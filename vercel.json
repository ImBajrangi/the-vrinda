{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/sitemap.xml",
      "destination": "https://bhav.vrindopnishad.in/sitemap.xml",
      "permanent": true
    },
    {
      "source": "/robots.txt",
      "destination": "https://bhav.vrindopnishad.in/robots.txt",
      "permanent": true
    },
    {
      "source": "/sitemap-:path*.xml",
      "destination": "https://bhav.vrindopnishad.in/sitemap-:path*.xml",
      "permanent": true
    },
    {
      "source": "/(hi/)?(lyrics|content|verse|pada|pad)/:slug",
      "destination": "https://bhav.vrindopnishad.in/?tab=padavali&pad=:slug",
      "permanent": true
    },
    {
      "source": "/granthas/:path*",
      "destination": "https://path.vrindopnishad.in/?tab=granthas",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "destination": "https://bhav.vrindopnishad.in/$1",
      "permanent": true
    }
  ]
}
