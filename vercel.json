{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/(hi/)?(lyrics|content|verse|pada|pad)/:slug",
      "destination": "https://bhav.vrindopnishad.in/pad/:slug",
      "permanent": true
    },
    {
      "source": "/grantha/:path*",
      "destination": "https://path.vrindopnishad.in/grantha/:path*",
      "permanent": true
    },
    {
      "source": "/granthas/:path*",
      "destination": "https://path.vrindopnishad.in/grantha/:path*",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "destination": "https://bhav.vrindopnishad.in/$1",
      "permanent": true
    }
  ]
}
