{
  "name": "vrindopnisad",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/generate-sitemap.js && node scripts/split-epic-chunks.mjs && node scripts/generate-chapter-snippets.mjs && node scripts/generate-static-granthas.js && tsc -b && vite build && vite build --ssr src/entry-server.tsx --outDir dist-server && node scripts/prerender.js",
    "build:server": "vite build --ssr src/entry-server.tsx --outDir dist-server",
    "build:sitemap": "node scripts/generate-sitemap.js",
    "build:ssg": "node scripts/generate-sitemap.js && node scripts/split-epic-chunks.mjs && node scripts/generate-chapter-snippets.mjs && node scripts/generate-preambles-manifest.mjs && node scripts/generate-static-granthas.js && tsc -b && vite build && vite build --ssr src/entry-server.tsx --outDir dist-server && node scripts/prerender.js",
    "test": "node scripts/test-seo-ssr.js && node tests/benchmark-traffic.mjs",
    "test:smoke": "playwright test tests/e2e/smoke.spec.ts",
    "test:e2e": "playwright test",
    "test:e2e:browser": "playwright test",
    "test:domains": "node scripts/audit-deployed-domains.mjs && playwright test tests/e2e/domain-integrity.spec.ts",
    "test:bhav": "playwright test tests/e2e/bhav* tests/e2e/domain* tests/e2e/smoke*",
    "test:path": "playwright test tests/e2e/path*",
    "test:performance": "playwright test tests/e2e/performance.spec.ts",
    "test:perf": "playwright test tests/e2e/performance.spec.ts",
    "test:accessibility": "playwright test tests/e2e/accessibility.spec.ts",
    "test:mobile": "playwright test tests/e2e/mobile-navigation.spec.ts",
    "test:all": "npm run test && npm run test:domains && npm run test:smoke && npm run test:e2e:browser",
    "backup": "node scripts/backup-db.js",
    "db:sync": "node scripts/sync-to-supabase.js",
    "serve:ssr": "node server.js",
    "start": "node server.js",
    "preview": "vite preview"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.119.0",
    "clsx": "^2.1.1",
    "idb-keyval": "^6.2.1",
    "lucide-react": "^1.16.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.0.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/node": "^22.13.4",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^6.1.0"
  }
}
