# Vrindopnisad 2.0 - High Performance Edge Caching Headers
# Combined with _routes.json (direct CDN serving for static assets) & Worker caches.default for dynamic SSR HTML

# 1. Hashed Static Assets (Vite chunks, CSS, WebP, Icons)
/assets/*
  Cache-Control: public, max-age=31536000, immutable
  CDN-Cache-Control: public, max-age=31536000
  Cloudflare-CDN-Cache-Control: public, max-age=31536000

# 2. Audio Recordings (Immutable MP3 assets)
/audio/*
  Cache-Control: public, max-age=31536000, immutable
  CDN-Cache-Control: public, max-age=31536000
  Cloudflare-CDN-Cache-Control: public, max-age=31536000

# 3. Canonical Scripture Chunks (44,368+ Verses & 781 Chapters)
/data/epics/*
  Cache-Control: public, max-age=31536000, immutable
  CDN-Cache-Control: public, max-age=31536000
  Cloudflare-CDN-Cache-Control: public, max-age=31536000

/data/granthas/*
  Cache-Control: public, max-age=31536000, immutable
  CDN-Cache-Control: public, max-age=31536000
  Cloudflare-CDN-Cache-Control: public, max-age=31536000

# 4. Manifest, Catalog & Scripture Hierarchy (Edge + Browser SWR caching; eliminates 6.6MB re-fetches)
/data/manifest.json
  Cache-Control: public, max-age=300, s-maxage=3600, stale-while-revalidate=86400
  CDN-Cache-Control: public, s-maxage=3600, stale-while-revalidate=86400
  Cloudflare-CDN-Cache-Control: public, max-age=3600, stale-while-revalidate=86400

/data/catalog.json
  Cache-Control: public, max-age=3600, s-maxage=86400, stale-while-revalidate=604800
  CDN-Cache-Control: public, s-maxage=86400, stale-while-revalidate=604800
  Cloudflare-CDN-Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/data/scripture-hierarchy.json
  Cache-Control: public, max-age=3600, s-maxage=86400, stale-while-revalidate=604800
  CDN-Cache-Control: public, s-maxage=86400, stale-while-revalidate=604800
  Cloudflare-CDN-Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/data/*
  Cache-Control: public, max-age=86400, s-maxage=604800, stale-while-revalidate=604800
  CDN-Cache-Control: public, max-age=604800, stale-while-revalidate=604800
  Cloudflare-CDN-Cache-Control: public, max-age=604800, stale-while-revalidate=604800

# 5. XML Sitemaps & RSS Feeds (24-hour Edge Cache, 7-day stale-while-revalidate)
/*.xml
  Content-Type: application/xml; charset=UTF-8
  Cache-Control: public, max-age=3600, s-maxage=86400, stale-while-revalidate=604800
  CDN-Cache-Control: public, s-maxage=86400, stale-while-revalidate=604800
  Cloudflare-CDN-Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/*.xml.gz
  Cache-Control: public, max-age=3600, s-maxage=86400, stale-while-revalidate=604800
  CDN-Cache-Control: public, s-maxage=86400, stale-while-revalidate=604800
  Cloudflare-CDN-Cache-Control: public, max-age=86400, stale-while-revalidate=604800

