[{"id":"shri-radha-kripa-kataksha-stotram","collectionId":"stotras","index":1,"titleDevanagari":"श्री राधा कृपा कटाक्ष स्तोत्रम्","titleEnglish":"Shri Radha Kripa Kataksha Stotram","author":"Shri Urdhvamnaya Tantra / Shri Chaitanya Mahaprabhu Lineage","rag":"स्तोत्र पाठ","slug":"shri-radha-kripa-kataksha-stotram","duration":"07:30","verses":[{"stanzaNumber":1,"linesDevanagari":["मुनीन्द्रवृन्दवन्दिते त्रिलोकशोकहारिणी।","प्रसन्नवक्त्रपङ्कजे निकुञ्जभूविलासिनी॥","व्रजेन्द्रभानुनन्दिनी श्रीमदङ्गकान्तिसागरे।","कदा करिष्यसीह मां कृपाकटाक्षभाजनम्॥१॥"],"linesTransliteration":["Munīndravṛndavandite Triloka-Śokahāriṇī।","Prasannavaktrapan̄kaje Nikuñjabhūvilāsinī॥","Vrajendrabhānunandinī Śrīmadaṅgakāntisāgare।","Kadā Kariṣyasīha Māṁ Kṛpākaṭākṣabhājanam॥1॥"]},{"stanzaNumber":2,"linesDevanagari":["अशोकवृक्षवल्लरी वितानमण्डपस्थिते।","प्रवालवालपल्लव प्रभारुणाङ्घ्रिकोमले॥","वराभयस्फुरत्करे प्रभूतसम्पदालये।","कदा करिष्यसीह मां कृपाकटाक्षभाजनम्॥२॥"],"linesTransliteration":["Aśokavṛkṣavallarī Vitānamaṇḍapasthite।","Pravālavālapallava Prabhāruṇāṅghrikomale॥","Varābhayasphuratkare Prabhūtasampadālaye।","Kadā Kariṣyasīha Māṁ Kṛpākaṭākṣabhājanam॥2॥"]},{"stanzaNumber":3,"linesDevanagari":["अनङ्गरङ्गमङ्गल प्रसङ्गभङ्गुरभ्रुवां।","सविभ्रमं ससम्भ्रमं दृगञ्चलप्रपातनैः॥","अशेषलोकमोहिनं मुकुन्दमेव मोहिनि।","कदा करिष्यसीह मां कृपाकटाक्षभाजनम्॥३॥"],"linesTransliteration":["Anaṅgaraṅgamaṅgala Prasaṅgabhaṅgurabhruvāṁ।","Savibhramaṁ Sasambhramaṁ Dṛgañcalaprapātanaiḥ॥","Aśeṣalokamohinaṁ Mukundameva Mohini।","Kadā Kariṣyasīha Māṁ Kṛpākaṭākṣabhājanam॥3॥"]},{"stanzaNumber":4,"linesDevanagari":["तडित्स्ववर्णचम्पक प्रदीप्तगौरविग्रहे।","मुखप्रभापरास्तकोटि शारदेन्दुमण्डले॥","विचित्ररत्नसञ्चर त्किङ्किणीनिनाददे।","कदा करिष्यसीह मां कृपाकटाक्षभाजनम्॥४॥"],"linesTransliteration":["Taḍitsvavarṇacampaka Pradīptagauravigrahe।","Mukhaprabhāparāstakoṭi Śāradendumamḍale॥","Vicitraratnasañcara Tkiṅkiṇīninādade।","Kadā Kariṣyasīha Māṁ Kṛpākaṭākṣabhājanam॥4॥"]}]},{"id":"5a4b088a59e8c72a534d8639","collectionId":"stotras","index":1,"titleDevanagari":"राधा कृपा कटाक्ष बिन","titleEnglish":"Radha Kripa Kataksha Bin - Braj Rasik","author":"ब्रज रसिक","rag":"","slug":"radha-kripa-kataksha-bin-mile-na-gokul-chand","duration":"05:20","verses":[{"index":1,"linesDevanagari":["“ राधा कृपा कटाक्ष बिन, मिलै न गोकुलचन्द&nbsp; | | ”"],"linesEnglish":["\"Radha Kripa Kataksha Bin, Mile Na Gokul Chand\""]}]},{"id":"5da428581276e7006036d022","collectionId":"stotras","index":1,"titleDevanagari":"कृपा कटाक्षि चितै 'श्रीहरिप्रिया'","titleEnglish":"Kripa Katakshi Chitai 'ShriHaripriya' - Shri Harivyas Devacharya, Mahavani","author":"श्री हरिव्यास देवाचार्य","rag":"","slug":"kripa-katakshi-chitai-shriharipriya-shri-harivyas-devacharya-mahavani","duration":"05:20","verses":[{"index":1,"linesDevanagari":["कृपा कटाक्षि चितै 'श्रीहरिप्रिया'।","तबही सकै चरन-रज लाध॥"],"linesEnglish":["Kripa Katakshi Chitai 'ShriHaripriya'","Tabhi Sakai Charan-Raj Laadh."]}]},{"id":"shri-yamunashtakam","collectionId":"stotras","index":2,"titleDevanagari":"श्री यमुनाष्टकम्","titleEnglish":"Shri Yamunashtakam","author":"Mahaprabhu Shri Vallabhacharya","rag":"स्तोत्र पाठ","slug":"shri-yamunashtakam","duration":"07:30","verses":[{"stanzaNumber":1,"linesDevanagari":["नमामि यमुनामहं सकलसिद्धिहेतुं मुदा।","मुरारिपदपङ्कजस्फुरदमन्दरेणुउत्कटा॥","तटस्थनवकाननप्रकटमोदपुष्पोच्चया।","सलोलकलकासिद्भिर्मुरारिपूरितकामा॥१॥"],"linesTransliteration":["Namāmi Yamunāmahaṁ Sakalasiddhihetuṁ Mudā।","Murāripadapaṅkajasphuradamandareṇuutkaṭā॥"]}]},{"id":"shri-madhurashtakam","collectionId":"stotras","index":3,"titleDevanagari":"श्री मधुराष्टकम्","titleEnglish":"Shri Madhurashtakam","author":"Shri Vallabhacharya","rag":"स्तोत्र पाठ","slug":"shri-madhurashtakam","duration":"07:30","verses":[{"stanzaNumber":1,"linesDevanagari":["अधरं मधुरं वदनं मधुरं नयनं मधुरं हसितं मधुरम्।","हृदयं मधुरं गमनं मधुरं मधुराधिपतेरखिलं मधुरम्॥१॥"],"linesTransliteration":["Adharaṁ Madhuraṁ Vadanaṁ Madhuraṁ Nayanaṁ Madhuraṁ Hasitaṁ Madhuram।","Hṛdayaṁ Madhuraṁ Gamanaṁ Madhuraṁ Madhurādhipaterakhilaṁ Madhuram॥1॥"]}]}]