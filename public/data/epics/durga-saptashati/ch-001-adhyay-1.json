          "स बभूव महाभागः सावर्णिस्तनयो रवेः॥३॥"
        ]
      }
    ],
    "chapterId": "adhyay-1",
    "chapterName": "अध्याय 1 (चरित्र 1)",
    "verseNumber": 3
  },
