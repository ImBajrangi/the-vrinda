        "stanzaNumber": 1,
        "linesDevanagari": [
          "ॐ ऋषिरुवाच॥१॥",
          "एतत्ते कथितं भूप देवीमाहात्म्यमुत्तमम्।",
          "एवंप्रभावा सा देवी ययेदं धार्यते जगत्॥२॥"
        ]
      }
    ],
    "chapterId": "adhyay-13",
    "chapterName": "अध्याय 13 (चरित्र 13)",
    "verseNumber": 2
  },
  {
