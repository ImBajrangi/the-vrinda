          "चकार शुम्भो यत्कर्म निशुम्भश्चातिकोपनः॥३॥"
        ]
      }
    ],
    "chapterId": "adhyay-9",
    "chapterName": "अध्याय 9 (चरित्र 9)",
    "verseNumber": 3
