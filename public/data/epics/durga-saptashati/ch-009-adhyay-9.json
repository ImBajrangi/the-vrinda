          "विचित्रमिदमाख्यातं भगवन् भवता मम।",
          "देव्याश्चरितमाहात्म्यं रक्तबीजवधाश्रितम्॥२॥"
        ]
      }
    ],
    "chapterId": "adhyay-9",
    "chapterName": "अध्याय 9 (चरित्र 9)",
    "verseNumber": 2
