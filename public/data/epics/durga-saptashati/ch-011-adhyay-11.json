    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "देवि प्रपन्नार्तिहरे प्रसीद प्रसीद मातर्जगतोऽखिलस्य।",
          "प्रसीद विश्वेश्वरि पाहि विश्वं त्वमीश्वरी देवि चराचरस्य॥३॥"
        ]
      }
    ],
    "chapterId": "adhyay-11",
    "chapterName": "अध्याय 11 (चरित्र 11)",
    "verseNumber": 3
  },
