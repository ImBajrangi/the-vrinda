          "सक्रोधः प्राह दैत्यानामधिपं धूम्रलोचनम्॥३॥"
        ]
      }
    ],
    "chapterId": "adhyay-6",
    "chapterName": "अध्याय 6 (चरित्र 6)",
    "verseNumber": 3
