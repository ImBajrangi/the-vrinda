          "महासुराभ्यां तां देवीं संस्मरन्त्यपराजिताम्॥५॥"
        ]
      }
    ],
    "chapterId": "adhyay-5",
    "chapterName": "अध्याय 5 (चरित्र 5)",
    "verseNumber": 5
  },
