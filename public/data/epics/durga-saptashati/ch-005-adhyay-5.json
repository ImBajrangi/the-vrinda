        "stanzaNumber": 1,
        "linesDevanagari": [
          "देवा ऊचुः॥८॥",
          "नमो देव्यै महादेव्यै शिवायै सततं नमः।",
          "नमः प्रकृत्यै भद्रायै नियताः प्रणताः स्मताम्॥९॥"
        ]
      }
    ],
    "chapterId": "adhyay-5",
    "chapterName": "अध्याय 5 (चरित्र 5)",
    "verseNumber": 9
