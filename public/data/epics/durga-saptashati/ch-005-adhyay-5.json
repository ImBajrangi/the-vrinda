      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "ॐ क्लीं ऋषिरुवाच॥१॥",
          "पुरा शुम्भनिशुम्भाभ्यामसुराभ्यां शचीपतेः।",
          "त्रैलोक्यं यज्ञभागाश्च हृता मदबलाश्रयात्॥२॥"
        ]
      }
    ],
    "chapterId": "adhyay-5",
    "chapterName": "अध्याय 5 (चरित्र 5)",
    "verseNumber": 2
  },
  {
