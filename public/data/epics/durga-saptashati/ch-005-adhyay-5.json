    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "तावेव सूर्यतां तद्वदधिकारं तथैन्दवम्।",
          "कौबेरमथ याम्यं च चक्राते वरुणस्य च॥३॥"
        ]
      }
    ],
    "chapterId": "adhyay-5",
    "chapterName": "अध्याय 5 (चरित्र 5)",
    "verseNumber": 3
  },
  {
