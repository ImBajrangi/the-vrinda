          "भवतां नाशयिष्यामि तत्क्षणात्परमापदः॥६॥"
        ]
      }
    ],
    "chapterId": "adhyay-5",
    "chapterName": "अध्याय 5 (चरित्र 5)",
    "verseNumber": 6
