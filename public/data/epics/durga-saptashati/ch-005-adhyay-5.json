    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "तावेव पवनर्द्धिं च चक्रतुर्वह्निकर्म च।",
          "ततो देवा विनिर्धूता भ्रष्टराज्याः पराजिताः॥४॥"
        ]
      }
    ],
    "chapterId": "adhyay-5",
    "chapterName": "अध्याय 5 (चरित्र 5)",
    "verseNumber": 4
  },
  {
