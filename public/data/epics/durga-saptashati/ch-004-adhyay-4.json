    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "ॐ ऋषिरुवाच॥१॥",
          "शक्रादयः सुरगणा निहतेऽतिवीर्ये",
          "तस्मिन्दुरात्मनि सुरारिबले च देव्या।",
          "तां तुष्टुवुः प्रणतिनम्रशिरोधरांसा",
          "वाग्भिः प्रहर्षपुलकोद्गमचारुदेहाः॥२॥"
        ]
      }
    ],
    "chapterId": "adhyay-4",
    "chapterName": "अध्याय 4 (चरित्र 4)",
    "verseNumber": 2
  },
  {
    "id": "durga-saptashati-adhyay-4-shlok-3",
    "collectionId": "durga-saptashati",
    "index": 171,
    "titleDevanagari": "दुर्गा सप्तशती, अध्याय 4, श्लोक 3",
    "author": "महर्षि वेदव्यास",
    "slug": "durga-saptashati-adhyay-4-shlok-3",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "देव्या यया ततमिदं जगदात्मशक्त्या",
          "निश्शेषदेवगणशक्तिसमूहमूर्त्या।",
          "तामम्बिकामखिलदेवमहर्षिपूज्यां",
          "भक्त्या नताः स्म विदधातु शुभानि सा नः॥३॥"
        ]
      }
    ],
    "chapterId": "adhyay-4",
    "chapterName": "अध्याय 4 (चरित्र 4)",
    "verseNumber": 3
  },
  {
    "id": "durga-saptashati-adhyay-4-shlok-4",
    "collectionId": "durga-saptashati",
    "index": 172,
    "titleDevanagari": "दुर्गा सप्तशती, अध्याय 4, श्लोक 4",
    "author": "महर्षि वेदव्यास",
    "slug": "durga-saptashati-adhyay-4-shlok-4",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "यस्याः प्रभावमतुलं भगवाननन्तो",
          "ब्रह्मा हरश्च न हि वक्तुमलं बलं च।",
          "सा चण्डिकाखिलजगत्परिपालनाय",
          "नाशाय चाशुभभयस्य मतिं करोतु॥४॥"
        ]
      }
    ],
    "chapterId": "adhyay-4",
    "chapterName": "अध्याय 4 (चरित्र 4)",
    "verseNumber": 4
  },
  {
    "id": "durga-saptashati-adhyay-4-shlok-5",
