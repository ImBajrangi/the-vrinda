    "slug": "durga-saptashati-adhyay-4-shlok-7",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "हेतुः समस्तजगतां त्रिगुणापि दोषैर्न",
          "ज्ञायसे हरिहरादिभिरप्यपारा।",
          "सर्वाश्रयाखिलमिदं जगदंशभूत-",
          "मव्याकृता हि परमा प्रकृतिस्त्वमाद्या॥७॥"
        ]
      }
    ],
    "chapterId": "adhyay-4",
    "chapterName": "अध्याय 4 (चरित्र 4)",
    "verseNumber": 7
  },
