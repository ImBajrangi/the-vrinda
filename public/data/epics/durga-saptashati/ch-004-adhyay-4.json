    "slug": "durga-saptashati-adhyay-4-shlok-8",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "यस्याः समस्तसुरता समुदीरणेन",
          "तृप्तिं प्रयाति सकलेषु मखेषु देवि।",
          "स्वाहासि वै पितृगणस्य च तृप्तिहेतु-",
          "रुच्चार्यसे त्वमत एव जनैः स्वधा च॥८॥"
        ]
      }
    ],
    "chapterId": "adhyay-4",
    "chapterName": "अध्याय 4 (चरित्र 4)",
    "verseNumber": 8
  },
