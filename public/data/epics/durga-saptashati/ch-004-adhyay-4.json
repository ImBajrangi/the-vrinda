    "index": 173,
    "titleDevanagari": "दुर्गा सप्तशती, अध्याय 4, श्लोक 5",
    "author": "महर्षि वेदव्यास",
    "slug": "durga-saptashati-adhyay-4-shlok-5",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "या श्रीः स्वयं सुकृतिनां भवनेष्वलक्ष्मीः",
          "पापात्मनां कृतधियां हृदयेषु बुद्धिः।",
          "श्रद्धा सतां कुलजनप्रभवस्य लज्जा",
          "तां त्वां नताः स्म परिपालय देवि विश्वम्॥५॥"
        ]
      }
    ],
    "chapterId": "adhyay-4",
    "chapterName": "अध्याय 4 (चरित्र 4)",
    "verseNumber": 5
  },
  {
    "id": "durga-saptashati-adhyay-4-shlok-6",
    "collectionId": "durga-saptashati",
    "index": 174,
    "titleDevanagari": "दुर्गा सप्तशती, अध्याय 4, श्लोक 6",
    "author": "महर्षि वेदव्यास",
    "slug": "durga-saptashati-adhyay-4-shlok-6",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "किं वर्णयाम तव रूपमचिन्त्यमेतत्",
          "किं चातिवीर्यमसुरक्षयकारि भूरि।",
          "किं चाहवेषु चरितानि तवाद्भुतानि",
          "सर्वेषु देव्यसुरदेवगणादिकेषु॥६॥",
          "आपके अद्भुत चरित्रोंका, हम किस प्रकार वर्णन करें।",
          "जगतजननी, गुणातीत, भक्तवत्सल, परा प्रकृति"
        ]
      }
    ],
    "chapterId": "adhyay-4",
    "chapterName": "अध्याय 4 (चरित्र 4)",
    "verseNumber": 6
  },
  {
    "id": "durga-saptashati-adhyay-4-shlok-7",
