    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "यत्र ह वाव भगवान् पितृराजो वैवस्वतः",
          "स्वविषयं प्रापितेषु स्वपुरुषैर्जन्तुषु सम्परेतेषु",
          "यथाकर्मावद्यं दोषमेवानुल्लङ्घितभगवच्छासनः",
          "सगणो दमं धारयति ॥ ६ ॥"
        ]
      }
    ],
    "chapterId": "skandh-5-adhyay-26",
    "chapterName": "पंचम स्कन्ध (स्थान लीला), अध्याय 26",
    "verseNumber": 6
