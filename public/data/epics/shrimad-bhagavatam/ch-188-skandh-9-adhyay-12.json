    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "श्रीमद्भागवतपुराणम्",
          "स्कन्धः ९/अध्यायः १२",
          "इक्ष्वाकूणां कुशादिसुमित्रान्तानां वर्णनम् –",
          "श्रीशुक उवाच ।",
          "कुशस्य चातिथिस्तस्मात् निषधस्तत्सुतो नभः ।",
          "पुण्डरीकोऽथ तत्पुत्रः क्षेमधन्वाभवत्ततः ॥ १ ॥"
        ]
      }
    ],
    "chapterId": "skandh-9-adhyay-12",
    "chapterName": "नवम स्कन्ध (ईशानुकथा लीला), अध्याय 12",
    "verseNumber": 1
  },
