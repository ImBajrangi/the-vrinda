    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "4 CHAPTER",
          "श्रीमद्भागवतपुराणम्/स्कन्धः ११/अध्यायः ४",
          "भगवतोऽवताराणां वर्णनम्, नारायणकृतः कामपराभवः –",
          "श्रीराजोवाच –",
          "( अनुष्टुप् )",
          "यानि यानीह कर्माणि यैर्यैः स्वच्छन्दजन्मभिः ।",
          "चक्रे करोति कर्ता वा हरिस्तानि ब्रुवन्तु नः ॥ १ ॥"
        ]
      }
    ],
    "chapterId": "skandh-11-adhyay-4",
    "chapterName": "एकादश स्कन्ध (मुक्ति लीला), अध्याय 4",
    "verseNumber": 1
  },
  {
    "id": "shrimad-bhagwat-skandh-11-adhyay-4-shlok-2",
    "collectionId": "shrimad-bhagavatam",
