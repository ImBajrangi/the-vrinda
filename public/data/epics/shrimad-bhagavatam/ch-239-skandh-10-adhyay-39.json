        "stanzaNumber": 1,
        "linesDevanagari": [
          "श्रीकृष्णबलरामयोर्मथुरायां प्रति प्रस्थानं विरहकातर गोपीनां करुणोद्गारः कालिंद्यां अक्रूरकर्तृकं भगवद्धाम दर्शनं च –",
          "श्रीशुक उवाच –",
          "( अनुष्टुप् )",
          "सुखोपविष्टः पर्यङ्के रमकृष्णोरुमानितः ।",
          "लेभे मनोरथान् सर्वान् पन्पथि यान् स चकार ह ॥ १ ॥"
        ]
      }
