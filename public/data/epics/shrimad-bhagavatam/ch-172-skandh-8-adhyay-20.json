      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "श्रीमद्भागवत महापुराण",
          "अष्टमः स्कन्धः – विंशोऽध्यायः",
          "बलिकर्तृकं पदत्रयमितभूमिदानं भगवतो विराड्रूपग्रहणं च –",
          "श्रीशुक उवाच –",
          "(अनुष्टुप्)",
          "बलिरेवं गृहपतिः कुलाचार्येण भाषितः ।",
          "तूष्णीं भूत्वा क्षणं राजन् उवाचावहितो गुरुम् ॥ १ ॥"
        ]
      }
    ],
    "chapterId": "skandh-8-adhyay-20",
    "chapterName": "अष्टम स्कन्ध (मन्वन्तर लीला), अध्याय 20",
    "verseNumber": 1
