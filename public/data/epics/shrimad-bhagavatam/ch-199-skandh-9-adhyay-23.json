    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "अनुद्रुह्युतुर्वसु यदूनां वंशवर्णनम् –",
          "श्रीशुक उवाच ।",
          "अनोः सभानरश्चक्षुः परोक्षश्च त्रयः सुताः ।",
          "सभानरात् कालनरः सृञ्जयः तत्सुतस्ततः ॥ १ ॥"
        ]
      }
    ],
    "chapterId": "skandh-9-adhyay-23",
    "chapterName": "नवम स्कन्ध (ईशानुकथा लीला), अध्याय 23",
