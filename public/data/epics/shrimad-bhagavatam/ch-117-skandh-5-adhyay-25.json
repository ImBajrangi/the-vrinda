    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "यस्येदं क्षितिमण्डले भगवतोऽनन्तमूर्तेः",
          "सहस्रशिरस एकस्मिन्नेव शीर्षणि ध्रियमाणं",
          "सिद्धार्थ इव लक्ष्यते ॥ २ ॥"
        ]
      }
    ],
    "chapterId": "skandh-5-adhyay-25",
    "chapterName": "पंचम स्कन्ध (स्थान लीला), अध्याय 25",
    "verseNumber": 2
  },
  {
