    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "यस्य ह वा इदं कालेनोपसंजिहीर्षतोऽमर्ष-",
          "विरचितरुचिरभ्रमद्भुवोरन्तरेण साङ्कर्षणो नाम रुद्र",
          "एकादशव्यूहस्त्र्यक्षस्त्रिशिखं शूलमुत्तम्भयन्नुदतिष्ठत् ॥ ३ ॥"
        ]
      }
    ],
    "chapterId": "skandh-5-adhyay-25",
    "chapterName": "पंचम स्कन्ध (स्थान लीला), अध्याय 25",
    "verseNumber": 3
  },
  {
    "id": "shrimad-bhagwat-skandh-5-adhyay-25-shlok-4",
    "collectionId": "shrimad-bhagavatam",
    "index": 3979,
    "titleDevanagari": "स्कन्ध 5, अध्याय 25, श्लोक 4",
    "author": "महर्षि वेदव्यास",
    "slug": "shrimad-bhagwat-skandh-5-adhyay-25-shlok-4",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "यस्याङ्घ्रिकमलयुगलारुणविशदनखमणि-",
          "षण्डमण्डलेष्वहिपतयः सह सात्वतर्षभैरेकान्त-",
          "भक्तियोगेनावनमन्तः स्ववदनानि परिस्फुरत्-",
          "कुण्डलप्रभामण्डितगण्डस्थलान्यतिमनोहराणि",
          "प्रमुदितमनसः खलु विलोकयन्ति ॥ ४ ॥"
        ]
      }
    ],
    "chapterId": "skandh-5-adhyay-25",
    "chapterName": "पंचम स्कन्ध (स्थान लीला), अध्याय 25",
    "verseNumber": 4
  },
  {
    "id": "shrimad-bhagwat-skandh-5-adhyay-25-shlok-5",
    "collectionId": "shrimad-bhagavatam",
    "index": 3980,
    "titleDevanagari": "स्कन्ध 5, अध्याय 25, श्लोक 5",
    "author": "महर्षि वेदव्यास",
    "slug": "shrimad-bhagwat-skandh-5-adhyay-25-shlok-5",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "यस्यैव हि नागराजकुमार्य आशिष",
          "आशासानाश्चार्वङ्गवलयविलसितविशदविपुल-",
          "धवलसुभगरुचिरभुजरजतस्तम्भेष्वगुरुचन्दन-",
          "कुङ्कुमपङ्कानुलेपेनावलिम्पमानास्तदभिमर्शनो-",
          "न्मथितहृदयमकरध्वजावेशरुचिरललितस्मिता-",
          "स्तदनुरागमदमुदितमदविघूर्णितारुणकरुणावलोक-",
          "नयनवदनारविन्दं सव्रीडं किलविलोकयन्ति ॥ ५ ॥"
        ]
      }
    ],
    "chapterId": "skandh-5-adhyay-25",
    "chapterName": "पंचम स्कन्ध (स्थान लीला), अध्याय 25",
    "verseNumber": 5
  },
