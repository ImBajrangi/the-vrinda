    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "स एव भगवाननन्तोऽनन्तगुणार्णव आदिदेव",
          "उपसंहृतामर्षरोषवेगो लोकानां स्वस्तय आस्ते ॥ ६ ॥"
        ]
      }
    ],
    "chapterId": "skandh-5-adhyay-25",
    "chapterName": "पंचम स्कन्ध (स्थान लीला), अध्याय 25",
    "verseNumber": 6
  },
