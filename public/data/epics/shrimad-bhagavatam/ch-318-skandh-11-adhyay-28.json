    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "28 CHAPTER",
          "श्रीमद्भागवतपुराणम्/स्कन्धः ११/अध्यायः २८",
          "परमार्थनिरूपणम् –",
          "श्रीभगवानुवाच –",
          "( अनुष्टुप् )",
          "परस्वभावकर्माणि न प्रशंसेन्न गहयेत् ।",
          "विश्वमेकात्मकं पश्यन् प्रकृत्या पुरुषेण च ॥ १ ॥"
        ]
      }
    ],
    "chapterId": "skandh-11-adhyay-28",
    "chapterName": "एकादश स्कन्ध (मुक्ति लीला), अध्याय 28",
    "verseNumber": 1
