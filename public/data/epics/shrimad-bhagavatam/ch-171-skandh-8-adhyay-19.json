      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "अध्यायः १९",
          "श्रीमद्भागवत महापुराण",
          "अष्टमः स्कन्धः – एकोनविंशोऽध्यायः",
          "बलिवामनसंवादः, पदत्रयभूमियाचनम्, शुक्रद्वारा दाननिषेधश्च –",
          "श्रीशुक उवाच –",
          "(अनुष्टुप्)",
          "निशम्य भगवान् प्रीन्प्रीतः प्रतिनन्द्येदमब्रवीत् ॥ १ ॥"
        ]
      }
    ],
    "chapterId": "skandh-8-adhyay-19",
    "chapterName": "अष्टम स्कन्ध (मन्वन्तर लीला), अध्याय 19",
