      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "श्रीमद्भागवत महापुराण",
          "अष्टमः स्कन्धः – चतुर्विंशोऽध्यायः",
          "मत्स्यावतारकथा –",
          "श्रीराजोवाच –",
          "भगवन् श्रोतुमिच्छामि हरेरद्भुतकर्मणः ।",
          "अवतारकथामाद्यां मायामत्स्यविडम्बनम् ॥ १ ॥"
        ]
      }
    ],
    "chapterId": "skandh-8-adhyay-24",
