    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "श्रीमद्भागवत महापुराण",
          "षष्ठः स्कन्धः – द्वादशोऽध्यायः",
          "इन्द्रवृत्रयुद्धं वृत्रस्य वधश्च –",
          "श्रीऋषिरुवाच –",
          "एवं जिहासुर्नृप देहमाजौ",
          "मृत्युं वरं विजयान्मन्यमानः ।",
          "शूलं प्रगृह्याभ्यपतत् सुरेन्द्रं",
          "यथा महापुरुषं कैटभोऽप्सु ॥ १ ॥"
        ]
      }
    ],
    "chapterId": "skandh-6-adhyay-12",
    "chapterName": "षष्ठ स्कन्ध (पोषण लीला), अध्याय 12",
    "verseNumber": 1
  },
  {
    "id": "shrimad-bhagwat-skandh-6-adhyay-12-shlok-2",
