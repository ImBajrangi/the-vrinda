      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "26 CHAPTER",
          "श्रीमद्भागवतपुराणम्/स्कन्धः ११/अध्यायः २६",
          "ऐलगीतम् –",
          "श्रीभगवानुवाच –",
          "( अनुष्टुप् )",
          "मल्लक्षणमिमं कायं लब्ध्वा मद्धर्म आस्थितः ।",
          "आनन्दं परमात्मानम् आत्मस्थं समुपैति माम् ॥ १ ॥"
        ]
      }
    ],
    "chapterId": "skandh-11-adhyay-26",
    "chapterName": "एकादश स्कन्ध (मुक्ति लीला), अध्याय 26",
