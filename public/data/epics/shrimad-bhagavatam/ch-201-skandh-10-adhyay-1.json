          "श्रीमद्भागवतपुराणम्",
          "स्कन्धः १०",
          "श्रीमद्भागवतपुराणम्",
          "पूर्वार्धः",
          "1 CHAPTER",
          "अध्यायः १",
          "श्रीराजोवाच ।",
          "( अनुष्टुप् )",
          "कथितो वंशविस्तारो भवता सोमसूर्ययोः ।",
          "राज्ञां च उभयवंश्यानां चरितं परमाद्भुतम् ॥ १ ॥"
        ]
      }
