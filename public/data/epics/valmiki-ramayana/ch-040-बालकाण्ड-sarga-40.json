          "उवाच नरशार्दूलं रामं परबलार्दनम्॥१॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-40",
    "chapterName": "बालकाण्ड, सर्ग 40",
    "verseNumber": 1
