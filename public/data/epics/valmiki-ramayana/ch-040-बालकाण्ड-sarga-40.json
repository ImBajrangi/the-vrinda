      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "पितामहवचः श्रुत्वा त्रयस्त्रिंशदरिंदमाः।",
          "देवाः परमसंहृष्टाः पुनर्जग्मुर्यथागतम्॥५॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-40",
    "chapterName": "बालकाण्ड, सर्ग 40",
    "verseNumber": 5
