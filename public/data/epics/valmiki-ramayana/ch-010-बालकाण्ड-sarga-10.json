    "slug": "valmiki-ramayana-1-sarga-10-shlok-1-2",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "अथाब्रवीन्मुनिं रामः कथं ते भ्रातरो वने।",
          "कीदृशं तु तदा ब्रह्मस्तपस्तेपुर्महाबलाः॥१॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-10",
    "chapterName": "बालकाण्ड, सर्ग 10",
    "verseNumber": 1
  },
  {
    "id": "valmiki-ramayana-1-sarga-10-shlok-2",
    "collectionId": "valmiki-ramayana",
    "index": 481,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 10, श्लोक 2",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-10-shlok-2",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "अगस्त्यस्त्वब्रवीत् तत्र रामं सुप्रीतमानसम्।",
          "तांस्तान् धर्मविधींस्तत्र भ्रातरस्ते समाविशन्॥२॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-10",
    "chapterName": "बालकाण्ड, सर्ग 10",
    "verseNumber": 2
  },
  {
