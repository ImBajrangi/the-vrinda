        "stanzaNumber": 1,
        "linesDevanagari": [
          "॥ श्रीसीतारामचन्द्राभ्यां नमः॥",
          "श्रीमद्वाल्मीकीय रामायण",
          "उत्तरकाण्डम्",
          "दशमः सर्गः (सर्ग 10)",
          "दशवर्षसहस्रं तु निराहारो दशाननः।",
          "पूर्णे वर्षसहस्रे तु शिरश्चाग्नौ जुहाव सः॥१०॥",
          "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये उत्तरकाण्डे दशमः सर्गः॥१०॥"
        ]
      }
