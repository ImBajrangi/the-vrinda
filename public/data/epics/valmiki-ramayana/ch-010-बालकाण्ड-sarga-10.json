    "index": 482,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 10, श्लोक 3",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-10-shlok-3-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "इदं बहुशलाकं ते पूर्णचन्द्रमिवोदितम्।",
          "छत्रं सवालव्यजनं प्रतीच्छस्व मया धृतम्॥३॥",
          "आर्तस्तत्र बिलद्वारि स्थितः संवत्सरं नृप।",
          "दृष्ट्वा च शोणितं द्वारि बिलाच्चापि समुत्थितम्॥ ४॥",
          "शोकसंविग्नहृदयो भृशं व्याकुलितेन्द्रियः।"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-10",
    "chapterName": "बालकाण्ड, सर्ग 10",
    "verseNumber": 3
  },
