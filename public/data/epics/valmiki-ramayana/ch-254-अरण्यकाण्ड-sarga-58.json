    "index": 8346,
    "titleDevanagari": "वाल्मीकि रामायण, अरण्यकाण्ड, सर्ग 58, श्लोक 14",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-58-shlok-14",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "श्रुतश्च मन्ये वैदेह्या स स्वरः सदृशो मम।",
          "त्रस्तया प्रेषितस्त्वं च द्रष्टुं मां शीघ्रमागतः॥१४॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-58",
    "chapterName": "अरण्यकाण्ड, सर्ग 58",
    "verseNumber": 14
  },
  {
