    "titleDevanagari": "वाल्मीकि रामायण, अरण्यकाण्ड, सर्ग 58, श्लोक 15",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-58-shlok-15",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "सर्वथा तु कृतं कष्टं सीतामुत्सृजता वने।",
          "प्रतिकर्तुं नृशंसानां रक्षसां दत्तमन्तरम्॥१५॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-58",
    "chapterName": "अरण्यकाण्ड, सर्ग 58",
    "verseNumber": 15
  },
