    "collectionId": "valmiki-ramayana",
    "index": 8343,
    "titleDevanagari": "वाल्मीकि रामायण, अरण्यकाण्ड, सर्ग 58, श्लोक 11",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-58-shlok-11",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "ब्रूहि लक्ष्मण वैदेही यदि जीवति वा न वा।",
          "त्वयि प्रमत्ते रक्षोभिर्भक्षिता वा तपस्विनी॥११॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-58",
    "chapterName": "अरण्यकाण्ड, सर्ग 58",
    "verseNumber": 11
  },
  {
    "id": "valmiki-ramayana-3-sarga-58-shlok-12",
    "collectionId": "valmiki-ramayana",
    "index": 8344,
    "titleDevanagari": "वाल्मीकि रामायण, अरण्यकाण्ड, सर्ग 58, श्लोक 12",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-58-shlok-12",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "सुकुमारी च बाला च नित्यं चादुःखभागिनी।",
          "मद्वियोगेन वैदेही व्यक्तं शोचति दुर्मनाः॥१२॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-58",
    "chapterName": "अरण्यकाण्ड, सर्ग 58",
    "verseNumber": 12
  },
  {
    "id": "valmiki-ramayana-3-sarga-58-shlok-13",
    "collectionId": "valmiki-ramayana",
    "index": 8345,
    "titleDevanagari": "वाल्मीकि रामायण, अरण्यकाण्ड, सर्ग 58, श्लोक 13",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-58-shlok-13",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "सर्वथा रक्षसा तेन जिह्मेन सुदुरात्मना।।",
          "वदता लक्ष्मणेत्युच्चैस्तवापि जनितं भयम्॥१३॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-58",
    "chapterName": "अरण्यकाण्ड, सर्ग 58",
    "verseNumber": 13
  },
  {
