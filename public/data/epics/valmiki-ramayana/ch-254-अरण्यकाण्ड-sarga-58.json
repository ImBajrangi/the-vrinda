    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-58-shlok-16",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "दुःखिताः खरघातेन राक्षसाः पिशिताशनाः।",
          "तैः सीता निहता घोरैर्भविष्यति न संशयः॥१६॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-58",
