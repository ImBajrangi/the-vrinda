[
  {
    "id": "valmiki-ramayana-3-sarga-58-shlok-1",
    "collectionId": "valmiki-ramayana",
    "index": 8336,
    "titleDevanagari": "वाल्मीकि रामायण, अरण्यकाण्ड, सर्ग 58, श्लोक 1",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-58-shlok-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "स दृष्ट्वा लक्ष्मणं दीनं शून्यं दशरथात्मजः।",
          "पर्यपृच्छत धर्मात्मा वैदेहीमागतं विना॥१॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-58",
    "chapterName": "अरण्यकाण्ड, सर्ग 58",
    "verseNumber": 1
  },
  {
    "id": "valmiki-ramayana-3-sarga-58-shlok-2",
    "collectionId": "valmiki-ramayana",
    "index": 8337,
    "titleDevanagari": "वाल्मीकि रामायण, अरण्यकाण्ड, सर्ग 58, श्लोक 2",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-58-shlok-2",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "प्रस्थितं दण्डकारण्यं या मामनुजगाम ह।",
          "क्व सा लक्ष्मण वैदेही यां हित्वा त्वमिहागतः॥ २॥",
          "अयोध्या"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-58",
    "chapterName": "अरण्यकाण्ड, सर्ग 58",
    "verseNumber": 2
  },
  {
    "id": "valmiki-ramayana-3-sarga-58-shlok-3",
    "collectionId": "valmiki-ramayana",
    "index": 8338,
    "titleDevanagari": "वाल्मीकि रामायण, अरण्यकाण्ड, सर्ग 58, श्लोक 3",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-58-shlok-3",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "राज्यभ्रष्टस्य दीनस्य दण्डकान् परिधावतः।",
          "क्व सा दुःखसहाया मे वैदेही तनुमध्यमा॥३॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-58",
    "chapterName": "अरण्यकाण्ड, सर्ग 58",
    "verseNumber": 3
  },
  {
    "id": "valmiki-ramayana-3-sarga-58-shlok-4",
    "collectionId": "valmiki-ramayana",
    "index": 8339,
    "titleDevanagari": "वाल्मीकि रामायण, अरण्यकाण्ड, सर्ग 58, श्लोक 4",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-58-shlok-4",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "यां विना नोत्सहे वीर मुहूर्तमपि जीवितुम्।",
          "क्व सा प्राणसहाया मे सीता सुरसुतोपमा॥४॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-58",
    "chapterName": "अरण्यकाण्ड, सर्ग 58",
    "verseNumber": 4
  },
  {
    "id": "valmiki-ramayana-3-sarga-58-shlok-5",
    "collectionId": "valmiki-ramayana",
    "index": 8340,
    "titleDevanagari": "वाल्मीकि रामायण, अरण्यकाण्ड, सर्ग 58, श्लोक 5",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-58-shlok-5",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "पतित्वममराणां हि पृथिव्याश्चापि लक्ष्मण।",
          "विना तां तपनीयाभां नेच्छेयं जनकात्मजाम्॥५॥",
          "कच्चिज्जीवति वैदेही प्राणैः प्रियतरा मम।",
          "कच्चित् प्रव्राजनं वीर न मे मिथ्या भविष्यति॥",
          "सीतानिमित्तं सौमित्रे मृते मयि गते त्वयि।",
          "कच्चित् सकामा कैकेयी सुखिता सा भविष्यति॥",
          "अयोध्या"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-58",
    "chapterName": "अरण्यकाण्ड, सर्ग 58",
    "verseNumber": 5
  },
  {
    "id": "valmiki-ramayana-3-sarga-58-shlok-8",
    "collectionId": "valmiki-ramayana",
    "index": 8341,
    "titleDevanagari": "वाल्मीकि रामायण, अरण्यकाण्ड, सर्ग 58, श्लोक 8",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-58-shlok-8",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "सपुत्रराज्यां सिद्धार्थां मृतपुत्रा तपस्विनी।",
          "उपस्थास्यति कौसल्या कच्चित् सौम्येन कैकयीम्॥८॥",
          "यदि जीवति वैदेही गमिष्याम्याश्रमं पुनः।",
          "संवृत्ता यदि वृत्ता सा प्राणांस्त्यक्ष्यामि लक्ष्मण॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-58",
    "chapterName": "अरण्यकाण्ड, सर्ग 58",
    "verseNumber": 8
  },
  {
    "id": "valmiki-ramayana-3-sarga-58-shlok-10",
    "collectionId": "valmiki-ramayana",
    "index": 8342,
    "titleDevanagari": "वाल्मीकि रामायण, अरण्यकाण्ड, सर्ग 58, श्लोक 10",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-58-shlok-10",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "यदि मामाश्रमगतं वैदेही नाभिभाषते।",
          "पुरः प्रहसिता सीता विनशिष्यामि लक्ष्मण॥ १०॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-58",
    "chapterName": "अरण्यकाण्ड, सर्ग 58",
    "verseNumber": 10
  },
  {
