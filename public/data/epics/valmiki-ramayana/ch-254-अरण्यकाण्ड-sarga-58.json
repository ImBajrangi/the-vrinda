      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "विगर्हमाणोऽनुजमार्तरूपं क्षुधाश्रमेणैव पिपासया च।",
          "विनिःश्वसन् शुष्कमुखो विषण्णः प्रतिश्रयं प्राप्य समीक्ष्य शून्यम्॥१९॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-58",
