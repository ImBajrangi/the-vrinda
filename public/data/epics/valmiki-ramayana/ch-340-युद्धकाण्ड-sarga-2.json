    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "समुद्रं लवयित्वा तु महानक्रसमाकुलम्।",
          "लङ्कामारोहयिष्यामो हनिष्यामश्च ते रिपुम्॥५॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-2",
    "chapterName": "युद्धकाण्ड, सर्ग 2",
    "verseNumber": 5
  },
  {
