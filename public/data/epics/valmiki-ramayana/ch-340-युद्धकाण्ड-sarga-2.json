    "slug": "valmiki-ramayana-6-sarga-2-shlok-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "करना तं तु शोकपरिघुनं रामं दशरथात्मजम्।",
          "उवाच वचनं श्रीमान् सुग्रीवः शोकनाशनम्॥ १॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-2",
    "chapterName": "युद्धकाण्ड, सर्ग 2",
    "verseNumber": 1
  },
  {
    "id": "valmiki-ramayana-6-sarga-2-shlok-2",
