    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-6-sarga-2-shlok-7",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "इमे शूराः समर्थाश्च सर्वतो हरियूथपाः।",
          "त्वत्प्रियार्थं कृतोत्साहाः प्रवेष्टमपि पावकम्।",
          "एषां हर्षेण जानामि तर्कश्चापि दृढो मम॥७॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-2",
    "chapterName": "युद्धकाण्ड, सर्ग 2",
    "verseNumber": 7
  },
  {
