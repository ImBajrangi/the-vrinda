    "titleDevanagari": "वाल्मीकि रामायण, युद्धकाण्ड, सर्ग 2, श्लोक 2",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-6-sarga-2-shlok-2",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "॥ श्रीसीतारामचन्द्राभ्यां नमः॥",
          "श्रीमद्वाल्मीकीय रामायण",
          "युद्धकाण्डम्",
          "द्वितीयः सर्गः (2)",
          "किं त्वया तप्यते वीर यथान्यः प्राकृतस्तथा।",
          "मैवं भूस्त्यज संतापं कृतघ्न इव सौहृदम्॥२॥",
          "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये युद्धकाण्डे द्वितीयः सर्गः॥२॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-2",
    "chapterName": "युद्धकाण्ड, सर्ग 2",
    "verseNumber": 2
  },
  {
    "id": "valmiki-ramayana-6-sarga-2-shlok-3",
    "collectionId": "valmiki-ramayana",
    "index": 11290,
    "titleDevanagari": "वाल्मीकि रामायण, युद्धकाण्ड, सर्ग 2, श्लोक 3",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-6-sarga-2-shlok-3",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "संतापस्य च ते स्थानं नहि पश्यामि राघव।",
          "प्रवृत्तावुपलब्धायां ज्ञाते च निलये रिपोः॥३॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-2",
    "chapterName": "युद्धकाण्ड, सर्ग 2",
    "verseNumber": 3
  },
  {
