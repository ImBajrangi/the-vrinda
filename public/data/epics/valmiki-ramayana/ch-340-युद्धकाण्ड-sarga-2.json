    "slug": "valmiki-ramayana-6-sarga-2-shlok-8",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "विक्रमेण समानेष्ये सीतां हत्वा यथा रिपुम्।",
          "रावणं पापकर्माणं तथा त्वं कर्तुमर्हसि॥८॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-2",
    "chapterName": "युद्धकाण्ड, सर्ग 2",
    "verseNumber": 8
  },
