    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-6-sarga-2-shlok-4",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "मतिमान् शास्त्रवित् प्राज्ञः पण्डितश्चासि राघव।",
          "त्यजेमां प्राकृतां बुद्धिं कृतात्मेवार्थदूषिणीम्॥४॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-2",
    "chapterName": "युद्धकाण्ड, सर्ग 2",
    "verseNumber": 4
  },
