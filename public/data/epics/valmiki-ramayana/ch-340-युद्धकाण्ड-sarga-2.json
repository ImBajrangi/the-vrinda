    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-6-sarga-2-shlok-6",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "निरुत्साहस्य दीनस्य शोकपर्याकुलात्मनः।",
          "सर्वार्था व्यवसीदन्ति व्यसनं चाधिगच्छति॥६॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-2",
    "chapterName": "युद्धकाण्ड, सर्ग 2",
    "verseNumber": 6
  },
  {
