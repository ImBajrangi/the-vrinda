    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "प्रत्याश्वस्तो यदा राजा मोहात् प्रत्यागतस्मृतिः।",
          "तदाजुहाव तं सूतं रामवृत्तान्तकारणात्॥१॥"
        ]
      }
    ],
    "chapterId": "अयोध्याकाण्ड-sarga-58",
    "chapterName": "अयोध्याकाण्ड, सर्ग 58",
    "verseNumber": 1
  },
  {
