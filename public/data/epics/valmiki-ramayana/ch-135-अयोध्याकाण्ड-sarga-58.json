    "slug": "valmiki-ramayana-2-sarga-58-shlok-2",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "तदा सूतो महाराजं कृताञ्जलिरुपस्थितः।",
          "राममेवानुशोचन्तं दुःखशोकसमन्वितम्॥२॥"
        ]
      }
    ],
    "chapterId": "अयोध्याकाण्ड-sarga-58",
    "chapterName": "अयोध्याकाण्ड, सर्ग 58",
    "verseNumber": 2
  },
  {
    "id": "valmiki-ramayana-2-sarga-58-shlok-4",
