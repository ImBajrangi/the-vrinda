        "linesDevanagari": [
          "दुःखस्यानुचितो दुःखं सुमन्त्र शयनोचितः।",
          "भूमिपालात्मजो भूमौ शेते कथमनाथवत्॥६॥"
        ]
      }
    ],
    "chapterId": "अयोध्याकाण्ड-sarga-58",
    "chapterName": "अयोध्याकाण्ड, सर्ग 58",
    "verseNumber": 6
  },
