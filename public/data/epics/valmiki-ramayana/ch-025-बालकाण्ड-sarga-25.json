    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 25, श्लोक 29",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-25-shlok-29",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "आरोग्य शिबिकां चैव वालिनं गतजीवितम्।",
          "अलंकारैश्च विविधर्माल्यैर्वस्त्रैश्च भूषितम्॥ २९॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-25",
    "chapterName": "बालकाण्ड, सर्ग 25",
    "verseNumber": 29
  },
  {
