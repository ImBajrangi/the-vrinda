    "slug": "valmiki-ramayana-1-sarga-25-shlok-8-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "किं तु कालपरीणामो द्रष्टव्यः साधु पश्यता।",
          "धर्मश्चार्थश्च कामश्च कालक्रमसमाहिताः॥८॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-25",
    "chapterName": "बालकाण्ड, सर्ग 25",
    "verseNumber": 8
  },
  {
