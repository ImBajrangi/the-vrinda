    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-25-shlok-16",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "ततो गत्वा दशग्रीवः सपुत्रः सविभीषणः।",
          "स्त्रियोऽवतारयामास सर्वास्ता बाष्पगद्गदाः॥१६॥",
          "लक्षिण्यो रत्नभूताश्च देवदानवरक्षसाम्।",
          "तस्य तासु मतिं ज्ञात्वा धर्मात्मा वाक्यमब्रवीत्॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-25",
    "chapterName": "बालकाण्ड, सर्ग 25",
    "verseNumber": 16
  },
