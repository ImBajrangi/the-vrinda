    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "कामगं स्यन्दनं दिव्यमन्तरिक्षचरं ध्रुवम्।",
          "मायां च तामसी नाम यया सम्पद्यते तमः॥१०॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-25",
    "chapterName": "बालकाण्ड, सर्ग 25",
    "verseNumber": 10
