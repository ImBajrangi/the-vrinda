    "slug": "valmiki-ramayana-1-sarga-25-shlok-14-2",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "ततोऽब्रवीद् दशग्रीवो न शोभनमिदं कृतम्।",
          "पूजिताः शत्रवो यस्माद् द्रव्यैरिन्द्रपुरोगमाः॥१४॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-25",
