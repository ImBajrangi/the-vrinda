    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 25, श्लोक 1",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-25-shlok-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "स सुग्रीवं च तारां च साङ्गदां सहलक्ष्मणः।",
          "समानशोकः काकुत्स्थः सान्त्वयन्निदमब्रवीत्॥ १॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-25",
    "chapterName": "बालकाण्ड, सर्ग 25",
    "verseNumber": 1
  },
  {
    "id": "valmiki-ramayana-1-sarga-25-shlok-2",
    "collectionId": "valmiki-ramayana",
    "index": 1208,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 25, श्लोक 2",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-25-shlok-2",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "ततो निकुम्भिला नाम लङ्कोपवनमुत्तमम्।",
          "तद राक्षसेन्द्रो बलवान् प्रविवेश सहानुगः ॥२॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-25",
    "chapterName": "बालकाण्ड, सर्ग 25",
    "verseNumber": 2
  },
  {
    "id": "valmiki-ramayana-1-sarga-25-shlok-3",
    "collectionId": "valmiki-ramayana",
    "index": 1209,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 25, श्लोक 3",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-25-shlok-3",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "ततो यूपशताकीर्णं सौम्यचैत्योपशोभितम्।",
          "ददर्श विष्ठितं यज्ञं श्रिया सम्प्रज्वलन्निव॥३॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-25",
    "chapterName": "बालकाण्ड, सर्ग 25",
    "verseNumber": 3
  },
  {
    "id": "valmiki-ramayana-1-sarga-25-shlok-4-1",
    "collectionId": "valmiki-ramayana",
    "index": 1210,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 25, श्लोक 4",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-25-shlok-4-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "नियतिः कारणं लोके नियतिः कर्मसाधनम्।",
          "नियतिः सर्वभूतानां नियोगेष्विह कारणम्॥४॥",
          "न कर्ता कस्यचित् कश्चिन्नियोगे नापि चेश्वरः।",
          "स्वभावे वर्तते लोकस्तस्य कालः परायणम्॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-25",
    "chapterName": "बालकाण्ड, सर्ग 25",
    "verseNumber": 4
  },
  {
    "id": "valmiki-ramayana-1-sarga-25-shlok-5",
    "collectionId": "valmiki-ramayana",
    "index": 1211,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 25, श्लोक 5",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-25-shlok-5",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "तं समासाद्य लङ्केशः परिष्वज्याथ बाहुभिः।",
          "अब्रवीत् किमिदं वत्स वर्तसे ब्रूहि तत्त्वतः॥५॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-25",
    "chapterName": "बालकाण्ड, सर्ग 25",
    "verseNumber": 5
  },
  {
