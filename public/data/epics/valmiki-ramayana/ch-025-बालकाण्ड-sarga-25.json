    "slug": "valmiki-ramayana-1-sarga-25-shlok-28",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "ततो वालिनमुद्यम्य सुग्रीवः शिबिकां तदा।",
          "आरोपयत विक्रोशन्नङ्गदेन सहैव तु॥२८॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-25",
    "chapterName": "बालकाण्ड, सर्ग 25",
    "verseNumber": 28
  },
  {
