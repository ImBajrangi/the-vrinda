    "slug": "valmiki-ramayana-1-sarga-25-shlok-11-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "एतया किल संग्रामे मायया राक्षसेश्वर।",
          "प्रयुक्तया गतिः शक्या नहि ज्ञातुं सुरासुरैः॥११॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-25",
    "chapterName": "बालकाण्ड, सर्ग 25",
    "verseNumber": 11
  },
  {
