    "slug": "valmiki-ramayana-1-sarga-25-shlok-7-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "न कालस्यास्ति बन्धुत्वं न हेतुर्न पराक्रमः।",
          "न मित्रज्ञातिसम्बन्धः कारणं नात्मनो वशः॥७॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-25",
    "chapterName": "बालकाण्ड, सर्ग 25",
    "verseNumber": 7
  },
  {
