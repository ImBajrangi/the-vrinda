      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "ईदृशीं शिबिकां दृष्ट्वा रामो लक्ष्मणमब्रवीत्।",
          "क्षिप्रं विनीयतां वाली प्रेतकार्यं विधीयताम्॥ २७॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-25",
    "chapterName": "बालकाण्ड, सर्ग 25",
    "verseNumber": 27
  },
  {
    "id": "valmiki-ramayana-1-sarga-25-shlok-28",
    "collectionId": "valmiki-ramayana",
    "index": 1234,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 25, श्लोक 28",
