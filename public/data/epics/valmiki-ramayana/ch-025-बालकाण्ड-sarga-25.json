      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "स तु गत्वा मधुपुरं प्रविश्य च दशाननः॥३८॥",
          "न ददर्श मधुं तत्र भगिनीं तत्र दृष्टवान्।"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-25",
    "chapterName": "बालकाण्ड, सर्ग 25",
    "verseNumber": 38
