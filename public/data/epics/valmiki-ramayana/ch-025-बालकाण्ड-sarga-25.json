    "slug": "valmiki-ramayana-1-sarga-25-shlok-13-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "कुरु त्वमस्य सुग्रीव प्रेतकार्यमनन्तरम्।",
          "ताराङ्गदाभ्यां सहितो वालिनो दहनं प्रति॥१३॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-25",
    "chapterName": "बालकाण्ड, सर्ग 25",
