    "slug": "valmiki-ramayana-1-sarga-25-shlok-6-2",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "उशना त्वब्रवीत् तत्र यज्ञसम्पत्समृद्धये।",
          "रावणं राक्षसश्रेष्ठं द्विजश्रेष्ठो महातपाः॥६॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-25",
    "chapterName": "बालकाण्ड, सर्ग 25",
    "verseNumber": 6
  },
  {
