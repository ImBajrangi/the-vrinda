      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "एहीदानीं कृतं यद्धि सुकृतं तन्न संशयः।",
          "आगच्छ सौम्य गच्छामः स्वमेव भवनं प्रति॥१५॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-25",
    "chapterName": "बालकाण्ड, सर्ग 25",
