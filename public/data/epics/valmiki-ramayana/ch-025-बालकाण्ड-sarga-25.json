    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 25, श्लोक 32",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-25-shlok-32",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "राज्ञामृद्धिविशेषा हि दृश्यन्ते भुवि यादृशाः।",
          "तादृशैरिह कुर्वन्तु वानरा भर्तृसक्रियाम्॥३२॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-25",
    "chapterName": "बालकाण्ड, सर्ग 25",
    "verseNumber": 32
  },
  {
