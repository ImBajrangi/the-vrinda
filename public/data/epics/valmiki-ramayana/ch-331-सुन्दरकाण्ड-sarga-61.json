    "slug": "valmiki-ramayana-5-sarga-61-shlok-2",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "प्रीतिमन्तस्ततः सर्वे वायुपुत्रपुरःसराः।",
          "महेन्द्राग्रात् समुत्पत्य पुप्लुवुः प्लवगर्षभाः॥२॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-61",
    "chapterName": "सुन्दरकाण्ड, सर्ग 61",
    "verseNumber": 2
  },
  {
