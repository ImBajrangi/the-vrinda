    "slug": "valmiki-ramayana-5-sarga-61-shlok-4",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "सभाज्यमानं भूतैस्तमात्मवन्तं महाबलम्।",
          "हनूमन्तं महावेगं वहन्त इव दृष्टिभिः॥४॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-61",
    "chapterName": "सुन्दरकाण्ड, सर्ग 61",
    "verseNumber": 4
  },
  {
