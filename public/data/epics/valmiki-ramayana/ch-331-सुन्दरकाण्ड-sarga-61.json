    "slug": "valmiki-ramayana-5-sarga-61-shlok-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "ततो जाम्बवतो वाक्यमगृह्णन्त वनौकसः।",
          "अङ्गदप्रमुखा वीरा हनूमांश्च महाकपिः॥१॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-61",
    "chapterName": "सुन्दरकाण्ड, सर्ग 61",
    "verseNumber": 1
  },
  {
