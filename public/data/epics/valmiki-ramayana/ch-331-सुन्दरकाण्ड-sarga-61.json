        "linesDevanagari": [
          "यत् तन्मधुवनं नाम सुग्रीवस्याभिरक्षितम्।",
          "अधृष्यं सर्वभूतानां सर्वभूतमनोहरम्॥८॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-61",
    "chapterName": "सुन्दरकाण्ड, सर्ग 61",
    "verseNumber": 8
