        "linesDevanagari": [
          "प्लवमानाः खमाप्लुत्य ततस्ते काननौकसः।",
          "नन्दनोपममासेदुर्वनं द्रुमशतायुतम्॥७॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-61",
    "chapterName": "सुन्दरकाण्ड, सर्ग 61",
    "verseNumber": 7
  },
