    "slug": "valmiki-ramayana-5-sarga-61-shlok-3",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "मेरुमन्दरसंकाशा मत्ता इव महागजाः।",
          "छादयन्त इवाकाशं महाकाया महाबलाः॥३॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-61",
    "chapterName": "सुन्दरकाण्ड, सर्ग 61",
    "verseNumber": 3
  },
