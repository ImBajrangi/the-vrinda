        "linesDevanagari": [
          "ततः प्रबुद्धो भरतस्तं घोषं संनिवर्त्य च।",
          "नाहं राजेति चोक्त्वा तं शत्रुघ्नमिदमब्रवीत्॥४॥"
        ]
      }
    ],
    "chapterId": "अयोध्याकाण्ड-sarga-81",
    "chapterName": "अयोध्याकाण्ड, सर्ग 81",
    "verseNumber": 4
  },
