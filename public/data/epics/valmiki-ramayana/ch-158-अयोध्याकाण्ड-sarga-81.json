    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "स तूर्यघोषः सुमहान् दिवमापूरयन्निव।",
          "भरतं शोकसंतप्तं भूयः शोकैररन्धयत्॥३॥"
        ]
      }
    ],
    "chapterId": "अयोध्याकाण्ड-sarga-81",
    "chapterName": "अयोध्याकाण्ड, सर्ग 81",
    "verseNumber": 3
  },
  {
