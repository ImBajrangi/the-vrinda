    "slug": "valmiki-ramayana-2-sarga-81-shlok-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "ततो नान्दीमुखीं रात्रिं भरतं सूतमागधाः।",
          "तुष्टुवुः सविशेषज्ञाः स्तवैर्मङ्गलसंस्तवैः॥१॥",
          "इधर",
          "अयोध्या"
        ]
      }
    ],
    "chapterId": "अयोध्याकाण्ड-sarga-81",
    "chapterName": "अयोध्याकाण्ड, सर्ग 81",
    "verseNumber": 1
  },
