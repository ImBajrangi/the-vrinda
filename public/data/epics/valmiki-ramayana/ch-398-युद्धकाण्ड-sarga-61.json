    "titleDevanagari": "वाल्मीकि रामायण, युद्धकाण्ड, सर्ग 61, श्लोक 1",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-6-sarga-61-shlok-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "ततो रामो महातेजा धनुरादाय वीर्यवान्।",
          "किरीटिनं महाकायं कुम्भकर्णं ददर्श ह॥१॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-61",
    "chapterName": "युद्धकाण्ड, सर्ग 61",
    "verseNumber": 1
  },
  {
    "id": "valmiki-ramayana-6-sarga-61-shlok-3",
    "collectionId": "valmiki-ramayana",
    "index": 13404,
    "titleDevanagari": "वाल्मीकि रामायण, युद्धकाण्ड, सर्ग 61, श्लोक 3",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-6-sarga-61-shlok-3",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "तं दृष्ट्वा राक्षसश्रेष्ठं पर्वताकारदर्शनम्।",
          "क्रममाणमिवाकाशं पुरा नारायणं यथा॥२॥",
          "सतोयाम्बुदसंकाशं काञ्चनाङ्गदभूषणम्।",
          "दृष्ट्वा पुनः प्रदुद्राव वानराणां महाचमूः॥३॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-61",
    "chapterName": "युद्धकाण्ड, सर्ग 61",
    "verseNumber": 3
  },
  {
    "id": "valmiki-ramayana-6-sarga-61-shlok-4",
    "collectionId": "valmiki-ramayana",
    "index": 13405,
    "titleDevanagari": "वाल्मीकि रामायण, युद्धकाण्ड, सर्ग 61, श्लोक 4",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-6-sarga-61-shlok-4",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "विद्रुतां वाहिनीं दृष्ट्वा वर्धमानं च राक्षसम्।",
          "सविस्मितमिदं रामो विभीषणमुवाच ह॥४॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-61",
    "chapterName": "युद्धकाण्ड, सर्ग 61",
    "verseNumber": 4
  },
  {
    "id": "valmiki-ramayana-6-sarga-61-shlok-5",
    "collectionId": "valmiki-ramayana",
    "index": 13406,
    "titleDevanagari": "वाल्मीकि रामायण, युद्धकाण्ड, सर्ग 61, श्लोक 5",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-6-sarga-61-shlok-5",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "कोऽसौ पर्वतसंकाशः किरीटी हरिलोचनः।",
          "लङ्कायां दृश्यते वीरः सविद्युदिव तोयदः॥५॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-61",
    "chapterName": "युद्धकाण्ड, सर्ग 61",
    "verseNumber": 5
  },
  {
    "id": "valmiki-ramayana-6-sarga-61-shlok-6",
    "collectionId": "valmiki-ramayana",
    "index": 13407,
    "titleDevanagari": "वाल्मीकि रामायण, युद्धकाण्ड, सर्ग 61, श्लोक 6",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-6-sarga-61-shlok-6",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "पृथिव्यां केतुभूतोऽसौ महानेकोऽत्र दृश्यते।",
          "यं दृष्ट्वा वानराः सर्वे विद्रवन्ति ततस्ततः॥६॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-61",
    "chapterName": "युद्धकाण्ड, सर्ग 61",
    "verseNumber": 6
  },
  {
    "id": "valmiki-ramayana-6-sarga-61-shlok-7",
    "collectionId": "valmiki-ramayana",
    "index": 13408,
    "titleDevanagari": "वाल्मीकि रामायण, युद्धकाण्ड, सर्ग 61, श्लोक 7",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-6-sarga-61-shlok-7",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "आचक्ष्व सुमहान् कोऽसौ रक्षो वा यदि वासुरः।",
          "न मयैवंविधं भूतं दृष्टपूर्वं कदाचन॥७॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-61",
    "chapterName": "युद्धकाण्ड, सर्ग 61",
    "verseNumber": 7
  },
  {
