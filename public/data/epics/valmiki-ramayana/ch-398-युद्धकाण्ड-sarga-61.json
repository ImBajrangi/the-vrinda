    "titleDevanagari": "वाल्मीकि रामायण, युद्धकाण्ड, सर्ग 61, श्लोक 8",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-6-sarga-61-shlok-8",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "सम्पृष्टो राजपुत्रेण रामेणाक्लिष्टकर्मणा।",
          "विभीषणो महाप्राज्ञः काकुत्स्थमिदमब्रवीत्॥८॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-61",
    "chapterName": "युद्धकाण्ड, सर्ग 61",
    "verseNumber": 8
  },
  {
    "id": "valmiki-ramayana-6-sarga-61-shlok-9",
    "collectionId": "valmiki-ramayana",
    "index": 13410,
    "titleDevanagari": "वाल्मीकि रामायण, युद्धकाण्ड, सर्ग 61, श्लोक 9",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-6-sarga-61-shlok-9",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "येन वैवस्वतो युद्धे वासवश्च पराजितः।",
          "सैष विश्रवसः पुत्रः कुम्भकर्णः प्रतापवान्।",
          "अस्य प्रमाणसदृशो राक्षसोऽन्यो न विद्यते॥९॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-61",
    "chapterName": "युद्धकाण्ड, सर्ग 61",
    "verseNumber": 9
  },
  {
    "id": "valmiki-ramayana-6-sarga-61-shlok-10",
    "collectionId": "valmiki-ramayana",
    "index": 13411,
    "titleDevanagari": "वाल्मीकि रामायण, युद्धकाण्ड, सर्ग 61, श्लोक 10",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-6-sarga-61-shlok-10",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "एतेन देवा युधि दानवाश्च यक्षा भुजंगाः पिशिताशनाश्च।",
          "गन्धर्वविद्याधरकिंनराश्च सहस्रशो राघव सम्प्रभग्नाः॥१०॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-61",
    "chapterName": "युद्धकाण्ड, सर्ग 61",
    "verseNumber": 10
  },
  {
    "id": "valmiki-ramayana-6-sarga-61-shlok-11",
    "collectionId": "valmiki-ramayana",
    "index": 13412,
    "titleDevanagari": "वाल्मीकि रामायण, युद्धकाण्ड, सर्ग 61, श्लोक 11",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-6-sarga-61-shlok-11",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "शूलपाणिं विरूपाक्षं कुम्भकर्णं महाबलम्।",
          "हन्तुं न शेकुस्त्रिदशाः कालोऽयमिति मोहिताः॥११॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-61",
    "chapterName": "युद्धकाण्ड, सर्ग 61",
    "verseNumber": 11
  },
  {
