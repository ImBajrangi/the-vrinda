    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-6-sarga-61-shlok-14",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "तेषु सम्भक्ष्यमाणेषु प्रजा भयनिपीडिताः।",
          "यान्त स्म शरणं शक्रं तमप्यर्थं न्यवेदयन्॥१४॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-61",
    "chapterName": "युद्धकाण्ड, सर्ग 61",
    "verseNumber": 14
  },
  {
