    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-6-sarga-61-shlok-13",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "बालेन जातमात्रेण क्षुधार्तेन महात्मना।",
          "भक्षितानि सहस्राणि प्रजानां सुबहून्यपि॥१३॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-61",
    "chapterName": "युद्धकाण्ड, सर्ग 61",
    "verseNumber": 13
  },
  {
