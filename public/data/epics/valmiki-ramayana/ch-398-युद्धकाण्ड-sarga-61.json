    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-6-sarga-61-shlok-12",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "प्रकृत्या ह्येष तेजस्वी कुम्भकर्णो महाबलः।",
          "अन्येषां राक्षसेन्द्राणां वरदानकृतं बलम्॥१२॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-61",
    "chapterName": "युद्धकाण्ड, सर्ग 61",
    "verseNumber": 12
  },
  {
