    "index": 8696,
    "titleDevanagari": "वाल्मीकि रामायण, अरण्यकाण्ड, सर्ग 72, श्लोक 20",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-72-shlok-20",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "कृतार्थो वाकृतार्थो वा तव कृत्यं करिष्यति।",
          "स ऋक्षरजसः पुत्रः पम्पामटति शङ्कितः॥२०॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-72",
    "chapterName": "अरण्यकाण्ड, सर्ग 72",
    "verseNumber": 20
  },
  {
    "id": "valmiki-ramayana-3-sarga-72-shlok-21",
    "collectionId": "valmiki-ramayana",
    "index": 8697,
    "titleDevanagari": "वाल्मीकि रामायण, अरण्यकाण्ड, सर्ग 72, श्लोक 21",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-72-shlok-21",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "भास्करस्यौरसः पुत्रो वालिना कृतकिल्बिषः।",
          "संनिधायायुधं क्षिप्रमृष्यमूकालयं कपिम्॥२१॥",
          "कुरु राघव सत्येन वयस्यं वनचारिणम्।",
          "स हि स्थानानि कात्स्न्येन सर्वाणि कपिकुञ्जरः॥ २२॥",
          "नरमांसाशिनां लोके नैपुण्यादधिगच्छति।",
          "न तस्याविदितं लोके किंचिदस्ति हि राघव॥ २३॥",
          "यावत् सूर्यः प्रतपति सहस्रांशुः परंतप।",
          "स नदीर्विपुलान् शैलान् गिरिदुर्गाणि कन्दरान्॥ २४॥",
          "अन्विष्य वानरैः सार्धं पत्नीं तेऽधिगमिष्यति।"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-72",
    "chapterName": "अरण्यकाण्ड, सर्ग 72",
    "verseNumber": 21
  },
  {
