    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-72-shlok-10",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "तदवश्यं त्वया कार्यः स सुहृत् सुहृदां वर।",
          "अकृत्वा नहि ते सिद्धिमहं पश्यामि चिन्तयन्॥ १०॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-72",
    "chapterName": "अरण्यकाण्ड, सर्ग 72",
    "verseNumber": 10
  },
  {
