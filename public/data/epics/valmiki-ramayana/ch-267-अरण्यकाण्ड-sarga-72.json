    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-72-shlok-26",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "वानरांश्च महाकायान् प्रेषयिष्यति राघव॥२५॥",
          "दिशो विचेतुं तां सीतां त्वद्वियोगेन शोचतीम्।",
          "अन्वेष्यति वरारोहां मैथिली रावणालये॥२६॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-72",
    "chapterName": "अरण्यकाण्ड, सर्ग 72",
    "verseNumber": 26
  },
  {
