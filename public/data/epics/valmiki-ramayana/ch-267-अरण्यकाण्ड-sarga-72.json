    "slug": "valmiki-ramayana-3-sarga-72-shlok-11",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "श्रूयतां राम वक्ष्यामि सुग्रीवो नाम वानरः।",
          "भ्रात्रा निरस्तः क्रुद्धेन वालिना शक्रसूनुना॥११॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-72",
    "chapterName": "अरण्यकाण्ड, सर्ग 72",
    "verseNumber": 11
  },
  {
    "id": "valmiki-ramayana-3-sarga-72-shlok-12",
    "collectionId": "valmiki-ramayana",
    "index": 8690,
    "titleDevanagari": "वाल्मीकि रामायण, अरण्यकाण्ड, सर्ग 72, श्लोक 12",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-72-shlok-12",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "ऋष्यमूके गिरिवरे पम्पापर्यन्तशोभिते।",
          "निवसत्यात्मवान् वीरश्चतुर्भिः सह वानरैः॥ १२॥",
          "वानरेन्द्रो महावीर्यस्तेजोवानमितप्रभः।",
          "सत्यसंधो विनीतश्च धृतिमान् मतिमान् महान्॥ १३॥",
          "दक्षः प्रगल्भो द्युतिमान् महाबलपराक्रमः।"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-72",
    "chapterName": "अरण्यकाण्ड, सर्ग 72",
    "verseNumber": 12
  },
  {
    "id": "valmiki-ramayana-3-sarga-72-shlok-14",
    "collectionId": "valmiki-ramayana",
    "index": 8691,
    "titleDevanagari": "वाल्मीकि रामायण, अरण्यकाण्ड, सर्ग 72, श्लोक 14",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-72-shlok-14",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "भ्रात्रा विवासितो वीर राज्यहेतोर्महात्मना॥१४॥",
          "स ते सहायो मित्रं च सीतायाः परिमार्गणे।",
          "भविष्यति हि ते राम मा च शोके मनः कृथाः॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-72",
    "chapterName": "अरण्यकाण्ड, सर्ग 72",
    "verseNumber": 14
  },
  {
    "id": "valmiki-ramayana-3-sarga-72-shlok-16",
    "collectionId": "valmiki-ramayana",
    "index": 8692,
    "titleDevanagari": "वाल्मीकि रामायण, अरण्यकाण्ड, सर्ग 72, श्लोक 16",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-72-shlok-16",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "भवितव्यं हि तच्चापि न तच्छक्यमिहान्यथा।",
          "कर्तुमिक्ष्वाकुशार्दूल कालो हि दुरतिक्रमः॥१६॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-72",
    "chapterName": "अरण्यकाण्ड, सर्ग 72",
    "verseNumber": 16
  },
