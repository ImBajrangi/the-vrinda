    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-72-shlok-4",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "सविधूय चितामाशु विधूमोऽग्निरिवोत्थितः।",
          "अरजे वाससी बिभ्रन्माल्यं दिव्यं महाबलः॥४॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-72",
    "chapterName": "अरण्यकाण्ड, सर्ग 72",
    "verseNumber": 4
  },
  {
    "id": "valmiki-ramayana-3-sarga-72-shlok-5",
    "collectionId": "valmiki-ramayana",
    "index": 8685,
    "titleDevanagari": "वाल्मीकि रामायण, अरण्यकाण्ड, सर्ग 72, श्लोक 5",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-72-shlok-5",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "ततश्चिताया वेगेन भास्वरो विरजाम्बरः।",
          "उत्पपाताशु संहृष्टः सर्वप्रत्यङ्गभूषणः॥५॥",
          "विमाने भास्वरे तिष्ठन् हंसयुक्ते यशस्करे।",
          "प्रभया च महातेजा दिशो दश विराजयन्॥६॥",
          "सोऽन्तरिक्षगतो वाक्यं कबन्धो राममब्रवीत्।"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-72",
    "chapterName": "अरण्यकाण्ड, सर्ग 72",
    "verseNumber": 5
  },
  {
    "id": "valmiki-ramayana-3-sarga-72-shlok-8",
    "collectionId": "valmiki-ramayana",
    "index": 8686,
    "titleDevanagari": "वाल्मीकि रामायण, अरण्यकाण्ड, सर्ग 72, श्लोक 8",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-72-shlok-8",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "शृणु राघव तत्त्वेन यथा सीतामवाप्स्यसि॥७॥",
          "राम षड् युक्तयो लोके याभिः सर्वं विमृश्यते।",
          "परिमृष्टो दशान्तेन दशाभागेन सेव्यते॥८॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-72",
    "chapterName": "अरण्यकाण्ड, सर्ग 72",
    "verseNumber": 8
  },
  {
    "id": "valmiki-ramayana-3-sarga-72-shlok-9",
    "collectionId": "valmiki-ramayana",
    "index": 8687,
    "titleDevanagari": "वाल्मीकि रामायण, अरण्यकाण्ड, सर्ग 72, श्लोक 9",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-72-shlok-9",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "दशाभागगतो हीनस्त्वं हि राम सलक्ष्मणः।",
          "यत्कृते व्यसनं प्राप्तं त्वया दारप्रधर्षणम्॥९॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-72",
    "chapterName": "अरण्यकाण्ड, सर्ग 72",
    "verseNumber": 9
  },
  {
