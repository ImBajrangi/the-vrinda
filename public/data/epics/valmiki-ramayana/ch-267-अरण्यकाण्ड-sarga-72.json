    "titleDevanagari": "वाल्मीकि रामायण, अरण्यकाण्ड, सर्ग 72, श्लोक 2",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-72-shlok-2",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "लक्ष्मणस्तु महोल्काभिर्खलिताभिः समन्ततः।",
          "चितामादीपयामास सा प्रजज्वाल सर्वतः॥२॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-72",
    "chapterName": "अरण्यकाण्ड, सर्ग 72",
    "verseNumber": 2
  },
  {
