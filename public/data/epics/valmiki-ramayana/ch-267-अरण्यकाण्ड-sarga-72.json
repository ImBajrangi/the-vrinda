    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-72-shlok-19",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "कृतज्ञः कामरूपी च सहायार्थी च वीर्यवान्।",
          "शक्तौ ह्यद्य युवां कर्तुं कार्यं तस्य चिकीर्षितम्॥ १९॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-72",
    "chapterName": "अरण्यकाण्ड, सर्ग 72",
    "verseNumber": 19
  },
  {
    "id": "valmiki-ramayana-3-sarga-72-shlok-20",
