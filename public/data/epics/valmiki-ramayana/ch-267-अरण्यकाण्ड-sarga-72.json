    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-72-shlok-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "एवमुक्तौ तु तौ वीरौ कबन्धेन नरेश्वरौ।",
          "गिरिप्रदरमासाद्य पावकं विससर्जतुः॥१॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-72",
    "chapterName": "अरण्यकाण्ड, सर्ग 72",
    "verseNumber": 1
  },
  {
