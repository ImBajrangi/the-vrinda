    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-72-shlok-17",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "गच्छ शीघ्रमितो वीर सुग्रीवं तं महाबलम्।",
          "वयस्यं तं कुरु क्षिप्रमितो गत्वाद्य राघव॥१७॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-72",
    "chapterName": "अरण्यकाण्ड, सर्ग 72",
    "verseNumber": 17
  },
  {
    "id": "valmiki-ramayana-3-sarga-72-shlok-18",
    "collectionId": "valmiki-ramayana",
