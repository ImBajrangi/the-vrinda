    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "तया महत्या यायिन्या ध्वजिन्या वनवासिनः।",
          "अर्दिता यूथपा मत्ताः सयूथाः सम्प्रदुद्रुवुः ॥१॥"
        ]
      }
    ],
    "chapterId": "अयोध्याकाण्ड-sarga-93",
    "chapterName": "अयोध्याकाण्ड, सर्ग 93",
