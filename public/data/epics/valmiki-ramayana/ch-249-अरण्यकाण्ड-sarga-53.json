    "slug": "valmiki-ramayana-3-sarga-53-shlok-11",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "नहि चक्षुःपथं प्राप्य तयोः पार्थिवपुत्रयोः।",
          "ससैन्योऽपि समर्थस्त्वं मुहूर्तमपि जीवितुम्॥११॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-53",
    "chapterName": "अरण्यकाण्ड, सर्ग 53",
    "verseNumber": 11
  },
