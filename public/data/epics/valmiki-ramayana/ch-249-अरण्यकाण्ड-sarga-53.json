    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "न त्वं तयोः शरस्पर्श सोढुं शक्तः कथंचन।",
          "वने प्रज्वलितस्येव स्पर्शमग्नेर्विहंगमः॥१२॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-53",
    "chapterName": "अरण्यकाण्ड, सर्ग 53",
    "verseNumber": 12
  },
  {
