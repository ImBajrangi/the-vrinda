    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-53-shlok-5",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "यो हि मामुद्यतस्त्रातुं सोऽप्ययं विनिपातितः।",
          "गृध्रराजः पुराणोऽसौ श्वशुरस्य सखा मम॥५॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-53",
    "chapterName": "अरण्यकाण्ड, सर्ग 53",
    "verseNumber": 5
  },
  {
    "id": "valmiki-ramayana-3-sarga-53-shlok-7",
    "collectionId": "valmiki-ramayana",
