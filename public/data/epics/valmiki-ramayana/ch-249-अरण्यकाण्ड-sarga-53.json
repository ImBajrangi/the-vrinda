    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-53-shlok-10",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "किं शक्यं कर्तुमेवं हि यज्जवेनैव धावसि।",
          "मुहूर्तमपि तिष्ठ त्वं न जीवन् प्रतियास्यसि॥१०॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-53",
    "chapterName": "अरण्यकाण्ड, सर्ग 53",
    "verseNumber": 10
  },
