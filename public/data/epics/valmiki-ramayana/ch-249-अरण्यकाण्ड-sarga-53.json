    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-53-shlok-13",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "साधु कृत्वाऽऽत्मनः पथ्यं साधु मां मुञ्च रावण।",
          "मत्प्रधर्षणसंक्रुद्धो भ्रात्रा सह पतिर्मम॥१३॥",
          "विधास्यति विनाशाय त्वं मां यदि न मुञ्चसि।"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-53",
    "chapterName": "अरण्यकाण्ड, सर्ग 53",
    "verseNumber": 13
