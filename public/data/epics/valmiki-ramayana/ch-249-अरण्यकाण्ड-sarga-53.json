    "titleDevanagari": "वाल्मीकि रामायण, अरण्यकाण्ड, सर्ग 53, श्लोक 7",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-53-shlok-7",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "परमं खलु ते वीर्यं दृश्यते राक्षसाधम।",
          "विश्राव्य नामधेयं हि युद्धे नास्मि जिता त्वया॥",
          "ईदृशं गर्हितं कर्म कथं कृत्वा न लज्जसे।",
          "स्त्रियाश्चाहरणं नीच रहिते च परस्य च॥७॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-53",
    "chapterName": "अरण्यकाण्ड, सर्ग 53",
    "verseNumber": 7
  },
  {
    "id": "valmiki-ramayana-3-sarga-53-shlok-8",
    "collectionId": "valmiki-ramayana",
    "index": 8219,
    "titleDevanagari": "वाल्मीकि रामायण, अरण्यकाण्ड, सर्ग 53, श्लोक 8",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-53-shlok-8",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "कथयिष्यन्ति लोकेषु पुरुषाः कर्म कुत्सितम्।",
          "सुनृशंसमधर्मिष्ठं तव शौटीर्यमानिनः॥८॥",
          "धिक् ते शौर्यं च सत्त्वं च यत्त्वया कथितं तदा।",
          "कुलाक्रोशकरं लोके धिक ते चारित्रमीदृशम्॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-53",
    "chapterName": "अरण्यकाण्ड, सर्ग 53",
    "verseNumber": 8
  },
  {
