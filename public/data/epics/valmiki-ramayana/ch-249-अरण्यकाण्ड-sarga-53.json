    "slug": "valmiki-ramayana-3-sarga-53-shlok-14",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "येन त्वं व्यवसायेन बलान्मां हर्तुमिच्छसि॥१४॥",
          "व्यवसायस्तु ते नीच भविष्यति निरर्थकः।।"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-53",
