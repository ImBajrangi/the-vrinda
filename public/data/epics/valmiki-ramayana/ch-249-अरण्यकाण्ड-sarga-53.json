    "titleDevanagari": "वाल्मीकि रामायण, अरण्यकाण्ड, सर्ग 53, श्लोक 2",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-53-shlok-2",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "रोषरोदनताम्राक्षी भीमाक्षं राक्षसाधिपम्।",
          "रुदती करुणं सीता ह्रियमाणा तमब्रवीत्॥२॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-53",
    "chapterName": "अरण्यकाण्ड, सर्ग 53",
    "verseNumber": 2
  },
  {
    "id": "valmiki-ramayana-3-sarga-53-shlok-3",
