    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "त्वयैव नूनं दुष्टात्मन् भीरुणा हर्तुमिच्छता।",
          "ममापवाहितो भर्ता मृगरूपेण मायया॥४॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-53",
    "chapterName": "अरण्यकाण्ड, सर्ग 53",
    "verseNumber": 4
  },
  {
