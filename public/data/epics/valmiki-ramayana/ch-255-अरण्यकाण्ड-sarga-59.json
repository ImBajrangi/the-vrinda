    "titleDevanagari": "वाल्मीकि रामायण, अरण्यकाण्ड, सर्ग 59, श्लोक 1",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-59-shlok-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "अथाश्रमादुपावृत्तमन्तरा रघुनन्दनः।",
          "परिपप्रच्छ सौमित्रिं रामो दुःखादिदं वचः॥१॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-59",
    "chapterName": "अरण्यकाण्ड, सर्ग 59",
    "verseNumber": 1
  },
  {
    "id": "valmiki-ramayana-3-sarga-59-shlok-2",
    "collectionId": "valmiki-ramayana",
    "index": 8354,
    "titleDevanagari": "वाल्मीकि रामायण, अरण्यकाण्ड, सर्ग 59, श्लोक 2",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-59-shlok-2",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "तमुवाच किमर्थं त्वमागतोऽपास्य मैथिलीम्।",
          "यदा सा तव विश्वासाद् वने विरहिता मया॥२॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-59",
    "chapterName": "अरण्यकाण्ड, सर्ग 59",
    "verseNumber": 2
  },
  {
    "id": "valmiki-ramayana-3-sarga-59-shlok-3",
    "collectionId": "valmiki-ramayana",
    "index": 8355,
    "titleDevanagari": "वाल्मीकि रामायण, अरण्यकाण्ड, सर्ग 59, श्लोक 3",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-59-shlok-3",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "दृष्ट्वैवाभ्यागतं त्वां मे मैथिलीं त्यज्य लक्ष्मण।",
          "शङ्कमानं महत् पापं यत्सत्यं व्यथितं मनः ॥ ३॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-59",
    "chapterName": "अरण्यकाण्ड, सर्ग 59",
    "verseNumber": 3
  },
  {
    "id": "valmiki-ramayana-3-sarga-59-shlok-4",
    "collectionId": "valmiki-ramayana",
    "index": 8356,
    "titleDevanagari": "वाल्मीकि रामायण, अरण्यकाण्ड, सर्ग 59, श्लोक 4",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-59-shlok-4",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "ङ्के स्फुरते नयन सव्यं बाहाचा हदयं च मे।",
          "दृष्ट्वा लक्ष्मण दूरे त्वां सीताविरहितं पथि॥४॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-59",
    "chapterName": "अरण्यकाण्ड, सर्ग 59",
    "verseNumber": 4
  },
  {
    "id": "valmiki-ramayana-3-sarga-59-shlok-5",
    "collectionId": "valmiki-ramayana",
    "index": 8357,
    "titleDevanagari": "वाल्मीकि रामायण, अरण्यकाण्ड, सर्ग 59, श्लोक 5",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-59-shlok-5",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "एवमुक्तस्तु सौमित्रिर्लक्ष्मणः शुभलक्षणः।",
          "भूयो दुःखसमाविष्टो दुःखितं राममब्रवीत्॥५॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-59",
    "chapterName": "अरण्यकाण्ड, सर्ग 59",
    "verseNumber": 5
  },
  {
    "id": "valmiki-ramayana-3-sarga-59-shlok-6",
    "collectionId": "valmiki-ramayana",
    "index": 8358,
    "titleDevanagari": "वाल्मीकि रामायण, अरण्यकाण्ड, सर्ग 59, श्लोक 6",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-59-shlok-6",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "न स्वयं कामकारेण तां त्यक्त्वाहमिहागतः।",
          "प्रचोदितस्तयैवोग्रैस्त्वत्सकाशमिहागतः॥६॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-59",
    "chapterName": "अरण्यकाण्ड, सर्ग 59",
    "verseNumber": 6
  },
  {
