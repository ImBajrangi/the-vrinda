    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "सा तमार्तस्वरं श्रुत्वा तव स्नेहेन मैथिली।",
          "गच्छ गच्छेति मामाशु रुदती भयविक्लवा॥८॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-59",
    "chapterName": "अरण्यकाण्ड, सर्ग 59",
    "verseNumber": 8
  },
