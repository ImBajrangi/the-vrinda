    "slug": "valmiki-ramayana-3-sarga-59-shlok-7",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "आर्येणेव परिक्रुष्टं लक्ष्मणेति सुविस्वरम्।",
          "परित्राहीति यद्वाक्यं मैथिल्यास्तच्छ्रुतिं गतम्॥ ७॥"
        ]
      }
