        "linesDevanagari": [
          "भूमीगृहांश्चैत्यगृहान् गृहातिगृहकानपि।",
          "उत्पतन् निपतंश्चापि तिष्ठन् गच्छन् पुनः क्वचित्॥१५॥"
        ]
      }
