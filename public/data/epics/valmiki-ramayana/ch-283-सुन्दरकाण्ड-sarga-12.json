      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "अनिर्वेदः श्रियो मूलमनिर्वेदः परं सुखम्।",
          "भूयस्तत्र विचेष्यामि न यत्र विचयः कृतः॥१०॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-12",
    "chapterName": "सुन्दरकाण्ड, सर्ग 12",
    "verseNumber": 10
  },
