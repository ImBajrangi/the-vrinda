    "slug": "valmiki-ramayana-5-sarga-12-shlok-8",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "अदृष्ट्वा किं प्रवक्ष्यामि तामहं जनकात्मजाम्।",
          "ध्रुवं प्रायमुपासिष्ये कालस्य व्यतिवर्तने॥८॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-12",
    "chapterName": "सुन्दरकाण्ड, सर्ग 12",
    "verseNumber": 8
  },
  {
    "id": "valmiki-ramayana-5-sarga-12-shlok-9",
