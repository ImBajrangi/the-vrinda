    "slug": "valmiki-ramayana-5-sarga-12-shlok-9",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "किं वा वक्ष्यति वृद्धश्च जाम्बवानंगदश्च सः।",
          "गतं पारं समुद्रस्य वानराश्च समागताः॥९॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-12",
    "chapterName": "सुन्दरकाण्ड, सर्ग 12",
    "verseNumber": 9
  },
  {
