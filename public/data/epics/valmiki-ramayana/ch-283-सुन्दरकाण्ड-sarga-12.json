[
  {
    "id": "valmiki-ramayana-5-sarga-12-shlok-1",
    "collectionId": "valmiki-ramayana",
    "index": 9344,
    "titleDevanagari": "वाल्मीकि रामायण, सुन्दरकाण्ड, सर्ग 12, श्लोक 1",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-5-sarga-12-shlok-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "स तस्य मध्ये भवनस्य संस्थितो लतागृहांश्चित्रगृहान् निशागृहान्।",
          "जगाम सीतां प्रतिदर्शनोत्सुको न चैव तां पश्यति चारुदर्शनाम्॥१॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-12",
    "chapterName": "सुन्दरकाण्ड, सर्ग 12",
    "verseNumber": 1
  },
  {
    "id": "valmiki-ramayana-5-sarga-12-shlok-2",
    "collectionId": "valmiki-ramayana",
    "index": 9345,
    "titleDevanagari": "वाल्मीकि रामायण, सुन्दरकाण्ड, सर्ग 12, श्लोक 2",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-5-sarga-12-shlok-2",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "स चिन्तयामास ततो महाकपिः प्रियामपश्यन् रघुनन्दनस्य ताम्।",
          "ध्रुवं न सीता ध्रियते यथा न मे विचिन्वतो दर्शनमेति मैथिली॥२॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-12",
    "chapterName": "सुन्दरकाण्ड, सर्ग 12",
    "verseNumber": 2
  },
  {
    "id": "valmiki-ramayana-5-sarga-12-shlok-3",
    "collectionId": "valmiki-ramayana",
    "index": 9346,
    "titleDevanagari": "वाल्मीकि रामायण, सुन्दरकाण्ड, सर्ग 12, श्लोक 3",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-5-sarga-12-shlok-3",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "सा राक्षसानां प्रवरेण जानकी स्वशीलसंरक्षणतत्परा सती।",
          "अनेन नूनं प्रति दुष्टकर्मणा हता भवेदार्यपथे परे स्थिता॥३॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-12",
    "chapterName": "सुन्दरकाण्ड, सर्ग 12",
    "verseNumber": 3
  },
  {
    "id": "valmiki-ramayana-5-sarga-12-shlok-4",
    "collectionId": "valmiki-ramayana",
    "index": 9347,
    "titleDevanagari": "वाल्मीकि रामायण, सुन्दरकाण्ड, सर्ग 12, श्लोक 4",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-5-sarga-12-shlok-4",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "विरूपरूपा विकृता विवर्चसो महानना दीर्घविरूपदर्शनाः।",
          "समीक्ष्य ता राक्षसराजयोषितो भयाद् विनष्टा जनकेश्वरात्मजा॥४॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-12",
    "chapterName": "सुन्दरकाण्ड, सर्ग 12",
    "verseNumber": 4
  },
  {
    "id": "valmiki-ramayana-5-sarga-12-shlok-5",
    "collectionId": "valmiki-ramayana",
    "index": 9348,
    "titleDevanagari": "वाल्मीकि रामायण, सुन्दरकाण्ड, सर्ग 12, श्लोक 5",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-5-sarga-12-shlok-5",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "सीतामदृष्ट्वा ह्यनवाप्य पौरुषं विहृत्य कालं सह वानरैश्चिरम्।",
          "न मेऽस्ति सुग्रीवसमीपगा गतिः सुतीक्ष्णदण्डो बलवांश्च वानरः॥५॥",
          "दृष्टमन्तःपुरं सर्वं दृष्टा रावणयोषितः।",
          "न सीता दृश्यते साध्वी वृथा जातो मम श्रमः॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-12",
    "chapterName": "सुन्दरकाण्ड, सर्ग 12",
    "verseNumber": 5
  },
  {
    "id": "valmiki-ramayana-5-sarga-12-shlok-7",
    "collectionId": "valmiki-ramayana",
    "index": 9349,
    "titleDevanagari": "वाल्मीकि रामायण, सुन्दरकाण्ड, सर्ग 12, श्लोक 7",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-5-sarga-12-shlok-7",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "किं नु मां वानराः सर्वे गतं वक्ष्यन्ति संगताः।",
          "गत्वा तत्र त्वया वीर किं कृतं तद् वदस्व नः॥७॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-12",
    "chapterName": "सुन्दरकाण्ड, सर्ग 12",
    "verseNumber": 7
  },
  {
    "id": "valmiki-ramayana-5-sarga-12-shlok-8",
