[
  {
    "id": "valmiki-ramayana-3-sarga-36-shlok-3",
    "collectionId": "valmiki-ramayana",
    "index": 7732,
    "titleDevanagari": "वाल्मीकि रामायण, अरण्यकाण्ड, सर्ग 36, श्लोक 3",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-36-shlok-3",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "जानीषे त्वं जनस्थानं भ्राता यत्र खरो मम।",
          "दूषणश्च महाबाहुः स्वसा शूर्पणखा च मे ॥२॥",
          "त्रिशिराश्च महाबाहू राक्षसः पिशिताशनः।",
          "अन्ये च बहवः शूरा लब्धलक्षा निशाचराः॥३॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-36",
    "chapterName": "अरण्यकाण्ड, सर्ग 36",
    "verseNumber": 3
  },
  {
    "id": "valmiki-ramayana-3-sarga-36-shlok-4",
    "collectionId": "valmiki-ramayana",
    "index": 7733,
    "titleDevanagari": "वाल्मीकि रामायण, अरण्यकाण्ड, सर्ग 36, श्लोक 4",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-36-shlok-4",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "वसन्ति मन्नियोगेन अधिवासं च राक्षसाः।",
          "बाधमाना महारण्ये मुनीन् ये धर्मचारिणः॥४॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-36",
    "chapterName": "अरण्यकाण्ड, सर्ग 36",
    "verseNumber": 4
  },
  {
    "id": "valmiki-ramayana-3-sarga-36-shlok-5",
    "collectionId": "valmiki-ramayana",
    "index": 7734,
    "titleDevanagari": "वाल्मीकि रामायण, अरण्यकाण्ड, सर्ग 36, श्लोक 5",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-36-shlok-5",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "चतुर्दश सहस्राणि रक्षसां भीमकर्मणाम्।",
          "शूराणां लब्धलक्षाणां खरचित्तानुवर्तिनाम्॥५॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-36",
    "chapterName": "अरण्यकाण्ड, सर्ग 36",
    "verseNumber": 5
  },
  {
    "id": "valmiki-ramayana-3-sarga-36-shlok-6",
    "collectionId": "valmiki-ramayana",
    "index": 7735,
    "titleDevanagari": "वाल्मीकि रामायण, अरण्यकाण्ड, सर्ग 36, श्लोक 6",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-36-shlok-6",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "ते त्विदानीं जनस्थाने वसमाना महाबलाः।",
          "सङ्गताः परमायत्ता रामेण सह संयुगे॥६॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-36",
    "chapterName": "अरण्यकाण्ड, सर्ग 36",
    "verseNumber": 6
  },
  {
    "id": "valmiki-ramayana-3-sarga-36-shlok-7",
    "collectionId": "valmiki-ramayana",
    "index": 7736,
    "titleDevanagari": "वाल्मीकि रामायण, अरण्यकाण्ड, सर्ग 36, श्लोक 7",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-36-shlok-7",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "नानाशस्त्रप्रहरणाः खरप्रमुखराक्षसाः।",
          "तेन संजातरोषेण रामेण रणमूर्धनि॥७॥",
          "अनुक्त्वा परुषं किंचिच्छरैर्व्यापारितं धनुः।"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-36",
    "chapterName": "अरण्यकाण्ड, सर्ग 36",
    "verseNumber": 7
  },
  {
    "id": "valmiki-ramayana-3-sarga-36-shlok-8",
    "collectionId": "valmiki-ramayana",
    "index": 7737,
    "titleDevanagari": "वाल्मीकि रामायण, अरण्यकाण्ड, सर्ग 36, श्लोक 8",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-36-shlok-8",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "चतुर्दश सहस्राणि रक्षसामुग्रतेजसाम्॥८॥",
          "निहतानि शरैर्दीप्तैर्मानुषेण पदातिना।",
          "खरश्च निहतः संख्ये दूषणश्च निपातितः॥९॥",
          "हत्वा त्रिशिरसं चापि निर्भया दण्डकाः कृताः।",
          "पित्रा निरस्तः क्रुद्धेन सभार्यः क्षीणजीवितः॥ १०॥",
          "स हन्ता तस्य सैन्यस्य रामः क्षत्रियपांसनः।"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-36",
    "chapterName": "अरण्यकाण्ड, सर्ग 36",
    "verseNumber": 8
  },
  {
    "id": "valmiki-ramayana-3-sarga-36-shlok-13",
    "collectionId": "valmiki-ramayana",
    "index": 7738,
    "titleDevanagari": "वाल्मीकि रामायण, अरण्यकाण्ड, सर्ग 36, श्लोक 13",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-36-shlok-13",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "अशीलः कर्कशस्तीक्ष्णो मूर्यो लुब्धोऽजितेन्द्रियः॥११॥",
          "त्यक्तधर्मा त्वधर्मात्मा भूतानामहिते रतः।",
          "येन वैरं विनारण्ये सत्त्वमास्थाय केवलम्॥१२॥",
          "कर्णनासापहारेण भगिनी मे विरूपिता।",
          "अस्य भार्यां जनस्थानात् सीतां सुरसुतोपमाम्॥ १३॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-36",
    "chapterName": "अरण्यकाण्ड, सर्ग 36",
    "verseNumber": 13
  },
  {
    "id": "valmiki-ramayana-3-sarga-36-shlok-15",
    "collectionId": "valmiki-ramayana",
    "index": 7739,
    "titleDevanagari": "वाल्मीकि रामायण, अरण्यकाण्ड, सर्ग 36, श्लोक 15",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-36-shlok-15",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "त्वया ह्यहं सहायेन पावस्थेन महाबल॥१४॥",
          "भ्रातृभिश्च सुरान् सर्वान् नाहमत्राभिचिन्तये।",
          "तत्सहायो भव त्वं मे समर्थो ह्यसि राक्षस॥१५॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-36",
    "chapterName": "अरण्यकाण्ड, सर्ग 36",
    "verseNumber": 15
  },
  {
