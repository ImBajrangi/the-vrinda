    "collectionId": "valmiki-ramayana",
    "index": 7740,
    "titleDevanagari": "वाल्मीकि रामायण, अरण्यकाण्ड, सर्ग 36, श्लोक 16",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-36-shlok-16",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "वीर्ये युद्धे च दर्प च न ह्यस्ति सदृशस्तव।",
          "उपायतो महान् शूरो महामायाविशारदः॥१६॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-36",
    "chapterName": "अरण्यकाण्ड, सर्ग 36",
    "verseNumber": 16
  },
