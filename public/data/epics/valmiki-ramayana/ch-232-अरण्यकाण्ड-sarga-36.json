    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-36-shlok-22",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "तस्य रामकथां श्रुत्वा मारीचस्य महात्मनः।",
          "शुष्कं समभवद् वक्त्रं परित्रस्तो बभूव च॥ २२॥"
        ]
      }
    ],
