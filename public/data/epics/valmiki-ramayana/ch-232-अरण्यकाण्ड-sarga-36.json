    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-36-shlok-19",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "त्वां तु निःसंशयं सीता दृष्ट्वा तु मृगरूपिणम्।",
          "गृह्यतामिति भर्तारं लक्ष्मणं चाभिधास्यति॥१९॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-36",
