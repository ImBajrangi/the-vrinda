      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "ओष्ठौ परिलिहन् शुष्कौ नेत्रैरनिमिषैरिव।",
          "मृतभूत इवार्तस्तु रावणं समुदैक्षत॥२३॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-36",
