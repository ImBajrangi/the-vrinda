    "slug": "valmiki-ramayana-2-sarga-76-shlok-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "तमेवं शोकसंतप्तं भरतं कैकयीसुतम्।",
          "उवाच वदतां श्रेष्ठो वसिष्ठः श्रेष्ठवागृषिः॥१॥"
        ]
      }
    ],
    "chapterId": "अयोध्याकाण्ड-sarga-76",
    "chapterName": "अयोध्याकाण्ड, सर्ग 76",
    "verseNumber": 1
  },
  {
