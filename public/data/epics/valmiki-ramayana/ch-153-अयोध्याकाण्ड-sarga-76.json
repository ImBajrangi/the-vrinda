    "slug": "valmiki-ramayana-2-sarga-76-shlok-2",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "अलं शोकेन भद्रं ते राजपुत्र महायशः।",
          "प्राप्तकालं नरपतेः कुरु संयानमुत्तमम्॥२॥"
        ]
      }
    ],
    "chapterId": "अयोध्याकाण्ड-sarga-76",
    "chapterName": "अयोध्याकाण्ड, सर्ग 76",
    "verseNumber": 2
  },
