    "chapterId": "अयोध्याकाण्ड-sarga-110",
    "chapterName": "अयोध्याकाण्ड, सर्ग 110",
    "verseNumber": 5
  },
  {
    "id": "valmiki-ramayana-2-sarga-110-shlok-6",
    "collectionId": "valmiki-ramayana",
    "index": 6516,
    "titleDevanagari": "वाल्मीकि रामायण, अयोध्याकाण्ड, सर्ग 110, श्लोक 6",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-2-sarga-110-shlok-6",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "विवस्वान् कश्यपाज्जज्ञे मनुर्वैवस्वतः स्वयम्।",
          "स तु प्रजापतिः पूर्वमिक्ष्वाकुस्तु मनोः सुतः॥६॥",
          "यस्येयं प्रथमं दत्ता समृद्धा मनुना मही।",
          "तमिक्ष्वाकुमयोध्यायां राजानं विद्धि पूर्वकम्॥"
        ]
      }
    ],
    "chapterId": "अयोध्याकाण्ड-sarga-110",
    "chapterName": "अयोध्याकाण्ड, सर्ग 110",
    "verseNumber": 6
  },
  {
    "id": "valmiki-ramayana-2-sarga-110-shlok-7",
    "collectionId": "valmiki-ramayana",
    "index": 6517,
    "titleDevanagari": "वाल्मीकि रामायण, अयोध्याकाण्ड, सर्ग 110, श्लोक 7",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-2-sarga-110-shlok-7",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "होरी तोते न खेलूँ श्याम रसिया ।।",
          "घूँघट में पिचकारी मारे बेंदी की चटक बिगारै रसिया ।",
          "नैनन में पिचकारी मारे कजरा की रेख बिगारै रसिया ।",
          "होठन में पिचकारी मारै नथली की गूंज बिगारै रसिया ।",
          "छातियन में पिचकारी मारै चोली की चटक बिगारै रसिया ।",
          "घुटुमन में पिचकारी मारै लंहगा की घूम बिगारै रसिया ।"
        ]
      }
    ],
    "chapterId": "अयोध्याकाण्ड-sarga-110",
    "chapterName": "अयोध्याकाण्ड, सर्ग 110",
    "verseNumber": 7
  },
