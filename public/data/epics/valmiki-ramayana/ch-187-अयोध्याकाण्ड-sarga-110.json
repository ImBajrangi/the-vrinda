    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "निवर्तयितुकामस्तु त्वामेतद् वाक्यमब्रवीत्।",
          "इमां लोकसमुत्पत्तिं लोकनाथ निबोध मे॥२॥"
        ]
      }
    ],
    "chapterId": "अयोध्याकाण्ड-sarga-110",
    "chapterName": "अयोध्याकाण्ड, सर्ग 110",
    "verseNumber": 2
  },
