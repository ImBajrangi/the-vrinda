    "index": 10400,
    "titleDevanagari": "वाल्मीकि रामायण, सुन्दरकाण्ड, सर्ग 44, श्लोक 3",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-5-sarga-44-shlok-3",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "धनुः शक्रधनुःप्रख्यं महद् रुचिरसायकम्।",
          "विस्फारयाणो वेगेन वज्राशनिसमस्वनम्॥३॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-44",
    "chapterName": "सुन्दरकाण्ड, सर्ग 44",
    "verseNumber": 3
  },
  {
