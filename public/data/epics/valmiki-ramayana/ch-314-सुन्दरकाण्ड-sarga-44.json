    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-5-sarga-44-shlok-9",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "तत्तस्य रक्तं रक्तेन रञ्जितं शुशुभे मुखम्।",
          "यथाऽऽकाशे महापद्मं सिक्तं काञ्चनबिन्दुभिः॥९॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-44",
    "chapterName": "सुन्दरकाण्ड, सर्ग 44",
    "verseNumber": 9
  },
  {
    "id": "valmiki-ramayana-5-sarga-44-shlok-10",
    "collectionId": "valmiki-ramayana",
