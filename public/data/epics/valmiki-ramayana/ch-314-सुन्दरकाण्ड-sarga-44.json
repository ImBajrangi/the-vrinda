    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-5-sarga-44-shlok-4",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "तस्य विस्फारघोषेण धनुषो महता दिशः।",
          "प्रदिशश्च नभश्चैव सहसा समपूर्यत॥४॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-44",
    "chapterName": "सुन्दरकाण्ड, सर्ग 44",
    "verseNumber": 4
  },
  {
    "id": "valmiki-ramayana-5-sarga-44-shlok-5",
    "collectionId": "valmiki-ramayana",
    "index": 10402,
    "titleDevanagari": "वाल्मीकि रामायण, सुन्दरकाण्ड, सर्ग 44, श्लोक 5",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-5-sarga-44-shlok-5",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "रथेन खरयुक्तेन तमागतमुदीक्ष्य सः।",
          "हनूमान् वेगसम्पन्नो जहर्ष च ननाद च॥५॥",
          "तं तोरणविटङ्कस्थं हनूमन्तं महाकपिम्।",
          "जम्बुमाली महातेजा विव्याध निशितैः शरैः॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-44",
    "chapterName": "सुन्दरकाण्ड, सर्ग 44",
    "verseNumber": 5
  },
  {
    "id": "valmiki-ramayana-5-sarga-44-shlok-7",
    "collectionId": "valmiki-ramayana",
    "index": 10403,
    "titleDevanagari": "वाल्मीकि रामायण, सुन्दरकाण्ड, सर्ग 44, श्लोक 7",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-5-sarga-44-shlok-7",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "अर्धचन्द्रेण वदने शिरस्येकेन कर्णिना।",
          "बाह्वोर्विव्याध नाराचैर्दशभिस्तु कपीश्वरम्॥७॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-44",
    "chapterName": "सुन्दरकाण्ड, सर्ग 44",
    "verseNumber": 7
  },
  {
