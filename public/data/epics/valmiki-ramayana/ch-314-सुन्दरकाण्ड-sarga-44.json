    "collectionId": "valmiki-ramayana",
    "index": 10407,
    "titleDevanagari": "वाल्मीकि रामायण, सुन्दरकाण्ड, सर्ग 44, श्लोक 12",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-5-sarga-44-shlok-12",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "तां शरैर्दशभिः क्रुद्धस्ताडयामास राक्षसः॥११॥",
          "विपन्नं कर्म तद् दृष्ट्वा हनूमांश्चण्डविक्रमः।",
          "सालं विपुलमुत्पाट्य भ्रामयामास वीर्यवान्॥१२॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-44",
    "chapterName": "सुन्दरकाण्ड, सर्ग 44",
    "verseNumber": 12
  },
  {
