    "collectionId": "valmiki-ramayana",
    "index": 10404,
    "titleDevanagari": "वाल्मीकि रामायण, सुन्दरकाण्ड, सर्ग 44, श्लोक 8",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-5-sarga-44-shlok-8",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "तस्य तच्छुशुभे तानं शरेणाभिहतं मुखम्।",
          "शरदीवाम्बुजं फुल्लं विद्धं भास्कररश्मिना॥८॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-44",
    "chapterName": "सुन्दरकाण्ड, सर्ग 44",
    "verseNumber": 8
  },
  {
