    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-5-sarga-44-shlok-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "संदिष्टो राक्षसेन्द्रेण प्रहस्तस्य सुतो बली।",
          "जम्बुमाली महादंष्ट्रो निर्जगाम धनुर्धरः॥१॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-44",
    "chapterName": "सुन्दरकाण्ड, सर्ग 44",
    "verseNumber": 1
  },
  {
