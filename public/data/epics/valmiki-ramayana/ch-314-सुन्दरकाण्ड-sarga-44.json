      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "भ्रामयन्तं कपिं दृष्ट्वा सालवृक्षं महाबलम्।",
          "चिक्षेप सुबहून् बाणाञ्जम्बुमाली महाबलः॥१३॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-44",
    "chapterName": "सुन्दरकाण्ड, सर्ग 44",
    "verseNumber": 13
  },
  {
