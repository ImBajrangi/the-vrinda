    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "अथ तां जातसंतापां तेन वाक्येन मोहिताम्।",
          "सरमा लादयामास महीं दग्धामिवाम्भसा॥१॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-34",
    "chapterName": "युद्धकाण्ड, सर्ग 34",
    "verseNumber": 1
  },
