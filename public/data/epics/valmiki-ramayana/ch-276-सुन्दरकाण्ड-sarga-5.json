    "titleDevanagari": "वाल्मीकि रामायण, सुन्दरकाण्ड, सर्ग 5, श्लोक 1",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-5-sarga-5-shlok-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "ततः स मध्यंगतमंशुमन्तं ज्योत्स्नावितानं मुहुरुद्रमन्तम्।",
          "ददर्श धीमान् भुवि भानुमन्तं गोष्ठे वृषं मत्तमिव भ्रमन्तम्॥१॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-5",
    "chapterName": "सुन्दरकाण्ड, सर्ग 5",
    "verseNumber": 1
  },
  {
    "id": "valmiki-ramayana-5-sarga-5-shlok-2",
    "collectionId": "valmiki-ramayana",
    "index": 9108,
    "titleDevanagari": "वाल्मीकि रामायण, सुन्दरकाण्ड, सर्ग 5, श्लोक 2",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-5-sarga-5-shlok-2",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "लोकस्य पापानि विनाशयन्तं महोदधिं चापि समेधयन्तम्।",
          "भूतानि सर्वाणि विराजयन्तं ददर्श शीतांशुमथाभियान्तम्॥२॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-5",
    "chapterName": "सुन्दरकाण्ड, सर्ग 5",
    "verseNumber": 2
  },
  {
    "id": "valmiki-ramayana-5-sarga-5-shlok-3",
    "collectionId": "valmiki-ramayana",
    "index": 9109,
    "titleDevanagari": "वाल्मीकि रामायण, सुन्दरकाण्ड, सर्ग 5, श्लोक 3",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-5-sarga-5-shlok-3",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "या भाति लक्ष्मी वि मन्दरस्था यथा प्रदोषेषु च सागरस्था।",
          "तथैव तोयेषु च पुष्करस्था रराज सा चारुनिशाकरस्था॥३॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-5",
    "chapterName": "सुन्दरकाण्ड, सर्ग 5",
    "verseNumber": 3
  },
  {
    "id": "valmiki-ramayana-5-sarga-5-shlok-4",
    "collectionId": "valmiki-ramayana",
    "index": 9110,
    "titleDevanagari": "वाल्मीकि रामायण, सुन्दरकाण्ड, सर्ग 5, श्लोक 4",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-5-sarga-5-shlok-4",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "हंसो यथा राजतपञ्जरस्थः सिंहो यथा मन्दरकन्दरस्थः।",
          "वीरो यथा गर्वितकुञ्जरस्थश्चन्द्रोऽपि बभ्राज तथाम्बरस्थः॥४॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-5",
    "chapterName": "सुन्दरकाण्ड, सर्ग 5",
    "verseNumber": 4
  },
  {
    "id": "valmiki-ramayana-5-sarga-5-shlok-5",
