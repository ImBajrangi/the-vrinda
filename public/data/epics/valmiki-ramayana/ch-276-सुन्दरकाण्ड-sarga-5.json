    "slug": "valmiki-ramayana-5-sarga-5-shlok-6",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "विनष्टशीताम्बुतुषारपङ्को महाग्रहग्राहविनष्टपङ्कः।",
          "प्रकाशलक्ष्याश्रयनिर्मलाङ्को रराज चन्द्रो भगवान् शशाङ्कः॥६॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-5",
    "chapterName": "सुन्दरकाण्ड, सर्ग 5",
    "verseNumber": 6
  },
