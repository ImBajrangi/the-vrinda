    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "प्रकाशचन्द्रोदयनष्टदोषः प्रवृद्धरक्षःपिशिताशदोषः।",
          "रामाभिरामेरितचित्तदोषः स्वर्गप्रकाशो भगवान् प्रदोषः॥८॥"
        ]
      }
    ],
