    "index": 9368,
    "titleDevanagari": "वाल्मीकि रामायण, सुन्दरकाण्ड, सर्ग 13, श्लोक 3",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-5-sarga-13-shlok-3",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "भूयिष्ठं लोलिता लंका रामस्य चरता प्रियम्।",
          "न हि पश्यामि वैदेहीं सीतां सर्वांगशोभनाम्॥३॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-13",
    "chapterName": "सुन्दरकाण्ड, सर्ग 13",
    "verseNumber": 3
  },
  {
    "id": "valmiki-ramayana-5-sarga-13-shlok-4",
