    "index": 9369,
    "titleDevanagari": "वाल्मीकि रामायण, सुन्दरकाण्ड, सर्ग 13, श्लोक 4",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-5-sarga-13-shlok-4",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "पल्वलानि तटाकानि सरांसि सरितस्तथा।",
          "नद्योऽनूपवनान्ताश्च दुर्गाश्च धरणीधराः॥४॥",
          "लोलिता वसुधा सर्वा न च पश्यामि जानकीम्।",
          "इह सम्पातिना सीता रावणस्य निवेशने।",
          "आख्याता गृध्रराजेन न च सा दृश्यते न किम्॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-13",
    "chapterName": "सुन्दरकाण्ड, सर्ग 13",
    "verseNumber": 4
  },
  {
    "id": "valmiki-ramayana-5-sarga-13-shlok-6",
    "collectionId": "valmiki-ramayana",
    "index": 9370,
    "titleDevanagari": "वाल्मीकि रामायण, सुन्दरकाण्ड, सर्ग 13, श्लोक 6",
