    "slug": "valmiki-ramayana-5-sarga-13-shlok-2",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "सम्परिक्रम्य हनुमान् रावणस्य निवेशनान्।",
          "अदृष्ट्वा जानकी सीतामब्रवीद् वचनं कपिः॥२॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-13",
    "chapterName": "सुन्दरकाण्ड, सर्ग 13",
    "verseNumber": 2
  },
  {
    "id": "valmiki-ramayana-5-sarga-13-shlok-3",
