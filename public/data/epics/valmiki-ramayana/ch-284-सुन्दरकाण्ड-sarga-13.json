    "slug": "valmiki-ramayana-5-sarga-13-shlok-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "विमानात् तु स संक्रम्य प्राकारं हरियूथपः।",
          "हनूमान् वेगवानासीद् यथा विद्युद् घनान्तरे॥१॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-13",
    "chapterName": "सुन्दरकाण्ड, सर्ग 13",
    "verseNumber": 1
  },
  {
