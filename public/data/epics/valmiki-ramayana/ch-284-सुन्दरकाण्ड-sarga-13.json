    "slug": "valmiki-ramayana-5-sarga-13-shlok-6",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "किं नु सीताथ वैदेही मैथिली जनकात्मजा।",
          "उपतिष्ठेत विवशा रावणेन हृता बलात्॥६॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-13",
    "chapterName": "सुन्दरकाण्ड, सर्ग 13",
    "verseNumber": 6
  },
  {
