    "slug": "valmiki-ramayana-5-sarga-13-shlok-7",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "क्षिप्रमुत्पततो मन्ये सीतामादाय रक्षसः।",
          "बिभ्यतो रामबाणानामन्तरा पतिता भवेत्॥७॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-13",
    "chapterName": "सुन्दरकाण्ड, सर्ग 13",
    "verseNumber": 7
  },
  {
