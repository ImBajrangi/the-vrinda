    "slug": "valmiki-ramayana-5-sarga-37-shlok-4",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "विधिनमसंहार्यः प्राणिनां प्लवगोत्तम।",
          "सौमित्रं मां च रामं च व्यसनैः पश्य मोहितान्॥४॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-37",
    "chapterName": "सुन्दरकाण्ड, सर्ग 37",
    "verseNumber": 4
  },
  {
    "id": "valmiki-ramayana-5-sarga-37-shlok-5",
