    "slug": "valmiki-ramayana-5-sarga-37-shlok-6",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "राक्षसानां वधं कृत्वा सूदयित्वा च रावणम्।",
          "लङ्कामुन्मथितां कृत्वा कदा द्रक्ष्यति मां पतिः॥६॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-37",
    "chapterName": "सुन्दरकाण्ड, सर्ग 37",
    "verseNumber": 6
  },
  {
