    "slug": "valmiki-ramayana-5-sarga-37-shlok-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "सा सीता वचनं श्रुत्वा पूर्णचन्द्रनिभानना।",
          "हनूमन्तमुवाचेदं धर्मार्थसहितं वचः॥१॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-37",
    "chapterName": "सुन्दरकाण्ड, सर्ग 37",
    "verseNumber": 1
  },
  {
    "id": "valmiki-ramayana-5-sarga-37-shlok-2",
    "collectionId": "valmiki-ramayana",
    "index": 10121,
    "titleDevanagari": "वाल्मीकि रामायण, सुन्दरकाण्ड, सर्ग 37, श्लोक 2",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-5-sarga-37-shlok-2",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "अमृतं विषसम्पृक्तं त्वया वानर भाषितम्।",
          "यच्च नान्यमना रामो यच्च शोकपरायणः॥२॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-37",
    "chapterName": "सुन्दरकाण्ड, सर्ग 37",
    "verseNumber": 2
  },
  {
    "id": "valmiki-ramayana-5-sarga-37-shlok-3",
    "collectionId": "valmiki-ramayana",
    "index": 10122,
    "titleDevanagari": "वाल्मीकि रामायण, सुन्दरकाण्ड, सर्ग 37, श्लोक 3",
