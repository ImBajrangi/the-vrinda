    "slug": "valmiki-ramayana-5-sarga-37-shlok-3",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "ऐश्वर्ये वा सुविस्तीर्णे व्यसने वा सुदारुणे।",
          "रज्ज्वेव पुरुषं बद्ध्वा कृतान्तः परिकर्षति॥३॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-37",
    "chapterName": "सुन्दरकाण्ड, सर्ग 37",
    "verseNumber": 3
  },
  {
    "id": "valmiki-ramayana-5-sarga-37-shlok-4",
