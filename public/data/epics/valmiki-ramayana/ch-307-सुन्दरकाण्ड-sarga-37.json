    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "वर्तते दशमो मासो द्वौ तु शेषौ प्लवङ्गम।",
          "रावणेन नृशंसेन समयो यः कृतो मम॥८॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-37",
    "chapterName": "सुन्दरकाण्ड, सर्ग 37",
    "verseNumber": 8
  },
  {
