    "index": 10124,
    "titleDevanagari": "वाल्मीकि रामायण, सुन्दरकाण्ड, सर्ग 37, श्लोक 5",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-5-sarga-37-shlok-5",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "शोकस्यास्य कथं पारं राघवोऽधिगमिष्यति।",
          "प्लवमानः परिक्रान्तो हतनौः सागरे यथा॥५॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-37",
    "chapterName": "सुन्दरकाण्ड, सर्ग 37",
    "verseNumber": 5
  },
  {
