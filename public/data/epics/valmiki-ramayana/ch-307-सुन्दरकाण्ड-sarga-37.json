    "slug": "valmiki-ramayana-5-sarga-37-shlok-7",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "स वाच्यः संत्वरस्वेति यावदेव न पूर्यते।",
          "अयं संवत्सरः कालस्तावद्धि मम जीवितम्॥७॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-37",
    "chapterName": "सुन्दरकाण्ड, सर्ग 37",
    "verseNumber": 7
  },
  {
