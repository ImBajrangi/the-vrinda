    "slug": "valmiki-ramayana-1-sarga-68-shlok-8",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "सेयं मम सुता राजन् विश्वामित्रपुरस्कृतैः।",
          "यदृच्छयागतै राजन् निर्जिता तव पुत्रकैः॥८॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-68",
    "chapterName": "बालकाण्ड, सर्ग 68",
    "verseNumber": 8
  },
  {
