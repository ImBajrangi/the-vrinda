    "slug": "valmiki-ramayana-1-sarga-68-shlok-7",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "पूर्वं प्रतिज्ञा विदिता वीर्यशुल्का ममात्मजा।",
          "राजानश्च कृतामर्षा निर्वीर्या विमुखीकृताः॥७॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-68",
    "chapterName": "बालकाण्ड, सर्ग 68",
    "verseNumber": 7
  },
  {
    "id": "valmiki-ramayana-1-sarga-68-shlok-8",
