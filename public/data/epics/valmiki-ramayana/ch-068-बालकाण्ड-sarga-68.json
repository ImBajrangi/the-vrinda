[
  {
    "id": "valmiki-ramayana-1-sarga-68-shlok-1",
    "collectionId": "valmiki-ramayana",
    "index": 2783,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 68, श्लोक 1",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-68-shlok-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "गोकुल बजत बधाई, गोकुल बाजत आज बधाई",
          "भीड़ भई है, नन्द जू  के द्वार अष्ट महासिद्धि आई",
          "ब्रह्मादिक, रुद्रादिक जाकी चरण रेणु नहीं पाई",
          "सोइ नन्द जू को पूत कहावत कौतुक सुनो, मोरी माई",
          "अम्बरीश , प्रह्लाद, विभीषण नित नित महिमा गाई",
          "सोइ हरि परमानन्द को ठाकुर ब्रज जन केलि कराई"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-68",
    "chapterName": "बालकाण्ड, सर्ग 68",
    "verseNumber": 1
  },
  {
    "id": "valmiki-ramayana-1-sarga-68-shlok-2",
    "collectionId": "valmiki-ramayana",
    "index": 2784,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 68, श्लोक 2",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-68-shlok-2",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "ते राजवचनाद् गत्वा राजवेश्म प्रवेशिताः।",
          "ददृशुर्देवसंकाशं वृद्धं दशरथं नृपम्॥२॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-68",
    "chapterName": "बालकाण्ड, सर्ग 68",
    "verseNumber": 2
  },
  {
    "id": "valmiki-ramayana-1-sarga-68-shlok-5",
    "collectionId": "valmiki-ramayana",
    "index": 2785,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 68, श्लोक 5",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-68-shlok-5",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "बद्धाञ्जलिपुटाः सर्वे दूता विगतसाध्वसाः।",
          "राजानं प्रश्रितं वाक्यमब्रुवन् मधुराक्षरम्॥३॥",
          "मैथिलो जनको राजा साग्निहोत्रपुरस्कृतः।",
          "मुहुर्मुहुर्मधुरया स्नेहसंरक्तया गिरा॥४॥",
          "कुशलं चाव्ययं चैव सोपाध्यायपुरोहितम्।",
          "जनकस्त्वां महाराज पृच्छते सपुरःसरम्॥५॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-68",
    "chapterName": "बालकाण्ड, सर्ग 68",
    "verseNumber": 5
  },
  {
    "id": "valmiki-ramayana-1-sarga-68-shlok-6",
    "collectionId": "valmiki-ramayana",
    "index": 2786,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 68, श्लोक 6",
