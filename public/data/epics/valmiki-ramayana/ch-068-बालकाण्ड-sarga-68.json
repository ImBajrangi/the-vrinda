    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "तच्च रत्नं धनुर्दिव्यं मध्ये भग्नं महात्मना।",
          "रामेण हि महाबाहो महत्यां जनसंसदि॥९॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-68",
    "chapterName": "बालकाण्ड, सर्ग 68",
    "verseNumber": 9
  },
