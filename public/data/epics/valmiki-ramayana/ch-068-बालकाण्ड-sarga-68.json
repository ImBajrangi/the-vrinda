    "slug": "valmiki-ramayana-1-sarga-68-shlok-6",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "पृष्ट्वा कुशलमव्यग्रं वैदेहो मिथिलाधिपः।",
          "कौशिकानुमते वाक्यं भवन्तमिदमब्रवीत्॥६॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-68",
    "chapterName": "बालकाण्ड, सर्ग 68",
    "verseNumber": 6
  },
  {
