    "slug": "valmiki-ramayana-2-sarga-44-shlok-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "विलपन्ती तथा तां तु कौसल्यां प्रमदोत्तमाम्।",
          "इदं धर्मे स्थिता धन॑ सुमित्रा वाक्यमब्रवीत्॥१॥"
        ]
      }
    ],
    "chapterId": "अयोध्याकाण्ड-sarga-44",
    "chapterName": "अयोध्याकाण्ड, सर्ग 44",
    "verseNumber": 1
  },
  {
