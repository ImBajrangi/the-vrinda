    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-2-sarga-44-shlok-2",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "तवार्ये सद्गुणैर्युक्तः स पुत्रः पुरुषोत्तमः।",
          "किं ते विलपितेनैवं कृपणं रुदितेन वा ॥२॥"
        ]
      }
    ],
    "chapterId": "अयोध्याकाण्ड-sarga-44",
    "chapterName": "अयोध्याकाण्ड, सर्ग 44",
    "verseNumber": 2
  },
  {
