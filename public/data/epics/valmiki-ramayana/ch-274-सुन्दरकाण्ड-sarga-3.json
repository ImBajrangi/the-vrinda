    "slug": "valmiki-ramayana-5-sarga-3-shlok-6",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "शातकुम्भेन महता प्राकारेणाभिसंवृताम्॥६॥",
          "किङ्किणीजालघोषाभिः पताकाभिरलंकृताम्।"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-3",
    "chapterName": "सुन्दरकाण्ड, सर्ग 3",
    "verseNumber": 6
  },
