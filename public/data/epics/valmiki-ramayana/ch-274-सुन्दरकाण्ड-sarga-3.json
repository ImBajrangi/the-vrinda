    "slug": "valmiki-ramayana-5-sarga-3-shlok-20",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "अथ सा हरिशार्दूलं प्रविशन्तं महाकपिम्।",
          "नगरी स्वेन रूपेण ददर्श पवनात्मजम्॥२०॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-3",
