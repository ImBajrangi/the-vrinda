[
  {
    "id": "valmiki-ramayana-5-sarga-3-shlok-2",
    "collectionId": "valmiki-ramayana",
    "index": 9041,
    "titleDevanagari": "वाल्मीकि रामायण, सुन्दरकाण्ड, सर्ग 3, श्लोक 2",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-5-sarga-3-shlok-2",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "स लम्बशिखरे लम्बे लम्बतोयदसंनिभे।",
          "सत्त्वमास्थाय मेधावी हनुमान् मारुतात्मजः॥१॥",
          "निशि लंकां महासत्त्वो विवेश कपिकुञ्जरः।",
          "रम्यकाननतोयाढ्यां पुरीं रावणपालिताम्॥२॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-3",
    "chapterName": "सुन्दरकाण्ड, सर्ग 3",
    "verseNumber": 2
  },
  {
    "id": "valmiki-ramayana-5-sarga-3-shlok-3",
    "collectionId": "valmiki-ramayana",
    "index": 9042,
    "titleDevanagari": "वाल्मीकि रामायण, सुन्दरकाण्ड, सर्ग 3, श्लोक 3",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-5-sarga-3-shlok-3",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "॥ श्रीसीतारामचन्द्राभ्यां नमः॥",
          "श्रीमद्वाल्मीकीय रामायण",
          "सुन्दरकाण्डम्",
          "तृतीयः सर्गः (3)",
          "शारदाम्बुधरप्रख्यैर्भवनैरुपशोभिताम्।",
          "सागरोपमनिर्घोषां सागरानिलसेविताम्॥३॥",
          "इत्याचे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये सुन्दरकाण्डे तृतीयः सर्गः॥३॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-3",
    "chapterName": "सुन्दरकाण्ड, सर्ग 3",
    "verseNumber": 3
  },
  {
    "id": "valmiki-ramayana-5-sarga-3-shlok-4",
    "collectionId": "valmiki-ramayana",
    "index": 9043,
    "titleDevanagari": "वाल्मीकि रामायण, सुन्दरकाण्ड, सर्ग 3, श्लोक 4",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-5-sarga-3-shlok-4",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "सुपुष्टबलसम्पुष्टां यथैव विटपावतीम्।",
          "चारुतोरणनिर्वृहां पाण्डुरद्वारतोरणाम्॥४॥",
          "भुजगाचरितां गुप्तां शुभां भोगवतीमिव।",
          "तां सविद्युद्घनाकीर्णां ज्योतिर्गणनिषेविताम्॥",
          "चण्डमारुतनिर्हादां यथा चाप्यमरावतीम्।"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-3",
    "chapterName": "सुन्दरकाण्ड, सर्ग 3",
    "verseNumber": 4
  },
  {
