    "slug": "valmiki-ramayana-5-sarga-3-shlok-7",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "आसाद्य सहसा हृष्टः प्राकारमभिपेदिवान्॥७॥",
          "विस्मयाविष्टहृदयः पुरीमालोक्य सर्वतः।"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-3",
    "chapterName": "सुन्दरकाण्ड, सर्ग 3",
    "verseNumber": 7
  },
