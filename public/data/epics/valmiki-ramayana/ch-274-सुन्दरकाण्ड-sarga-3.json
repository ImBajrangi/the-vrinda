    "slug": "valmiki-ramayana-5-sarga-3-shlok-13",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "तां समीक्ष्य पुरी लंकां राक्षसाधिपतेः शुभाम्।",
          "अनुत्तमामृद्धिमतीं चिन्तयामास वीर्यवान्॥१३॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-3",
    "chapterName": "सुन्दरकाण्ड, सर्ग 3",
    "verseNumber": 13
  },
