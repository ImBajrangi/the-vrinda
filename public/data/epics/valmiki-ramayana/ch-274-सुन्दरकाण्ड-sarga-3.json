        "stanzaNumber": 1,
        "linesDevanagari": [
          "नेयमन्येन नगरी शक्या धर्षयितुं बलात्।",
          "रक्षिता रावणबलैरुद्यतायुधपाणिभिः॥१४॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-3",
    "chapterName": "सुन्दरकाण्ड, सर्ग 3",
    "verseNumber": 14
  },
  {
