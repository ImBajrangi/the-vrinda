    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-5-sarga-3-shlok-17",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "समीक्ष्य च महाबाहो राघवस्य पराक्रमम्।",
          "लक्ष्मणस्य च विक्रान्तमभवत् प्रीतिमान् कपिः॥१७॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-3",
