    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-5-sarga-3-shlok-12",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "वस्वोकसारप्रतिमां समीक्ष्य नगरी ततः।",
          "खमिवोत्पतितां लंकां जहर्ष हनुमान् कपिः॥१२॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-3",
    "chapterName": "सुन्दरकाण्ड, सर्ग 3",
    "verseNumber": 12
  },
  {
