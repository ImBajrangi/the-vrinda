    "slug": "valmiki-ramayana-5-sarga-3-shlok-11",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "क्रौञ्चबर्हिणसंघुष्टै राजहंसनिषेवितैः।",
          "तूर्याभरणनिर्घोषैः सर्वतः परिनादिताम्॥११॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-3",
    "chapterName": "सुन्दरकाण्ड, सर्ग 3",
    "verseNumber": 11
  },
  {
