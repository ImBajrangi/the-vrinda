    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "भवान् मे प्रियकामार्थं वचनं यदिहोक्तवान्।",
          "अकार्यं कार्यसंकाशमपथ्यं पथ्य संनिभम्॥२॥"
        ]
      }
    ],
    "chapterId": "अयोध्याकाण्ड-sarga-109",
    "chapterName": "अयोध्याकाण्ड, सर्ग 109",
    "verseNumber": 2
  },
