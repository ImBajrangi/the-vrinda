    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "जाबालेस्तु वचः श्रुत्वा रामः सत्यपराक्रमः।",
          "उवाच परया सूक्त्या बुद्ध्याविप्रतिपन्नया॥१॥"
        ]
      }
    ],
    "chapterId": "अयोध्याकाण्ड-sarga-109",
    "chapterName": "अयोध्याकाण्ड, सर्ग 109",
    "verseNumber": 1
  },
