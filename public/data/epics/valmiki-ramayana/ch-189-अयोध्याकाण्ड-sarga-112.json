    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "तमप्रतिमतेजोभ्यां भ्रातृभ्यां रोमहर्षणम्।",
          "विस्मिताः संगमं प्रेक्ष्य समुपेता महर्षयः॥१॥"
        ]
      }
    ],
    "chapterId": "अयोध्याकाण्ड-sarga-112",
    "chapterName": "अयोध्याकाण्ड, सर्ग 112",
    "verseNumber": 1
  },
