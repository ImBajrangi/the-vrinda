    "slug": "valmiki-ramayana-5-sarga-18-shlok-3",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "अथ मंगलवादित्रैः शब्दैः श्रोत्रमनोहरैः।",
          "राबोध्यत महाबाहुर्दशग्रीवो महाबलः॥३॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-18",
    "chapterName": "सुन्दरकाण्ड, सर्ग 18",
    "verseNumber": 3
  },
  {
