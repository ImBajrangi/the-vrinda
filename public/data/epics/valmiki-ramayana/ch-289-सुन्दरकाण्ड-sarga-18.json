    "slug": "valmiki-ramayana-5-sarga-18-shlok-2",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "षडंगवेदविदुषां क्रतुप्रवरयाजिनाम्।",
          "शुश्राव ब्रह्मघोषान् स विरात्रे ब्रह्मरक्षसाम्॥२॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-18",
    "chapterName": "सुन्दरकाण्ड, सर्ग 18",
    "verseNumber": 2
