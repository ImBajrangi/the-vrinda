    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "तथा विप्रेक्षमाणस्य वनं पुष्पितपादपम्।",
          "विचिन्वतश्च वैदेहीं किञ्चिच्छेषा निशाभवत्॥१॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-18",
    "chapterName": "सुन्दरकाण्ड, सर्ग 18",
    "verseNumber": 1
