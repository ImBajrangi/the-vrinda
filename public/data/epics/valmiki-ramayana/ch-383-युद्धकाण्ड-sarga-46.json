    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "ततो द्यां पृथिवीं चैव वीक्षमाणा वनौकसः।",
          "ददृशुः संततौ बाणैर्धातरौ रामलक्ष्मणौ ॥१॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-46",
    "chapterName": "युद्धकाण्ड, सर्ग 46",
    "verseNumber": 1
  },
  {
