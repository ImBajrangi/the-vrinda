    "slug": "valmiki-ramayana-6-sarga-46-shlok-2",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "वृष्ट्वेवोपरते देवे कृतकर्मणि राक्षसे।",
          "आजगामाथ तं देशं ससुग्रीवो विभीषणः॥२॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-46",
    "chapterName": "युद्धकाण्ड, सर्ग 46",
    "verseNumber": 2
  },
