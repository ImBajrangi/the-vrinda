    "slug": "valmiki-ramayana-6-sarga-3-shlok-12",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "तत्रेषूपलयन्त्राणि बलवन्ति महान्ति च।",
          "आगतं प्रतिसैन्यं तैस्तत्र प्रतिनिवार्यते॥१२॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-3",
    "chapterName": "युद्धकाण्ड, सर्ग 3",
    "verseNumber": 12
  },
