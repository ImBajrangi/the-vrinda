    "titleDevanagari": "वाल्मीकि रामायण, युद्धकाण्ड, सर्ग 3, श्लोक 1",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-6-sarga-3-shlok-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "सुग्रीवस्य वचः श्रुत्वा हेतुमत् परमार्थवत्।",
          "प्रतिजग्राह काकुत्स्थो हनूमन्तमथाब्रवीत्॥१॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-3",
    "chapterName": "युद्धकाण्ड, सर्ग 3",
    "verseNumber": 1
  },
  {
    "id": "valmiki-ramayana-6-sarga-3-shlok-2",
    "collectionId": "valmiki-ramayana",
    "index": 11313,
    "titleDevanagari": "वाल्मीकि रामायण, युद्धकाण्ड, सर्ग 3, श्लोक 2",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-6-sarga-3-shlok-2",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "तपसा सेतुबन्धेन सागरोच्छोषणेन च।",
          "सर्वथापि समर्थोऽस्मि सागरस्यास्य लङ्घने॥२॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-3",
    "chapterName": "युद्धकाण्ड, सर्ग 3",
    "verseNumber": 2
  },
  {
    "id": "valmiki-ramayana-6-sarga-3-shlok-3",
    "collectionId": "valmiki-ramayana",
    "index": 11314,
    "titleDevanagari": "वाल्मीकि रामायण, युद्धकाण्ड, सर्ग 3, श्लोक 3",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-6-sarga-3-shlok-3",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "॥ श्रीसीतारामचन्द्राभ्यां नमः॥",
          "श्रीमद्वाल्मीकीय रामायण",
          "युद्धकाण्डम्",
          "तृतीयः सर्गः (3)",
          "कति दुर्गाणि दुर्गाया लङ्कायास्तद् ब्रवीष्व मे।",
          "ज्ञातुमिच्छामि तत् सर्वं दर्शनादिव वानर ॥३॥",
          "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये युद्धकाण्डे तृतीयः सर्गः॥३॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-3",
    "chapterName": "युद्धकाण्ड, सर्ग 3",
    "verseNumber": 3
  },
  {
    "id": "valmiki-ramayana-6-sarga-3-shlok-5",
    "collectionId": "valmiki-ramayana",
    "index": 11315,
    "titleDevanagari": "वाल्मीकि रामायण, युद्धकाण्ड, सर्ग 3, श्लोक 5",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-6-sarga-3-shlok-5",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "बलस्य परिमाणं च द्वारदुर्गक्रियामपि।",
          "गुप्तिकर्म च लङ्काया रक्षसां सदनानि च॥४॥",
          "यथासुखं यथावच्च लङ्कायामसि दृष्टवान्।",
          "सर्वमाचक्ष्व तत्त्वेन सर्वथा कुशलो ह्यसि॥५॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-3",
    "chapterName": "युद्धकाण्ड, सर्ग 3",
    "verseNumber": 5
  },
  {
    "id": "valmiki-ramayana-6-sarga-3-shlok-6",
    "collectionId": "valmiki-ramayana",
    "index": 11316,
    "titleDevanagari": "वाल्मीकि रामायण, युद्धकाण्ड, सर्ग 3, श्लोक 6",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-6-sarga-3-shlok-6",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "श्रुत्वा रामस्य वचनं हनूमान् मारुतात्मजः।",
          "वाक्यं वाक्यविदां श्रेष्ठो रामं पुनरथाब्रवीत्॥६॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-3",
    "chapterName": "युद्धकाण्ड, सर्ग 3",
    "verseNumber": 6
  },
  {
    "id": "valmiki-ramayana-6-sarga-3-shlok-9",
    "collectionId": "valmiki-ramayana",
    "index": 11317,
    "titleDevanagari": "वाल्मीकि रामायण, युद्धकाण्ड, सर्ग 3, श्लोक 9",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-6-sarga-3-shlok-9",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "श्रूयतां सर्वमाख्यास्ये दुर्गकर्म विधानतः।",
          "गुप्ता पुरी यथा लङ्का रक्षिता च यथा बलैः॥७॥",
          "राक्षसाश्च यथा स्निग्धा रावणस्य च तेजसा।",
          "परां समृद्धिं लङ्कायाः सागरस्य च भीमताम्॥८॥",
          "विभागं च बलौघस्य निर्देशं वाहनस्य च।",
          "एवमुक्त्वा कपिश्रेष्ठः कथयामास तत्त्वतः॥९॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-3",
    "chapterName": "युद्धकाण्ड, सर्ग 3",
    "verseNumber": 9
  },
  {
    "id": "valmiki-ramayana-6-sarga-3-shlok-10",
