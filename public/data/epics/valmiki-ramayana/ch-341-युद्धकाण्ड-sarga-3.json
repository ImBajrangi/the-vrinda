    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-6-sarga-3-shlok-10",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "हृष्टप्रमुदिता लङ्का मत्तद्विपसमाकुला।",
          "महती रथसम्पूर्णा रक्षोगणनिषेविता॥१०॥",
          "दृढबद्धकपाटानि महापरिघवन्ति च।",
          "चत्वारि विपुलान्यस्या द्वाराणि सुमहान्ति च॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-3",
    "chapterName": "युद्धकाण्ड, सर्ग 3",
    "verseNumber": 10
  },
  {
