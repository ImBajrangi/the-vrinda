    "titleDevanagari": "वाल्मीकि रामायण, युद्धकाण्ड, सर्ग 11, श्लोक 8",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-6-sarga-11-shlok-8",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "गदापरिघहस्ताश्च शक्तितोमरपाणयः।",
          "परश्वधधराश्चान्ये तथान्ये शूलपाणयः।",
          "ततस्तूर्यसहस्राणं संजज्ञे निःस्वनो महान्॥८॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-11",
    "chapterName": "युद्धकाण्ड, सर्ग 11",
    "verseNumber": 8
  },
  {
    "id": "valmiki-ramayana-6-sarga-11-shlok-9",
    "collectionId": "valmiki-ramayana",
