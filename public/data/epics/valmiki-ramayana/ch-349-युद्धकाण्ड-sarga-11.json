    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-6-sarga-11-shlok-7",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "रथैश्चातिरथाः शीघ्रं मत्तैश्च वरवारणैः।",
          "अनूत्पेतुर्दशग्रीवमाक्रीडद्भिश्च वाजिभिः॥७॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-11",
    "chapterName": "युद्धकाण्ड, सर्ग 11",
    "verseNumber": 7
  },
  {
    "id": "valmiki-ramayana-6-sarga-11-shlok-8",
