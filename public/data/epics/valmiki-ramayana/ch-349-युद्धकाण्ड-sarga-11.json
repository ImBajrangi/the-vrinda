    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "विमलं चातपत्रं च प्रगृहीतमशोभत ॥१०॥",
          "पाण्डुरं राक्षसेन्द्रस्य पूर्णस्ताराधिपो यथा।"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-11",
    "chapterName": "युद्धकाण्ड, सर्ग 11",
    "verseNumber": 10
  },
  {
