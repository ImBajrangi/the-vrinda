    "titleDevanagari": "वाल्मीकि रामायण, युद्धकाण्ड, सर्ग 11, श्लोक 1",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-6-sarga-11-shlok-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "स बभूव कृशो राजा मैथिलीकाममोहितः।",
          "असन्मानाच्च सुहृदां पापः पापेन कर्मणा॥१॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-11",
    "chapterName": "युद्धकाण्ड, सर्ग 11",
    "verseNumber": 1
  },
  {
    "id": "valmiki-ramayana-6-sarga-11-shlok-2",
    "collectionId": "valmiki-ramayana",
    "index": 11562,
    "titleDevanagari": "वाल्मीकि रामायण, युद्धकाण्ड, सर्ग 11, श्लोक 2",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-6-sarga-11-shlok-2",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "अतीव कामसम्पन्नो वैदेहीमनुचिन्तयन्।",
          "अतीतसमये काले तस्मिन् वै युधि रावणः।",
          "अमात्यैश्च सुहृद्भिश्च प्राप्तकालममन्यत॥२॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-11",
    "chapterName": "युद्धकाण्ड, सर्ग 11",
    "verseNumber": 2
  },
  {
    "id": "valmiki-ramayana-6-sarga-11-shlok-3",
    "collectionId": "valmiki-ramayana",
    "index": 11563,
    "titleDevanagari": "वाल्मीकि रामायण, युद्धकाण्ड, सर्ग 11, श्लोक 3",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-6-sarga-11-shlok-3",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "स हेमजालविततं मणिविद्रमभूषितम्।",
          "उपगम्य विनीताश्वमारुरोह महारथम्॥३॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-11",
    "chapterName": "युद्धकाण्ड, सर्ग 11",
    "verseNumber": 3
  },
  {
