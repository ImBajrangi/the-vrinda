    "index": 11566,
    "titleDevanagari": "वाल्मीकि रामायण, युद्धकाण्ड, सर्ग 11, श्लोक 6",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-6-sarga-11-shlok-6",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "नानाविकृतवेषाश्च नानाभूषणभूषिताः।",
          "पार्श्वतः पृष्ठतश्चैनं परिवार्य ययुस्तदा॥६॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-11",
    "chapterName": "युद्धकाण्ड, सर्ग 11",
    "verseNumber": 6
  },
  {
