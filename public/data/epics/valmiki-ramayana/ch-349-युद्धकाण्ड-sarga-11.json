    "slug": "valmiki-ramayana-6-sarga-11-shlok-12",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "ते कृताञ्जलयः सर्वे रथस्थं पृथिवीस्थिताः॥१२॥",
          "राक्षसा राक्षसश्रेष्ठं शिरोभिस्तं ववन्दिरे।"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-11",
    "chapterName": "युद्धकाण्ड, सर्ग 11",
    "verseNumber": 12
