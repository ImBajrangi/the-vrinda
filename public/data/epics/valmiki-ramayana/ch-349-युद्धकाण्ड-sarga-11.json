    "slug": "valmiki-ramayana-6-sarga-11-shlok-4",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "तमास्थाय रथश्रेष्ठं महामेघसमस्वनम्।",
          "प्रययौ रक्षसां श्रेष्ठो दशग्रीवः सभां प्रति॥४॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-11",
    "chapterName": "युद्धकाण्ड, सर्ग 11",
    "verseNumber": 4
  },
  {
