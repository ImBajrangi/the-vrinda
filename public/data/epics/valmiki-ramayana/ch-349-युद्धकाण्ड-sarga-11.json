    "slug": "valmiki-ramayana-6-sarga-11-shlok-9",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "तुमुलः शङ्खशब्दश्च सभां गच्छति रावणे।",
          "स नेमिघोषेण महान् सहसाभिनिनादयन्॥९॥",
          "राजमार्गं श्रिया जुष्टं प्रतिपेदे महारथः।"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-11",
    "chapterName": "युद्धकाण्ड, सर्ग 11",
    "verseNumber": 9
  },
  {
    "id": "valmiki-ramayana-6-sarga-11-shlok-10",
    "collectionId": "valmiki-ramayana",
