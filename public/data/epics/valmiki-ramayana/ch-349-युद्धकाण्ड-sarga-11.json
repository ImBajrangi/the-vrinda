    "slug": "valmiki-ramayana-6-sarga-11-shlok-13",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "राक्षसैः स्तूयमानः सञ्जयाशीर्भिररिंदमः॥१३॥",
          "आससाद महातेजाः सभां विरचितां तदा।।"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-11",
