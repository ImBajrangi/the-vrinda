    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "तेषामञ्जलिपद्मानि प्रगृहीतानि सर्वशः।",
          "प्रतिगृह्याब्रवीद राजा तेभ्यः प्रियहितं वचः॥१॥"
        ]
      }
    ],
    "chapterId": "अयोध्याकाण्ड-sarga-3",
    "chapterName": "अयोध्याकाण्ड, सर्ग 3",
