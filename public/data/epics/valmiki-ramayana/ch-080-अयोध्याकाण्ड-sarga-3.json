    "slug": "valmiki-ramayana-2-sarga-3-shlok-5",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "राज्ञस्तूपरते वाक्ये जनघोषो महानभूत्।",
          "शनैस्तस्मिन् प्रशान्ते च जनघोषे जनाधिपः॥५॥",
          "वसिष्ठं मुनिशार्दूलं राजा वचनमब्रवीत्।"
        ]
      }
    ],
    "chapterId": "अयोध्याकाण्ड-sarga-3",
    "chapterName": "अयोध्याकाण्ड, सर्ग 3",
    "verseNumber": 5
  },
