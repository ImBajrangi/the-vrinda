[
  {
    "id": "valmiki-ramayana-3-sarga-47-shlok-1",
    "collectionId": "valmiki-ramayana",
    "index": 8011,
    "titleDevanagari": "वाल्मीकि रामायण, अरण्यकाण्ड, सर्ग 47, श्लोक 1",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-47-shlok-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "रावणेन तु वैदेही तदा पृष्टा जिहीर्षुणा।",
          "परिव्राजकरूपेण शशंसात्मानमात्मना॥१॥",
          "दुहिता जनकस्याहं मैथिलस्य महात्मनः।",
          "सीता नाम्नास्मि भद्रं ते रामस्य महिषी प्रिया॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-47",
    "chapterName": "अरण्यकाण्ड, सर्ग 47",
    "verseNumber": 1
  },
  {
    "id": "valmiki-ramayana-3-sarga-47-shlok-4",
    "collectionId": "valmiki-ramayana",
    "index": 8012,
    "titleDevanagari": "वाल्मीकि रामायण, अरण्यकाण्ड, सर्ग 47, श्लोक 4",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-47-shlok-4",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "उषित्वा द्वादश समा इक्ष्वाकूणां निवेशने।",
          "भुजाना मानुषान् भोगान् सर्वकामसमृद्धिनी॥ ४॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-47",
    "chapterName": "अरण्यकाण्ड, सर्ग 47",
    "verseNumber": 4
  },
  {
    "id": "valmiki-ramayana-3-sarga-47-shlok-5",
    "collectionId": "valmiki-ramayana",
    "index": 8013,
    "titleDevanagari": "वाल्मीकि रामायण, अरण्यकाण्ड, सर्ग 47, श्लोक 5",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-47-shlok-5",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "तत्र त्रयोदशे वर्षे राजाऽमन्त्रयत प्रभुः।।",
          "अभिषेचयितं रामं समेतो राजमन्त्रिभिः॥५॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-47",
    "chapterName": "अरण्यकाण्ड, सर्ग 47",
    "verseNumber": 5
  },
  {
    "id": "valmiki-ramayana-3-sarga-47-shlok-6",
    "collectionId": "valmiki-ramayana",
    "index": 8014,
    "titleDevanagari": "वाल्मीकि रामायण, अरण्यकाण्ड, सर्ग 47, श्लोक 6",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-47-shlok-6",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "तस्मिन् सम्भ्रियमाणे तु राघवस्याभिषेचने।",
          "कैकेयी नाम भर्तारं ममार्या याचते वरम्॥६॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-47",
    "chapterName": "अरण्यकाण्ड, सर्ग 47",
    "verseNumber": 6
  },
  {
    "id": "valmiki-ramayana-3-sarga-47-shlok-7",
    "collectionId": "valmiki-ramayana",
    "index": 8015,
    "titleDevanagari": "वाल्मीकि रामायण, अरण्यकाण्ड, सर्ग 47, श्लोक 7",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-47-shlok-7",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "परिगृह्य तु कैकेयी श्वशुरं सुकृतेन मे।",
          "मम प्रव्राजनं भर्तुर्भरतस्याभिषेचनम्॥७॥",
          "द्वावयाचत भर्तारं सत्यसंधं नृपोत्तमम्।",
          "नाद्य भोक्ष्ये न च स्वप्स्ये न पास्ये न कदाचन॥ ८॥",
          "एष मे जीवितस्यान्तो रामो यदभिषिच्यते।"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-47",
    "chapterName": "अरण्यकाण्ड, सर्ग 47",
    "verseNumber": 7
  },
  {
    "id": "valmiki-ramayana-3-sarga-47-shlok-10",
    "collectionId": "valmiki-ramayana",
    "index": 8016,
    "titleDevanagari": "वाल्मीकि रामायण, अरण्यकाण्ड, सर्ग 47, श्लोक 10",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-47-shlok-10",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "मम भर्ता महातेजा वयसा पञ्चविंशकः॥१०॥",
          "अष्टादश हि वर्षाणि मम जन्मनि गण्यते।।",
          "रामेति प्रथितो लोके सत्यवान् शीलवान् शुचिः॥ ११॥",
          "विशालाक्षो महाबाहुः सर्वभूतहिते रतः।",
          "कामार्तश्च महाराजः पिता दशरथः स्वयम्॥ १२॥",
          "कैकेय्याः प्रियकामार्थं तं रामं नाभ्यषेचयत्।"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-47",
    "chapterName": "अरण्यकाण्ड, सर्ग 47",
    "verseNumber": 10
  },
  {
    "id": "valmiki-ramayana-3-sarga-47-shlok-13",
    "collectionId": "valmiki-ramayana",
    "index": 8017,
    "titleDevanagari": "वाल्मीकि रामायण, अरण्यकाण्ड, सर्ग 47, श्लोक 13",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-47-shlok-13",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "अभिषेकाय तु पितुः समीपं राममागतम्॥१३॥",
          "कैकेयी मम भर्तारमित्युवाच द्रुतं वचः।"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-47",
    "chapterName": "अरण्यकाण्ड, सर्ग 47",
    "verseNumber": 13
  },
  {
    "id": "valmiki-ramayana-3-sarga-47-shlok-14",
    "collectionId": "valmiki-ramayana",
    "index": 8018,
    "titleDevanagari": "वाल्मीकि रामायण, अरण्यकाण्ड, सर्ग 47, श्लोक 14",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-47-shlok-14",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "तव पित्रा समाज्ञप्तं ममेदं शृणु राघव॥१४॥",
          "भरताय प्रदातव्यमिदं राज्यमकण्टकम्।",
          "त्वया तु खलु वस्तव्यं नव वर्षाणि पञ्च च॥ १५॥",
          "वने प्रव्रज काकुत्स्थ पितरं मोचयानृतात् ।"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-47",
    "chapterName": "अरण्यकाण्ड, सर्ग 47",
    "verseNumber": 14
  },
  {
    "id": "valmiki-ramayana-3-sarga-47-shlok-16",
    "collectionId": "valmiki-ramayana",
    "index": 8019,
    "titleDevanagari": "वाल्मीकि रामायण, अरण्यकाण्ड, सर्ग 47, श्लोक 16",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-47-shlok-16",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "तथेत्युवाच तां रामः कैकेयीमकुतोभयः॥१६॥",
          "चकार तद्वचः श्रुत्वा भर्ता मम दृढव्रतः।",
          "दद्यान्न प्रतिगृह्णीयात् सत्यं ब्रूयान्न चानृतम्॥ १७॥",
          "एतद् ब्राह्मण रामस्य व्रतं धृतमनुत्तमम्।"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-47",
    "chapterName": "अरण्यकाण्ड, सर्ग 47",
    "verseNumber": 16
  },
  {
    "id": "valmiki-ramayana-3-sarga-47-shlok-19",
    "collectionId": "valmiki-ramayana",
    "index": 8020,
    "titleDevanagari": "वाल्मीकि रामायण, अरण्यकाण्ड, सर्ग 47, श्लोक 19",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-47-shlok-19",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "तस्य भ्राता तु वैमात्रो लक्ष्मणो नाम वीर्यवान्॥ १८॥",
          "रामस्य पुरुषव्याघ्रः सहायः समरेऽरिहा ।",
          "स भ्राता लक्ष्मणो नाम ब्रह्मचारी दृढव्रतः॥१९॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-47",
    "chapterName": "अरण्यकाण्ड, सर्ग 47",
    "verseNumber": 19
  },
  {
    "id": "valmiki-ramayana-3-sarga-47-shlok-20",
    "collectionId": "valmiki-ramayana",
    "index": 8021,
    "titleDevanagari": "वाल्मीकि रामायण, अरण्यकाण्ड, सर्ग 47, श्लोक 20",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-47-shlok-20",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "अन्वगच्छद् धनुष्पाणिः प्रव्रजन्तं मया सह।",
          "जटी तापसरूपेण मया सह सहानुजः॥२०॥",
          "प्रविष्टो दण्डकारण्यं धर्मनित्यो दृढव्रतः।",
          "ते वयं प्रच्युता राज्यात् कैकेय्यास्तु कृते त्रयः॥ २१॥",
          "विचराम द्विजश्रेष्ठ वनं गम्भीरमोजसा।",
          "समाश्वस मुहूर्तं तु शक्यं वस्तुमिह त्वया॥ २२॥",
          "आगमिष्यति मे भर्ता वन्यमादाय पुष्कलम्।"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-47",
    "chapterName": "अरण्यकाण्ड, सर्ग 47",
    "verseNumber": 20
  },
  {
