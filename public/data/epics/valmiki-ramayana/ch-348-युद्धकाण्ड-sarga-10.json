    "slug": "valmiki-ramayana-6-sarga-10-shlok-8",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "पुण्यान् पुण्याहघोषांश्च वेदविद्भिरुदाहृतान्।",
          "शुश्राव सुमहातेजा भ्रातुर्विजयसंश्रितान्॥८॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-10",
    "chapterName": "युद्धकाण्ड, सर्ग 10",
    "verseNumber": 8
  },
  {
