    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-6-sarga-10-shlok-11",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "स राजदृष्टिसम्पन्नमासनं हेमभूषितम्।",
          "जगाम समुदाचारं प्रयुज्याचारकोविदः॥११॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-10",
    "chapterName": "युद्धकाण्ड, सर्ग 10",
    "verseNumber": 11
  },
  {
