    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-6-sarga-10-shlok-14",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "यदाप्रभृति वैदेही सम्प्राप्तेह परंतप।",
          "तदाप्रभृति दृश्यन्ते निमित्तान्यशुभानि नः॥१४॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-10",
    "chapterName": "युद्धकाण्ड, सर्ग 10",
    "verseNumber": 14
  },
  {
