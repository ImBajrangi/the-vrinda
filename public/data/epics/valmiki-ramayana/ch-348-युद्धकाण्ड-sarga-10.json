    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-6-sarga-10-shlok-9",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "पूजितान् दधिपात्रैश्च सर्पिभिः सुमनोक्षतैः।",
          "मन्त्रवेदविदो विप्रान् ददर्श स महाबलः॥९॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-10",
    "chapterName": "युद्धकाण्ड, सर्ग 10",
    "verseNumber": 9
  },
  {
    "id": "valmiki-ramayana-6-sarga-10-shlok-10",
