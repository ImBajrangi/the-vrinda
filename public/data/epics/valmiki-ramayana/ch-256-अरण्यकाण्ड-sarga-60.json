    "slug": "valmiki-ramayana-3-sarga-60-shlok-3",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "त्वरमाणो जगामाथ सीतादर्शनलालसः।",
          "शून्यमावसथं दृष्ट्वा बभूवोद्विग्नमानसः॥३॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-60",
    "chapterName": "अरण्यकाण्ड, सर्ग 60",
    "verseNumber": 3
  },
  {
