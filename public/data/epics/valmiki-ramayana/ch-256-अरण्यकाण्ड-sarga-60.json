    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "रुदन्तमिव वृक्षैश्च ग्लानपुष्पमृगद्विजम्।",
          "श्रिया विहीनं विध्वस्तं संत्यक्तं वनदैवतैः॥६॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-60",
    "chapterName": "अरण्यकाण्ड, सर्ग 60",
    "verseNumber": 6
