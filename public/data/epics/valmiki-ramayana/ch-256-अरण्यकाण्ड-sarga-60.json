    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-60-shlok-5",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "उद्भ्रमन्निव वेगेन विक्षिपन् रघुनन्दनः।",
          "तत्र तत्रोटजस्थानमभिवीक्ष्य समन्ततः॥४॥",
          "ददर्श पर्णशालां च सीतया रहितां तदा।",
          "श्रिया विरहितां ध्वस्तां हेमन्ते पद्मिनीमिव॥५॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-60",
    "chapterName": "अरण्यकाण्ड, सर्ग 60",
    "verseNumber": 5
  },
  {
