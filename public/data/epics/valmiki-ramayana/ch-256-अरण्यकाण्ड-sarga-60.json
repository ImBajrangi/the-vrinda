    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "अथवार्जुन शंस त्वं प्रियां तामनिप्रियाम्।",
          "जनकस्य सुता तन्वी यदि जीवति वा न वा॥ १४॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-60",
