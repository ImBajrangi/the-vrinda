    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "या प्रीतिर्बहुमानश्च मय्ययोध्यानिवासिनाम्।",
          "मत्प्रियार्थं विशेषेण भरते सा विधीयताम्॥६॥"
        ]
      }
    ],
    "chapterId": "अयोध्याकाण्ड-sarga-45",
    "chapterName": "अयोध्याकाण्ड, सर्ग 45",
    "verseNumber": 6
  },
