    "slug": "valmiki-ramayana-2-sarga-45-shlok-2",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "निवर्तितेऽतीव बलात् सुहृद्धर्मेण राजनि।",
          "नैव ते संन्यवर्तन्त रामस्यानुगता रथम्॥२॥"
        ]
      }
    ],
    "chapterId": "अयोध्याकाण्ड-sarga-45",
    "chapterName": "अयोध्याकाण्ड, सर्ग 45",
    "verseNumber": 2
  },
  {
