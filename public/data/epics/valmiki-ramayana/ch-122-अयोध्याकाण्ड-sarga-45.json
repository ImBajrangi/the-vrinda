    "slug": "valmiki-ramayana-2-sarga-45-shlok-3",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "अयोध्यानिलयानां हि पुरुषाणां महायशाः।",
          "बभूव गुणसम्पन्नः पूर्णचन्द्र इव प्रियः॥३॥"
        ]
      }
    ],
    "chapterId": "अयोध्याकाण्ड-sarga-45",
    "chapterName": "अयोध्याकाण्ड, सर्ग 45",
    "verseNumber": 3
  },
  {
