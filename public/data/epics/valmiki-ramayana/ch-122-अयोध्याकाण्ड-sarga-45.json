    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "स हि कल्याणचारित्रः कैकेय्यानन्दवर्धनः।",
          "करिष्यति यथावद् वः प्रियाणि च हितानि च॥ ७॥"
        ]
      }
    ],
    "chapterId": "अयोध्याकाण्ड-sarga-45",
    "chapterName": "अयोध्याकाण्ड, सर्ग 45",
    "verseNumber": 7
  },
