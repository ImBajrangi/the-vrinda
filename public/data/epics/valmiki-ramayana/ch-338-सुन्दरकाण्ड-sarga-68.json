    "slug": "valmiki-ramayana-5-sarga-68-shlok-2",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "एवं बहुविधं वाच्यो रामो दाशरथिस्त्वया।",
          "यथा मां प्राप्नुयाच्छीघ्रं हत्वा रावणमाहवे॥२॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-68",
    "chapterName": "सुन्दरकाण्ड, सर्ग 68",
    "verseNumber": 2
  },
  {
