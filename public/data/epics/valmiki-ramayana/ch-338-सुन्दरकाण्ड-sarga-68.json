    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "अथाहमुत्तरं देव्या पुनरुक्तः ससम्भ्रमम्।",
          "तव स्नेहान्नरव्याघ्र सौहार्दादनुमान्य च॥१॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-68",
    "chapterName": "सुन्दरकाण्ड, सर्ग 68",
    "verseNumber": 1
  },
  {
