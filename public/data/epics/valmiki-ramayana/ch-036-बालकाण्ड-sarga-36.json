    "slug": "valmiki-ramayana-1-sarga-36-shlok-2",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "तस्मिन् प्रतिगृहीते तु वाक्ये हरिगणेश्वरः।",
          "लक्ष्मणात् सुमहत् त्रासं वस्त्रं क्लिन्नमिवात्यजत्॥२॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-36",
    "chapterName": "बालकाण्ड, सर्ग 36",
    "verseNumber": 2
  },
  {
