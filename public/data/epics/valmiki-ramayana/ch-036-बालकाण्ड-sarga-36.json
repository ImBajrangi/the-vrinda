    "slug": "valmiki-ramayana-1-sarga-36-shlok-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "इत्युक्तस्तारया वाक्यं प्रश्रितं धर्मसंहितम्।",
          "मृदुस्वभावः सौमित्रिः प्रतिजग्राह तद्वचः॥१॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-36",
    "chapterName": "बालकाण्ड, सर्ग 36",
    "verseNumber": 1
  },
  {
    "id": "valmiki-ramayana-1-sarga-36-shlok-2",
    "collectionId": "valmiki-ramayana",
    "index": 1746,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 36, श्लोक 2",
