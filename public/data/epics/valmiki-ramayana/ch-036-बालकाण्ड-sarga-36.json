    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "ततः कण्ठगतं माल्यं चित्रं बहुगुणं महत्।",
          "चिच्छेद विमदश्चासीत् सुग्रीवो वानरेश्वरः॥३॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-36",
    "chapterName": "बालकाण्ड, सर्ग 36",
    "verseNumber": 3
  },
  {
