    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "कृतैर्विशेषकैराः षडतुकुसुमोद्भवैः।",
          "बभावन्यतमेव श्रीः कान्तिश्रीद्युतिकीर्तिभिः॥१७॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-26",
    "chapterName": "बालकाण्ड, सर्ग 26",
    "verseNumber": 17
