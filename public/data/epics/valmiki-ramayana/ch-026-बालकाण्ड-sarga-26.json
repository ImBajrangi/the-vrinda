    "slug": "valmiki-ramayana-1-sarga-26-shlok-10-2",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "पुष्पवर्षाणि मुञ्चन्तो नगाः पवनताडिताः।",
          "शैलं तं वासयन्तीव मधुमाधवगन्धिनः ॥१०॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-26",
    "chapterName": "बालकाण्ड, सर्ग 26",
    "verseNumber": 10
  },
  {
    "id": "valmiki-ramayana-1-sarga-26-shlok-11",
    "collectionId": "valmiki-ramayana",
    "index": 1270,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 26, श्लोक 11",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-26-shlok-11",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "मधुपुष्परजःपृक्तं गन्धमादाय पुष्कलम्।",
          "प्रववौ वर्धयन् कामं रावणस्य सुखोऽनिलः॥११॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-26",
    "chapterName": "बालकाण्ड, सर्ग 26",
    "verseNumber": 11
  },
  {
    "id": "valmiki-ramayana-1-sarga-26-shlok-12-1",
    "collectionId": "valmiki-ramayana",
    "index": 1271,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 26, श्लोक 12",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-26-shlok-12-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "एवमुक्त्वा हनूमन्तं रामः सुग्रीवमब्रवीत्॥११॥",
          "वृत्तज्ञो वृत्तसम्पन्नमुदारबलविक्रमम्।",
          "इममप्यङ्गदं वीरं यौवराज्येऽभिषेचय॥१२॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-26",
    "chapterName": "बालकाण्ड, सर्ग 26",
    "verseNumber": 12
  },
  {
    "id": "valmiki-ramayana-1-sarga-26-shlok-13",
    "collectionId": "valmiki-ramayana",
    "index": 1272,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 26, श्लोक 13",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-26-shlok-13",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "गेयात् पुष्पसमृद्ध्या च शैत्याद् वायोर्गिरेर्गुणात्।",
          "प्रवृत्तायां रजन्यां च चन्द्रस्योदयनेन च ॥१२॥",
          "रावणः स महावीर्यः कामस्य वशमागतः।",
          "विनिःश्वस्य विनिःश्वस्य शशिनं समवैक्षत॥१३॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-26",
    "chapterName": "बालकाण्ड, सर्ग 26",
    "verseNumber": 13
  },
  {
    "id": "valmiki-ramayana-1-sarga-26-shlok-14-1",
    "collectionId": "valmiki-ramayana",
    "index": 1273,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 26, श्लोक 14",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-26-shlok-14-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "पूर्वोऽयं वार्षिको मासः श्रावणः सलिलागमः।",
          "प्रवृत्ताः सौम्य चत्वारो मासा वार्षिक संज्ञिताः॥ १४॥",
          "नायमुद्योगसमयः प्रविश त्वं पुरीं शुभाम्।",
          "अस्मिन् वत्स्याम्यहं सौम्य पर्वते सहलक्ष्मणः॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-26",
    "chapterName": "बालकाण्ड, सर्ग 26",
    "verseNumber": 14
  },
  {
