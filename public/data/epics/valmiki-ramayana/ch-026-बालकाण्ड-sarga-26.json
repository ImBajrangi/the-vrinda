[
  {
    "id": "valmiki-ramayana-1-sarga-26-shlok-1",
    "collectionId": "valmiki-ramayana",
    "index": 1260,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 26, श्लोक 1",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-26-shlok-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "स तु तत्र दशग्रीवः सह सैन्येन वीर्यवान्।",
          "अस्तं प्राप्ते दिनकरे निवासं समरोचयत्॥१॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-26",
    "chapterName": "बालकाण्ड, सर्ग 26",
    "verseNumber": 1
  },
  {
    "id": "valmiki-ramayana-1-sarga-26-shlok-2-1",
    "collectionId": "valmiki-ramayana",
    "index": 1261,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 26, श्लोक 2",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-26-shlok-2-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "उदिते विमले चन्द्रे तुल्यपर्वतवर्चसि।",
          "प्रसुप्तं सुमहत् सैन्यं नानाप्रहरणायुधम्॥२॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-26",
    "chapterName": "बालकाण्ड, सर्ग 26",
    "verseNumber": 2
  },
  {
    "id": "valmiki-ramayana-1-sarga-26-shlok-3-1",
    "collectionId": "valmiki-ramayana",
    "index": 1262,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 26, श्लोक 3",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-26-shlok-3-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "ततः काञ्चनशैलाभस्तरुणार्कनिभाननः।",
          "अब्रवीत् प्राञ्जलिर्वाक्यं हनूमान् मारुतात्मजः॥३॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-26",
    "chapterName": "बालकाण्ड, सर्ग 26",
    "verseNumber": 3
  },
  {
    "id": "valmiki-ramayana-1-sarga-26-shlok-4",
    "collectionId": "valmiki-ramayana",
    "index": 1263,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 26, श्लोक 4",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-26-shlok-4",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "भवत्प्रसादात् काकुत्स्थ पितृपैतामहं महत्।",
          "वानराणां सुदंष्ट्राणां सम्पन्नबलशालिनाम्॥४॥",
          "महात्मनां सुदुष्प्रापं प्राप्तं राज्यमिदं प्रभो।",
          "भवता समनुज्ञातः प्रविश्य नगरं शुभम्॥५॥",
          "संविधास्यति कार्याणि सर्वाणि ससुहृद्गणः।"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-26",
    "chapterName": "बालकाण्ड, सर्ग 26",
    "verseNumber": 4
  },
  {
    "id": "valmiki-ramayana-1-sarga-26-shlok-5",
    "collectionId": "valmiki-ramayana",
    "index": 1264,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 26, श्लोक 5",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-26-shlok-5",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "गोब्राह्मणहितार्थाय देशस्य च हिताय च।",
          "तव चैवाप्रमेयस्य वचनं कर्तुमुद्यतः॥५॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-26",
    "chapterName": "बालकाण्ड, सर्ग 26",
    "verseNumber": 5
  },
  {
    "id": "valmiki-ramayana-1-sarga-26-shlok-6-2",
    "collectionId": "valmiki-ramayana",
    "index": 1265,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 26, श्लोक 6",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-26-shlok-6-2",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "कर्णिकारवनैर्दीप्तैः कदम्बबकुलैस्तथा।",
          "पद्मिनीभिश्च फुल्लाभिर्मन्दाकिन्या जलैरपि।",
          "चम्पकाशोकपूनागमन्दारतरुभिस्तथा।",
          "चूतपाटललोधैश्च प्रियङ्ग्वर्जुनकेतकैः॥५॥",
          "तगरैर्नारिकेलैश्च प्रियालपनसैस्तथा।",
          "एतैरन्यैश्च तरुभिरुद्भासितवनान्तरे॥६॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-26",
    "chapterName": "बालकाण्ड, सर्ग 26",
    "verseNumber": 6
  },
  {
    "id": "valmiki-ramayana-1-sarga-26-shlok-7",
    "collectionId": "valmiki-ramayana",
    "index": 1266,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 26, श्लोक 7",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-26-shlok-7",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "किन्नरा मदनेनार्ता रक्ता मधुरकण्ठिनः।",
          "समं सम्प्रजगुर्यत्र मनस्तुष्टिविवर्धनम्॥७॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-26",
    "chapterName": "बालकाण्ड, सर्ग 26",
    "verseNumber": 7
  },
  {
    "id": "valmiki-ramayana-1-sarga-26-shlok-8-1",
    "collectionId": "valmiki-ramayana",
    "index": 1267,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 26, श्लोक 8",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-26-shlok-8-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "एवमुक्तो हनुमता राघवः परवीरहा॥८॥",
          "प्रत्युवाच हनूमन्तं बुद्धिमान् वाक्यकोविदः।",
          "चतुर्दश समाः सौम्य ग्रामं वा यदि वा पुरम्॥",
          "न प्रवेक्ष्यामि हनुमन् पितुर्निर्देशपालकः।"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-26",
    "chapterName": "बालकाण्ड, सर्ग 26",
    "verseNumber": 8
  },
  {
    "id": "valmiki-ramayana-1-sarga-26-shlok-9-1",
    "collectionId": "valmiki-ramayana",
    "index": 1268,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 26, श्लोक 9",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-26-shlok-9-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "घण्टानामिव संनादः शुश्रुवे मधुरस्वनः।",
          "अप्सरोगणसङ्घानां गायतां धनदालये॥९॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-26",
    "chapterName": "बालकाण्ड, सर्ग 26",
    "verseNumber": 9
  },
  {
    "id": "valmiki-ramayana-1-sarga-26-shlok-10-2",
