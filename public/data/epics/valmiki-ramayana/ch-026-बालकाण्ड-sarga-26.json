    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-26-shlok-15-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "दिव्यचन्दनलिप्ताङ्गी मन्दारकृतमूर्धजा।",
          "दिव्योत्सवकृतारम्भा दिव्यपुष्पविभूषिता॥१५॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-26",
    "chapterName": "बालकाण्ड, सर्ग 26",
    "verseNumber": 15
  },
  {
    "id": "valmiki-ramayana-1-sarga-26-shlok-16-1",
