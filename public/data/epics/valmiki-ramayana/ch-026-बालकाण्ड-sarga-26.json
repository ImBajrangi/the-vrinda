    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "नीलं सतोयमेघाभं वस्त्रं समवगुण्ठिता।",
          "यस्या वक्त्रं शशिनिभं भ्रवौ चापनिभे शुभे॥१८॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-26",
