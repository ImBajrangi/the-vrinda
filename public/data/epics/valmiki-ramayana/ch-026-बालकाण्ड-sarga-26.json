    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "तदेवं प्राञ्जलिः प्रह्वो याचते त्वां दशाननः।",
          "भर्तुर्भर्ता विधाता च त्रैलोक्यस्य भजस्व माम्॥२७॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-26",
    "chapterName": "बालकाण्ड, सर्ग 26",
    "verseNumber": 27
