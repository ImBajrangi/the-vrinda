    "slug": "valmiki-ramayana-2-sarga-74-shlok-2",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "राज्याद भ्रंशस्व कैकेयि नृशंसे दुष्टचारिणि।",
          "परित्यक्तासि धर्मेण मा मृतं रुदती भव॥२॥"
        ]
      }
    ],
    "chapterId": "अयोध्याकाण्ड-sarga-74",
    "chapterName": "अयोध्याकाण्ड, सर्ग 74",
    "verseNumber": 2
  },
  {
