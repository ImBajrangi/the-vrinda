    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "तां तथा गर्हयित्वा तु मातरं भरतस्तदा।",
          "रोषेण महताविष्टः पुनरेवाब्रवीद् वचः॥१॥"
        ]
      }
    ],
    "chapterId": "अयोध्याकाण्ड-sarga-74",
    "chapterName": "अयोध्याकाण्ड, सर्ग 74",
    "verseNumber": 1
  },
  {
