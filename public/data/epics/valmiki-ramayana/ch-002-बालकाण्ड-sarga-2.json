      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "तस्य तद् वचनं श्रुत्वा राघवस्य महात्मनः।",
          "कुम्भयोनिमहातेजा वाक्यमेतदवाच ह॥१॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-2",
    "chapterName": "बालकाण्ड, सर्ग 2",
    "verseNumber": 1
  },
  {
