    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "चिन्तयित्वा स धर्मात्मा विमृश्य गुरुलाघवम्।",
          "सुग्रीवः परमोद्विग्नः सर्वैस्तैर्वानरैः सह॥४॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-2",
    "chapterName": "बालकाण्ड, सर्ग 2",
    "verseNumber": 4
  },
