    "slug": "valmiki-ramayana-1-sarga-2-shlok-3",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "तावत् ते रावणस्येदं कुलं जन्म च राघव।",
          "वरप्रदानं च तथा तस्मै दत्तं ब्रवीमि ते॥३॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-2",
    "chapterName": "बालकाण्ड, सर्ग 2",
    "verseNumber": 3
  },
  {
