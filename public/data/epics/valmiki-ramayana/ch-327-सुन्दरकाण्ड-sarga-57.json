    "slug": "valmiki-ramayana-5-sarga-57-shlok-8",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "प्रविशन्नभ्रजालानि निष्क्रमंश्च पुनः पुनः।",
          "प्रकाशश्चाप्रकाशश्च चन्द्रमा इव दृश्यते॥८॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-57",
    "chapterName": "सुन्दरकाण्ड, सर्ग 57",
    "verseNumber": 8
  },
