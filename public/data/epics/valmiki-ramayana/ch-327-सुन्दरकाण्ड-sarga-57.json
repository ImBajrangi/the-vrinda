    "slug": "valmiki-ramayana-5-sarga-57-shlok-7",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "पाण्डुरारुणवर्णानि नीलमाञ्जिष्ठकानि च।",
          "हरितारुणवर्णानि महाभ्राणि चकाशिरे॥७॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-57",
    "chapterName": "सुन्दरकाण्ड, सर्ग 57",
    "verseNumber": 7
  },
