    "slug": "valmiki-ramayana-5-sarga-57-shlok-10",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "ताायमाणो गगने स बभौ वायुनन्दनः।",
          "दारयन् मेघवृन्दानि निष्पतंश्च पुनः पुनः॥१०॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-57",
    "chapterName": "सुन्दरकाण्ड, सर्ग 57",
    "verseNumber": 10
