        "linesDevanagari": [
          "विविधाभ्रघनापन्नगोचरो धवलाम्बरः।",
          "दृश्यादृश्यतनुर्वीरस्तथा चन्द्रायतेऽम्बरे॥९॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-57",
    "chapterName": "सुन्दरकाण्ड, सर्ग 57",
    "verseNumber": 9
  },
