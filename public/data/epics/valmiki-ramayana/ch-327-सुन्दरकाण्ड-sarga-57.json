[
  {
    "id": "valmiki-ramayana-5-sarga-57-shlok-4",
    "collectionId": "valmiki-ramayana",
    "index": 10822,
    "titleDevanagari": "वाल्मीकि रामायण, सुन्दरकाण्ड, सर्ग 57, श्लोक 4",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-5-sarga-57-shlok-4",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "आप्लुत्य च महावेगः पक्षवानिव पर्वतः।",
          "भुजङ्गयक्षगन्धर्वप्रबुद्धकमलोत्पलम्॥१॥",
          "स चन्द्रकुमुदं रम्यं सार्ककारण्डवं शुभम्।",
          "तिष्यश्रवणकादम्बमभ्रशैवलशाद्रलम्॥२॥",
          "पुनर्वसुमहामीनं लोहिताङ्गमहाग्रहम्।",
          "ऐरावतमहाद्वीपं स्वातीहंसविलासितम्॥३॥",
          "वातसंघातजालोमिचन्द्रांशुशिशिराम्बुमत्।",
          "हनूमानपरिश्रान्तः पुप्लुवे गगनार्णवम्॥४॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-57",
    "chapterName": "सुन्दरकाण्ड, सर्ग 57",
    "verseNumber": 4
  },
  {
    "id": "valmiki-ramayana-5-sarga-57-shlok-6",
    "collectionId": "valmiki-ramayana",
