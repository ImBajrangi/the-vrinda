          "येन संक्षिप्यते सर्वं त्रैलोक्यमिदमव्ययम्॥४॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-22",
    "chapterName": "बालकाण्ड, सर्ग 22",
    "verseNumber": 4
  },
