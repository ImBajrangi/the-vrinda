    "slug": "valmiki-ramayana-1-sarga-22-shlok-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "स तस्य तु महानादं श्रुत्वा वैवस्वतः प्रभुः।",
          "शत्रु विजयिनं मेने स्वबलस्य च संक्षयम्॥१॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-22",
    "chapterName": "बालकाण्ड, सर्ग 22",
    "verseNumber": 1
  },
  {
