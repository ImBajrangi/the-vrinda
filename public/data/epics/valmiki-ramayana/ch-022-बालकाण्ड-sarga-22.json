        "stanzaNumber": 1,
        "linesDevanagari": [
          "तं प्राप्तविजयं वाली सुग्रीवं प्लवगेश्वरम्।",
          "आभाष्य व्यक्तया वाचा सस्नेहमिदमब्रवीत्॥२॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-22",
    "chapterName": "बालकाण्ड, सर्ग 22",
    "verseNumber": 2
  },
