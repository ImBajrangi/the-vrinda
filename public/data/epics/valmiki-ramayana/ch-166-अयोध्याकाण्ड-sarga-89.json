    "slug": "valmiki-ramayana-2-sarga-89-shlok-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "व्युष्य रात्रिं तु तत्रैव गङ्गाकूले स राघवः।",
          "काल्यमुत्थाय शत्रुघ्नमिदं वचनमब्रवीत्॥१॥"
        ]
      }
    ],
    "chapterId": "अयोध्याकाण्ड-sarga-89",
    "chapterName": "अयोध्याकाण्ड, सर्ग 89",
    "verseNumber": 1
  },
