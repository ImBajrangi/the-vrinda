    "slug": "valmiki-ramayana-2-sarga-18-shlok-2",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "स पितुश्चरणौ पूर्वमभिवाद्य विनीतवत।",
          "ततो ववन्दे चरणौ कैकेय्याः सुसमाहितः॥२॥"
