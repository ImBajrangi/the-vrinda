    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-6-shlok-9",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "इत्युक्तस्तु सुरैः सर्वैः कपर्दी नीललोहितः।",
          "सुकेशं प्रति सापेक्षः प्राह देवगणान् प्रभुः॥९॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-6",
    "chapterName": "बालकाण्ड, सर्ग 6",
    "verseNumber": 9
  },
  {
