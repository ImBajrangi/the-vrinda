    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "ततस्तु जयशब्देन प्रतिनन्द्य महेश्वरम्।",
          "विष्णोः समीपमाजग्मुर्निशाचरभयार्दिताः॥१२॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-6",
    "chapterName": "बालकाण्ड, सर्ग 6",
