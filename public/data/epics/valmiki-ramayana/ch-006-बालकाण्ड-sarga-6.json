    "slug": "valmiki-ramayana-1-sarga-6-shlok-5",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "शरण्यान्यशरण्यानि ह्याश्रमाणि कृतानि नः।",
          "स्वर्गाच्च देवान् प्रच्याव्य स्वर्गे क्रीडन्ति देववत्॥५॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-6",
    "chapterName": "बालकाण्ड, सर्ग 6",
    "verseNumber": 5
  },
  {
    "id": "valmiki-ramayana-1-sarga-6-shlok-6-1",
    "collectionId": "valmiki-ramayana",
    "index": 290,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 6, श्लोक 6",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-6-shlok-6-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "॥ श्रीसीतारामचन्द्राभ्यां नमः॥",
          "श्रीमद्वाल्मीकीय रामायण",
          "किष्किन्धाकाण्डम्",
          "षष्ठः सर्गः (सर्ग 6)",
          "रसातले वा वर्तन्तीं वर्तन्तीं वा नभस्तले।",
          "अहमानीय दास्यामि तव भार्यामरिंदम॥६॥",
          "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये किष्किन्धाकाण्डे षष्ठः सर्गः॥६॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-6",
    "chapterName": "बालकाण्ड, सर्ग 6",
    "verseNumber": 6
  },
  {
