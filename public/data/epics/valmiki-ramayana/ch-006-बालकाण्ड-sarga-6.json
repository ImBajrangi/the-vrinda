    "slug": "valmiki-ramayana-1-sarga-6-shlok-14",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "सुकेशतनयैर्देव त्रिभिस्त्रेताग्निसंनिभैः।",
          "आक्रम्य वरदानेन स्थानान्यपहृतानि नः॥१४॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-6",
