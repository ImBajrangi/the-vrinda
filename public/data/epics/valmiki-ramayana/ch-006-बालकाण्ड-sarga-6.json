[
  {
    "id": "valmiki-ramayana-1-sarga-6-shlok-1-1",
    "collectionId": "valmiki-ramayana",
    "index": 285,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 6, श्लोक 1",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-6-shlok-1-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "पुनरेवाब्रवीत् प्रीतो राघवं रघुनन्दनम्।",
          "अयमाख्याति ते राम सचिवो मन्त्रिसत्तमः॥१॥",
          "हनुमान् यन्निमित्तं त्वं निर्जनं वनमागतः।"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-6",
    "chapterName": "बालकाण्ड, सर्ग 6",
    "verseNumber": 1
  },
  {
    "id": "valmiki-ramayana-1-sarga-6-shlok-2",
    "collectionId": "valmiki-ramayana",
    "index": 286,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 6, श्लोक 2",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-6-shlok-2",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "इक्ष्वाकूणामतिरथो यज्वा धर्मपरो वशी।",
          "महर्षिकल्पो राजर्षिस्त्रिषु लोकेषु विश्रुतः॥२॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-6",
    "chapterName": "बालकाण्ड, सर्ग 6",
    "verseNumber": 2
  },
  {
    "id": "valmiki-ramayana-1-sarga-6-shlok-3-1",
    "collectionId": "valmiki-ramayana",
    "index": 287,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 6, श्लोक 3",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-6-shlok-3-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "जगत्सृष्टयन्तकर्तारमजमव्यक्तरूपिणम्।",
          "आधारं सर्वलोकानामाराध्यं परमं गुरुम्॥२॥",
          "ते समेत्य तु कामारिं त्रिपुरारिं त्रिलोचनम्।",
          "ऊचुः प्राञ्जलयो देवा भयगद्गदभाषिणः॥३॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-6",
    "chapterName": "बालकाण्ड, सर्ग 6",
    "verseNumber": 3
  },
  {
    "id": "valmiki-ramayana-1-sarga-6-shlok-4-1",
    "collectionId": "valmiki-ramayana",
    "index": 288,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 6, श्लोक 4",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-6-shlok-4-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "लक्ष्मणेन सह भ्रात्रा वसतश्च वने तव॥२॥",
          "रक्षसापहृता भार्या मैथिली जनकात्मजा।",
          "त्वया वियुक्ता रुदती लक्ष्मणेन च धीमता॥३॥",
          "अन्तरं प्रेप्सुना तेन हत्वा गृधं जटायुषम्।",
          "भार्यावियोगजं दुःखं प्रापितस्तेन रक्षसा॥४॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-6",
    "chapterName": "बालकाण्ड, सर्ग 6",
    "verseNumber": 4
  },
  {
    "id": "valmiki-ramayana-1-sarga-6-shlok-5",
    "collectionId": "valmiki-ramayana",
    "index": 289,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 6, श्लोक 5",
