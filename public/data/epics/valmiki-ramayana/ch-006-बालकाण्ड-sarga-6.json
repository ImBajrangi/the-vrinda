    "slug": "valmiki-ramayana-1-sarga-6-shlok-16-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "ततो गृहीत्वा वासस्तु शुभान्याभरणानि च।",
          "अभवद् बाष्पसंरुद्धो नीहारेणेव चन्द्रमाः॥१६॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-6",
    "chapterName": "बालकाण्ड, सर्ग 6",
