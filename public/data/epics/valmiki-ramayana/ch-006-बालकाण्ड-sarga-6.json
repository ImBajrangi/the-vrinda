    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-6-shlok-10-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "अनुमानात् तु जानामि मैथिली सा न संशयः।",
          "ह्रियमाणा मया दृष्टा रक्षसा रौद्रकर्मणा॥९॥",
          "क्रोशन्ती रामरामेति लक्ष्मणेति च विस्वरम्।",
          "स्फुरन्ती रावणस्याङ्के पन्नगेन्द्रवधूर्यथा॥१०॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-6",
    "chapterName": "बालकाण्ड, सर्ग 6",
    "verseNumber": 10
  },
  {
