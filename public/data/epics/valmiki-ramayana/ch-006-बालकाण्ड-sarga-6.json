    "slug": "valmiki-ramayana-1-sarga-6-shlok-7",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "नाल्पसंनिचयः कश्चिदासीत् तस्मिन् पुरोत्तमे।",
          "कुटुम्बी यो ह्यसिद्धार्थोऽगवाश्वधनधान्यवान्॥७॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-6",
    "chapterName": "बालकाण्ड, सर्ग 6",
    "verseNumber": 7
  },
  {
