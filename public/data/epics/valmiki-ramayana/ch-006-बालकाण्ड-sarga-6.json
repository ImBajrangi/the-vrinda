    "collectionId": "valmiki-ramayana",
    "index": 295,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 6, श्लोक 11",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-6-shlok-11",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "एतमेव समुद्योगं पुरस्कृत्य महर्षयः।",
          "गच्छध्वं शरणं विष्णुं हनिष्यति स तान् प्रभुः॥११॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-6",
    "chapterName": "बालकाण्ड, सर्ग 6",
    "verseNumber": 11
  },
