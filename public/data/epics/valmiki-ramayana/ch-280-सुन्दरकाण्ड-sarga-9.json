    "slug": "valmiki-ramayana-5-sarga-9-shlok-3",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "मार्गमाणस्तु वैदेहीं सीतामायतलोचनाम्।",
          "सर्वतः परिचक्राम हनूमानरिसूदनः॥३॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-9",
    "chapterName": "सुन्दरकाण्ड, सर्ग 9",
    "verseNumber": 3
