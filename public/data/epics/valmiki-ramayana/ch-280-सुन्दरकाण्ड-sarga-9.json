    "slug": "valmiki-ramayana-5-sarga-9-shlok-2",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "तस्यालयवरिष्ठस्य मध्ये विमलमायतम्।",
          "ददर्श भवनश्रेष्ठं हनुमान् मारुतात्मजः॥१॥",
          "अर्धयोजनविस्तीर्णमायतं योजनं महत्।",
          "भवनं राक्षसेन्द्रस्य बहुप्रासादसंकुलम्॥२॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-9",
    "chapterName": "सुन्दरकाण्ड, सर्ग 9",
    "verseNumber": 2
  },
  {
