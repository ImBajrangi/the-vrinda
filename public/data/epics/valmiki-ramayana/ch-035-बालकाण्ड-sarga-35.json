    "slug": "valmiki-ramayana-1-sarga-35-shlok-8-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "स हि प्राप्तं न जानीते कालं कालविदां वरः।",
          "विश्वामित्रो महातेजाः किं पुनर्यः पृथग्जनः॥ ८॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-35",
    "chapterName": "बालकाण्ड, सर्ग 35",
    "verseNumber": 8
  },
  {
