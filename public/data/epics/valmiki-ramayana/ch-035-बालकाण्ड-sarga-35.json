    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 35, श्लोक 1",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-35-shlok-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "तथा ब्रूवाणं सौमित्रिं प्रदीप्तमिव तेजसा।",
          "अब्रवील्लक्ष्मणं तारा ताराधिपनिभानना॥१॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-35",
    "chapterName": "बालकाण्ड, सर्ग 35",
    "verseNumber": 1
  },
  {
    "id": "valmiki-ramayana-1-sarga-35-shlok-2",
    "collectionId": "valmiki-ramayana",
    "index": 1721,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 35, श्लोक 2",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-35-shlok-2",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "नैवं लक्ष्मण वक्तव्यो नायं परुषमर्हति।",
          "हरीणामीश्वरः श्रोतुं तव वक्त्राद् विशेषतः॥२॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-35",
    "chapterName": "बालकाण्ड, सर्ग 35",
    "verseNumber": 2
  },
  {
