    "collectionId": "valmiki-ramayana",
    "index": 1722,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 35, श्लोक 3",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-35-shlok-3-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "नैवाकृतज्ञः सुग्रीवो न शठो नापि दारुणः।",
          "नैवानृतकथो वीर न जिह्मश्च कपीश्वरः॥३॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-35",
    "chapterName": "बालकाण्ड, सर्ग 35",
    "verseNumber": 3
  },
  {
    "id": "valmiki-ramayana-1-sarga-35-shlok-4",
    "collectionId": "valmiki-ramayana",
    "index": 1723,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 35, श्लोक 4",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-35-shlok-4",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "उपकारं कृतं वीरो नाप्ययं विस्मृतः कपिः।",
          "रामेण वीर सुग्रीवो यदन्यैर्दुष्करं रणे॥४॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-35",
    "chapterName": "बालकाण्ड, सर्ग 35",
    "verseNumber": 4
  },
  {
    "id": "valmiki-ramayana-1-sarga-35-shlok-5",
    "collectionId": "valmiki-ramayana",
    "index": 1724,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 35, श्लोक 5",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-35-shlok-5",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "रामप्रसादात् कीर्तिं च कपिराज्यं च शाश्वतम्।",
          "प्राप्तवानिह सुग्रीवो रुमां मां च परंतप॥५॥",
          "सुदुःखशयितः पूर्वं प्राप्येदं सुखमुत्तमम्।",
          "प्राप्तकालं न जानीते विश्वामित्रो यथा मुनिः॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-35",
    "chapterName": "बालकाण्ड, सर्ग 35",
    "verseNumber": 5
  },
  {
    "id": "valmiki-ramayana-1-sarga-35-shlok-6",
    "collectionId": "valmiki-ramayana",
    "index": 1725,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 35, श्लोक 6",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-35-shlok-6",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "एवमुक्ता महर्षयो विश्वामित्रेण धीमता।",
          "पश्यन्तस्ते प्रयाता वै वनानि विविधानि च॥६॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-35",
    "chapterName": "बालकाण्ड, सर्ग 35",
    "verseNumber": 6
  },
  {
