    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "घृताच्यां किल संसक्तो दश वर्षाणि लक्ष्मण।",
          "अहोऽमन्यत धर्मात्मा विश्वामित्रो महामुनिः॥७॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-35",
    "chapterName": "बालकाण्ड, सर्ग 35",
    "verseNumber": 7
  },
  {
