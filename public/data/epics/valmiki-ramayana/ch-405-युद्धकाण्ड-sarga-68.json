    "titleDevanagari": "वाल्मीकि रामायण, युद्धकाण्ड, सर्ग 68, श्लोक 1",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-6-sarga-68-shlok-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "कुम्भकर्णं हतं दृष्ट्वा राघवेण महात्मना।",
          "राक्षसा राक्षसेन्द्राय रावणाय न्यवेदयन्॥१॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-68",
    "chapterName": "युद्धकाण्ड, सर्ग 68",
    "verseNumber": 1
  },
  {
    "id": "valmiki-ramayana-6-sarga-68-shlok-2",
    "collectionId": "valmiki-ramayana",
    "index": 13807,
    "titleDevanagari": "वाल्मीकि रामायण, युद्धकाण्ड, सर्ग 68, श्लोक 2",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-6-sarga-68-shlok-2",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "राजन् स कालसंकाशः संयुक्तः कालकर्मणा।",
          "विद्राव्य वानरी सेनां भक्षयित्वा च वानरान्॥२॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-68",
    "chapterName": "युद्धकाण्ड, सर्ग 68",
    "verseNumber": 2
  },
  {
    "id": "valmiki-ramayana-6-sarga-68-shlok-5",
    "collectionId": "valmiki-ramayana",
    "index": 13808,
    "titleDevanagari": "वाल्मीकि रामायण, युद्धकाण्ड, सर्ग 68, श्लोक 5",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-6-sarga-68-shlok-5",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "प्रतपित्वा मुहूर्तं तु प्रशान्तो रामतेजसा।",
          "कायेनार्धप्रविष्टेन समुद्रं भीमदर्शनम्॥३॥",
          "निकृत्तनासाकर्णेन विक्षरद्रुधिरेण च।",
          "रुद्ध्वा द्वारं शरीरेण लङ्कायाः पर्वतोपमः॥४॥",
          "कुम्भकर्णस्तव भ्राता काकुत्स्थशरपीडितः।",
          "अगण्डभूतो विवृतो दावदग्ध इव द्रुमः॥५॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-68",
    "chapterName": "युद्धकाण्ड, सर्ग 68",
    "verseNumber": 5
  },
  {
    "id": "valmiki-ramayana-6-sarga-68-shlok-6",
    "collectionId": "valmiki-ramayana",
    "index": 13809,
    "titleDevanagari": "वाल्मीकि रामायण, युद्धकाण्ड, सर्ग 68, श्लोक 6",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-6-sarga-68-shlok-6",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "श्रुत्वा विनिहतं संख्ये कुम्भकर्णं महाबलम्।",
          "रावणः शोकसंतप्तो मुमोह च पपात च॥६॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-68",
    "chapterName": "युद्धकाण्ड, सर्ग 68",
    "verseNumber": 6
  },
  {
    "id": "valmiki-ramayana-6-sarga-68-shlok-7",
    "collectionId": "valmiki-ramayana",
    "index": 13810,
    "titleDevanagari": "वाल्मीकि रामायण, युद्धकाण्ड, सर्ग 68, श्लोक 7",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-6-sarga-68-shlok-7",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "पितृव्यं निहतं श्रुत्वा देवान्तकनरान्तकौ।",
          "त्रिशिराश्चातिकायश्च रुरुदुः शोकपीडिताः॥७॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-68",
    "chapterName": "युद्धकाण्ड, सर्ग 68",
    "verseNumber": 7
  },
  {
    "id": "valmiki-ramayana-6-sarga-68-shlok-8",
    "collectionId": "valmiki-ramayana",
    "index": 13811,
    "titleDevanagari": "वाल्मीकि रामायण, युद्धकाण्ड, सर्ग 68, श्लोक 8",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-6-sarga-68-shlok-8",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "भ्रातरं निहतं श्रुत्वा रामेणाक्लिष्टकर्मणा।",
          "महोदरमहापाश्वौँ शोकाक्रान्तौ बभूवतुः॥८॥",
          "ततः कृच्छ्रात् समासाद्य संज्ञां राक्षसपुङ्गवः।",
          "कुम्भकर्णवधाद् दीनो विललापाकुलेन्द्रियः॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-68",
    "chapterName": "युद्धकाण्ड, सर्ग 68",
    "verseNumber": 8
  },
  {
    "id": "valmiki-ramayana-6-sarga-68-shlok-10",
    "collectionId": "valmiki-ramayana",
    "index": 13812,
    "titleDevanagari": "वाल्मीकि रामायण, युद्धकाण्ड, सर्ग 68, श्लोक 10",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-6-sarga-68-shlok-10",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "हा वीर रिपुदर्पन कुम्भकर्ण महाबल।",
          "त्वं मां विहाय वै दैवाद् यातोऽसि यमसादनम्॥१०॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-68",
    "chapterName": "युद्धकाण्ड, सर्ग 68",
    "verseNumber": 10
  },
  {
    "id": "valmiki-ramayana-6-sarga-68-shlok-11",
    "collectionId": "valmiki-ramayana",
    "index": 13813,
    "titleDevanagari": "वाल्मीकि रामायण, युद्धकाण्ड, सर्ग 68, श्लोक 11",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-6-sarga-68-shlok-11",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "मम शल्यमनुद्धृत्य बान्धवानां महाबल।",
          "शत्रुसैन्यं प्रताप्यैकः क्व मां संत्यज्य गच्छसि॥११॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-68",
    "chapterName": "युद्धकाण्ड, सर्ग 68",
    "verseNumber": 11
  },
  {
