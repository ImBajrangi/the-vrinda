    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-6-sarga-68-shlok-13",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "कथमेवंविधो वीरो देवदानवदर्पहा।",
          "कालाग्निप्रतिमो ह्यद्य राघवेण रणे हतः॥१३॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-68",
    "chapterName": "युद्धकाण्ड, सर्ग 68",
    "verseNumber": 13
  },
