    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "इदानीं खल्वहं नास्मि यस्य मे पतितो भुजः।",
          "दक्षिणोऽयं समाश्रित्य न बिभेमि सुरासुरात्॥१२॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-68",
    "chapterName": "युद्धकाण्ड, सर्ग 68",
    "verseNumber": 12
  },
  {
