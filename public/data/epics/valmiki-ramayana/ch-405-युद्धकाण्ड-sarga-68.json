    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-6-sarga-68-shlok-14",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "यस्य ते वज्रनिष्पेषो न कुर्याद् व्यसनं सदा।",
          "स कथं रामबाणार्तः प्रसुप्तोऽसि महीतले॥१४॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-68",
    "chapterName": "युद्धकाण्ड, सर्ग 68",
    "verseNumber": 14
