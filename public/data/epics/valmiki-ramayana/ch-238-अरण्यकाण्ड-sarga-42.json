    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "दृष्टश्चाहं पुनस्तेन शरचापासिधारिणा।",
          "मद्धोद्यतशस्त्रेण निहतं जीवितं च मे॥२॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-42",
    "chapterName": "अरण्यकाण्ड, सर्ग 42",
    "verseNumber": 2
  },
  {
