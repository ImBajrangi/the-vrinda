    "slug": "valmiki-ramayana-3-sarga-42-shlok-7",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "आरुह्यतामयं शीघ्रं खगो रत्नविभूषितः।",
          "मया सह रथो युक्तः पिशाचवदनैः खरैः॥७॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-42",
    "chapterName": "अरण्यकाण्ड, सर्ग 42",
    "verseNumber": 7
  },
  {
