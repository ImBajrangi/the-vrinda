    "slug": "valmiki-ramayana-3-sarga-42-shlok-5",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "प्रहृष्टस्त्वभवत् तेन वचनेन स राक्षसः।",
          "परिष्वज्य सुसंश्लिष्टमिदं वचनमब्रवीत्॥५॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-42",
    "chapterName": "अरण्यकाण्ड, सर्ग 42",
    "verseNumber": 5
  },
  {
