    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "एतद् रामाश्रमपदं दृश्यते कदलीवृतम्॥१३॥",
          "क्रियतां तत् सखे शीघ्रं यदर्थं वयमागताः।"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-42",
    "chapterName": "अरण्यकाण्ड, सर्ग 42",
    "verseNumber": 13
