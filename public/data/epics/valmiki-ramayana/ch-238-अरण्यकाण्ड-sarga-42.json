    "slug": "valmiki-ramayana-3-sarga-42-shlok-8",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "प्रलोभयित्वा वैदेहीं यथेष्टं गन्तुमर्हसि।",
          "तां शून्ये प्रसभं सीतामानयिष्यामि मैथिलीम्॥ ८॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-42",
    "chapterName": "अरण्यकाण्ड, सर्ग 42",
    "verseNumber": 8
  },
  {
