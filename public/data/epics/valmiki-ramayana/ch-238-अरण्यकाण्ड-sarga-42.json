    "slug": "valmiki-ramayana-3-sarga-42-shlok-3",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "नहि रामं पराक्रम्य जीवन् प्रतिनिवर्तते।",
          "वर्तते प्रतिरूपोऽसौ यमदण्डहतस्य ते॥३॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-42",
    "chapterName": "अरण्यकाण्ड, सर्ग 42",
    "verseNumber": 3
  },
  {
