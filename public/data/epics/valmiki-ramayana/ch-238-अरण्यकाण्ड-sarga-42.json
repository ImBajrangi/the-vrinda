    "index": 7875,
    "titleDevanagari": "वाल्मीकि रामायण, अरण्यकाण्ड, सर्ग 42, श्लोक 9",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-42-shlok-9",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "ततस्तथेत्युवाचैनं रावणं ताटकासुतः।",
          "ततो रावणमारीचौ विमानमिव तं रथम्॥९॥",
          "आरुह्याययतुः शीघ्रं तस्मादाश्रममण्डलात्।"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-42",
    "chapterName": "अरण्यकाण्ड, सर्ग 42",
    "verseNumber": 9
  },
  {
    "id": "valmiki-ramayana-3-sarga-42-shlok-10",
    "collectionId": "valmiki-ramayana",
    "index": 7876,
    "titleDevanagari": "वाल्मीकि रामायण, अरण्यकाण्ड, सर्ग 42, श्लोक 10",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-42-shlok-10",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "तथैव तत्र पश्यन्तौ पत्तनानि वनानि च॥१०॥",
          "गिरीश्च सरितः सर्वा राष्ट्राणि नगराणि च।",
          "समेत्य दण्डकारण्यं राघवस्याश्रमं ततः॥११॥",
          "ददर्श सहमारीचो रावणो राक्षसाधिपः।",
          "अवतीर्य रथात् तस्मात् ततः काञ्चनभूषणात्॥ १२॥",
          "हस्ते गृहीत्वा मारीचं रावणो वाक्यमब्रवीत्।"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-42",
    "chapterName": "अरण्यकाण्ड, सर्ग 42",
    "verseNumber": 10
  },
