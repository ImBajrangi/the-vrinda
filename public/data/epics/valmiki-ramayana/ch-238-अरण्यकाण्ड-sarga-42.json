    "slug": "valmiki-ramayana-3-sarga-42-shlok-4",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "किं नु कर्तुं मया शक्यमेवं त्वयि दुरात्मनि।",
          "एष गच्छाम्यहं तात स्वस्ति तेऽस्तु निशाचर ॥४॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-42",
    "chapterName": "अरण्यकाण्ड, सर्ग 42",
    "verseNumber": 4
  },
  {
