    "slug": "valmiki-ramayana-3-sarga-42-shlok-6",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "एतच्छौटीर्ययुक्तं ते मच्छन्दवशवर्तिनः।",
          "इदानीमसि मारीचः पूर्वमन्यो हि राक्षसः॥६॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-42",
    "chapterName": "अरण्यकाण्ड, सर्ग 42",
    "verseNumber": 6
  },
  {
