    "slug": "valmiki-ramayana-5-sarga-46-shlok-12",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "वाली च सह सुग्रीवो जाम्बवांश्च महाबलः॥१२॥",
          "नीलः सेनापतिश्चैव ये चान्ये द्रिविदादयः।"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-46",
    "chapterName": "सुन्दरकाण्ड, सर्ग 46",
    "verseNumber": 12
  },
  {
    "id": "valmiki-ramayana-5-sarga-46-shlok-13",
    "collectionId": "valmiki-ramayana",
    "index": 10443,
    "titleDevanagari": "वाल्मीकि रामायण, सुन्दरकाण्ड, सर्ग 46, श्लोक 13",
