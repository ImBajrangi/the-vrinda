    "slug": "valmiki-ramayana-5-sarga-46-shlok-16",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "तथापि तु नयज्ञेन जयमाकाङ्क्षता रणे॥१६॥",
          "आत्मा रक्ष्यः प्रयत्नेन युद्धसिद्धिर्हि चञ्चला।"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-46",
    "chapterName": "सुन्दरकाण्ड, सर्ग 46",
    "verseNumber": 16
  },
