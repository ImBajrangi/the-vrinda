    "slug": "valmiki-ramayana-5-sarga-46-shlok-22",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "तस्य पञ्चायसास्तीक्ष्णाः सिताः पीतमुखाः",
          "शराः। शिरस्युत्पलपत्राभा दुर्धरेण निपातिताः॥२२॥"
        ]
      }
