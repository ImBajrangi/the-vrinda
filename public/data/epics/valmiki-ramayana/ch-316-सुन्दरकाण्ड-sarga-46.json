    "slug": "valmiki-ramayana-5-sarga-46-shlok-14",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "महत्सत्त्वमिदं ज्ञेयं कपिरूपं व्यवस्थितम्॥१४॥",
          "प्रयत्नं महदास्थाय क्रियतामस्य निग्रहः।"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-46",
    "chapterName": "सुन्दरकाण्ड, सर्ग 46",
    "verseNumber": 14
  },
  {
    "id": "valmiki-ramayana-5-sarga-46-shlok-15",
    "collectionId": "valmiki-ramayana",
    "index": 10445,
    "titleDevanagari": "वाल्मीकि रामायण, सुन्दरकाण्ड, सर्ग 46, श्लोक 15",
