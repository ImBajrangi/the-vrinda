[
  {
    "id": "valmiki-ramayana-5-sarga-46-shlok-1",
    "collectionId": "valmiki-ramayana",
    "index": 10433,
    "titleDevanagari": "वाल्मीकि रामायण, सुन्दरकाण्ड, सर्ग 46, श्लोक 1",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-5-sarga-46-shlok-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "हतान् मन्त्रिसुतान् बुद्ध्वा वानरेण महात्मना।",
          "रावणः संवृताकारश्चकार मतिमुत्तमाम्॥१॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-46",
    "chapterName": "सुन्दरकाण्ड, सर्ग 46",
    "verseNumber": 1
  },
  {
    "id": "valmiki-ramayana-5-sarga-46-shlok-3",
    "collectionId": "valmiki-ramayana",
    "index": 10434,
    "titleDevanagari": "वाल्मीकि रामायण, सुन्दरकाण्ड, सर्ग 46, श्लोक 3",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-5-sarga-46-shlok-3",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "स विरूपाक्षयूपाक्षौ दुर्धरं चैव राक्षसम्।",
          "प्रघसं भासकर्णं च पञ्च सेनाग्रनायकान्॥२॥",
          "संदिदेश दशग्रीवो वीरान् नयविशारदान्।",
          "हनूमद्ग्रहणेऽव्यग्रान् वायुवेगसमान् युधि॥३॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-46",
    "chapterName": "सुन्दरकाण्ड, सर्ग 46",
    "verseNumber": 3
  },
  {
    "id": "valmiki-ramayana-5-sarga-46-shlok-4",
    "collectionId": "valmiki-ramayana",
    "index": 10435,
    "titleDevanagari": "वाल्मीकि रामायण, सुन्दरकाण्ड, सर्ग 46, श्लोक 4",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-5-sarga-46-shlok-4",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "यात सेनाग्रगाः सर्वे महाबलपरिग्रहाः।",
          "सवाजिरथमातङ्गाः स कपिः शास्यतामिति॥४॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-46",
    "chapterName": "सुन्दरकाण्ड, सर्ग 46",
    "verseNumber": 4
  },
  {
    "id": "valmiki-ramayana-5-sarga-46-shlok-5",
    "collectionId": "valmiki-ramayana",
    "index": 10436,
    "titleDevanagari": "वाल्मीकि रामायण, सुन्दरकाण्ड, सर्ग 46, श्लोक 5",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-5-sarga-46-shlok-5",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "यत्तैश्च खलु भाव्यं स्यात् तमासाद्य वनालयम्।",
          "कर्म चापि समाधेयं देशकालाविरोधितम्॥५॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-46",
    "chapterName": "सुन्दरकाण्ड, सर्ग 46",
    "verseNumber": 5
  },
  {
    "id": "valmiki-ramayana-5-sarga-46-shlok-6",
    "collectionId": "valmiki-ramayana",
    "index": 10437,
    "titleDevanagari": "वाल्मीकि रामायण, सुन्दरकाण्ड, सर्ग 46, श्लोक 6",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-5-sarga-46-shlok-6",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "न ह्यहं तं कपिं मन्ये कर्मणा प्रति तर्कयन्।",
          "सर्वथा तन्महद् भूतं महाबलपरिग्रहम्॥६॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-46",
    "chapterName": "सुन्दरकाण्ड, सर्ग 46",
    "verseNumber": 6
  },
  {
    "id": "valmiki-ramayana-5-sarga-46-shlok-7",
    "collectionId": "valmiki-ramayana",
    "index": 10438,
    "titleDevanagari": "वाल्मीकि रामायण, सुन्दरकाण्ड, सर्ग 46, श्लोक 7",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-5-sarga-46-shlok-7",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "वानरोऽयमिति ज्ञात्वा नहि शुद्ध्यति मे मनः।",
          "नैवाहं तं कपिं मन्ये यथेयं प्रस्तुता कथा॥७॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-46",
    "chapterName": "सुन्दरकाण्ड, सर्ग 46",
    "verseNumber": 7
  },
  {
    "id": "valmiki-ramayana-5-sarga-46-shlok-9",
    "collectionId": "valmiki-ramayana",
    "index": 10439,
    "titleDevanagari": "वाल्मीकि रामायण, सुन्दरकाण्ड, सर्ग 46, श्लोक 9",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-5-sarga-46-shlok-9",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "भवेदिन्द्रेण वा सृष्टमस्मदर्थं तपोबलात्।",
          "सनागयक्षगन्धर्वदेवासुरमहर्षयः॥८॥",
          "युष्माभिः प्रहितैः सर्वैर्मया सह विनिर्जिताः।",
          "तैरवश्यं विधातव्यं व्यलीकं किंचिदेव नः॥९॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-46",
    "chapterName": "सुन्दरकाण्ड, सर्ग 46",
    "verseNumber": 9
  },
  {
    "id": "valmiki-ramayana-5-sarga-46-shlok-10",
    "collectionId": "valmiki-ramayana",
    "index": 10440,
    "titleDevanagari": "वाल्मीकि रामायण, सुन्दरकाण्ड, सर्ग 46, श्लोक 10",
    "author": "महर्षि वाल्मीकि",
