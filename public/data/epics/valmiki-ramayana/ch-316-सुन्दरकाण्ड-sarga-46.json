    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-5-sarga-46-shlok-19",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "ततस्तु ददृशुर्वीरा दीप्यमानं महाकपिम्॥१९॥",
          "रश्मिमन्तमिवोद्यन्तं स्वतेजोरश्मिमालिनम्।",
          "तोरणस्थं महावेगं महासत्त्वं महाबलम्॥२०॥",
          "महामतिं महोत्साहं महाकायं महाभुजम्।"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-46",
    "chapterName": "सुन्दरकाण्ड, सर्ग 46",
    "verseNumber": 19
  },
