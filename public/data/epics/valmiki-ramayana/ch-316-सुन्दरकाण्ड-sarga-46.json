    "slug": "valmiki-ramayana-5-sarga-46-shlok-11",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "नावमन्यो भवद्भिश्च कपि/रपराक्रमः॥११॥",
          "दृष्टा हि हरयः पूर्वे मया विपुलविक्रमाः।"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-46",
    "chapterName": "सुन्दरकाण्ड, सर्ग 46",
    "verseNumber": 11
  },
  {
