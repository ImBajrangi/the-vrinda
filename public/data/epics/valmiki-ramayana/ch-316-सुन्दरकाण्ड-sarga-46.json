    "slug": "valmiki-ramayana-5-sarga-46-shlok-21",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "तं समीक्ष्यैव ते सर्वे दिक्षु सर्वास्ववस्थिताः॥२१॥",
          "तैस्तैः प्रहरणैर्भीमैरभिपेतुस्ततस्ततः।"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-46",
    "chapterName": "सुन्दरकाण्ड, सर्ग 46",
