    "slug": "valmiki-ramayana-5-sarga-46-shlok-13",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "नैव तेषां गतिर्भीमा न तेजो न पराक्रमः॥१३॥",
          "न मतिर्न बलोत्साहो न रूपपरिकल्पनम्।"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-46",
    "chapterName": "सुन्दरकाण्ड, सर्ग 46",
    "verseNumber": 13
  },
  {
    "id": "valmiki-ramayana-5-sarga-46-shlok-14",
