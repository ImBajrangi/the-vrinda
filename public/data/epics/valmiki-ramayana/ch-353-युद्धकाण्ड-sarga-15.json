    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-6-sarga-15-shlok-9",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "न तात मन्त्रे तव निश्चयोऽस्ति बालस्त्वमद्याप्यविपक्वबुद्धिः।",
          "तस्मात् त्वयाप्यात्मविनाशनाय वचोऽर्थहीनं बहु विप्रलप्तम्॥९॥",
          "९॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-15",
    "chapterName": "युद्धकाण्ड, सर्ग 15",
    "verseNumber": 9
  },
  {
