    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-6-sarga-15-shlok-10",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "पुत्रप्रवादेन तु रावणस्य त्वमिन्द्रजिन्मित्रमुखोऽसि शत्रुः।",
          "यस्येदृशं राघवतो विनाशं निशम्य मोहादनुमन्यसे त्वम्॥१०॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-15",
    "chapterName": "युद्धकाण्ड, सर्ग 15",
    "verseNumber": 10
  },
  {
    "id": "valmiki-ramayana-6-sarga-15-shlok-11",
