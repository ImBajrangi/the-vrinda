[
  {
    "id": "valmiki-ramayana-6-sarga-15-shlok-1",
    "collectionId": "valmiki-ramayana",
    "index": 11668,
    "titleDevanagari": "वाल्मीकि रामायण, युद्धकाण्ड, सर्ग 15, श्लोक 1",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-6-sarga-15-shlok-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "बृहस्पतेस्तुल्यमतेर्वचस्तन्निशम्य यत्नेन विभीषणस्य।",
          "ततो महात्मा वचनं बभाषे तत्रेन्द्रजिन्नैर्ऋतयूथमुख्यः॥१॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-15",
    "chapterName": "युद्धकाण्ड, सर्ग 15",
    "verseNumber": 1
  },
  {
    "id": "valmiki-ramayana-6-sarga-15-shlok-2",
    "collectionId": "valmiki-ramayana",
    "index": 11669,
    "titleDevanagari": "वाल्मीकि रामायण, युद्धकाण्ड, सर्ग 15, श्लोक 2",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-6-sarga-15-shlok-2",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "किं नाम ते तात कनिष्ठ वाक्य मनर्थकं वै बहभीतवच्च।",
          "अस्मिन् कुले योऽपि भवेन्न जातः सोऽपीदृशं नैव वदेन्न कुर्यात्॥२॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-15",
    "chapterName": "युद्धकाण्ड, सर्ग 15",
    "verseNumber": 2
  },
  {
    "id": "valmiki-ramayana-6-sarga-15-shlok-3",
    "collectionId": "valmiki-ramayana",
    "index": 11670,
    "titleDevanagari": "वाल्मीकि रामायण, युद्धकाण्ड, सर्ग 15, श्लोक 3",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-6-sarga-15-shlok-3",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "सत्त्वेन वीर्येण पराक्रमेण धैर्येण शौर्येण च तेजसा च।",
          "एकः कुलेऽस्मिन् पुरुषो विमुक्तो विभीषणस्तात कनिष्ठ एषः॥३॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-15",
    "chapterName": "युद्धकाण्ड, सर्ग 15",
    "verseNumber": 3
  },
  {
    "id": "valmiki-ramayana-6-sarga-15-shlok-4",
    "collectionId": "valmiki-ramayana",
    "index": 11671,
    "titleDevanagari": "वाल्मीकि रामायण, युद्धकाण्ड, सर्ग 15, श्लोक 4",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-6-sarga-15-shlok-4",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "किं नाम तौ मानुषराजपुत्रावस्माकमेकेन हि राक्षसेन।",
          "सुप्राकृतेनापि निहन्तुमेतौ शक्यौ कुतो भीषयसे स्म भीरो॥४॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-15",
    "chapterName": "युद्धकाण्ड, सर्ग 15",
    "verseNumber": 4
  },
  {
    "id": "valmiki-ramayana-6-sarga-15-shlok-5",
    "collectionId": "valmiki-ramayana",
    "index": 11672,
    "titleDevanagari": "वाल्मीकि रामायण, युद्धकाण्ड, सर्ग 15, श्लोक 5",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-6-sarga-15-shlok-5",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "त्रिलोकनाथो ननु देवराजः शक्रो मया भूमितले निविष्टः।",
          "भयार्पिताश्चापि दिशः प्रपन्नाः सर्वे तदा देवगणाः समग्राः॥५॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-15",
    "chapterName": "युद्धकाण्ड, सर्ग 15",
    "verseNumber": 5
  },
  {
    "id": "valmiki-ramayana-6-sarga-15-shlok-6",
    "collectionId": "valmiki-ramayana",
    "index": 11673,
    "titleDevanagari": "वाल्मीकि रामायण, युद्धकाण्ड, सर्ग 15, श्लोक 6",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-6-sarga-15-shlok-6",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "ऐरावतो निःस्वनमुन्नदन् स निपातितो भूमितले मया तु।",
          "विकृष्य दन्तौ तु मया प्रसह्य वित्रासिता देवगणाः समग्राः॥६॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-15",
    "chapterName": "युद्धकाण्ड, सर्ग 15",
    "verseNumber": 6
  },
  {
    "id": "valmiki-ramayana-6-sarga-15-shlok-7",
    "collectionId": "valmiki-ramayana",
    "index": 11674,
    "titleDevanagari": "वाल्मीकि रामायण, युद्धकाण्ड, सर्ग 15, श्लोक 7",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-6-sarga-15-shlok-7",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "सोऽहं सुराणामपि दर्पहन्ता दैत्योत्तमानामपि शोककर्ता।",
          "कथं नरेन्द्रात्मजयोर्न शक्तो मनुष्ययोः प्राकृतयोः सुवीर्यः॥७॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-15",
    "chapterName": "युद्धकाण्ड, सर्ग 15",
    "verseNumber": 7
  },
  {
    "id": "valmiki-ramayana-6-sarga-15-shlok-8",
