    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-6-sarga-15-shlok-12",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "मूढोऽप्रगल्भोऽविनयोपपन्नस्तीक्ष्णस्वभावोऽल्पमतिर्दुरात्मा।",
          "मूर्खस्त्वमत्यन्तसुदुर्मतिश्च त्वमिन्द्रजिद् बालतया ब्रवीषि॥१२॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-15",
    "chapterName": "युद्धकाण्ड, सर्ग 15",
    "verseNumber": 12
