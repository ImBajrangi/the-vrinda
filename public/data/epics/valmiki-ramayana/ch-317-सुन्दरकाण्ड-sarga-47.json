    "slug": "valmiki-ramayana-5-sarga-47-shlok-8",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "स तं समासाद्य हरिं हरीक्षणो युगान्तकालाग्निमिव प्रजाक्षये।",
          "अवस्थितं विस्मितजातसम्भ्रमं समैक्षताक्षो बहुमानचक्षुषा॥८॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-47",
    "chapterName": "सुन्दरकाण्ड, सर्ग 47",
    "verseNumber": 8
  },
