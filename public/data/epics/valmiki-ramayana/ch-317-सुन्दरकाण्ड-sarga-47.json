    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "तस्य वेगं च कपेर्महात्मनः पराक्रमं चारिषु रावणात्मजः।",
          "विचारयन् स्वं च बलं महाबलो युगक्षये सूर्य इवाभिवर्धत॥९॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-47",
    "chapterName": "सुन्दरकाण्ड, सर्ग 47",
    "verseNumber": 9
  },
