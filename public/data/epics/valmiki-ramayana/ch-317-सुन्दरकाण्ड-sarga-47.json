    "slug": "valmiki-ramayana-5-sarga-47-shlok-7",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "स पूरयन् खं च महीं च साचलां तुरङ्गमातङ्गमहारथस्वनैः।",
          "बलैः समेतैः सहतोरणस्थितं समर्थमासीनमुपागमत् कपिम्॥७॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-47",
    "chapterName": "सुन्दरकाण्ड, सर्ग 47",
    "verseNumber": 7
  },
