    "titleDevanagari": "वाल्मीकि रामायण, सुन्दरकाण्ड, सर्ग 47, श्लोक 1",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-5-sarga-47-shlok-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "सेनापतीन् पञ्च स तु प्रमापितान् हनूमता सानुचरान् सवाहनान्।",
          "निशम्य राजा समरोद्धतोन्मुखं कुमारमक्षं प्रसमैक्षताक्षम्॥१॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-47",
    "chapterName": "सुन्दरकाण्ड, सर्ग 47",
    "verseNumber": 1
  },
  {
    "id": "valmiki-ramayana-5-sarga-47-shlok-2",
    "collectionId": "valmiki-ramayana",
    "index": 10471,
    "titleDevanagari": "वाल्मीकि रामायण, सुन्दरकाण्ड, सर्ग 47, श्लोक 2",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-5-sarga-47-shlok-2",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "स तस्य दृष्टयर्पणसम्प्रचोदितः प्रतापवान् काञ्चनचित्रकार्मुकः।",
          "समुत्पपाताथ सदस्युदीरितो द्विजातिमुख्यैर्ह विषेव पावकः॥२॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-47",
    "chapterName": "सुन्दरकाण्ड, सर्ग 47",
    "verseNumber": 2
  },
  {
    "id": "valmiki-ramayana-5-sarga-47-shlok-3",
    "collectionId": "valmiki-ramayana",
    "index": 10472,
    "titleDevanagari": "वाल्मीकि रामायण, सुन्दरकाण्ड, सर्ग 47, श्लोक 3",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-5-sarga-47-shlok-3",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "ततो महान् बालदिवाकरप्रभं प्रतप्तजाम्बूनदजालसंततम्।",
          "रथं समास्थाय ययौ स वीर्यवान् महाहरिं तं प्रति नैर्ऋतर्षभः॥३॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-47",
    "chapterName": "सुन्दरकाण्ड, सर्ग 47",
    "verseNumber": 3
  },
  {
    "id": "valmiki-ramayana-5-sarga-47-shlok-6",
    "collectionId": "valmiki-ramayana",
    "index": 10473,
    "titleDevanagari": "वाल्मीकि रामायण, सुन्दरकाण्ड, सर्ग 47, श्लोक 6",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-5-sarga-47-shlok-6",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "ततस्तपःसंग्रहसंचयार्जितं प्रतप्तजाम्बूनदजालचित्रितम्।",
          "पताकिनं रत्नविभूषितध्वजं मनोजवाष्टाश्ववरैः सुयोजितम्॥४॥",
          "सुरासुराधृष्यमसङ्गचारिणं तडित्प्रभं व्योमचरं समाहितम्।",
          "सतूणमष्टासिनिबद्धबन्धुरं यथाक्रमावेशितशक्तितोमरम्॥५॥",
          "विराजमानं प्रतिपूर्णवस्तुना सहेमदाम्ना शशिसूर्यवर्चसा।",
          "दिवाकराभं रथमास्थितस्ततः स निर्जगामामरतुल्यविक्रमः॥६॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-47",
    "chapterName": "सुन्दरकाण्ड, सर्ग 47",
    "verseNumber": 6
  },
  {
