    "slug": "valmiki-ramayana-2-sarga-79-shlok-4",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "आभिषेचनिकं सर्वमिदमादाय राघव।",
          "प्रतीक्षते त्वां स्वजनः श्रेणयश्च नृपात्मज॥४॥"
        ]
      }
