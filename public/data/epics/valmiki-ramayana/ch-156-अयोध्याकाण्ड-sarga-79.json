    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-2-sarga-79-shlok-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "ततः प्रभातसमये दिवसेऽथ चतुर्दशे।",
          "समेत्य राजकर्तारो भरतं वाक्यमब्रुवन्॥१॥"
        ]
      }
    ],
    "chapterId": "अयोध्याकाण्ड-sarga-79",
    "chapterName": "अयोध्याकाण्ड, सर्ग 79",
    "verseNumber": 1
  },
  {
    "id": "valmiki-ramayana-2-sarga-79-shlok-3",
    "collectionId": "valmiki-ramayana",
    "index": 5657,
    "titleDevanagari": "वाल्मीकि रामायण, अयोध्याकाण्ड, सर्ग 79, श्लोक 3",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-2-sarga-79-shlok-3",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "गतो दशरथः स्वर्ग यो नो गुरुतरो गुरुः।",
          "रामं प्रव्राज्य वै ज्येष्ठं लक्ष्मणं च महाबलम्॥२॥",
          "त्वमद्य भव नो राजा राजपुत्रो महायशः।",
          "संगत्या नापराध्नोति राज्यमेतदनायकम्॥३॥"
        ]
      }
    ],
    "chapterId": "अयोध्याकाण्ड-sarga-79",
    "chapterName": "अयोध्याकाण्ड, सर्ग 79",
    "verseNumber": 3
  },
  {
