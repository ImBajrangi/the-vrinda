    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "राज्यं गृहाण भरत पितृपैतामहं ध्रुवम्।",
          "अभिषेचय चात्मानं पाहि चास्मान् नरर्षभ॥५॥"
        ]
      }
    ],
    "chapterId": "अयोध्याकाण्ड-sarga-79",
    "chapterName": "अयोध्याकाण्ड, सर्ग 79",
    "verseNumber": 5
  },
