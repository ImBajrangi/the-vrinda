    "slug": "valmiki-ramayana-5-sarga-35-shlok-7",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "यानि रामस्य चिह्नानि लक्ष्मणस्य च यानि वै।",
          "लक्षितानि विशालाक्षि वदतः शृणु तानि मे॥७॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-35",
    "chapterName": "सुन्दरकाण्ड, सर्ग 35",
    "verseNumber": 7
  },
  {
