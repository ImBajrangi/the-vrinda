    "index": 10009,
    "titleDevanagari": "वाल्मीकि रामायण, सुन्दरकाण्ड, सर्ग 35, श्लोक 5",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-5-sarga-35-shlok-5",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "एवमुक्तस्तु वैदेह्या हनूमान् मारुतात्मजः।",
          "ततो रामं यथातत्त्वमाख्यातुमुपचक्रमे॥५॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-35",
    "chapterName": "सुन्दरकाण्ड, सर्ग 35",
    "verseNumber": 5
  },
  {
    "id": "valmiki-ramayana-5-sarga-35-shlok-6",
