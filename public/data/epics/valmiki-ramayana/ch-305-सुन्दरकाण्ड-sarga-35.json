    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "अर्चिष्मानर्चितोऽत्यर्थं ब्रह्मचर्यव्रते स्थितः।",
          "साधूनामुपकारज्ञः प्रचारज्ञश्च कर्मणाम्॥१२॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-35",
    "chapterName": "सुन्दरकाण्ड, सर्ग 35",
    "verseNumber": 12
  },
