    "index": 10013,
    "titleDevanagari": "वाल्मीकि रामायण, सुन्दरकाण्ड, सर्ग 35, श्लोक 10",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-5-sarga-35-shlok-10",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "तेजसाऽऽदित्यसंकाशः क्षमया पृथिवीसमः।",
          "बृहस्पतिसमो बुद्ध्या यशसा वासवोपमः॥९॥",
          "रक्षिता जीवलोकस्य स्वजनस्य च रक्षिता।",
          "रक्षिता स्वस्य वृत्तस्य धर्मस्य च परंतपः॥१०॥",
          "रामो भामिनि लोकस्य चातुर्वर्ण्यस्य रक्षिता।",
          "मर्यादानां च लोकस्य कर्ता कारयिता च सः॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-35",
    "chapterName": "सुन्दरकाण्ड, सर्ग 35",
    "verseNumber": 10
  },
