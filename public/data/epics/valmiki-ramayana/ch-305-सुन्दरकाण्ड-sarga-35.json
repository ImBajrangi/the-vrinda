    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-5-sarga-35-shlok-4",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "कीदृशं तस्य संस्थानं रूपं तस्य च कीदृशम्।",
          "कथारू कथं बाहू लक्ष्मणस्य च शंस मे॥४॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-35",
    "chapterName": "सुन्दरकाण्ड, सर्ग 35",
    "verseNumber": 4
  },
  {
    "id": "valmiki-ramayana-5-sarga-35-shlok-5",
