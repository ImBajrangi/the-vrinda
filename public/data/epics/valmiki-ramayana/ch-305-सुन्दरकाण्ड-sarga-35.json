    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "राजनीत्यां विनीतश्च ब्राह्मणानामुपासकः।",
          "ज्ञानवान शीलसम्पन्नो विनीतश्च परंतपः॥१३॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-35",
    "chapterName": "सुन्दरकाण्ड, सर्ग 35",
    "verseNumber": 13
