    "titleDevanagari": "वाल्मीकि रामायण, सुन्दरकाण्ड, सर्ग 35, श्लोक 1",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-5-sarga-35-shlok-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "तां तु रामकथां श्रुत्वा वैदेही वानरर्षभात्।",
          "उवाच वचनं सान्त्वमिदं मधुरया गिरा॥१॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-35",
    "chapterName": "सुन्दरकाण्ड, सर्ग 35",
    "verseNumber": 1
  },
  {
    "id": "valmiki-ramayana-5-sarga-35-shlok-2",
    "collectionId": "valmiki-ramayana",
    "index": 10006,
    "titleDevanagari": "वाल्मीकि रामायण, सुन्दरकाण्ड, सर्ग 35, श्लोक 2",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-5-sarga-35-shlok-2",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "क्व ते रामेण संसर्गः कथं जानासि लक्ष्मणम्।",
          "वानराणां नराणां च कथमासीत् समागमः ॥२॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-35",
    "chapterName": "सुन्दरकाण्ड, सर्ग 35",
    "verseNumber": 2
  },
  {
    "id": "valmiki-ramayana-5-sarga-35-shlok-3",
    "collectionId": "valmiki-ramayana",
    "index": 10007,
    "titleDevanagari": "वाल्मीकि रामायण, सुन्दरकाण्ड, सर्ग 35, श्लोक 3",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-5-sarga-35-shlok-3",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "यानि रामस्य चिह्नानि लक्ष्मणस्य च वानर।",
          "तानि भूयः समाचक्ष्व न मां शोकः समाविशेत्॥३",
          "॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-35",
    "chapterName": "सुन्दरकाण्ड, सर्ग 35",
    "verseNumber": 3
  },
  {
    "id": "valmiki-ramayana-5-sarga-35-shlok-4",
