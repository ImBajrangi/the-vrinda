    "slug": "valmiki-ramayana-5-sarga-35-shlok-8",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "रामः कमलपत्राक्षः पूर्णचन्द्रनिभाननः।",
          "रूपदाक्षिण्यसम्पन्नः प्रसूतो जनकात्मजे॥८॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-35",
    "chapterName": "सुन्दरकाण्ड, सर्ग 35",
    "verseNumber": 8
  },
  {
    "id": "valmiki-ramayana-5-sarga-35-shlok-10",
