    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-5-sarga-60-shlok-20",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "न तावदेषा मतिरक्षमा नो यथा भवान् पश्यति राजपुत्र।",
          "यथा तु रामस्य मतिर्निविष्टा तथा भवान् पश्यतु कार्यसिद्धिम्॥२०॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-60",
