    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-5-sarga-60-shlok-19",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "तस्माद् गच्छाम वै सर्वे यत्र रामः सलक्ष्मणः।",
          "सुग्रीवश्च महातेजाः कार्यस्यास्य निवेदने॥१९॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-60",
    "chapterName": "सुन्दरकाण्ड, सर्ग 60",
    "verseNumber": 19
  },
  {
