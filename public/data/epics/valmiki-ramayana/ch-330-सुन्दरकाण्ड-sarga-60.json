[
  {
    "id": "valmiki-ramayana-5-sarga-60-shlok-1",
    "collectionId": "valmiki-ramayana",
    "index": 11029,
    "titleDevanagari": "वाल्मीकि रामायण, सुन्दरकाण्ड, सर्ग 60, श्लोक 1",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-5-sarga-60-shlok-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "तस्य तद् वचनं श्रुत्वा वालिसूनुरभाषत।",
          "अश्विपुत्रौ महावेगौ बलवन्तौ प्लवंगमौ॥१॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-60",
    "chapterName": "सुन्दरकाण्ड, सर्ग 60",
    "verseNumber": 1
  },
  {
    "id": "valmiki-ramayana-5-sarga-60-shlok-2",
    "collectionId": "valmiki-ramayana",
    "index": 11030,
    "titleDevanagari": "वाल्मीकि रामायण, सुन्दरकाण्ड, सर्ग 60, श्लोक 2",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-5-sarga-60-shlok-2",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "पितामहवरोत्सेकात् परमं दर्पमास्थितौ।",
          "अश्विनोर्माननार्थं हि सर्वलोकपितामहः॥२॥",
          "सर्वावध्यत्वमतुलमनयोर्दत्तवान् पुरा।",
          "वरोत्सेकेन मत्तौ च प्रमथ्य महतीं चमूम्॥३॥",
          "सुराणाममृतं वीरौ पीतवन्तौ महाबलौ।"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-60",
    "chapterName": "सुन्दरकाण्ड, सर्ग 60",
    "verseNumber": 2
  },
  {
    "id": "valmiki-ramayana-5-sarga-60-shlok-4",
    "collectionId": "valmiki-ramayana",
    "index": 11031,
    "titleDevanagari": "वाल्मीकि रामायण, सुन्दरकाण्ड, सर्ग 60, श्लोक 4",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-5-sarga-60-shlok-4",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "एतावेव हि संक्रुद्धौ सवाजिरथकुञ्जराम्॥४॥",
          "लङ्कां नाशयितुं शक्तौ सर्वे तिष्ठन्तु वानराः।"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-60",
    "chapterName": "सुन्दरकाण्ड, सर्ग 60",
    "verseNumber": 4
  },
  {
    "id": "valmiki-ramayana-5-sarga-60-shlok-5",
    "collectionId": "valmiki-ramayana",
    "index": 11032,
    "titleDevanagari": "वाल्मीकि रामायण, सुन्दरकाण्ड, सर्ग 60, श्लोक 5",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-5-sarga-60-shlok-5",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "अहमेकोऽपि पर्याप्तः सराक्षसगणां पुरीम्॥५॥",
          "तां लङ्कां तरसा हन्तुं रावणं च महाबलम्।",
          "किं पुनः सहितो वीरैर्बलवद्भिः कृतात्मभिः॥६॥",
          "कृतास्त्रैः प्लवगैः शक्तैर्भवद्भिर्विजयैषिभिः।"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-60",
    "chapterName": "सुन्दरकाण्ड, सर्ग 60",
    "verseNumber": 5
  },
  {
    "id": "valmiki-ramayana-5-sarga-60-shlok-9",
    "collectionId": "valmiki-ramayana",
    "index": 11033,
    "titleDevanagari": "वाल्मीकि रामायण, सुन्दरकाण्ड, सर्ग 60, श्लोक 9",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-5-sarga-60-shlok-9",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "नहि वः प्लवने कश्चिन्नापि कश्चित् पराक्रमे।",
          "तुल्यः सामरदैत्येषु लोकेषु हरिसत्तमाः॥९॥",
          "जित्वा लङ्कां सरक्षौघां हत्वा तं रावणं रणे।",
          "सीतामादाय गच्छामः सिद्धार्था हृष्टमानसाः॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-60",
    "chapterName": "सुन्दरकाण्ड, सर्ग 60",
    "verseNumber": 9
  },
  {
    "id": "valmiki-ramayana-5-sarga-60-shlok-11",
    "collectionId": "valmiki-ramayana",
    "index": 11034,
    "titleDevanagari": "वाल्मीकि रामायण, सुन्दरकाण्ड, सर्ग 60, श्लोक 11",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-5-sarga-60-shlok-11",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "तेष्वेवं हतवीरेषु राक्षसेषु हनूमता।",
          "किमन्यदत्र कर्तव्यं गृहीत्वा याम जानकीम्॥११॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-60",
    "chapterName": "सुन्दरकाण्ड, सर्ग 60",
    "verseNumber": 11
  },
  {
    "id": "valmiki-ramayana-5-sarga-60-shlok-13",
    "collectionId": "valmiki-ramayana",
    "index": 11035,
    "titleDevanagari": "वाल्मीकि रामायण, सुन्दरकाण्ड, सर्ग 60, श्लोक 13",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-5-sarga-60-shlok-13",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "रामलक्ष्मणयोर्मध्ये न्यस्याम जनकात्मजाम्।",
          "किं व्यलीकैस्तु तान् सर्वान् वानरान्वानरर्षभान्॥१२॥",
          "वयमेव हि गत्वा तान् हत्वा राक्षसपुङ्गवान्।",
          "राघवं द्रष्टुमर्हामः सुग्रीवं सहलक्ष्मणम्॥१३॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-60",
    "chapterName": "सुन्दरकाण्ड, सर्ग 60",
    "verseNumber": 13
  },
  {
    "id": "valmiki-ramayana-5-sarga-60-shlok-14",
    "collectionId": "valmiki-ramayana",
    "index": 11036,
    "titleDevanagari": "वाल्मीकि रामायण, सुन्दरकाण्ड, सर्ग 60, श्लोक 14",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-5-sarga-60-shlok-14",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "तमेवं कृतसंकल्पं जाम्बवान् हरिसत्तमः।",
          "उवाच परमप्रीतो वाक्यमर्थवदर्थवित्॥१४॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-60",
    "chapterName": "सुन्दरकाण्ड, सर्ग 60",
    "verseNumber": 14
  },
  {
    "id": "valmiki-ramayana-5-sarga-60-shlok-15",
    "collectionId": "valmiki-ramayana",
    "index": 11037,
    "titleDevanagari": "वाल्मीकि रामायण, सुन्दरकाण्ड, सर्ग 60, श्लोक 15",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-5-sarga-60-shlok-15",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "नैषा बुद्धिर्महाबुद्धे यद् ब्रवीषि महाकपे।",
          "विचेतुं वयमाज्ञप्ता दक्षिणां दिशमुत्तमाम्॥१५॥",
          "नानेतुं कपिराजेन नैव रामेण धीमता।"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-60",
    "chapterName": "सुन्दरकाण्ड, सर्ग 60",
    "verseNumber": 15
  },
  {
    "id": "valmiki-ramayana-5-sarga-60-shlok-16",
    "collectionId": "valmiki-ramayana",
    "index": 11038,
    "titleDevanagari": "वाल्मीकि रामायण, सुन्दरकाण्ड, सर्ग 60, श्लोक 16",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-5-sarga-60-shlok-16",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "कथंचिन्निर्जितां सीतामस्माभिर्नाभिरोचयेत्॥१६॥",
          "राघवो नृपशार्दूलः कुलं व्यपदिशन् स्वकम्।"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-60",
    "chapterName": "सुन्दरकाण्ड, सर्ग 60",
    "verseNumber": 16
  },
  {
    "id": "valmiki-ramayana-5-sarga-60-shlok-17",
    "collectionId": "valmiki-ramayana",
    "index": 11039,
    "titleDevanagari": "वाल्मीकि रामायण, सुन्दरकाण्ड, सर्ग 60, श्लोक 17",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-5-sarga-60-shlok-17",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "प्रतिज्ञाय स्वयं राजा सीताविजयमग्रतः॥१७॥",
          "सर्वेषां कपिमुख्यानां कथं मिथ्या करिष्यति।"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-60",
    "chapterName": "सुन्दरकाण्ड, सर्ग 60",
    "verseNumber": 17
  },
  {
    "id": "valmiki-ramayana-5-sarga-60-shlok-18",
