    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "सूतश्चित्ररथश्चार्यः सचिवः सुचिरोषितः।",
          "तोषयैनं महाहश्च रत्नैर्वस्त्रैर्धनैस्तथा॥१७॥",
          "पशकाभिश्च सर्वाभिर्गवां दशशतेन च।"
        ]
      }
    ],
    "chapterId": "अयोध्याकाण्ड-sarga-32",
