    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-2-sarga-32-shlok-16",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "कौसल्यां च य आशीर्भिर्भक्तः पर्युपतिष्ठति।",
          "आचार्यस्तैत्तिरीयाणामभिरूपश्च वेदवित्॥ १५॥",
          "तस्य यानं च दासीश्च सौमित्रे सम्प्रदापय।",
          "कौशेयानि च वस्त्राणि यावत् तुष्यति स द्विजः॥ १६॥"
        ]
      }
    ],
    "chapterId": "अयोध्याकाण्ड-sarga-32",
    "chapterName": "अयोध्याकाण्ड, सर्ग 32",
    "verseNumber": 16
