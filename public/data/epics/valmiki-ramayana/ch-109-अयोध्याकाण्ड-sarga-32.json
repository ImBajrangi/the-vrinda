    "slug": "valmiki-ramayana-2-sarga-32-shlok-14",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "अगस्त्यं कौशिकं चैव तावुभौ ब्राह्मणोत्तमौ।",
          "अर्चयाहूय सौमित्रे रत्नैः सस्यमिवाम्बुभिः॥",
          "तर्पयस्व महाबाहो गोसहस्रेण राघव।",
          "सुवर्णरजतैश्चैव मणिभिश्च महाधनैः॥१४॥"
        ]
      }
    ],
    "chapterId": "अयोध्याकाण्ड-sarga-32",
    "chapterName": "अयोध्याकाण्ड, सर्ग 32",
    "verseNumber": 14
  },
  {
