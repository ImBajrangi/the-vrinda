    "slug": "valmiki-ramayana-2-sarga-32-shlok-8",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "अङ्गदानि च चित्राणि केयूराणि शुभानि च।",
          "प्रयच्छति सखी तुभ्यं भार्यायै गच्छती वनम्॥ ८॥"
        ]
      }
    ],
    "chapterId": "अयोध्याकाण्ड-sarga-32",
    "chapterName": "अयोध्याकाण्ड, सर्ग 32",
    "verseNumber": 8
  },
