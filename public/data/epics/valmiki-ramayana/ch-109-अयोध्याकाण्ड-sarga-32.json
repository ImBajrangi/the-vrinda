    "slug": "valmiki-ramayana-2-sarga-32-shlok-7",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "सुयज्ञं स तदोवाच रामः सीताप्रचोदितः॥६॥",
          "हारं च हेमसूत्रं च भार्यायै सौम्य हारय।",
          "रशनां चाथ सा सीता दातुमिच्छति ते सखी॥ ७॥"
        ]
      }
    ],
    "chapterId": "अयोध्याकाण्ड-sarga-32",
    "chapterName": "अयोध्याकाण्ड, सर्ग 32",
    "verseNumber": 7
  },
  {
