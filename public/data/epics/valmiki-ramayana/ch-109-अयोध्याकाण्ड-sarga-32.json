    "slug": "valmiki-ramayana-2-sarga-32-shlok-5",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "जातरूपमयैर्मुख्यैरङ्गदैः कुण्डलैः शुभैः ।",
          "सहेमसूत्रैर्मणिभिः केयरैर्वलयैरपि॥५॥",
          "अन्यैश्च रत्नैर्बहुभिः काकुत्स्थः प्रत्यपूजयत्।"
        ]
      }
    ],
    "chapterId": "अयोध्याकाण्ड-sarga-32",
    "chapterName": "अयोध्याकाण्ड, सर्ग 32",
    "verseNumber": 5
  },
  {
