    "slug": "valmiki-ramayana-2-sarga-32-shlok-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "ततः शासनमाज्ञाय भ्रातुः प्रियकरं हितम्।",
          "गत्वा स प्रविवेशाशु सुयज्ञस्य निवेशनम्॥१॥"
        ]
      }
    ],
    "chapterId": "अयोध्याकाण्ड-sarga-32",
    "chapterName": "अयोध्याकाण्ड, सर्ग 32",
    "verseNumber": 1
  },
  {
    "id": "valmiki-ramayana-2-sarga-32-shlok-2",
    "collectionId": "valmiki-ramayana",
    "index": 4120,
    "titleDevanagari": "वाल्मीकि रामायण, अयोध्याकाण्ड, सर्ग 32, श्लोक 2",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-2-sarga-32-shlok-2",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "तं विप्रमग्न्यगारस्थं वन्दित्वा लक्ष्मणोऽब्रवीत्।",
          "सखेऽभ्यागच्छ पश्य त्वं वेश्म दुष्करकारिणः॥ २॥",
          "ततः संध्यामुपास्थाय गत्वा सौमित्रिणा सह।",
          "ऋष्टुं स प्राविशल्लक्ष्या रम्यं रामनिवेशनम्॥"
        ]
      }
    ],
    "chapterId": "अयोध्याकाण्ड-sarga-32",
    "chapterName": "अयोध्याकाण्ड, सर्ग 32",
    "verseNumber": 2
  },
  {
    "id": "valmiki-ramayana-2-sarga-32-shlok-4",
    "collectionId": "valmiki-ramayana",
    "index": 4121,
    "titleDevanagari": "वाल्मीकि रामायण, अयोध्याकाण्ड, सर्ग 32, श्लोक 4",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-2-sarga-32-shlok-4",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "तमागतं वेदविदं प्राञ्जलिः सीतया सह।",
          "सुयज्ञमभिचक्राम राघवोऽग्निमिवार्चितम्॥४॥"
        ]
      }
    ],
    "chapterId": "अयोध्याकाण्ड-sarga-32",
    "chapterName": "अयोध्याकाण्ड, सर्ग 32",
    "verseNumber": 4
  },
  {
