    "slug": "valmiki-ramayana-6-sarga-58-shlok-10",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "तेषामन्योन्यमासाद्य संग्रामः सुमहानभूत्।",
          "बहूनामश्मवृष्टिं च शरवर्षं च वर्षताम्॥१०॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-58",
    "chapterName": "युद्धकाण्ड, सर्ग 58",
    "verseNumber": 10
  },
  {
