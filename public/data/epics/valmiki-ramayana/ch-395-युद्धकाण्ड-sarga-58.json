[
  {
    "id": "valmiki-ramayana-6-sarga-58-shlok-1",
    "collectionId": "valmiki-ramayana",
    "index": 13130,
    "titleDevanagari": "वाल्मीकि रामायण, युद्धकाण्ड, सर्ग 58, श्लोक 1",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-6-sarga-58-shlok-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "ततः प्रहस्तं निर्यान्तं दृष्ट्वा रणकृतोद्यमम्।",
          "उवाच सस्मितं रामो विभीषणमरिंदमः॥१॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-58",
    "chapterName": "युद्धकाण्ड, सर्ग 58",
    "verseNumber": 1
  },
  {
    "id": "valmiki-ramayana-6-sarga-58-shlok-2",
    "collectionId": "valmiki-ramayana",
    "index": 13131,
    "titleDevanagari": "वाल्मीकि रामायण, युद्धकाण्ड, सर्ग 58, श्लोक 2",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-6-sarga-58-shlok-2",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "क एष सुमहाकायो बलेन महता वृतः।",
          "आगच्छति महावेगः किंरूपबलपौरुषः॥२॥",
          "आचक्ष्व मे महाबाहो वीर्यवन्तं निशाचरम्।"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-58",
    "chapterName": "युद्धकाण्ड, सर्ग 58",
    "verseNumber": 2
  },
  {
    "id": "valmiki-ramayana-6-sarga-58-shlok-4",
    "collectionId": "valmiki-ramayana",
    "index": 13132,
    "titleDevanagari": "वाल्मीकि रामायण, युद्धकाण्ड, सर्ग 58, श्लोक 4",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-6-sarga-58-shlok-4",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "राघवस्य वचः श्रुत्वा प्रत्युवाच विभीषणः॥३॥",
          "एष सेनापतिस्तस्य प्रहस्तो नाम राक्षसः।",
          "लङ्कायां राक्षसेन्द्रस्य त्रिभागबलसंवृतः।",
          "वीर्यवानस्त्रविच्छूरः सुप्रख्यातपराक्रमः॥४॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-58",
    "chapterName": "युद्धकाण्ड, सर्ग 58",
    "verseNumber": 4
  },
  {
    "id": "valmiki-ramayana-6-sarga-58-shlok-6",
    "collectionId": "valmiki-ramayana",
    "index": 13133,
    "titleDevanagari": "वाल्मीकि रामायण, युद्धकाण्ड, सर्ग 58, श्लोक 6",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-6-sarga-58-shlok-6",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "ततः प्रहस्तं निर्यान्तं भीमं भीमपराक्रमम्।",
          "गर्जन्तं सुमहाकायं राक्षसैरभिसंवृतम्॥५॥",
          "ददर्श महती सेना वानराणां बलीयसाम्।",
          "अभिसंजातघोषाणां प्रहस्तमभिगर्जताम्॥६॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-58",
    "chapterName": "युद्धकाण्ड, सर्ग 58",
    "verseNumber": 6
  },
  {
    "id": "valmiki-ramayana-6-sarga-58-shlok-8",
    "collectionId": "valmiki-ramayana",
    "index": 13134,
    "titleDevanagari": "वाल्मीकि रामायण, युद्धकाण्ड, सर्ग 58, श्लोक 8",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-6-sarga-58-shlok-8",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "खड्गशक्त्यृष्टिशूलाश्च बाणानि मुसलानि च।",
          "गदाश्च परिघाः प्रासा विविधाश्च परश्वधाः॥७॥",
          "धनूंषि च विचित्राणि राक्षसानां जयैषिणाम्।",
          "प्रगृहीतान्यराजन्त वानरानभिधावताम्॥८॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-58",
    "chapterName": "युद्धकाण्ड, सर्ग 58",
    "verseNumber": 8
  },
  {
    "id": "valmiki-ramayana-6-sarga-58-shlok-9",
    "collectionId": "valmiki-ramayana",
    "index": 13135,
    "titleDevanagari": "वाल्मीकि रामायण, युद्धकाण्ड, सर्ग 58, श्लोक 9",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-6-sarga-58-shlok-9",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "जगृहुः पादपांश्चापि पुष्पितांस्तु गिरीस्तथा।",
          "शिलाश्च विपुला दीर्घा योद्धुकामाः प्लवंगमाः॥९॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-58",
    "chapterName": "युद्धकाण्ड, सर्ग 58",
    "verseNumber": 9
  },
  {
