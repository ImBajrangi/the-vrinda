    "slug": "valmiki-ramayana-6-sarga-58-shlok-11",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "बहवो राक्षसा युद्धे बहून् वानरपुङ्गवान्।",
          "वानरा राक्षसांश्चापि निजघ्नुर्बहवो बहून्॥११॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-58",
    "chapterName": "युद्धकाण्ड, सर्ग 58",
    "verseNumber": 11
  },
