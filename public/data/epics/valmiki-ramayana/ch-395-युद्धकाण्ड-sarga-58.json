    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "निरुच्छ्वासाः पुनः केचित् पतिता जगतीतले।",
          "विभिन्नहृदयाः केचिदिषुसंधानसाधिताः॥१३॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-58",
    "chapterName": "युद्धकाण्ड, सर्ग 58",
    "verseNumber": 13
