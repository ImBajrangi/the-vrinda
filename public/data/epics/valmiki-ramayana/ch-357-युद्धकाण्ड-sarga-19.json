    "slug": "valmiki-ramayana-6-sarga-19-shlok-14",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "महोदरमहापाश्वौँ राक्षसश्चाप्यकम्पनः।",
          "अनीकपास्तु तस्यैते लोकपालसमा युधि॥१४॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-19",
    "chapterName": "युद्धकाण्ड, सर्ग 19",
    "verseNumber": 14
  },
  {
