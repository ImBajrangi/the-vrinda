        "linesDevanagari": [
          "अहत्वा रावणं संख्ये सपुत्रजनबान्धवम्।",
          "अयोध्या",
          "ं न प्रवेक्ष्यामि त्रिभिस्तैर्भ्रातृभिः शपे॥२१॥"
        ]
      }
