    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-6-sarga-19-shlok-8",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "आख्याहि मम तत्त्वेन राक्षसानां बलाबलम्॥७॥",
          "एवमुक्तं तदा रक्षो रामेणाक्लिष्टकर्मणा।",
          "रावणस्य बलं सर्वमाख्यातुमुपचक्रमे॥८॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-19",
    "chapterName": "युद्धकाण्ड, सर्ग 19",
    "verseNumber": 8
  },
  {
    "id": "valmiki-ramayana-6-sarga-19-shlok-9",
    "collectionId": "valmiki-ramayana",
