    "slug": "valmiki-ramayana-6-sarga-19-shlok-13",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "संग्रामे सुमहद्व्यूहे तर्पयित्वा हुताशनम्।",
          "अन्तर्धानगतः श्रीमानिन्द्रजिद्धन्ति राघव॥१३॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-19",
    "chapterName": "युद्धकाण्ड, सर्ग 19",
    "verseNumber": 13
  },
  {
