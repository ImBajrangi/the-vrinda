    "slug": "valmiki-ramayana-6-sarga-19-shlok-11",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "राम सेनापतिस्तस्य प्रहस्तो यदि ते श्रुतः।",
          "कैलासे येन समरे मणिभद्रः पराजितः॥११॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-19",
    "chapterName": "युद्धकाण्ड, सर्ग 19",
    "verseNumber": 11
