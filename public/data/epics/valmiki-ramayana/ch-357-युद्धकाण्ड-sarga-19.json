    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-6-sarga-19-shlok-16",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "दशकोटिसहस्राणि रक्षसां कामरूपिणाम्।",
          "मांसशोणितभक्ष्याणां लङ्कापुरनिवासिनाम्॥१५॥",
          "स तैस्तु सहितो राजा लोकपालानयोधयत्।",
          "सह देवैस्तु ते भग्ना रावणेन दुरात्मना॥१६॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-19",
    "chapterName": "युद्धकाण्ड, सर्ग 19",
    "verseNumber": 16
  },
