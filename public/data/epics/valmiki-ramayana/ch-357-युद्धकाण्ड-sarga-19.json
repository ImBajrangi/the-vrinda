    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-6-sarga-19-shlok-10",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "रावणानन्तरो भ्राता मम ज्येष्ठश्च वीर्यवान्।",
          "कुम्भकर्णो महातेजाः शक्रप्रतिबलो युधि॥१०॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-19",
    "chapterName": "युद्धकाण्ड, सर्ग 19",
    "verseNumber": 10
  },
  {
