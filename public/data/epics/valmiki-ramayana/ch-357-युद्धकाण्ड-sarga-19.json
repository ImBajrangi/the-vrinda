    "titleDevanagari": "वाल्मीकि रामायण, युद्धकाण्ड, सर्ग 19, श्लोक 1",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-6-sarga-19-shlok-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "राघवेणाभये दत्ते संनतो रावणानुजः।",
          "विभीषणो महाप्राज्ञो भूमिं समवलोकयत्॥१॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-19",
    "chapterName": "युद्धकाण्ड, सर्ग 19",
    "verseNumber": 1
  },
  {
    "id": "valmiki-ramayana-6-sarga-19-shlok-2",
    "collectionId": "valmiki-ramayana",
    "index": 11806,
    "titleDevanagari": "वाल्मीकि रामायण, युद्धकाण्ड, सर्ग 19, श्लोक 2",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-6-sarga-19-shlok-2",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "खात् पपातावनिं हृष्टो भक्तैरनुचरैः सह।",
          "स तु रामस्य धर्मात्मा निपपात विभीषणः॥२॥",
          "पादयोर्निपपाताथ चतुर्भिः सह राक्षसैः।"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-19",
    "chapterName": "युद्धकाण्ड, सर्ग 19",
    "verseNumber": 2
  },
  {
    "id": "valmiki-ramayana-6-sarga-19-shlok-3",
    "collectionId": "valmiki-ramayana",
    "index": 11807,
    "titleDevanagari": "वाल्मीकि रामायण, युद्धकाण्ड, सर्ग 19, श्लोक 3",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-6-sarga-19-shlok-3",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "अब्रवीच्च तदा वाक्यं रामं प्रति विभीषणः॥३॥",
          "धर्मयुक्तं च युक्तं च साम्प्रतं सम्प्रहर्षणम्।"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-19",
    "chapterName": "युद्धकाण्ड, सर्ग 19",
    "verseNumber": 3
  },
  {
    "id": "valmiki-ramayana-6-sarga-19-shlok-4",
    "collectionId": "valmiki-ramayana",
    "index": 11808,
    "titleDevanagari": "वाल्मीकि रामायण, युद्धकाण्ड, सर्ग 19, श्लोक 4",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-6-sarga-19-shlok-4",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "अनुजो रावणस्याहं तेन चाम्यवमानितः॥४॥",
          "भवन्तं सर्वभूतानां शरण्यं शरणं गतः।",
          "परित्यक्ता मया लङ्का मित्राणि च धनानि च॥",
          "भवद्गतं हि मे राज्यं जीवितं च सुखानि च।"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-19",
    "chapterName": "युद्धकाण्ड, सर्ग 19",
    "verseNumber": 4
  },
  {
    "id": "valmiki-ramayana-6-sarga-19-shlok-6",
    "collectionId": "valmiki-ramayana",
    "index": 11809,
    "titleDevanagari": "वाल्मीकि रामायण, युद्धकाण्ड, सर्ग 19, श्लोक 6",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-6-sarga-19-shlok-6",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "तस्य तद् वचनं श्रुत्वा रामो वचनमब्रवीत्॥६॥",
          "वचसा सान्त्वयित्वैनं लोचनाभ्यां पिबन्निव।"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-19",
    "chapterName": "युद्धकाण्ड, सर्ग 19",
    "verseNumber": 6
  },
  {
