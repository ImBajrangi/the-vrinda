    "slug": "valmiki-ramayana-5-sarga-19-shlok-3",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "ऊरुभ्यामुदरं छाद्य बाहुभ्यां च पयोधरौ।",
          "उपविष्टा विशालाक्षी रुदती वरवर्णिनी॥३॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-19",
    "chapterName": "सुन्दरकाण्ड, सर्ग 19",
    "verseNumber": 3
  },
