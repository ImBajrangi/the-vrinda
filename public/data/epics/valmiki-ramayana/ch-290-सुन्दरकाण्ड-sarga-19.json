    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-5-sarga-19-shlok-5",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "दशग्रीवस्तु वैदेही रक्षितां राक्षसीगणैः।",
          "ददर्श दीनां दुःखार्ती नावं सन्नामिवार्णवे॥४॥",
          "असंवृतायामासीनां धरण्यां संशितव्रताम्।",
          "छिन्नां प्रपतितां भूमौ शाखामिव वनस्पतेः॥५॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-19",
    "chapterName": "सुन्दरकाण्ड, सर्ग 19",
    "verseNumber": 5
  },
