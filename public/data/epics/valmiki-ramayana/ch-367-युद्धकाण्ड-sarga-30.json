    "slug": "valmiki-ramayana-6-sarga-30-shlok-8",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "जानुभिर्मुष्टिभिर्दन्तैस्तलैश्चाभिहतो भृशम्।",
          "परिणीतोऽस्मि हरिभिर्बलमध्ये अमर्षणैः॥८॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-30",
    "chapterName": "युद्धकाण्ड, सर्ग 30",
    "verseNumber": 8
  },
  {
