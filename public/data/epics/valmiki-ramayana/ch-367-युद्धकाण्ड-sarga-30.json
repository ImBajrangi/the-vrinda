    "slug": "valmiki-ramayana-6-sarga-30-shlok-7",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "प्रविष्टमात्रे ज्ञातोऽहं बले तस्मिन् विचारिते।",
          "बलाद् गृहीतो रक्षोभिर्बहुधास्मि विचारितः॥७॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-30",
    "chapterName": "युद्धकाण्ड, सर्ग 30",
    "verseNumber": 7
  },
  {
