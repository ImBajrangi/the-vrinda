    "titleDevanagari": "वाल्मीकि रामायण, युद्धकाण्ड, सर्ग 30, श्लोक 1",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-6-sarga-30-shlok-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "ततस्तमक्षोभ्यबलं लङ्काधिपतये चराः।",
          "सुवेले राघवं शैले निविष्टं प्रत्यवेदयन्॥१॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-30",
    "chapterName": "युद्धकाण्ड, सर्ग 30",
    "verseNumber": 1
  },
  {
    "id": "valmiki-ramayana-6-sarga-30-shlok-2",
    "collectionId": "valmiki-ramayana",
    "index": 12138,
    "titleDevanagari": "वाल्मीकि रामायण, युद्धकाण्ड, सर्ग 30, श्लोक 2",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-6-sarga-30-shlok-2",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "चाराणां रावणः श्रुत्वा प्राप्तं रामं महाबलम्।",
          "जातोद्वेगोऽभवत् किंचिच्छार्दूलं वाक्यमब्रवीत् ॥२॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-30",
    "chapterName": "युद्धकाण्ड, सर्ग 30",
    "verseNumber": 2
  },
  {
    "id": "valmiki-ramayana-6-sarga-30-shlok-3",
    "collectionId": "valmiki-ramayana",
    "index": 12139,
    "titleDevanagari": "वाल्मीकि रामायण, युद्धकाण्ड, सर्ग 30, श्लोक 3",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-6-sarga-30-shlok-3",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "अयथावच्च ते वर्णो दीनश्चासि निशाचर।",
          "नासि कच्चिदमित्राणां क्रुद्धानां वशमागतः॥३॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-30",
    "chapterName": "युद्धकाण्ड, सर्ग 30",
    "verseNumber": 3
  },
  {
