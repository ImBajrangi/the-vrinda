    "titleDevanagari": "वाल्मीकि रामायण, युद्धकाण्ड, सर्ग 30, श्लोक 5",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-6-sarga-30-shlok-5",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "न ते चारयितुं शक्या राजन् वानरपुङ्गवाः।",
          "विक्रान्ता बलवन्तश्च राघवेण च रक्षिताः॥५॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-30",
    "chapterName": "युद्धकाण्ड, सर्ग 30",
    "verseNumber": 5
  },
  {
    "id": "valmiki-ramayana-6-sarga-30-shlok-6",
    "collectionId": "valmiki-ramayana",
    "index": 12141,
    "titleDevanagari": "वाल्मीकि रामायण, युद्धकाण्ड, सर्ग 30, श्लोक 6",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-6-sarga-30-shlok-6",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "नापि सम्भाषितुं शक्याः सम्प्रश्नोऽत्र न लभ्यते।",
          "सर्वतो रक्ष्यते पन्था वानरैः पर्वतोपमैः॥६॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-30",
    "chapterName": "युद्धकाण्ड, सर्ग 30",
    "verseNumber": 6
  },
  {
