    "slug": "valmiki-ramayana-5-sarga-63-shlok-5",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "नैवर्लरजसा राजन् न त्वया न च वालिना।",
          "वनं निसृष्टपूर्वं ते नाशितं तत्तु वानरैः॥५॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-63",
    "chapterName": "सुन्दरकाण्ड, सर्ग 63",
    "verseNumber": 5
  },
  {
