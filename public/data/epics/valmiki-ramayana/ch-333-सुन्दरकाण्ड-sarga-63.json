    "slug": "valmiki-ramayana-5-sarga-63-shlok-2",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "उत्तिष्ठोत्तिष्ठ कस्मात् त्वं पादयोः पतितो मम।",
          "अभयं ते प्रदास्यामि सत्यमेवाभिधीयताम्॥२॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-63",
    "chapterName": "सुन्दरकाण्ड, सर्ग 63",
    "verseNumber": 2
  },
  {
