    "slug": "valmiki-ramayana-5-sarga-63-shlok-3",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "किं सम्भ्रमाद्धितं कृत्स्नं ब्रूहि यद् वक्तुमर्हसि।",
          "कच्चिन्मधुवने स्वस्ति श्रोतुमिच्छामि वानर ॥३॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-63",
    "chapterName": "सुन्दरकाण्ड, सर्ग 63",
    "verseNumber": 3
  },
  {
