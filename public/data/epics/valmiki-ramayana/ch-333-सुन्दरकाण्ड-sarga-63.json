    "slug": "valmiki-ramayana-5-sarga-63-shlok-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "ततो मूर्जा निपतितं वानरं वानरर्षभः।",
          "दृष्ट्वैवोद्रिग्नहृदयो वाक्यमेतदुवाच ह॥१॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-63",
    "chapterName": "सुन्दरकाण्ड, सर्ग 63",
    "verseNumber": 1
  },
  {
