    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "स समाश्वासितस्तेन सुग्रीवेण महात्मना।",
          "उत्थाय स महाप्राज्ञो वाक्यं दधिमुखोऽब्रवीत्॥४॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-63",
    "chapterName": "सुन्दरकाण्ड, सर्ग 63",
    "verseNumber": 4
  },
  {
