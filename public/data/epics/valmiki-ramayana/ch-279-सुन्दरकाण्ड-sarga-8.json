    "slug": "valmiki-ramayana-5-sarga-8-shlok-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "स तस्य मध्ये भवनस्य संस्थितो महद्विमानं मणिरत्नचित्रितम्।",
          "प्रतप्तजाम्बूनदजालकृत्रिमं ददर्श धीमान् पवनात्मजः कपिः॥१॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-8",
    "chapterName": "सुन्दरकाण्ड, सर्ग 8",
    "verseNumber": 1
  },
  {
