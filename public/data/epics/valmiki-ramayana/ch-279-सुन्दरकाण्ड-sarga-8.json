    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-5-sarga-8-shlok-2",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "तदप्रमेयप्रतिकारकृत्रिमं कृतं स्वयं साध्विति विश्वकर्मणा।",
          "दिवं गते वायुपथे प्रतिष्ठितं व्यराजतादित्यपथस्य लक्ष्म तत्॥२॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-8",
    "chapterName": "सुन्दरकाण्ड, सर्ग 8",
    "verseNumber": 2
  },
  {
