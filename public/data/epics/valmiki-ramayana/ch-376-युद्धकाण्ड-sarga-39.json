        "linesDevanagari": [
          "तच्चैत्ररथसंकाशं मनोज्ञं नन्दनोपमम्।",
          "वनं सर्वर्तुकं रम्यं शुशुभे षट्पदायुतम्॥८॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-39",
    "chapterName": "युद्धकाण्ड, सर्ग 39",
    "verseNumber": 8
  },
