    "titleDevanagari": "वाल्मीकि रामायण, युद्धकाण्ड, सर्ग 39, श्लोक 5",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-6-sarga-39-shlok-5",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "चम्पकाशोकबकुलशालतालसमाकुला।",
          "तमालवनसंछन्ना नागमालासमावृता॥३॥",
          "हिन्तालैरर्जुनैर्नीपैः सप्तपर्णैः सुपुष्पितैः।",
          "तिलकैः कर्णिकारैश्च पाटलैश्च समन्ततः॥४॥",
          "शुशुभे पुष्पिताग्रैश्च लतापरिगतैर्दुमैः।",
          "लङ्का बहुविधैर्दिव्यैर्यथेन्द्रस्यामरावती॥५॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-39",
    "chapterName": "युद्धकाण्ड, सर्ग 39",
    "verseNumber": 5
  },
  {
    "id": "valmiki-ramayana-6-sarga-39-shlok-6",
    "collectionId": "valmiki-ramayana",
