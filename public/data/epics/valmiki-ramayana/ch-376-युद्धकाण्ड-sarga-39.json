    "slug": "valmiki-ramayana-6-sarga-39-shlok-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "तां रात्रिमुषितास्तत्र सुवेले हरियूथपाः।",
          "लङ्कायां ददृशुर्वीरा वनान्युपवनानि च॥१॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-39",
    "chapterName": "युद्धकाण्ड, सर्ग 39",
    "verseNumber": 1
  },
  {
