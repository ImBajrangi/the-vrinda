    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "विचित्रकुसुमोपेतै रक्तकोमलपल्लवैः।",
          "शादलैश्च तथा नीलैश्चित्राभिर्वनराजिभिः॥६॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-39",
    "chapterName": "युद्धकाण्ड, सर्ग 39",
    "verseNumber": 6
  },
