    "slug": "valmiki-ramayana-6-sarga-39-shlok-2",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "समसौम्यानि रम्याणि विशालान्यायतानि च।",
          "दृष्टिरम्याणि ते दृष्वा बभूवुर्जातविस्मयाः॥२॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-39",
    "chapterName": "युद्धकाण्ड, सर्ग 39",
    "verseNumber": 2
  },
  {
    "id": "valmiki-ramayana-6-sarga-39-shlok-5",
    "collectionId": "valmiki-ramayana",
