    "slug": "valmiki-ramayana-5-sarga-42-shlok-4",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "स ता दृष्ट्वा महाबाहुर्महासत्त्वो महाबलः।",
          "चकार सुमहद्रूपं राक्षसीनां भयावहम्॥४॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-42",
    "chapterName": "सुन्दरकाण्ड, सर्ग 42",
    "verseNumber": 4
  },
  {
    "id": "valmiki-ramayana-5-sarga-42-shlok-5",
    "collectionId": "valmiki-ramayana",
    "index": 10345,
    "titleDevanagari": "वाल्मीकि रामायण, सुन्दरकाण्ड, सर्ग 42, श्लोक 5",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-5-sarga-42-shlok-5",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "ततस्तु गिरिसंकाशमतिकायं महाबलम्।",
          "राक्षस्यो वानरं दृष्ट्वा पप्रच्छुर्जनकात्मजाम्॥५॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-42",
    "chapterName": "सुन्दरकाण्ड, सर्ग 42",
    "verseNumber": 5
  },
  {
