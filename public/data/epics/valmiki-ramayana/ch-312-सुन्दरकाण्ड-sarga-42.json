    "collectionId": "valmiki-ramayana",
    "index": 10343,
    "titleDevanagari": "वाल्मीकि रामायण, सुन्दरकाण्ड, सर्ग 42, श्लोक 3",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-5-sarga-42-shlok-3",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "ततो गतायां निद्रायां राक्षस्यो विकृताननाः।",
          "तद् वनं ददृशुर्भग्नं तं च वीरं महाकपिम्॥३॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-42",
    "chapterName": "सुन्दरकाण्ड, सर्ग 42",
    "verseNumber": 3
  },
  {
