    "titleDevanagari": "वाल्मीकि रामायण, सुन्दरकाण्ड, सर्ग 42, श्लोक 1",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-5-sarga-42-shlok-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "ततः पक्षिनिनादेन वृक्षभङ्गस्वनेन च।",
          "बभूवुस्त्राससम्भ्रान्ताः सर्वे लङ्कानिवासिनः॥१॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-42",
    "chapterName": "सुन्दरकाण्ड, सर्ग 42",
    "verseNumber": 1
  },
  {
    "id": "valmiki-ramayana-5-sarga-42-shlok-2",
    "collectionId": "valmiki-ramayana",
    "index": 10342,
    "titleDevanagari": "वाल्मीकि रामायण, सुन्दरकाण्ड, सर्ग 42, श्लोक 2",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-5-sarga-42-shlok-2",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "विद्रुताश्च भयत्रस्ता विनेदुर्मूगपक्षिणः।",
          "रक्षसां च निमित्तानि क्रूराणि प्रतिपेदिरे॥२॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-42",
    "chapterName": "सुन्दरकाण्ड, सर्ग 42",
    "verseNumber": 2
  },
  {
