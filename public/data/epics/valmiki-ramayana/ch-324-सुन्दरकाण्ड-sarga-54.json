    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-5-sarga-54-shlok-11",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "तथा चेन्द्रजितो वेश्म ददाह हरियूथपः।",
          "जम्बुमालेः सुमालेश्च ददाह भवनं ततः॥११॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-54",
    "chapterName": "सुन्दरकाण्ड, सर्ग 54",
    "verseNumber": 11
  },
  {
    "id": "valmiki-ramayana-5-sarga-54-shlok-15",
    "collectionId": "valmiki-ramayana",
    "index": 10714,
    "titleDevanagari": "वाल्मीकि रामायण, सुन्दरकाण्ड, सर्ग 54, श्लोक 15",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-5-sarga-54-shlok-15",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "रश्मिकेतोश्च भवनं सूर्यशत्रोस्तथैव च।",
          "ह्रस्वकर्णस्य दंष्ट्रस्य रोमशस्य च रक्षसः॥१२॥",
          "युद्धोन्मत्तस्य मत्तस्य ध्वजग्रीवस्य रक्षसः।",
          "विद्युज्जिह्वस्य घोरस्य तथा हस्तिमुखस्य च॥१३॥",
          "करालस्य विशालस्य शोणिताक्षस्य चैव हि।",
          "कुम्भकर्णस्य भवनं मकराक्षस्य चैव हि॥१४॥",
          "नरान्तकस्य कुम्भस्य निकुम्भस्य दुरात्मनः।",
          "यज्ञशत्रोश्च भवनं ब्रह्मशत्रोस्तथैव च॥१५॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-54",
    "chapterName": "सुन्दरकाण्ड, सर्ग 54",
    "verseNumber": 15
  },
  {
