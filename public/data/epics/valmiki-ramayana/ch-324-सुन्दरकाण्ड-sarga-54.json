    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-5-sarga-54-shlok-17",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "तेषु तेषु महार्हेषु भवनेषु महायशाः।",
          "गृहेष्वृद्धिमतामृद्धिं ददाह कपिकुञ्जरः॥१७॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-54",
    "chapterName": "सुन्दरकाण्ड, सर्ग 54",
    "verseNumber": 17
  },
  {
