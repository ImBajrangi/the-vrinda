[
  {
    "id": "valmiki-ramayana-5-sarga-54-shlok-1",
    "collectionId": "valmiki-ramayana",
    "index": 10704,
    "titleDevanagari": "वाल्मीकि रामायण, सुन्दरकाण्ड, सर्ग 54, श्लोक 1",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-5-sarga-54-shlok-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "वीक्षमाणस्ततो लङ्कां कपिः कृतमनोरथः।",
          "वर्धमानसमुत्साहः कार्यशेषमचिन्तयत्॥१॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-54",
    "chapterName": "सुन्दरकाण्ड, सर्ग 54",
    "verseNumber": 1
  },
  {
    "id": "valmiki-ramayana-5-sarga-54-shlok-2",
    "collectionId": "valmiki-ramayana",
    "index": 10705,
    "titleDevanagari": "वाल्मीकि रामायण, सुन्दरकाण्ड, सर्ग 54, श्लोक 2",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-5-sarga-54-shlok-2",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "किं नु खल्ववशिष्टं मे कर्तव्यमिह साम्प्रतम्।",
          "यदेषां रक्षसां भूयः संतापजननं भवेत्॥२॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-54",
    "chapterName": "सुन्दरकाण्ड, सर्ग 54",
    "verseNumber": 2
  },
  {
    "id": "valmiki-ramayana-5-sarga-54-shlok-3",
    "collectionId": "valmiki-ramayana",
    "index": 10706,
    "titleDevanagari": "वाल्मीकि रामायण, सुन्दरकाण्ड, सर्ग 54, श्लोक 3",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-5-sarga-54-shlok-3",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "वनं तावत्प्रमथितं प्रकृष्टा राक्षसा हताः।",
          "बलैकदेशः क्षपितः शेषं दुर्गविनाशनम्॥३॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-54",
    "chapterName": "सुन्दरकाण्ड, सर्ग 54",
    "verseNumber": 3
  },
  {
    "id": "valmiki-ramayana-5-sarga-54-shlok-4",
    "collectionId": "valmiki-ramayana",
    "index": 10707,
    "titleDevanagari": "वाल्मीकि रामायण, सुन्दरकाण्ड, सर्ग 54, श्लोक 4",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-5-sarga-54-shlok-4",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "दुर्गे विनाशिते कर्म भवेत् सुखपरिश्रमम्।",
          "अल्पयत्नेन कार्येऽस्मिन् मम स्यात् सफलः श्रमः॥४॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-54",
    "chapterName": "सुन्दरकाण्ड, सर्ग 54",
    "verseNumber": 4
  },
  {
    "id": "valmiki-ramayana-5-sarga-54-shlok-5",
    "collectionId": "valmiki-ramayana",
    "index": 10708,
    "titleDevanagari": "वाल्मीकि रामायण, सुन्दरकाण्ड, सर्ग 54, श्लोक 5",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-5-sarga-54-shlok-5",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "यो ह्ययं मम लाङ्गले दीप्यते हव्यवाहनः।",
          "अस्य संतर्पणं न्याय्यं कर्तुमेभिर्गृहोत्तमैः॥५॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-54",
    "chapterName": "सुन्दरकाण्ड, सर्ग 54",
    "verseNumber": 5
  },
  {
    "id": "valmiki-ramayana-5-sarga-54-shlok-6",
    "collectionId": "valmiki-ramayana",
    "index": 10709,
    "titleDevanagari": "वाल्मीकि रामायण, सुन्दरकाण्ड, सर्ग 54, श्लोक 6",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-5-sarga-54-shlok-6",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "ततः प्रदीप्तलाङ्गलः सविद्युदिव तोयदः।",
          "भवनाग्रेषु लङ्काया विचचार महाकपिः॥६॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-54",
    "chapterName": "सुन्दरकाण्ड, सर्ग 54",
    "verseNumber": 6
  },
  {
    "id": "valmiki-ramayana-5-sarga-54-shlok-7",
    "collectionId": "valmiki-ramayana",
    "index": 10710,
    "titleDevanagari": "वाल्मीकि रामायण, सुन्दरकाण्ड, सर्ग 54, श्लोक 7",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-5-sarga-54-shlok-7",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "गृहाद् गृहं राक्षसानामुद्यानानि च वानरः।",
          "वीक्षमाणो ह्यसंत्रस्तः प्रासादांश्च चचार सः॥७॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-54",
    "chapterName": "सुन्दरकाण्ड, सर्ग 54",
    "verseNumber": 7
  },
  {
    "id": "valmiki-ramayana-5-sarga-54-shlok-9",
    "collectionId": "valmiki-ramayana",
    "index": 10711,
    "titleDevanagari": "वाल्मीकि रामायण, सुन्दरकाण्ड, सर्ग 54, श्लोक 9",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-5-sarga-54-shlok-9",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "अवप्लुत्य महावेगः प्रहस्तस्य निवेशनम्।",
          "अग्निं तत्र विनिक्षिप्य श्वसनेन समो बली॥८॥",
          "ततोऽन्यत् पुप्लुवे वेश्म महापार्श्वस्य वीर्यवान्।",
          "मुमोच हनुमानग्निं कालानलशिखोपमम्॥९॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-54",
    "chapterName": "सुन्दरकाण्ड, सर्ग 54",
    "verseNumber": 9
  },
  {
    "id": "valmiki-ramayana-5-sarga-54-shlok-10",
    "collectionId": "valmiki-ramayana",
    "index": 10712,
    "titleDevanagari": "वाल्मीकि रामायण, सुन्दरकाण्ड, सर्ग 54, श्लोक 10",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-5-sarga-54-shlok-10",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "वज्रदंष्ट्रस्य च तथा पुप्लुवे स महाकपिः।",
          "शुकस्य च महातेजाः सारणस्य च धीमतः॥१०॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-54",
    "chapterName": "सुन्दरकाण्ड, सर्ग 54",
    "verseNumber": 10
  },
  {
    "id": "valmiki-ramayana-5-sarga-54-shlok-11",
