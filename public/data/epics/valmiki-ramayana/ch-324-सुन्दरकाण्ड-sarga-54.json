    "collectionId": "valmiki-ramayana",
    "index": 10715,
    "titleDevanagari": "वाल्मीकि रामायण, सुन्दरकाण्ड, सर्ग 54, श्लोक 16",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-5-sarga-54-shlok-16",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "वर्जयित्वा महातेजा विभीषणगृहं प्रति।",
          "क्रममाणः क्रमेणैव ददाह हरिपुङ्गवः॥१६॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-54",
    "chapterName": "सुन्दरकाण्ड, सर्ग 54",
    "verseNumber": 16
  },
  {
    "id": "valmiki-ramayana-5-sarga-54-shlok-17",
