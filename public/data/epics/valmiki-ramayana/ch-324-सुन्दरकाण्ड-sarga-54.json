      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "नाग्निस्तृप्यति काष्ठानां तृणानां च यथा तथा॥२८॥",
          "हनूमान् राक्षसेन्द्राणां वधे किंचिन्न तृप्यति।",
          "न हनूमद्रिशस्तानां राक्षसानां वसुन्धरा ॥२९॥"
        ]
      }
    ],
