    "index": 10718,
    "titleDevanagari": "वाल्मीकि रामायण, सुन्दरकाण्ड, सर्ग 54, श्लोक 20",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-5-sarga-54-shlok-20",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "ततस्तस्मिन् गृहे मुख्ये नानारत्नविभूषिते।",
          "मेरुमन्दरसंकाशे नानामङ्गलशोभिते॥१९॥",
          "प्रदीप्तमग्निमुत्सृज्य लाङ्गलाग्रे प्रतिष्ठितम्।",
          "ननाद हनुमान् वीरो युगान्तजलदो यथा॥२०॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-54",
    "chapterName": "सुन्दरकाण्ड, सर्ग 54",
    "verseNumber": 20
  },
  {
    "id": "valmiki-ramayana-5-sarga-54-shlok-21",
    "collectionId": "valmiki-ramayana",
    "index": 10719,
    "titleDevanagari": "वाल्मीकि रामायण, सुन्दरकाण्ड, सर्ग 54, श्लोक 21",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-5-sarga-54-shlok-21",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "श्वसनेन च संयोगादतिवेगो महाबलः।",
          "कालाग्निरिव जज्वाल प्रावर्धत हुताशनः॥२१॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-54",
    "chapterName": "सुन्दरकाण्ड, सर्ग 54",
    "verseNumber": 21
  },
  {
    "id": "valmiki-ramayana-5-sarga-54-shlok-23",
    "collectionId": "valmiki-ramayana",
    "index": 10720,
    "titleDevanagari": "वाल्मीकि रामायण, सुन्दरकाण्ड, सर्ग 54, श्लोक 23",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-5-sarga-54-shlok-23",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "प्रदीप्तमग्निं पवनस्तेषु वेश्मसु चारयन्।",
          "तानि काञ्चनजालानि मुक्तामणिमयानि च॥२२॥",
          "भवनानि व्यशीर्यन्त रत्नवन्ति महान्ति च।",
          "तानि भग्नविमानानि निपेतुर्वसुधातले॥२३॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-54",
    "chapterName": "सुन्दरकाण्ड, सर्ग 54",
    "verseNumber": 23
  },
  {
    "id": "valmiki-ramayana-5-sarga-54-shlok-24",
    "collectionId": "valmiki-ramayana",
    "index": 10721,
    "titleDevanagari": "वाल्मीकि रामायण, सुन्दरकाण्ड, सर्ग 54, श्लोक 24",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-5-sarga-54-shlok-24",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "भवनानीव सिद्धानामम्बरात् पुण्यसंक्षये।",
          "संजज्ञे तुमुलः शब्दो राक्षसानां प्रधावताम्॥२४॥",
          "स्वे स्वे गृहपरित्राणे भग्नोत्साहोज्झितश्रियाम्।",
          "काश्चिदग्निपरीताङ्ग्यो हर्येभ्यो मुक्तमूर्धजाः॥ २६॥",
          "पतन्त्योरेजिरेऽभ्रेभ्यः सौदामन्य इवाम्बरात्।"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-54",
    "chapterName": "सुन्दरकाण्ड, सर्ग 54",
    "verseNumber": 24
  },
