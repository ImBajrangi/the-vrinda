    "collectionId": "valmiki-ramayana",
    "index": 10717,
    "titleDevanagari": "वाल्मीकि रामायण, सुन्दरकाण्ड, सर्ग 54, श्लोक 18",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-5-sarga-54-shlok-18",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "सर्वेषां समतिक्रम्य राक्षसेन्द्रस्य वीर्यवान्।",
          "आससादाथ लक्ष्मीवान् रावणस्य निवेशनम्॥१८॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-54",
    "chapterName": "सुन्दरकाण्ड, सर्ग 54",
    "verseNumber": 18
  },
  {
    "id": "valmiki-ramayana-5-sarga-54-shlok-20",
