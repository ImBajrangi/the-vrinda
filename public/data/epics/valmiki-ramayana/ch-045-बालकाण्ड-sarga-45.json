    "slug": "valmiki-ramayana-1-sarga-45-shlok-2-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "एवमेतद् विचेतव्यं भवद्भिर्वानरोत्तमैः।",
          "तदुग्रशासनं भर्तुर्विज्ञाय हरिपुंगवाः ॥२॥",
          "शलभा इव संछाद्य मेदिनीं सम्प्रतस्थिरे।"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-45",
    "chapterName": "बालकाण्ड, सर्ग 45",
    "verseNumber": 2
  },
  {
