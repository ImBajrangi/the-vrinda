    "slug": "valmiki-ramayana-1-sarga-45-shlok-6",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "गता भगवती रात्रिः श्रोतव्यं परमं श्रुतम्।",
          "तराम सरितां श्रेष्ठां पुण्यां त्रिपथगां नदीम्॥६॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-45",
    "chapterName": "बालकाण्ड, सर्ग 45",
    "verseNumber": 6
  },
  {
    "id": "valmiki-ramayana-1-sarga-45-shlok-7",
