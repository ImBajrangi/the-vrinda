    "slug": "valmiki-ramayana-1-sarga-45-shlok-13",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "तस्य तद् वचनं श्रुत्वा रामस्य मुनिपुंगवः।",
          "आख्यातुं तत्समारेभे विशालायाः पुरातनम्॥ १३॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-45",
    "chapterName": "बालकाण्ड, सर्ग 45",
