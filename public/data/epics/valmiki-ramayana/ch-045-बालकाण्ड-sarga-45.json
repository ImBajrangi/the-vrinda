    "slug": "valmiki-ramayana-1-sarga-45-shlok-1-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "सर्वांश्चाहूय सुग्रीवः प्लवगान् प्लवगर्षभः।",
          "समस्तांश्चाब्रवीद् राजा रामकार्यार्थसिद्धये ॥१॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-45",
    "chapterName": "बालकाण्ड, सर्ग 45",
    "verseNumber": 1
  },
  {
    "id": "valmiki-ramayana-1-sarga-45-shlok-2-1",
    "collectionId": "valmiki-ramayana",
