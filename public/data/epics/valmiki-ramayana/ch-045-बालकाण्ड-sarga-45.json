    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "एवमुक्तस्ततो देवैर्देवदेवेश्वरः प्रभुः।",
          "प्रादुरासीत् ततोऽत्रैव शङ्खचक्रधरो हरिः॥ २२॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-45",
    "chapterName": "बालकाण्ड, सर्ग 45",
    "verseNumber": 22
  },
