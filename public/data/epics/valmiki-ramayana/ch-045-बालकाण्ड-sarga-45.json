    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "ततः सर्वा दिशो राजा चोदयित्वा यथातथम्।",
          "कपिसेनापतिर्वीरो मुमोद सुखितः सुखम्॥८॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-45",
    "chapterName": "बालकाण्ड, सर्ग 45",
    "verseNumber": 8
  },
