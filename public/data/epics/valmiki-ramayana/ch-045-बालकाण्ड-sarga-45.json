      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "ततो मुनिवरस्तूर्णं जगाम सहराघवः।",
          "विशाला नगरी रम्यां दिव्यां स्वर्गोपमां तदा॥ १०॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-45",
    "chapterName": "बालकाण्ड, सर्ग 45",
