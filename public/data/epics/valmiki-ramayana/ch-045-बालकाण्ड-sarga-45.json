    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "ततो निश्चित्य मथनं योक्त्रं कृत्वा च वासुकिम्।",
          "मन्थानं मन्दरं कृत्वा ममन्थुरमितौजसः॥१८॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-45",
    "chapterName": "बालकाण्ड, सर्ग 45",
