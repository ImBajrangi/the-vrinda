    "index": 2136,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 45, श्लोक 7",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-45-shlok-7",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "पूर्वां दिशं प्रतिययौ विनतो हरियूथपः॥५॥",
          "ताराङ्गदादिसहितः प्लवगः पवनात्मजः।",
          "अगस्त्याचरितामाशां दक्षिणां हरियूथपः॥६॥",
          "पश्चिमां च दिशं घोरां सुषेणः प्लवगेश्वरः।",
          "प्रतस्थे हरिशार्दूलो दिशं वरुणपालिताम्॥७॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-45",
    "chapterName": "बालकाण्ड, सर्ग 45",
    "verseNumber": 7
  },
  {
