    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "उत्तरां तु दिशं रम्यां गिरिराजसमावृताम्॥४॥",
          "प्रतस्थे सहसा वीरो हरिः शतबलिस्तदा।"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-45",
    "chapterName": "बालकाण्ड, सर्ग 45",
    "verseNumber": 4
  },
