    "slug": "valmiki-ramayana-1-sarga-45-shlok-12",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "कतमो राजवंशोऽयं विशालायां महामुने।",
          "श्रोतुमिच्छामि भद्रं ते परं कौतूहलं हि मे ॥१२॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-45",
    "chapterName": "बालकाण्ड, सर्ग 45",
    "verseNumber": 12
