    "slug": "valmiki-ramayana-1-sarga-45-shlok-3",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "रामः प्रस्रवणे तस्मिन् न्यवसत् सहलक्ष्मणः॥३॥",
          "प्रतीक्षमाणस्तं मासं सीताधिगमने कृतः।"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-45",
    "chapterName": "बालकाण्ड, सर्ग 45",
    "verseNumber": 3
  },
