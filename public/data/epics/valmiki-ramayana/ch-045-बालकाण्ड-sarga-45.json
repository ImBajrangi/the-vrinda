    "slug": "valmiki-ramayana-1-sarga-45-shlok-5",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "ततः प्रभाते विमले विश्वामित्रं तपोधनम्।",
          "उवाच राघवो वाक्यं कृताह्निकमरिंदमः॥५॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-45",
    "chapterName": "बालकाण्ड, सर्ग 45",
    "verseNumber": 5
  },
  {
