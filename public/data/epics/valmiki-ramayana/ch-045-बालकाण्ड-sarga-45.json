      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "श्रूयतां राम शक्रस्य कथां कथयतः श्रुताम्।",
          "अस्मिन् देशे हि यद् वृत्तं शृणु तत्त्वेन राघव॥ १४॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-45",
    "chapterName": "बालकाण्ड, सर्ग 45",
    "verseNumber": 14
  },
  {
    "id": "valmiki-ramayana-1-sarga-45-shlok-15",
    "collectionId": "valmiki-ramayana",
    "index": 2143,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 45, श्लोक 15",
