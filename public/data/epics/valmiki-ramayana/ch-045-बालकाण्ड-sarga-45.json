        "stanzaNumber": 1,
        "linesDevanagari": [
          "अथ देवा महादेवं शङ्करं शरणार्थिनः।",
          "जग्मुः पशुपतिं रुद्रं त्राहि त्राहीति तुष्टवुः ॥२१॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-45",
    "chapterName": "बालकाण्ड, सर्ग 45",
    "verseNumber": 21
