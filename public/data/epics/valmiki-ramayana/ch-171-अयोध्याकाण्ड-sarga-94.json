    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "नानामृगगणैर्दीपितरक्ष्वृक्षगणैर्वृतः।",
          "अदुष्टैर्भात्ययं शैलो बहुपक्षिसमाकुलः॥७॥"
        ]
      }
    ],
    "chapterId": "अयोध्याकाण्ड-sarga-94",
    "chapterName": "अयोध्याकाण्ड, सर्ग 94",
    "verseNumber": 7
  },
  {
