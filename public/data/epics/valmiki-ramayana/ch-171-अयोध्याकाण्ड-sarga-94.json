    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-2-sarga-94-shlok-6",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "केचिद् रजतसंकाशाः केचित् क्षतजसंनिभाः।",
          "पीतमाञ्जिष्ठवर्णाश्च केचिन्मणिवरप्रभाः॥५॥",
          "पुष्पार्ककेतकाभाश्च केचिज्ज्योतीरसप्रभाः।",
          "विराजन्तेऽचलेन्द्रस्य देशा धातुविभूषिताः॥६॥"
        ]
      }
    ],
    "chapterId": "अयोध्याकाण्ड-sarga-94",
    "chapterName": "अयोध्याकाण्ड, सर्ग 94",
    "verseNumber": 6
  },
