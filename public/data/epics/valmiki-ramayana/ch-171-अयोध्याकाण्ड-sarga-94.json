    "titleDevanagari": "वाल्मीकि रामायण, अयोध्याकाण्ड, सर्ग 94, श्लोक 3",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-2-sarga-94-shlok-3",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "न राज्यभ्रंशनं भद्रे न सुहृद्भिर्विनाभवः।",
          "मनो मे बाधते दृष्ट्वा रमणीयमिमं गिरिम्॥३॥"
        ]
      }
    ],
    "chapterId": "अयोध्याकाण्ड-sarga-94",
    "chapterName": "अयोध्याकाण्ड, सर्ग 94",
    "verseNumber": 3
  },
