    "slug": "valmiki-ramayana-2-sarga-94-shlok-4",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "पश्येममचलं भद्रे नानाद्विजगणायुतम्।",
          "शिखरैः खमिवोद्विद्वैर्धातुमद्भिर्विभूषितम्॥४॥"
        ]
      }
    ],
    "chapterId": "अयोध्याकाण्ड-sarga-94",
    "chapterName": "अयोध्याकाण्ड, सर्ग 94",
    "verseNumber": 4
  },
