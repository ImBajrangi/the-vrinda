    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "जलप्रपातैरुद्भेदैनिष्पन्दैश्च क्वचित् क्वचित्।",
          "स्रवद्भिर्भात्ययं शैलः स्रवन्मद इव द्विपः॥१३॥"
        ]
      }
