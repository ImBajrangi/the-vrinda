    "titleDevanagari": "वाल्मीकि रामायण, अरण्यकाण्ड, सर्ग 10, श्लोक 4",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-10-shlok-4",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "ते चार्ता दण्डकारण्ये मुनयः संशितव्रताः।",
          "मां सीते स्वयमागम्य शरण्यं शरणं गताः॥४॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-10",
    "chapterName": "अरण्यकाण्ड, सर्ग 10",
    "verseNumber": 4
  },
  {
    "id": "valmiki-ramayana-3-sarga-10-shlok-5",
    "collectionId": "valmiki-ramayana",
    "index": 7025,
    "titleDevanagari": "वाल्मीकि रामायण, अरण्यकाण्ड, सर्ग 10, श्लोक 5",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-10-shlok-5",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "वसन्तः कालकालेषु वने मूलफलाशनाः।",
          "न लभन्ते सुखं भीरु राक्षसैः क्रूरकर्मभिः॥५॥",
          "भक्ष्यन्ते राक्षसैीमैर्नरमांसोपजीविभिः।"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-10",
    "chapterName": "अरण्यकाण्ड, सर्ग 10",
    "verseNumber": 5
  },
  {
    "id": "valmiki-ramayana-3-sarga-10-shlok-6",
    "collectionId": "valmiki-ramayana",
