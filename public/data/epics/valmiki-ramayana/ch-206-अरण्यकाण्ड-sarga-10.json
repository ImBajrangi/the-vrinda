    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "होमकाले तु सम्प्राप्ते पर्वकालेषु चानघ ॥११॥",
          "धर्षयन्ति सुदुर्धर्षा राक्षसाः पिशिताशनाः।"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-10",
    "chapterName": "अरण्यकाण्ड, सर्ग 10",
    "verseNumber": 11
