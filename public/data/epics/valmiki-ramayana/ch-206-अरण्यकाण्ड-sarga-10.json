    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-10-shlok-12",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "राक्षसैर्धर्षितानां च तापसानां तपस्विनाम्॥१२॥",
          "गतिं मृगयमाणानां भवान् नः परमा गतिः।"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-10",
    "chapterName": "अरण्यकाण्ड, सर्ग 10",
    "verseNumber": 12
