        "linesDevanagari": [
          "मया तु वचनं श्रुत्वा तेषामेवं मुखाच्च्युतम्॥७॥",
          "कृत्वा वचनशुश्रूषां वाक्यमेतदुदाहृतम्।"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-10",
    "chapterName": "अरण्यकाण्ड, सर्ग 10",
    "verseNumber": 7
  },
  {
    "id": "valmiki-ramayana-3-sarga-10-shlok-9",
