    "collectionId": "valmiki-ramayana",
    "index": 7023,
    "titleDevanagari": "वाल्मीकि रामायण, अरण्यकाण्ड, सर्ग 10, श्लोक 3",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-10-shlok-3",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "किं नु वक्ष्याम्यहं देवि त्वयैवोक्तमिदं वचः।",
          "क्षत्रियैर्धार्यते चापो नार्तशब्दो भवेदिति॥३॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-10",
    "chapterName": "अरण्यकाण्ड, सर्ग 10",
    "verseNumber": 3
  },
  {
    "id": "valmiki-ramayana-3-sarga-10-shlok-4",
