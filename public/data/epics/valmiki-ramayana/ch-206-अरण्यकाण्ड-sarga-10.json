      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "॥ श्रीसीतारामचन्द्राभ्यां नमः॥",
          "श्रीमद्वाल्मीकीय रामायण",
          "अरण्यकाण्डम्",
          "दशमः सर्गः (सर्ग 10)",
          "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्येऽरण्यकाण्डे दशमः सर्गः ॥१०॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-10",
    "chapterName": "अरण्यकाण्ड, सर्ग 10",
    "verseNumber": 10
  },
  {
