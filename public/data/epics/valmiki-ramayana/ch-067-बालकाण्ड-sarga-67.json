    "slug": "valmiki-ramayana-1-sarga-67-shlok-22",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "महामेरुप्रतीकाशं मां द्रक्ष्यध्वं प्लवङ्गमाः॥२१॥",
          "दिवमावृत्य गच्छन्तं ग्रसमानमिवाम्बरम्।",
          "विधमिष्यामि जीमूतान् कम्पयिष्यामि पर्वतान्।",
          "सागरं शोषयिष्यामि प्लवमानः समाहितः॥२२॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-67",
    "chapterName": "बालकाण्ड, सर्ग 67",
    "verseNumber": 22
  },
  {
    "id": "valmiki-ramayana-1-sarga-67-shlok-23",
