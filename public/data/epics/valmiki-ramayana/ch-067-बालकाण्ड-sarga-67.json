      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "पन्नगाशनमाकाशे पतन्तं पक्षिसेवितम्।",
          "वैनतेयमहं शक्तः परिगन्तुं सहस्रशः॥१४॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-67",
    "chapterName": "बालकाण्ड, सर्ग 67",
