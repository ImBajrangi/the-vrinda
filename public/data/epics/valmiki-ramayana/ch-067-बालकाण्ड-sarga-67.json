      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "आरुजन् पर्वताग्राणि हुताशनसखोऽनिलः।",
          "बलवानप्रमेयश्च वायुराकाशगोचरः॥९॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-67",
    "chapterName": "बालकाण्ड, सर्ग 67",
    "verseNumber": 9
  },
  {
