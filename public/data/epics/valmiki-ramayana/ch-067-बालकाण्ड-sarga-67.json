    "slug": "valmiki-ramayana-1-sarga-67-shlok-13",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "ममोरुजङ्घावेगेन भविष्यति समुत्थितः।",
          "समुत्थितमहाग्राहः समुद्रो वरुणालयः॥१३॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-67",
    "chapterName": "बालकाण्ड, सर्ग 67",
