    "slug": "valmiki-ramayana-1-sarga-67-shlok-23",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "वैनतेयस्य वा शक्तिर्मम वा मारुतस्य वा।",
          "ऋते सुपर्णराजानं मारुतं वा महाबलम्।",
          "न तद् भूतं प्रपश्यामि यन्मां प्लुतमनुव्रजेत्॥२३॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-67",
    "chapterName": "बालकाण्ड, सर्ग 67",
    "verseNumber": 23
  },
