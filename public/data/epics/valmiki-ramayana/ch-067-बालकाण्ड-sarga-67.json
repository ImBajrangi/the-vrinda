    "slug": "valmiki-ramayana-1-sarga-67-shlok-24",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "निमेषान्तरमात्रेण निरालम्बनमम्बरम्।",
          "सहसा निपतिष्यामि घनाद विद्युदिवोत्थिता॥२४॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-67",
