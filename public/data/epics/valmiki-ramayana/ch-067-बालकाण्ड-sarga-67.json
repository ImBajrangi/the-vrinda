    "slug": "valmiki-ramayana-1-sarga-67-shlok-8",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "हरीणामुत्थितो मध्यात् सम्प्रहृष्टतनूरुहः।",
          "अभिवाद्य हरीन् वृद्धान् हनूमानिदमब्रवीत्॥८॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-67",
    "chapterName": "बालकाण्ड, सर्ग 67",
    "verseNumber": 8
  },
  {
