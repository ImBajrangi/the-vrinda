    "slug": "valmiki-ramayana-1-sarga-67-shlok-20",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "भविष्यति हि मे पन्थाः स्वातेः पन्था इवाम्बरे।",
          "चरन्तं घोरमाकाशमुत्पतिष्यन्तमेव च ॥२०॥",
          "द्रक्ष्यन्ति निपतन्तं च सर्वभूतानि वानराः।"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-67",
    "chapterName": "बालकाण्ड, सर्ग 67",
    "verseNumber": 20
  },
  {
    "id": "valmiki-ramayana-1-sarga-67-shlok-22",
