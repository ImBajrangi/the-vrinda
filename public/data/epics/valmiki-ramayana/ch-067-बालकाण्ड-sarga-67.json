        "linesDevanagari": [
          "तस्याहं शीघ्रवेगस्य शीघ्रगस्य महात्मनः।",
          "मारुतस्यौरसः पुत्रः प्लवनेनास्मि तत्समः ॥१०॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-67",
    "chapterName": "बालकाण्ड, सर्ग 67",
    "verseNumber": 10
