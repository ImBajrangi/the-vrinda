    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "तच्चास्य वचनं श्रुत्वा ज्ञातीनां शोकनाशनम्॥३०॥",
          "उवाच परिसंहृष्टो जाम्बवान् प्लवगेश्वरः।"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-67",
    "chapterName": "बालकाण्ड, सर्ग 67",
    "verseNumber": 30
  },
  {
    "id": "valmiki-ramayana-1-sarga-67-shlok-31",
