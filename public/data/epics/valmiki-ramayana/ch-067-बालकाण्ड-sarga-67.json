[
  {
    "id": "valmiki-ramayana-1-sarga-67-shlok-2",
    "collectionId": "valmiki-ramayana",
    "index": 2742,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 67, श्लोक 2",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-67-shlok-2",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "तं दृष्ट्वा जृम्भमाणं ते क्रमितुं शतयोजनम्।",
          "वेगेनापूर्यमाणं च सहसा वानरोत्तमम्॥१॥",
          "सहसा शोकमुत्सृज्य प्रहर्षेण समन्विताः।",
          "विनेदुस्तुष्टवुश्चापि हनूमन्तं महाबलम्॥२॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-67",
    "chapterName": "बालकाण्ड, सर्ग 67",
    "verseNumber": 2
  },
  {
    "id": "valmiki-ramayana-1-sarga-67-shlok-3",
    "collectionId": "valmiki-ramayana",
    "index": 2743,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 67, श्लोक 3",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-67-shlok-3",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "प्रहृष्टा विस्मिताश्चापि ते वीक्षन्ते समन्ततः।",
          "त्रिविक्रमं कृतोत्साहं नारायणमिव प्रजाः॥३॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-67",
    "chapterName": "बालकाण्ड, सर्ग 67",
    "verseNumber": 3
  },
  {
    "id": "valmiki-ramayana-1-sarga-67-shlok-4",
    "collectionId": "valmiki-ramayana",
    "index": 2744,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 67, श्लोक 4",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-67-shlok-4",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "संस्तूयमानो हनुमान् व्यवर्धत महाबलः।",
          "समाविद्ध्य च लाङ्गेलं हर्षाद् बलमुपेयिवान्॥४॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-67",
    "chapterName": "बालकाण्ड, सर्ग 67",
    "verseNumber": 4
  },
  {
    "id": "valmiki-ramayana-1-sarga-67-shlok-5",
    "collectionId": "valmiki-ramayana",
    "index": 2745,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 67, श्लोक 5",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-67-shlok-5",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "तस्य संस्तूयमानस्य वृद्वैर्वानरपुङ्गवैः।",
          "तेजसाऽऽपूर्यमाणस्य रूपमासीदनुत्तमम्॥५॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-67",
    "chapterName": "बालकाण्ड, सर्ग 67",
    "verseNumber": 5
  },
  {
    "id": "valmiki-ramayana-1-sarga-67-shlok-6",
    "collectionId": "valmiki-ramayana",
    "index": 2746,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 67, श्लोक 6",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-67-shlok-6",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "यथा विजृम्भते सिंहो विवृते गिरिगह्वरे।",
          "मारुतस्यौरसः पुत्रस्तथा सम्प्रति जृम्भते॥६॥",
          "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये किष्किन्धाकाण्डे सप्तषष्टितमः सर्गः॥६७॥",
          "॥ किष्किन्धाकाण्डं सम्पूर्णम्॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-67",
    "chapterName": "बालकाण्ड, सर्ग 67",
    "verseNumber": 6
  },
  {
    "id": "valmiki-ramayana-1-sarga-67-shlok-7",
    "collectionId": "valmiki-ramayana",
    "index": 2747,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 67, श्लोक 7",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-67-shlok-7",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "अशोभत मुखं तस्य जृम्भमाणस्य धीमतः।",
          "अम्बरीषोपमं दीप्तं विधूम इव पावकः॥७॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-67",
    "chapterName": "बालकाण्ड, सर्ग 67",
    "verseNumber": 7
  },
  {
    "id": "valmiki-ramayana-1-sarga-67-shlok-8",
