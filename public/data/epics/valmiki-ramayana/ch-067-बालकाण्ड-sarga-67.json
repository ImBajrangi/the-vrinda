    "slug": "valmiki-ramayana-1-sarga-67-shlok-19",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "लतानां विविधं पुष्पं पादपानां च सर्वशः।",
          "अनुयास्यति मामद्य प्लवमानं विहायसा॥१९॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-67",
    "chapterName": "बालकाण्ड, सर्ग 67",
    "verseNumber": 19
  },
  {
