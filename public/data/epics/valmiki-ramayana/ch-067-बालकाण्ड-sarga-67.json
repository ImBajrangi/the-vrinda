      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "बाहुवेगप्रणुन्नेन सागरेणाहमुत्सहे।",
          "समाप्लावयितुं लोकं सपर्वतनदीह्रदम्॥१२॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-67",
    "chapterName": "बालकाण्ड, सर्ग 67",
