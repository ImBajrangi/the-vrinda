      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "त्वां चैवोपगताः सर्वे परियूना बुभुक्षिताः।",
          "आतिथ्यधर्मदत्तानि मूलानि च फलानि च॥१६॥",
          "अस्माभिरुपयुक्तानि बुभुक्षापरिपीडितैः।"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-52",
    "chapterName": "बालकाण्ड, सर्ग 52",
    "verseNumber": 16
  },
