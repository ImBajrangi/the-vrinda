    "slug": "valmiki-ramayana-1-sarga-52-shlok-12-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "अस्माद्धंसा जलक्लिन्नाः पक्षैः सलिलरेणुभिः।",
          "कुरराः सारसाश्चैव निष्पतन्ति पतत्त्रिणः॥१२॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-52",
    "chapterName": "बालकाण्ड, सर्ग 52",
    "verseNumber": 12
  },
  {
