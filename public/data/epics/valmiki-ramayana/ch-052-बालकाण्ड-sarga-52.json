    "slug": "valmiki-ramayana-1-sarga-52-shlok-11-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "चारयन्तस्ततश्चक्षुर्दृष्टवन्तो महद् बिलम्।",
          "लतापादपसंछन्नं तिमिरेण समावृतम्॥११॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-52",
    "chapterName": "बालकाण्ड, सर्ग 52",
    "verseNumber": 11
