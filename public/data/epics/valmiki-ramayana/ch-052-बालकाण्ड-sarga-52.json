    "slug": "valmiki-ramayana-1-sarga-52-shlok-14-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "अस्मिन् निपतिताः सर्वेऽप्यथ कार्यत्वरान्विताः।",
          "ततो गाढं निपतिता गृह्य हस्तैः परस्परम्॥१४॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-52",
    "chapterName": "बालकाण्ड, सर्ग 52",
    "verseNumber": 14
