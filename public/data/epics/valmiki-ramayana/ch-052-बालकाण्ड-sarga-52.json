    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "विवर्णवदनाः सर्वे सर्वे ध्यानपरायणाः।",
          "नाधिगच्छामहे पारं मग्नाश्चिन्तामहार्णवे॥१०॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-52",
    "chapterName": "बालकाण्ड, सर्ग 52",
    "verseNumber": 10
  },
  {
