[
  {
    "id": "valmiki-ramayana-1-sarga-52-shlok-1",
    "collectionId": "valmiki-ramayana",
    "index": 2323,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 52, श्लोक 1",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-52-shlok-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "अथ तानब्रवीत् सर्वान् विश्रान्तान् हरियूथपान्।",
          "इदं वचनमेकाना तापसी धर्मचारिणी॥१॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-52",
    "chapterName": "बालकाण्ड, सर्ग 52",
    "verseNumber": 1
  },
  {
    "id": "valmiki-ramayana-1-sarga-52-shlok-2-1",
    "collectionId": "valmiki-ramayana",
    "index": 2324,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 52, श्लोक 2",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-52-shlok-2-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "वानरा यदि वः खेदः प्रणष्टः फलभक्षणात्।",
          "यदि चैतन्मया श्राव्यं श्रोतुमिच्छामि तां कथाम्॥२॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-52",
    "chapterName": "बालकाण्ड, सर्ग 52",
    "verseNumber": 2
  },
  {
    "id": "valmiki-ramayana-1-sarga-52-shlok-3",
    "collectionId": "valmiki-ramayana",
    "index": 2325,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 52, श्लोक 3",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-52-shlok-3",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "तस्यास्तद् वचनं श्रुत्वा हनूमान् मारुतात्मजः।",
          "आर्जवेन यथातत्त्वमाख्यातुमुपचक्रमे ॥३॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-52",
    "chapterName": "बालकाण्ड, सर्ग 52",
    "verseNumber": 3
  },
  {
    "id": "valmiki-ramayana-1-sarga-52-shlok-4",
    "collectionId": "valmiki-ramayana",
    "index": 2326,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 52, श्लोक 4",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-52-shlok-4",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "राजा सर्वस्य लोकस्य महेन्द्रवरुणोपमः।",
          "रामो दाशरथिः श्रीमान् प्रविष्टो दण्डकावनम्॥४॥",
          "लक्ष्मणेन सह भ्रात्रा वैदेह्या सह भार्यया।",
          "तस्य भार्या जनस्थानाद् रावणेन हृता बलात्॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-52",
    "chapterName": "बालकाण्ड, सर्ग 52",
    "verseNumber": 4
  },
  {
    "id": "valmiki-ramayana-1-sarga-52-shlok-5",
    "collectionId": "valmiki-ramayana",
    "index": 2327,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 52, श्लोक 5",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-52-shlok-5",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "प्रतिगृह्य तु तां पूजां वसिष्ठाद् राजसत्तमः।",
          "तपोऽग्निहोत्रशिष्येषु कुशलं पर्यपृच्छत॥४॥",
          "विश्वामित्रो महातेजा वनस्पतिगणे तदा।",
          "सर्वत्र कुशलं प्राह वसिष्ठो राजसत्तमम्॥५॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-52",
    "chapterName": "बालकाण्ड, सर्ग 52",
    "verseNumber": 5
  },
  {
    "id": "valmiki-ramayana-1-sarga-52-shlok-6",
    "collectionId": "valmiki-ramayana",
    "index": 2328,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 52, श्लोक 6",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-52-shlok-6",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "सुखोपविष्टं राजानं विश्वामित्रं महातपाः।",
          "पप्रच्छ जपतां श्रेष्ठो वसिष्ठो ब्रह्मणः सुतः॥६॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-52",
    "chapterName": "बालकाण्ड, सर्ग 52",
    "verseNumber": 6
  },
  {
    "id": "valmiki-ramayana-1-sarga-52-shlok-7",
    "collectionId": "valmiki-ramayana",
    "index": 2329,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 52, श्लोक 7",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-52-shlok-7",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "वीरस्तस्य सखा राज्ञः सुग्रीवो नाम वानरः।",
          "राजा वानरमुख्यानां येन प्रस्थापिता वयम्॥६॥",
          "अगस्त्यचरितामाशां दक्षिणां यमरक्षिताम्।",
          "सहैभिर्वानरैर्मुख्यैरङ्गदप्रमुखैर्वयम्॥७॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-52",
    "chapterName": "बालकाण्ड, सर्ग 52",
    "verseNumber": 7
  },
  {
    "id": "valmiki-ramayana-1-sarga-52-shlok-8",
    "collectionId": "valmiki-ramayana",
    "index": 2330,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 52, श्लोक 8",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-52-shlok-8",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "रावणं सहिताः सर्वे राक्षसं कामरूपिणम्।",
          "सीतया सह वैदेह्या मार्गध्वमिति चोदिताः॥८॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-52",
    "chapterName": "बालकाण्ड, सर्ग 52",
    "verseNumber": 8
  },
  {
    "id": "valmiki-ramayana-1-sarga-52-shlok-9-1",
    "collectionId": "valmiki-ramayana",
    "index": 2331,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 52, श्लोक 9",
