    "slug": "valmiki-ramayana-1-sarga-52-shlok-9-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "विचित्य तु वनं सर्वं समुद्रं दक्षिणां दिशम्।",
          "वयं बुभुक्षिताः सर्वे वृक्षमूलमुपाश्रिताः॥९॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-52",
    "chapterName": "बालकाण्ड, सर्ग 52",
    "verseNumber": 9
  },
  {
