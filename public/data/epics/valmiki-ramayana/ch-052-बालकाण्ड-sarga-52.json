    "slug": "valmiki-ramayana-1-sarga-52-shlok-13",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "साध्वत्र प्रविशामेति मया तूक्ताः प्लवङ्गमाः।",
          "तेषामपि हि सर्वेषामनुमानमुपागतम्॥१३॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-52",
    "chapterName": "बालकाण्ड, सर्ग 52",
    "verseNumber": 13
  },
