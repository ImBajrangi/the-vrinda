    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "अर्कं तुद्यां शरैस्तीक्ष्णैर्विभिन्द्यां हि महीतलम्।",
          "कामरूपेण उन्मत्ते पश्य मां कामरूपिणम्॥४॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-49",
    "chapterName": "अरण्यकाण्ड, सर्ग 49",
    "verseNumber": 4
  },
