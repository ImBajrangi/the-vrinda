    "slug": "valmiki-ramayana-3-sarga-49-shlok-5",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "एवमुक्तवतस्तस्य रावणस्य शिखिप्रभे।",
          "क्रुद्धस्य हरिपर्यन्ते रक्ते नेत्रे बभूवतुः॥५॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-49",
    "chapterName": "अरण्यकाण्ड, सर्ग 49",
    "verseNumber": 5
  },
  {
