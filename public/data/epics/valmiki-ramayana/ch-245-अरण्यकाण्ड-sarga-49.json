    "slug": "valmiki-ramayana-3-sarga-49-shlok-2",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "स मैथिली पुनर्वाक्यं बभाषे वाक्यकोविदः।",
          "नोन्मत्तया श्रुतौ मन्ये मम वीर्यपराक्रमौ॥२॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-49",
    "chapterName": "अरण्यकाण्ड, सर्ग 49",
    "verseNumber": 2
  },
  {
