    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "मां भजस्व चिराय त्वमहं श्लाघ्यः पतिस्तव।",
          "नैव चाहं क्वचिद् भद्रे करिष्ये तव विप्रियम्॥ १२॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-49",
    "chapterName": "अरण्यकाण्ड, सर्ग 49",
    "verseNumber": 12
