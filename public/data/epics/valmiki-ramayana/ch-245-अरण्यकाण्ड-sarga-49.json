    "slug": "valmiki-ramayana-3-sarga-49-shlok-3",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "उदहेयं भुजाभ्यां तु मेदिनीमम्बरे स्थितः।",
          "आपिबेयं समुद्रं च मृत्युं हन्यां रणे स्थितः॥३॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-49",
    "chapterName": "अरण्यकाण्ड, सर्ग 49",
    "verseNumber": 3
  },
  {
