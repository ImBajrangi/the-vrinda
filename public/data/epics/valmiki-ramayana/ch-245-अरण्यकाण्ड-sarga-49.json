    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "सद्यः सौम्यं परित्यज्य तीक्ष्णरूपं स रावणः।",
          "स्वं रूपं कालरूपाभं भेजे वैश्रवणानुजः॥६॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-49",
    "chapterName": "अरण्यकाण्ड, सर्ग 49",
    "verseNumber": 6
  },
