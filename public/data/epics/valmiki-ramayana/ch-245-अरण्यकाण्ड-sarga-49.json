    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "दशास्यो विंशतिभुजो बभूव क्षणदाचरः।",
          "स परिव्राजकच्छद्म महाकायो विहाय तत्॥८॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-49",
    "chapterName": "अरण्यकाण्ड, सर्ग 49",
    "verseNumber": 8
  },
  {
