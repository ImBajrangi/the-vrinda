    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "इत्युक्त्वा मैथिली वाक्यं प्रियाहाँ प्रियवादिनीम्॥ १५॥",
          "अभिगम्य सुदुष्टात्मा राक्षसः काममोहितः।",
          "जग्राह रावणः सीतां बुधः खे रोहिणीमिव॥ १६॥"
        ]
      }
    ],
