    "slug": "valmiki-ramayana-3-sarga-49-shlok-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "सीताया वचनं श्रुत्वा दशग्रीवः प्रतापवान्।",
          "हस्ते हस्तं समाहत्य चकार सुमहद् वपुः॥१॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-49",
    "chapterName": "अरण्यकाण्ड, सर्ग 49",
    "verseNumber": 1
  },
  {
