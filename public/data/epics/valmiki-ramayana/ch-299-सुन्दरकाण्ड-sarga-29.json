    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-5-sarga-29-shlok-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "तथागतां तां व्यथितामनिन्दितां व्यतीतहर्षां परिदीनमानसाम्।",
          "शुभां निमित्तानि शुभानि भेजिरे नरं श्रिया जुष्टमिवोपसेविनः॥१॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-29",
    "chapterName": "सुन्दरकाण्ड, सर्ग 29",
    "verseNumber": 1
  },
  {
