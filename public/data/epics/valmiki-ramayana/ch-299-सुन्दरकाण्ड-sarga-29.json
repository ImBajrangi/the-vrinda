    "slug": "valmiki-ramayana-5-sarga-29-shlok-3",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "भुजश्च चार्वञ्चितवृत्तपीनः परार्घ्यकालागुरुचन्दनार्हः।",
          "अनुत्तमेनाघ्युषितः प्रियेण चिरेण वामः समवेपताशु॥३॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-29",
    "chapterName": "सुन्दरकाण्ड, सर्ग 29",
    "verseNumber": 3
  },
