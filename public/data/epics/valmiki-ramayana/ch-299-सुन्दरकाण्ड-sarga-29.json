    "slug": "valmiki-ramayana-5-sarga-29-shlok-2",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "तस्याः शुभं वाममरालपक्ष्मराज्यावृतं कृष्णविशालशुक्लम्।",
          "प्रास्पन्दतैकं नयनं सुकेश्या मीनाहतं पद्ममिवाभिताम्रम्॥२॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-29",
    "chapterName": "सुन्दरकाण्ड, सर्ग 29",
    "verseNumber": 2
  },
  {
