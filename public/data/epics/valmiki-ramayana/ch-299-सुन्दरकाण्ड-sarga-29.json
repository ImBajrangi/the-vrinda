    "slug": "valmiki-ramayana-5-sarga-29-shlok-5",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "शुभं पुनर्हेमसमानवर्ण मीषद्रजोध्वस्तमिवातुलाक्ष्याः।",
          "वासः स्थितायाः शिखराग्रदन्त्याः किंचित् परिसंसत चारुगात्र्याः॥५॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-29",
    "chapterName": "सुन्दरकाण्ड, सर्ग 29",
    "verseNumber": 5
  },
