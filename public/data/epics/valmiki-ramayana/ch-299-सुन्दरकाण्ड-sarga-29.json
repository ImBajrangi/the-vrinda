    "slug": "valmiki-ramayana-5-sarga-29-shlok-4",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "गजेन्द्रहस्तप्रतिमश्च पीनस्तयोर्द्वयोः संहतयोस्तु जातः।",
          "प्रस्पन्दमानः पुनरूरुरस्या रामं पुरस्तात् स्थितमाचचक्षे॥४॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-29",
    "chapterName": "सुन्दरकाण्ड, सर्ग 29",
    "verseNumber": 4
  },
  {
