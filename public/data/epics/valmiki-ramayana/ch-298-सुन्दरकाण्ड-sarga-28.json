    "index": 9854,
    "titleDevanagari": "वाल्मीकि रामायण, सुन्दरकाण्ड, सर्ग 28, श्लोक 11",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-5-sarga-28-shlok-11",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "हा राम सत्यव्रत दीर्घबाहो हा पूर्णचन्द्रप्रतिमानवकत्र।",
          "हा जीवलोकस्य हितः प्रियश्च वध्यां न मां वेत्सि हि राक्षसानाम्॥११॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-28",
    "chapterName": "सुन्दरकाण्ड, सर्ग 28",
    "verseNumber": 11
  },
  {
    "id": "valmiki-ramayana-5-sarga-28-shlok-12",
    "collectionId": "valmiki-ramayana",
    "index": 9855,
    "titleDevanagari": "वाल्मीकि रामायण, सुन्दरकाण्ड, सर्ग 28, श्लोक 12",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-5-sarga-28-shlok-12",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "अनन्यदेवत्वमियं क्षमा च भूमौ च शय्या नियमश्च धर्मे।",
          "पतिव्रतात्वं विफलं ममेदं कृतं कृतघ्नेष्विव मानुषाणाम्॥१२॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-28",
    "chapterName": "सुन्दरकाण्ड, सर्ग 28",
    "verseNumber": 12
  },
  {
    "id": "valmiki-ramayana-5-sarga-28-shlok-13",
    "collectionId": "valmiki-ramayana",
    "index": 9856,
    "titleDevanagari": "वाल्मीकि रामायण, सुन्दरकाण्ड, सर्ग 28, श्लोक 13",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-5-sarga-28-shlok-13",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "मोघो हि धर्मश्चरितो ममायं तथैकपत्नीत्वमिदं निरर्थकम्।",
          "या त्वां न पश्यामि कृशा विवर्णा हीना त्वया संगमने निराशा॥१३॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-28",
    "chapterName": "सुन्दरकाण्ड, सर्ग 28",
    "verseNumber": 13
  },
  {
    "id": "valmiki-ramayana-5-sarga-28-shlok-14",
    "collectionId": "valmiki-ramayana",
    "index": 9857,
    "titleDevanagari": "वाल्मीकि रामायण, सुन्दरकाण्ड, सर्ग 28, श्लोक 14",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-5-sarga-28-shlok-14",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "पितुर्निदेशं नियमेन कृत्वा वनान्निवृत्तश्चरितव्रतश्च।",
          "स्त्रीभिस्तु मन्ये विपुलेक्षणाभिः संरस्यसे वीतभयः कृतार्थः॥१४॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-28",
    "chapterName": "सुन्दरकाण्ड, सर्ग 28",
    "verseNumber": 14
  },
  {
    "id": "valmiki-ramayana-5-sarga-28-shlok-15",
    "collectionId": "valmiki-ramayana",
    "index": 9858,
    "titleDevanagari": "वाल्मीकि रामायण, सुन्दरकाण्ड, सर्ग 28, श्लोक 15",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-5-sarga-28-shlok-15",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "अहं तु राम त्वयि जातकामा चिरं विनाशाय निबद्धभावा।",
          "मोघं चरित्वाथ तपो व्रतं च त्यक्ष्यामि धिग्जीवितमल्पभाग्याम्॥१५॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-28",
    "chapterName": "सुन्दरकाण्ड, सर्ग 28",
    "verseNumber": 15
  },
  {
    "id": "valmiki-ramayana-5-sarga-28-shlok-16",
    "collectionId": "valmiki-ramayana",
    "index": 9859,
    "titleDevanagari": "वाल्मीकि रामायण, सुन्दरकाण्ड, सर्ग 28, श्लोक 16",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-5-sarga-28-shlok-16",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "संजीवितं क्षिप्रमहं त्यजेयं विषेण शस्त्रेण शितेन वापि।",
          "विषस्य दाता न तु मेऽस्ति कश्चिच्छस्त्रस्य वा वेश्मनि राक्षसस्य॥१६॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-28",
    "chapterName": "सुन्दरकाण्ड, सर्ग 28",
    "verseNumber": 16
  },
  {
    "id": "valmiki-ramayana-5-sarga-28-shlok-17",
    "collectionId": "valmiki-ramayana",
    "index": 9860,
    "titleDevanagari": "वाल्मीकि रामायण, सुन्दरकाण्ड, सर्ग 28, श्लोक 17",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-5-sarga-28-shlok-17",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "शोकाभितप्ता बहुधा विचिन्त्य सीताथ वेणीग्रथनं गृहीत्वा।",
          "उद्बद्ध्य वेण्युद्ग्रथनेन शीघ्रमहं गमिष्यामि यमस्य मूलम्॥१७॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-28",
    "chapterName": "सुन्दरकाण्ड, सर्ग 28",
    "verseNumber": 17
  },
  {
    "id": "valmiki-ramayana-5-sarga-28-shlok-19",
    "collectionId": "valmiki-ramayana",
    "index": 9861,
    "titleDevanagari": "वाल्मीकि रामायण, सुन्दरकाण्ड, सर्ग 28, श्लोक 19",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-5-sarga-28-shlok-19",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "उपस्थिता सा मृदुसर्वगात्री शाखां गृहीत्वा च नगस्य तस्य।",
          "तस्यास्तु रामं परिचिन्तयन्त्या रामानुजं स्वं च कुलं शुभांगयाः॥१८॥",
          "तस्या विशोकानि तदा बहूनि धैर्यार्जितानि प्रवराणि लोके।",
          "प्रादुर्निमित्तानि तदा बभूवुः पुरापि सिद्धान्युपलक्षितानि॥१९॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-28",
    "chapterName": "सुन्दरकाण्ड, सर्ग 28",
    "verseNumber": 19
  },
