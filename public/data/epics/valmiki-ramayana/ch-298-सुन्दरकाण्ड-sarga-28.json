[
  {
    "id": "valmiki-ramayana-5-sarga-28-shlok-1",
    "collectionId": "valmiki-ramayana",
    "index": 9844,
    "titleDevanagari": "वाल्मीकि रामायण, सुन्दरकाण्ड, सर्ग 28, श्लोक 1",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-5-sarga-28-shlok-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "सा राक्षसेन्द्रस्य वचो निशम्य तद् रावणस्याप्रियमप्रियार्ता।",
          "सीता वितत्रास यथा वनान्ते सिंहाभिपन्ना गजराजकन्या॥१॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-28",
    "chapterName": "सुन्दरकाण्ड, सर्ग 28",
    "verseNumber": 1
  },
  {
    "id": "valmiki-ramayana-5-sarga-28-shlok-2",
    "collectionId": "valmiki-ramayana",
    "index": 9845,
    "titleDevanagari": "वाल्मीकि रामायण, सुन्दरकाण्ड, सर्ग 28, श्लोक 2",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-5-sarga-28-shlok-2",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "सा राक्षसीमध्यगता च भीरुर्वाग्भिर्भृशं रावणतर्जिता च।",
          "कान्तारमध्ये विजने विसृष्टा बालेव कन्या विललाप सीता॥२॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-28",
    "chapterName": "सुन्दरकाण्ड, सर्ग 28",
    "verseNumber": 2
  },
  {
    "id": "valmiki-ramayana-5-sarga-28-shlok-3",
    "collectionId": "valmiki-ramayana",
    "index": 9846,
    "titleDevanagari": "वाल्मीकि रामायण, सुन्दरकाण्ड, सर्ग 28, श्लोक 3",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-5-sarga-28-shlok-3",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "सत्यं बतेदं प्रवदन्ति लोके नाकालमृत्युर्भवतीति सन्तः।",
          "यत्राहमेवं परिभय॑माना जीवामि यस्मात् क्षणमप्यपुण्या॥३॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-28",
    "chapterName": "सुन्दरकाण्ड, सर्ग 28",
    "verseNumber": 3
  },
  {
    "id": "valmiki-ramayana-5-sarga-28-shlok-4",
    "collectionId": "valmiki-ramayana",
    "index": 9847,
    "titleDevanagari": "वाल्मीकि रामायण, सुन्दरकाण्ड, सर्ग 28, श्लोक 4",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-5-sarga-28-shlok-4",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "सुखाद् विहीनं बहुदुःखपूर्णमिदं तु नूनं हृदयं स्थिरं मे।",
          "विदीर्यते यन्न सहस्रधाद्य वज्राहतं श्रृंगमिवाचलस्य॥४॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-28",
    "chapterName": "सुन्दरकाण्ड, सर्ग 28",
    "verseNumber": 4
  },
  {
    "id": "valmiki-ramayana-5-sarga-28-shlok-5",
    "collectionId": "valmiki-ramayana",
    "index": 9848,
    "titleDevanagari": "वाल्मीकि रामायण, सुन्दरकाण्ड, सर्ग 28, श्लोक 5",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-5-sarga-28-shlok-5",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "नैवास्ति नूनं मम दोषमत्र वध्याहमस्याप्रियदर्शनस्य।",
          "भावं न चास्याहमनुप्रदातुमलं द्विजो मन्त्रमिवाद्विजाय॥५॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-28",
    "chapterName": "सुन्दरकाण्ड, सर्ग 28",
    "verseNumber": 5
  },
  {
    "id": "valmiki-ramayana-5-sarga-28-shlok-6",
    "collectionId": "valmiki-ramayana",
    "index": 9849,
    "titleDevanagari": "वाल्मीकि रामायण, सुन्दरकाण्ड, सर्ग 28, श्लोक 6",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-5-sarga-28-shlok-6",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "तस्मिन्ननागच्छति लोकनाथे गर्भस्थजन्तोरिव शल्यकृन्तः।",
          "नूनं ममांगान्यचिरादनार्यः शस्त्रैः शितैश्छेत्स्यति राक्षसेन्द्रः॥६॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-28",
    "chapterName": "सुन्दरकाण्ड, सर्ग 28",
    "verseNumber": 6
  },
  {
    "id": "valmiki-ramayana-5-sarga-28-shlok-7",
    "collectionId": "valmiki-ramayana",
    "index": 9850,
    "titleDevanagari": "वाल्मीकि रामायण, सुन्दरकाण्ड, सर्ग 28, श्लोक 7",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-5-sarga-28-shlok-7",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "दुःखं बतेदं ननु दुःखिताया मासौ चिरायाभिगमिष्यतो द्रौ।",
          "बद्धस्य वध्यस्य यथा निशान्ते राजोपरोधादिव तस्करस्य॥७॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-28",
    "chapterName": "सुन्दरकाण्ड, सर्ग 28",
    "verseNumber": 7
  },
  {
    "id": "valmiki-ramayana-5-sarga-28-shlok-8",
    "collectionId": "valmiki-ramayana",
    "index": 9851,
    "titleDevanagari": "वाल्मीकि रामायण, सुन्दरकाण्ड, सर्ग 28, श्लोक 8",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-5-sarga-28-shlok-8",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "हा राम हा लक्ष्मण हा सुमित्रे हा राममातः सह मे जनन्यः।",
          "एषा विपद्याम्यहमल्पभाग्या महार्णवे नौरिव मूढवाता॥८॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-28",
    "chapterName": "सुन्दरकाण्ड, सर्ग 28",
    "verseNumber": 8
  },
  {
    "id": "valmiki-ramayana-5-sarga-28-shlok-9",
    "collectionId": "valmiki-ramayana",
    "index": 9852,
    "titleDevanagari": "वाल्मीकि रामायण, सुन्दरकाण्ड, सर्ग 28, श्लोक 9",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-5-sarga-28-shlok-9",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "तरस्विनौ धारयता मृगस्य सत्त्वेन रूपं मनुजेन्द्रपुत्रौ।",
          "नूनं विशस्तौ मम कारणात् तौ सिंहर्षभौ द्वाविव वैद्युतेन॥९॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-28",
    "chapterName": "सुन्दरकाण्ड, सर्ग 28",
    "verseNumber": 9
  },
  {
    "id": "valmiki-ramayana-5-sarga-28-shlok-10",
    "collectionId": "valmiki-ramayana",
    "index": 9853,
    "titleDevanagari": "वाल्मीकि रामायण, सुन्दरकाण्ड, सर्ग 28, श्लोक 10",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-5-sarga-28-shlok-10",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "नूनं स कालो मृगरूपधारी मामल्पभाग्यां लुलुभे तदानीम्।",
          "यत्रार्यपुत्रौ विससर्ज मूढा रामानुजं लक्ष्मणपूर्वजं च॥१०॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-28",
    "chapterName": "सुन्दरकाण्ड, सर्ग 28",
    "verseNumber": 10
  },
  {
    "id": "valmiki-ramayana-5-sarga-28-shlok-11",
