    "titleDevanagari": "वाल्मीकि रामायण, अरण्यकाण्ड, सर्ग 57, श्लोक 1",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-57-shlok-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "राक्षसं मृगरूपेण चरन्तं कामरूपिणम्।",
          "निहत्य रामो मारीचं तूर्णं पथि न्यवर्तत॥१॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-57",
    "chapterName": "अरण्यकाण्ड, सर्ग 57",
    "verseNumber": 1
  },
  {
    "id": "valmiki-ramayana-3-sarga-57-shlok-2",
    "collectionId": "valmiki-ramayana",
