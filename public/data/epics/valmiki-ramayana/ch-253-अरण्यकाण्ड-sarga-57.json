    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-57-shlok-13",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "तानि दृष्ट्वा निमित्तानि महाघोराणि राघवः।",
          "न्यवर्तताथ त्वरितो जवेनाश्रममात्मनः॥१३॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-57",
    "chapterName": "अरण्यकाण्ड, सर्ग 57",
    "verseNumber": 13
  },
  {
    "id": "valmiki-ramayana-3-sarga-57-shlok-14",
    "collectionId": "valmiki-ramayana",
    "index": 8329,
    "titleDevanagari": "वाल्मीकि रामायण, अरण्यकाण्ड, सर्ग 57, श्लोक 14",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-57-shlok-14",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "ततो लक्ष्मणमायान्तं ददर्श विगतप्रभम्।",
          "ततोऽविदूरे रामेण समीयाय स लक्ष्मणः॥१४॥",
          "विषण्णः सन् विषण्णेन दुःखितो दुःखभागिना।",
          "स जगहेऽथ तं भ्राता दृष्ट्वा लक्ष्मणमागतम्॥",
          "विहाय सीतां विजने वने राक्षससेविते।"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-57",
    "chapterName": "अरण्यकाण्ड, सर्ग 57",
    "verseNumber": 14
  },
  {
    "id": "valmiki-ramayana-3-sarga-57-shlok-16",
    "collectionId": "valmiki-ramayana",
    "index": 8330,
    "titleDevanagari": "वाल्मीकि रामायण, अरण्यकाण्ड, सर्ग 57, श्लोक 16",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-57-shlok-16",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "गृहीत्वा च करं सव्यं लक्ष्मणं रघुनन्दनः॥१६॥",
          "उवाच मधुरोदर्कमिदं परुषमार्तवत्।",
          "अहो लक्ष्मण गडं ते कृतं यत् त्वं विहाय ताम्॥ १७॥",
          "सीतामिहागतः सौम्य कच्चित् स्वस्ति भवेदिति।",
          "न मेऽस्ति संशयो वीर सर्वथा जनकात्मजा॥ १८॥",
          "विनष्टा भक्षिता वापि राक्षसैर्वनचारिभिः।"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-57",
    "chapterName": "अरण्यकाण्ड, सर्ग 57",
    "verseNumber": 16
  },
