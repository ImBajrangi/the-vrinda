    "index": 8323,
    "titleDevanagari": "वाल्मीकि रामायण, अरण्यकाण्ड, सर्ग 57, श्लोक 6",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-57-shlok-6",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "स सौमित्रिः स्वरं श्रुत्वा तां च हित्वाथ मैथिलीम्।",
          "तयैव प्रहितः क्षिप्रं मत्सकाशमिहैष्यति॥६॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-57",
    "chapterName": "अरण्यकाण्ड, सर्ग 57",
    "verseNumber": 6
  },
  {
    "id": "valmiki-ramayana-3-sarga-57-shlok-8",
    "collectionId": "valmiki-ramayana",
    "index": 8324,
    "titleDevanagari": "वाल्मीकि रामायण, अरण्यकाण्ड, सर्ग 57, श्लोक 8",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-57-shlok-8",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "राक्षसैः सहितैनूनं सीताया ईप्सितो वधः।",
          "काञ्चनश्च मृगो भूत्वा व्यपनीयाश्रमात्तु माम्॥ ७॥",
          "दूरं नीत्वाथ मारीचो राक्षसोऽभूच्छराहतः।",
          "हा लक्ष्मण हतोऽस्मीति यदाक्यं व्याजहार ह॥ ८॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-57",
    "chapterName": "अरण्यकाण्ड, सर्ग 57",
    "verseNumber": 8
  },
  {
    "id": "valmiki-ramayana-3-sarga-57-shlok-9",
    "collectionId": "valmiki-ramayana",
    "index": 8325,
    "titleDevanagari": "वाल्मीकि रामायण, अरण्यकाण्ड, सर्ग 57, श्लोक 9",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-57-shlok-9",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "अपि स्वस्ति भवेद् द्वाभ्यां रहिताभ्यां मया वने।",
          "जनस्थाननिमित्तं हि कृतवैरोऽस्मि राक्षसैः॥९॥",
          "निमित्तानि च घोराणि दृश्यन्तेऽद्य बहूनि च।",
          "इत्येवं चिन्तयन् रामः श्रुत्वा गोमायुनिःस्वनम्॥ १०॥",
          "निवर्तमानस्त्वरितो जगामाश्रममात्मवान्।"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-57",
    "chapterName": "अरण्यकाण्ड, सर्ग 57",
    "verseNumber": 9
  },
  {
