    "slug": "valmiki-ramayana-3-sarga-57-shlok-20",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "अशुभान्येव भूयिष्ठं यथा प्रादुर्भवन्ति मे ॥१९॥",
          "अपि लक्ष्मण सीतायाः सामग्रयं प्राप्नुयामहे।",
          "जीवन्त्याः पुरुषव्याघ्र सुताया जनकस्य वै॥ २०॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-57",
    "chapterName": "अरण्यकाण्ड, सर्ग 57",
    "verseNumber": 20
  },
