    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-57-shlok-12",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "तं दीनमानसं दीनमासेदुर्मृगपक्षिणः॥१२॥",
          "सव्यं कृत्वा महात्मानं घोरांश्च ससृजुः स्वरान्।"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-57",
    "chapterName": "अरण्यकाण्ड, सर्ग 57",
    "verseNumber": 12
  },
