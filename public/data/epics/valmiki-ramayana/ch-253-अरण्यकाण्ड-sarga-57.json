    "titleDevanagari": "वाल्मीकि रामायण, अरण्यकाण्ड, सर्ग 57, श्लोक 2",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-57-shlok-2",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "तस्य संत्वरमाणस्य द्रष्टकामस्य मैथिलीम्।",
          "क्रूरस्वनोऽथ गोमायुर्विननादास्य पृष्ठतः॥२॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-57",
    "chapterName": "अरण्यकाण्ड, सर्ग 57",
    "verseNumber": 2
  },
  {
    "id": "valmiki-ramayana-3-sarga-57-shlok-3",
    "collectionId": "valmiki-ramayana",
    "index": 8320,
    "titleDevanagari": "वाल्मीकि रामायण, अरण्यकाण्ड, सर्ग 57, श्लोक 3",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-57-shlok-3",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "स तस्य स्वरमाज्ञाय दारुणं रोमहर्षणम्।",
          "चिन्तयामास गोमायोः स्वरेण परिशङ्कितः॥३॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-57",
    "chapterName": "अरण्यकाण्ड, सर्ग 57",
    "verseNumber": 3
  },
  {
    "id": "valmiki-ramayana-3-sarga-57-shlok-4",
    "collectionId": "valmiki-ramayana",
