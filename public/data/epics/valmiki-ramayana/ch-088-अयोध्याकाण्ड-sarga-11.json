        "linesDevanagari": [
          "तामुवाच महाराजः कैकेयीमीषदुत्स्मयः।",
          "कामी हस्तेन संगृह्य मूर्धजेषु भुवि स्थिताम्॥४॥"
        ]
      }
    ],
    "chapterId": "अयोध्याकाण्ड-sarga-11",
    "chapterName": "अयोध्याकाण्ड, सर्ग 11",
    "verseNumber": 4
  },
