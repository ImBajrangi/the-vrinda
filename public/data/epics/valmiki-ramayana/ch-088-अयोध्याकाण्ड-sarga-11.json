        "stanzaNumber": 1,
        "linesDevanagari": [
          "अवलिप्ते न जानासि त्वत्तः प्रियतरो मम।",
          "मनुजो मनुजव्याघ्राद् रामादन्यो न विद्यते॥५॥"
        ]
      }
    ],
    "chapterId": "अयोध्याकाण्ड-sarga-11",
    "chapterName": "अयोध्याकाण्ड, सर्ग 11",
    "verseNumber": 5
  },
  {
