    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "तं मन्मथशरैर्विद्धं कामवेगवशानुगम्।",
          "उवाच पृथिवीपालं कैकेयी दारुणं वचः॥१॥"
        ]
      }
    ],
    "chapterId": "अयोध्याकाण्ड-sarga-11",
    "chapterName": "अयोध्याकाण्ड, सर्ग 11",
    "verseNumber": 1
  },
  {
