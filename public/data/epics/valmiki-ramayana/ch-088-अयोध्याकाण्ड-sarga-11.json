        "stanzaNumber": 1,
        "linesDevanagari": [
          "तेनाजय्येन मुख्येन राघवेण महात्मना।",
          "शपे ते जीवनाण ब्रूहि यन्मनसेप्सितम्॥६॥"
        ]
      }
    ],
    "chapterId": "अयोध्याकाण्ड-sarga-11",
    "chapterName": "अयोध्याकाण्ड, सर्ग 11",
    "verseNumber": 6
  },
  {
    "id": "valmiki-ramayana-2-sarga-11-shlok-7",
