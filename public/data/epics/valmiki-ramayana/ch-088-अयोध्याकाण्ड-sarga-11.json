    "slug": "valmiki-ramayana-2-sarga-11-shlok-2",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "नास्मि विप्रकृता देव केनचिन्नावमानिता।",
          "अभिप्रायस्तु मे कश्चित् तमिच्छामि त्वया कृतम्॥२॥"
        ]
      }
    ],
    "chapterId": "अयोध्याकाण्ड-sarga-11",
    "chapterName": "अयोध्याकाण्ड, सर्ग 11",
    "verseNumber": 2
  },
  {
