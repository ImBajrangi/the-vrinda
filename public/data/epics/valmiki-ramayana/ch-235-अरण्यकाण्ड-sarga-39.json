    "slug": "valmiki-ramayana-3-sarga-39-shlok-5",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "निहत्य दण्डकारण्ये तापसान् धर्मचारिणः।",
          "रुधिराणि पिबंस्तेषां तन्मांसानि च भक्षयन् ॥५॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-39",
    "chapterName": "अरण्यकाण्ड, सर्ग 39",
    "verseNumber": 5
  },
  {
