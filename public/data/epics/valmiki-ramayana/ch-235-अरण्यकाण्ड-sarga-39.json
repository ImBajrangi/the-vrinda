    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-39-shlok-12",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "ते बाणा वज्रसंकाशाः सुघोरा रक्तभोजनाः।",
          "आजग्मुः सहिताः सर्वे त्रयः संनतपर्वणः॥१२॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-39",
    "chapterName": "अरण्यकाण्ड, सर्ग 39",
    "verseNumber": 12
