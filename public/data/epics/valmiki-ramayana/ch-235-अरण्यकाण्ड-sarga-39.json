    "slug": "valmiki-ramayana-3-sarga-39-shlok-6",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "ऋषिमांसाशनः क्रूरस्त्रासयन् वनगोचरान्।",
          "तदा रुधिरमत्तोऽहं व्यचरं दण्डकावनम्॥६॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-39",
    "chapterName": "अरण्यकाण्ड, सर्ग 39",
    "verseNumber": 6
  },
  {
    "id": "valmiki-ramayana-3-sarga-39-shlok-8",
