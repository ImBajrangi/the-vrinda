    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-39-shlok-8",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "तदाहं दण्डकारण्ये विचरन् धर्मदूषकः।",
          "आसादयं तदा रामं तापसं धर्ममाश्रितम्॥७॥",
          "वैदेहीं च महाभागां लक्ष्मणं च महारथम्।",
          "तापसं नियताहारं सर्वभूतहिते रतम्॥८॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-39",
    "chapterName": "अरण्यकाण्ड, सर्ग 39",
    "verseNumber": 8
  },
  {
    "id": "valmiki-ramayana-3-sarga-39-shlok-10",
    "collectionId": "valmiki-ramayana",
    "index": 7807,
    "titleDevanagari": "वाल्मीकि रामायण, अरण्यकाण्ड, सर्ग 39, श्लोक 10",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-39-shlok-10",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "सोऽहं वनगतं रामं परिभूय महाबलम्।",
          "तापसोऽयमिति ज्ञात्वा पूर्ववैरमनुस्मरन्॥९॥",
          "अभ्यधावं सुसंक्रुद्धस्तीक्ष्णशृङ्गो मृगाकृतिः।",
          "जिघांसुरकृतप्रज्ञस्तं प्रहारमनुस्मरन्॥१०॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-39",
    "chapterName": "अरण्यकाण्ड, सर्ग 39",
    "verseNumber": 10
  },
  {
