    "titleDevanagari": "वाल्मीकि रामायण, अरण्यकाण्ड, सर्ग 39, श्लोक 1",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-39-shlok-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "एवमस्मि तदा मुक्तः कथंचित् तेन संयुगे।",
          "इदानीमपि यद् वृत्तं तच्छृणुष्व यदुत्तरम्॥१॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-39",
    "chapterName": "अरण्यकाण्ड, सर्ग 39",
    "verseNumber": 1
  },
  {
    "id": "valmiki-ramayana-3-sarga-39-shlok-2",
    "collectionId": "valmiki-ramayana",
    "index": 7801,
    "titleDevanagari": "वाल्मीकि रामायण, अरण्यकाण्ड, सर्ग 39, श्लोक 2",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-39-shlok-2",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "राक्षसाभ्यामहं द्वाभ्यामनिर्विण्णस्तथाकृतः।",
          "सहितो मृगरूपाभ्यां प्रविष्टो दण्डकावने॥२॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-39",
    "chapterName": "अरण्यकाण्ड, सर्ग 39",
    "verseNumber": 2
  },
  {
    "id": "valmiki-ramayana-3-sarga-39-shlok-3",
