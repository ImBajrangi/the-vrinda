    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-39-shlok-11",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "तेन त्यक्तास्त्रयो बाणाः शिताः शत्रुनिबर्हणाः।",
          "विकृष्य सुमहच्चापं सुपर्णानिलतुल्यगाः ॥११॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-39",
    "chapterName": "अरण्यकाण्ड, सर्ग 39",
    "verseNumber": 11
