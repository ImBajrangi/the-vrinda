    "slug": "valmiki-ramayana-3-sarga-39-shlok-4",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "अग्निहोत्रेषु तीर्थेषु चैत्यवृक्षेषु रावण।",
          "अत्यन्तघोरो व्यचरंस्तापसांस्तान् प्रधर्षयन्॥४॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-39",
    "chapterName": "अरण्यकाण्ड, सर्ग 39",
    "verseNumber": 4
  },
  {
    "id": "valmiki-ramayana-3-sarga-39-shlok-5",
