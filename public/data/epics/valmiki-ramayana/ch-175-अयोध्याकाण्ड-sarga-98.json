    "index": 6141,
    "titleDevanagari": "वाल्मीकि रामायण, अयोध्याकाण्ड, सर्ग 98, श्लोक 4",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-2-sarga-98-shlok-4",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "गुहो ज्ञातिसहस्रेण शरचापासिपाणिना।",
          "समन्वेषतु काकुत्स्थावस्मिन् परिवृतः स्वयम्॥ ४॥",
          "अमात्यैः सह पौरैश्च गुरुभिश्च द्विजातिभिः।",
          "सह सर्वं चरिष्यामि पद्भ्यां परिवृतः स्वयम्॥"
        ]
      }
    ],
    "chapterId": "अयोध्याकाण्ड-sarga-98",
    "chapterName": "अयोध्याकाण्ड, सर्ग 98",
    "verseNumber": 4
  },
  {
    "id": "valmiki-ramayana-2-sarga-98-shlok-6",
