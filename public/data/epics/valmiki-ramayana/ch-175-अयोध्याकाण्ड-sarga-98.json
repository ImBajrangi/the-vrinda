    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-2-sarga-98-shlok-3",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "क्षिप्रं वनमिदं सौम्य नरसंधैः समन्ततः।",
          "लुब्धैश्च सहितैरेभिस्त्वमन्वेषितुमर्हसि ॥३॥"
        ]
      }
    ],
    "chapterId": "अयोध्याकाण्ड-sarga-98",
    "chapterName": "अयोध्याकाण्ड, सर्ग 98",
    "verseNumber": 3
  },
  {
    "id": "valmiki-ramayana-2-sarga-98-shlok-4",
