[
  {
    "id": "valmiki-ramayana-2-sarga-98-shlok-2",
    "collectionId": "valmiki-ramayana",
    "index": 6139,
    "titleDevanagari": "वाल्मीकि रामायण, अयोध्याकाण्ड, सर्ग 98, श्लोक 2",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-2-sarga-98-shlok-2",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "निवेश्य सेनां तु विभुः पद्भ्यां पादवतां वरः।",
          "अभिगन्तुं स काकुत्स्थमियेष गुरुवर्तकम्॥१॥",
          "निविष्टमात्रे सैन्ये तु यथोद्देशं विनीतवत्।",
          "भरतो भ्रातरं वाक्यं शत्रुघ्नमिदमब्रवीत्॥२॥"
        ]
      }
    ],
    "chapterId": "अयोध्याकाण्ड-sarga-98",
    "chapterName": "अयोध्याकाण्ड, सर्ग 98",
    "verseNumber": 2
  },
  {
    "id": "valmiki-ramayana-2-sarga-98-shlok-3",
