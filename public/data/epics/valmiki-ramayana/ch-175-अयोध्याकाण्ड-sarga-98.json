    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-2-sarga-98-shlok-6",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "यावन्न रामं द्रक्ष्यामि लक्ष्मणं वा महाबलम्।",
          "वैदेहीं वा महाभागां न मे शान्तिर्भविष्यति॥६॥"
        ]
      }
    ],
    "chapterId": "अयोध्याकाण्ड-sarga-98",
    "chapterName": "अयोध्याकाण्ड, सर्ग 98",
    "verseNumber": 6
  },
