    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "विस्फार्य च धनुर्घोरं शक्राशनिसमप्रभम्।",
          "वानराणामनीकानि प्राकिरच्छरवृष्टिभिः॥२॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-54",
    "chapterName": "युद्धकाण्ड, सर्ग 54",
    "verseNumber": 2
  },
  {
