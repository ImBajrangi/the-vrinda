    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-50-shlok-10",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "अथ राजा मुनिश्रेष्ठं कृताञ्जलिरभाषत॥१०॥",
          "आसने भगवानास्तां सहैभिर्मुनिपुंगवैः।"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-50",
    "chapterName": "बालकाण्ड, सर्ग 50",
    "verseNumber": 10
  },
