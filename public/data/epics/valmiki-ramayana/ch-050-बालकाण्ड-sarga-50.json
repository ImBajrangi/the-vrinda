    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "ततस्तद् बिलमासाद्य सुगन्धि दुरतिक्रमम्॥१०॥",
          "विस्मयव्यग्रमनसो बभूवुर्वानरर्षभाः।",
          "संजातपरिशङ्कास्ते तद् बिलं प्लवगोत्तमाः॥११॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-50",
    "chapterName": "बालकाण्ड, सर्ग 50",
    "verseNumber": 11
  },
  {
    "id": "valmiki-ramayana-1-sarga-50-shlok-12",
    "collectionId": "valmiki-ramayana",
    "index": 2278,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 50, श्लोक 12",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-50-shlok-12",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "अभ्यपद्यन्त संहृष्टास्तेजोवन्तो महाबलाः।",
          "नानासत्त्वसमाकीर्णं दैत्येन्द्रनिलयोपमम्॥१२॥",
          "दुर्दर्शमिव घोरं च दुर्विगाह्यं च सर्वशः।"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-50",
    "chapterName": "बालकाण्ड, सर्ग 50",
    "verseNumber": 12
  },
