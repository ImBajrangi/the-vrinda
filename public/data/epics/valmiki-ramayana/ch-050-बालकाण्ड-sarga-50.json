    "slug": "valmiki-ramayana-1-sarga-50-shlok-30",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "काञ्चनानि विमानानि राजतानि तथैव च॥३०॥",
          "तपनीयगवाक्षाणि मुक्ताजालावृतानि च।",
          "हैमराजतभौमानि वैदूर्यमणिमन्ति च ॥३१॥",
          "ददृशुस्तत्र हरयो गृहमुख्यानि सर्वशः।"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-50",
    "chapterName": "बालकाण्ड, सर्ग 50",
    "verseNumber": 30
  },
  {
    "id": "valmiki-ramayana-1-sarga-50-shlok-32",
