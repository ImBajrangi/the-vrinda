    "slug": "valmiki-ramayana-1-sarga-50-shlok-3",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "आसेदुस्तस्य शैलस्य कोटिं दक्षिणपश्चिमाम्।",
          "तेषां तत्रैव वसतां स कालो व्यत्यवर्तत ॥३॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-50",
    "chapterName": "बालकाण्ड, सर्ग 50",
    "verseNumber": 3
  },
  {
    "id": "valmiki-ramayana-1-sarga-50-shlok-4-1",
