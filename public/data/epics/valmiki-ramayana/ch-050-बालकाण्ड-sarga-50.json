    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-50-shlok-6",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "विश्वामित्रमनुप्राप्तं श्रुत्वा नृपवरस्तदा।",
          "शतानन्दं पुरस्कृत्य पुरोहितमनिन्दितः॥६॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-50",
    "chapterName": "बालकाण्ड, सर्ग 50",
    "verseNumber": 6
  },
  {
    "id": "valmiki-ramayana-1-sarga-50-shlok-7",
    "collectionId": "valmiki-ramayana",
    "index": 2273,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 50, श्लोक 7",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-50-shlok-7",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "परस्परेण रहिता अन्योन्यस्याविदूरतः।",
          "गजो गवाक्षो गवयः शरभो गन्धमादनः॥५॥",
          "मैन्दश्च द्विविदश्चैव हनूमान् जाम्बवानपि।",
          "अङ्गदो युवराजश्च तारश्च वनगोचरः॥६॥",
          "गिरिजालावृतान् देशान् मार्गित्वा दक्षिणां दिशम्।",
          "विचिन्वन्तस्ततस्तत्र ददृशुर्विवृतं बिलम्॥७॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-50",
    "chapterName": "बालकाण्ड, सर्ग 50",
    "verseNumber": 7
  },
  {
    "id": "valmiki-ramayana-1-sarga-50-shlok-8-1",
    "collectionId": "valmiki-ramayana",
    "index": 2274,
