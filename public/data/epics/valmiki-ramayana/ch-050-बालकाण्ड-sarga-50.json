    "slug": "valmiki-ramayana-1-sarga-50-shlok-8-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "दुर्गमृक्षबिलं नाम दानवेनाभिरक्षितम्।",
          "क्षुत्पिपासापरीतास्तु श्रान्तास्तु सलिलार्थिनः॥८॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-50",
    "chapterName": "बालकाण्ड, सर्ग 50",
    "verseNumber": 8
  },
  {
