    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-50-shlok-9",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "अवकीर्णं लतावृक्षर्ददृशुस्ते महाबिलम्।",
          "तत्र क्रौञ्चाश्च हंसाश्च सारसाश्चापि निष्क्रमन्॥९॥",
          "जलार्द्राश्चक्रवाकाश्च रक्ताङ्गाः पद्मरेणुभिः।"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-50",
    "chapterName": "बालकाण्ड, सर्ग 50",
    "verseNumber": 9
  },
  {
