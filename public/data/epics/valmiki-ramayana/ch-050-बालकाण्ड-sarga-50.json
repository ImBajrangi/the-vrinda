    "slug": "valmiki-ramayana-1-sarga-50-shlok-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "सह ताराङ्गदाभ्यां तु संगम्य हनुमान् कपिः।",
          "विचिनोति च विन्ध्यस्य गुहाश्च गहनानि च॥१॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-50",
    "chapterName": "बालकाण्ड, सर्ग 50",
    "verseNumber": 1
  },
  {
    "id": "valmiki-ramayana-1-sarga-50-shlok-2",
    "collectionId": "valmiki-ramayana",
    "index": 2268,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 50, श्लोक 2",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-50-shlok-2",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "सिंहशार्दूलजुष्टाश्च गुहाश्च परितस्तदा।",
          "विषमेषु नगेन्द्रस्य महाप्रस्रवणेषु च॥२॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-50",
    "chapterName": "बालकाण्ड, सर्ग 50",
    "verseNumber": 2
  },
  {
