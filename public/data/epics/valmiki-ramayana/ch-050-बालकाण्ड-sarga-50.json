    "slug": "valmiki-ramayana-1-sarga-50-shlok-4-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "स हि देशो दुरन्वेष्यो गुहागहनवान् महान्।",
          "तत्र वायुसुतः सर्वं विचिनोति स्म पर्वतम्॥४॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-50",
    "chapterName": "बालकाण्ड, सर्ग 50",
    "verseNumber": 4
  },
  {
    "id": "valmiki-ramayana-1-sarga-50-shlok-5",
    "collectionId": "valmiki-ramayana",
    "index": 2271,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 50, श्लोक 5",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-50-shlok-5",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "रामस्य वचनं श्रुत्वा विश्वामित्रो महामुनिः।",
          "निवासमकरोद देशे विविक्ते सलिलान्विते॥५॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-50",
    "chapterName": "बालकाण्ड, सर्ग 50",
    "verseNumber": 5
  },
  {
    "id": "valmiki-ramayana-1-sarga-50-shlok-6",
