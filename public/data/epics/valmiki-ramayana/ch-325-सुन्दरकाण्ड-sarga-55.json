    "slug": "valmiki-ramayana-5-sarga-55-shlok-3",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "धन्याः खलु महात्मानो ये बुद्ध्या कोपमुत्थितम्।",
          "निरुन्धन्ति महात्मानो दीप्तमग्निमिवाम्भसा॥३॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-55",
    "chapterName": "सुन्दरकाण्ड, सर्ग 55",
    "verseNumber": 3
  },
  {
