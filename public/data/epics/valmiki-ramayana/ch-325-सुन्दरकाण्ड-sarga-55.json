    "slug": "valmiki-ramayana-5-sarga-55-shlok-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "संदीप्यमानां वित्रस्तां त्रस्तरक्षोगणां पुरीम्।",
          "अवेक्ष्य हनुमाँल्लङ्कां चिन्तयामास वानरः॥१॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-55",
    "chapterName": "सुन्दरकाण्ड, सर्ग 55",
    "verseNumber": 1
  },
