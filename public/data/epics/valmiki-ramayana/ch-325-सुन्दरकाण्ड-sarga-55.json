    "slug": "valmiki-ramayana-5-sarga-55-shlok-2",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "तस्याभूत् सुमहांस्त्रासः कुत्सा चात्मन्यजायत।",
          "लङ्कां प्रदहता कर्म किंस्वित् कृतमिदं मया॥२॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-55",
    "chapterName": "सुन्दरकाण्ड, सर्ग 55",
    "verseNumber": 2
  },
