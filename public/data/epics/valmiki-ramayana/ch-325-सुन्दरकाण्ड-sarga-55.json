        "linesDevanagari": [
          "यः समुत्पतितं क्रोधं क्षमयैव निरस्यति।",
          "यथोरगस्त्वचं जीर्णां स वै पुरुष उच्यते॥६॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-55",
    "chapterName": "सुन्दरकाण्ड, सर्ग 55",
    "verseNumber": 6
  },
