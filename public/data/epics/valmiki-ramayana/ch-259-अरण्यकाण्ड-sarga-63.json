    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-63-shlok-10",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "तां हारपाशस्य सदोचितान्तां ग्रीवां प्रियाया मम सुव्रतायाः।",
          "रक्षांसि नूनं परिपीतवन्ति शून्ये हि भित्त्वा रुधिराशनानि॥१०॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-63",
    "chapterName": "अरण्यकाण्ड, सर्ग 63",
    "verseNumber": 10
  },
  {
