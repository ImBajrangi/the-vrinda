    "slug": "valmiki-ramayana-3-sarga-63-shlok-15",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "कामं त्विदं पुष्पितवृक्षषण्डं नानाविधैः पक्षिगणैरुपेतम्।",
          "वनं प्रयाता नु तदप्ययुक्तमेकाकिनी सातिबिभेति भीरुः॥१५॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-63",
    "chapterName": "अरण्यकाण्ड, सर्ग 63",
    "verseNumber": 15
  },
