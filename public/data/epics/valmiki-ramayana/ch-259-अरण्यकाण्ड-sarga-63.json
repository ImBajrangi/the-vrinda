    "slug": "valmiki-ramayana-3-sarga-63-shlok-8",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "तौ लोहितस्य प्रियदर्शनस्य सदोचितावुत्तमचन्दनस्य।",
          "वृत्तौ स्तनौ शोणितपङ्कदिग्धौ नूनं प्रियाया मम नाभिपातः॥८॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-63",
    "chapterName": "अरण्यकाण्ड, सर्ग 63",
    "verseNumber": 8
  },
  {
