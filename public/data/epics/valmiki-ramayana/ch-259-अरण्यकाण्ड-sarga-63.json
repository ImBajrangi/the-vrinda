    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-63-shlok-13",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "गोदावरीयं सरितां वरिष्ठा प्रिया प्रियाया मम नित्यकालम्।",
          "अप्यत्र गच्छेदिति चिन्तयामि नैकाकिनी याति हि सा कदाचित्॥१३॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-63",
    "chapterName": "अरण्यकाण्ड, सर्ग 63",
    "verseNumber": 13
  },
