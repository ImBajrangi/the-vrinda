    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-63-shlok-12",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "अस्मिन् मया सार्धमुदारशीला शिलातले पूर्वमुपोपविष्टा।",
          "कान्तस्मिता लक्ष्मण जातहासा त्वामाह सीता बहुवाक्यजातम्॥१२॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-63",
    "chapterName": "अरण्यकाण्ड, सर्ग 63",
    "verseNumber": 12
  },
  {
