    "titleDevanagari": "वाल्मीकि रामायण, अरण्यकाण्ड, सर्ग 63, श्लोक 1",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-63-shlok-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "स राजपुत्रः प्रियया विहीनः शोकेन मोहेन च पीड्यमानः।",
          "विषादयन् भ्रातरमार्तरूपो भूयो विषादं प्रविवेश तीव्रम्॥१॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-63",
    "chapterName": "अरण्यकाण्ड, सर्ग 63",
    "verseNumber": 1
  },
  {
    "id": "valmiki-ramayana-3-sarga-63-shlok-2",
    "collectionId": "valmiki-ramayana",
    "index": 8451,
    "titleDevanagari": "वाल्मीकि रामायण, अरण्यकाण्ड, सर्ग 63, श्लोक 2",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-63-shlok-2",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "स लक्ष्मणं शोकवशाभिपन्नं शोके निमग्नो विपुले तु रामः।",
          "उवाच वाक्यं व्यसनानुरूपमुष्णं विनिःश्वस्य रुदन् सशोकम्॥२॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-63",
    "chapterName": "अरण्यकाण्ड, सर्ग 63",
    "verseNumber": 2
  },
  {
    "id": "valmiki-ramayana-3-sarga-63-shlok-3",
    "collectionId": "valmiki-ramayana",
    "index": 8452,
    "titleDevanagari": "वाल्मीकि रामायण, अरण्यकाण्ड, सर्ग 63, श्लोक 3",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-63-shlok-3",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "न मद्विधो दुष्कृतकर्मकारी मन्ये द्वितीयोऽस्ति वसुंधरायाम्।",
          "शोकानुशोको हि परम्पराया मामेति भिन्दन् हृदयं मनश्च॥३॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-63",
    "chapterName": "अरण्यकाण्ड, सर्ग 63",
    "verseNumber": 3
  },
  {
    "id": "valmiki-ramayana-3-sarga-63-shlok-4",
    "collectionId": "valmiki-ramayana",
    "index": 8453,
    "titleDevanagari": "वाल्मीकि रामायण, अरण्यकाण्ड, सर्ग 63, श्लोक 4",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-63-shlok-4",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "पूर्वं मया नूनमभीप्सितानि पापानि कर्माण्यसकृत्कृतानि।",
          "तत्रायमद्यापतितो विपाको दुःखेन दुःखं यदहं विशामि॥४॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-63",
    "chapterName": "अरण्यकाण्ड, सर्ग 63",
    "verseNumber": 4
  },
  {
    "id": "valmiki-ramayana-3-sarga-63-shlok-5",
    "collectionId": "valmiki-ramayana",
    "index": 8454,
    "titleDevanagari": "वाल्मीकि रामायण, अरण्यकाण्ड, सर्ग 63, श्लोक 5",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-63-shlok-5",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "राज्यप्रणाशः स्वजनैर्वियोगः पितुर्विनाशो जननीवियोगः।",
          "सर्वाणि मे लक्ष्मण शोकवेग मापूरयन्ति प्रविचिन्तितानि॥५॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-63",
    "chapterName": "अरण्यकाण्ड, सर्ग 63",
    "verseNumber": 5
  },
  {
    "id": "valmiki-ramayana-3-sarga-63-shlok-6",
    "collectionId": "valmiki-ramayana",
    "index": 8455,
    "titleDevanagari": "वाल्मीकि रामायण, अरण्यकाण्ड, सर्ग 63, श्लोक 6",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-63-shlok-6",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "सर्वं तु दुःखं मम लक्ष्मणेदं शान्तं शरीरे वनमेत्य क्लेशम्।",
          "सीतावियोगात् पुनरप्युदीर्णं काष्ठरिवाग्निः सहसोपदीप्तः॥६॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-63",
    "chapterName": "अरण्यकाण्ड, सर्ग 63",
    "verseNumber": 6
  },
  {
    "id": "valmiki-ramayana-3-sarga-63-shlok-7",
    "collectionId": "valmiki-ramayana",
    "index": 8456,
    "titleDevanagari": "वाल्मीकि रामायण, अरण्यकाण्ड, सर्ग 63, श्लोक 7",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-63-shlok-7",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "सा नूनमार्या मम राक्षसेन ह्यभ्याहृता खं समुपेत्य भीरुः।",
          "अपस्वरं सुस्वरविप्रलापा भयेन विक्रन्दितवत्यभीक्ष्णम्॥७॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-63",
    "chapterName": "अरण्यकाण्ड, सर्ग 63",
    "verseNumber": 7
  },
  {
