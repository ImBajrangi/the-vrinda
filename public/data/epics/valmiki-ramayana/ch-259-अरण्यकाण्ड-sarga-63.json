    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "तच्छ्लक्ष्णसुव्यक्तमृदुप्रलापं तस्या मुखं कुञ्चितकेशभारम्।",
          "रक्षोवशं नूनमुपागताया न भ्राजते राहुमुखे यथेन्दुः॥९॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-63",
    "chapterName": "अरण्यकाण्ड, सर्ग 63",
    "verseNumber": 9
  },
  {
