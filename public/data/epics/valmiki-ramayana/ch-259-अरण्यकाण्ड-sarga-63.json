    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-63-shlok-14",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "पद्मानना पद्मपलाशनेत्रा पद्मानि वानेतुमभिप्रयाता।",
          "तदप्ययुक्तं नहि सा कदाचिन्मया विना गच्छति पङ्कजानि॥१४॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-63",
