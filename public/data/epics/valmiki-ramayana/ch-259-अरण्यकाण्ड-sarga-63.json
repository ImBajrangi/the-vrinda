    "slug": "valmiki-ramayana-3-sarga-63-shlok-19",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "शोकं विसृज्याद्य धृतिं भजस्व सोत्साहता चास्तु विमार्गणेऽस्याः।",
          "उत्साहवन्तो हि नरा न लोके सीदन्ति कर्मस्वतिदुष्करेषु॥१९॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-63",
    "chapterName": "अरण्यकाण्ड, सर्ग 63",
    "verseNumber": 19
  },
  {
    "id": "valmiki-ramayana-3-sarga-63-shlok-20",
