    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-63-shlok-16",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "आदित्य भो लोककृताकृतज्ञ लोकस्य सत्यानृतकर्मसाक्षिन्।",
          "मम प्रिया सा क्व गता हृता वा शंसस्व मे शोकहतस्य सर्वम्॥१६॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-63",
    "chapterName": "अरण्यकाण्ड, सर्ग 63",
    "verseNumber": 16
  },
