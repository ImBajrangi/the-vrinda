    "slug": "valmiki-ramayana-3-sarga-63-shlok-11",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "मया विहीना विजने वने सा रक्षोभिराहृत्य विकृष्यमाणा।",
          "नूनं विनादं कुररीव दीना सा मुक्तवत्यायतकान्तनेत्रा॥११॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-63",
    "chapterName": "अरण्यकाण्ड, सर्ग 63",
    "verseNumber": 11
  },
  {
