    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "तदवस्थं तु भरतं शत्रुघ्नोऽनन्तरस्थितः।",
          "परिष्वज्य रोदोच्चैर्विसंज्ञः शोककर्शितः॥५॥"
        ]
      }
    ],
    "chapterId": "अयोध्याकाण्ड-sarga-87",
    "chapterName": "अयोध्याकाण्ड, सर्ग 87",
    "verseNumber": 5
  },
