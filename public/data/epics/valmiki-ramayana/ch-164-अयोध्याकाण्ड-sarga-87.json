    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-2-sarga-87-shlok-4",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "भरतं मूर्च्छितं दृष्ट्वा विवर्णवदनो गुहः।",
          "बभूव व्यथितस्तत्र भूमिकम्पे यथा द्रुमः॥४॥"
        ]
      }
    ],
    "chapterId": "अयोध्याकाण्ड-sarga-87",
    "chapterName": "अयोध्याकाण्ड, सर्ग 87",
    "verseNumber": 4
  },
  {
