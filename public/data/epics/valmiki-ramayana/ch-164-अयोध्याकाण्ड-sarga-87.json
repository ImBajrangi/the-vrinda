    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-2-sarga-87-shlok-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "गुहस्य वचनं श्रुत्वा भरतो भृशमप्रियम्।",
          "ध्यानं जगाम तत्रैव यत्र तच्छ्रुतमप्रियम्॥१॥"
        ]
      }
    ],
    "chapterId": "अयोध्याकाण्ड-sarga-87",
    "chapterName": "अयोध्याकाण्ड, सर्ग 87",
    "verseNumber": 1
  },
  {
    "id": "valmiki-ramayana-2-sarga-87-shlok-3",
