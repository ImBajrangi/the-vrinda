    "slug": "valmiki-ramayana-3-sarga-43-shlok-6",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "चरन्तो मृगयां हृष्टाः पापेनोपाधिना वने।",
          "अनेन निहता राम राजानः कामरूपिणा॥६॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-43",
    "chapterName": "अरण्यकाण्ड, सर्ग 43",
    "verseNumber": 6
  },
  {
