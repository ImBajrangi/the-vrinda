    "titleDevanagari": "वाल्मीकि रामायण, अरण्यकाण्ड, सर्ग 43, श्लोक 2",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-43-shlok-2",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "सा तं सम्प्रेक्ष्य सुश्रोणी कुसुमानि विचिन्वती।",
          "हेमराजतवर्णाभ्यां पार्वाभ्यामुपशोभितम्॥१॥",
          "प्रहृष्टा चानवद्याङ्गी मृष्टहाटकवर्णिनी।।",
          "भर्तारमपि चक्रन्द लक्ष्मणं चैव सायुधम्॥२॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-43",
    "chapterName": "अरण्यकाण्ड, सर्ग 43",
    "verseNumber": 2
  },
  {
    "id": "valmiki-ramayana-3-sarga-43-shlok-3",
    "collectionId": "valmiki-ramayana",
    "index": 7896,
    "titleDevanagari": "वाल्मीकि रामायण, अरण्यकाण्ड, सर्ग 43, श्लोक 3",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-43-shlok-3",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "आहूयाहूय च पुनस्तं मृगं साधु वीक्षते।",
          "आगच्छागच्छ शीघ्रं वै आर्यपुत्र सहानुज॥३॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-43",
    "chapterName": "अरण्यकाण्ड, सर्ग 43",
    "verseNumber": 3
  },
  {
