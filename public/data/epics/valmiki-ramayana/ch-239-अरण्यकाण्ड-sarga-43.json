    "slug": "valmiki-ramayana-3-sarga-43-shlok-4",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "तावाहूतौ नरव्याघ्रौ वैदेह्या रामलक्ष्मणौ।",
          "वीक्षमाणौ तु तं देशं तदा ददृशतुगम्॥४॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-43",
    "chapterName": "अरण्यकाण्ड, सर्ग 43",
    "verseNumber": 4
  },
  {
