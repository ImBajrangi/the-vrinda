    "slug": "valmiki-ramayana-3-sarga-43-shlok-5",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "शङ्कमानस्तु तं दृष्ट्वा लक्ष्मणो वाक्यमब्रवीत्।",
          "तमेवैनमहं मन्ये मारीचं राक्षसं मृगम्॥५॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-43",
    "chapterName": "अरण्यकाण्ड, सर्ग 43",
    "verseNumber": 5
  },
  {
