    "slug": "valmiki-ramayana-3-sarga-43-shlok-7",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "अस्य मायाविदो माया मृगरूपमिदं कृतम्।",
          "भानुमत् पुरुषव्याघ्र गन्धर्वपुरसंनिभम्॥७॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-43",
    "chapterName": "अरण्यकाण्ड, सर्ग 43",
    "verseNumber": 7
  },
