        "stanzaNumber": 1,
        "linesDevanagari": [
          "मृगो ह्येवंविधो रत्नविचित्रो नास्ति राघव।",
          "जगत्यां जगतीनाथ मायैषा हि न संशयः॥८॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-43",
    "chapterName": "अरण्यकाण्ड, सर्ग 43",
