    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "आर्यपुत्राभिरामोऽसौ मृगो हरति मे मनः।।",
          "आनयैनं महाबाहो क्रीडार्थं नो भविष्यति॥१०॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-43",
    "chapterName": "अरण्यकाण्ड, सर्ग 43",
    "verseNumber": 10
