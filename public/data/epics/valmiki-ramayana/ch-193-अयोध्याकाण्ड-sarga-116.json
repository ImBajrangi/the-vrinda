    "slug": "valmiki-ramayana-2-sarga-116-shlok-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "प्रतियाते तु भरते वसन् रामस्तदा वने।",
          "लक्षयामास सोढेगमथौत्सुक्यं तपस्विनाम्॥१॥"
        ]
      }
    ],
    "chapterId": "अयोध्याकाण्ड-sarga-116",
    "chapterName": "अयोध्याकाण्ड, सर्ग 116",
    "verseNumber": 1
  },
  {
    "id": "valmiki-ramayana-2-sarga-116-shlok-2",
