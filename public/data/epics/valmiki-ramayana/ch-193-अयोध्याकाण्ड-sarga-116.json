        "linesDevanagari": [
          "तेषामौत्सुक्यमालक्ष्य रामस्त्वात्मनि शङ्कितः।",
          "कृताञ्जलिरुवाचेदमृषिं कुलपतिं ततः॥४॥"
        ]
      }
    ],
    "chapterId": "अयोध्याकाण्ड-sarga-116",
    "chapterName": "अयोध्याकाण्ड, सर्ग 116",
    "verseNumber": 4
  },
