    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "आपूर्यमाणं शश्वच्च तेजोबलपराक्रमैः।",
          "शशिनं शुक्लपक्षादौ वर्धमानमिव श्रिया॥३॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-54",
    "chapterName": "बालकाण्ड, सर्ग 54",
    "verseNumber": 3
  },
