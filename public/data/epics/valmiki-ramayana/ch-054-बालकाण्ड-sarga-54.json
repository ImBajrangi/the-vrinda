    "slug": "valmiki-ramayana-1-sarga-54-shlok-2-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "बुद्ध्या ह्यष्टाङ्गया युक्तं चतुर्बलसमन्वितम्।",
          "चतुर्दशगुणं मेने हनूमान् वालिनः सुतम्॥२॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-54",
    "chapterName": "बालकाण्ड, सर्ग 54",
    "verseNumber": 2
  },
  {
