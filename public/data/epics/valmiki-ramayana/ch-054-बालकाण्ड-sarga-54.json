    "slug": "valmiki-ramayana-1-sarga-54-shlok-1-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "तथा ब्रुवति तारे तु ताराधिपतिवर्चसि।",
          "अथ मेने हृतं राज्यं हनूमानङ्गदेन तत्॥१॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-54",
    "chapterName": "बालकाण्ड, सर्ग 54",
    "verseNumber": 1
  },
  {
