    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "एवमुक्तस्तु भरतो निषादाधिपतिं गुहम्।",
          "प्रत्युवाच महाप्राज्ञो वाक्यं हेत्वर्थसंहितम्॥१॥"
        ]
      }
    ],
    "chapterId": "अयोध्याकाण्ड-sarga-85",
    "chapterName": "अयोध्याकाण्ड, सर्ग 85",
    "verseNumber": 1
  },
  {
