    "slug": "valmiki-ramayana-2-sarga-85-shlok-2",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "ऊर्जितः खलु ते कामः कृतो मम गुरोः सखे।",
          "यो मे त्वमीदृशीं सेनामभ्यर्चयितुमिच्छसि॥२॥"
        ]
      }
    ],
    "chapterId": "अयोध्याकाण्ड-sarga-85",
