    "slug": "valmiki-ramayana-1-sarga-21-shlok-24",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "ततो हलहलाशब्दः सर्वदिग्भ्यः समुत्थितः॥२४॥",
          "धर्मराजस्य योधानां शूराणां सम्प्रधावताम्।"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-21",
    "chapterName": "बालकाण्ड, सर्ग 21",
    "verseNumber": 24
  },
