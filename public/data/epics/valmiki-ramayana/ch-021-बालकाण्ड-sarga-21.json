    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-21-shlok-9-2",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "तं देशं प्रभया तस्य पुष्पकस्य महाबलः।",
          "कृत्वा वितिमिरं सर्वं समीपमभ्यवर्तत॥९॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-21",
    "chapterName": "बालकाण्ड, सर्ग 21",
    "verseNumber": 9
  },
