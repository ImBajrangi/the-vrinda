    "slug": "valmiki-ramayana-1-sarga-21-shlok-11",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "संस्कार्यो हरिराजस्तु अङ्गदश्चाभिषिच्यताम्।",
          "सिंहासनगतं पुत्रं पश्यन्ती शान्तिमेष्यसि॥११॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-21",
    "chapterName": "बालकाण्ड, सर्ग 21",
    "verseNumber": 11
  },
  {
    "id": "valmiki-ramayana-1-sarga-21-shlok-12-2",
