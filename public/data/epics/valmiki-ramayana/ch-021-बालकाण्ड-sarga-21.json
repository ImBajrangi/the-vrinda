    "slug": "valmiki-ramayana-1-sarga-21-shlok-13",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "कृमिभिर्भक्ष्यमाणांश्च सारमेयैश्च दारुणैः।",
          "श्रोत्रायासकरा वाचो वदतश्च भयावहाः॥१३॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-21",
    "chapterName": "बालकाण्ड, सर्ग 21",
    "verseNumber": 13
  },
