    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "नह्येषा बुद्धिरास्थेया हनूमन्नङ्गदं प्रति।",
          "पिता हि बन्धुः पुत्रस्य न माता हरिसत्तम॥१५॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-21",
    "chapterName": "बालकाण्ड, सर्ग 21",
    "verseNumber": 15
