[
  {
    "id": "valmiki-ramayana-1-sarga-21-shlok-1-1",
    "collectionId": "valmiki-ramayana",
    "index": 1017,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 21, श्लोक 1",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-21-shlok-1-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "एवं संचिन्त्य विप्रेन्द्रो जगाम लघुविक्रमः।",
          "आख्यातुं तद् यथावृत्तं यमस्य सदनं प्रति॥१॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-21",
    "chapterName": "बालकाण्ड, सर्ग 21",
    "verseNumber": 1
  },
  {
    "id": "valmiki-ramayana-1-sarga-21-shlok-2-2",
    "collectionId": "valmiki-ramayana",
    "index": 1018,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 21, श्लोक 2",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-21-shlok-2-2",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "अपश्यत् स यमं तत्र देवमग्निपुरस्कृतम्।",
          "विधानमनुतिष्ठन्तं प्राणिनो यस्य यादृशम्॥२॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-21",
    "chapterName": "बालकाण्ड, सर्ग 21",
    "verseNumber": 2
  },
  {
    "id": "valmiki-ramayana-1-sarga-21-shlok-3-1",
    "collectionId": "valmiki-ramayana",
    "index": 1019,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 21, श्लोक 3",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-21-shlok-3-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "स तु दृष्ट्वा यमः प्राप्तं महर्षिं तत्र नारदम्।",
          "अब्रवीत् सुखमासीनमय॑मावेद्य धर्मतः॥३॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-21",
    "chapterName": "बालकाण्ड, सर्ग 21",
    "verseNumber": 3
  },
  {
    "id": "valmiki-ramayana-1-sarga-21-shlok-4-1",
    "collectionId": "valmiki-ramayana",
    "index": 1020,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 21, श्लोक 4",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-21-shlok-4-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "अङ्गदस्तु कुमारोऽयं द्रष्टव्यो जीवपुत्रया।",
          "आयत्यां च विधेयानि समर्थान्यस्य चिन्तय॥४॥",
          "जानास्यनियतामेवं भूतानामागतिं गतिम्।",
          "तस्माच्छभं हि कर्तव्यं पण्डिते नेह लौकिकम्॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-21",
    "chapterName": "बालकाण्ड, सर्ग 21",
    "verseNumber": 4
  },
  {
    "id": "valmiki-ramayana-1-sarga-21-shlok-5",
    "collectionId": "valmiki-ramayana",
    "index": 1021,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 21, श्लोक 5",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-21-shlok-5",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "त्रस्तरूपं तु विज्ञाय जगत् सर्वं महानृषिः।",
          "नृपतिं सुव्रतो धीरो वसिष्ठो वाक्यमब्रवीत्॥५॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-21",
    "chapterName": "बालकाण्ड, सर्ग 21",
    "verseNumber": 5
  },
  {
    "id": "valmiki-ramayana-1-sarga-21-shlok-6",
    "collectionId": "valmiki-ramayana",
    "index": 1022,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 21, श्लोक 6",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-21-shlok-6",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "अब्रवीत् तु तदा वाक्यं नारदो भगवानृषिः।",
          "श्रूयतामभिधास्यामि विधानं च विधीयताम्॥५॥",
          "एष नाम्ना दशग्रीवः पितृराज निशाचरः।",
          "उपयाति वशं नेतुं विक्रमैस्त्वां सुदुर्जयम्॥६॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-21",
    "chapterName": "बालकाण्ड, सर्ग 21",
    "verseNumber": 6
  },
  {
    "id": "valmiki-ramayana-1-sarga-21-shlok-7",
    "collectionId": "valmiki-ramayana",
    "index": 1023,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 21, श्लोक 7",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-21-shlok-7",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "एतेन कारणेनाहं त्वरितो ह्यागतः प्रभो।",
          "दण्डप्रहरणस्याद्य तव किं नु भविष्यति॥७॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-21",
    "chapterName": "बालकाण्ड, सर्ग 21",
    "verseNumber": 7
  },
  {
