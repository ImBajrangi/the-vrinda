    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-21-shlok-23",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "सुखमापुर्मुहूर्तं ते ह्यतर्कितमचिन्तितम्।",
          "प्रेतेषु मुच्यमानेषु राक्षसेन महीयसा॥२३॥",
          "प्रेतगोपाः सुसंक्रुद्धा राक्षसेन्द्रमभिद्रवन्।"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-21",
    "chapterName": "बालकाण्ड, सर्ग 21",
    "verseNumber": 23
  },
