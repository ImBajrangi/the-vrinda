    "slug": "valmiki-ramayana-1-sarga-21-shlok-10",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "सोऽपश्यत् स महाबाहुर्दशग्रीवस्ततस्ततः।",
          "प्राणिनः सुकृतं चैव भुञ्जानांश्चैव दुष्कृतम्॥१०॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-21",
    "chapterName": "बालकाण्ड, सर्ग 21",
    "verseNumber": 10
