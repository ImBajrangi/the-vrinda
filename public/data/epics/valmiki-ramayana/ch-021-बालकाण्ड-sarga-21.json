    "slug": "valmiki-ramayana-1-sarga-21-shlok-14",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "संतार्यमाणान् वैतरणीं बहुशः शोणितोदकाम्।",
          "वालुकासु च तप्तासु तप्यमानान् मुहुर्मुहुः॥१४॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-21",
    "chapterName": "बालकाण्ड, सर्ग 21",
    "verseNumber": 14
