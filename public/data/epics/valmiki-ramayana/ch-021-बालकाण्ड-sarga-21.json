    "slug": "valmiki-ramayana-1-sarga-21-shlok-16-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "नहि मम हरिराजसंश्रयात् क्षमतरमस्ति परत्र चेह वा।",
          "अभिमुखहतवीरसेवितं शयनमिदं मम सेवितुं क्षमम्॥१६॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-21",
    "chapterName": "बालकाण्ड, सर्ग 21",
