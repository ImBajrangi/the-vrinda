    "slug": "valmiki-ramayana-1-sarga-21-shlok-8",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "एतस्मिन्नन्तरे दूरादंशुमन्तमिवोदितम्।",
          "ददृशुर्दीप्तमायान्तं विमानं तस्य रक्षसः॥८॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-21",
    "chapterName": "बालकाण्ड, सर्ग 21",
    "verseNumber": 8
  },
  {
