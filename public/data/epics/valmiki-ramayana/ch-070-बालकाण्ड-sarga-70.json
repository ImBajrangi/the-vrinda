    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-70-shlok-20",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "अव्यक्तप्रभवो ब्रह्मा शाश्वतो नित्य अव्ययः॥",
          "तस्मान्मरीचिः संजज्ञे मरीचेः कश्यपः सुतः।",
          "विवस्वान् कश्यपाज्जज्ञे मनुर्वैवस्वतः स्मृतः॥ २०॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-70",
    "chapterName": "बालकाण्ड, सर्ग 70",
    "verseNumber": 20
  },
  {
