[
  {
    "id": "valmiki-ramayana-1-sarga-70-shlok-1",
    "collectionId": "valmiki-ramayana",
    "index": 2817,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 70, श्लोक 1",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-70-shlok-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "ततः प्रभाते जनकः कृतकर्मा महर्षिभिः ।",
          "उवाच वाक्यं वाक्यज्ञः शतानन्दं पुरोहितम्॥१॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-70",
    "chapterName": "बालकाण्ड, सर्ग 70",
    "verseNumber": 1
  },
  {
    "id": "valmiki-ramayana-1-sarga-70-shlok-4",
    "collectionId": "valmiki-ramayana",
    "index": 2818,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 70, श्लोक 4",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-70-shlok-4",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "तमहं द्रष्टुमिच्छामि यज्ञगोप्ता स मे मतः।",
          "प्रीतिं सोऽपि महातेजा इमां भोक्ता मया सह॥ ४॥",
          "एवमुक्ते तु वचने शतानन्दस्य संनिधौ।",
          "आगताः केचिदव्यग्रा जनकस्तान् समादिशत्॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-70",
    "chapterName": "बालकाण्ड, सर्ग 70",
    "verseNumber": 4
  },
  {
    "id": "valmiki-ramayana-1-sarga-70-shlok-6",
    "collectionId": "valmiki-ramayana",
    "index": 2819,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 70, श्लोक 6",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-70-shlok-6",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "शासनात् तु नरेन्द्रस्य प्रययुः शीघ्रवाजिभिः।",
          "समानेतुं नरव्याघ्रं विष्णुमिन्द्राज्ञया यथा॥६॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-70",
    "chapterName": "बालकाण्ड, सर्ग 70",
    "verseNumber": 6
  },
  {
    "id": "valmiki-ramayana-1-sarga-70-shlok-7",
    "collectionId": "valmiki-ramayana",
    "index": 2820,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 70, श्लोक 7",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-70-shlok-7",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "सांकाश्यां ते समागम्य ददृशुश्च कुशध्वजम्।",
          "न्यवेदयन् यथावृत्तं जनकस्य च चिन्तितम्॥७॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-70",
    "chapterName": "बालकाण्ड, सर्ग 70",
    "verseNumber": 7
  },
  {
    "id": "valmiki-ramayana-1-sarga-70-shlok-8",
    "collectionId": "valmiki-ramayana",
    "index": 2821,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 70, श्लोक 8",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-70-shlok-8",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "तवृत्तं नृपतिः श्रुत्वा दूतश्रेष्ठैर्महाजवैः।",
          "आज्ञया तु नरेन्द्रस्य आजगाम कुशध्वजः॥८॥",
          "स ददर्श महात्मानं जनकं धर्मवत्सलम्।",
          "सोऽभिवाद्य शतानन्दं जनकं चातिधार्मिकम्॥",
          "राजाहँ परमं दिव्यमासनं सोऽध्यरोहत।"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-70",
    "chapterName": "बालकाण्ड, सर्ग 70",
    "verseNumber": 8
  },
  {
    "id": "valmiki-ramayana-1-sarga-70-shlok-10",
    "collectionId": "valmiki-ramayana",
    "index": 2822,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 70, श्लोक 10",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-70-shlok-10",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "उपविष्टावुभौ तौ तु भ्रातरावमितद्युती॥१०॥",
          "प्रेषयामासतुर्वीरौ मन्त्रि श्रेष्ठं सुदामनम्।।",
          "गच्छ मन्त्रिपते शीघ्रमिक्ष्वाकुममितप्रभम्॥११॥",
          "आत्मजैः सह दुर्धर्षमानयस्व समन्त्रिणम्।",
          "औपकार्यां स गत्वा तु रघूणां कुलवर्धनम्॥ १२॥",
          "ददर्श शिरसा चैनमभिवाद्येदमब्रवीत्।"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-70",
    "chapterName": "बालकाण्ड, सर्ग 70",
    "verseNumber": 10
  },
  {
    "id": "valmiki-ramayana-1-sarga-70-shlok-13",
    "collectionId": "valmiki-ramayana",
    "index": 2823,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 70, श्लोक 13",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-70-shlok-13",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "अयोध्याधिपते वीर वैदेहो मिथिलाधिपः॥१३॥",
          "स त्वां द्रष्टं व्यवसितः सोपाध्यायपुरोहितम्।"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-70",
    "chapterName": "बालकाण्ड, सर्ग 70",
    "verseNumber": 13
  },
  {
    "id": "valmiki-ramayana-1-sarga-70-shlok-14",
    "collectionId": "valmiki-ramayana",
    "index": 2824,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 70, श्लोक 14",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-70-shlok-14",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "मन्त्रि श्रेष्ठवचः श्रुत्वा राजा सर्षिगणस्तथा॥१४॥",
          "सबन्धुरगमत् तत्र जनको यत्र वर्तते।",
          "राजा च मन्त्रिसहितः सोपाध्यायः सबान्धवः॥ १५॥",
          "वाक्यं वाक्यविदां श्रेष्ठो वैदेहमिदमब्रवीत्।"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-70",
    "chapterName": "बालकाण्ड, सर्ग 70",
    "verseNumber": 14
  },
  {
    "id": "valmiki-ramayana-1-sarga-70-shlok-16",
    "collectionId": "valmiki-ramayana",
    "index": 2825,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 70, श्लोक 16",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-70-shlok-16",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "विदितं ते महाराज इक्ष्वाकुकुलदैवतम्॥१६॥",
          "वक्ता सर्वेषु कृत्येषु वसिष्ठो भगवानृषिः।"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-70",
    "chapterName": "बालकाण्ड, सर्ग 70",
    "verseNumber": 16
  },
  {
    "id": "valmiki-ramayana-1-sarga-70-shlok-17",
    "collectionId": "valmiki-ramayana",
    "index": 2826,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 70, श्लोक 17",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-70-shlok-17",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "विश्वामित्राभ्यनुज्ञातः सह सर्वैर्महर्षिभिः॥१७॥",
          "एष वक्ष्यति धर्मात्मा वसिष्ठो मे यथाक्रमम्।"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-70",
    "chapterName": "बालकाण्ड, सर्ग 70",
    "verseNumber": 17
  },
  {
