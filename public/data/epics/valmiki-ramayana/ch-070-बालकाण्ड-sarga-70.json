    "slug": "valmiki-ramayana-1-sarga-70-shlok-26",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "मान्धातुस्तु सुतः श्रीमान् सुसन्धिरुदपद्यत।",
          "सुसन्धेरपि पुत्रौ द्वौ ध्रुवसन्धिः प्रसेनजित्॥२६॥"
        ]
      }
