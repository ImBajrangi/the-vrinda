    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-70-shlok-18",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "तूष्णीभूते दशरथे वसिष्ठो भगवानृषिः॥१८॥",
          "उवाच वाक्यं वाक्यज्ञो वैदेहं सपुरोधसम्।"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-70",
    "chapterName": "बालकाण्ड, सर्ग 70",
    "verseNumber": 18
  },
  {
    "id": "valmiki-ramayana-1-sarga-70-shlok-20",
