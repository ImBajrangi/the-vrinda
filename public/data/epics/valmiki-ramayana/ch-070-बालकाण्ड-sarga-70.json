    "slug": "valmiki-ramayana-1-sarga-70-shlok-22",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "इक्ष्वाकोस्तु सुतः श्रीमान् कुक्षिरित्येव विश्रुतः।",
          "कुक्षेरथात्मजः श्रीमान् विकक्षिरुदपद्यत॥२२॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-70",
    "chapterName": "बालकाण्ड, सर्ग 70",
    "verseNumber": 22
  },
  {
