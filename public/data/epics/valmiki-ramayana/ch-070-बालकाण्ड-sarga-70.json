    "slug": "valmiki-ramayana-1-sarga-70-shlok-21",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "मनुः प्रजापतिः पूर्वमिक्ष्वाकुश्च मनोः सुतः।",
          "तमिक्ष्वाकुमयोध्यायां राजानं विद्धि पूर्वकम्॥ २१॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-70",
    "chapterName": "बालकाण्ड, सर्ग 70",
    "verseNumber": 21
  },
  {
