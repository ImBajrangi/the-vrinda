    "slug": "valmiki-ramayana-1-sarga-70-shlok-23",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "विकुक्षेस्तु महातेजा बाणः पुत्रः प्रतापवान्।",
          "बाणस्य तु महातेजा अनरण्यः प्रतापवान्॥२३॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-70",
    "chapterName": "बालकाण्ड, सर्ग 70",
    "verseNumber": 23
  },
  {
