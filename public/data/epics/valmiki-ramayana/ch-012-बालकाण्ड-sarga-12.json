    "slug": "valmiki-ramayana-1-sarga-12-shlok-6-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "स मूर्ना न्यपतद् भूमौ प्रलम्बीकृतभूषणः।",
          "सुग्रीवः परमप्रीतो राघवाय कृताञ्जलिः॥६॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-12",
    "chapterName": "बालकाण्ड, सर्ग 12",
    "verseNumber": 6
  },
  {
    "id": "valmiki-ramayana-1-sarga-12-shlok-7",
