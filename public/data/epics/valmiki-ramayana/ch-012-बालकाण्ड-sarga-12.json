    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-12-shlok-11",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "भर्तारमनया सार्धमस्याः प्राप्तोऽस्मि मार्गितुम्।",
          "कन्यापितृत्वं दुःखं हि सर्वेषां मानकांक्षिणाम्॥११॥",
          "कन्या हि द्वे कुले नित्यं संशये स्थाप्य तिष्ठति।"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-12",
    "chapterName": "बालकाण्ड, सर्ग 12",
    "verseNumber": 11
  },
  {
