    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "मयस्तदाब्रवीद् राम पृच्छन्तं तं निशाचरम्॥५॥",
          "श्रूयतां सर्वमाख्यास्ये यथावृत्तमिदं तव।"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-12",
    "chapterName": "बालकाण्ड, सर्ग 12",
    "verseNumber": 5
  },
  {
