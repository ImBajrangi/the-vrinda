    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 12, श्लोक 1",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-12-shlok-1-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "एतच्च वचनं श्रुत्वा सुग्रीवस्य सुभाषितम्।",
          "प्रत्ययार्थं महातेजा रामो जग्राह कार्मुकम्॥१॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-12",
    "chapterName": "बालकाण्ड, सर्ग 12",
    "verseNumber": 1
  },
  {
    "id": "valmiki-ramayana-1-sarga-12-shlok-2-1",
    "collectionId": "valmiki-ramayana",
    "index": 616,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 12, श्लोक 2",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-12-shlok-2-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "स गृहीत्वा धनुर्घोरं शरमेकं च मानदः।",
          "सालमुद्दिश्य चिक्षेप पूरयन् स रवैर्दिशः॥२॥",
          "स विसृष्टो बलवता बाणः स्वर्णपरिष्कृतः।",
          "भित्त्वा सालान् गिरिप्रस्थं सप्तं भूमि विवेश ह॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-12",
    "chapterName": "बालकाण्ड, सर्ग 12",
    "verseNumber": 2
  },
  {
    "id": "valmiki-ramayana-1-sarga-12-shlok-3-1",
    "collectionId": "valmiki-ramayana",
    "index": 617,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 12, श्लोक 3",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-12-shlok-3-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "अथ दत्त्वा स्वयं रक्षो मृगयामटते स्म तत्।",
          "तत्रापश्यत् ततो राम मयं नाम दितेः सुतम्॥३॥",
          "कन्यासहायं तं दृष्ट्वा दशग्रीवो निशाचरः।",
          "अनया मृगशावाक्ष्या कमर्थं सह तिष्ठसि।"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-12",
    "chapterName": "बालकाण्ड, सर्ग 12",
    "verseNumber": 3
  },
  {
    "id": "valmiki-ramayana-1-sarga-12-shlok-4-1",
    "collectionId": "valmiki-ramayana",
    "index": 618,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 12, श्लोक 4",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-12-shlok-4-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "सायकस्तु मुहूर्तेन सालान् भित्त्वा महाजवः।",
          "निष्पत्य च पुनस्तूणं तमेव प्रविवेश ह॥४॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-12",
    "chapterName": "बालकाण्ड, सर्ग 12",
    "verseNumber": 4
  },
  {
