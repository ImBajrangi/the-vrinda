    "slug": "valmiki-ramayana-1-sarga-12-shlok-10-2",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "तस्माद् पुराद् दुहितरं गृहीत्वा वनमागतः।",
          "इयं ममात्मजा राजंस्तस्याः कुक्षौ विवर्धिता॥१०॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-12",
    "chapterName": "बालकाण्ड, सर्ग 12",
    "verseNumber": 10
  },
  {
