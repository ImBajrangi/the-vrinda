    "slug": "valmiki-ramayana-1-sarga-12-shlok-8-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "सेन्द्रानपि सुरान् सर्वांस्त्वं बाणैः पुरुषर्षभ।",
          "समर्थः समरे हन्तुं किं पुनर्वालिनं प्रभो॥८॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-12",
    "chapterName": "बालकाण्ड, सर्ग 12",
    "verseNumber": 8
  },
  {
    "id": "valmiki-ramayana-1-sarga-12-shlok-9-2",
    "collectionId": "valmiki-ramayana",
    "index": 623,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 12, श्लोक 9",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-12-shlok-9-2",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "हेमा नामाप्सरास्तात श्रुतपूर्वा यदि त्वया॥६॥",
          "दैवतैर्मम सा दत्ता पौलोमीव शतक्रतोः।",
          "तस्यां सक्तमना ह्यासं दशवर्षशतान्यहम्॥७॥",
          "सा च दैवतकार्येण गता वर्षाश्चतुर्दश।",
          "तस्याः कृते च हेमायाः सर्वं हेममयं पुरम्॥८॥",
          "वज्रवैदूर्यचित्रं च मायया निर्मितं मया।",
          "तत्राहमवसं दीनस्तया हीनः सुदुःखितः॥९॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-12",
    "chapterName": "बालकाण्ड, सर्ग 12",
    "verseNumber": 9
  },
  {
