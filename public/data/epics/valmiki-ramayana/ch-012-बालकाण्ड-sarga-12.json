    "slug": "valmiki-ramayana-1-sarga-12-shlok-14",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "सर्वे ते त्वरितं गत्वा किष्किन्धां वालिनः पुरीम्।",
          "वृक्षरात्मानमावृत्य ह्यतिष्ठन् गहने वने ॥१४॥"
        ]
      }
    ],
