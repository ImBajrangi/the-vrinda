    "slug": "valmiki-ramayana-1-sarga-12-shlok-7",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "इदं चोवाच धर्मज्ञं कर्मणा तेन हर्षितः।",
          "रामं सर्वास्त्रविदुषां श्रेष्ठं शूरमवस्थितम्॥७॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-12",
    "chapterName": "बालकाण्ड, सर्ग 12",
    "verseNumber": 7
  },
  {
