    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "हितबुद्ध्या यदहितं वचः परुषमुच्यते।",
          "परपक्षं प्रविश्यैव नैतच्छ्रोत्रगतं मम॥३॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-36",
    "chapterName": "युद्धकाण्ड, सर्ग 36",
    "verseNumber": 3
  },
