    "slug": "valmiki-ramayana-6-sarga-36-shlok-2",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "स बद्ध्वा भ्रुकुटिं वक्त्रे क्रोधस्य वशमागतः।",
          "अमर्षात् परिवृत्ताक्षो माल्यवन्तमथाब्रवीत्॥२॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-36",
    "chapterName": "युद्धकाण्ड, सर्ग 36",
    "verseNumber": 2
  },
  {
