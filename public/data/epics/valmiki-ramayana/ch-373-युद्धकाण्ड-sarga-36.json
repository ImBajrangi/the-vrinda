    "slug": "valmiki-ramayana-6-sarga-36-shlok-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "तत् तु माल्यवतो वाक्यं हितमुक्तं दशाननः।",
          "न मर्षयति दुष्टात्मा कालस्य वशमागतः॥१॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-36",
    "chapterName": "युद्धकाण्ड, सर्ग 36",
    "verseNumber": 1
  },
  {
