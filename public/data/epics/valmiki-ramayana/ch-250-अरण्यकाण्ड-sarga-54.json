    "slug": "valmiki-ramayana-3-sarga-54-shlok-5",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "स च पम्पामतिक्रम्य लङ्कामभिमुखः पुरीम्॥५॥",
          "जगाम मैथिलीं गृह्य रुदतीं राक्षसेश्वरः।।"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-54",
    "chapterName": "अरण्यकाण्ड, सर्ग 54",
    "verseNumber": 5
  },
