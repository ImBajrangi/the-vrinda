    "titleDevanagari": "वाल्मीकि रामायण, अरण्यकाण्ड, सर्ग 54, श्लोक 1",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-54-shlok-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "ह्रियमाणा तु वैदेही कंचिन्नाथमपश्यती।",
          "ददर्श गिरिशृङ्गस्थान् पञ्च वानरपुङ्गवान्॥१॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-54",
    "chapterName": "अरण्यकाण्ड, सर्ग 54",
    "verseNumber": 1
  },
  {
    "id": "valmiki-ramayana-3-sarga-54-shlok-3",
    "collectionId": "valmiki-ramayana",
    "index": 8234,
    "titleDevanagari": "वाल्मीकि रामायण, अरण्यकाण्ड, सर्ग 54, श्लोक 3",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-54-shlok-3",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "तेषां मध्ये विशालाक्षी कौशेयं कनकप्रभम्।",
          "उत्तरीयं वरारोहा शुभान्याभरणानि च॥२॥",
          "मुमोच यदि रामाय शंसेयुरिति भामिनी।",
          "वस्त्रमुत्सृज्य तन्मध्ये निक्षिप्तं सहभूषणम्॥३॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-54",
    "chapterName": "अरण्यकाण्ड, सर्ग 54",
    "verseNumber": 3
  },
  {
    "id": "valmiki-ramayana-3-sarga-54-shlok-4",
    "collectionId": "valmiki-ramayana",
    "index": 8235,
    "titleDevanagari": "वाल्मीकि रामायण, अरण्यकाण्ड, सर्ग 54, श्लोक 4",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-54-shlok-4",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "सम्भ्रमात् तु दशग्रीवस्तत्कर्म च न बुद्धवान्।",
          "पिङ्गाक्षास्तां विशालाक्षी नेत्रैरनिमिषैरिव॥४॥",
          "विक्रोशन्तीं तदा सीतां ददृशुर्वानरोत्तमाः।"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-54",
    "chapterName": "अरण्यकाण्ड, सर्ग 54",
    "verseNumber": 4
  },
  {
