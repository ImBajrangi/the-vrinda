        "stanzaNumber": 1,
        "linesDevanagari": [
          "यथा हि तव वै दैन्यं रूपं चाप्यतिमानुषम्।",
          "तपसा चान्वितो वेषस्त्वं राममहिषी ध्रुवम्॥१३॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-33",
    "chapterName": "सुन्दरकाण्ड, सर्ग 33",
    "verseNumber": 13
