        "stanzaNumber": 1,
        "linesDevanagari": [
          "रावणेन जनस्थानाद् बलात् प्रमथिता यदि।",
          "सीता त्वमसि भद्रं ते तन्ममाचक्ष्व पृच्छतः॥१२॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-33",
    "chapterName": "सुन्दरकाण्ड, सर्ग 33",
