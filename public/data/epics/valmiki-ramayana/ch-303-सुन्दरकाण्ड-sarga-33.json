    "slug": "valmiki-ramayana-5-sarga-33-shlok-4",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "द्रुमस्य शाखामालम्ब्य तिष्ठसि त्वमनिन्दिते॥३॥",
          "किमर्थं तव नेत्राभ्यां वारि स्रवति शोकजम्।",
          "पुण्डरीकपलाशाभ्यां विप्रकीर्णमिवोदकम्॥४॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-33",
    "chapterName": "सुन्दरकाण्ड, सर्ग 33",
    "verseNumber": 4
  },
