    "slug": "valmiki-ramayana-5-sarga-7-shlok-12",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "कृताश्च वैदूर्यमया विहङ्गा रूप्यप्रवालैश्च तथा विहङ्गाः।",
          "चित्राश्च नानावसुभिर्भुजङ्गा जात्यानुरूपास्तुरगाः शुभाङ्गाः॥१२॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-7",
    "chapterName": "सुन्दरकाण्ड, सर्ग 7",
    "verseNumber": 12
  },
