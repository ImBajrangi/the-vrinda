    "titleDevanagari": "वाल्मीकि रामायण, सुन्दरकाण्ड, सर्ग 7, श्लोक 1",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-5-sarga-7-shlok-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "स वेश्मजालं बलवान् ददर्श व्यासक्तवैदूर्यसुवर्णजालम्।",
          "यथा महत्प्रावृषि मेघजालं विद्युत्पिनद्धं सविहङ्गजालम्॥१॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-7",
    "chapterName": "सुन्दरकाण्ड, सर्ग 7",
    "verseNumber": 1
  },
  {
    "id": "valmiki-ramayana-5-sarga-7-shlok-2",
    "collectionId": "valmiki-ramayana",
    "index": 9167,
    "titleDevanagari": "वाल्मीकि रामायण, सुन्दरकाण्ड, सर्ग 7, श्लोक 2",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-5-sarga-7-shlok-2",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "निवेशनानां विविधाश्च शालाः प्रधानशङ्खायुधचापशालाः।",
          "मनोहराश्चापि पुनर्विशाला ददर्श वेश्माद्रिषु चन्द्रशालाः॥२॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-7",
    "chapterName": "सुन्दरकाण्ड, सर्ग 7",
    "verseNumber": 2
  },
  {
    "id": "valmiki-ramayana-5-sarga-7-shlok-3",
    "collectionId": "valmiki-ramayana",
    "index": 9168,
    "titleDevanagari": "वाल्मीकि रामायण, सुन्दरकाण्ड, सर्ग 7, श्लोक 3",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-5-sarga-7-shlok-3",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "गृहाणि नानावसुराजितानि देवासुरैश्चापि सुपूजितानि।",
          "सर्वैश्च दोषैः परिवर्जितानि कपिर्ददर्श स्वबलार्जितानि॥३॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-7",
    "chapterName": "सुन्दरकाण्ड, सर्ग 7",
    "verseNumber": 3
  },
  {
    "id": "valmiki-ramayana-5-sarga-7-shlok-4",
    "collectionId": "valmiki-ramayana",
    "index": 9169,
    "titleDevanagari": "वाल्मीकि रामायण, सुन्दरकाण्ड, सर्ग 7, श्लोक 4",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-5-sarga-7-shlok-4",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "तानि प्रयत्नाभिसमाहितानि मयेन साक्षादिव निर्मितानि।",
          "महीतले सर्वगुणोत्तराणि ददर्श लंकाधिपतेर्गृहाणि॥४॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-7",
    "chapterName": "सुन्दरकाण्ड, सर्ग 7",
    "verseNumber": 4
  },
  {
    "id": "valmiki-ramayana-5-sarga-7-shlok-5",
    "collectionId": "valmiki-ramayana",
    "index": 9170,
    "titleDevanagari": "वाल्मीकि रामायण, सुन्दरकाण्ड, सर्ग 7, श्लोक 5",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-5-sarga-7-shlok-5",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "ततो ददर्शोच्छ्रितमेघरूपं मनोहरं काञ्चनचारुरूपम्।",
          "रक्षोऽधिपस्यात्मबलानुरूपं गृहोत्तमं ह्यप्रतिरूपरूपम्॥५॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-7",
    "chapterName": "सुन्दरकाण्ड, सर्ग 7",
    "verseNumber": 5
  },
  {
    "id": "valmiki-ramayana-5-sarga-7-shlok-6",
    "collectionId": "valmiki-ramayana",
    "index": 9171,
    "titleDevanagari": "वाल्मीकि रामायण, सुन्दरकाण्ड, सर्ग 7, श्लोक 6",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-5-sarga-7-shlok-6",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "महीतले स्वर्गमिव प्रकीर्ण श्रिया ज्वलन्तं बहुरत्नकीर्णम्।",
          "नानातरूणां कुसुमावकीर्णं गिरेरिवाग्रं रजसावकीर्णम्॥६॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-7",
    "chapterName": "सुन्दरकाण्ड, सर्ग 7",
    "verseNumber": 6
  },
  {
    "id": "valmiki-ramayana-5-sarga-7-shlok-7",
    "collectionId": "valmiki-ramayana",
    "index": 9172,
    "titleDevanagari": "वाल्मीकि रामायण, सुन्दरकाण्ड, सर्ग 7, श्लोक 7",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-5-sarga-7-shlok-7",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "॥ श्रीसीतारामचन्द्राभ्यां नमः॥",
          "श्रीमद्वाल्मीकीय रामायण",
          "सुन्दरकाण्डम्",
          "सप्तमः सर्गः (7)",
          "नारीप्रवेकैरिव दीप्यमानं तडिद्भिरम्भोधरमय॑मानम्।",
          "हंसप्रवेकैरिव वाह्यमानं श्रिया युतं खे सुकृतं विमानम्॥७॥",
          "इत्याचे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये सुन्दरकाण्डे सप्तमः सर्गः॥७॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-7",
    "chapterName": "सुन्दरकाण्ड, सर्ग 7",
    "verseNumber": 7
  },
  {
    "id": "valmiki-ramayana-5-sarga-7-shlok-8",
    "collectionId": "valmiki-ramayana",
    "index": 9173,
    "titleDevanagari": "वाल्मीकि रामायण, सुन्दरकाण्ड, सर्ग 7, श्लोक 8",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-5-sarga-7-shlok-8",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "यथा नगाग्रं बहुधातुचित्रं यथा नभश्च ग्रहचन्द्रचित्रम्।",
          "ददर्श युक्तीकृतचारुमेघ चित्रं विमानं बहुरत्नचित्रम्॥८॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-7",
    "chapterName": "सुन्दरकाण्ड, सर्ग 7",
    "verseNumber": 8
  },
