    "slug": "valmiki-ramayana-5-sarga-7-shlok-9",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "मही कृता पर्वतराजिपूर्णा शैलाः कृता वृक्षवितानपूर्णाः।",
          "वृक्षाः कृताः पुष्पवितानपूर्णाः पुष्पं कृतं केसरपत्रपूर्णम्॥९॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-7",
    "chapterName": "सुन्दरकाण्ड, सर्ग 7",
    "verseNumber": 9
  },
  {
