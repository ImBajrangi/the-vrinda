    "slug": "valmiki-ramayana-5-sarga-7-shlok-11",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "पुष्पाह्वयं नाम विराजमानं रत्नप्रभाभिश्च विघूर्णमानम्।",
          "वेश्मोत्तमानामपि चोच्चमानं महाकपिस्तत्र महाविमानम्॥११॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-7",
    "chapterName": "सुन्दरकाण्ड, सर्ग 7",
    "verseNumber": 11
  },
  {
