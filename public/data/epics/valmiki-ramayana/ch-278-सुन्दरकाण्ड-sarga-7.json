    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-5-sarga-7-shlok-10",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "कृतानि वेश्मानि च पाण्डुराणि तथा सुपुष्पाण्यपि पुष्कराणि।",
          "पुनश्च पद्मानि सकेसराणि वनानि चित्राणि सरोवराणि॥१०॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-7",
    "chapterName": "सुन्दरकाण्ड, सर्ग 7",
    "verseNumber": 10
  },
