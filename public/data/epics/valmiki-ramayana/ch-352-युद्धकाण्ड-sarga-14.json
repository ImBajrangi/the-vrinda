    "slug": "valmiki-ramayana-6-sarga-14-shlok-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "निशाचरेन्द्रस्य निशम्य वाक्यं स कुम्भकर्णस्य च गर्जितानि।",
          "विभीषणो राक्षसराजमुख्यमुवाच वाक्यं हितमर्थयुक्तम्॥१॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-14",
    "chapterName": "युद्धकाण्ड, सर्ग 14",
    "verseNumber": 1
  },
  {
