    "slug": "valmiki-ramayana-6-sarga-14-shlok-4",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "यावन्न गृह्णन्ति शिरांसि बाणा रामेरिता राक्षसपुंगवानाम्।",
          "वज्रोपमा वायुसमानवेगाः प्रदीयतां दाशरथाय मैथिली॥४॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-14",
    "chapterName": "युद्धकाण्ड, सर्ग 14",
    "verseNumber": 4
  },
