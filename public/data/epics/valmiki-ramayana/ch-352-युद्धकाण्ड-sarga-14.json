    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "अयं च राजा व्यसनाभिभूतो मित्रैरमित्रप्रतिमैर्भवद्भिः।",
          "अन्वास्यते राक्षसनाशनार्थे तीक्ष्णः प्रकृत्या ह्यसमीक्षकारी॥१७॥",
          "वाग्दण्डयोस्तु पारुष्यमर्थदूषणमेव च।",
          "पानं स्त्री मृगया द्यूतं व्यसनं सप्तधा प्रभो॥"
        ]
      }
    ],
