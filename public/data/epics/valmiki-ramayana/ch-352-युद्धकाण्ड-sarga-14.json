    "slug": "valmiki-ramayana-6-sarga-14-shlok-3",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "यावन्न लङ्कां समभिद्रवन्ति बलीमुखाः पर्वतकूटमात्राः।",
          "दंष्ट्रायुधाश्चैव नखायुधाश्च प्रदीयतां दाशरथाय मैथिली॥३॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-14",
    "chapterName": "युद्धकाण्ड, सर्ग 14",
    "verseNumber": 3
  },
  {
