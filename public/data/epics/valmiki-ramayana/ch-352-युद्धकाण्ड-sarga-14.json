    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "निशम्य वाक्यं तु विभीषणस्य ततः प्रहस्तो वचनं बभाषे।",
          "न नो भयं विद्म न दैवतेभ्यो न दानवेभ्योऽप्यथवा कदाचित्॥७॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-14",
    "chapterName": "युद्धकाण्ड, सर्ग 14",
    "verseNumber": 7
  },
