        "linesDevanagari": [
          "किमर्थं चापि निक्षिप्य दूरे बलमिहागतः।",
          "कस्मान्नेहोपयातोऽसि सबलः पुरुषर्षभ॥५॥"
        ]
      }
    ],
    "chapterId": "अयोध्याकाण्ड-sarga-91",
    "chapterName": "अयोध्याकाण्ड, सर्ग 91",
    "verseNumber": 5
  },
