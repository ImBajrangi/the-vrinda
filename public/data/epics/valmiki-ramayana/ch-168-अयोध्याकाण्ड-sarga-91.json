    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-2-sarga-91-shlok-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "कृतबुद्धिं निवासाय तत्रैव स मुनिस्तदा।",
          "भरतं केकयीपुत्रमातिथ्येन न्यमन्त्रयत्॥१॥"
        ]
      }
    ],
    "chapterId": "अयोध्याकाण्ड-sarga-91",
    "chapterName": "अयोध्याकाण्ड, सर्ग 91",
    "verseNumber": 1
  },
  {
    "id": "valmiki-ramayana-2-sarga-91-shlok-2",
    "collectionId": "valmiki-ramayana",
    "index": 5910,
    "titleDevanagari": "वाल्मीकि रामायण, अयोध्याकाण्ड, सर्ग 91, श्लोक 2",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-2-sarga-91-shlok-2",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "अब्रवीद् भरतस्त्वेनं नन्विदं भवता कृतम्।",
          "पाद्यमय॑मथातिथ्यं वने यदुपपद्यते॥२॥",
          "अथोवाच भरद्वाजो भरतं प्रहसन्निव।",
          "जाने त्वां प्रीतिसंयुक्तं तष्येस्त्वं येन केनचित्॥"
        ]
      }
    ],
    "chapterId": "अयोध्याकाण्ड-sarga-91",
    "chapterName": "अयोध्याकाण्ड, सर्ग 91",
    "verseNumber": 2
  },
  {
