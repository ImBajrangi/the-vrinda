    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "सेनायास्तु तवैवास्याः कर्तुमिच्छामि भोजनम्।",
          "मम प्रीतिर्यथारूपा त्वम मनुजर्षभ॥४॥"
        ]
      }
    ],
    "chapterId": "अयोध्याकाण्ड-sarga-91",
    "chapterName": "अयोध्याकाण्ड, सर्ग 91",
    "verseNumber": 4
  },
