[
  {
    "id": "valmiki-ramayana-1-sarga-58-shlok-1",
    "collectionId": "valmiki-ramayana",
    "index": 2479,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 58, श्लोक 1",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-58-shlok-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "इत्युक्तः करुणं वाक्यं वानरैस्त्यक्तजीवितैः।",
          "सबाष्पो वानरान् गृध्रः प्रत्युवाच महास्वनः॥१॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-58",
    "chapterName": "बालकाण्ड, सर्ग 58",
    "verseNumber": 1
  },
  {
    "id": "valmiki-ramayana-1-sarga-58-shlok-2",
    "collectionId": "valmiki-ramayana",
    "index": 2480,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 58, श्लोक 2",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-58-shlok-2",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "यवीयान् स मम भ्राता जटायुर्नाम वानराः।",
          "यमाख्यात हतं युद्ध रावणेन बलीयसा॥२॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-58",
    "chapterName": "बालकाण्ड, सर्ग 58",
    "verseNumber": 2
  },
  {
    "id": "valmiki-ramayana-1-sarga-58-shlok-3",
    "collectionId": "valmiki-ramayana",
    "index": 2481,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 58, श्लोक 3",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-58-shlok-3",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "वृद्धभावादपक्षत्वाच्छृण्वंस्तदपि मर्षये।",
          "नहि मे शक्तिरस्त्यद्य भ्रातुर्वैरविमोक्षणे॥३॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-58",
    "chapterName": "बालकाण्ड, सर्ग 58",
    "verseNumber": 3
  },
  {
    "id": "valmiki-ramayana-1-sarga-58-shlok-4",
    "collectionId": "valmiki-ramayana",
    "index": 2482,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 58, श्लोक 4",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-58-shlok-4",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "अशक्यमिति सोवाच वसिष्ठो भगवानृषिः।",
          "तं वयं वै समाहर्तुं क्रतुं शक्ताः कथंचन॥४॥",
          "बालिशस्त्वं नरश्रेष्ठ गम्यतां स्वपुरं पुनः।",
          "याजने भगवान् शक्तस्त्रैलोक्यस्यापि पार्थिव॥",
          "अवमानं कथं कर्तुं तस्य शक्ष्यामहे वयम्।"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-58",
    "chapterName": "बालकाण्ड, सर्ग 58",
    "verseNumber": 4
  },
  {
    "id": "valmiki-ramayana-1-sarga-58-shlok-5",
    "collectionId": "valmiki-ramayana",
    "index": 2483,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 58, श्लोक 5",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-58-shlok-5",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "पुरा वृत्रवधे वृत्ते स चाहं च जयैषिणौ।",
          "आदित्यमुपयातौ स्वो ज्वलन्तं रश्मिमालिनम्॥४॥",
          "आवृत्याकाशमार्गेण जवेन स्वर्गतौ भृशम्।",
          "मध्यं प्राप्ते तु सूर्ये तु जटायुरवसीदति॥५॥",
          "तमहं भ्रातरं दृष्ट्वा सूर्यरश्मिभिरर्दितम्।",
          "पक्षाभ्यां छादयामास स्नेहात् परमविह्वलम्॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-58",
    "chapterName": "बालकाण्ड, सर्ग 58",
    "verseNumber": 5
  },
  {
    "id": "valmiki-ramayana-1-sarga-58-shlok-6",
    "collectionId": "valmiki-ramayana",
    "index": 2484,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 58, श्लोक 6",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-58-shlok-6",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "तेषां तद् वचनं श्रुत्वा क्रोधपर्याकुलाक्षरम्॥६॥",
          "स राजा पुनरेवैतानिदं वचनमब्रवीत्।",
          "प्रत्याख्यातो भगवता गुरुपुत्रैस्तथैव हि ॥७॥",
          "अन्यां गतिं गमिष्यामि स्वस्ति वोऽस्तु तपोधनाः।"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-58",
    "chapterName": "बालकाण्ड, सर्ग 58",
    "verseNumber": 6
  },
  {
    "id": "valmiki-ramayana-1-sarga-58-shlok-7",
    "collectionId": "valmiki-ramayana",
    "index": 2485,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 58, श्लोक 7",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-58-shlok-7",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "निर्दग्धपत्रः पतितो विन्ध्येऽहं वानरर्षभाः।",
          "अहमस्मिन् वसन् भ्रातुः प्रवृत्तिं नोपलक्षये॥७॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-58",
    "chapterName": "बालकाण्ड, सर्ग 58",
    "verseNumber": 7
  },
  {
