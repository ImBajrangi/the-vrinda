    "slug": "valmiki-ramayana-1-sarga-58-shlok-8",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "जटायुषस्त्वेवमुक्तो भ्रात्रा सम्पातिना तदा।",
          "युवराजो महाप्रज्ञः प्रत्युवाचाङ्गदस्तदा॥८॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-58",
    "chapterName": "बालकाण्ड, सर्ग 58",
    "verseNumber": 8
  },
  {
