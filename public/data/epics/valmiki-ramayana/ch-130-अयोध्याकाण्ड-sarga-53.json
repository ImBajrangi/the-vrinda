    "slug": "valmiki-ramayana-2-sarga-53-shlok-4",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "रात्रिं कथंचिदेवेमां सौमित्रे वर्तयामहे।",
          "अपवर्तामहे भूमावास्तीर्य स्वयमर्जितैः॥४॥",
          "स तु संविश्य मेदिन्यां महार्हशयनोचितः।",
          "इमाः सौमित्रये रामो व्याजहार कथाः शुभाः॥",
          "अयोध्या"
        ]
      }
    ],
    "chapterId": "अयोध्याकाण्ड-sarga-53",
    "chapterName": "अयोध्याकाण्ड, सर्ग 53",
    "verseNumber": 4
  },
