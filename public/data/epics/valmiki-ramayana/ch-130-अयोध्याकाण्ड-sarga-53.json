    "slug": "valmiki-ramayana-2-sarga-53-shlok-3",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "जागर्तव्यमतन्द्रिभ्यामद्यप्रभृति रात्रिषु।",
          "योगक्षेमौ हि सीताया वर्तेते लक्ष्मणावयोः॥३॥"
        ]
      }
    ],
    "chapterId": "अयोध्याकाण्ड-sarga-53",
    "chapterName": "अयोध्याकाण्ड, सर्ग 53",
    "verseNumber": 3
  },
  {
