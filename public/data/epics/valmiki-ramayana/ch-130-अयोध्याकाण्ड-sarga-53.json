    "slug": "valmiki-ramayana-2-sarga-53-shlok-2",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "अद्येयं प्रथमा रात्रिर्याता जनपदाद् बहिः।",
          "या समन्त्रेण रहिता तां नोत्कण्ठितुमर्हसि ॥२॥"
        ]
      }
    ],
    "chapterId": "अयोध्याकाण्ड-sarga-53",
    "chapterName": "अयोध्याकाण्ड, सर्ग 53",
    "verseNumber": 2
  },
