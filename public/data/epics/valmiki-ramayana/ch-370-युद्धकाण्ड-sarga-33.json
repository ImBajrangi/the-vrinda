    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "स तां श्रुत्वा विशालाक्षि प्रवृत्तिं राक्षसाधिपः।",
          "एष मन्त्रयते सर्वैः सचिवैः सह रावणः॥१८॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-33",
    "chapterName": "युद्धकाण्ड, सर्ग 33",
    "verseNumber": 18
  },
