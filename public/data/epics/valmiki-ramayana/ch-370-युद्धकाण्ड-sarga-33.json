[
  {
    "id": "valmiki-ramayana-6-sarga-33-shlok-1",
    "collectionId": "valmiki-ramayana",
    "index": 12248,
    "titleDevanagari": "वाल्मीकि रामायण, युद्धकाण्ड, सर्ग 33, श्लोक 1",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-6-sarga-33-shlok-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "सीतां तु मोहितां दृष्ट्वा सरमा नाम राक्षसी।",
          "आससादाथ वैदेहीं प्रियां प्रणयिनी सखीम्॥१॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-33",
    "chapterName": "युद्धकाण्ड, सर्ग 33",
    "verseNumber": 1
  },
  {
    "id": "valmiki-ramayana-6-sarga-33-shlok-2",
    "collectionId": "valmiki-ramayana",
    "index": 12249,
    "titleDevanagari": "वाल्मीकि रामायण, युद्धकाण्ड, सर्ग 33, श्लोक 2",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-6-sarga-33-shlok-2",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "मोहितां राक्षसेन्द्रेण सीतां परमदुःखिताम्।",
          "आश्वासयामास तदा सरमा मृदुभाषिणी॥२॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-33",
    "chapterName": "युद्धकाण्ड, सर्ग 33",
    "verseNumber": 2
  },
  {
    "id": "valmiki-ramayana-6-sarga-33-shlok-3",
    "collectionId": "valmiki-ramayana",
    "index": 12250,
    "titleDevanagari": "वाल्मीकि रामायण, युद्धकाण्ड, सर्ग 33, श्लोक 3",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-6-sarga-33-shlok-3",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "सा हि तत्र कृता मित्रं सीतया रक्ष्यमाणया।",
          "रक्षन्ती रावणादिष्टा सानुक्रोशा दृढव्रता॥३॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-33",
    "chapterName": "युद्धकाण्ड, सर्ग 33",
    "verseNumber": 3
  },
  {
    "id": "valmiki-ramayana-6-sarga-33-shlok-4",
    "collectionId": "valmiki-ramayana",
    "index": 12251,
    "titleDevanagari": "वाल्मीकि रामायण, युद्धकाण्ड, सर्ग 33, श्लोक 4",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-6-sarga-33-shlok-4",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "सा ददर्श सखी सीतां सरमा नष्टचेतनाम्।",
          "उपावृत्योत्थितां ध्वस्तां वडवामिव पांसुषु॥४॥",
          "तां समाश्वासयामास सखीस्नेहेन सुव्रताम्।",
          "समाश्वसिहि वैदेहि मा भूत् ते मनसो व्यथा।",
          "उक्ता यद् रावणेन त्वं प्रयुक्तश्च स्वयं त्वया॥",
          "सखीस्नेहेन तद् भीरु मया सर्वं प्रतिश्रुतम्।",
          "लीनया गहने शून्ये भयमुत्सृज्य रावणात्।",
          "तव हेतोर्विशालाक्षि नहि मे रावणाद् भयम्॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-33",
    "chapterName": "युद्धकाण्ड, सर्ग 33",
    "verseNumber": 4
  },
  {
    "id": "valmiki-ramayana-6-sarga-33-shlok-7",
    "collectionId": "valmiki-ramayana",
    "index": 12252,
    "titleDevanagari": "वाल्मीकि रामायण, युद्धकाण्ड, सर्ग 33, श्लोक 7",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-6-sarga-33-shlok-7",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "स सम्भ्रान्तश्च निष्क्रान्तो यत्कृते राक्षसेश्वरः।",
          "तत्र मे विदितं सर्वमभिनिष्क्रम्य मैथिलि॥७॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-33",
    "chapterName": "युद्धकाण्ड, सर्ग 33",
    "verseNumber": 7
  },
  {
    "id": "valmiki-ramayana-6-sarga-33-shlok-8",
    "collectionId": "valmiki-ramayana",
    "index": 12253,
    "titleDevanagari": "वाल्मीकि रामायण, युद्धकाण्ड, सर्ग 33, श्लोक 8",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-6-sarga-33-shlok-8",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "न शक्यं सौप्तिकं कर्तुं रामस्य विदितात्मनः।",
          "वधश्च पुरुषव्याघ्र तस्मिन् नैवोपपद्यते॥८॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-33",
    "chapterName": "युद्धकाण्ड, सर्ग 33",
    "verseNumber": 8
  },
  {
    "id": "valmiki-ramayana-6-sarga-33-shlok-9",
    "collectionId": "valmiki-ramayana",
    "index": 12254,
    "titleDevanagari": "वाल्मीकि रामायण, युद्धकाण्ड, सर्ग 33, श्लोक 9",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-6-sarga-33-shlok-9",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "न त्वेवं वानरा हन्तुं शक्याः पादपयोधिनः।",
          "सुरा देवर्षभेणेव रामेण हि सुरक्षिताः॥९॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-33",
    "chapterName": "युद्धकाण्ड, सर्ग 33",
    "verseNumber": 9
  },
  {
    "id": "valmiki-ramayana-6-sarga-33-shlok-12",
    "collectionId": "valmiki-ramayana",
    "index": 12255,
    "titleDevanagari": "वाल्मीकि रामायण, युद्धकाण्ड, सर्ग 33, श्लोक 12",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-6-sarga-33-shlok-12",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "दीर्घवृत्तभुजः श्रीमान् महोरस्कः प्रतापवान्।",
          "धन्वी संनहनोपेतो धर्मात्मा भुवि विश्रुतः॥१०॥",
          "विक्रान्तो रक्षिता नित्यमात्मनश्च परस्य च।",
          "लक्ष्मणेन सह भ्रात्रा कुलीनो नयशास्त्रवित् ॥११॥",
          "हन्ता परबलौघानामचिन्त्यबलपौरुषः।",
          "न हतो राघवः श्रीमान् सीते शत्रुनिबर्हणः॥१२॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-33",
    "chapterName": "युद्धकाण्ड, सर्ग 33",
    "verseNumber": 12
  },
  {
    "id": "valmiki-ramayana-6-sarga-33-shlok-13",
    "collectionId": "valmiki-ramayana",
    "index": 12256,
    "titleDevanagari": "वाल्मीकि रामायण, युद्धकाण्ड, सर्ग 33, श्लोक 13",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-6-sarga-33-shlok-13",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "अयुक्तबुद्धिकृत्येन सर्वभूतविरोधिना।",
          "एवं प्रयुक्ता रौद्रेण माया मायाविना त्वयि॥१३॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-33",
    "chapterName": "युद्धकाण्ड, सर्ग 33",
    "verseNumber": 13
  },
  {
