    "slug": "valmiki-ramayana-6-sarga-33-shlok-22",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "कल्प्यन्ते मत्तमातङ्गा युज्यन्ते रथवाजिनः।",
          "दृश्यन्ते तुरगारूढाः प्रासहस्ताः सहस्रशः॥२२॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-33",
    "chapterName": "युद्धकाण्ड, सर्ग 33",
