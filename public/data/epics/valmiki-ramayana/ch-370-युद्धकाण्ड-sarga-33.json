    "titleDevanagari": "वाल्मीकि रामायण, युद्धकाण्ड, सर्ग 33, श्लोक 14",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-6-sarga-33-shlok-14",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "शोकस्ते विगतः सर्वकल्याणं त्वामुपस्थितम्।",
          "ध्रुवं त्वां भजते लक्ष्मीः प्रियं ते भवति शृणु॥१४॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-33",
    "chapterName": "युद्धकाण्ड, सर्ग 33",
    "verseNumber": 14
  },
  {
    "id": "valmiki-ramayana-6-sarga-33-shlok-15",
    "collectionId": "valmiki-ramayana",
    "index": 12258,
    "titleDevanagari": "वाल्मीकि रामायण, युद्धकाण्ड, सर्ग 33, श्लोक 15",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-6-sarga-33-shlok-15",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "उत्तीर्य सागरं रामः सह वानरसेनया।",
          "संनिविष्टः समुद्रस्य तीरमासाद्य दक्षिणम्॥१५॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-33",
    "chapterName": "युद्धकाण्ड, सर्ग 33",
    "verseNumber": 15
  },
  {
    "id": "valmiki-ramayana-6-sarga-33-shlok-16",
    "collectionId": "valmiki-ramayana",
    "index": 12259,
    "titleDevanagari": "वाल्मीकि रामायण, युद्धकाण्ड, सर्ग 33, श्लोक 16",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-6-sarga-33-shlok-16",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "दृष्टो मे परिपूर्णार्थः काकुत्स्थः सहलक्ष्मणः।",
          "सहितैः सागरान्तस्थैर्बलैस्तिष्ठति रक्षितः॥१६॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-33",
    "chapterName": "युद्धकाण्ड, सर्ग 33",
    "verseNumber": 16
  },
  {
