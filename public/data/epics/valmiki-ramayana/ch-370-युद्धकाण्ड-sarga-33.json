    "slug": "valmiki-ramayana-6-sarga-33-shlok-23",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "तत्र तत्र च संनद्धाः सम्पतन्ति सहस्रशः।",
          "आपूर्यन्ते राजमार्गाः सैन्यैरद्भुतदर्शनैः॥२३॥",
          "वेगवद्भिर्नदद्भिश्च तोयौपैरिव सागरः।"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-33",
    "chapterName": "युद्धकाण्ड, सर्ग 33",
    "verseNumber": 23
  },
  {
