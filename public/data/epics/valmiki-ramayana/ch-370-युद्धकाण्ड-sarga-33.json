    "slug": "valmiki-ramayana-6-sarga-33-shlok-21",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "संनाहजननी ह्येषा भैरवा भीरु भेरिका।",
          "भेरीनादं च गम्भीरं शृणु तोयदनिःस्वनम्॥२१॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-33",
