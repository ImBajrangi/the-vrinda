    "index": 10680,
    "titleDevanagari": "वाल्मीकि रामायण, सुन्दरकाण्ड, सर्ग 53, श्लोक 16",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-5-sarga-53-shlok-16",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "ततस्ते संवृताकारं सत्त्ववन्तं महाकपिम्॥१६॥",
          "परिगृह्य ययुर्हृष्टा राक्षसाः कपिकुञ्जरम्।",
          "शङ्कभेरीनिनादैश्च घोषयन्तः स्वकर्मभिः॥१७॥",
          "राक्षसाः क्रूरकर्माणश्चारयन्ति स्म तां पुरीम्।"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-53",
    "chapterName": "सुन्दरकाण्ड, सर्ग 53",
    "verseNumber": 16
  },
  {
    "id": "valmiki-ramayana-5-sarga-53-shlok-18",
