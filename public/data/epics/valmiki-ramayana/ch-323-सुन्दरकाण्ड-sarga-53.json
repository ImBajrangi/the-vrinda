    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-5-sarga-53-shlok-12",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "यदि भर्तृहितार्थाय चरन्तं भर्तृशासनात्।",
          "निबध्नन्ते दुरात्मानो न तु मे निष्कृतिः कृता॥१२॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-53",
    "chapterName": "सुन्दरकाण्ड, सर्ग 53",
    "verseNumber": 12
  },
  {
    "id": "valmiki-ramayana-5-sarga-53-shlok-13",
    "collectionId": "valmiki-ramayana",
    "index": 10677,
    "titleDevanagari": "वाल्मीकि रामायण, सुन्दरकाण्ड, सर्ग 53, श्लोक 13",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-5-sarga-53-shlok-13",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "सर्वेषामेव पर्याप्तो राक्षसानामहं युधि।",
          "किं तु रामस्य प्रीत्यर्थं विषहिष्येऽहमीदृशम्॥१३॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-53",
    "chapterName": "सुन्दरकाण्ड, सर्ग 53",
    "verseNumber": 13
  },
  {
    "id": "valmiki-ramayana-5-sarga-53-shlok-14",
