    "index": 10678,
    "titleDevanagari": "वाल्मीकि रामायण, सुन्दरकाण्ड, सर्ग 53, श्लोक 14",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-5-sarga-53-shlok-14",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "लङ्का चारयितव्या मे पुनरेव भवेदिति।",
          "रात्रौ नहि सुदृष्टा मे दुर्गकर्मविधानतः॥१४॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-53",
    "chapterName": "सुन्दरकाण्ड, सर्ग 53",
    "verseNumber": 14
  },
  {
    "id": "valmiki-ramayana-5-sarga-53-shlok-15",
