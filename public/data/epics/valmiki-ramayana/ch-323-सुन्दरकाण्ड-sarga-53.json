    "index": 10681,
    "titleDevanagari": "वाल्मीकि रामायण, सुन्दरकाण्ड, सर्ग 53, श्लोक 18",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-5-sarga-53-shlok-18",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "अन्वीयमानो रक्षोभिर्ययौ सुखमिरंदमः॥१८॥",
          "हनूमांश्चारयामास राक्षसानां महापुरीम्।",
          "अथापश्यद् विमानानि विचित्राणि महाकपिः॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-53",
    "chapterName": "सुन्दरकाण्ड, सर्ग 53",
    "verseNumber": 18
  },
  {
