    "titleDevanagari": "वाल्मीकि रामायण, सुन्दरकाण्ड, सर्ग 53, श्लोक 1",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-5-sarga-53-shlok-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "तस्य तद् वचनं श्रुत्वा दशग्रीवो महात्मनः।",
          "देशकालहितं वाक्यं भ्रातुरुत्तरमब्रवीत्॥१॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-53",
    "chapterName": "सुन्दरकाण्ड, सर्ग 53",
    "verseNumber": 1
  },
  {
    "id": "valmiki-ramayana-5-sarga-53-shlok-2",
    "collectionId": "valmiki-ramayana",
    "index": 10668,
    "titleDevanagari": "वाल्मीकि रामायण, सुन्दरकाण्ड, सर्ग 53, श्लोक 2",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-5-sarga-53-shlok-2",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "सम्यगुक्तं हि भवता दूतवध्या विगर्हिता।",
          "अवश्यं तु वधायान्यः क्रियतामस्य निग्रहः॥२॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-53",
    "chapterName": "सुन्दरकाण्ड, सर्ग 53",
    "verseNumber": 2
  },
  {
    "id": "valmiki-ramayana-5-sarga-53-shlok-3",
    "collectionId": "valmiki-ramayana",
    "index": 10669,
    "titleDevanagari": "वाल्मीकि रामायण, सुन्दरकाण्ड, सर्ग 53, श्लोक 3",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-5-sarga-53-shlok-3",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "कपीनां किल लाङ्गलमिष्टं भवति भूषणम्।",
          "तदस्य दीप्यतां शीघ्रं तेन दग्धेन गच्छतु॥३॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-53",
    "chapterName": "सुन्दरकाण्ड, सर्ग 53",
    "verseNumber": 3
  },
  {
    "id": "valmiki-ramayana-5-sarga-53-shlok-4",
    "collectionId": "valmiki-ramayana",
    "index": 10670,
    "titleDevanagari": "वाल्मीकि रामायण, सुन्दरकाण्ड, सर्ग 53, श्लोक 4",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-5-sarga-53-shlok-4",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "ततः पश्यन्त्वमुं दीनमङ्गवैरूप्यकर्शितम्।",
          "सुमित्रज्ञातयः सर्वे बान्धवाः ससुहृज्जनाः॥४॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-53",
    "chapterName": "सुन्दरकाण्ड, सर्ग 53",
    "verseNumber": 4
  },
  {
    "id": "valmiki-ramayana-5-sarga-53-shlok-5",
    "collectionId": "valmiki-ramayana",
    "index": 10671,
    "titleDevanagari": "वाल्मीकि रामायण, सुन्दरकाण्ड, सर्ग 53, श्लोक 5",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-5-sarga-53-shlok-5",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "आज्ञापयद् राक्षसेन्द्रः पुरं सर्वं सचत्वरम्।",
          "लाङ्गलेन प्रदीप्तेन रक्षोभिः परिणीयताम्॥५॥",
          "त",
          "स्य तद् वचनं श्रुत्वा राक्षसाः कोपकर्कशाः।",
          "वेष्टन्ते तस्य लाङ्गलं जीर्णैः कार्पासिकैः पटैः॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-53",
    "chapterName": "सुन्दरकाण्ड, सर्ग 53",
    "verseNumber": 5
  },
  {
    "id": "valmiki-ramayana-5-sarga-53-shlok-7",
    "collectionId": "valmiki-ramayana",
    "index": 10672,
    "titleDevanagari": "वाल्मीकि रामायण, सुन्दरकाण्ड, सर्ग 53, श्लोक 7",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-5-sarga-53-shlok-7",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "संवेष्टयमाने लाङ्गले व्यवर्धत महाकपिः।",
          "शुष्कमिन्धनमासाद्य वनेष्विव हुताशनम्॥७॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-53",
    "chapterName": "सुन्दरकाण्ड, सर्ग 53",
    "verseNumber": 7
  },
  {
    "id": "valmiki-ramayana-5-sarga-53-shlok-8",
    "collectionId": "valmiki-ramayana",
    "index": 10673,
    "titleDevanagari": "वाल्मीकि रामायण, सुन्दरकाण्ड, सर्ग 53, श्लोक 8",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-5-sarga-53-shlok-8",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "तैलेन परिषिच्याथ तेऽग्निं तत्रोपपादयन्।",
          "लाङ्गलेन प्रदीप्तेन राक्षसांस्तानताडयत्॥८॥",
          "रोषामर्षपरीतात्मा बालसूर्यसमाननः।"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-53",
    "chapterName": "सुन्दरकाण्ड, सर्ग 53",
    "verseNumber": 8
  },
  {
    "id": "valmiki-ramayana-5-sarga-53-shlok-9",
    "collectionId": "valmiki-ramayana",
    "index": 10674,
    "titleDevanagari": "वाल्मीकि रामायण, सुन्दरकाण्ड, सर्ग 53, श्लोक 9",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-5-sarga-53-shlok-9",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "स भूयः संगतैः क्रूरै राक्षसैर्हरिपुङ्गवः॥९॥",
          "सहस्त्रीबालवृद्धाश्च जग्मुः प्रीतिं निशाचराः।"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-53",
    "chapterName": "सुन्दरकाण्ड, सर्ग 53",
    "verseNumber": 9
  },
  {
    "id": "valmiki-ramayana-5-sarga-53-shlok-10",
    "collectionId": "valmiki-ramayana",
    "index": 10675,
    "titleDevanagari": "वाल्मीकि रामायण, सुन्दरकाण्ड, सर्ग 53, श्लोक 10",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-5-sarga-53-shlok-10",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "निबद्धः कृतवान् वीरस्तत्कालसदृशीं मतिम्॥१०॥",
          "कामं खलु न मे शक्ता निबद्धस्यापि राक्षसाः।",
          "छित्त्वा पाशान् समुत्पत्य हन्यामहमिमान् पुनः॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-53",
    "chapterName": "सुन्दरकाण्ड, सर्ग 53",
    "verseNumber": 10
  },
  {
    "id": "valmiki-ramayana-5-sarga-53-shlok-12",
