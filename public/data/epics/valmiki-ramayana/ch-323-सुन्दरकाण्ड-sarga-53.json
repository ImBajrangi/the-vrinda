    "slug": "valmiki-ramayana-5-sarga-53-shlok-22",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "स्त्रीबालवृद्धा निर्जग्मुस्तत्र तत्र कुतूहलात्॥२२॥",
          "तं प्रदीपितलाङ्गलं हनूमन्तं दिदृक्षवः।।"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-53",
