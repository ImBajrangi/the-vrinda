    "index": 10679,
    "titleDevanagari": "वाल्मीकि रामायण, सुन्दरकाण्ड, सर्ग 53, श्लोक 15",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-5-sarga-53-shlok-15",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "अवश्यमेव द्रष्टव्या मया लङ्का निशाक्षये।",
          "कामं बध्नन्तु मे भूयः पुच्छस्योद्दीपनेन च॥१५॥",
          "पीडां कुर्वन्ति रक्षांसि न मेऽस्ति मनसः श्रमः।"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-53",
    "chapterName": "सुन्दरकाण्ड, सर्ग 53",
    "verseNumber": 15
  },
  {
    "id": "valmiki-ramayana-5-sarga-53-shlok-16",
