    "slug": "valmiki-ramayana-3-sarga-21-shlok-6",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "इत्येवमुक्ता दुर्धर्षा खरेण परिसान्त्विता।",
          "विमृज्य नयने साने खरं भ्रातरमब्रवीत्॥६॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-21",
    "chapterName": "अरण्यकाण्ड, सर्ग 21",
    "verseNumber": 6
  },
  {
