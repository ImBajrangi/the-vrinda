    "collectionId": "valmiki-ramayana",
    "index": 7344,
    "titleDevanagari": "वाल्मीकि रामायण, अरण्यकाण्ड, सर्ग 21, श्लोक 7",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-21-shlok-7",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "अस्मीदानीमहं प्राप्ता हतश्रवणनासिका।",
          "शोणितौघपरिक्लिन्ना त्वया च परिसान्त्विता॥ ७॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-21",
    "chapterName": "अरण्यकाण्ड, सर्ग 21",
    "verseNumber": 7
  },
  {
    "id": "valmiki-ramayana-3-sarga-21-shlok-9",
    "collectionId": "valmiki-ramayana",
    "index": 7345,
    "titleDevanagari": "वाल्मीकि रामायण, अरण्यकाण्ड, सर्ग 21, श्लोक 9",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-21-shlok-9",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "प्रेषिताश्च त्वया शूरा राक्षसास्ते चतुर्दश।",
          "निहन्तुं राघवं घोरं मत्प्रियार्थं सलक्ष्मणम्॥८॥",
          "ते तु रामेण सामर्षाः शूलपट्टिशपाणयः।",
          "समरे निहताः सर्वे सायकैमर्मभेदिभिः॥९॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-21",
    "chapterName": "अरण्यकाण्ड, सर्ग 21",
    "verseNumber": 9
  },
  {
    "id": "valmiki-ramayana-3-sarga-21-shlok-10",
    "collectionId": "valmiki-ramayana",
    "index": 7346,
    "titleDevanagari": "वाल्मीकि रामायण, अरण्यकाण्ड, सर्ग 21, श्लोक 10",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-21-shlok-10",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "तान् भूमौ पतितान् दृष्ट्वा क्षणेनैव महाजवान्।",
          "रामस्य च महत्कर्म महांस्त्रासोऽभवन्मम॥१०॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-21",
    "chapterName": "अरण्यकाण्ड, सर्ग 21",
    "verseNumber": 10
  },
  {
