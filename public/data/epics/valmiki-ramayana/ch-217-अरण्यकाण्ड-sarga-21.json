    "slug": "valmiki-ramayana-3-sarga-21-shlok-12",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "विषादनक्राध्युषिते परित्रासोर्मिमालिनि।",
          "किं मां न त्रायसे मग्नां विपुले शोकसागरे॥ १२॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-21",
    "chapterName": "अरण्यकाण्ड, सर्ग 21",
    "verseNumber": 12
  },
  {
    "id": "valmiki-ramayana-3-sarga-21-shlok-13",
    "collectionId": "valmiki-ramayana",
