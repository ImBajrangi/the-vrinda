    "titleDevanagari": "वाल्मीकि रामायण, अरण्यकाण्ड, सर्ग 21, श्लोक 1",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-21-shlok-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "स पुनः पतितां दृष्ट्वा क्रोधाच्छूर्पणखां पुनः।",
          "उवाच व्यक्तया वाचा तामनर्थार्थमागताम्॥१॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-21",
    "chapterName": "अरण्यकाण्ड, सर्ग 21",
    "verseNumber": 1
  },
  {
    "id": "valmiki-ramayana-3-sarga-21-shlok-2",
    "collectionId": "valmiki-ramayana",
    "index": 7339,
    "titleDevanagari": "वाल्मीकि रामायण, अरण्यकाण्ड, सर्ग 21, श्लोक 2",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-21-shlok-2",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "मया त्विदानीं शूरास्ते राक्षसाः पिशिताशनाः।",
          "त्वत्प्रियार्थं विनिर्दिष्टाः किमर्थं रुद्यते पुनः॥२॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-21",
    "chapterName": "अरण्यकाण्ड, सर्ग 21",
    "verseNumber": 2
  },
  {
    "id": "valmiki-ramayana-3-sarga-21-shlok-3",
    "collectionId": "valmiki-ramayana",
    "index": 7340,
    "titleDevanagari": "वाल्मीकि रामायण, अरण्यकाण्ड, सर्ग 21, श्लोक 3",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-21-shlok-3",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "भक्ताश्चैवानुरक्ताश्च हिताश्च मम नित्यशः।",
          "हन्यमाना न हन्यन्ते न न कुर्युर्वचो मम॥३॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-21",
    "chapterName": "अरण्यकाण्ड, सर्ग 21",
    "verseNumber": 3
  },
  {
    "id": "valmiki-ramayana-3-sarga-21-shlok-4",
    "collectionId": "valmiki-ramayana",
    "index": 7341,
    "titleDevanagari": "वाल्मीकि रामायण, अरण्यकाण्ड, सर्ग 21, श्लोक 4",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-21-shlok-4",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "किमेतच्छोतुमिच्छामि कारणं यत्कृते पुनः।",
          "हा नाथेति विनर्दन्ती सर्पवच्चेष्टसे क्षितौ॥४॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-21",
    "chapterName": "अरण्यकाण्ड, सर्ग 21",
    "verseNumber": 4
  },
  {
    "id": "valmiki-ramayana-3-sarga-21-shlok-5",
    "collectionId": "valmiki-ramayana",
    "index": 7342,
    "titleDevanagari": "वाल्मीकि रामायण, अरण्यकाण्ड, सर्ग 21, श्लोक 5",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-21-shlok-5",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "अनाथवद् विलपसि किं नु नाथे मयि स्थिते।",
          "उत्तिष्ठोत्तिष्ठ मा मैवं वैक्लव्यं त्यज्यतामिति॥५॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-21",
    "chapterName": "अरण्यकाण्ड, सर्ग 21",
    "verseNumber": 5
  },
  {
