    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-21-shlok-15",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "यदि रामममित्रघ्नं न त्वमद्य वधिष्यसि॥१५॥",
          "तव चैवाग्रतः प्राणांस्त्यक्ष्यामि निरपत्रपा।"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-21",
