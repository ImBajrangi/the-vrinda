    "slug": "valmiki-ramayana-3-sarga-21-shlok-16",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "बुद्ध्याहमनुपश्यामि न त्वं रामस्य संयुगे॥१६॥",
          "स्थातुं प्रतिमुखे शक्तः सबलोऽपि महारणे।"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-21",
