    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-21-shlok-11",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "सास्मि भीता समुद्विग्ना विषण्णा च निशाचर।",
          "शरणं त्वां पुनः प्राप्ता सर्वतो भयदर्शिनी॥११॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-21",
    "chapterName": "अरण्यकाण्ड, सर्ग 21",
    "verseNumber": 11
  },
  {
