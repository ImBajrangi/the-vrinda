    "slug": "valmiki-ramayana-3-sarga-12-shlok-2",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "राजा दशरथो नाम ज्येष्ठस्तस्य सुतो बली।",
          "रामः प्राप्तो मुनिं द्रष्टं भार्यया सह सीतया॥२॥",
          "‘मुने!",
          "अयोध्या"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-12",
    "chapterName": "अरण्यकाण्ड, सर्ग 12",
    "verseNumber": 2
  },
  {
