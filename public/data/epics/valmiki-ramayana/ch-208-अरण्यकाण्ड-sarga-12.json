    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-12-shlok-10",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "दिष्ट्या रामश्चिरस्याद्य द्रष्टुं मां समुपागतः ॥१०॥",
          "मनसा कांक्षितं ह्यस्य मयाप्यागमनं प्रति।",
          "गम्यतां सत्कृतो रामः सभार्यः सहलक्ष्मणः॥",
          "प्रवेश्यतां समीपं मे किमसौ न प्रवेशितः।"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-12",
    "chapterName": "अरण्यकाण्ड, सर्ग 12",
    "verseNumber": 10
