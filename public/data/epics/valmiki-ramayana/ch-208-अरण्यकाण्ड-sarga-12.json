    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-12-shlok-6",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "स प्रविश्य मुनिश्रेष्ठं तपसा दुष्प्रधर्षणम्।",
          "कृताञ्जलिरुवाचेदं रामागमनमञ्जसा॥६॥",
          "यथोक्तं लक्ष्मणेनैव शिष्योऽगस्त्यस्य सम्मतः।"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-12",
    "chapterName": "अरण्यकाण्ड, सर्ग 12",
    "verseNumber": 6
  },
  {
    "id": "valmiki-ramayana-3-sarga-12-shlok-7",
