    "slug": "valmiki-ramayana-3-sarga-12-shlok-3",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "लक्ष्मणो नाम तस्याहं भ्राता त्ववरजो हितः।",
          "अनुकूलश्च भक्तश्च यदि ते श्रोत्रमागतः॥३॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-12",
    "chapterName": "अरण्यकाण्ड, सर्ग 12",
    "verseNumber": 3
  },
