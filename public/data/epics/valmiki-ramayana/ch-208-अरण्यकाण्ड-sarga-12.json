    "titleDevanagari": "वाल्मीकि रामायण, अरण्यकाण्ड, सर्ग 12, श्लोक 17",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-12-shlok-17",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "प्रविवेश ततो रामः सीतया सह लक्ष्मणः॥१६॥",
          "प्रशान्तहरिणाकीर्णमाश्रमं ावलोकयन्।",
          "स तत्र ब्रह्मणः स्थानमग्नेः स्थानं तथैव च॥ १७॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-12",
    "chapterName": "अरण्यकाण्ड, सर्ग 12",
    "verseNumber": 17
  },
  {
    "id": "valmiki-ramayana-3-sarga-12-shlok-18",
    "collectionId": "valmiki-ramayana",
    "index": 7121,
    "titleDevanagari": "वाल्मीकि रामायण, अरण्यकाण्ड, सर्ग 12, श्लोक 18",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-12-shlok-18",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "विष्णोः स्थानं महेन्द्रस्य स्थानं चैव विवस्वतः।",
          "सोमस्थानं भगस्थानं स्थानं कौबेरमेव च ॥१८॥",
          "धातुर्विधातुः स्थानं च वायोः स्थानं तथैव च।",
          "स्थानं च पाशहस्तस्य वरुणस्य महात्मनः॥१९॥",
          "स्थानं तथैव गायत्र्या वसूनां स्थानमेव च।",
          "स्थानं च नागराजस्य गरुडस्थानमेव च ॥२०॥",
          "कार्तिकेयस्य च स्थानं धर्मस्थानं च पश्यति।"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-12",
    "chapterName": "अरण्यकाण्ड, सर्ग 12",
    "verseNumber": 18
  },
