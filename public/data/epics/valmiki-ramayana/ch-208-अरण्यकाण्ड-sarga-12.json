    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "ततः शिष्यादुपश्रुत्य प्राप्तं रामं सलक्ष्मणम्॥९॥",
          "वैदेहीं च महाभागामिदं वचनमब्रवीत्।"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-12",
    "chapterName": "अरण्यकाण्ड, सर्ग 12",
    "verseNumber": 9
  },
  {
    "id": "valmiki-ramayana-3-sarga-12-shlok-10",
