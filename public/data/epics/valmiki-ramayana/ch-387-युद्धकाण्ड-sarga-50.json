    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "अथोवाच महातेजा हरिराजो महाबलः।",
          "किमियं व्यथिता सेना मूढवातेव नौर्जले॥१॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-50",
    "chapterName": "युद्धकाण्ड, सर्ग 50",
    "verseNumber": 1
