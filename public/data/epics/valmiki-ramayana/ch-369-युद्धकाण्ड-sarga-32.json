    "slug": "valmiki-ramayana-6-sarga-32-shlok-4",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "सकामा भव कैकेयि हतोऽयं कुलनन्दनः।",
          "कुलमुत्सादितं सर्वं त्वया कलहशीलया॥४॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-32",
    "chapterName": "युद्धकाण्ड, सर्ग 32",
    "verseNumber": 4
  },
  {
