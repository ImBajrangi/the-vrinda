    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "आर्येण किं नु कैकेय्याः कृतं रामेण विप्रियम्।",
          "यन्मया चीरवसनं दत्त्वा प्रव्राजितो वनम्॥५॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-32",
    "chapterName": "युद्धकाण्ड, सर्ग 32",
    "verseNumber": 5
  },
