        "linesDevanagari": [
          "एवमुक्त्वा तु वैदेही वेपमाना तपस्विनी।",
          "जगाम जगतीं बाला छिन्ना तु कदली यथा॥६॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-32",
    "chapterName": "युद्धकाण्ड, सर्ग 32",
    "verseNumber": 6
  },
