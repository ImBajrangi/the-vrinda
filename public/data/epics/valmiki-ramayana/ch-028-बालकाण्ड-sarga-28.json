    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "मेघकृष्णाजिनधरा धारायज्ञोपवीतिनः।",
          "मारुतापूरितगुहाः प्राधीता इव पर्वताः॥१०॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-28",
    "chapterName": "बालकाण्ड, सर्ग 28",
    "verseNumber": 10
  },
