    "slug": "valmiki-ramayana-1-sarga-28-shlok-7",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "एषा घर्मपरिक्लिष्टा नववारिपरिप्लुता।",
          "सीतेव शोकसंतप्ता मही बाष्पं विमुञ्चति॥७॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-28",
    "chapterName": "बालकाण्ड, सर्ग 28",
    "verseNumber": 7
  },
  {
