    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "शचीसुतश्चापि तथा जयन्तस्तस्य सारथिम्।",
          "तं चापि रावणिः क्रुद्धः समन्तात् प्रत्यविध्यत॥११॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-28",
    "chapterName": "बालकाण्ड, सर्ग 28",
    "verseNumber": 11
  },
