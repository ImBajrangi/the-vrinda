    "slug": "valmiki-ramayana-1-sarga-28-shlok-9",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "तेषां युद्धं समभवत् सदृशं देवरक्षसाम्।",
          "महेन्द्रस्य च पुत्रस्य राक्षसेन्द्रसुतस्य च॥९॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-28",
    "chapterName": "बालकाण्ड, सर्ग 28",
    "verseNumber": 9
  },
