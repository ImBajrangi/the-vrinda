[
  {
    "id": "valmiki-ramayana-1-sarga-28-shlok-1",
    "collectionId": "valmiki-ramayana",
    "index": 1370,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 28, श्लोक 1",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-28-shlok-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "स तदा वालिनं हत्वा सुग्रीवमभिषिच्य च।",
          "वसन् माल्यवतः पृष्ठे रामो लक्ष्मणमब्रवीत्॥१॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-28",
    "chapterName": "बालकाण्ड, सर्ग 28",
    "verseNumber": 1
  },
  {
    "id": "valmiki-ramayana-1-sarga-28-shlok-2-2",
    "collectionId": "valmiki-ramayana",
    "index": 1371,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 28, श्लोक 2",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-28-shlok-2-2",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "सुमालिनं हतं दृष्ट्वा वसुना भस्मसात्कृतम्।",
          "स्वसैन्यं विद्रुतं चापि लक्षयित्वार्दितं सुरैः॥१॥",
          "ततः स बलवान् क्रुद्धो रावणस्य सुतस्तदा।",
          "निवर्त्य राक्षसान् सर्वान् मेघनादो व्यवस्थितः॥२॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-28",
    "chapterName": "बालकाण्ड, सर्ग 28",
    "verseNumber": 2
  },
  {
    "id": "valmiki-ramayana-1-sarga-28-shlok-3-1",
    "collectionId": "valmiki-ramayana",
    "index": 1372,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 28, श्लोक 3",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-28-shlok-3-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "नवमासधृतं गर्भं भास्करस्य गभस्तिभिः।",
          "पीत्वा रसं समुद्राणां द्यौः प्रसूते रसायनम्॥३॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-28",
    "chapterName": "बालकाण्ड, सर्ग 28",
    "verseNumber": 3
  },
  {
    "id": "valmiki-ramayana-1-sarga-28-shlok-4-1",
    "collectionId": "valmiki-ramayana",
    "index": 1373,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 28, श्लोक 4",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-28-shlok-4-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "ततः प्रविशतस्तस्य विविधायुधधारिणः।",
          "विदुद्रुवुर्दिशः सर्वा दर्शनादेव देवताः॥४॥",
          "न बभूव तदा कश्चिद् युयुत्सोरस्य सम्मुखे।",
          "सर्वानाविद्ध्य वित्रस्तांस्ततः शक्रोऽब्रवीत् सुरान्॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-28",
    "chapterName": "बालकाण्ड, सर्ग 28",
    "verseNumber": 4
  },
  {
    "id": "valmiki-ramayana-1-sarga-28-shlok-5",
    "collectionId": "valmiki-ramayana",
    "index": 1374,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 28, श्लोक 5",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-28-shlok-5",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "संध्यारागोत्थितैस्तानैरन्तेष्वपि च पाण्डुभिः।",
          "स्निग्धैरभ्रपटच्छेदैर्बद्धव्रणमिवाम्बरम्॥५॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-28",
    "chapterName": "बालकाण्ड, सर्ग 28",
    "verseNumber": 5
  },
  {
    "id": "valmiki-ramayana-1-sarga-28-shlok-6-1",
    "collectionId": "valmiki-ramayana",
    "index": 1375,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 28, श्लोक 6",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-28-shlok-6-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "न भेतव्यं न गन्तव्यं निवर्तध्वं रणे सुराः।",
          "एष गच्छति पुत्रो मे युद्धार्थमपराजितः॥६॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-28",
    "chapterName": "बालकाण्ड, सर्ग 28",
    "verseNumber": 6
  },
  {
    "id": "valmiki-ramayana-1-sarga-28-shlok-7",
