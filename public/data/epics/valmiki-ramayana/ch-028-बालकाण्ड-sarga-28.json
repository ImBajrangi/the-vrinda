    "slug": "valmiki-ramayana-1-sarga-28-shlok-8",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "ततस्ते त्रिदशाः सर्वे परिवार्य शचीसुतम्।",
          "रावणस्य सुतं युद्धे समासाद्य प्रजजिरे॥८॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-28",
    "chapterName": "बालकाण्ड, सर्ग 28",
    "verseNumber": 8
  },
