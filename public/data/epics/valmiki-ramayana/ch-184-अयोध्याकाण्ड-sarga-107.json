    "slug": "valmiki-ramayana-2-sarga-107-shlok-3",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "पुरा भ्रातः पिता नः स मातरं ते समुद्रहन्।",
          "मातामहे समाश्रौषीद् राज्यशुल्कमनुत्तमम्॥३॥"
        ]
      }
    ],
    "chapterId": "अयोध्याकाण्ड-sarga-107",
