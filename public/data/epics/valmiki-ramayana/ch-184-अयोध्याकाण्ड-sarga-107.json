    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "उपपन्नमिदं वाक्यं यस्त्वमेवमभाषथाः।",
          "जातः पुत्रो दशरथात् कैकेय्यां राजसत्तमात्॥ २॥"
        ]
      }
    ],
    "chapterId": "अयोध्याकाण्ड-sarga-107",
    "chapterName": "अयोध्याकाण्ड, सर्ग 107",
    "verseNumber": 2
  },
