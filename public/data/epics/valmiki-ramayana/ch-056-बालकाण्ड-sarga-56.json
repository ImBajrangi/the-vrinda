    "slug": "valmiki-ramayana-1-sarga-56-shlok-11",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "अन्योन्यमुपकुर्वन्ति स्नेहकारुण्ययन्त्रिताः।",
          "ततस्तस्योपकारार्थं त्यजतात्मानमात्मना॥११॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-56",
    "chapterName": "बालकाण्ड, सर्ग 56",
    "verseNumber": 11
  },
  {
