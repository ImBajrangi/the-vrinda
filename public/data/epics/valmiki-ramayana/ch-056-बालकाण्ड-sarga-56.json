    "slug": "valmiki-ramayana-1-sarga-56-shlok-9",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "वैदेह्याः प्रियकामेन कृतं कर्म जटायुषा।",
          "गृध्रराजेन यत् तत्र श्रुतं वस्तदशेषतः॥९॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-56",
    "chapterName": "बालकाण्ड, सर्ग 56",
    "verseNumber": 9
  },
