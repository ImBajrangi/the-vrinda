    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "स सुखी गृध्रराजस्तु रावणेन हतो रणे।",
          "मुक्तश्च सुग्रीवभयाद् गतश्च परमां गतिम्॥१३॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-56",
    "chapterName": "बालकाण्ड, सर्ग 56",
    "verseNumber": 13
