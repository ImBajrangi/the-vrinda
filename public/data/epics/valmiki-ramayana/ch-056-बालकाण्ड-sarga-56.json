    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 56, श्लोक 8",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-56-shlok-8",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "रामस्य न कृतं कार्यं न कृतं राजशासनम्।",
          "हरीणामियमज्ञाता विपत्तिः सहसाऽऽगता॥८॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-56",
    "chapterName": "बालकाण्ड, सर्ग 56",
    "verseNumber": 8
  },
  {
