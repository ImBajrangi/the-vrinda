    "slug": "valmiki-ramayana-1-sarga-56-shlok-10",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "तथा सर्वाणि भूतानि तिर्यग्योनिगतान्यपि।",
          "प्रियं कुर्वन्ति रामस्य त्यक्त्वा प्राणान् यथा वयम्॥१०॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-56",
    "chapterName": "बालकाण्ड, सर्ग 56",
    "verseNumber": 10
  },
