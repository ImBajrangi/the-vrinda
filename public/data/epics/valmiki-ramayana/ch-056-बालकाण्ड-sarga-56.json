[
  {
    "id": "valmiki-ramayana-1-sarga-56-shlok-1",
    "collectionId": "valmiki-ramayana",
    "index": 2433,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 56, श्लोक 1",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-56-shlok-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "एवमुक्तो वसिष्ठेन विश्वामित्रो महाबलः।",
          "आग्नेयमस्त्रमुद्दिश्य तिष्ठ तिष्ठति चाब्रवीत्॥१॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-56",
    "chapterName": "बालकाण्ड, सर्ग 56",
    "verseNumber": 1
  },
  {
    "id": "valmiki-ramayana-1-sarga-56-shlok-2",
    "collectionId": "valmiki-ramayana",
    "index": 2434,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 56, श्लोक 2",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-56-shlok-2",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "उपविष्टास्तु ते सर्वे यस्मिन् प्रायं गिरिस्थले।",
          "हरयो गृध्रराजश्च तं देशमुपचक्रमे॥१॥",
          "सम्पातिर्नाम नाम्ना तु चिरजीवी विहंगमः।",
          "भ्राता जटायुषः श्रीमान् विख्यातबलपौरुषः॥२॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-56",
    "chapterName": "बालकाण्ड, सर्ग 56",
    "verseNumber": 2
  },
  {
    "id": "valmiki-ramayana-1-sarga-56-shlok-3",
    "collectionId": "valmiki-ramayana",
    "index": 2435,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 56, श्लोक 3",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-56-shlok-3",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "कन्दरादभिनिष्क्रम्य स विन्ध्यस्य महागिरेः।",
          "उपविष्टान् हरीन् दृष्ट्वा हृष्टात्मा गिरमब्रवीत्॥३॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-56",
    "chapterName": "बालकाण्ड, सर्ग 56",
    "verseNumber": 3
  },
  {
    "id": "valmiki-ramayana-1-sarga-56-shlok-4-1",
    "collectionId": "valmiki-ramayana",
    "index": 2436,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 56, श्लोक 4",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-56-shlok-4-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "विधिः किल नरं लोके विधानेनानुवर्तते।",
          "यथायं विहितो भक्ष्यश्चिरान्मह्यमुपागतः॥४॥",
          "परम्पराणां भक्षिष्ये वानराणां मृतं मृतम्।",
          "उवाचैतद् वचः पक्षी तान् निरीक्ष्य प्लवंगमान्॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-56",
    "chapterName": "बालकाण्ड, सर्ग 56",
    "verseNumber": 4
  },
  {
    "id": "valmiki-ramayana-1-sarga-56-shlok-5",
    "collectionId": "valmiki-ramayana",
    "index": 2437,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 56, श्लोक 5",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-56-shlok-5",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "तस्यास्त्रं गाधिपुत्रस्य घोरमाग्नेयमुत्तमम्।",
          "ब्रह्मदण्डेन तच्छान्तमग्नेर्वेग इवाम्भसा॥५॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-56",
    "chapterName": "बालकाण्ड, सर्ग 56",
    "verseNumber": 5
  },
  {
    "id": "valmiki-ramayana-1-sarga-56-shlok-6-1",
    "collectionId": "valmiki-ramayana",
    "index": 2438,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 56, श्लोक 6",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-56-shlok-6-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "तस्य तद् वचनं श्रुत्वा भक्ष्यलुब्धस्य पक्षिणः।",
          "अङ्गदः परमायस्तो हनूमन्तमथाब्रवीत्॥६॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-56",
    "chapterName": "बालकाण्ड, सर्ग 56",
    "verseNumber": 6
  },
  {
    "id": "valmiki-ramayana-1-sarga-56-shlok-7-1",
    "collectionId": "valmiki-ramayana",
    "index": 2439,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 56, श्लोक 7",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-56-shlok-7-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "पश्य सीतापदेशेन साक्षाद् वैवस्वतो यमः।",
          "इमं देशमनुप्राप्तो वानराणां विपत्तये॥७॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-56",
    "chapterName": "बालकाण्ड, सर्ग 56",
    "verseNumber": 7
  },
  {
