    "slug": "valmiki-ramayana-1-sarga-56-shlok-12",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "प्रियं कृतं हि रामस्य धर्मज्ञेन जटायुषा।",
          "राघवार्थे परिश्रान्ता वयं संत्यक्तजीविताः॥१२॥",
          "कान्ताराणि प्रपन्नाः स्म न च पश्याम मैथिलीम्।"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-56",
    "chapterName": "बालकाण्ड, सर्ग 56",
    "verseNumber": 12
  },
