    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "जटायुषो विनाशेन राज्ञो दशरथस्य च।",
          "हरणेन च वैदेह्याः संशयं हरयो गताः॥१४॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-56",
    "chapterName": "बालकाण्ड, सर्ग 56",
    "verseNumber": 14
