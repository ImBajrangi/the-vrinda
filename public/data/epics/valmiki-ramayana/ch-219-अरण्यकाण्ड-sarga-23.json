    "slug": "valmiki-ramayana-3-sarga-23-shlok-12",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "कबन्धः परिघाभासो दृश्यते भास्करान्तिके॥ ११॥",
          "जग्राह सूर्यं स्वर्भानुरपर्वणि महाग्रहः ।",
          "प्रवाति मारुतः शीघ्रं निष्प्रभोऽभूद् दिवाकरः॥ १२॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-23",
    "chapterName": "अरण्यकाण्ड, सर्ग 23",
    "verseNumber": 12
