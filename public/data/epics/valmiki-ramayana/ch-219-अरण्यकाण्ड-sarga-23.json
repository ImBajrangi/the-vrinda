    "titleDevanagari": "वाल्मीकि रामायण, अरण्यकाण्ड, सर्ग 23, श्लोक 4",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-23-shlok-4",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "ततो ध्वजमुपागम्य हेमदण्डं समुच्छ्रितम्।",
          "समाक्रम्य महाकायस्तस्थौ गृध्रः सुदारुणः॥४॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-23",
    "chapterName": "अरण्यकाण्ड, सर्ग 23",
    "verseNumber": 4
  },
  {
    "id": "valmiki-ramayana-3-sarga-23-shlok-5",
    "collectionId": "valmiki-ramayana",
    "index": 7379,
    "titleDevanagari": "वाल्मीकि रामायण, अरण्यकाण्ड, सर्ग 23, श्लोक 5",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-23-shlok-5",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "जनस्थानसमीपे च समाक्रम्य खरस्वनाः।",
          "विस्वरान् विविधान् नादान् मांसादा मृगपक्षिणः॥५॥",
          "व्याजहरभिदीप्तायां दिशि वै भैरवस्वनम्।",
          "अशिवं यातुधानानां शिवा घोरा महास्वनाः॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-23",
    "chapterName": "अरण्यकाण्ड, सर्ग 23",
    "verseNumber": 5
  },
  {
