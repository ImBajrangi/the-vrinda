    "verseNumber": 15
  },
  {
    "id": "valmiki-ramayana-3-sarga-23-shlok-17",
    "collectionId": "valmiki-ramayana",
    "index": 7388,
    "titleDevanagari": "वाल्मीकि रामायण, अरण्यकाण्ड, सर्ग 23, श्लोक 17",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-23-shlok-17",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "प्रचचाल मही चापि सशैलवनकानना।",
          "खरस्य च रथस्थस्य नर्दमानस्य धीमतः॥१६॥",
          "प्राकम्पत भुजः सव्यः स्वरश्चास्यावसज्जत।",
          "साम्रा सम्पद्यते दृष्टिः पश्यमानस्य सर्वतः॥१७॥",
          "तान् समीक्ष्य महोत्पातानुत्थितान् रोमहर्षणान्॥ १८॥",
          "अब्रवीद् राक्षसान् सर्वान् प्रहसन् स खरस्तदा।"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-23",
    "chapterName": "अरण्यकाण्ड, सर्ग 23",
    "verseNumber": 17
  },
  {
    "id": "valmiki-ramayana-3-sarga-23-shlok-20",
