    "titleDevanagari": "वाल्मीकि रामायण, अरण्यकाण्ड, सर्ग 23, श्लोक 3",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-23-shlok-3",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "श्यामं रुधिरपर्यन्तं बभूव परिवेषणम्।",
          "अलातचक्रप्रतिमं प्रतिगृह्य दिवाकरम्॥३॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-23",
    "chapterName": "अरण्यकाण्ड, सर्ग 23",
    "verseNumber": 3
  },
  {
    "id": "valmiki-ramayana-3-sarga-23-shlok-4",
