    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-23-shlok-22",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "यन्निमित्तं तु रामस्य लक्ष्मणस्य विपर्ययः॥२२॥",
          "सकामा भगिनीमेऽस्तु पीत्वा त रुधिरं तयोः।"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-23",
