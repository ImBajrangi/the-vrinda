    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-23-shlok-23",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "॥ श्रीसीतारामचन्द्राभ्यां नमः॥",
          "श्रीमद्वाल्मीकीय रामायण",
          "अरण्यकाण्डम्",
          "त्रयोविंशः सर्गः (सर्ग 23)",
          "न क्वचित् प्राप्तपूर्वो मे संयुगेषु पराजयः॥२३॥",
          "युष्माकमेतत् प्रत्यक्षं नानृतं कथयाम्यहम्।",
          "इत्याचे श्रीमद्रामायणे वाल्मीकीये आदिकाव्येऽरण्यकाण्डे त्रयोविंशः सर्गः ॥२३॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-23",
    "chapterName": "अरण्यकाण्ड, सर्ग 23",
    "verseNumber": 23
  },
  {
    "id": "valmiki-ramayana-3-sarga-23-shlok-24",
