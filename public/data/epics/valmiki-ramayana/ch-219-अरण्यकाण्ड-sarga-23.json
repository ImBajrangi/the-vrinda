    "slug": "valmiki-ramayana-3-sarga-23-shlok-13",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "उत्पेतुश्च विना रात्रिं ताराः खद्योतसप्रभाः।",
          "संलीनमीनविहगा नलिन्यः शुष्कपङ्कजाः॥१३॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-23",
