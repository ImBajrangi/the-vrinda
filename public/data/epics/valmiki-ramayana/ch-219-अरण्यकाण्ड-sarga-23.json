    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "समेयुश्च महात्मानो युद्धदर्शनकांक्षिणः॥ २६ ॥",
          "ऋषयो देवगन्धर्वाः सिद्धाश्च सह चारणैः।",
