    "titleDevanagari": "वाल्मीकि रामायण, अरण्यकाण्ड, सर्ग 23, श्लोक 1",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-23-shlok-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "तत्प्रयातं बलं घोरमशिवं शोणितोदकम्।",
          "अभ्यवर्षन्महाघोरस्तुमलो गर्दभारुणः॥१॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-23",
    "chapterName": "अरण्यकाण्ड, सर्ग 23",
    "verseNumber": 1
  },
  {
    "id": "valmiki-ramayana-3-sarga-23-shlok-2",
    "collectionId": "valmiki-ramayana",
