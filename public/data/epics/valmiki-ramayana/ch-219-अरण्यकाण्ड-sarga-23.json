        "linesDevanagari": [
          "क्षतजार्द्रसवर्णाभा संध्या कालं विना बभौ।",
          "खरं चाभिमुखं नेदुस्तदा घोरा मृगाः खगाः॥९॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-23",
    "chapterName": "अरण्यकाण्ड, सर्ग 23",
    "verseNumber": 9
  },
  {
