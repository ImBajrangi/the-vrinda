      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "प्रभिन्नगजसंकाशास्तोयशोणितधारिणः।",
          "आकाशं तदनाकाशं चक्रुर्भीमाम्बुवाहकाः॥७॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-23",
    "chapterName": "अरण्यकाण्ड, सर्ग 23",
    "verseNumber": 7
