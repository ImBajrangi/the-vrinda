    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "बभूव तिमिरं घोरमुद्धतं रोमहर्षणम्।",
          "दिशो वा प्रदिशो वापि सुव्यक्तं न चकाशिरे॥ ८॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-23",
    "chapterName": "अरण्यकाण्ड, सर्ग 23",
    "verseNumber": 8
  },
