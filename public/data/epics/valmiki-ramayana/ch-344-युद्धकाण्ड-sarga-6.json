[
  {
    "id": "valmiki-ramayana-6-sarga-6-shlok-1",
    "collectionId": "valmiki-ramayana",
    "index": 11467,
    "titleDevanagari": "वाल्मीकि रामायण, युद्धकाण्ड, सर्ग 6, श्लोक 1",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-6-sarga-6-shlok-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "लङ्कायां तु कृतं कर्म घोरं दृष्ट्वा भयावहम्।",
          "राक्षसेन्द्रो हनुमता शक्रेणेव महात्मना।",
          "अब्रवीद् राक्षसान् सर्वान् ह्रिया किंचिदवाङ्मुखः॥१॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-6",
    "chapterName": "युद्धकाण्ड, सर्ग 6",
    "verseNumber": 1
  },
  {
    "id": "valmiki-ramayana-6-sarga-6-shlok-2",
    "collectionId": "valmiki-ramayana",
    "index": 11468,
    "titleDevanagari": "वाल्मीकि रामायण, युद्धकाण्ड, सर्ग 6, श्लोक 2",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-6-sarga-6-shlok-2",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "धर्षिता च प्रविष्टा च लङ्का दुष्प्रसहा पुरी।",
          "तेन वानरमात्रेण दृष्टा सीता च जानकी॥२॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-6",
    "chapterName": "युद्धकाण्ड, सर्ग 6",
    "verseNumber": 2
  },
  {
    "id": "valmiki-ramayana-6-sarga-6-shlok-3",
    "collectionId": "valmiki-ramayana",
    "index": 11469,
    "titleDevanagari": "वाल्मीकि रामायण, युद्धकाण्ड, सर्ग 6, श्लोक 3",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-6-sarga-6-shlok-3",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "प्रासादो धर्षितश्चैत्यः प्रवरा राक्षसा हताः।",
          "आविला च पुरी लङ्का सर्वा हनुमता कृता॥३॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-6",
    "chapterName": "युद्धकाण्ड, सर्ग 6",
    "verseNumber": 3
  },
  {
    "id": "valmiki-ramayana-6-sarga-6-shlok-4",
    "collectionId": "valmiki-ramayana",
    "index": 11470,
    "titleDevanagari": "वाल्मीकि रामायण, युद्धकाण्ड, सर्ग 6, श्लोक 4",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-6-sarga-6-shlok-4",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "किं करिष्यामि भद्रं वः किं वो युक्तमनन्तरम्।",
          "उच्यतां नः समर्थं यत् कृतं च सुकृतं भवेत्॥४॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-6",
    "chapterName": "युद्धकाण्ड, सर्ग 6",
    "verseNumber": 4
  },
  {
    "id": "valmiki-ramayana-6-sarga-6-shlok-5",
    "collectionId": "valmiki-ramayana",
    "index": 11471,
    "titleDevanagari": "वाल्मीकि रामायण, युद्धकाण्ड, सर्ग 6, श्लोक 5",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-6-sarga-6-shlok-5",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "मन्त्रमूलं च विजयं प्रवदन्ति मनस्विनः।",
          "तस्माद् वै रोचये मन्त्रं रामं प्रति महाबलाः॥५॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-6",
    "chapterName": "युद्धकाण्ड, सर्ग 6",
    "verseNumber": 5
  },
  {
    "id": "valmiki-ramayana-6-sarga-6-shlok-6",
    "collectionId": "valmiki-ramayana",
    "index": 11472,
    "titleDevanagari": "वाल्मीकि रामायण, युद्धकाण्ड, सर्ग 6, श्लोक 6",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-6-sarga-6-shlok-6",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "॥ श्रीसीतारामचन्द्राभ्यां नमः॥",
          "श्रीमद्वाल्मीकीय रामायण",
          "युद्धकाण्डम्",
          "षष्ठः सर्गः (6)",
          "त्रिविधाः पुरुषा लोके उत्तमाधममध्यमाः।",
          "तेषां तु समवेतानां गुणदोषौ वदाम्यहम्॥६॥",
          "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये युद्धकाण्डे षष्ठः सर्गः॥६॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-6",
    "chapterName": "युद्धकाण्ड, सर्ग 6",
    "verseNumber": 6
  },
  {
    "id": "valmiki-ramayana-6-sarga-6-shlok-8",
    "collectionId": "valmiki-ramayana",
    "index": 11473,
    "titleDevanagari": "वाल्मीकि रामायण, युद्धकाण्ड, सर्ग 6, श्लोक 8",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-6-sarga-6-shlok-8",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "मन्त्रस्त्रिभिर्हि संयुक्तः समर्थैर्मन्त्रनिर्णये।",
          "मित्रैर्वापि समानार्थैर्बान्धवैरपि वाधिकैः॥७॥",
          "सहितो मन्त्रयित्वा यः कर्मारम्भान् प्रवर्तयेत्।",
          "दैवे च कुरुते यत्नं तमाहुः पुरुषोत्तमम्॥८॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-6",
    "chapterName": "युद्धकाण्ड, सर्ग 6",
    "verseNumber": 8
  },
  {
    "id": "valmiki-ramayana-6-sarga-6-shlok-9",
    "collectionId": "valmiki-ramayana",
    "index": 11474,
    "titleDevanagari": "वाल्मीकि रामायण, युद्धकाण्ड, सर्ग 6, श्लोक 9",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-6-sarga-6-shlok-9",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "एकोऽर्थं विमृशेदेको धर्मे प्रकुरुते मनः।",
          "एकः कार्याणि कुरुते तमाहुर्मध्यमं नरम्॥९॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-6",
    "chapterName": "युद्धकाण्ड, सर्ग 6",
    "verseNumber": 9
  },
  {
