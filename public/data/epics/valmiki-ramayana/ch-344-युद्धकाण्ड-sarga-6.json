    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-6-sarga-6-shlok-10",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "गुणदोषौ न निश्चित्य त्यक्त्वा दैवव्यपाश्रयम्।",
          "करिष्यामीति यः कार्यमुपेक्षेत् स नराधमः॥१०॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-6",
    "chapterName": "युद्धकाण्ड, सर्ग 6",
    "verseNumber": 10
  },
  {
    "id": "valmiki-ramayana-6-sarga-6-shlok-11",
    "collectionId": "valmiki-ramayana",
    "index": 11476,
    "titleDevanagari": "वाल्मीकि रामायण, युद्धकाण्ड, सर्ग 6, श्लोक 11",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-6-sarga-6-shlok-11",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "यथेमे पुरुषा नित्यमुत्तमाधममध्यमाः।",
          "एवं मन्त्रोऽपि विज्ञेय उत्तमाधममध्यमः॥११॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-6",
    "chapterName": "युद्धकाण्ड, सर्ग 6",
    "verseNumber": 11
  },
  {
    "id": "valmiki-ramayana-6-sarga-6-shlok-12",
    "collectionId": "valmiki-ramayana",
    "index": 11477,
    "titleDevanagari": "वाल्मीकि रामायण, युद्धकाण्ड, सर्ग 6, श्लोक 12",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-6-sarga-6-shlok-12",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "ऐकमत्यमुपागम्य शास्त्रदृष्टेन चक्षुषा।",
          "मन्त्रिणो यत्र निरतास्तमाहुर्मन्त्रमुत्तमम्॥१२॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-6",
    "chapterName": "युद्धकाण्ड, सर्ग 6",
    "verseNumber": 12
  },
