    "slug": "valmiki-ramayana-6-sarga-6-shlok-17",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "तरिष्यति च सुव्यक्तं राघवः सागरं सुखम्।",
          "तरसा युक्तरूपेण सानुजः सबलानुगः॥१७॥"
        ]
      }
    ],
