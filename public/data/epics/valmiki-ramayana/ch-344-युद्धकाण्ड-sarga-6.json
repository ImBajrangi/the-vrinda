    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-6-sarga-6-shlok-16",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "वानराणां हि धीराणां सहस्रैः परिवारितः।",
          "रामोऽभ्येति पुरीं लङ्कामस्माकमुपरोधकः॥१६॥"
        ]
      }
    ],
