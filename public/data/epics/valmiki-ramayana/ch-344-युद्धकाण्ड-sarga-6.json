    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-6-sarga-6-shlok-13",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "बह्वीरपि मतीर्गत्वा मन्त्रिणामर्थनिर्णयः।",
          "पुनर्यत्रैकतां प्राप्तः स मन्त्रो मध्यमः स्मृतः॥१३॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-6",
    "chapterName": "युद्धकाण्ड, सर्ग 6",
    "verseNumber": 13
  },
  {
    "id": "valmiki-ramayana-6-sarga-6-shlok-14",
