    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-6-sarga-6-shlok-14",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "अन्योन्यमतिमास्थाय यत्र सम्प्रतिभाष्यते।",
          "न चैकमत्ये श्रेयोऽस्ति मन्त्रः सोऽधम उच्यते॥१४॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-6",
    "chapterName": "युद्धकाण्ड, सर्ग 6",
    "verseNumber": 14
  },
