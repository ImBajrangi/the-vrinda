    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-6-sarga-6-shlok-15",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "तस्मात् सुमन्त्रितं साधु भवन्तो मतिसत्तमाः।",
          "कार्य सम्प्रतिपद्यन्तमेतत् कृत्यं मतं मम॥१५॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-6",
