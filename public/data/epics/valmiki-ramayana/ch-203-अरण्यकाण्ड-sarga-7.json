    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "रामस्तु सहितो भ्रात्रा सीतया च परंतपः।",
          "सुतीक्ष्णस्याश्रमपदं जगाम सह तैर्द्विजैः॥१॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-7",
    "chapterName": "अरण्यकाण्ड, सर्ग 7",
    "verseNumber": 1
