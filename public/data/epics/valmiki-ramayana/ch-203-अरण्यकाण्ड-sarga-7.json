        "linesDevanagari": [
          "रामोऽहमस्मि भगवन् भवन्तं द्रष्टुमागतः।",
          "तन्माभिवद धर्मज्ञ महर्षे सत्यविक्रम॥६॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-7",
    "chapterName": "अरण्यकाण्ड, सर्ग 7",
    "verseNumber": 6
