    "slug": "valmiki-ramayana-3-sarga-7-shlok-7",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "॥ श्रीसीतारामचन्द्राभ्यां नमः॥",
          "श्रीमद्वाल्मीकीय रामायण",
          "अरण्यकाण्डम्",
          "सप्तमः सर्गः (सर्ग 7)",
          "स निरीक्ष्य ततो धीरो रामं धर्मभृतां वरम्।",
          "समाश्लिष्य च बाहुभ्यामिदं वचनमब्रवीत्॥७॥",
          "इत्याचे श्रीमद्रामायणे वाल्मीकीये आदिकाव्येऽरण्यकाण्डे सप्तमः सर्गः॥७॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-7",
    "chapterName": "अरण्यकाण्ड, सर्ग 7",
    "verseNumber": 7
  },
  {
