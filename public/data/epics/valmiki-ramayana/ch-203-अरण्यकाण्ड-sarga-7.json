    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "स गत्वा दूरमध्वानं नदीस्तीर्वा बहूदकाः।",
          "ददर्श विमलं शैलं महामेरुमिवोन्नतम्॥२॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-7",
