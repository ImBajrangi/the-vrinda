    "slug": "valmiki-ramayana-3-sarga-32-shlok-21",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "रावणं सर्वभूतानां सर्वलोकभयावहम्॥२१॥",
          "राक्षसी भ्रातरं क्रूरं सा ददर्श महाबलम्।"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-32",
