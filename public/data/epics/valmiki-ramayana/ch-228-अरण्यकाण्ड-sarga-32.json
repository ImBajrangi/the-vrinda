    "slug": "valmiki-ramayana-3-sarga-32-shlok-11",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "अहताङ्गैः समस्तैस्तं देवप्रहरणैस्तदा।",
          "अक्षोभ्याणां समुद्राणां क्षोभणं क्षिप्रकारिणम्॥ ११॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-32",
    "chapterName": "अरण्यकाण्ड, सर्ग 32",
    "verseNumber": 11
  },
  {
    "id": "valmiki-ramayana-3-sarga-32-shlok-12",
