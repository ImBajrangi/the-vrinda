    "slug": "valmiki-ramayana-3-sarga-32-shlok-16",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "चन्द्रसूर्यौ महाभागावुत्तिष्ठन्तौ परंतपौ॥१६॥",
          "निवारयति बाहभ्यां यः शैलशिखरोपमः।"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-32",
    "chapterName": "अरण्यकाण्ड, सर्ग 32",
    "verseNumber": 16
