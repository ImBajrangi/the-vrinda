    "titleDevanagari": "वाल्मीकि रामायण, अरण्यकाण्ड, सर्ग 32, श्लोक 2",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-32-shlok-2",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "ङ्के ततः शार्पणखा दृष्ट्या सहस्राणि चातुर्दशा ।",
          "हतान्येकेन रामेण रक्षसां भीमकर्मणाम्॥१॥",
          "दूषणं च खरं चैव हतं त्रिशिरसं रणे।",
          "दृष्ट्वा पुनर्महानादान् ननाद जलदोपमा॥२॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-32",
    "chapterName": "अरण्यकाण्ड, सर्ग 32",
    "verseNumber": 2
  },
  {
    "id": "valmiki-ramayana-3-sarga-32-shlok-3",
    "collectionId": "valmiki-ramayana",
    "index": 7641,
    "titleDevanagari": "वाल्मीकि रामायण, अरण्यकाण्ड, सर्ग 32, श्लोक 3",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-32-shlok-3",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "सा दृष्ट्वा कर्म रामस्य कृतमन्यैः सुदुष्करम्।",
          "जगाम परमोद्विग्ना लङ्कां रावणपालिताम्॥३॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-32",
    "chapterName": "अरण्यकाण्ड, सर्ग 32",
    "verseNumber": 3
  },
  {
    "id": "valmiki-ramayana-3-sarga-32-shlok-4",
    "collectionId": "valmiki-ramayana",
    "index": 7642,
    "titleDevanagari": "वाल्मीकि रामायण, अरण्यकाण्ड, सर्ग 32, श्लोक 4",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-32-shlok-4",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "सा ददर्श विमानाग्रे रावणं दीप्ततेजसम्।",
          "उपोपविष्टं सचिवैर्मरुद्भिरिव वासवम्॥४॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-32",
    "chapterName": "अरण्यकाण्ड, सर्ग 32",
    "verseNumber": 4
  },
  {
    "id": "valmiki-ramayana-3-sarga-32-shlok-5",
