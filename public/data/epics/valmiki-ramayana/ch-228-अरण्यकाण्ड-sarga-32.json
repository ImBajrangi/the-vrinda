    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-32-shlok-15",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "वनं चैत्ररथं दिव्यं नलिनी नन्दनं वनम्॥१५॥",
          "विनाशयति यः क्रोधाद् देवोद्यानानि वीर्यवान्।"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-32",
    "chapterName": "अरण्यकाण्ड, सर्ग 32",
    "verseNumber": 15
  },
