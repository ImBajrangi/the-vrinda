    "titleDevanagari": "वाल्मीकि रामायण, अरण्यकाण्ड, सर्ग 32, श्लोक 5",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-32-shlok-5",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "आसीनं सूर्यसंकाशे काञ्चने परमासने।",
          "रुक्मवेदिगतं प्राज्यं ज्वलन्तमिव पावकम्॥५॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-32",
    "chapterName": "अरण्यकाण्ड, सर्ग 32",
    "verseNumber": 5
  },
  {
    "id": "valmiki-ramayana-3-sarga-32-shlok-7",
    "collectionId": "valmiki-ramayana",
    "index": 7644,
    "titleDevanagari": "वाल्मीकि रामायण, अरण्यकाण्ड, सर्ग 32, श्लोक 7",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-32-shlok-7",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "देवगन्धर्वभूतानामृषीणां च महात्मनाम्।",
          "अजेयं समरे घोरं व्यात्ताननमिवान्तकम्॥६॥",
          "देवासुरविमर्देषु वज्राशनिकृतव्रणम्।",
          "ऐरावतविषाणाग्रैरुत्कृष्टकिणवक्षसम्॥७॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-32",
    "chapterName": "अरण्यकाण्ड, सर्ग 32",
    "verseNumber": 7
  },
  {
    "id": "valmiki-ramayana-3-sarga-32-shlok-9",
    "collectionId": "valmiki-ramayana",
    "index": 7645,
    "titleDevanagari": "वाल्मीकि रामायण, अरण्यकाण्ड, सर्ग 32, श्लोक 9",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-32-shlok-9",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "विंशद्भुजं दशग्रीवं दर्शनीयपरिच्छदम्।",
          "विशालवक्षसं वीरं राजलक्षणलक्षितम्॥८॥",
          "नद्धवैदूर्यसंकाशं तप्तकाञ्चनभूषणम्।",
          "सुभुजं शुक्लदशनं महास्यं पर्वतोपमम्॥९॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-32",
    "chapterName": "अरण्यकाण्ड, सर्ग 32",
    "verseNumber": 9
  },
  {
    "id": "valmiki-ramayana-3-sarga-32-shlok-10",
    "collectionId": "valmiki-ramayana",
    "index": 7646,
    "titleDevanagari": "वाल्मीकि रामायण, अरण्यकाण्ड, सर्ग 32, श्लोक 10",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-32-shlok-10",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "विष्णुचक्रनिपातैश्च शतशो देवसंयुगे।",
          "अन्यैः शस्त्रैः प्रहारैश्च महायुद्धेषु ताडितम्॥ १०॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-32",
    "chapterName": "अरण्यकाण्ड, सर्ग 32",
    "verseNumber": 10
  },
  {
    "id": "valmiki-ramayana-3-sarga-32-shlok-11",
