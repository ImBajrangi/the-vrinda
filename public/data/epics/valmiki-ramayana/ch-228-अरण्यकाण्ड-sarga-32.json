    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-32-shlok-12",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "क्षेप्तारं पर्वताग्राणां सुराणां च प्रमर्दनम्।",
          "उच्छेत्तारं च धर्माणां परदाराभिमर्शनम्॥१२॥",
          "सर्वदिव्यास्त्रयोक्तारं यज्ञविघ्नकरं सदा।",
          "पुरीं भोगवतीं गत्वा पराजित्य च वासुकिम्॥ १३॥",
          "तक्षकस्य प्रियां भार्यां पराजित्य जहार यः।"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-32",
    "chapterName": "अरण्यकाण्ड, सर्ग 32",
    "verseNumber": 12
  },
  {
    "id": "valmiki-ramayana-3-sarga-32-shlok-14",
    "collectionId": "valmiki-ramayana",
    "index": 7649,
    "titleDevanagari": "वाल्मीकि रामायण, अरण्यकाण्ड, सर्ग 32, श्लोक 14",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-32-shlok-14",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "कैलासं पर्वतं गत्वा विजित्य नरवाहनम्॥१४॥",
          "विमानं पुष्पकं तस्य कामगं वै जहार यः।"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-32",
    "chapterName": "अरण्यकाण्ड, सर्ग 32",
    "verseNumber": 14
  },
