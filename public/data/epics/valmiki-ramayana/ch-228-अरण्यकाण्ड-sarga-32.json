    "slug": "valmiki-ramayana-3-sarga-32-shlok-24",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "उपगम्याब्रवीद वाक्यं राक्षसी भयविह्वला।",
          "रावणं शत्रुहन्तारं मन्त्रिभिः परिवारितम्॥२४॥"
        ]
      }
    ],
