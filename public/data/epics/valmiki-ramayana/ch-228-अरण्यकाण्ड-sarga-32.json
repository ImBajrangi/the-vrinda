    "slug": "valmiki-ramayana-3-sarga-32-shlok-20",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "प्राप्तयज्ञहरं दुष्टं ब्रह्मघ्नं क्रूरकारिणम्॥२०॥",
          "कर्कशं निरनुक्रोशं प्रजानामहिते रतम्।"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-32",
