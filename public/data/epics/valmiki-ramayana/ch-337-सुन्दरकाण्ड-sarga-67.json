    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-5-sarga-67-shlok-18",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "एवमस्त्रविदां श्रेष्ठः सत्त्ववाञ्छीलवानपि॥१८॥",
          "किमर्थमस्त्रं रक्षःसु न योजयसि राघव।"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-67",
    "chapterName": "सुन्दरकाण्ड, सर्ग 67",
    "verseNumber": 18
  },
  {
    "id": "valmiki-ramayana-5-sarga-67-shlok-19",
    "collectionId": "valmiki-ramayana",
    "index": 11223,
    "titleDevanagari": "वाल्मीकि रामायण, सुन्दरकाण्ड, सर्ग 67, श्लोक 19",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-5-sarga-67-shlok-19",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "न दानवा न गन्धर्वा नासुरा न मरुद्गणाः॥१९॥",
          "तव राम रणे शक्तास्तथा प्रतिसमासितुम्।"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-67",
    "chapterName": "सुन्दरकाण्ड, सर्ग 67",
    "verseNumber": 19
  },
  {
    "id": "valmiki-ramayana-5-sarga-67-shlok-20",
    "collectionId": "valmiki-ramayana",
    "index": 11224,
    "titleDevanagari": "वाल्मीकि रामायण, सुन्दरकाण्ड, सर्ग 67, श्लोक 20",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-5-sarga-67-shlok-20",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "तव वीर्यवतः कश्चिन्मयि यद्यस्ति सम्भ्रमः॥२०॥",
          "क्षिप्रं सुनिशितैर्बाणैर्हन्यतां युधि रावणः।",
          "भ्रातुरादेशमाज्ञाय लक्ष्मणो वा परंतपः॥ २१॥",
          "स किमर्थं नरवरो न मां रक्षति राघवः।",
          "शक्तौ तौ पुरुषव्याघ्रौ वाय्वग्निसमतेजसौ॥ २२॥",
          "सुराणामपि दुर्धर्षों किमर्थं मामुपेक्षतः।",
          "ममैव दुष्कृतं किंचिन्महदस्ति न संशयः॥ २३॥",
          "समर्थौ सहितौ यन्मां न रक्षेते परंतपौ।"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-67",
    "chapterName": "सुन्दरकाण्ड, सर्ग 67",
    "verseNumber": 20
  },
