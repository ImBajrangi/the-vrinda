    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-5-sarga-67-shlok-11",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "ततस्तस्मिन् महाबाहो कोपसंवर्तितेक्षणः।",
          "वायसे त्वं व्यधाः क्रूरां मतिं मतिमतां वर॥११॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-67",
    "chapterName": "सुन्दरकाण्ड, सर्ग 67",
    "verseNumber": 11
  },
  {
    "id": "valmiki-ramayana-5-sarga-67-shlok-12",
    "collectionId": "valmiki-ramayana",
    "index": 11216,
    "titleDevanagari": "वाल्मीकि रामायण, सुन्दरकाण्ड, सर्ग 67, श्लोक 12",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-5-sarga-67-shlok-12",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "स दर्भसंस्तराद् गृह्य ब्रह्मास्त्रेण न्ययोजयः।",
          "स दीप्त इव कालाग्निर्जज्वालाभिमुखं खगम्॥१२॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-67",
    "chapterName": "सुन्दरकाण्ड, सर्ग 67",
    "verseNumber": 12
  },
  {
    "id": "valmiki-ramayana-5-sarga-67-shlok-13",
    "collectionId": "valmiki-ramayana",
    "index": 11217,
    "titleDevanagari": "वाल्मीकि रामायण, सुन्दरकाण्ड, सर्ग 67, श्लोक 13",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-5-sarga-67-shlok-13",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "स त्वं प्रदीप्तं चिक्षेप दर्भ तं वायसं प्रति।",
          "ततस्तु वायसं दीप्तः स दर्भोऽनुजगाम ह॥१३॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-67",
    "chapterName": "सुन्दरकाण्ड, सर्ग 67",
    "verseNumber": 13
  },
  {
    "id": "valmiki-ramayana-5-sarga-67-shlok-14",
    "collectionId": "valmiki-ramayana",
    "index": 11218,
    "titleDevanagari": "वाल्मीकि रामायण, सुन्दरकाण्ड, सर्ग 67, श्लोक 14",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-5-sarga-67-shlok-14",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "भीतैश्च सम्परित्यक्तः सुरैः सर्वैश्च वायसः।",
          "त्रील्लोकान् सम्परिक्रम्य त्रातारं नाधिगच्छति॥१४॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-67",
    "chapterName": "सुन्दरकाण्ड, सर्ग 67",
    "verseNumber": 14
  },
  {
    "id": "valmiki-ramayana-5-sarga-67-shlok-15",
    "collectionId": "valmiki-ramayana",
    "index": 11219,
    "titleDevanagari": "वाल्मीकि रामायण, सुन्दरकाण्ड, सर्ग 67, श्लोक 15",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-5-sarga-67-shlok-15",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "पुनरप्यागतस्तत्र त्वत्सकाशमरिंदम।",
          "त्वं तं निपतितं भूमौ शरण्यः शरणागतम्॥१५॥",
          "वधार्हमपि काकुत्स्थ कृपया परिपालयः।"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-67",
    "chapterName": "सुन्दरकाण्ड, सर्ग 67",
    "verseNumber": 15
  },
  {
    "id": "valmiki-ramayana-5-sarga-67-shlok-16",
    "collectionId": "valmiki-ramayana",
    "index": 11220,
    "titleDevanagari": "वाल्मीकि रामायण, सुन्दरकाण्ड, सर्ग 67, श्लोक 16",
