    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-5-sarga-67-shlok-17",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "राम त्वां स नमस्कृत्य राज्ञो दशरथस्य च॥१७॥",
          "विसृष्टस्तु तदा काकः प्रतिपेदे स्वमालयम्।"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-67",
    "chapterName": "सुन्दरकाण्ड, सर्ग 67",
    "verseNumber": 17
  },
  {
    "id": "valmiki-ramayana-5-sarga-67-shlok-18",
