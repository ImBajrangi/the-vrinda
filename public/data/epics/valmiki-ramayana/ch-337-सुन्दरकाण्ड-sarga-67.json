[
  {
    "id": "valmiki-ramayana-5-sarga-67-shlok-1",
    "collectionId": "valmiki-ramayana",
    "index": 11206,
    "titleDevanagari": "वाल्मीकि रामायण, सुन्दरकाण्ड, सर्ग 67, श्लोक 1",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-5-sarga-67-shlok-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "एवमुक्तस्तु हनुमान् राघवेण महात्मना।",
          "सीताया भाषितं सर्वं न्यवेदयत राघवे॥१॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-67",
    "chapterName": "सुन्दरकाण्ड, सर्ग 67",
    "verseNumber": 1
  },
  {
    "id": "valmiki-ramayana-5-sarga-67-shlok-2",
    "collectionId": "valmiki-ramayana",
    "index": 11207,
    "titleDevanagari": "वाल्मीकि रामायण, सुन्दरकाण्ड, सर्ग 67, श्लोक 2",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-5-sarga-67-shlok-2",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "इदमुक्तवती देवी जानकी पुरुषर्षभ।",
          "पूर्ववृत्तमभिज्ञानं चित्रकूटे यथातथम्॥२॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-67",
    "chapterName": "सुन्दरकाण्ड, सर्ग 67",
    "verseNumber": 2
  },
  {
    "id": "valmiki-ramayana-5-sarga-67-shlok-3",
    "collectionId": "valmiki-ramayana",
    "index": 11208,
    "titleDevanagari": "वाल्मीकि रामायण, सुन्दरकाण्ड, सर्ग 67, श्लोक 3",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-5-sarga-67-shlok-3",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "सुखसुप्ता त्वया सार्धं जानकी पूर्वमुत्थिता।",
          "वायसः सहसोत्पत्य विददार स्तनान्तरम्॥३॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-67",
    "chapterName": "सुन्दरकाण्ड, सर्ग 67",
    "verseNumber": 3
  },
  {
    "id": "valmiki-ramayana-5-sarga-67-shlok-4",
    "collectionId": "valmiki-ramayana",
    "index": 11209,
    "titleDevanagari": "वाल्मीकि रामायण, सुन्दरकाण्ड, सर्ग 67, श्लोक 4",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-5-sarga-67-shlok-4",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "पर्यायेण च सुप्तस्त्वं देव्यङ्के भरताग्रज।",
          "पुनश्च किल पक्षी स देव्या जनयति व्यथा॥४॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-67",
    "chapterName": "सुन्दरकाण्ड, सर्ग 67",
    "verseNumber": 4
  },
  {
    "id": "valmiki-ramayana-5-sarga-67-shlok-5",
    "collectionId": "valmiki-ramayana",
    "index": 11210,
    "titleDevanagari": "वाल्मीकि रामायण, सुन्दरकाण्ड, सर्ग 67, श्लोक 5",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-5-sarga-67-shlok-5",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "ततः पुनरुपागम्य विददार भृशं किल।",
          "ततस्त्वं बोधितस्तस्याः शोणितेन समुक्षितः॥५॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-67",
    "chapterName": "सुन्दरकाण्ड, सर्ग 67",
    "verseNumber": 5
  },
  {
    "id": "valmiki-ramayana-5-sarga-67-shlok-6",
    "collectionId": "valmiki-ramayana",
    "index": 11211,
    "titleDevanagari": "वाल्मीकि रामायण, सुन्दरकाण्ड, सर्ग 67, श्लोक 6",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-5-sarga-67-shlok-6",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "वायसेन च तेनैवं सततं बाध्यमानया।",
          "बोधितः किल देव्या त्वं सुखसुप्तः परंतप॥६॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-67",
    "chapterName": "सुन्दरकाण्ड, सर्ग 67",
    "verseNumber": 6
  },
  {
    "id": "valmiki-ramayana-5-sarga-67-shlok-7",
    "collectionId": "valmiki-ramayana",
    "index": 11212,
    "titleDevanagari": "वाल्मीकि रामायण, सुन्दरकाण्ड, सर्ग 67, श्लोक 7",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-5-sarga-67-shlok-7",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "तां च दृष्ट्वा महाबाहो दारितां च स्तनान्तरे।",
          "आशीविष इव क्रुद्धस्ततो वाक्यं त्वमूचिवान्॥७॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-67",
    "chapterName": "सुन्दरकाण्ड, सर्ग 67",
    "verseNumber": 7
  },
  {
    "id": "valmiki-ramayana-5-sarga-67-shlok-8",
    "collectionId": "valmiki-ramayana",
    "index": 11213,
    "titleDevanagari": "वाल्मीकि रामायण, सुन्दरकाण्ड, सर्ग 67, श्लोक 8",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-5-sarga-67-shlok-8",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "नखाग्रैः केन ते भीरु दारितं वै स्तनान्तरम्।",
          "कः क्रीडति सरोषेण पञ्चवक्त्रेण भोगिना॥८॥",
          "निरीक्षमाणः सहसा वायसं समुदैक्षथाः।",
          "नखैः सरुधिरैस्तीक्ष्णैस्तामेवाभिमुखं स्थितम्॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-67",
    "chapterName": "सुन्दरकाण्ड, सर्ग 67",
    "verseNumber": 8
  },
  {
    "id": "valmiki-ramayana-5-sarga-67-shlok-10",
    "collectionId": "valmiki-ramayana",
    "index": 11214,
    "titleDevanagari": "वाल्मीकि रामायण, सुन्दरकाण्ड, सर्ग 67, श्लोक 10",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-5-sarga-67-shlok-10",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "सुतः किल स शक्रस्य वायसः पततां वरः।",
          "धरान्तरगतः शीघ्रं पवनस्य गतौ समः॥१०॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-67",
    "chapterName": "सुन्दरकाण्ड, सर्ग 67",
    "verseNumber": 10
  },
  {
