    "slug": "valmiki-ramayana-5-sarga-67-shlok-16",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "मोघमस्त्रं न शक्यं तु कर्तुमित्येव राघव॥१६॥",
          "भवांस्तस्याक्षि काकस्य हिनस्ति स्म स दक्षिणम्।"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-67",
    "chapterName": "सुन्दरकाण्ड, सर्ग 67",
    "verseNumber": 16
  },
  {
    "id": "valmiki-ramayana-5-sarga-67-shlok-17",
