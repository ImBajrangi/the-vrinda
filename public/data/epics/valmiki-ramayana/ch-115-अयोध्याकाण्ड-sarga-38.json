    "slug": "valmiki-ramayana-2-sarga-38-shlok-5",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "इयं हि कस्यापि करोति किंचित् तपस्विनी राजवरस्य पुत्री।",
          "या चीरमासाद्य जनस्य मध्ये स्थिता विसंज्ञा श्रमणीव काचित् ॥५॥"
        ]
      }
    ],
    "chapterId": "अयोध्याकाण्ड-sarga-38",
    "chapterName": "अयोध्याकाण्ड, सर्ग 38",
    "verseNumber": 5
  },
