    "slug": "valmiki-ramayana-2-sarga-38-shlok-6",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "चीराण्यपास्याज्जनकस्य कन्या नेयं प्रतिज्ञा मम दत्तपूर्वा ।",
          "यथासुखं गच्छतु राजपुत्री वनं समग्रा सह सर्वरत्नैः॥६॥"
        ]
      }
    ],
    "chapterId": "अयोध्याकाण्ड-sarga-38",
    "chapterName": "अयोध्याकाण्ड, सर्ग 38",
    "verseNumber": 6
  },
  {
