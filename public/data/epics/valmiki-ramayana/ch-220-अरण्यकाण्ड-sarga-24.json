    "slug": "valmiki-ramayana-3-sarga-24-shlok-3",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "इमान् पश्य महाबाहो सर्वभूतापहारिणः।",
          "समुत्थितान् महोत्पातान् संहर्तुं सर्वराक्षसान्॥३॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-24",
    "chapterName": "अरण्यकाण्ड, सर्ग 24",
    "verseNumber": 3
  },
