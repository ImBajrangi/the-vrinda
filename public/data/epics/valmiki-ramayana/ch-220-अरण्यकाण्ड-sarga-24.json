    "slug": "valmiki-ramayana-3-sarga-24-shlok-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "आश्रमं प्रतियाते तु खरे खरपराक्रमे।",
          "तानेवौत्पातिकान् रामः सह भ्रात्रा ददर्श ह॥१॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-24",
    "chapterName": "अरण्यकाण्ड, सर्ग 24",
    "verseNumber": 1
  },
  {
