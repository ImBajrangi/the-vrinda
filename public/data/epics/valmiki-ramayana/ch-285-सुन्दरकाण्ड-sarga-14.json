[
  {
    "id": "valmiki-ramayana-5-sarga-14-shlok-1",
    "collectionId": "valmiki-ramayana",
    "index": 9429,
    "titleDevanagari": "वाल्मीकि रामायण, सुन्दरकाण्ड, सर्ग 14, श्लोक 1",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-5-sarga-14-shlok-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "स मुहूर्तमिव ध्यात्वा मनसा चाधिगम्य ताम्।",
          "अवप्लुतो महातेजाः प्राकारं तस्य वेश्मनः॥१॥",
          "स तु संहृष्टसर्वांगः प्राकारस्थो महाकपिः।",
          "पुष्पिताग्रान् वसन्तादौ ददर्श विविधान् द्रुमान्॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-14",
    "chapterName": "सुन्दरकाण्ड, सर्ग 14",
    "verseNumber": 1
  },
  {
    "id": "valmiki-ramayana-5-sarga-14-shlok-4",
    "collectionId": "valmiki-ramayana",
    "index": 9430,
    "titleDevanagari": "वाल्मीकि रामायण, सुन्दरकाण्ड, सर्ग 14, श्लोक 4",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-5-sarga-14-shlok-4",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "सालानशोकान् भव्यांश्च चम्पकांश्च सुपुष्पितान्।",
          "उद्दालकान् नागवृक्षांश्चूतान् कपिमुखानपि॥३॥",
          "तथाऽऽम्रवणसम्पन्नॉल्लताशतसमन्वितान्।",
          "ज्यामुक्त इव नाराचः पुप्लुवे वृक्षवाटिकाम्॥४॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-14",
    "chapterName": "सुन्दरकाण्ड, सर्ग 14",
    "verseNumber": 4
  },
  {
    "id": "valmiki-ramayana-5-sarga-14-shlok-6",
    "collectionId": "valmiki-ramayana",
    "index": 9431,
    "titleDevanagari": "वाल्मीकि रामायण, सुन्दरकाण्ड, सर्ग 14, श्लोक 6",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-5-sarga-14-shlok-6",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "स प्रविश्य विचित्रां तां विहगैरभिनादिताम्।",
          "राजतैः काञ्चनैश्चैव पादपैः सर्वतो वृताम्॥५॥",
          "विहगैगसङ्घश्च विचित्रां चित्रकाननाम्।",
          "उदितादित्यसंकाशां ददर्श हनुमान् बली॥६॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-14",
    "chapterName": "सुन्दरकाण्ड, सर्ग 14",
    "verseNumber": 6
  },
  {
