      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "प्रहृष्टमनुजां काले मृगपक्षिमदाकुलाम्।",
          "मत्तबर्हिणसंघुष्टां नानाद्विजगणायुताम्॥८॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-14",
    "chapterName": "सुन्दरकाण्ड, सर्ग 14",
    "verseNumber": 8
  },
  {
