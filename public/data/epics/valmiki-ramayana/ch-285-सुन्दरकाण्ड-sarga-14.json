    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "उत्पतद्भिर्द्धिजगणैः पक्षैर्वातैः समाहताः।",
          "अनेकवर्णा विविधा मुमुचुः पुष्पवृष्टयः॥१०॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-14",
    "chapterName": "सुन्दरकाण्ड, सर्ग 14",
    "verseNumber": 10
