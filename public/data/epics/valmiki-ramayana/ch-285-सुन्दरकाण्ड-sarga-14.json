      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "पुष्पावकीर्णः शुशुभे हनूमान् मारुतात्मजः।",
          "अशोकवनिकामध्ये यथा पुष्पमयो गिरिः॥११॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-14",
    "chapterName": "सुन्दरकाण्ड, सर्ग 14",
    "verseNumber": 11
  },
