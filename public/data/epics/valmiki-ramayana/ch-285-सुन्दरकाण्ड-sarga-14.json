    "slug": "valmiki-ramayana-5-sarga-14-shlok-15",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "निर्धूतपत्रशिखराः शीर्णपुष्पफलद्रुमाः।",
          "निक्षिप्तवस्त्राभरणा धूर्ता इव पराजिताः॥१५॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-14",
