    "slug": "valmiki-ramayana-5-sarga-14-shlok-7",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "वृतां नानाविधैर्वृक्षैः पुष्पोपगफलोपगैः।",
          "कोकिलै ङ्गराजैश्च मत्तैर्नित्यनिषेविताम्॥७॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-14",
    "chapterName": "सुन्दरकाण्ड, सर्ग 14",
    "verseNumber": 7
  },
