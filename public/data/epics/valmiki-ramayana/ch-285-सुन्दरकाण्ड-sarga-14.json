    "slug": "valmiki-ramayana-5-sarga-14-shlok-14",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "॥ श्रीसीतारामचन्द्राभ्यां नमः॥",
          "श्रीमद्वाल्मीकीय रामायण",
          "सुन्दरकाण्डम्",
          "चतुर्दशः सर्गः (14)",
          "तरस्विना ते तरवस्तरसा बहु कम्पिताः।",
          "कुसुमानि विचित्राणि ससृजुः कपिना तदा॥१४॥",
          "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये सुन्दरकाण्डे चतुर्दशः सर्गः॥१४॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-14",
    "chapterName": "सुन्दरकाण्ड, सर्ग 14",
    "verseNumber": 14
  },
  {
