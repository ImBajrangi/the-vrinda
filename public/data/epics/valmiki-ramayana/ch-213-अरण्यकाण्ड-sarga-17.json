    "slug": "valmiki-ramayana-3-sarga-17-shlok-13",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "शरीरजसमाविष्टा राक्षसी राममब्रवीत्।",
          "जटी तापसवेषेण सभार्यः शरचापधृक् ॥१२॥",
          "आगतस्त्वमिमं देशं कथं राक्षससेवितम्।",
          "किमागमनकृत्यं ते तत्त्वमाख्यातुमर्हसि ॥१३॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-17",
    "chapterName": "अरण्यकाण्ड, सर्ग 17",
    "verseNumber": 13
  },
