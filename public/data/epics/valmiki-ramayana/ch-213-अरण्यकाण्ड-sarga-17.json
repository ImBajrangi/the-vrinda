    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "दीप्तास्यं च महाबाहुं पद्मपत्रायतेक्षणम्।",
          "गजविक्रान्तगमनं जटामण्डलधारिणम्॥७॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-17",
    "chapterName": "अरण्यकाण्ड, सर्ग 17",
    "verseNumber": 7
  },
