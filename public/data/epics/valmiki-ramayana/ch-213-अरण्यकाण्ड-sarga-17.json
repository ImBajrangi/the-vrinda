    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-17-shlok-2",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "आश्रमं तमुपागम्य राघवः सहलक्ष्मणः।",
          "कृत्वा पौर्वाणिकं कर्म पर्णशालामुपागमत्॥ २॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-17",
    "chapterName": "अरण्यकाण्ड, सर्ग 17",
    "verseNumber": 2
  },
  {
    "id": "valmiki-ramayana-3-sarga-17-shlok-4",
    "collectionId": "valmiki-ramayana",
    "index": 7254,
    "titleDevanagari": "वाल्मीकि रामायण, अरण्यकाण्ड, सर्ग 17, श्लोक 4",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-17-shlok-4",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "उवास सुखितस्तत्र पूज्यमानो महर्षिभिः।",
          "स रामः पर्णशालायामासीनः सह सीतया॥३॥",
          "विरराज महाबाहुश्चित्रया चन्द्रमा इव।",
          "लक्ष्मणेन सह भ्रात्रा चकार विविधाः कथाः॥ ४॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-17",
    "chapterName": "अरण्यकाण्ड, सर्ग 17",
    "verseNumber": 4
  },
  {
    "id": "valmiki-ramayana-3-sarga-17-shlok-6",
    "collectionId": "valmiki-ramayana",
    "index": 7255,
    "titleDevanagari": "वाल्मीकि रामायण, अरण्यकाण्ड, सर्ग 17, श्लोक 6",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-17-shlok-6",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "तदासीनस्य रामस्य कथासंसक्तचेतसः।",
          "तं देशं राक्षसी काचिदाजगाम यदृच्छया॥५॥",
          "सा तु शूर्पणखा नाम दशग्रीवस्य रक्षसः।",
          "भगिनी राममासाद्य ददर्श त्रिदशोपमम्॥६॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-17",
    "chapterName": "अरण्यकाण्ड, सर्ग 17",
    "verseNumber": 6
  },
