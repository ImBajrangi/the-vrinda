[
  {
    "id": "valmiki-ramayana-3-sarga-61-shlok-2",
    "collectionId": "valmiki-ramayana",
    "index": 8412,
    "titleDevanagari": "वाल्मीकि रामायण, अरण्यकाण्ड, सर्ग 61, श्लोक 2",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-61-shlok-2",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "दृष्ट्वाऽऽश्रमपदं शून्यं रामो दशरथात्मजः।",
          "रहितां पर्णशालां च प्रविद्धान्यासनानि च॥१॥",
          "अदृष्ट्वा तत्र वैदेहीं संनिरीक्ष्य च सर्वशः।",
          "उवाच रामः प्राक्रुश्य प्रगृह्य रुचिरौ भुजौ॥२॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-61",
    "chapterName": "अरण्यकाण्ड, सर्ग 61",
    "verseNumber": 2
  },
  {
    "id": "valmiki-ramayana-3-sarga-61-shlok-3",
    "collectionId": "valmiki-ramayana",
    "index": 8413,
    "titleDevanagari": "वाल्मीकि रामायण, अरण्यकाण्ड, सर्ग 61, श्लोक 3",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-61-shlok-3",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "क्व नु लक्ष्मण वैदेही कं वा देशमितो गता।",
          "केनाहृता वा सौमित्रे भक्षिता केन वा प्रिया॥३॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-61",
    "chapterName": "अरण्यकाण्ड, सर्ग 61",
    "verseNumber": 3
  },
  {
    "id": "valmiki-ramayana-3-sarga-61-shlok-4",
    "collectionId": "valmiki-ramayana",
    "index": 8414,
    "titleDevanagari": "वाल्मीकि रामायण, अरण्यकाण्ड, सर्ग 61, श्लोक 4",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-61-shlok-4",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "वृक्षणावार्य यदि मां सीते हसितुमिच्छसि।",
          "अलं ते हसितेनाद्य मां भजस्व सुदुःखितम्॥४॥",
          "यैः परिक्रीडसे सीते विश्वस्तैमूंगपोतकैः।",
          "एते हीनास्त्वया सौम्ये ध्यायन्त्यस्राविलेक्षणाः॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-61",
    "chapterName": "अरण्यकाण्ड, सर्ग 61",
    "verseNumber": 4
  },
  {
    "id": "valmiki-ramayana-3-sarga-61-shlok-6",
    "collectionId": "valmiki-ramayana",
    "index": 8415,
    "titleDevanagari": "वाल्मीकि रामायण, अरण्यकाण्ड, सर्ग 61, श्लोक 6",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-61-shlok-6",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "सीतया रहितोऽहं वै नहि जीवामि लक्ष्मण।",
          "वृतं शोकेन महता सीताहरणजेन माम्॥६॥",
          "परलोके महाराजो नूनं द्रक्ष्यति मे पिता।"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-61",
    "chapterName": "अरण्यकाण्ड, सर्ग 61",
    "verseNumber": 6
  },
  {
    "id": "valmiki-ramayana-3-sarga-61-shlok-7",
    "collectionId": "valmiki-ramayana",
    "index": 8416,
    "titleDevanagari": "वाल्मीकि रामायण, अरण्यकाण्ड, सर्ग 61, श्लोक 7",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-61-shlok-7",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "कथं प्रतिज्ञां संश्रुत्य मया त्वमभियोजितः॥७॥",
          "अपूरयित्वा तं कालं मत्सकाशमिहागतः।।"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-61",
    "chapterName": "अरण्यकाण्ड, सर्ग 61",
    "verseNumber": 7
  },
  {
    "id": "valmiki-ramayana-3-sarga-61-shlok-8",
    "collectionId": "valmiki-ramayana",
    "index": 8417,
    "titleDevanagari": "वाल्मीकि रामायण, अरण्यकाण्ड, सर्ग 61, श्लोक 8",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-61-shlok-8",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "कामवृत्तमनार्यं वा मृषावादिनमेव च॥८॥",
          "धिक् त्वामिति परे लोके व्यक्तं वक्ष्यति मे पिता।"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-61",
    "chapterName": "अरण्यकाण्ड, सर्ग 61",
    "verseNumber": 8
  },
  {
    "id": "valmiki-ramayana-3-sarga-61-shlok-10",
    "collectionId": "valmiki-ramayana",
    "index": 8418,
    "titleDevanagari": "वाल्मीकि रामायण, अरण्यकाण्ड, सर्ग 61, श्लोक 10",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-61-shlok-10",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "विवशं शोकसंतप्तं दीनं भग्नमनोरथम्॥९॥",
          "मामिहोत्सृज्य करुणं कीर्तिनरमिवानृजुम्।",
          "क्व गच्छसि वरारोहे मा मोत्सृज सुमध्यमे॥ १०॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-61",
    "chapterName": "अरण्यकाण्ड, सर्ग 61",
    "verseNumber": 10
  },
  {
    "id": "valmiki-ramayana-3-sarga-61-shlok-11",
    "collectionId": "valmiki-ramayana",
    "index": 8419,
    "titleDevanagari": "वाल्मीकि रामायण, अरण्यकाण्ड, सर्ग 61, श्लोक 11",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-61-shlok-11",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "त्वया विरहितश्चाहं त्यक्ष्ये जीवितमात्मनः।",
          "इतीव विलपन् रामः सीतादर्शनलालसः॥११॥",
          "न ददर्श सुदुःखार्तो राघवो जनकात्मजाम्।"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-61",
    "chapterName": "अरण्यकाण्ड, सर्ग 61",
    "verseNumber": 11
  },
  {
    "id": "valmiki-ramayana-3-sarga-61-shlok-13",
    "collectionId": "valmiki-ramayana",
