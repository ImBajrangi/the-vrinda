    "titleDevanagari": "वाल्मीकि रामायण, अरण्यकाण्ड, सर्ग 61, श्लोक 13",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-61-shlok-13",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "अनासादयमानं तं सीतां शोकपरायणम्॥१२॥",
          "पङ्कमासाद्य विपुलं सीदन्तमिव कुञ्जरम्।",
          "लक्ष्मणो राममत्यर्थमुवाच हितकाम्यया॥१३॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-61",
    "chapterName": "अरण्यकाण्ड, सर्ग 61",
    "verseNumber": 13
  },
  {
    "id": "valmiki-ramayana-3-sarga-61-shlok-14",
    "collectionId": "valmiki-ramayana",
    "index": 8421,
    "titleDevanagari": "वाल्मीकि रामायण, अरण्यकाण्ड, सर्ग 61, श्लोक 14",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-61-shlok-14",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "मा विषादं महाबुद्धे कुरु यत्नं मया सह।",
          "इदं गिरिवरं वीर बहुकन्दरशोभितम्॥१४॥",
          "प्रियकाननसंचारा वनोन्मत्ता च मैथिली।",
          "सा वनं वा प्रविष्टा स्यान्नलिनी वा सुपुष्पिताम्॥ १५॥",
          "सरितं वापि सम्प्राप्ता मीनवञ्जलसेविताम्।",
          "वित्रासयितुकामा वा लीना स्यात् कानने क्वचित्॥१६॥",
          "जिज्ञासमाना वैदेही त्वां मां च पुरुषर्षभ।"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-61",
    "chapterName": "अरण्यकाण्ड, सर्ग 61",
    "verseNumber": 14
  },
