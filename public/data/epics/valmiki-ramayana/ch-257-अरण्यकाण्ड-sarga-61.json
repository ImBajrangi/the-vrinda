    "slug": "valmiki-ramayana-3-sarga-61-shlok-17",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "तस्या ह्यन्वेषणे श्रीमन् क्षिप्रमेव यतावहे ॥१७॥",
          "वनं सर्वं विचिनुवो यत्र सा जनकात्मजा।"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-61",
    "chapterName": "अरण्यकाण्ड, सर्ग 61",
    "verseNumber": 17
  },
