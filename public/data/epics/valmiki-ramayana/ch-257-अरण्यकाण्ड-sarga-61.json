    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-61-shlok-21",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "तौ वनानि गिरीश्चैव सरितश्च सरांसि च।",
          "निखिलेन विचिन्वन्तौ सीतां दशरथात्मजौ॥ २०॥",
          "तस्य शैलस्य सानूनि शिलाश्च शिखराणि च।",
          "निखिलेन विचिन्वन्तौ नैव तामभिजग्मतुः॥ २१॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-61",
    "chapterName": "अरण्यकाण्ड, सर्ग 61",
    "verseNumber": 21
  },
