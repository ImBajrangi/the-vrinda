    "slug": "valmiki-ramayana-3-sarga-61-shlok-19",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "मन्यसे यदि काकुत्स्थ मा स्म शोके मनः कृथाः॥१८॥",
          "एवमुक्तः स सौहार्दाल्लक्ष्मणेन समाहितः।",
          "सह सौमित्रिणा रामो विचेतुमुपचक्रमे॥१९॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-61",
    "chapterName": "अरण्यकाण्ड, सर्ग 61",
    "verseNumber": 19
  },
  {
