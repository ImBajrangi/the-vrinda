    "slug": "valmiki-ramayana-2-sarga-9-shlok-6",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "किं न स्मरसि कैकेयि स्मरन्ती वा निगृहसे।",
          "यदुच्यमानमात्मार्थं मत्तस्त्वं श्रोतुमिच्छसि॥६॥",
          "मयोच्यमानं यदि ते श्रोतुं छन्दो विलासिनि।"
        ]
      }
    ],
    "chapterId": "अयोध्याकाण्ड-sarga-9",
    "chapterName": "अयोध्याकाण्ड, सर्ग 9",
    "verseNumber": 6
  },
