    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "एवमुक्ता तु कैकेयी क्रोधेन ज्वलितानना।",
          "दीर्घमुष्णं विनिःश्वस्य मन्थरामिदमब्रवीत्॥१॥"
        ]
      }
    ],
    "chapterId": "अयोध्याकाण्ड-sarga-9",
    "chapterName": "अयोध्याकाण्ड, सर्ग 9",
    "verseNumber": 1
  },
  {
