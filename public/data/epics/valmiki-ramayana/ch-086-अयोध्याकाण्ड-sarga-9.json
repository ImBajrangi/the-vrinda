      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "इदं त्विदानीं सम्पश्य केनोपायेन साधये।",
          "भरतः प्राप्नुयाद् राज्यं न तु रामः कथंचन॥३॥"
        ]
      }
    ],
    "chapterId": "अयोध्याकाण्ड-sarga-9",
    "chapterName": "अयोध्याकाण्ड, सर्ग 9",
    "verseNumber": 3
  },
  {
