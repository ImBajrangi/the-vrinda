    "slug": "valmiki-ramayana-2-sarga-9-shlok-2",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "अद्य राममितः क्षिप्रं वनं प्रस्थापयाम्यहम्।",
          "यौवराज्येन भरतं क्षिप्रमद्याभिषेचये॥२॥"
        ]
      }
    ],
    "chapterId": "अयोध्याकाण्ड-sarga-9",
