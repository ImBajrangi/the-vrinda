    "slug": "valmiki-ramayana-2-sarga-9-shlok-4",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "एवमुक्ता तु सा देव्या मन्थरा पापदर्शिनी।",
          "रामार्थमुपहिंसन्ती कैकेयीमिदमब्रवीत्॥४॥",
          "हन्तेदानीं प्रपश्य त्वं कैकेयि श्रूयतां वचः।",
          "यथा ते भरतो राज्यं पुत्रः प्राप्स्यति केवलम्॥"
        ]
      }
    ],
    "chapterId": "अयोध्याकाण्ड-sarga-9",
    "chapterName": "अयोध्याकाण्ड, सर्ग 9",
    "verseNumber": 4
  },
  {
    "id": "valmiki-ramayana-2-sarga-9-shlok-6",
