      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "यदि ते धर्मलाभं तु यशश्च परमं भुवि॥१५॥",
          "स्थिरमिच्छसि राजेन्द्र रामं मे दातुमर्हसि।"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-19",
    "chapterName": "बालकाण्ड, सर्ग 19",
