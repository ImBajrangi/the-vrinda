      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "ततः प्रवृत्तं सुमहद् युद्धं युद्धविशारद ॥१३॥",
          "अनरण्यस्य नृपते राक्षसेन्द्रस्य चाद्भुतम्।"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-19",
    "chapterName": "बालकाण्ड, सर्ग 19",
