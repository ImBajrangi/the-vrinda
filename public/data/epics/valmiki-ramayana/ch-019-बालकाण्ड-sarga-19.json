    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-19-shlok-12-2",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "नागानां दशसाहस्रं वाजिनां नियुतं तथा।",
          "रथानां बहुसाहस्रं पत्तीनां च नरोत्तम॥१२॥",
          "महीं संछाद्य निष्क्रान्तं सपदातिरथं रणे।"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-19",
    "chapterName": "बालकाण्ड, सर्ग 19",
    "verseNumber": 12
  },
