    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 19, श्लोक 1",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-19-shlok-1-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "अथ जित्वा मरुत्तं स प्रययौ राक्षसाधिपः।",
          "नगराणि नरेन्द्राणां युद्धकाङ्क्षी दशाननः॥१॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-19",
    "chapterName": "बालकाण्ड, सर्ग 19",
    "verseNumber": 1
  },
  {
    "id": "valmiki-ramayana-1-sarga-19-shlok-2",
    "collectionId": "valmiki-ramayana",
    "index": 955,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 19, श्लोक 2",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-19-shlok-2",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "अश्मभिः परिभिन्नाङ्गः पादपैराहतो भृशम्।",
          "रामबाणेन चाक्रान्तो जीवितान्ते मुमोह सः॥२॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-19",
    "chapterName": "बालकाण्ड, सर्ग 19",
    "verseNumber": 2
  },
  {
    "id": "valmiki-ramayana-1-sarga-19-shlok-3-2",
    "collectionId": "valmiki-ramayana",
    "index": 956,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 19, श्लोक 3",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-19-shlok-3-2",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "समासाद्य तु राजेन्द्रान् महेन्द्रवरुणोपमान्।",
          "अब्रवीद् राक्षसेन्द्रस्तु युद्धं मे दीयतामिति॥२॥",
          "निर्जिताः स्मेति वा ब्रूत एष मे हि सुनिश्चयः।",
          "अन्यथा कुर्वतामेवं मोक्षो नैवोपपद्यते॥३॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-19",
    "chapterName": "बालकाण्ड, सर्ग 19",
    "verseNumber": 3
  },
  {
    "id": "valmiki-ramayana-1-sarga-19-shlok-4-2",
    "collectionId": "valmiki-ramayana",
    "index": 957,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 19, श्लोक 4",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-19-shlok-4-2",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "ततस्त्वभीरवः प्राज्ञाः पार्थिवा धर्मनिश्चयाः।",
          "मन्त्रयित्वा ततोऽन्योन्यं राजानः सुमहाबलाः॥४॥",
          "निर्जिताः स्मेत्यभाषन्त ज्ञात्वा वरबलं रिपोः।"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-19",
    "chapterName": "बालकाण्ड, सर्ग 19",
    "verseNumber": 4
  },
  {
    "id": "valmiki-ramayana-1-sarga-19-shlok-5-1",
    "collectionId": "valmiki-ramayana",
    "index": 958,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 19, श्लोक 5",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-19-shlok-5-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "दुष्यन्तः सुरथो गाधिर्गयो राजा पुरूरवाः॥५॥",
          "एते सर्वेऽब्रुवंस्तात निर्जिताः स्मेति पार्थिवाः।"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-19",
    "chapterName": "बालकाण्ड, सर्ग 19",
    "verseNumber": 5
  },
  {
    "id": "valmiki-ramayana-1-sarga-19-shlok-6-1",
    "collectionId": "valmiki-ramayana",
    "index": 959,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 19, श्लोक 6",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-19-shlok-6-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "सा ददर्श ततस्त्रस्तान् हरीनापततो द्रुतम्।",
          "यूथादेव परिभ्रष्टान् मृगान् निहतयूथपान्॥६॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-19",
    "chapterName": "बालकाण्ड, सर्ग 19",
    "verseNumber": 6
  },
  {
    "id": "valmiki-ramayana-1-sarga-19-shlok-7-1",
    "collectionId": "valmiki-ramayana",
    "index": 960,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 19, श्लोक 7",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-19-shlok-7-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "तानुवाच समासाद्य दुःखितान् दुःखिता सती।",
          "रामवित्रासितान् सर्वाननुबद्धानिवेषुभिः॥७॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-19",
    "chapterName": "बालकाण्ड, सर्ग 19",
    "verseNumber": 7
  },
  {
    "id": "valmiki-ramayana-1-sarga-19-shlok-8",
    "collectionId": "valmiki-ramayana",
    "index": 961,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 19, श्लोक 8",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-19-shlok-8",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "अथायोध्यां समासाद्य रावणो राक्षसाधिपः॥६॥",
          "सुगुप्तामनरण्येन शक्रेणेवामरावतीम्।",
          "स तं पुरुषशार्दूलं पुरंदरसमं बले॥७॥",
          "प्राह राजानमासाद्य युद्धं देहीति रावणः।",
          "निर्जितोऽस्मीति वा ब्रूहि त्वमेवं मम शासनम्॥८॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-19",
    "chapterName": "बालकाण्ड, सर्ग 19",
    "verseNumber": 8
  },
  {
    "id": "valmiki-ramayana-1-sarga-19-shlok-9-1",
    "collectionId": "valmiki-ramayana",
    "index": 962,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 19, श्लोक 9",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-19-shlok-9-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "अयोध्याधिपतिस्तस्य श्रुत्वा पापात्मनो वचः।",
          "अनरण्यस्तु संक्रुद्धो राक्षसेन्द्रमथाब्रवीत्॥९॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-19",
    "chapterName": "बालकाण्ड, सर्ग 19",
    "verseNumber": 9
  },
  {
    "id": "valmiki-ramayana-1-sarga-19-shlok-10",
