    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-19-shlok-10",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "दीयते इन्द्रयुद्धं ते राक्षसाधिपते मया।",
          "संतिष्ठ क्षिप्रमायत्तो भव चैवं भवाम्यहम्॥१०॥",
          "अथ पूर्वं श्रुतार्थेन निर्जितं सुमहद् बलम्।",
          "निष्क्रामत् तन्नरेन्द्रस्य बलं रक्षोवधोद्यतम्॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-19",
    "chapterName": "बालकाण्ड, सर्ग 19",
    "verseNumber": 10
  },
  {
    "id": "valmiki-ramayana-1-sarga-19-shlok-11",
    "collectionId": "valmiki-ramayana",
    "index": 964,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 19, श्लोक 11",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-19-shlok-11",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "जीवपुत्रे निवर्तस्व पुत्रं रक्षस्व चाङ्गदम्।",
          "अन्तको रामरूपेण हत्वा नयति वालिनम्॥११॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-19",
    "chapterName": "बालकाण्ड, सर्ग 19",
    "verseNumber": 11
  },
  {
