      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "तुरंगखुरविध्वस्तं रथनेमिसमुत्थितम्॥१०॥",
          "रुरोध कर्णनेत्राणि युध्यतां धरणीरजः।"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-44",
    "chapterName": "युद्धकाण्ड, सर्ग 44",
    "verseNumber": 10
