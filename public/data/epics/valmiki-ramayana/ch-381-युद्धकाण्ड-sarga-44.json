    "slug": "valmiki-ramayana-6-sarga-44-shlok-9",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "लक्ष्मणश्चापि रामश्च शरैराशीविषोपमैः॥९॥",
          "दृश्यादृश्यानि रक्षांसि प्रवराणि निजघ्नतुः।"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-44",
    "chapterName": "युद्धकाण्ड, सर्ग 44",
    "verseNumber": 9
  },
