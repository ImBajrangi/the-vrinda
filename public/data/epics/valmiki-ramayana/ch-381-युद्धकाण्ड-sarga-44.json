        "stanzaNumber": 1,
        "linesDevanagari": [
          "वर्तमाने तथा घोरे संग्रामे लोमहर्षणे।",
          "रुधिरौघा महाघोरा नद्यस्तत्र विसुस्रुवुः॥११॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-44",
    "chapterName": "युद्धकाण्ड, सर्ग 44",
    "verseNumber": 11
