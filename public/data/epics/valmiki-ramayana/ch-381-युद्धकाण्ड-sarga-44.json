    "titleDevanagari": "वाल्मीकि रामायण, युद्धकाण्ड, सर्ग 44, श्लोक 1",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-6-sarga-44-shlok-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "युध्यतामेव तेषां तु तदा वानररक्षसाम्।",
          "रविरस्तं गतो रात्रिः प्रवृत्ता प्राणहारिणी॥१॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-44",
    "chapterName": "युद्धकाण्ड, सर्ग 44",
    "verseNumber": 1
  },
  {
    "id": "valmiki-ramayana-6-sarga-44-shlok-2",
    "collectionId": "valmiki-ramayana",
    "index": 12632,
    "titleDevanagari": "वाल्मीकि रामायण, युद्धकाण्ड, सर्ग 44, श्लोक 2",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-6-sarga-44-shlok-2",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "अन्योन्यं बद्धवैराणां घोराणं जयमिच्छताम्।",
          "सम्प्रवृत्तं निशायुद्धं तदा वानररक्षसाम्॥२॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-44",
    "chapterName": "युद्धकाण्ड, सर्ग 44",
    "verseNumber": 2
  },
  {
    "id": "valmiki-ramayana-6-sarga-44-shlok-3",
    "collectionId": "valmiki-ramayana",
    "index": 12633,
    "titleDevanagari": "वाल्मीकि रामायण, युद्धकाण्ड, सर्ग 44, श्लोक 3",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-6-sarga-44-shlok-3",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "राक्षसोऽसीति हरयो वानरोऽसीति राक्षसाः।",
          "अन्योन्यं समरे जघ्नुस्तस्मिंस्तमसि दारुणे॥३॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-44",
    "chapterName": "युद्धकाण्ड, सर्ग 44",
    "verseNumber": 3
  },
  {
