    "index": 12636,
    "titleDevanagari": "वाल्मीकि रामायण, युद्धकाण्ड, सर्ग 44, श्लोक 6",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-6-sarga-44-shlok-6",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "तस्मिंस्तमसि दुष्पारे राक्षसाः क्रोधमिर्च्छताः।",
          "परिपेतुर्महावेगा भक्षयन्तः प्लवङ्गमान्॥६॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-44",
    "chapterName": "युद्धकाण्ड, सर्ग 44",
    "verseNumber": 6
  },
  {
    "id": "valmiki-ramayana-6-sarga-44-shlok-7",
