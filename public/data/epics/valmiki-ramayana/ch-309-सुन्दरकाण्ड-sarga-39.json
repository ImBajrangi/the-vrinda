    "slug": "valmiki-ramayana-5-sarga-39-shlok-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "मणिं दत्त्वा ततः सीता हनूमन्तमथाब्रवीत्।",
          "अभिज्ञानमभिज्ञातमेतद् रामस्य तत्त्वतः॥१॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-39",
    "chapterName": "सुन्दरकाण्ड, सर्ग 39",
    "verseNumber": 1
  },
  {
