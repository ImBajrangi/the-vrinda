    "slug": "valmiki-ramayana-5-sarga-39-shlok-2",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "मणिं दृष्ट्वा तु रामो वै त्रयाणां संस्मरिष्यति।",
          "वीरो जनन्या मम च राज्ञो दशरथस्य च॥२॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-39",
    "chapterName": "सुन्दरकाण्ड, सर्ग 39",
    "verseNumber": 2
  },
  {
