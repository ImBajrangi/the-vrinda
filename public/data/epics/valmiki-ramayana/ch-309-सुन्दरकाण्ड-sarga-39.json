    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "हनूमन् यत्नमास्थाय दुःखक्षयकरो भव।",
          "स तथेति प्रतिज्ञाय मारुतिर्भीमविक्रमः॥५॥",
          "शिरसाऽऽवन्द्य वैदेहीं गमनायोपचक्रमे।"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-39",
    "chapterName": "सुन्दरकाण्ड, सर्ग 39",
    "verseNumber": 5
  },
