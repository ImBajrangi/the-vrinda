    "slug": "valmiki-ramayana-1-sarga-8-shlok-2",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "संरक्तनयनः क्रोधाच्चलन्मौलिर्निशाचरः।",
          "पद्मनाभमिदं प्राह वचनं पुरुषोत्तमम्॥२॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-8",
    "chapterName": "बालकाण्ड, सर्ग 8",
    "verseNumber": 2
  },
  {
