    "slug": "valmiki-ramayana-1-sarga-8-shlok-4-2",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "पराङ्मुखवधं पापं यः करोति सुरेश्वर।",
          "स हन्ता न गतः स्वर्गं लभते पुण्यकर्मणाम्॥४॥",
          "युद्धश्रद्धाथवा तेऽस्ति शङ्खचक्रगदाधर।",
          "अहं स्थितोऽस्मि पश्यामि बलं दर्शय यत् तव॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-8",
    "chapterName": "बालकाण्ड, सर्ग 8",
    "verseNumber": 4
  },
  {
    "id": "valmiki-ramayana-1-sarga-8-shlok-5",
