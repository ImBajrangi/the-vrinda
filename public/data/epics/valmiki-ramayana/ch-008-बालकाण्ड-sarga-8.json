    "slug": "valmiki-ramayana-1-sarga-8-shlok-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "हन्यमाने बले तस्मिन् पद्मनाभेन पृष्ठतः।",
          "माल्यवान् संनिवृत्तोऽथ वेलामेत्य इवार्णवः॥१॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-8",
    "chapterName": "बालकाण्ड, सर्ग 8",
    "verseNumber": 1
  },
  {
    "id": "valmiki-ramayana-1-sarga-8-shlok-2",
