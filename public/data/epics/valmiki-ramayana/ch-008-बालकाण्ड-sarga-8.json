    "slug": "valmiki-ramayana-1-sarga-8-shlok-3",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "नारायण न जानीषे क्षात्रधर्मं पुरातनम्।",
          "अयुद्धमनसो भीतानस्मान् हंसि यथेतरः॥३॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-8",
    "chapterName": "बालकाण्ड, सर्ग 8",
    "verseNumber": 3
  },
  {
