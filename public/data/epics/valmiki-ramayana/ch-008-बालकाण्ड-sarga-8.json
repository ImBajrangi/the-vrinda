    "slug": "valmiki-ramayana-1-sarga-8-shlok-5",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "ततः सुमन्त्रस्त्वरितं गत्वा त्वरितविक्रमः।",
          "समानयत् स तान् सर्वान् समस्तान् वेदपारगान्॥५॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-8",
    "chapterName": "बालकाण्ड, सर्ग 8",
    "verseNumber": 5
  },
