    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "माल्यवन्तं स्थितं दृष्ट्वा माल्यवन्तमिवाचलम्।",
          "उवाच राक्षसेन्द्रं तं देवराजानुजो बली॥६॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-8",
    "chapterName": "बालकाण्ड, सर्ग 8",
    "verseNumber": 6
  },
