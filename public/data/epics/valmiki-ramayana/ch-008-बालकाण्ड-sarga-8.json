      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "युष्मत्तो भयभीतानां देवानां वै मयाभयम्।",
          "राक्षसोत्सादनं दत्तं तदेतदनुपाल्यते॥७॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-8",
    "chapterName": "बालकाण्ड, सर्ग 8",
    "verseNumber": 7
