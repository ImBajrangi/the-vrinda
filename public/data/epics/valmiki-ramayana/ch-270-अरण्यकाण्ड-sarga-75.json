    "index": 8763,
    "titleDevanagari": "वाल्मीकि रामायण, अरण्यकाण्ड, सर्ग 75, श्लोक 8",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-75-shlok-8",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "नित्यं वालिभयात् त्रस्तश्चतुर्भिः सह वानरैः।",
          "अहं त्वरे च तं द्रष्टुं सुग्रीवं वानरर्षभम्॥८॥",
          "तदधीनं हि मे कार्यं सीतायाः परिमार्गणम्।"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-75",
    "chapterName": "अरण्यकाण्ड, सर्ग 75",
    "verseNumber": 8
  },
  {
