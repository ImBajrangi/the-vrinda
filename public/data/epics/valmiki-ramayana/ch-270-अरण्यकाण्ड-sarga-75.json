    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-75-shlok-6",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "हृदये मे नरव्याघ्र शुभमाविर्भविष्यति।",
          "तदागच्छ गमिष्यावः पम्पां तां प्रियदर्शनाम्॥६॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-75",
    "chapterName": "अरण्यकाण्ड, सर्ग 75",
    "verseNumber": 6
  },
