    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "कोयष्टिभिश्चार्जुनकैः शतपत्रैश्च कीरकैः।",
          "एतैश्चान्यैश्च बहुभिर्नादितं तद् वनं महत्॥ १२॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-75",
    "chapterName": "अरण्यकाण्ड, सर्ग 75",
    "verseNumber": 12
  },
  {
