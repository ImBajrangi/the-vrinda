    "slug": "valmiki-ramayana-3-sarga-75-shlok-11",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "आश्रमात्तु ततस्तस्मान्निष्क्रम्य स विशाम्पतिः॥ १०॥",
          "आजगाम ततः पम्पां लक्ष्मणेन सह प्रभुः।",
          "समीक्षमाणः पुष्पाढ्यं सर्वतो विपुलद्रुमम्॥११॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-75",
    "chapterName": "अरण्यकाण्ड, सर्ग 75",
    "verseNumber": 11
  },
  {
    "id": "valmiki-ramayana-3-sarga-75-shlok-12",
