    "titleDevanagari": "वाल्मीकि रामायण, अरण्यकाण्ड, सर्ग 75, श्लोक 2",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-75-shlok-2",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "दिवं तु तस्यां यातायां शबर्यां स्वेन तेजसा।",
          "लक्ष्मणेन सह भ्रात्रा चिन्तयामास राघवः॥१॥",
          "चिन्तयित्वा तु धर्मात्मा प्रभावं तं महात्मनाम्।",
          "हितकारिणमेकाग्रं लक्ष्मणं राघवोऽब्रवीत्॥२॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-75",
    "chapterName": "अरण्यकाण्ड, सर्ग 75",
    "verseNumber": 2
  },
  {
    "id": "valmiki-ramayana-3-sarga-75-shlok-3",
    "collectionId": "valmiki-ramayana",
    "index": 8759,
    "titleDevanagari": "वाल्मीकि रामायण, अरण्यकाण्ड, सर्ग 75, श्लोक 3",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-75-shlok-3",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "दृष्टो मयाऽऽश्रमः सौम्य बह्वाश्चर्यः कृतात्मनाम्।",
          "विश्वस्तमृगशार्दूलो नानाविहगसेवितः॥३॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-75",
    "chapterName": "अरण्यकाण्ड, सर्ग 75",
    "verseNumber": 3
  },
  {
    "id": "valmiki-ramayana-3-sarga-75-shlok-5",
    "collectionId": "valmiki-ramayana",
    "index": 8760,
    "titleDevanagari": "वाल्मीकि रामायण, अरण्यकाण्ड, सर्ग 75, श्लोक 5",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-75-shlok-5",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "सप्तानां च समुद्राणां तेषां तीर्थेषु लक्ष्मण।",
          "उपस्पृष्टं च विधिवत् पितरश्चापि तर्पिताः॥४॥",
          "प्रणष्टमशुभं यन्नः कल्याणं समुपस्थितम्।",
          "तेन त्वेतत् प्रहृष्टं मे मनो लक्ष्मण सम्प्रति॥५॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-75",
    "chapterName": "अरण्यकाण्ड, सर्ग 75",
    "verseNumber": 5
  },
  {
