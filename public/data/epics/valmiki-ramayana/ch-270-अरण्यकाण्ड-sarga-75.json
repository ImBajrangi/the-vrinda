    "slug": "valmiki-ramayana-3-sarga-75-shlok-7",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "ऋष्यमूको गिरिर्यत्र नातिदूरे प्रकाशते।",
          "यस्मिन् वसति धर्मात्मा सुग्रीवोंऽशुमतः सुतः॥ ७॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-75",
    "chapterName": "अरण्यकाण्ड, सर्ग 75",
    "verseNumber": 7
  },
  {
    "id": "valmiki-ramayana-3-sarga-75-shlok-8",
