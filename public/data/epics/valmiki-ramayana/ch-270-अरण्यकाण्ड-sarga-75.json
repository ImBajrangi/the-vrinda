          "मतङ्गसरसं नाम ह्रदं समवगाहत॥१४॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-75",
    "chapterName": "अरण्यकाण्ड, सर्ग 75",
    "verseNumber": 14
