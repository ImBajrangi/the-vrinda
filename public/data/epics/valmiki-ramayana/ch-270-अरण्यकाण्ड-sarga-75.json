    "slug": "valmiki-ramayana-3-sarga-75-shlok-13",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "स रामो विविधान् वृक्षान् सरांसि विविधानि च।",
          "पश्यन् कामाभिसंतप्तो जगाम परमं ह्रदम्॥ १३॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-75",
    "chapterName": "अरण्यकाण्ड, सर्ग 75",
    "verseNumber": 13
  },
  {
