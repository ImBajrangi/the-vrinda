      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "॥ श्रीसीतारामचन्द्राभ्यां नमः॥",
          "श्रीमद्वाल्मीकीय रामायण",
          "सुन्दरकाण्डम्",
          "पञ्चाशः सर्गः (सर्ग 50)",
          "इत्याचे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये सुन्दरकाण्डे पञ्चाशः सर्गः॥५०॥"
        ]
      }
