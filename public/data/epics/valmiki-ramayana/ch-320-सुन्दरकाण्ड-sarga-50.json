[
  {
    "id": "valmiki-ramayana-5-sarga-50-shlok-1",
    "collectionId": "valmiki-ramayana",
    "index": 10582,
    "titleDevanagari": "वाल्मीकि रामायण, सुन्दरकाण्ड, सर्ग 50, श्लोक 1",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-5-sarga-50-shlok-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "तमुद्रीक्ष्य महाबाहुः पिङ्गाक्षं पुरतः स्थितम्।",
          "रोषेण महताऽऽविष्टो रावणो लोकरावणः॥१॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-50",
    "chapterName": "सुन्दरकाण्ड, सर्ग 50",
    "verseNumber": 1
  },
  {
    "id": "valmiki-ramayana-5-sarga-50-shlok-3",
    "collectionId": "valmiki-ramayana",
    "index": 10583,
    "titleDevanagari": "वाल्मीकि रामायण, सुन्दरकाण्ड, सर्ग 50, श्लोक 3",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-5-sarga-50-shlok-3",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "शङ्काहतात्मा दध्यौ स कपीन्द्रं तेजसा वृतम्।",
          "किमेष भगवान् नन्दी भवेत् साक्षादिहागतः॥",
          "येन शप्तोऽस्मि कैलासे मया प्रहसिते पुरा।",
          "सोऽयं वानरमर्तिः स्यात्किंस्विद बाणोऽपि वासुरः॥३॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-50",
    "chapterName": "सुन्दरकाण्ड, सर्ग 50",
    "verseNumber": 3
  },
  {
    "id": "valmiki-ramayana-5-sarga-50-shlok-4",
    "collectionId": "valmiki-ramayana",
    "index": 10584,
    "titleDevanagari": "वाल्मीकि रामायण, सुन्दरकाण्ड, सर्ग 50, श्लोक 4",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-5-sarga-50-shlok-4",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "स राजा रोषताम्राक्षः प्रहस्तं मन्त्रिसत्तमम्।",
          "कालयुक्तमुवाचेदं वचो विपुलमर्थवत्॥४॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-50",
    "chapterName": "सुन्दरकाण्ड, सर्ग 50",
    "verseNumber": 4
  },
  {
    "id": "valmiki-ramayana-5-sarga-50-shlok-5",
    "collectionId": "valmiki-ramayana",
    "index": 10585,
    "titleDevanagari": "वाल्मीकि रामायण, सुन्दरकाण्ड, सर्ग 50, श्लोक 5",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-5-sarga-50-shlok-5",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "दुरात्मा पृच्छ्यतामेष कुतः किं वास्य कारणम्।",
          "वनभङ्गे च कोऽस्यार्थो राक्षसानां च तर्जने॥५॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-50",
    "chapterName": "सुन्दरकाण्ड, सर्ग 50",
    "verseNumber": 5
  },
  {
    "id": "valmiki-ramayana-5-sarga-50-shlok-6",
    "collectionId": "valmiki-ramayana",
    "index": 10586,
    "titleDevanagari": "वाल्मीकि रामायण, सुन्दरकाण्ड, सर्ग 50, श्लोक 6",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-5-sarga-50-shlok-6",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "मत्पुरीमप्रधृष्यां वै गमने किं प्रयोजनम्।",
          "आयोधने वा कं कार्यं पृच्छयतामेष दुर्मतिः॥६॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-50",
    "chapterName": "सुन्दरकाण्ड, सर्ग 50",
    "verseNumber": 6
  },
  {
    "id": "valmiki-ramayana-5-sarga-50-shlok-7",
    "collectionId": "valmiki-ramayana",
    "index": 10587,
    "titleDevanagari": "वाल्मीकि रामायण, सुन्दरकाण्ड, सर्ग 50, श्लोक 7",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-5-sarga-50-shlok-7",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "रावणस्य वचः श्रुत्वा प्रहस्तो वाक्यमब्रवीत्।",
          "समाश्वसिहि भद्रं ते न भीः कार्या त्वया कपे॥७॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-50",
    "chapterName": "सुन्दरकाण्ड, सर्ग 50",
    "verseNumber": 7
  },
  {
    "id": "valmiki-ramayana-5-sarga-50-shlok-8",
    "collectionId": "valmiki-ramayana",
    "index": 10588,
    "titleDevanagari": "वाल्मीकि रामायण, सुन्दरकाण्ड, सर्ग 50, श्लोक 8",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-5-sarga-50-shlok-8",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "यदि तावत् त्वमिन्द्रेण प्रेषितो रावणालयम्।",
          "तत्त्वमाख्याहि मा ते भूद् भयं वानर मोक्ष्यसे॥८ ॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-50",
    "chapterName": "सुन्दरकाण्ड, सर्ग 50",
    "verseNumber": 8
  },
  {
    "id": "valmiki-ramayana-5-sarga-50-shlok-9",
    "collectionId": "valmiki-ramayana",
    "index": 10589,
    "titleDevanagari": "वाल्मीकि रामायण, सुन्दरकाण्ड, सर्ग 50, श्लोक 9",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-5-sarga-50-shlok-9",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "यदि वैश्रवणस्य त्वं यमस्य वरुणस्य च।",
          "चारुरूपमिदं कृत्वा प्रविष्टो नः पुरीमिमाम्॥९॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-50",
    "chapterName": "सुन्दरकाण्ड, सर्ग 50",
    "verseNumber": 9
  },
  {
    "id": "valmiki-ramayana-5-sarga-50-shlok-10",
    "collectionId": "valmiki-ramayana",
    "index": 10590,
    "titleDevanagari": "वाल्मीकि रामायण, सुन्दरकाण्ड, सर्ग 50, श्लोक 10",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-5-sarga-50-shlok-10",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "विष्णुना प्रेषितो वापि दूतो विजयकाक्षिणा।",
          "नहि ते वानरं तेजो रूपमात्रं तु वानरम्॥१०॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-50",
    "chapterName": "सुन्दरकाण्ड, सर्ग 50",
    "verseNumber": 10
  },
  {
    "id": "valmiki-ramayana-5-sarga-50-shlok-11",
    "collectionId": "valmiki-ramayana",
    "index": 10591,
    "titleDevanagari": "वाल्मीकि रामायण, सुन्दरकाण्ड, सर्ग 50, श्लोक 11",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-5-sarga-50-shlok-11",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "तत्त्वतः कथयस्वाद्य ततो वानर मोक्ष्यसे।",
          "अनृतं वदतश्चापि दुर्लभं तव जीवितम्॥११॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-50",
    "chapterName": "सुन्दरकाण्ड, सर्ग 50",
    "verseNumber": 11
  },
  {
    "id": "valmiki-ramayana-5-sarga-50-shlok-13",
    "collectionId": "valmiki-ramayana",
    "index": 10592,
    "titleDevanagari": "वाल्मीकि रामायण, सुन्दरकाण्ड, सर्ग 50, श्लोक 13",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-5-sarga-50-shlok-13",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "अथवा यन्निमित्तस्ते प्रवेशो रावणालये।",
          "एवमुक्तो हरिवरस्तदा रक्षोगणेश्वरम्॥१२॥",
          "अब्रवीन्नास्मि शक्रस्य यमस्य वरुणस्य च।",
          "धनदेन न मे सख्यं विष्णुना नास्मि चोदितः॥१३॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-50",
    "chapterName": "सुन्दरकाण्ड, सर्ग 50",
    "verseNumber": 13
  },
  {
    "id": "valmiki-ramayana-5-sarga-50-shlok-14",
    "collectionId": "valmiki-ramayana",
    "index": 10593,
    "titleDevanagari": "वाल्मीकि रामायण, सुन्दरकाण्ड, सर्ग 50, श्लोक 14",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-5-sarga-50-shlok-14",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "जातिरेव मम त्वेषा वानरोऽहमिहागतः।",
          "दर्शने राक्षसेन्द्रस्य तदिदं दुर्लभं मया॥१४॥",
          "वनं राक्षसराजस्य दर्शनार्थं विनाशितम्।",
          "ततस्ते राक्षसाः प्राप्ता बलिनो युद्धकाङ्क्षिणः॥",
          "रक्षणार्थं च देहस्य प्रतियुद्धा मया रणे।"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-50",
    "chapterName": "सुन्दरकाण्ड, सर्ग 50",
    "verseNumber": 14
  },
  {
    "id": "valmiki-ramayana-5-sarga-50-shlok-16",
    "collectionId": "valmiki-ramayana",
    "index": 10594,
    "titleDevanagari": "वाल्मीकि रामायण, सुन्दरकाण्ड, सर्ग 50, श्लोक 16",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-5-sarga-50-shlok-16",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "अस्त्रपाशैर्न शक्योऽहं बद्धं देवासुरैरपि॥१६॥",
          "पितामहादेष वरो ममापि हि समागतः।"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-50",
    "chapterName": "सुन्दरकाण्ड, सर्ग 50",
    "verseNumber": 16
  },
  {
