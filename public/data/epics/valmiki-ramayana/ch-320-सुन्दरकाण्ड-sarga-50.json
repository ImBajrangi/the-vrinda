    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-5-sarga-50-shlok-17",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "राजानं द्रष्टुकामेन मयास्त्रमनुवर्तितम्॥१७॥",
          "विमुक्तोऽप्यहमस्त्रेण राक्षसैस्त्वभिवेदितः।"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-50",
    "chapterName": "सुन्दरकाण्ड, सर्ग 50",
    "verseNumber": 17
  },
