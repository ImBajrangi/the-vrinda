    "slug": "valmiki-ramayana-3-sarga-31-shlok-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "त्वरमाणस्ततो गत्वा जनस्थानादकम्पनः।",
          "प्रविश्य लङ्कां वेगेन रावणं वाक्यमब्रवीत्॥१॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-31",
    "chapterName": "अरण्यकाण्ड, सर्ग 31",
    "verseNumber": 1
  },
  {
