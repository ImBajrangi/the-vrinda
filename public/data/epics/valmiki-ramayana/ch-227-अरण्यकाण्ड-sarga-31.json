    "slug": "valmiki-ramayana-3-sarga-31-shlok-2",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "जनस्थानस्थिता राजन् राक्षसा बहवो हताः।",
          "खरश्च निहतः संख्ये कथंचिदहमागतः॥२॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-31",
    "chapterName": "अरण्यकाण्ड, सर्ग 31",
    "verseNumber": 2
  },
