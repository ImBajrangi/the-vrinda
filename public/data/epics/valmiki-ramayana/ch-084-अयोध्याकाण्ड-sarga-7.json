    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "पताकाभिर्वरारंभिर्ध्वजैश्च समलंकृताम्।",
          "सिक्तां चन्दनतोयैश्च शिरःस्नातजनैर्युताम्॥३॥"
        ]
      }
    ],
