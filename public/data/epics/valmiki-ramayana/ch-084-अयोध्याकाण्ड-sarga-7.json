    "slug": "valmiki-ramayana-2-sarga-7-shlok-7",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "॥ श्रीसीतारामचन्द्राभ्यां नमः॥",
          "श्रीमद्वाल्मीकीय रामायण",
          "अयोध्याकाण्डम्",
          "सप्तमः सर्गः (सर्ग 7)",
          "सा हर्षोत्फुल्लनयनां पाण्डुरक्षौमवासिनीम्।",
          "अविदूरे स्थितां दृष्ट्वा धात्री पप्रच्छ मन्थरा॥७॥",
          "इत्याचे श्रीमद्रामायणे वाल्मीकीये आदिकाव्येऽयोध्याकाण्डे सप्तमः सर्गः॥७॥"
        ]
      }
    ],
    "chapterId": "अयोध्याकाण्ड-sarga-7",
    "chapterName": "अयोध्याकाण्ड, सर्ग 7",
    "verseNumber": 7
  },
  {
    "id": "valmiki-ramayana-2-sarga-7-shlok-9",
