        "linesDevanagari": [
          "हृष्टप्रमुदितैः पौरैरुच्छ्रितध्वजमालिनीम्।",
          "अयोध्या",
          "ं मन्थरा दृष्ट्वा परं विस्मयमागता॥६॥",
          "अयोध्या"
        ]
      }
    ],
    "chapterId": "अयोध्याकाण्ड-sarga-7",
