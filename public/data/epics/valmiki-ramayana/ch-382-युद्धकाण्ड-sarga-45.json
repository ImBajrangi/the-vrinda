        "linesDevanagari": [
          "तं भीमवेगा हरयो नाराचैः क्षतविक्षताः।",
          "अन्धकारे न ददृशुर्मेधैः सूर्यमिवावृतम्॥६॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-45",
    "chapterName": "युद्धकाण्ड, सर्ग 45",
    "verseNumber": 6
  },
