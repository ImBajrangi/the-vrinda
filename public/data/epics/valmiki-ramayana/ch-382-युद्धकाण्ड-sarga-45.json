    "titleDevanagari": "वाल्मीकि रामायण, युद्धकाण्ड, सर्ग 45, श्लोक 1",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-6-sarga-45-shlok-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "स तस्य गतिमन्विच्छन् राजपुत्रः प्रतापवान्।",
          "दिदेशातिबलो रामो दश वानरयूथपान्॥१॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-45",
    "chapterName": "युद्धकाण्ड, सर्ग 45",
    "verseNumber": 1
  },
  {
    "id": "valmiki-ramayana-6-sarga-45-shlok-3",
    "collectionId": "valmiki-ramayana",
    "index": 12669,
    "titleDevanagari": "वाल्मीकि रामायण, युद्धकाण्ड, सर्ग 45, श्लोक 3",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-6-sarga-45-shlok-3",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "दौ सुषेणस्य दायादौ नीलं च प्लवगाधिपम्।",
          "अङ्गदं वालिपुत्रं च शरभं च तरस्विनम्॥२॥",
          "द्विविदं च हनूमन्तं सानुप्रस्थं महाबलम्।",
          "ऋषभं चर्षभस्कन्धमादिदेश परंतपः॥३॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-45",
    "chapterName": "युद्धकाण्ड, सर्ग 45",
    "verseNumber": 3
  },
  {
