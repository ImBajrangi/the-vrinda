      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "तेषां वेगवतां वेगमिषुभिर्वेगवत्तरैः।",
          "अस्त्रवित् परमास्त्रस्तु वारयामास रावणिः॥५॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-45",
    "chapterName": "युद्धकाण्ड, सर्ग 45",
    "verseNumber": 5
  },
