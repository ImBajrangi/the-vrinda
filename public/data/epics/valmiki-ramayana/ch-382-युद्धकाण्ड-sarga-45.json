    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "ते सम्प्रहृष्टा हरयो भीमानुद्यम्य पादपान्।",
          "आकाशं विविशुः सर्वे मार्गमाणा दिशो दश॥४॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-45",
    "chapterName": "युद्धकाण्ड, सर्ग 45",
    "verseNumber": 4
  },
