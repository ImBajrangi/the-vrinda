    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-5-sarga-26-shlok-5-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "आत्मानं खादतानार्या न सीतां भक्षयिष्यथ।",
          "जनकस्य सुतामिष्टां स्नुषां दशरथस्य च॥५॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-26",
    "chapterName": "सुन्दरकाण्ड, सर्ग 26",
    "verseNumber": 5
  },
  {
