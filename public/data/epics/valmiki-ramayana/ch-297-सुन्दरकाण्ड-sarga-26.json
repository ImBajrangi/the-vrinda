    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-5-sarga-26-shlok-17",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "पाण्डुरर्षभयुक्तेन रथेनाष्टयुजा स्वयम्।",
          "इहोपयातः काकुत्स्थः सीतया सह भार्यया॥१७॥",
          "शुक्लमाल्याम्बरधरो लक्ष्मणेन सहागतः।"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-26",
    "chapterName": "सुन्दरकाण्ड, सर्ग 26",
    "verseNumber": 17
  },
