    "slug": "valmiki-ramayana-5-sarga-26-shlok-7",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "एवमुक्तास्त्रिजटया राक्षस्यः क्रोधमूर्च्छिताः।",
          "सर्वा एवाब्रुवन् भीतास्त्रिजटां तामिदं वचः॥७॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-26",
    "chapterName": "सुन्दरकाण्ड, सर्ग 26",
    "verseNumber": 7
  },
  {
    "id": "valmiki-ramayana-5-sarga-26-shlok-8",
