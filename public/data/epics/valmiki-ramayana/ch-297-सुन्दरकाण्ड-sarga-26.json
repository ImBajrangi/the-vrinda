    "slug": "valmiki-ramayana-5-sarga-26-shlok-9",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "प्रत्याख्यानं न जानाति नात्मानं नात्मनः कुलम्।",
          "यो नृशंसस्वभावेन मां प्रार्थयितुमिच्छति॥९॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-26",
    "chapterName": "सुन्दरकाण्ड, सर्ग 26",
    "verseNumber": 9
  },
