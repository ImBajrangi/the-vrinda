    "slug": "valmiki-ramayana-5-sarga-26-shlok-8",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "कथयस्व त्वया दृष्टः स्वप्नोऽयं कीदृशो निशि।",
          "तासां श्रुत्वा तु वचनं राक्षसीनां मुखोद्गतम्॥८॥",
          "उवाच वचनं काले त्रिजटा स्वप्नसंश्रितम्।"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-26",
    "chapterName": "सुन्दरकाण्ड, सर्ग 26",
    "verseNumber": 8
  },
  {
