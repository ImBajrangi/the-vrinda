    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-5-sarga-26-shlok-4",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "सीतां ताभिरनार्याभिर्दृष्ट्वा संतर्जितां तदा।",
          "राक्षसी त्रिजटा वृद्धा प्रबुद्धा वाक्यमब्रवीत्॥४॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-26",
    "chapterName": "सुन्दरकाण्ड, सर्ग 26",
    "verseNumber": 4
  },
  {
