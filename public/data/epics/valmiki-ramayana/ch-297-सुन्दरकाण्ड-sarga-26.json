    "titleDevanagari": "वाल्मीकि रामायण, सुन्दरकाण्ड, सर्ग 26, श्लोक 1",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-5-sarga-26-shlok-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "इत्युक्ताः सीतया घोरं राक्षस्यः क्रोधमूर्च्छिताः।",
          "काश्चिज्जग्मुस्तदाख्यातुं रावणस्य दुरात्मनः॥१॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-26",
    "chapterName": "सुन्दरकाण्ड, सर्ग 26",
    "verseNumber": 1
  },
  {
    "id": "valmiki-ramayana-5-sarga-26-shlok-2-1",
    "collectionId": "valmiki-ramayana",
    "index": 9791,
    "titleDevanagari": "वाल्मीकि रामायण, सुन्दरकाण्ड, सर्ग 26, श्लोक 2",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-5-sarga-26-shlok-2-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "ततः सीतामुपागम्य राक्षस्यो भीमदर्शनाः।",
          "पुनः परुषमेकार्थमनर्थार्थमथाब्रुवन्॥२॥",
          "अद्येदानीं तवानार्ये सीते पापविनिश्चये।",
          "राक्षस्यो भक्षयिष्यन्ति मांसमेतद् यथासुखम्॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-26",
    "chapterName": "सुन्दरकाण्ड, सर्ग 26",
    "verseNumber": 2
  },
  {
    "id": "valmiki-ramayana-5-sarga-26-shlok-3",
    "collectionId": "valmiki-ramayana",
    "index": 9792,
    "titleDevanagari": "वाल्मीकि रामायण, सुन्दरकाण्ड, सर्ग 26, श्लोक 3",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-5-sarga-26-shlok-3",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "राघवस्य प्रमत्तस्य रक्षसा कामरूपिणा।",
          "रावणेन प्रमथ्याहमानीता क्रोशती बलात्॥३॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-26",
    "chapterName": "सुन्दरकाण्ड, सर्ग 26",
    "verseNumber": 3
  },
  {
