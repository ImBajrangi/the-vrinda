    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-5-sarga-26-shlok-6",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "स्वप्नो ह्यद्य मया दृष्टो दारुणो रोमहर्षणः।",
          "राक्षसानामभावाय भर्तुरस्या भवाय च॥६॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-26",
    "chapterName": "सुन्दरकाण्ड, सर्ग 26",
    "verseNumber": 6
  },
