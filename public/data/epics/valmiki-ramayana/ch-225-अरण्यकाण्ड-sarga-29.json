    "titleDevanagari": "वाल्मीकि रामायण, अरण्यकाण्ड, सर्ग 29, श्लोक 1",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-29-shlok-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "खरं तु विरथं रामो गदापाणिमवस्थितम्।",
          "मृदुपूर्वं महातेजाः परुषं वाक्यमब्रवीत्॥१॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-29",
    "chapterName": "अरण्यकाण्ड, सर्ग 29",
    "verseNumber": 1
  },
  {
    "id": "valmiki-ramayana-3-sarga-29-shlok-4",
    "collectionId": "valmiki-ramayana",
    "index": 7536,
    "titleDevanagari": "वाल्मीकि रामायण, अरण्यकाण्ड, सर्ग 29, श्लोक 4",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-29-shlok-4",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "गजाश्वरथसम्बाधे बले महति तिष्ठता।",
          "कृतं ते दारुणं कर्म सर्वलोकजुगुप्सितम्॥२॥",
          "उद्वेजनीयो भूतानां नृशंसः पापकर्मकृत् ।",
          "त्रयाणामपि लोकानामीश्वरोऽपि न तिष्ठति॥३॥",
          "कर्म लोकविरुद्धं तु कुर्वाणं क्षणदाचर।",
          "तीक्ष्णं सर्वजनो हन्ति सष दुष्टमिवागतम्॥४॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-29",
    "chapterName": "अरण्यकाण्ड, सर्ग 29",
    "verseNumber": 4
  },
  {
    "id": "valmiki-ramayana-3-sarga-29-shlok-5",
    "collectionId": "valmiki-ramayana",
    "index": 7537,
    "titleDevanagari": "वाल्मीकि रामायण, अरण्यकाण्ड, सर्ग 29, श्लोक 5",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-29-shlok-5",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "लोभात् पापानि कुर्वाणः कामाद् वा यो न बुध्यते।",
          "हृष्टः पश्यति तस्यान्तं ब्राह्मणी करकादिव॥५॥",
          "वसतो दण्डकारण्ये तापसान् धर्मचारिणः।",
          "किं नु हत्वा महाभागान् फलं प्राप्स्यसि राक्षस॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-29",
    "chapterName": "अरण्यकाण्ड, सर्ग 29",
    "verseNumber": 5
  },
  {
    "id": "valmiki-ramayana-3-sarga-29-shlok-7",
    "collectionId": "valmiki-ramayana",
    "index": 7538,
    "titleDevanagari": "वाल्मीकि रामायण, अरण्यकाण्ड, सर्ग 29, श्लोक 7",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-29-shlok-7",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "न चिरं पापकर्माणः क्रूरा लोकजुगुप्सिताः।",
          "ऐश्वर्यं प्राप्य तिष्ठन्ति शीर्णमूला इव द्रुमाः॥७॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-29",
    "chapterName": "अरण्यकाण्ड, सर्ग 29",
    "verseNumber": 7
  },
  {
