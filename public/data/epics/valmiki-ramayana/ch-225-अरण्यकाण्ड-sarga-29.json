    "titleDevanagari": "वाल्मीकि रामायण, अरण्यकाण्ड, सर्ग 29, श्लोक 8",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-29-shlok-8",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "अवश्यं लभते कर्ता फलं पापस्य कर्मणः।",
          "घोरं पर्यागते काले द्रुमः पुष्पमिवार्तवम्॥८॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-29",
    "chapterName": "अरण्यकाण्ड, सर्ग 29",
    "verseNumber": 8
  },
