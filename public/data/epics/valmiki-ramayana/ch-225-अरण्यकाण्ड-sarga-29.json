        "linesDevanagari": [
          "नचिरात् प्राप्यते लोके पापानां कर्मणां फलम्।",
          "सविषाणामिवान्नानां भुक्तानां क्षणदाचर ॥९॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-29",
    "chapterName": "अरण्यकाण्ड, सर्ग 29",
    "verseNumber": 9
  },
  {
