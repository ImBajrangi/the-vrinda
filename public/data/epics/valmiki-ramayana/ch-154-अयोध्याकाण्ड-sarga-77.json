    "slug": "valmiki-ramayana-2-sarga-77-shlok-2",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "ब्राह्मणेभ्यो धनं रत्नं ददावन्नं च पुष्कलम्।",
          "वासांसि च महार्हाणि रत्नानि विविधानि च।",
          "वास्तिकं बहु शुक्लं च गाश्चापि बहुशस्तदा॥ २॥"
        ]
      }
    ],
    "chapterId": "अयोध्याकाण्ड-sarga-77",
    "chapterName": "अयोध्याकाण्ड, सर्ग 77",
    "verseNumber": 2
  },
  {
