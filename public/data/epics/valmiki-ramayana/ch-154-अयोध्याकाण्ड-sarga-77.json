    "slug": "valmiki-ramayana-2-sarga-77-shlok-3",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "दासीर्दासांश्च यानानि वेश्मानि सुमहान्ति च।",
          "ब्राह्मणेभ्यो ददौ पुत्रो राज्ञस्तस्यौदेहिकम्॥ ३॥"
        ]
      }
    ],
