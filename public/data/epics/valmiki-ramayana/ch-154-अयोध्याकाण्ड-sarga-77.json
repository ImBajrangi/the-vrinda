    "slug": "valmiki-ramayana-2-sarga-77-shlok-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "ततो दशाहेऽतिगते कृतशौचो नृपात्मजः।",
          "द्वादशेऽहनि सम्प्राप्ते श्राद्धकर्माण्यकारयत्॥१॥"
        ]
      }
    ],
    "chapterId": "अयोध्याकाण्ड-sarga-77",
    "chapterName": "अयोध्याकाण्ड, सर्ग 77",
    "verseNumber": 1
  },
  {
