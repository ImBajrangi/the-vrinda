    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "सर्वर्तुकुसुमै रम्यैः फलवद्भिश्च पादपैः।",
          "पुष्पितानामशोकानां श्रिया सूर्योदयप्रभाम्॥५॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-15",
    "chapterName": "सुन्दरकाण्ड, सर्ग 15",
    "verseNumber": 5
  },
  {
