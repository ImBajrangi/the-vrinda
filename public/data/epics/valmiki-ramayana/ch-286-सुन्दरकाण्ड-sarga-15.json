    "slug": "valmiki-ramayana-5-sarga-15-shlok-4",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "काञ्चनोत्पलपद्माभिर्वापीभिरुपशोभिताम्।",
          "बह्वासनकुथोपेतां बहुभूमिगृहायुताम्॥४॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-15",
    "chapterName": "सुन्दरकाण्ड, सर्ग 15",
    "verseNumber": 4
  },
  {
