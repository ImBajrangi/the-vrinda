    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-5-sarga-15-shlok-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "स वीक्षमाणस्तत्रस्थो मार्गमाणश्च मैथिलीम्।",
          "अवेक्षमाणश्च महीं सर्वां तामन्ववैक्षत॥१॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-15",
    "chapterName": "सुन्दरकाण्ड, सर्ग 15",
    "verseNumber": 1
  },
  {
    "id": "valmiki-ramayana-5-sarga-15-shlok-2",
