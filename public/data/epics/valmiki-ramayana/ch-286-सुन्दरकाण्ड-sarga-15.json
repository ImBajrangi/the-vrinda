    "index": 9475,
    "titleDevanagari": "वाल्मीकि रामायण, सुन्दरकाण्ड, सर्ग 15, श्लोक 7",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-5-sarga-15-shlok-7",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "विनिष्पतद्भिः शतशश्चित्रैः पुष्पावतंसकैः।",
          "समूलपुष्परचितैरशोकैः शोकनाशनैः॥७॥",
          "पुष्पभारातिभारैश्च स्पृशद्भिरिव मेदिनीम्।",
          "कर्णिकारैः कुसुमितैः किंशुकैश्च सुपुष्पितैः॥८॥",
          "स देशः प्रभया तेषां प्रदीप्त इव सर्वतः।"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-15",
    "chapterName": "सुन्दरकाण्ड, सर्ग 15",
    "verseNumber": 7
  },
  {
