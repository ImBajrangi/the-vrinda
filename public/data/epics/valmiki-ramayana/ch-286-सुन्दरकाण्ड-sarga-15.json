    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "प्रदीप्तामिव तत्रस्थो मारुतिः समुदैक्षत।",
          "निष्पत्रशाखां विहगैः क्रियमाणामिवासकृत्॥६॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-15",
    "chapterName": "सुन्दरकाण्ड, सर्ग 15",
    "verseNumber": 6
  },
  {
    "id": "valmiki-ramayana-5-sarga-15-shlok-7",
