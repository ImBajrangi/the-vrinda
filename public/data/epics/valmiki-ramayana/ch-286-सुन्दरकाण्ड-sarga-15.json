    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "पुंनागाः सप्तपर्णाश्च चम्पकोद्दालकास्तथा॥९॥",
          "विवृद्धमूला बहवः शोभन्ते स्म सुपुष्पिताः।"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-15",
    "chapterName": "सुन्दरकाण्ड, सर्ग 15",
    "verseNumber": 9
