    "index": 9471,
    "titleDevanagari": "वाल्मीकि रामायण, सुन्दरकाण्ड, सर्ग 15, श्लोक 2",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-5-sarga-15-shlok-2",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "संतानकलताभिश्च पादपैरुपशोभिताम्।",
          "दिव्यगन्धरसोपेतां सर्वतः समलंकृताम्॥२॥",
          "तां स नन्दनसंकाशां मृगपक्षिभिरावृताम्।",
          "हर्म्यप्रासादसम्बाधां कोकिलाकुलनिःस्वनाम्॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-15",
    "chapterName": "सुन्दरकाण्ड, सर्ग 15",
    "verseNumber": 2
  },
  {
