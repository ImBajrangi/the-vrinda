    "slug": "valmiki-ramayana-2-sarga-104-shlok-2",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "राजपत्न्यश्च गच्छन्त्यो मन्दं मन्दाकिनी प्रति।",
          "ददृशुस्तत्र तत् तीर्थं रामलक्ष्मणसेवितम्॥२॥",
          "कौसल्या बाष्पपूर्णेन मुखेन परिशुष्यता।",
          "सुमित्रामब्रवीद् दीनां याश्चान्या राजयोषितः॥"
        ]
      }
    ],
    "chapterId": "अयोध्याकाण्ड-sarga-104",
    "chapterName": "अयोध्याकाण्ड, सर्ग 104",
    "verseNumber": 2
  },
