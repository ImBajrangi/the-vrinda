    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "वसिष्ठः पुरतः कृत्वा दारान् दशरथस्य च।",
          "अभिचक्राम तं देशं रामदर्शनतर्षितः॥१॥"
        ]
      }
    ],
    "chapterId": "अयोध्याकाण्ड-sarga-104",
    "chapterName": "अयोध्याकाण्ड, सर्ग 104",
    "verseNumber": 1
  },
  {
