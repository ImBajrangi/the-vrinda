    "slug": "valmiki-ramayana-3-sarga-30-shlok-7",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "पांसुरूषितसर्वाङ्गः स्रस्तन्यस्तभुजदयः।",
          "स्वप्स्यसे गां समाश्लिष्य दुर्लभां प्रमदामिव॥ ७॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-30",
    "chapterName": "अरण्यकाण्ड, सर्ग 30",
    "verseNumber": 7
  },
  {
