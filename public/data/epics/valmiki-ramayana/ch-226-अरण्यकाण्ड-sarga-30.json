    "titleDevanagari": "वाल्मीकि रामायण, अरण्यकाण्ड, सर्ग 30, श्लोक 1",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-30-shlok-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "भित्त्वा तु तां गदां बाणै राघवो धर्मवत्सलः।",
          "स्मयमान इदं वाक्यं संरब्धमिदमब्रवीत्॥१॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-30",
    "chapterName": "अरण्यकाण्ड, सर्ग 30",
    "verseNumber": 1
  },
  {
    "id": "valmiki-ramayana-3-sarga-30-shlok-2",
    "collectionId": "valmiki-ramayana",
    "index": 7562,
    "titleDevanagari": "वाल्मीकि रामायण, अरण्यकाण्ड, सर्ग 30, श्लोक 2",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-30-shlok-2",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "एतत् ते बलसर्वस्वं दर्शितं राक्षसाधम।",
          "शक्तिहीनतरो मत्तो वृथा त्वमुपगर्जसि॥२॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-30",
    "chapterName": "अरण्यकाण्ड, सर्ग 30",
    "verseNumber": 2
  },
  {
    "id": "valmiki-ramayana-3-sarga-30-shlok-3",
    "collectionId": "valmiki-ramayana",
    "index": 7563,
    "titleDevanagari": "वाल्मीकि रामायण, अरण्यकाण्ड, सर्ग 30, श्लोक 3",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-30-shlok-3",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "एषा बाणविनिर्भिन्ना गदा भूमितलं गता।",
          "अभिधानप्रगल्भस्य तव प्रत्ययघातिनी॥३॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-30",
    "chapterName": "अरण्यकाण्ड, सर्ग 30",
    "verseNumber": 3
  },
  {
