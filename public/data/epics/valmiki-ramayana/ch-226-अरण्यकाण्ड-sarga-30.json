    "slug": "valmiki-ramayana-3-sarga-30-shlok-8",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "प्रवृद्धनिद्रे शयिते त्वयि राक्षसपांसने।",
          "भविष्यन्ति शरण्यानां शरण्या दण्डका इमे॥ ८॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-30",
    "chapterName": "अरण्यकाण्ड, सर्ग 30",
    "verseNumber": 8
  },
  {
