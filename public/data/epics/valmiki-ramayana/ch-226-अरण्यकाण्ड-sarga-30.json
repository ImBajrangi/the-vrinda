    "slug": "valmiki-ramayana-3-sarga-30-shlok-10",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "अद्य विप्रसरिष्यन्ति राक्षस्यो हतबान्धवाः।",
          "बाष्पार्द्रवदना दीना भयादन्यभयावहाः॥१०॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-30",
    "chapterName": "अरण्यकाण्ड, सर्ग 30",
    "verseNumber": 10
  },
