    "titleDevanagari": "वाल्मीकि रामायण, अरण्यकाण्ड, सर्ग 30, श्लोक 4",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-30-shlok-4",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "यत् त्वयोक्तं विनष्टानामिदमश्रुप्रमार्जनम्।",
          "राक्षसानां करोमीति मिथ्या तदपि ते वचः॥४॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-30",
    "chapterName": "अरण्यकाण्ड, सर्ग 30",
    "verseNumber": 4
  },
  {
    "id": "valmiki-ramayana-3-sarga-30-shlok-5",
    "collectionId": "valmiki-ramayana",
    "index": 7565,
    "titleDevanagari": "वाल्मीकि रामायण, अरण्यकाण्ड, सर्ग 30, श्लोक 5",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-30-shlok-5",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "नीचस्य क्षुद्रशीलस्य मिथ्यावृत्तस्य रक्षसः।",
          "प्राणानपहरिष्यामि गरुत्मानमृतं यथा॥५॥",
          "अद्य ते भिन्नकण्ठस्य फेनबुबुदभूषितम्।",
          "विदारितस्य मद्बाणैर्मही पास्यति शोणितम्॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-30",
    "chapterName": "अरण्यकाण्ड, सर्ग 30",
    "verseNumber": 5
  },
  {
    "id": "valmiki-ramayana-3-sarga-30-shlok-7",
    "collectionId": "valmiki-ramayana",
