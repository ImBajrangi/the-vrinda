        "stanzaNumber": 1,
        "linesDevanagari": [
          "तमेवमभिसंरब्धं ब्रुवाणं राघवं वने।",
          "खरो निर्भर्त्सयामास रोषात् खरतरस्वरः॥१३॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-30",
    "chapterName": "अरण्यकाण्ड, सर्ग 30",
    "verseNumber": 13
