    "slug": "valmiki-ramayana-3-sarga-30-shlok-9",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "जनस्थाने हतस्थाने तव राक्षस मच्छरैः।",
          "निर्भया विचरिष्यन्ति सर्वतो मुनयो वने॥९॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-30",
    "chapterName": "अरण्यकाण्ड, सर्ग 30",
    "verseNumber": 9
  },
  {
