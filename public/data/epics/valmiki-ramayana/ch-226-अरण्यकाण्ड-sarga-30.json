        "linesDevanagari": [
          "अद्य शोकरसज्ञास्ता भविष्यन्ति निरर्थिकाः।",
          "अनुरूपकुलाः पत्न्यो यासां त्वं पतिरीदृशः॥ ११॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-30",
    "chapterName": "अरण्यकाण्ड, सर्ग 30",
    "verseNumber": 11
