    "index": 11446,
    "titleDevanagari": "वाल्मीकि रामायण, युद्धकाण्ड, सर्ग 5, श्लोक 3",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-6-sarga-5-shlok-3",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "निविष्टायां तु सेनायां तीरे नदनदीपतेः।",
          "पार्श्वस्थं लक्ष्मणं दृष्ट्वा रामो वचनमब्रवीत्॥३॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-5",
    "chapterName": "युद्धकाण्ड, सर्ग 5",
    "verseNumber": 3
  },
  {
