    "slug": "valmiki-ramayana-6-sarga-5-shlok-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "सा तु नीलेन विधिवत्स्वारक्षा सुसमाहिता।",
          "सागरस्योत्तरे तीरे साधु सा विनिवेशिता॥१॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-5",
    "chapterName": "युद्धकाण्ड, सर्ग 5",
    "verseNumber": 1
  },
  {
    "id": "valmiki-ramayana-6-sarga-5-shlok-2",
    "collectionId": "valmiki-ramayana",
    "index": 11445,
    "titleDevanagari": "वाल्मीकि रामायण, युद्धकाण्ड, सर्ग 5, श्लोक 2",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-6-sarga-5-shlok-2",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "मैन्दश्च द्विविदश्चोभौ तत्र वानरपुङ्गवौ।",
          "विचेरतुश्च तां सेनां रक्षार्थं सर्वतोदिशम्॥२॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-5",
    "chapterName": "युद्धकाण्ड, सर्ग 5",
    "verseNumber": 2
  },
  {
    "id": "valmiki-ramayana-6-sarga-5-shlok-3",
