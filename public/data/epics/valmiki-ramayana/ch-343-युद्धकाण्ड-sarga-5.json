    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "तन्मे दहति गात्राणि विषं पीतमिवाशये।",
          "हा नाथेति प्रिया सा मां ह्रियमाणा यदब्रवीत्॥७॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-5",
    "chapterName": "युद्धकाण्ड, सर्ग 5",
    "verseNumber": 7
  },
