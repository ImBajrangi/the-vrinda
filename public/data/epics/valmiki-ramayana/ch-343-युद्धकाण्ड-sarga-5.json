    "slug": "valmiki-ramayana-6-sarga-5-shlok-4",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "शोकश्च किल कालेन गच्छता ह्यपगच्छति।",
          "मम चापश्यतः कान्तामहन्यहनि वर्धते॥४॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-5",
    "chapterName": "युद्धकाण्ड, सर्ग 5",
    "verseNumber": 4
  },
  {
