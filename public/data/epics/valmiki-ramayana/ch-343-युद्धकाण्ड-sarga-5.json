    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-6-sarga-5-shlok-5",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "॥ श्रीसीतारामचन्द्राभ्यां नमः॥",
          "श्रीमद्वाल्मीकीय रामायण",
          "युद्धकाण्डम्",
          "पञ्चमः सर्गः (5)",
          "न मे दुःखं प्रिया दूरे न मे दुःखं हृतेति च।",
          "एतदेवानुशोचामि वयोऽस्या ह्यतिवर्तते॥५॥",
          "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये युद्धकाण्डे पञ्चमः सर्गः॥५॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-5",
    "chapterName": "युद्धकाण्ड, सर्ग 5",
    "verseNumber": 5
  },
  {
    "id": "valmiki-ramayana-6-sarga-5-shlok-6",
    "collectionId": "valmiki-ramayana",
    "index": 11449,
    "titleDevanagari": "वाल्मीकि रामायण, युद्धकाण्ड, सर्ग 5, श्लोक 6",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-6-sarga-5-shlok-6",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "वाहि वात यतः कान्ता तां स्पृष्ट्वा मामपि स्पृश।",
          "त्वयि मे गात्रसंस्पर्शश्चन्द्रे दृष्टिसमागमः॥६॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-5",
    "chapterName": "युद्धकाण्ड, सर्ग 5",
    "verseNumber": 6
  },
  {
