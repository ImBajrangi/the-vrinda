    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "कृतं हनूमता कार्यं सुमहद् भुवि दुर्लभम्।",
          "मनसापि यदन्येन न शक्यं धरणीतले॥२॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-1",
    "chapterName": "युद्धकाण्ड, सर्ग 1",
    "verseNumber": 2
  },
