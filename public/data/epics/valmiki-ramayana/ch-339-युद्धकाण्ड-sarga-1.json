    "slug": "valmiki-ramayana-6-sarga-1-shlok-4",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "देवदानवयक्षाणां गन्धर्वोरगरक्षसाम्।",
          "अप्रधृष्यां पुरीं लङ्कां रावणेन सुरक्षिताम्॥४॥",
          "यो वीर्यबलसम्पन्नो न समः स्याद्धनूमतः।"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-1",
    "chapterName": "युद्धकाण्ड, सर्ग 1",
    "verseNumber": 4
  },
