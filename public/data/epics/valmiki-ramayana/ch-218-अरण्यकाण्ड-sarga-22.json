    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "उपस्थापय मे क्षिप्रं रथं सौम्य धनूंषि च।",
          "शरांश्च चित्रान् खड्गांश्च शक्तीश्च विविधाः शिताः॥१०॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-22",
    "chapterName": "अरण्यकाण्ड, सर्ग 22",
    "verseNumber": 10
  },
  {
