    "index": 7364,
    "titleDevanagari": "वाल्मीकि रामायण, अरण्यकाण्ड, सर्ग 22, श्लोक 9",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-22-shlok-9",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "चतुर्दश सहस्राणि मम चित्तानुवर्तिनाम्।",
          "रक्षसां भीमवेगानां समरेष्वनिवर्तिनाम॥८॥",
          "नीलजीमूतवर्णानां लोकहिंसाविहारिणाम्।",
          "सर्वोद्योगमुदीर्णानां रक्षसां सौम्य कारय॥९॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-22",
    "chapterName": "अरण्यकाण्ड, सर्ग 22",
    "verseNumber": 9
  },
  {
    "id": "valmiki-ramayana-3-sarga-22-shlok-10",
    "collectionId": "valmiki-ramayana",
    "index": 7365,
