    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-22-shlok-2",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "तवापमानप्रभवः क्रोधोऽयमतुलो मम।",
          "न शक्यते धारयितुं लवणाम्भ इवोल्बणम्॥२॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-22",
    "chapterName": "अरण्यकाण्ड, सर्ग 22",
    "verseNumber": 2
  },
  {
