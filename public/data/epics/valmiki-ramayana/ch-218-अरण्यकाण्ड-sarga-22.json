    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-22-shlok-17",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "ततस्तद् राक्षसं सैन्यं घोरचर्मायुधध्वजम्।",
          "निर्जगाम जनस्थानान्महानादं महाजवम्॥१७॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-22",
