    "slug": "valmiki-ramayana-3-sarga-22-shlok-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "एवमाधर्षितः शूरः शूर्पणख्या खरस्ततः।",
          "उवाच रक्षसां मध्ये खरः खरतरं वचः॥१॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-22",
    "chapterName": "अरण्यकाण्ड, सर्ग 22",
    "verseNumber": 1
  },
  {
