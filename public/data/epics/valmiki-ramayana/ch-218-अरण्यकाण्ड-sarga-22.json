    "slug": "valmiki-ramayana-3-sarga-22-shlok-7",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "तया परुषितः पूर्वं पुनरेव प्रशंसितः।।",
          "अब्रवीद् दूषणं नाम खरः सेनापतिं तदा॥७॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-22",
    "chapterName": "अरण्यकाण्ड, सर्ग 22",
    "verseNumber": 7
  },
  {
    "id": "valmiki-ramayana-3-sarga-22-shlok-9",
