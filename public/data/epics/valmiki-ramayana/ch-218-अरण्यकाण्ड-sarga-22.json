    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-22-shlok-5",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "परश्वधहतस्याद्य मन्दप्राणस्य भूतले।",
          "रामस्य रुधिरं रक्तमुष्णं पास्यसि राक्षसि॥५॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-22",
    "chapterName": "अरण्यकाण्ड, सर्ग 22",
    "verseNumber": 5
  },
  {
