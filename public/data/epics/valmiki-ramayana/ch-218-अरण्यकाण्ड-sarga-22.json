    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "अग्रे निर्यातुमिच्छामि पौलस्त्यानां महात्मनाम्।",
          "वधार्थं दुर्विनीतस्य रामस्य रणकोविद ॥११॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-22",
    "chapterName": "अरण्यकाण्ड, सर्ग 22",
    "verseNumber": 11
