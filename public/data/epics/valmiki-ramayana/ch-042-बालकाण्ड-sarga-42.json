    "slug": "valmiki-ramayana-1-sarga-42-shlok-15",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "सुप्रीतो भगवान् ब्रह्मा प्रजानां प्रभुरीश्वरः॥ १४॥",
          "ततः सुरगणैः सार्धमुपागम्य पितामहः।",
          "भगीरथं महात्मानं तप्यमानमथाब्रवीत्॥१५॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-42",
    "chapterName": "बालकाण्ड, सर्ग 42",
    "verseNumber": 15
