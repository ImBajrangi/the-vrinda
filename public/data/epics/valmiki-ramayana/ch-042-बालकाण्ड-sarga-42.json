      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "अगत्वा निश्चयं राजा तेषामुद्धरणं प्रति।",
          "व्याधिना नरशार्दूल कालधर्ममुपेयिवान्॥९॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-42",
    "chapterName": "बालकाण्ड, सर्ग 42",
    "verseNumber": 9
