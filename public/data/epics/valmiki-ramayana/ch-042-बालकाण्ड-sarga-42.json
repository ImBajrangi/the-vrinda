    "slug": "valmiki-ramayana-1-sarga-42-shlok-10",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "तत्र स्थलीमरुप्राया अत्युच्चशिशिराः शिलाः॥",
          "गिरिजालावृतां दुर्गा मार्गित्वा पश्चिमां दिशम्।",
          "ततः पश्चिममागम्य समुद्रं द्रष्टुमर्हथ॥१०॥",
          "तिमिनक्राकुलजलं गत्वा द्रक्ष्यथ वानराः।"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-42",
    "chapterName": "बालकाण्ड, सर्ग 42",
    "verseNumber": 10
  },
  {
    "id": "valmiki-ramayana-1-sarga-42-shlok-12",
