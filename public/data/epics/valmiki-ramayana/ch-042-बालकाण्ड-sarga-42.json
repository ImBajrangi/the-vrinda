    "slug": "valmiki-ramayana-1-sarga-42-shlok-13",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "ऊर्ध्वबाहुः पञ्चतपा मासाहारो जितेन्द्रियः।",
          "तस्य वर्षसहस्राणि घोरे तपसि तिष्ठतः॥१३॥",
          "अतीतानि महाबाहो तस्य राज्ञो महात्मनः।"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-42",
    "chapterName": "बालकाण्ड, सर्ग 42",
    "verseNumber": 13
  },
