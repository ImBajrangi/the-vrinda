    "slug": "valmiki-ramayana-1-sarga-42-shlok-5",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "दिलीपस्तु महातेजाः श्रुत्वा पैतामहं वधम्।",
          "दुःखोपहतया बुद्धया निश्चयं नाध्यगच्छत॥५॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-42",
    "chapterName": "बालकाण्ड, सर्ग 42",
    "verseNumber": 5
  },
