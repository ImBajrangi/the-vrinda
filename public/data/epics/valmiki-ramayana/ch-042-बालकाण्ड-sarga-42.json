        "stanzaNumber": 1,
        "linesDevanagari": [
          "द्वात्रिंशच्छतसाहस्रं वर्षाणि सुमहायशाः।",
          "तपोवनगतो राजा स्वर्गं लेभे तपोधनः॥४॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-42",
    "chapterName": "बालकाण्ड, सर्ग 42",
    "verseNumber": 4
  },
