    "slug": "valmiki-ramayana-1-sarga-42-shlok-17-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "तानि नीडानि सिंहानां गिरिशृङ्गगताश्च ये।",
          "दृप्तास्तृप्ताश्च मातङ्गास्तोयदस्वननिःस्वनाः॥१७॥",
          "विचरन्ति विशालेऽस्मिंस्तोयपूर्णे समन्ततः।"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-42",
    "chapterName": "बालकाण्ड, सर्ग 42",
    "verseNumber": 17
