        "stanzaNumber": 1,
        "linesDevanagari": [
          "तस्य शृङ्ख दिवस्पर्श काञ्चनं चित्रपादपम्॥१८॥",
          "सर्वमाशु विचेतव्यं कपिभिः कामरूपिभिः।"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-42",
    "chapterName": "बालकाण्ड, सर्ग 42",
