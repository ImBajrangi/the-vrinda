    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "प्रत्यक्स्रोतोवहाश्चैव नद्यः शीतजलाः शिवाः॥८॥",
          "तापसानामरण्यानि कान्तारगिरयश्च ये।"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-42",
    "chapterName": "बालकाण्ड, सर्ग 42",
    "verseNumber": 8
