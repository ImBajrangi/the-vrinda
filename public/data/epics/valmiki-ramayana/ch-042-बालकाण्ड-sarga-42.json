    "slug": "valmiki-ramayana-1-sarga-42-shlok-3",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "तस्मै राज्यं समादिश्य दिलीपे रघुनन्दन।",
          "हिमवच्छिखरे रम्ये तपस्तेपे सुदारुणम्॥३॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-42",
    "chapterName": "बालकाण्ड, सर्ग 42",
    "verseNumber": 3
  },
