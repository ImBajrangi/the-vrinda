    "slug": "valmiki-ramayana-1-sarga-42-shlok-6",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "कथं गंगावतरणं कथं तेषां जलक्रिया।",
          "तारयेयं कथं चैतानिति चिन्तापरोऽभवत्॥६॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-42",
    "chapterName": "बालकाण्ड, सर्ग 42",
    "verseNumber": 6
  },
