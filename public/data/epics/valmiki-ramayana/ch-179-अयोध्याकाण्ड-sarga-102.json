    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "शाश्वतोऽयं सदा धर्मः स्थितोऽस्मासु नरर्षभ।",
          "ज्येष्ठ पुत्रे स्थिते राजा न कनीयान् भवेन्नृपः॥ २॥"
        ]
      }
    ],
