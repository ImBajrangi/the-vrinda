    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "एवं गृध्रो हतस्तेन रावणेन बलीयसा।",
          "संस्कृतश्चापि रामेण जगाम गतिमुत्तमाम्॥११॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-57",
    "chapterName": "बालकाण्ड, सर्ग 57",
    "verseNumber": 11
  },
