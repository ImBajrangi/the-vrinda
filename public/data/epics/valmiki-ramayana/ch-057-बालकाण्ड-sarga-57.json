    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 57, श्लोक 1",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-57-shlok-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "शोकाद् भ्रष्टस्वरमपि श्रुत्वा वानरयूथपाः।",
          "श्रद्दधु व तद्वाक्यं कर्मणा तस्य शङ्किताः॥१॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-57",
    "chapterName": "बालकाण्ड, सर्ग 57",
    "verseNumber": 1
  },
  {
    "id": "valmiki-ramayana-1-sarga-57-shlok-2-1",
    "collectionId": "valmiki-ramayana",
    "index": 2459,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 57, श्लोक 2",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-57-shlok-2-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "ते प्रायमुपविष्टास्तु दृष्ट्वा गृध्र प्लवंगमाः।",
          "चक्रुर्बुद्धिं तदा रौद्रां सर्वान् नो भक्षयिष्यति॥२॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-57",
    "chapterName": "बालकाण्ड, सर्ग 57",
    "verseNumber": 2
  },
  {
    "id": "valmiki-ramayana-1-sarga-57-shlok-3-1",
    "collectionId": "valmiki-ramayana",
    "index": 2460,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 57, श्लोक 3",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-57-shlok-3-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "सर्वथा प्रायमासीनान् यदि नो भक्षयिष्यति।",
          "कृतकृत्या भविष्यामः क्षिप्रं सिद्धिमितो गताः॥३॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-57",
    "chapterName": "बालकाण्ड, सर्ग 57",
    "verseNumber": 3
  },
  {
    "id": "valmiki-ramayana-1-sarga-57-shlok-4-1",
    "collectionId": "valmiki-ramayana",
    "index": 2461,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 57, श्लोक 4",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-57-shlok-4-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "एतां बुद्धिं ततश्चक्रुः सर्वे ते हरियूथपाः।",
          "अवतार्य गिरेः शृङ्गाद् गृध्रमाहाङ्गदस्तदा ॥४॥",
          "बभूवर्क्षरजो नाम वानरेन्द्रः प्रतापवान्।",
          "ममार्यः पार्थिवः पक्षिन् धार्मिकौ तस्य चात्मजौ॥",
          "सुग्रीवश्चैव वाली च पुत्रौ घनबलावुभौ।",
          "लोके विश्रुतकर्माभूद् राजा वाली पिता मम॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-57",
    "chapterName": "बालकाण्ड, सर्ग 57",
    "verseNumber": 4
  },
  {
    "id": "valmiki-ramayana-1-sarga-57-shlok-6",
    "collectionId": "valmiki-ramayana",
    "index": 2462,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 57, श्लोक 6",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-57-shlok-6",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "एवमुक्त्वा महातेजा जगाम सह दैवतैः॥६॥",
          "त्रिविष्टपं ब्रह्मलोकं लोकानां परमेश्वरः।"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-57",
    "chapterName": "बालकाण्ड, सर्ग 57",
    "verseNumber": 6
  },
  {
    "id": "valmiki-ramayana-1-sarga-57-shlok-8-1",
    "collectionId": "valmiki-ramayana",
    "index": 2463,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 57, श्लोक 8",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-57-shlok-8-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "राजा कृत्स्नस्य जगत इक्ष्वाकूणां महारथः।",
          "रामो दाशरथिः श्रीमान् प्रविष्टो दण्डकावनम्॥७॥",
          "लक्ष्मणेन सह भ्रात्रा वैदेह्या सह भार्यया।",
          "पितुर्निदेशनिरतो धर्मं पन्थानमाश्रितः॥८॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-57",
    "chapterName": "बालकाण्ड, सर्ग 57",
    "verseNumber": 8
  },
  {
    "id": "valmiki-ramayana-1-sarga-57-shlok-9",
    "collectionId": "valmiki-ramayana",
    "index": 2464,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 57, श्लोक 9",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-57-shlok-9",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "एवं निश्चित्य मनसा भूय एव महातपाः॥९॥",
          "तपश्चचार धर्मात्मा काकुत्स्थ परमात्मवान्।",
          "एतस्मिन्नेव काले तु सत्यवादी जितेन्द्रियः॥ १०॥",
          "त्रिशङ्करिति विख्यात इक्ष्वाकुकुलवर्धनः।"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-57",
    "chapterName": "बालकाण्ड, सर्ग 57",
    "verseNumber": 9
  },
  {
