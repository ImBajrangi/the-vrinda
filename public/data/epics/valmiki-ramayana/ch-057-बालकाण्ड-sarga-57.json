    "collectionId": "valmiki-ramayana",
    "index": 2465,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 57, श्लोक 10",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-57-shlok-10",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "तस्य भार्या जनस्थानाद् रावणेन हृता बलात्।",
          "रामस्य तु पितुर्मित्रं जटायुर्नाम गृध्रराट्॥९॥",
          "ददर्श सीतां वैदेहीं ह्रियमाणां विहायसा।",
          "रावणं विरथं कृत्वा स्थापयित्वा च मैथिलीम्।",
          "परिश्रान्तश्च वृद्धश्च रावणेन हतो रणे॥१०॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-57",
    "chapterName": "बालकाण्ड, सर्ग 57",
    "verseNumber": 10
  },
  {
