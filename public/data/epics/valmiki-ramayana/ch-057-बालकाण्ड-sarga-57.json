        "stanzaNumber": 1,
        "linesDevanagari": [
          "ततो मम पितृव्येण सुग्रीवेण महात्मना।",
          "चकार राघवः सख्यं सोऽवधीत् पितरं मम॥१२॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-57",
    "chapterName": "बालकाण्ड, सर्ग 57",
    "verseNumber": 12
  },
