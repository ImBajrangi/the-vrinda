    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "सुसंरब्धं तु भरतं लक्ष्मणं क्रोधमूर्च्छितम्।",
          "रामस्तु परिसान्त्व्याथ वचनं चेदमब्रवीत्॥१॥"
        ]
      }
    ],
    "chapterId": "अयोध्याकाण्ड-sarga-97",
    "chapterName": "अयोध्याकाण्ड, सर्ग 97",
    "verseNumber": 1
  },
