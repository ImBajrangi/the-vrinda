          "शक्तिः स्याद् वैनतेयस्य तव वा मारुतस्य वा॥९॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-56",
    "chapterName": "सुन्दरकाण्ड, सर्ग 56",
    "verseNumber": 9
