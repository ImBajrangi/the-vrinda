    "slug": "valmiki-ramayana-5-sarga-56-shlok-2",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "ततस्तं प्रस्थितं सीता वीक्षमाणा पुनः पुनः।",
          "भर्तुः स्नेहान्विता वाक्यं हनूमन्तमभाषत॥२॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-56",
    "chapterName": "सुन्दरकाण्ड, सर्ग 56",
    "verseNumber": 2
  },
