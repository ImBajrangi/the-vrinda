    "slug": "valmiki-ramayana-5-sarga-56-shlok-8",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "अयं च वीर संदेहस्तिष्ठतीव ममाग्रतः।",
          "सुमहत्सु सहायेषु हर्युक्षेषु महाबलः॥७॥",
          "कथं नु खलु दुष्पारं संतरिष्यति सागरम्।",
          "तानि हयृक्षसैन्यानि तौ वा नरवरात्मजौ॥८॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-56",
    "chapterName": "सुन्दरकाण्ड, सर्ग 56",
    "verseNumber": 8
  },
