    "slug": "valmiki-ramayana-5-sarga-56-shlok-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "ततस्तु शिंशपामूले जानकी पर्यवस्थिताम्।",
          "अभिवाद्याब्रवीद् दिष्ट्या पश्यामि त्वामिहाक्षताम्॥१॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-56",
    "chapterName": "सुन्दरकाण्ड, सर्ग 56",
    "verseNumber": 1
  },
  {
