    "slug": "valmiki-ramayana-1-sarga-55-shlok-14",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "वाच्यस्तातो यवीयान् मे सुग्रीवो वानरेश्वरः।",
          "आरोग्यपूर्वं कुशलं वाच्या माता रुमा च मे॥१४॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-55",
    "chapterName": "बालकाण्ड, सर्ग 55",
    "verseNumber": 14
  },
  {
    "id": "valmiki-ramayana-1-sarga-55-shlok-15",
