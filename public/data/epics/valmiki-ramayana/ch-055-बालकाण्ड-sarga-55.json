    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 55, श्लोक 15",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-55-shlok-15",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "मातरं चैव मे तारामाश्वासयितुमर्हथ।",
          "प्रकृत्या प्रियपुत्रा सा सानुक्रोशा तपस्विनी॥१५॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-55",
    "chapterName": "बालकाण्ड, सर्ग 55",
    "verseNumber": 15
  },
  {
    "id": "valmiki-ramayana-1-sarga-55-shlok-16-1",
    "collectionId": "valmiki-ramayana",
    "index": 2420,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 55, श्लोक 16",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-55-shlok-16-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "विनष्टमिह मां श्रुत्वा व्यक्तं हास्यति जीवितम्।",
          "एतावदुक्त्वा वचनं वृद्धांस्तानभिवाद्य च॥१६॥",
          "विवेश चाङ्गदो भूमौ रुदन् दर्भेषु दुर्मनाः।"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-55",
    "chapterName": "बालकाण्ड, सर्ग 55",
    "verseNumber": 16
  },
  {
    "id": "valmiki-ramayana-1-sarga-55-shlok-17",
    "collectionId": "valmiki-ramayana",
    "index": 2421,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 55, श्लोक 17",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-55-shlok-17",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "तस्य संविशतस्तत्र रुदन्तो वानरर्षभाः॥१७॥",
          "नयनेभ्यः प्रमुमुचुरुष्णं वै वारि दुःखिताः।",
          "सुग्रीवं चैव निन्दन्तः प्रशंसन्तश्च वालिनम्॥१८॥",
          "परिवार्याङ्गदं सर्वे व्यवसन् प्रायमासितुम्।"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-55",
    "chapterName": "बालकाण्ड, सर्ग 55",
    "verseNumber": 17
  },
  {
    "id": "valmiki-ramayana-1-sarga-55-shlok-19",
    "collectionId": "valmiki-ramayana",
    "index": 2422,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 55, श्लोक 19",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-55-shlok-19",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "तद् वाक्यं वालिपुत्रस्य विज्ञाय प्लवगर्षभाः॥१९॥",
          "उपस्पृश्योदकं सर्वे प्राङ्मुखाः समुपाविशन्।",
          "दक्षिणाग्रेषु दर्भेषु उदक्तीरं समाश्रिताः॥२०॥",
          "मुमूर्षवो हरिश्रेष्ठा एतत् क्षममिति स्म ह।"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-55",
    "chapterName": "बालकाण्ड, सर्ग 55",
    "verseNumber": 19
  },
  {
