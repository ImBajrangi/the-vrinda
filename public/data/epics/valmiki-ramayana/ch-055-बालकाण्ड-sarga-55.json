    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-55-shlok-20",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "विवर्धमानो वीर्येण समुद्र इव पर्वणि।",
          "हतं मेने तदा राम वसिष्ठमृषिसत्तमम्॥२०॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-55",
    "chapterName": "बालकाण्ड, सर्ग 55",
    "verseNumber": 20
  },
  {
