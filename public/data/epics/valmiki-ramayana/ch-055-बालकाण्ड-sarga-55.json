    "slug": "valmiki-ramayana-1-sarga-55-shlok-13-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "अभिवादनपूर्वं तु राजा कुशलमेव च।",
          "अभिवादनपूर्वं तु राघवौ बलशालिनौ ॥१३॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-55",
    "chapterName": "बालकाण्ड, सर्ग 55",
    "verseNumber": 13
  },
  {
