    "slug": "valmiki-ramayana-1-sarga-55-shlok-21",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "ततो गत्वाऽऽश्रमपदं मुमोचास्त्राणि पार्थिवः।",
          "यैस्तत् तपोवनं नाम निर्दग्धं चास्त्रतेजसा॥२१॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-55",
