[
  {
    "id": "valmiki-ramayana-1-sarga-55-shlok-1-1",
    "collectionId": "valmiki-ramayana",
    "index": 2405,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 55, श्लोक 1",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-55-shlok-1-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "श्रुत्वा हनुमतो वाक्यं प्रश्रितं धर्मसंहितम्।",
          "स्वामिसत्कारसंयुक्तमङ्गदो वाक्यमब्रवीत्॥१॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-55",
    "chapterName": "बालकाण्ड, सर्ग 55",
    "verseNumber": 1
  },
  {
    "id": "valmiki-ramayana-1-sarga-55-shlok-2",
    "collectionId": "valmiki-ramayana",
    "index": 2406,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 55, श्लोक 2",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-55-shlok-2",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "स्थैर्यमात्ममनःशौचमानृशंस्यमथार्जवम्।",
          "विक्रमश्चैव धैर्यं च सुग्रीवे नोपपद्यते॥२॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-55",
    "chapterName": "बालकाण्ड, सर्ग 55",
    "verseNumber": 2
  },
  {
    "id": "valmiki-ramayana-1-sarga-55-shlok-3",
    "collectionId": "valmiki-ramayana",
    "index": 2407,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 55, श्लोक 3",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-55-shlok-3",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "योनिदेशाच्च यवनाः शकृद्देशाच्छकाः स्मृताः।",
          "रोमकूपेषु म्लेच्छाश्च हारीताः सकिरातकाः॥ ३॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-55",
    "chapterName": "बालकाण्ड, सर्ग 55",
    "verseNumber": 3
  },
  {
    "id": "valmiki-ramayana-1-sarga-55-shlok-4",
    "collectionId": "valmiki-ramayana",
    "index": 2408,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 55, श्लोक 4",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-55-shlok-4",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "भ्रातुर्येष्ठस्य यो भार्यां जीवतो महिषीं प्रियाम्।",
          "धर्मेण मातरं यस्तु स्वीकरोति जुगुप्सितः॥३॥",
          "कथं स धर्मं जानीते येन भ्रात्रा दुरात्मना।",
          "युद्धायाभिनियुक्तेन बिलस्य पिहितं मुखम्॥४॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-55",
    "chapterName": "बालकाण्ड, सर्ग 55",
    "verseNumber": 4
  },
  {
    "id": "valmiki-ramayana-1-sarga-55-shlok-5",
    "collectionId": "valmiki-ramayana",
    "index": 2409,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 55, श्लोक 5",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-55-shlok-5",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "सत्यात् पाणिगृहीतश्च कृतकर्मा महायशाः।",
          "विस्मृतो राघवो येन स कस्य सुकृतं स्मरेत्॥५॥",
          "लक्ष्मणस्य भयेनेह नाधर्मभयभीरुणा।",
          "आदिष्टा मार्गितुं सीता धर्मस्तस्मिन् कथं भवेत्॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-55",
    "chapterName": "बालकाण्ड, सर्ग 55",
    "verseNumber": 5
  },
  {
    "id": "valmiki-ramayana-1-sarga-55-shlok-6",
    "collectionId": "valmiki-ramayana",
    "index": 2410,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 55, श्लोक 6",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-55-shlok-6",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "दृष्ट्वा निषूदितं सैन्यं वसिष्ठेन महात्मना।",
          "विश्वामित्रसुतानां तु शतं नानाविधायुधम्॥५॥",
          "अभ्यधावत् सुसंक्रुद्धं वसिष्ठं जपतां वरम्।",
          "हंकारेणैव तान् सर्वान् निर्ददाह महानृषिः॥६॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-55",
    "chapterName": "बालकाण्ड, सर्ग 55",
    "verseNumber": 6
  },
  {
    "id": "valmiki-ramayana-1-sarga-55-shlok-7-1",
    "collectionId": "valmiki-ramayana",
    "index": 2411,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 55, श्लोक 7",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-55-shlok-7-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "तस्मिन् पापे कृतघ्ने तु स्मृतिभिन्ने चलात्मनि।"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-55",
    "chapterName": "बालकाण्ड, सर्ग 55",
    "verseNumber": 7
  },
  {
    "id": "valmiki-ramayana-1-sarga-55-shlok-8-1",
    "collectionId": "valmiki-ramayana",
    "index": 2412,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 55, श्लोक 8",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-55-shlok-8-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "राज्ये पुत्रः प्रतिष्ठाप्यः सगुणो निर्गुणोऽपि वा।",
          "कथं शत्रुकुलीनं मां सुग्रीवो जीवयिष्यति॥८॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-55",
    "chapterName": "बालकाण्ड, सर्ग 55",
    "verseNumber": 8
  },
  {
    "id": "valmiki-ramayana-1-sarga-55-shlok-9-1",
    "collectionId": "valmiki-ramayana",
    "index": 2413,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 55, श्लोक 9",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-55-shlok-9-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "भिन्नमन्त्रोऽपराद्धश्च भिन्नशक्तिः कथं ह्यहम्।",
          "किष्किन्धां प्राप्य जीवेयमनाथ इव दुर्बलः॥९॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-55",
    "chapterName": "बालकाण्ड, सर्ग 55",
    "verseNumber": 9
  },
  {
    "id": "valmiki-ramayana-1-sarga-55-shlok-10",
    "collectionId": "valmiki-ramayana",
    "index": 2414,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 55, श्लोक 10",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-55-shlok-10",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "उपांशुदण्डेन हि मां बन्धनेनोपपादयेत्।",
          "शठः क्रूरो नृशंसश्च सुग्रीवो राज्यकारणात्॥१०॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-55",
    "chapterName": "बालकाण्ड, सर्ग 55",
    "verseNumber": 10
  },
  {
    "id": "valmiki-ramayana-1-sarga-55-shlok-11-1",
    "collectionId": "valmiki-ramayana",
    "index": 2415,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 55, श्लोक 11",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-55-shlok-11-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "बन्धनाच्चावसादान्मे श्रेयः प्रायोपवेशनम्।",
          "अनुजानन्तु मां सर्वे गृहं गच्छन्तु वानराः॥११॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-55",
    "chapterName": "बालकाण्ड, सर्ग 55",
    "verseNumber": 11
  },
  {
    "id": "valmiki-ramayana-1-sarga-55-shlok-12",
    "collectionId": "valmiki-ramayana",
    "index": 2416,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 55, श्लोक 12",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-55-shlok-12",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "अहं वः प्रतिजानामि न गमिष्याम्यहं पुरीम्।",
          "इहैव प्रायमासिष्ये श्रेयो मरणमेव मे॥१२॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-55",
    "chapterName": "बालकाण्ड, सर्ग 55",
    "verseNumber": 12
  },
  {
