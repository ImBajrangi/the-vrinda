    "titleDevanagari": "वाल्मीकि रामायण, युद्धकाण्ड, सर्ग 70, श्लोक 2",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-6-sarga-70-shlok-2",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "आरूढो मेघसंकाशं वारणेन्द्रं महोदरः।",
          "वालिपुत्रं महावीर्यमभिदुद्राव वेगवान्॥२॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-70",
    "chapterName": "युद्धकाण्ड, सर्ग 70",
    "verseNumber": 2
  },
  {
