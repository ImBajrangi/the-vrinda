    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "परिघाग्रेण तान् वृक्षान् बभञ्ज स महोदरः।",
          "त्रिशिराश्चाङ्गदं वीरमभिदुद्राव सायकैः॥९॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-70",
    "chapterName": "युद्धकाण्ड, सर्ग 70",
    "verseNumber": 9
  },
