    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-6-sarga-70-shlok-4",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "रथमादित्यसंकाशं युक्तं परमवाजिभिः।",
          "आस्थाय त्रिशिरा वीरो वालिपुत्रमथाभ्यगात्॥४॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-70",
    "chapterName": "युद्धकाण्ड, सर्ग 70",
    "verseNumber": 4
  },
  {
    "id": "valmiki-ramayana-6-sarga-70-shlok-6",
    "collectionId": "valmiki-ramayana",
    "index": 13917,
    "titleDevanagari": "वाल्मीकि रामायण, युद्धकाण्ड, सर्ग 70, श्लोक 6",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-6-sarga-70-shlok-6",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "स त्रिभिर्देवदर्पनै राक्षसेन्ट्रैरभिद्रुतः।",
          "वृक्षमुत्पाटयामास महाविटपमङ्गदः॥५॥",
          "देवान्तकाय तं वीरश्चिक्षेप सहसाङ्गदः।",
          "महावृक्षं महाशाखं शक्रो दीप्तामिवाशनिम्॥६॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-70",
    "chapterName": "युद्धकाण्ड, सर्ग 70",
    "verseNumber": 6
  },
  {
    "id": "valmiki-ramayana-6-sarga-70-shlok-8",
    "collectionId": "valmiki-ramayana",
    "index": 13918,
    "titleDevanagari": "वाल्मीकि रामायण, युद्धकाण्ड, सर्ग 70, श्लोक 8",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-6-sarga-70-shlok-8",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "त्रिशिरास्तं प्रचिच्छेद शरैराशीविषोपमैः ।",
          "स वृक्षं कृत्तमालोक्य उत्पपात तदाङ्गदः॥७॥",
          "स ववर्ष ततो वृक्षान् शिलाश्च कपिकुञ्जरः।",
          "तान् प्रचिच्छेद संक्रुद्धस्त्रिशिरा निशितैः शरैः॥८॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-70",
    "chapterName": "युद्धकाण्ड, सर्ग 70",
    "verseNumber": 8
  },
  {
