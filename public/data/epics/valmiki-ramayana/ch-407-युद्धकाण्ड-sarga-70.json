    "slug": "valmiki-ramayana-6-sarga-70-shlok-3",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "भ्रातृव्यसनसंतप्तस्तदा देवान्तको बली।",
          "आदाय परिघं घोरमदं समभिद्रवत्॥३॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-70",
    "chapterName": "युद्धकाण्ड, सर्ग 70",
    "verseNumber": 3
  },
  {
    "id": "valmiki-ramayana-6-sarga-70-shlok-4",
