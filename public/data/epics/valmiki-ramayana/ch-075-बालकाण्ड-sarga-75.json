    "slug": "valmiki-ramayana-1-sarga-75-shlok-17",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "तदा तु जृम्भितं शैवं धनुर्भीमपराक्रमम्॥१७॥",
          "हुंकारेण महादेवः स्तम्भितोऽथ त्रिलोचनः।"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-75",
    "chapterName": "बालकाण्ड, सर्ग 75",
    "verseNumber": 17
  },
  {
    "id": "valmiki-ramayana-1-sarga-75-shlok-18",
