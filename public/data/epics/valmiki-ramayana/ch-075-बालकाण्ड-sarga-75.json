    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-75-shlok-22",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "ऋचीकस्तु महातेजाः पुत्रस्याप्रतिकर्मणः॥२२॥",
          "पितर्मम ददौ दिव्यं जमदग्नेर्महात्मनः।"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-75",
    "chapterName": "बालकाण्ड, सर्ग 75",
    "verseNumber": 22
  },
