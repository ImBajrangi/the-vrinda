[
  {
    "id": "valmiki-ramayana-1-sarga-75-shlok-1",
    "collectionId": "valmiki-ramayana",
    "index": 2927,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 75, श्लोक 1",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-75-shlok-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "राम दाशरथे वीर वीर्यं ते श्रूयतेऽद्भुतम्।",
          "धनुषो भेदनं चैव निखिलेन मया श्रुतम्॥१॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-75",
    "chapterName": "बालकाण्ड, सर्ग 75",
    "verseNumber": 1
  },
  {
    "id": "valmiki-ramayana-1-sarga-75-shlok-2",
    "collectionId": "valmiki-ramayana",
    "index": 2928,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 75, श्लोक 2",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-75-shlok-2",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "तदद्भुतमचिन्त्यं च भेदनं धनुषस्तथा।",
          "तच्छ्रत्वाहमनुप्राप्तो धनुर्गृह्यापरं शुभम्॥२॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-75",
    "chapterName": "बालकाण्ड, सर्ग 75",
    "verseNumber": 2
  },
  {
    "id": "valmiki-ramayana-1-sarga-75-shlok-3",
    "collectionId": "valmiki-ramayana",
    "index": 2929,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 75, श्लोक 3",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-75-shlok-3",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "तदिदं घोरसंकाशं जामदग्न्यं महद्धनुः।",
          "पूरयस्व शरेणैव स्वबलं दर्शयस्व च॥३॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-75",
    "chapterName": "बालकाण्ड, सर्ग 75",
    "verseNumber": 3
  },
  {
    "id": "valmiki-ramayana-1-sarga-75-shlok-4",
    "collectionId": "valmiki-ramayana",
    "index": 2930,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 75, श्लोक 4",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-75-shlok-4",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "तदहं ते बलं दृष्ट्वा धनुषोऽप्यस्य पूरणे।",
          "द्वन्द्वयुद्धं प्रदास्यामि वीर्यश्लाघ्यमहं तव॥४॥",
          "तस्य तद् वचनं श्रुत्वा राजा दशरथस्तदा।",
          "विषण्णवदनो दीनः प्राञ्जलिर्वाक्यमब्रवीत्॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-75",
    "chapterName": "बालकाण्ड, सर्ग 75",
    "verseNumber": 4
  },
  {
    "id": "valmiki-ramayana-1-sarga-75-shlok-7",
    "collectionId": "valmiki-ramayana",
    "index": 2931,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 75, श्लोक 7",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-75-shlok-7",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "क्षत्ररोषात् प्रशान्तस्त्वं ब्राह्मणश्च महातपाः।",
          "बालानां मम पुत्राणामभयं दातुमर्हसि॥६॥",
          "भार्गवाणां कुले जातः स्वाध्यायव्रतशालिनाम्।",
          "सहस्राक्षे प्रतिज्ञाय शस्त्रं प्रक्षिप्तवानसि॥७॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-75",
    "chapterName": "बालकाण्ड, सर्ग 75",
    "verseNumber": 7
  },
  {
    "id": "valmiki-ramayana-1-sarga-75-shlok-8",
    "collectionId": "valmiki-ramayana",
    "index": 2932,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 75, श्लोक 8",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-75-shlok-8",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "स त्वं धर्मपरो भूत्वा कश्यपाय वसुंधराम्।",
          "दत्त्वा वनमुपागम्य महेन्द्रकृतकेतनः॥८॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-75",
    "chapterName": "बालकाण्ड, सर्ग 75",
    "verseNumber": 8
  },
  {
    "id": "valmiki-ramayana-1-sarga-75-shlok-9",
    "collectionId": "valmiki-ramayana",
    "index": 2933,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 75, श्लोक 9",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-75-shlok-9",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "मम सर्वविनाशाय सम्प्राप्तस्त्वं महामुने।",
          "न चैकस्मिन् हते रामे सर्वे जीवामहे वयम्॥९॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-75",
    "chapterName": "बालकाण्ड, सर्ग 75",
    "verseNumber": 9
  },
  {
    "id": "valmiki-ramayana-1-sarga-75-shlok-10",
    "collectionId": "valmiki-ramayana",
    "index": 2934,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 75, श्लोक 10",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-75-shlok-10",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "ब्रुवत्येवं दशरथे जामदग्न्यः प्रतापवान्।",
          "अनादृत्य तु तद्वाक्यं राममेवाभ्यभाषत॥१०॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-75",
    "chapterName": "बालकाण्ड, सर्ग 75",
    "verseNumber": 10
  },
  {
    "id": "valmiki-ramayana-1-sarga-75-shlok-11",
    "collectionId": "valmiki-ramayana",
    "index": 2935,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 75, श्लोक 11",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-75-shlok-11",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "इमे द्वे धनुषी श्रेष्ठे दिव्ये लोकाभिपूजिते।",
          "दृढे बलवती मुख्ये सुकृते विश्वकर्मणा ॥११॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-75",
    "chapterName": "बालकाण्ड, सर्ग 75",
    "verseNumber": 11
  },
  {
    "id": "valmiki-ramayana-1-sarga-75-shlok-12",
    "collectionId": "valmiki-ramayana",
    "index": 2936,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 75, श्लोक 12",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-75-shlok-12",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "अनुसृष्टं सुरैरेकं त्र्यम्बकाय युयुत्सवे।",
          "त्रिपुरगं नरश्रेष्ठ भग्नं काकुत्स्थ यत्त्वया॥१२॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-75",
    "chapterName": "बालकाण्ड, सर्ग 75",
    "verseNumber": 12
  },
  {
    "id": "valmiki-ramayana-1-sarga-75-shlok-13",
    "collectionId": "valmiki-ramayana",
    "index": 2937,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 75, श्लोक 13",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-75-shlok-13",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "इदं द्वितीयं दुर्धर्षं विष्णोर्दत्तं सुरोत्तमैः ।",
          "तदिदं वैष्णवं राम धनुः परपुरंजयम्॥१३॥",
          "समानसारं काकुत्स्थ रौद्रेण धनुषा त्विदम्।",
          "तदा तु देवताः सर्वाः पृच्छन्ति स्म पितामहम्॥ १४॥",
          "शितिकण्ठस्य विष्णोश्च बलाबलनिरीक्षया।"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-75",
    "chapterName": "बालकाण्ड, सर्ग 75",
    "verseNumber": 13
  },
  {
    "id": "valmiki-ramayana-1-sarga-75-shlok-15",
    "collectionId": "valmiki-ramayana",
    "index": 2938,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 75, श्लोक 15",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-75-shlok-15",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "अभिप्रायं तु विज्ञाय देवतानां पितामहः॥१५॥",
          "विरोधं जनयामास तयोः सत्यवतां वरः।।"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-75",
    "chapterName": "बालकाण्ड, सर्ग 75",
    "verseNumber": 15
  },
  {
