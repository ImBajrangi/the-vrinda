    "slug": "valmiki-ramayana-1-sarga-75-shlok-18",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "देवैस्तदा समागम्य सर्षिसङ्गः सचारणैः॥१८॥",
          "याचितौ प्रशमं तत्र जग्मतुस्तौ सुरोत्तमौ।",
          "जृम्भितं तद् धनुर्दृष्ट्वा शैवं विष्णुपराक्रमैः॥ १९॥",
          "अधिकं मेनिरे विष्णुं देवाः सर्षिगणास्तथा।"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-75",
    "chapterName": "बालकाण्ड, सर्ग 75",
    "verseNumber": 18
  },
  {
    "id": "valmiki-ramayana-1-sarga-75-shlok-20",
    "collectionId": "valmiki-ramayana",
    "index": 2942,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 75, श्लोक 20",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-75-shlok-20",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "धनू रुद्रस्तु संक्रुद्धो विदेहेषु महायशाः॥२०॥",
          "देवरातस्य राजर्षेर्ददौ हस्ते ससायकम्।",
          "इदं च वैष्णवं राम धनुः परपुरंजयम्॥ २१॥",
          "ऋचीके भार्गवे प्रादाद् विष्णुः स न्यासमुत्तमम्।"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-75",
    "chapterName": "बालकाण्ड, सर्ग 75",
    "verseNumber": 20
  },
  {
    "id": "valmiki-ramayana-1-sarga-75-shlok-22",
