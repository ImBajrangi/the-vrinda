    "slug": "valmiki-ramayana-1-sarga-75-shlok-16",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "विरोधे तु महद् युद्धमभवद् रोमहर्षणम्॥१६॥",
          "शितिकण्ठस्य विष्णोश्च परस्परजयैषिणोः।"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-75",
    "chapterName": "बालकाण्ड, सर्ग 75",
    "verseNumber": 16
  },
  {
