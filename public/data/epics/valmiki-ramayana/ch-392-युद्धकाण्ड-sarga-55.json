    "collectionId": "valmiki-ramayana",
    "index": 13027,
    "titleDevanagari": "वाल्मीकि रामायण, युद्धकाण्ड, सर्ग 55, श्लोक 6",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-6-sarga-55-shlok-6",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "ततो नानाप्रहरणा भीमाक्षा भीमदर्शनाः।",
          "निष्पेतू राक्षसा मुख्या बलाध्यक्षप्रचोदिताः॥६॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-55",
    "chapterName": "युद्धकाण्ड, सर्ग 55",
    "verseNumber": 6
  },
  {
    "id": "valmiki-ramayana-6-sarga-55-shlok-7",
    "collectionId": "valmiki-ramayana",
    "index": 13028,
    "titleDevanagari": "वाल्मीकि रामायण, युद्धकाण्ड, सर्ग 55, श्लोक 7",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-6-sarga-55-shlok-7",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "रथमास्थाय विपुलं तप्तकाञ्चनभूषणम्।",
          "मेघाभो मेघवर्णश्च मेघस्वनमहास्वनः॥७॥",
          "राक्षसैः संवृतो घोरैस्तदा निर्यात्यकम्पनः।"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-55",
    "chapterName": "युद्धकाण्ड, सर्ग 55",
    "verseNumber": 7
  },
  {
    "id": "valmiki-ramayana-6-sarga-55-shlok-8",
    "collectionId": "valmiki-ramayana",
    "index": 13029,
    "titleDevanagari": "वाल्मीकि रामायण, युद्धकाण्ड, सर्ग 55, श्लोक 8",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-6-sarga-55-shlok-8",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "नहि कम्पयितुं शक्यः सुरैरपि महामृधे॥८॥",
          "अकम्पनस्ततस्तेषामादित्य इव तेजसा।"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-55",
    "chapterName": "युद्धकाण्ड, सर्ग 55",
    "verseNumber": 8
  },
  {
