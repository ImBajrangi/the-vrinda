    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-6-sarga-55-shlok-9",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "तस्य निर्धावमानस्य संरब्धस्य युयुत्सया॥९॥",
          "अकस्माद् दैन्यमागच्छद्धयानां रथवाहिनाम्।"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-55",
    "chapterName": "युद्धकाण्ड, सर्ग 55",
    "verseNumber": 9
  },
  {
