    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-6-sarga-55-shlok-11",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "अभवत् सुदिने काले दुर्दिनं रूक्षमारुतम्॥११॥",
          "ऊचुः खगमृगाः सर्वे वाचः क्रूरा भयावहाः।"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-55",
    "chapterName": "युद्धकाण्ड, सर्ग 55",
    "verseNumber": 11
  },
