    "slug": "valmiki-ramayana-6-sarga-55-shlok-12",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "स सिंहोपचितस्कन्धः शार्दूलसमविक्रमः॥१२॥",
          "तानुत्पातानचिन्त्यैव निर्जगाम रणाजिरम्।"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-55",
    "chapterName": "युद्धकाण्ड, सर्ग 55",
    "verseNumber": 12
  },
