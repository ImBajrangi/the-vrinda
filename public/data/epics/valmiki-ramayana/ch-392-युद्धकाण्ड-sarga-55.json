    "titleDevanagari": "वाल्मीकि रामायण, युद्धकाण्ड, सर्ग 55, श्लोक 1",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-6-sarga-55-shlok-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "वज्रदंष्ट्रं हतं श्रुत्वा वालिपुत्रेण रावणः।",
          "बलाध्यक्षमुवाचेदं कृताञ्जलिमुपस्थितम्॥१॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-55",
    "chapterName": "युद्धकाण्ड, सर्ग 55",
    "verseNumber": 1
  },
  {
    "id": "valmiki-ramayana-6-sarga-55-shlok-2",
    "collectionId": "valmiki-ramayana",
    "index": 13023,
    "titleDevanagari": "वाल्मीकि रामायण, युद्धकाण्ड, सर्ग 55, श्लोक 2",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-6-sarga-55-shlok-2",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "शीघ्रं निर्यान्तुदुर्धर्षा राक्षसा भीमविक्रमाः।",
          "अकम्पनं पुरस्कृत्य सर्वशस्त्रास्त्रकोविदम्॥२॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-55",
    "chapterName": "युद्धकाण्ड, सर्ग 55",
    "verseNumber": 2
  },
  {
    "id": "valmiki-ramayana-6-sarga-55-shlok-3",
    "collectionId": "valmiki-ramayana",
    "index": 13024,
    "titleDevanagari": "वाल्मीकि रामायण, युद्धकाण्ड, सर्ग 55, श्लोक 3",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-6-sarga-55-shlok-3",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "एष शास्ता च गोप्ता च नेता च युधि सत्तमः।",
          "भूतिकामश्च मे नित्यं नित्यं च समरप्रियः॥३॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-55",
    "chapterName": "युद्धकाण्ड, सर्ग 55",
    "verseNumber": 3
  },
  {
    "id": "valmiki-ramayana-6-sarga-55-shlok-4",
    "collectionId": "valmiki-ramayana",
    "index": 13025,
    "titleDevanagari": "वाल्मीकि रामायण, युद्धकाण्ड, सर्ग 55, श्लोक 4",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-6-sarga-55-shlok-4",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "एष जेष्यति काकुत्स्थौ सुग्रीवं च महाबलम्।",
          "वानरांश्चापरान् घोरान् हनिष्यति न संशयः॥४॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-55",
    "chapterName": "युद्धकाण्ड, सर्ग 55",
    "verseNumber": 4
  },
  {
    "id": "valmiki-ramayana-6-sarga-55-shlok-5",
    "collectionId": "valmiki-ramayana",
    "index": 13026,
    "titleDevanagari": "वाल्मीकि रामायण, युद्धकाण्ड, सर्ग 55, श्लोक 5",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-6-sarga-55-shlok-5",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "परिगृह्य स तामाज्ञां रावणस्य महाबलः।",
          "बलं सम्प्रेरयामास तदा लघुपराक्रमः॥५॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-55",
    "chapterName": "युद्धकाण्ड, सर्ग 55",
    "verseNumber": 5
  },
  {
