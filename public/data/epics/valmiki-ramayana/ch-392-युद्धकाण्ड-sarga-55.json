    "slug": "valmiki-ramayana-6-sarga-55-shlok-13",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "तथा निर्गच्छतस्तस्य रक्षसः सह राक्षसैः॥१३॥",
          "बभूव सुमहान् नादः क्षोभयन्निव सागरम्।"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-55",
    "chapterName": "युद्धकाण्ड, सर्ग 55",
