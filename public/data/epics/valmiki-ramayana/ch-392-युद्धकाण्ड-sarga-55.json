    "slug": "valmiki-ramayana-6-sarga-55-shlok-10",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "व्यस्फुरन्नयनं चास्य सव्यं युद्धाभिनन्दिनः॥१०॥",
          "विवर्णो मुखवर्णश्च गद्गदश्चाभवत् स्वनः।"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-55",
    "chapterName": "युद्धकाण्ड, सर्ग 55",
    "verseNumber": 10
  },
