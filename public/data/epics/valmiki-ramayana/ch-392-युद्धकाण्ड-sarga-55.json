    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "तेन शब्देन वित्रस्ता वानराणां महाचमूः॥१४॥",
          "द्रुमशैलप्रहाराणां योद्धं समुपतिष्ठताम्।",
          "तेषां युद्धं महारौद्रं संजज्ञे कपिरक्षसाम्॥१५॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-55",
    "chapterName": "युद्धकाण्ड, सर्ग 55",
    "verseNumber": 15
  },
