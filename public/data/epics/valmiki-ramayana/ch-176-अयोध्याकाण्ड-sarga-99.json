    "slug": "valmiki-ramayana-2-sarga-99-shlok-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "निविष्टायां तु सेनायामुत्सुको भरतस्ततः।",
          "जगाम भ्रातरं द्रष्टं शत्रुघ्नमनुदर्शयन्॥१॥"
        ]
      }
    ],
    "chapterId": "अयोध्याकाण्ड-sarga-99",
    "chapterName": "अयोध्याकाण्ड, सर्ग 99",
    "verseNumber": 1
  },
  {
