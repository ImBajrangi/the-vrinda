    "slug": "valmiki-ramayana-5-sarga-66-shlok-2",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "तं तु दृष्ट्वा मणिश्रेष्ठं राघवः शोककर्शितः।",
          "नेत्राभ्यामश्रुपूर्णाभ्यां सुग्रीवमिदमब्रवीत्॥२॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-66",
    "chapterName": "सुन्दरकाण्ड, सर्ग 66",
    "verseNumber": 2
  },
  {
