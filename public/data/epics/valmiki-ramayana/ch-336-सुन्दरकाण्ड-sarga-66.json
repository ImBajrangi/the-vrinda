    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "यथैव धेनुः स्रवति स्नेहाद् वत्सस्य वत्सला।",
          "तथा ममापि हृदयं मणिश्रेष्ठस्य दर्शनात्॥३॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-66",
    "chapterName": "सुन्दरकाण्ड, सर्ग 66",
    "verseNumber": 3
  },
  {
