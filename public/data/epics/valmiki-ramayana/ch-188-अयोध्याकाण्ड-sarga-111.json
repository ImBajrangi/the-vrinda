    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "वसिष्ठः स तदा राममुक्त्वा राजपुरोहितः।",
          "अब्रवीद् धर्मसंयुक्तं पुनरेवापरं वचः॥१॥"
        ]
      }
    ],
    "chapterId": "अयोध्याकाण्ड-sarga-111",
    "chapterName": "अयोध्याकाण्ड, सर्ग 111",
    "verseNumber": 1
  },
  {
