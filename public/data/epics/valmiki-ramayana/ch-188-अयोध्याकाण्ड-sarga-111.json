    "slug": "valmiki-ramayana-2-sarga-111-shlok-2",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "पुरुषस्येह जातस्य भवन्ति गुरवः सदा।",
          "आचार्यश्चैव काकुत्स्थ पिता माता च राघव॥ २॥"
        ]
      }
    ],
    "chapterId": "अयोध्याकाण्ड-sarga-111",
    "chapterName": "अयोध्याकाण्ड, सर्ग 111",
    "verseNumber": 2
  },
  {
