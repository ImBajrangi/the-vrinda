    "titleDevanagari": "वाल्मीकि रामायण, अरण्यकाण्ड, सर्ग 56, श्लोक 1",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-56-shlok-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "सा तथोक्ता तु वैदेही निर्भया शोककर्शिता।",
          "तृणमन्तरतः कृत्वा रावणं प्रत्यभाषत॥१॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-56",
    "chapterName": "अरण्यकाण्ड, सर्ग 56",
    "verseNumber": 1
  },
  {
    "id": "valmiki-ramayana-3-sarga-56-shlok-3",
    "collectionId": "valmiki-ramayana",
    "index": 8288,
    "titleDevanagari": "वाल्मीकि रामायण, अरण्यकाण्ड, सर्ग 56, श्लोक 3",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-56-shlok-3",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "राजा दशरथो नाम धर्मसेतुरिवाचलः।",
          "सत्यसंधः परिज्ञातो यस्य पुत्रः स राघवः॥२॥",
          "रामो नाम स धर्मात्मा त्रिषु लोकेषु विश्रुतः।",
          "दीर्घबाहुर्विशालाक्षो दैवतं स पतिर्मम॥ ३॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-56",
    "chapterName": "अरण्यकाण्ड, सर्ग 56",
    "verseNumber": 3
  },
  {
    "id": "valmiki-ramayana-3-sarga-56-shlok-4",
    "collectionId": "valmiki-ramayana",
    "index": 8289,
    "titleDevanagari": "वाल्मीकि रामायण, अरण्यकाण्ड, सर्ग 56, श्लोक 4",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-56-shlok-4",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "इक्ष्वाकूणां कुले जातः सिंहस्कन्धो महाद्युतिः।",
          "लक्ष्मणेन सह भ्रात्रा यस्ते प्राणान् वधिष्यति॥ ४॥",
          "प्रत्यक्षं यद्यहं तस्य त्वया वै धर्षिता बलात्।",
          "शयिता त्वं हतः संख्ये जनस्थाने यथा खरः॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-56",
    "chapterName": "अरण्यकाण्ड, सर्ग 56",
    "verseNumber": 4
  },
  {
    "id": "valmiki-ramayana-3-sarga-56-shlok-6",
