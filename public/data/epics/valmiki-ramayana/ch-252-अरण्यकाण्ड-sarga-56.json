    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "तस्य ज्याविप्रमुक्तास्ते शराः काञ्चनभूषणाः।",
          "शरीरं विधमिष्यन्ति गङ्गाकूलमिवोर्मयः॥७॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-56",
    "chapterName": "अरण्यकाण्ड, सर्ग 56",
    "verseNumber": 7
  },
  {
