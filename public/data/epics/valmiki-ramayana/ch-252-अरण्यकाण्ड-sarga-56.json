    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "असुरैर्वा सुरैर्वा त्वं यद्यवध्योऽसि रावण।",
          "उत्पाद्य सुमहद् वैरं जीवंस्तस्य न मोक्ष्यसे॥८॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-56",
    "chapterName": "अरण्यकाण्ड, सर्ग 56",
    "verseNumber": 8
  },
  {
