    "index": 8290,
    "titleDevanagari": "वाल्मीकि रामायण, अरण्यकाण्ड, सर्ग 56, श्लोक 6",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-56-shlok-6",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "य एते राक्षसाः प्रोक्ता घोररूपा महाबलाः।",
          "राघवे निर्विषाः सर्वे सुपर्णे पन्नगा यथा॥६॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-56",
    "chapterName": "अरण्यकाण्ड, सर्ग 56",
    "verseNumber": 6
  },
  {
