    "slug": "valmiki-ramayana-1-sarga-39-shlok-4",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "एवं त्वयि न तच्चित्रं भवेद् यत् सौम्य शोभनम्।",
          "जानाम्यहं त्वां सुग्रीव सततं प्रियवादिनम्॥४॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-39",
    "chapterName": "बालकाण्ड, सर्ग 39",
    "verseNumber": 4
  },
  {
