    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-39-shlok-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "विश्वामित्रवचः श्रुत्वा कथान्ते रघुनन्दनः।",
          "उवाच परमप्रीतो मुनिं दीप्तमिवानलम्॥१॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-39",
    "chapterName": "बालकाण्ड, सर्ग 39",
    "verseNumber": 1
  },
  {
    "id": "valmiki-ramayana-1-sarga-39-shlok-2",
    "collectionId": "valmiki-ramayana",
    "index": 1844,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 39, श्लोक 2",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-39-shlok-2",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "यदिन्द्रो वर्षते वर्षं न तच्चित्रं भविष्यति।",
          "आदित्योऽसौ सहस्रांशुः कुर्याद् वितिमिरं नभः॥२॥",
          "चन्द्रमा रजनी कुर्यात् प्रभया सौम्य निर्मलाम्।",
          "त्वद्विधो वापि मित्राणां प्रीतिं कुर्यात् परंतप॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-39",
    "chapterName": "बालकाण्ड, सर्ग 39",
    "verseNumber": 2
  },
  {
    "id": "valmiki-ramayana-1-sarga-39-shlok-3",
    "collectionId": "valmiki-ramayana",
