    "slug": "valmiki-ramayana-1-sarga-39-shlok-8",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "एतस्मिन्नन्तरे चैव रजः समभिवर्तत।",
          "उष्णतीव्रां सहस्रांशोश्छादयद् गगने प्रभाम्॥८॥",
          "दिशः पर्याकुलाश्चासंस्तमसा तेन दूषिताः।",
          "चचाल च मही सर्वा सशैलवनकानना॥८॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-39",
    "chapterName": "बालकाण्ड, सर्ग 39",
    "verseNumber": 8
  },
  {
    "id": "valmiki-ramayana-1-sarga-39-shlok-9",
    "collectionId": "valmiki-ramayana",
    "index": 1851,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 39, श्लोक 9",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-39-shlok-9",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "ह्रियमाणे तु काकुत्स्थ तस्मिन्नश्वे महात्मनः॥ ८॥",
          "उपाध्यायगणाः सर्वे यजमानमथाब्रुवन्।",
          "अयं पर्वणि वेगेन यज्ञियाश्वोऽपनीयते॥९॥",
          "हर्तारं जहि काकुत्स्थ हयश्चैवोपनीयताम्।",
          "यज्ञच्छिद्रं भवत्येतत् सर्वेषामशिवाय नः॥१०॥",
          "तत् तथा क्रियतां राजन् यज्ञोऽच्छिद्रः कृतो भवेत्"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-39",
    "chapterName": "बालकाण्ड, सर्ग 39",
    "verseNumber": 9
  },
  {
