    "slug": "valmiki-ramayana-1-sarga-39-shlok-6",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "जहारात्मविनाशाय मैथिली राक्षसाधमः।",
          "वञ्चयित्वा तु पौलोमीमनुलादो यथा शचीम्॥६॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-39",
    "chapterName": "बालकाण्ड, सर्ग 39",
    "verseNumber": 6
  },
  {
