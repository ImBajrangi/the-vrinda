    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "ततो नगेन्द्रसंकाशैस्तीक्ष्णदंष्टैर्महाबलैः।",
          "कृत्स्ना संछादिता भूमिरसंख्येयैः प्लवंगमैः॥१०॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-39",
    "chapterName": "बालकाण्ड, सर्ग 39",
    "verseNumber": 10
