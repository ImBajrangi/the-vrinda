    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "नचिरात् तं वधिष्यामि रावणं निशितैः शरैः।",
          "पौलोम्याः पितरं दृप्तं शतक्रतुरिवारिहा॥७॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-39",
    "chapterName": "बालकाण्ड, सर्ग 39",
    "verseNumber": 7
  },
  {
