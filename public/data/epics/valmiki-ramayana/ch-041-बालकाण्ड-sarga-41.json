        "stanzaNumber": 1,
        "linesDevanagari": [
          "ततः प्रस्थाप्य सुग्रीवस्तन्महद्वानरं बलम्।",
          "दक्षिणां प्रेषयामास वानरानभिलक्षितान्॥१॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-41",
    "chapterName": "बालकाण्ड, सर्ग 41",
    "verseNumber": 1
  },
