      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "अभिवाद्याभिवाद्यांस्त्वं हत्वा विघ्नकरानपि।",
          "सिद्धार्थः संनिवर्तस्व मम यज्ञस्य पारगः ॥ ४॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-41",
    "chapterName": "बालकाण्ड, सर्ग 41",
    "verseNumber": 4
  },
  {
    "id": "valmiki-ramayana-1-sarga-41-shlok-5",
    "collectionId": "valmiki-ramayana",
    "index": 1956,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 41, श्लोक 5",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-41-shlok-5",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "नीलमग्निसुतं चैव हनूमन्तं च वानरम्।",
          "पितामहसुतं चैव जाम्बवन्तं महौजसम्॥२॥",
          "सुहोत्रं च शरारिं च शरगुल्मं तथैव च।",
          "गजं गवाक्षं गवयं सुषेणं वृषभं तथा॥३॥",
          "मैन्दं च द्विविदं चैव सुषेणं गन्धमादनम्।",
          "उल्कामुखमनङ्गं च हुताशनसुतावुभौ॥४॥",
          "अङ्गदप्रमुखान् वीरान् वीरः कपिगणेश्वरः।",
          "वेगविक्रमसम्पन्नान् संदिदेश विशेषवित्॥५॥",
          "तेषामग्रेसरं चैव बृहबलमथाङ्गदम्।",
          "विधाय हरिवीराणामादिशद दक्षिणां दिशम्॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-41",
    "chapterName": "बालकाण्ड, सर्ग 41",
    "verseNumber": 5
  },
