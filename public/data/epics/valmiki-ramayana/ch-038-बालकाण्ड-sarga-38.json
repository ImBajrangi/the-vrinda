[
  {
    "id": "valmiki-ramayana-1-sarga-38-shlok-1",
    "collectionId": "valmiki-ramayana",
    "index": 1809,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 38, श्लोक 1",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-38-shlok-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "प्रतिगृह्य च तत् सर्वमुपायनमुपाहृतम्।",
          "वानरान् सान्त्वयित्वा च सर्वानेव व्यसर्जयत्॥ १॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-38",
    "chapterName": "बालकाण्ड, सर्ग 38",
    "verseNumber": 1
  },
  {
    "id": "valmiki-ramayana-1-sarga-38-shlok-2-1",
    "collectionId": "valmiki-ramayana",
    "index": 1810,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 38, श्लोक 2",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-38-shlok-2-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "विसर्जयित्वा स हरीन् सहस्रान् कृतकर्मणः।",
          "मेने कृतार्थमात्मानं राघवं च महाबलम्॥२॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-38",
    "chapterName": "बालकाण्ड, सर्ग 38",
    "verseNumber": 2
  },
  {
    "id": "valmiki-ramayana-1-sarga-38-shlok-3",
    "collectionId": "valmiki-ramayana",
    "index": 1811,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 38, श्लोक 3",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-38-shlok-3",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "स लक्ष्मणो भीमबलं सर्ववानरसत्तमम्।",
          "अब्रवीत् प्रश्रितं वाक्यं सुग्रीवं सम्प्रहर्षयन्॥३॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-38",
    "chapterName": "बालकाण्ड, सर्ग 38",
    "verseNumber": 3
  },
  {
    "id": "valmiki-ramayana-1-sarga-38-shlok-4-1",
    "collectionId": "valmiki-ramayana",
    "index": 1812,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 38, श्लोक 4",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-38-shlok-4-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "किष्किन्धाया विनिष्क्राम यदि ते सौम्य रोचते।",
          "तस्य तद् वचनं श्रुत्वा लक्ष्मणस्य सुभाषितम्॥४॥",
          "सुग्रीवः परमप्रीतो वाक्यमेतदुवाच ह।"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-38",
    "chapterName": "बालकाण्ड, सर्ग 38",
    "verseNumber": 4
  },
  {
    "id": "valmiki-ramayana-1-sarga-38-shlok-5",
    "collectionId": "valmiki-ramayana",
    "index": 1813,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 38, श्लोक 5",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-38-shlok-5",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "ताभ्यां सह महाराजः पत्नीभ्यां तप्तवांस्तपः।",
          "हिमवन्तं समासाद्य भृगुप्रस्रवणे गिरौ॥५॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-38",
    "chapterName": "बालकाण्ड, सर्ग 38",
    "verseNumber": 5
  },
  {
    "id": "valmiki-ramayana-1-sarga-38-shlok-6",
    "collectionId": "valmiki-ramayana",
