    "slug": "valmiki-ramayana-1-sarga-38-shlok-10-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "तामुपस्थापितां दृष्ट्वा शिबिकां वानराधिपः॥१०॥",
          "लक्ष्मणारुह्यतां शीघ्रमिति सौमित्रिमब्रवीत्।"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-38",
    "chapterName": "बालकाण्ड, सर्ग 38",
    "verseNumber": 10
  },
  {
    "id": "valmiki-ramayana-1-sarga-38-shlok-11",
    "collectionId": "valmiki-ramayana",
    "index": 1819,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 38, श्लोक 11",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-38-shlok-11",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "इत्युक्त्वा काञ्चनं यानं सुग्रीवः सूर्यसंनिभम्॥११॥",
          "बहुभिर्हरिभिर्युक्तमारुरोह सलक्ष्मणः।"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-38",
    "chapterName": "बालकाण्ड, सर्ग 38",
    "verseNumber": 11
  },
  {
    "id": "valmiki-ramayana-1-sarga-38-shlok-12",
    "collectionId": "valmiki-ramayana",
    "index": 1820,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 38, श्लोक 12",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-38-shlok-12",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "पाण्डुरेणातपत्रेण ध्रियमाणेन मूर्धनि॥१२॥",
          "शुक्लैश्च वालव्यजनै—यमानैः समन्ततः।",
          "शंखभेरीनिनादैश्च बन्दिभिश्चाभिनन्दितः॥१३॥",
          "निर्ययौ प्राप्य सुग्रीवो राज्यश्रियमनुत्तमाम्।"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-38",
    "chapterName": "बालकाण्ड, सर्ग 38",
    "verseNumber": 12
  },
  {
    "id": "valmiki-ramayana-1-sarga-38-shlok-13",
    "collectionId": "valmiki-ramayana",
    "index": 1821,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 38, श्लोक 13",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-38-shlok-13",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "मुनेस्तु वचनं श्रुत्वा केशिनी रघुनन्दन।",
          "पुत्रं वंशकरं राम जग्राह नृपसंनिधौ॥१३॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-38",
    "chapterName": "बालकाण्ड, सर्ग 38",
    "verseNumber": 13
  },
  {
    "id": "valmiki-ramayana-1-sarga-38-shlok-14",
