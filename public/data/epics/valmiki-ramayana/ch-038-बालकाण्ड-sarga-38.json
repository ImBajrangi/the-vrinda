    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-38-shlok-17",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "सुमतिस्तु नरव्याघ्र गर्भतुम्बं व्यजायत।",
          "षष्टिः पुत्रसहस्राणि तुम्बभेदाद् विनिःसृताः॥ १७॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-38",
    "chapterName": "बालकाण्ड, सर्ग 38",
    "verseNumber": 17
  },
