    "slug": "valmiki-ramayana-1-sarga-38-shlok-14",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "स वानरशतैस्तीक्ष्णैर्बहुभिः शस्त्रपाणिभिः॥१४॥",
          "परिकीर्णो ययौ तत्र यत्र रामो व्यवस्थितः।"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-38",
    "chapterName": "बालकाण्ड, सर्ग 38",
    "verseNumber": 14
  },
  {
    "id": "valmiki-ramayana-1-sarga-38-shlok-15-1",
    "collectionId": "valmiki-ramayana",
    "index": 1823,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 38, श्लोक 15",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-38-shlok-15-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "स तं देशमनुप्राप्य श्रेष्ठं रामनिषेवितम्॥१५॥",
          "अवातरन्महातेजाः शिबिकायाः सलक्ष्मणः।",
          "आसाद्य च ततो रामं कृताञ्जलिपुटोऽभवत्॥",
          "कृताञ्जलौ स्थिते तस्मिन् वानराश्चाभवंस्तथा।",
          "तटाकमिव तं दृष्ट्वा रामः कुड्मलपङ्कजम्॥ १७॥",
          "वानराणां महत् सैन्यं सुग्रीवे प्रीतिमानभूत्।"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-38",
    "chapterName": "बालकाण्ड, सर्ग 38",
    "verseNumber": 15
  },
  {
    "id": "valmiki-ramayana-1-sarga-38-shlok-17",
    "collectionId": "valmiki-ramayana",
