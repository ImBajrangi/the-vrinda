    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-38-shlok-19",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "परिष्वज्य च धर्मात्मा निषीदेति ततोऽब्रवीत्॥१९॥",
          "निषण्णं तं ततो दृष्ट्वा क्षितौ रामोऽब्रवीत् ततः।"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-38",
    "chapterName": "बालकाण्ड, सर्ग 38",
    "verseNumber": 19
  },
  {
    "id": "valmiki-ramayana-1-sarga-38-shlok-20-1",
    "collectionId": "valmiki-ramayana",
    "index": 1827,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 38, श्लोक 20",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-38-shlok-20-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "धर्ममर्थं च कामं च काले यस्तु निषेवते॥२०॥",
          "विभज्य सततं वीर स राजा हरिसत्तम।",
          "हित्वा धर्मं तथार्थं च कामं यस्तु निषेवते॥२१॥",
          "स वृक्षाग्रे यथा सुप्तः पतितः प्रतिबुध्यते।"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-38",
    "chapterName": "बालकाण्ड, सर्ग 38",
    "verseNumber": 20
  },
  {
    "id": "valmiki-ramayana-1-sarga-38-shlok-21",
    "collectionId": "valmiki-ramayana",
    "index": 1828,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 38, श्लोक 21",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-38-shlok-21",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "एवं पापसमाचारः सज्जनप्रतिबाधकः॥२१॥",
          "पौराणामहिते युक्तः पित्रा निर्वासितः पुरात्।"
        ]
      }
