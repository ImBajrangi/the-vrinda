    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 38, श्लोक 6",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-38-shlok-6",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "एवं भवतु गच्छाम स्थेयं त्वच्छासने मया॥५॥",
          "तमेवमुक्त्वा सुग्रीवो लक्ष्मणं शुभलक्षणम्।",
          "विसर्जयामास तदा ताराद्याश्चैव योषितः॥६॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-38",
    "chapterName": "बालकाण्ड, सर्ग 38",
    "verseNumber": 6
  },
  {
    "id": "valmiki-ramayana-1-sarga-38-shlok-7-1",
    "collectionId": "valmiki-ramayana",
    "index": 1815,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 38, श्लोक 7",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-38-shlok-7-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "एहीत्युच्चैर्हरिवरान् सुग्रीवः समुदाहरत्।",
          "तस्य तद् वचनं श्रुत्वा हरयः शीघ्रमाययुः॥७॥",
          "बद्धाञ्जलिपुटाः सर्वे ये स्युः स्त्रीदर्शनक्षमाः।"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-38",
    "chapterName": "बालकाण्ड, सर्ग 38",
    "verseNumber": 7
  },
  {
    "id": "valmiki-ramayana-1-sarga-38-shlok-8-1",
    "collectionId": "valmiki-ramayana",
    "index": 1816,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 38, श्लोक 8",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-38-shlok-8-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "तानुवाच ततः प्राप्तान् राजार्कसदृशप्रभः॥८॥",
          "उपस्थापयत क्षिप्रं शिबिकां मम वानराः।"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-38",
    "chapterName": "बालकाण्ड, सर्ग 38",
    "verseNumber": 8
  },
  {
    "id": "valmiki-ramayana-1-sarga-38-shlok-9-1",
    "collectionId": "valmiki-ramayana",
