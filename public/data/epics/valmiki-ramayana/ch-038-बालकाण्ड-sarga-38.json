    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-38-shlok-9-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "श्रुत्वा तु वचनं तस्य हरयः शीघ्रविक्रमाः॥९॥",
          "समुपस्थापयामासुः शिबिकां प्रियदर्शनाम्।"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-38",
    "chapterName": "बालकाण्ड, सर्ग 38",
    "verseNumber": 9
  },
  {
    "id": "valmiki-ramayana-1-sarga-38-shlok-10-1",
    "collectionId": "valmiki-ramayana",
