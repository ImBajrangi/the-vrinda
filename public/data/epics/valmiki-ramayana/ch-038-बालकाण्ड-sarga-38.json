    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-38-shlok-18-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "पादयोः पतितं मूर्ना तमुत्थाप्य हरीश्वरम्॥१८॥",
          "प्रेम्णा च बहुमानाच्च राघवः परिषस्वजे।"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-38",
    "chapterName": "बालकाण्ड, सर्ग 38",
    "verseNumber": 18
  },
  {
