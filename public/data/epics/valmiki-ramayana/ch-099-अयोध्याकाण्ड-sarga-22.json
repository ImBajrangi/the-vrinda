    "titleDevanagari": "वाल्मीकि रामायण, अयोध्याकाण्ड, सर्ग 22, श्लोक 2",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-2-sarga-22-shlok-2",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "अथ तं व्यथया दीनं सविशेषममर्षितम्।",
          "सरोषमिव नागेन्द्रं रोषविस्फारितेक्षणम्॥१॥",
          "आसाद्य रामः सौमित्रिं सुहृदं भ्रातरं प्रियम्।",
          "उवाचेदं स धैर्येण धारयन् सत्त्वमात्मवान्॥२॥"
        ]
      }
    ],
    "chapterId": "अयोध्याकाण्ड-sarga-22",
    "chapterName": "अयोध्याकाण्ड, सर्ग 22",
    "verseNumber": 2
  },
  {
    "id": "valmiki-ramayana-2-sarga-22-shlok-4",
    "collectionId": "valmiki-ramayana",
    "index": 3804,
    "titleDevanagari": "वाल्मीकि रामायण, अयोध्याकाण्ड, सर्ग 22, श्लोक 4",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-2-sarga-22-shlok-4",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "निगृह्य रोषं शोकं च धैर्यमाश्रित्य केवलम्।",
          "अवमानं निरस्यैनं गृहीत्वा हर्षमुत्तमम्॥३॥",
          "उपक्लुप्तं यदैतन्मे अभिषेकार्थमुत्तमम्।",
          "सर्वं निवर्तय क्षिप्रं कुरु कार्यं निरव्ययम्॥४॥"
        ]
      }
    ],
    "chapterId": "अयोध्याकाण्ड-sarga-22",
    "chapterName": "अयोध्याकाण्ड, सर्ग 22",
    "verseNumber": 4
  },
  {
