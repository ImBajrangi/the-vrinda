    "slug": "valmiki-ramayana-2-sarga-22-shlok-6",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "यस्या मदभिषेकार्थे मानसं परितप्यते।",
          "माता नः सा यथा न स्यात् सविशङ्का तथा कुरु॥ ६ ॥"
        ]
      }
    ],
    "chapterId": "अयोध्याकाण्ड-sarga-22",
    "chapterName": "अयोध्याकाण्ड, सर्ग 22",
    "verseNumber": 6
  },
