    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-2-sarga-22-shlok-5",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "सौमित्रे योऽभिषेकार्थे मम सम्भारसम्भ्रमः।",
          "अभिषेकनिवृत्त्यर्थे सोऽस्तु सम्भारसम्भ्रमः॥५॥"
        ]
      }
    ],
    "chapterId": "अयोध्याकाण्ड-sarga-22",
    "chapterName": "अयोध्याकाण्ड, सर्ग 22",
    "verseNumber": 5
  },
