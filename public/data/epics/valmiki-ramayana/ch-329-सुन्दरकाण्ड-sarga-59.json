    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-5-sarga-59-shlok-18",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "मयैव निहता लङ्का दग्धा भस्मीकृता पुरी।",
          "राजमार्गेषु सर्वेषु नाम विश्रावितं मया॥१८॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-59",
    "chapterName": "सुन्दरकाण्ड, सर्ग 59",
    "verseNumber": 18
  },
  {
