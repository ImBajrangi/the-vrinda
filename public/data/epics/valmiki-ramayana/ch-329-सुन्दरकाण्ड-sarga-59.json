[
  {
    "id": "valmiki-ramayana-5-sarga-59-shlok-1",
    "collectionId": "valmiki-ramayana",
    "index": 11002,
    "titleDevanagari": "वाल्मीकि रामायण, सुन्दरकाण्ड, सर्ग 59, श्लोक 1",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-5-sarga-59-shlok-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "एतदाख्याय तत् सर्वं हनूमान् मारुतात्मजः।",
          "भूयः समुपचक्राम वचनं वक्तुमुत्तरम्॥१॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-59",
    "chapterName": "सुन्दरकाण्ड, सर्ग 59",
    "verseNumber": 1
  },
  {
    "id": "valmiki-ramayana-5-sarga-59-shlok-2",
    "collectionId": "valmiki-ramayana",
    "index": 11003,
    "titleDevanagari": "वाल्मीकि रामायण, सुन्दरकाण्ड, सर्ग 59, श्लोक 2",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-5-sarga-59-shlok-2",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "सफलो राघवोद्योगः सुग्रीवस्य च सम्भ्रमः।",
          "शीलमासाद्य सीताया मम च प्रीणितं मनः॥२॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-59",
    "chapterName": "सुन्दरकाण्ड, सर्ग 59",
    "verseNumber": 2
  },
  {
    "id": "valmiki-ramayana-5-sarga-59-shlok-3",
    "collectionId": "valmiki-ramayana",
    "index": 11004,
    "titleDevanagari": "वाल्मीकि रामायण, सुन्दरकाण्ड, सर्ग 59, श्लोक 3",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-5-sarga-59-shlok-3",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "आर्यायाः सदृशं शीलं सीतायाः प्लवगर्षभाः।",
          "तपसा धारयेल्लोकान् क्रुद्धा वा निर्दहेदपि॥३॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-59",
    "chapterName": "सुन्दरकाण्ड, सर्ग 59",
    "verseNumber": 3
  },
  {
    "id": "valmiki-ramayana-5-sarga-59-shlok-4",
    "collectionId": "valmiki-ramayana",
    "index": 11005,
    "titleDevanagari": "वाल्मीकि रामायण, सुन्दरकाण्ड, सर्ग 59, श्लोक 4",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-5-sarga-59-shlok-4",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "सर्वथातिप्रकृष्टोऽसौ रावणो राक्षसेश्वरः।",
          "यस्य तां स्पृशतो गात्रं तपसा न विनाशितम्॥४॥",
          "न तदग्निशिखा कुर्यात् संस्पृष्टा पाणिना सती।",
          "जनकस्य सुता कुर्याद् यत् क्रोधकलुषीकृता॥",
          "जाम्बवत्प्रमुखान् सर्वाननुज्ञाप्य महाकपीन्।",
          "अस्मिन् नेवंगते कार्ये भवतां च निवेदिते।",
          "न्याय्यं स्म सह वैदेह्या द्रष्टं तौ पार्थिवात्मजौ॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-59",
    "chapterName": "सुन्दरकाण्ड, सर्ग 59",
    "verseNumber": 4
  },
  {
    "id": "valmiki-ramayana-5-sarga-59-shlok-8",
    "collectionId": "valmiki-ramayana",
    "index": 11006,
    "titleDevanagari": "वाल्मीकि रामायण, सुन्दरकाण्ड, सर्ग 59, श्लोक 8",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-5-sarga-59-shlok-8",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "अहमेकोऽपि पर्याप्तः सराक्षसगणां पुरीम्।",
          "तां लङ्कां तरसा हन्तुं रावणं च महाबलम्॥७॥",
          "किं पुनः सहितो वीरैर्बलवद्भिः कृतात्मभिः।",
          "कृतास्त्रैः प्लवगैः शक्तैर्भवद्भिर्विजयैषिभिः॥८॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-59",
    "chapterName": "सुन्दरकाण्ड, सर्ग 59",
    "verseNumber": 8
  },
  {
    "id": "valmiki-ramayana-5-sarga-59-shlok-9",
    "collectionId": "valmiki-ramayana",
    "index": 11007,
    "titleDevanagari": "वाल्मीकि रामायण, सुन्दरकाण्ड, सर्ग 59, श्लोक 9",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-5-sarga-59-shlok-9",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "अहं तु रावणं युद्धे ससैन्यं सपुरःसरम्।",
          "सहपुत्रं वधिष्यामि सहोदरयुतं युधि॥९॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-59",
    "chapterName": "सुन्दरकाण्ड, सर्ग 59",
    "verseNumber": 9
  },
  {
    "id": "valmiki-ramayana-5-sarga-59-shlok-10",
    "collectionId": "valmiki-ramayana",
    "index": 11008,
    "titleDevanagari": "वाल्मीकि रामायण, सुन्दरकाण्ड, सर्ग 59, श्लोक 10",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-5-sarga-59-shlok-10",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "ब्राह्ममस्त्रं च रौद्रं च वायव्यं वारुणं तथा।",
          "यदि शक्रजितोऽस्त्राणि दुर्निरीक्ष्याणि संयुगे।",
          "तान्यहं निहनिष्यामि विधमिष्यामि राक्षसान्॥१०॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-59",
    "chapterName": "सुन्दरकाण्ड, सर्ग 59",
    "verseNumber": 10
  },
  {
    "id": "valmiki-ramayana-5-sarga-59-shlok-11",
    "collectionId": "valmiki-ramayana",
    "index": 11009,
    "titleDevanagari": "वाल्मीकि रामायण, सुन्दरकाण्ड, सर्ग 59, श्लोक 11",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-5-sarga-59-shlok-11",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "भवतामभ्यनुज्ञातो विक्रमो मे रुणद्धि तम्।",
          "मयातुला विसृष्टा हि शैलवृष्टिर्निरन्तरा॥११॥",
          "देवानपि रणे हन्यात् किं पुनस्तान् निशाचरान्।"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-59",
    "chapterName": "सुन्दरकाण्ड, सर्ग 59",
    "verseNumber": 11
  },
  {
    "id": "valmiki-ramayana-5-sarga-59-shlok-13",
    "collectionId": "valmiki-ramayana",
    "index": 11010,
    "titleDevanagari": "वाल्मीकि रामायण, सुन्दरकाण्ड, सर्ग 59, श्लोक 13",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-5-sarga-59-shlok-13",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "भवतामननुज्ञातो विक्रमो मे रुणद्धि माम्॥१२॥",
          "सागरोऽप्यतियाद् वेलां मन्दरः प्रचलेदपि।",
          "न जाम्बवन्तं समरे कम्पयेदरिवाहिनी॥१३॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-59",
    "chapterName": "सुन्दरकाण्ड, सर्ग 59",
    "verseNumber": 13
  },
  {
    "id": "valmiki-ramayana-5-sarga-59-shlok-14",
    "collectionId": "valmiki-ramayana",
    "index": 11011,
    "titleDevanagari": "वाल्मीकि रामायण, सुन्दरकाण्ड, सर्ग 59, श्लोक 14",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-5-sarga-59-shlok-14",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "सर्वराक्षससङ्घानां राक्षसा ये च पूर्वजाः।",
          "अलमेकोऽपि नाशाय वीरो वालिसुतः कपिः॥१४॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-59",
    "chapterName": "सुन्दरकाण्ड, सर्ग 59",
    "verseNumber": 14
  },
  {
