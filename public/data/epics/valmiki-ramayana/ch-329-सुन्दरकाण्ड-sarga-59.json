    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-5-sarga-59-shlok-20",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "जयत्यतिबलो रामो लक्ष्मणश्च महाबलः।",
          "राजा जयति सुग्रीवो राघवेणाभिपालितः॥१९॥",
          "अहं कोसलराजस्य दासः पवनसम्भवः।।",
          "हनुमानिति सर्वत्र नाम विश्रावितं मया॥२०॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-59",
    "chapterName": "सुन्दरकाण्ड, सर्ग 59",
    "verseNumber": 20
  },
  {
    "id": "valmiki-ramayana-5-sarga-59-shlok-21",
