    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "राक्षसीभिः परिवृता शोकसंतापकर्शिता।",
          "मेघरेखापरिवृता चन्द्ररेखेव निष्प्रभा॥२२॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-59",
    "chapterName": "सुन्दरकाण्ड, सर्ग 59",
    "verseNumber": 22
  },
  {
