    "slug": "valmiki-ramayana-5-sarga-59-shlok-23",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "अचिन्तयन्ती वैदेही रावणं बलदर्पितम्।",
          "पतिव्रता च सुश्रोणी अवष्टब्धा च जानकी॥२३॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-59",
