    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-5-sarga-59-shlok-17",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "अश्विपुत्रौ महावेगावेतौ प्लवगसत्तमौ।",
          "एतयोः प्रतियोद्धारं न पश्यामि रणाजिरे॥१७॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-59",
    "chapterName": "सुन्दरकाण्ड, सर्ग 59",
    "verseNumber": 17
