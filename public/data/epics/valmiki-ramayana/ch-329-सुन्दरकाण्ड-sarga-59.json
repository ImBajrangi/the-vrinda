    "slug": "valmiki-ramayana-5-sarga-59-shlok-24",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "अनुरक्ता हि वैदेही रामे सर्वात्मना शुभा।",
          "अनन्यचित्ता रामेण पौलोमीव पुरन्दरे॥२४॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-59",
