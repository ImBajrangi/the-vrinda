    "slug": "valmiki-ramayana-5-sarga-59-shlok-15",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "प्लवगस्योरुवेगेन नीलस्य च महात्मनः।",
          "मन्दरोऽप्यवशीर्येत किं पुनर्युधि राक्षसाः॥१५॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-59",
    "chapterName": "सुन्दरकाण्ड, सर्ग 59",
    "verseNumber": 15
  },
