    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-5-sarga-59-shlok-16",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "सदेवासुरयक्षेषु गन्धर्वोरगपक्षिषु।",
          "मैन्दस्य प्रतियोद्धारं शंसत द्विविदस्य वा॥१६॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-59",
    "chapterName": "सुन्दरकाण्ड, सर्ग 59",
    "verseNumber": 16
  },
  {
