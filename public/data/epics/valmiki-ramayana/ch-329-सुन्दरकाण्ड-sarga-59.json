    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-5-sarga-59-shlok-21",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "अशोकवनिकामध्ये रावणस्य दुरात्मनः।",
          "अधस्ताच्छिंशपामूले साध्वी करुणमास्थिता॥२१॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-59",
    "chapterName": "सुन्दरकाण्ड, सर्ग 59",
    "verseNumber": 21
  },
  {
