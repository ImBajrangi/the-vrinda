    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "सुदुष्टस्त्वं वने राममेकमेकोऽनुगच्छसि।",
          "मम हेतोः प्रतिच्छन्नः प्रयुक्तो भरतेन वा॥२४॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-45",
    "chapterName": "अरण्यकाण्ड, सर्ग 45",
    "verseNumber": 24
  },
  {
