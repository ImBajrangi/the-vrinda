    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-45-shlok-22",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "अनार्याकरुणारम्भ नृशंस कुलपांसन॥२१॥",
          "अहं तव प्रियं मन्ये रामस्य व्यसनं महत्।",
          "रामस्य व्यसनं दृष्ट्वा तेनैतानि प्रभाषसे॥२२॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-45",
    "chapterName": "अरण्यकाण्ड, सर्ग 45",
    "verseNumber": 22
  },
  {
