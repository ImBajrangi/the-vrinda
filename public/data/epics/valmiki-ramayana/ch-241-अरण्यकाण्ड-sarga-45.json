    "slug": "valmiki-ramayana-3-sarga-45-shlok-20",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "लक्ष्मणेनैवमुक्ता तु क्रुद्धा संरक्तलोचना॥२०॥",
          "अब्रवीत् परुषं वाक्यं लक्ष्मणं सत्यवादिनम्।"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-45",
    "chapterName": "अरण्यकाण्ड, सर्ग 45",
    "verseNumber": 20
  },
  {
