    "slug": "valmiki-ramayana-3-sarga-45-shlok-18",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "कृतवैराश्च कल्याणि वयमेतैर्निशाचरैः॥१८॥",
          "खरस्य निधने देवि जनस्थानवधं प्रति।।"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-45",
    "chapterName": "अरण्यकाण्ड, सर्ग 45",
    "verseNumber": 18
  },
