    "titleDevanagari": "वाल्मीकि रामायण, अरण्यकाण्ड, सर्ग 45, श्लोक 2",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-45-shlok-2",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "नहि मे जीवितं स्थाने हृदयं वावतिष्ठते।",
          "क्रोशतः परमार्तस्य श्रुतः शब्दो मया भृशम्॥ २॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-45",
    "chapterName": "अरण्यकाण्ड, सर्ग 45",
    "verseNumber": 2
  },
  {
    "id": "valmiki-ramayana-3-sarga-45-shlok-4",
    "collectionId": "valmiki-ramayana",
    "index": 7959,
    "titleDevanagari": "वाल्मीकि रामायण, अरण्यकाण्ड, सर्ग 45, श्लोक 4",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-45-shlok-4",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "आक्रन्दमानं तु वने भ्रातरं त्रातुमर्हसि।",
          "तंक्षिप्रमभिधाव त्वं भ्रातरं शरणैषिणम्॥३॥",
          "रक्षसां वशमापन्नं सिंहानामिव गोवृषम्।",
          "न जगाम तथोक्तस्तु भ्रातुराज्ञाय शासनम्॥४॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-45",
    "chapterName": "अरण्यकाण्ड, सर्ग 45",
    "verseNumber": 4
  },
  {
    "id": "valmiki-ramayana-3-sarga-45-shlok-6",
    "collectionId": "valmiki-ramayana",
    "index": 7960,
    "titleDevanagari": "वाल्मीकि रामायण, अरण्यकाण्ड, सर्ग 45, श्लोक 6",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-45-shlok-6",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "तमुवाच ततस्तत्र क्षुभिता जनकात्मजा।",
          "सौमित्रे मित्ररूपेण भ्रातुस्त्वमसि शत्रुवत्॥५॥",
          "यस्त्वमस्यामवस्थायां भ्रातरं नाभिपद्यसे।",
          "इच्छसि त्वं विनश्यन्तं रामं लक्ष्मण मत्कृते॥६॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-45",
    "chapterName": "अरण्यकाण्ड, सर्ग 45",
    "verseNumber": 6
  },
  {
    "id": "valmiki-ramayana-3-sarga-45-shlok-7",
    "collectionId": "valmiki-ramayana",
    "index": 7961,
    "titleDevanagari": "वाल्मीकि रामायण, अरण्यकाण्ड, सर्ग 45, श्लोक 7",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-45-shlok-7",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "लोभात्तु मत्कृते नूनं नानुगच्छसि राघवम्।",
          "व्यसनं ते प्रियं मन्ये स्नेहो भ्रातरि नास्ति ते॥७॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-45",
    "chapterName": "अरण्यकाण्ड, सर्ग 45",
    "verseNumber": 7
  },
  {
    "id": "valmiki-ramayana-3-sarga-45-shlok-8",
    "collectionId": "valmiki-ramayana",
    "index": 7962,
    "titleDevanagari": "वाल्मीकि रामायण, अरण्यकाण्ड, सर्ग 45, श्लोक 8",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-45-shlok-8",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "तेन तिष्ठसि विस्रब्धं तमपश्यन् महाद्युतिम्।",
          "किं हि संशयमापन्ने तस्मिन्निह मया भवेत्॥८॥",
          "कर्तव्यमिह तिष्ठन्त्या यत्प्रधानस्त्वमागतः।"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-45",
    "chapterName": "अरण्यकाण्ड, सर्ग 45",
    "verseNumber": 8
  },
  {
    "id": "valmiki-ramayana-3-sarga-45-shlok-9",
    "collectionId": "valmiki-ramayana",
    "index": 7963,
    "titleDevanagari": "वाल्मीकि रामायण, अरण्यकाण्ड, सर्ग 45, श्लोक 9",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-45-shlok-9",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "एवं ब्रुवाणां वैदेहीं बाष्पशोकसमन्विताम्॥९॥",
          "अब्रवील्लक्ष्मणस्त्रस्तां सीतां मृगवधूमिव।"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-45",
    "chapterName": "अरण्यकाण्ड, सर्ग 45",
    "verseNumber": 9
  },
  {
    "id": "valmiki-ramayana-3-sarga-45-shlok-10",
    "collectionId": "valmiki-ramayana",
    "index": 7964,
    "titleDevanagari": "वाल्मीकि रामायण, अरण्यकाण्ड, सर्ग 45, श्लोक 10",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-45-shlok-10",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "पन्नगासुरगन्धर्वदेवदानवराक्षसैः॥१०॥",
          "अशक्यस्तव वैदेहि भर्ता जेतुं न संशयः।"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-45",
    "chapterName": "अरण्यकाण्ड, सर्ग 45",
    "verseNumber": 10
  },
  {
    "id": "valmiki-ramayana-3-sarga-45-shlok-13",
    "collectionId": "valmiki-ramayana",
    "index": 7965,
    "titleDevanagari": "वाल्मीकि रामायण, अरण्यकाण्ड, सर्ग 45, श्लोक 13",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-45-shlok-13",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "देवि देवमनुष्येषु गन्धर्वेषु पतत्रिषु॥११॥",
          "राक्षसेषु पिशाचेषु किन्नरेषु मृगेषु च।",
          "दानवेषु च घोरेषु न स विद्येत शोभने॥१२॥",
          "यो रामं प्रतियुध्येत समरे वासवोपमम्।",
          "अवध्यः समरे रामो नैवं त्वं वक्तमर्हसि॥१३॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-45",
    "chapterName": "अरण्यकाण्ड, सर्ग 45",
    "verseNumber": 13
  },
  {
    "id": "valmiki-ramayana-3-sarga-45-shlok-15",
    "collectionId": "valmiki-ramayana",
    "index": 7966,
    "titleDevanagari": "वाल्मीकि रामायण, अरण्यकाण्ड, सर्ग 45, श्लोक 15",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-45-shlok-15",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "न त्वामस्मिन् वने हातुमुत्सहे राघवं विना।",
          "अनिवार्यं बलं तस्य बलैर्बलवतामपि॥१४॥",
          "त्रिभिर्लोकैः समुदितैः सेश्वरैः सामरैरपि।",
          "हृदयं निर्वृतं तेऽस्तु संतापस्त्यज्यतां तव॥१५॥",
          "आगमिष्यति ते भर्ता शीघ्रं हत्वा मृगोत्तमम्।",
          "न स तस्य स्वरो व्यक्तं न कश्चिदपि दैवतः॥ १६॥",
          "गन्धर्वनगरप्रख्या माया तस्य च रक्षसः।",
          "न्यासभूतासि वैदेहि न्यस्ता मयि महात्मना॥ १७॥",
          "रामेण त्वं वरारोहे न त्वां त्यक्तुमिहोत्सहे।"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-45",
    "chapterName": "अरण्यकाण्ड, सर्ग 45",
    "verseNumber": 15
  },
  {
