    "slug": "valmiki-ramayana-3-sarga-45-shlok-23",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "नैव चित्रं सपनेषु पापं लक्ष्मण यद् भवेत्।",
          "त्वद्विधेषु नृशंसेषु नित्यं प्रच्छन्नचारिषु॥२३॥"
        ]
      }
    ],
