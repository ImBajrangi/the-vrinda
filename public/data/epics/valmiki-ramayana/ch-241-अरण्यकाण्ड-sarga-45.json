    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-45-shlok-19",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "राक्षसा विविधा वाचो व्याहरन्ति महावने॥१९॥",
          "हिंसाविहारा वैदेहि न चिन्तयितुमर्हसि।"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-45",
    "chapterName": "अरण्यकाण्ड, सर्ग 45",
    "verseNumber": 19
  },
  {
