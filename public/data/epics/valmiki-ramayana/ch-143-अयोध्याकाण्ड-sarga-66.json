    "slug": "valmiki-ramayana-2-sarga-66-shlok-3",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "सकामा भव कैकेयी भुक्ष्व राज्यमकण्टकम्।",
          "त्यक्त्वा राजानमेकाना नृशंसे दुष्टचारिणि॥३॥"
        ]
      }
    ],
    "chapterId": "अयोध्याकाण्ड-sarga-66",
    "chapterName": "अयोध्याकाण्ड, सर्ग 66",
    "verseNumber": 3
  },
