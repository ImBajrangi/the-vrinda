    "slug": "valmiki-ramayana-2-sarga-69-shlok-12",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "औपवाह्यस्य नागस्य विषाणं शकलीकृतम्।",
          "सहसा चापि संशान्ता ज्वलिता जातवेदसः॥ १२॥",
          "अवदीर्णां च पृथिवीं शुष्कांश्च विविधान् द्रुमान्।",
          "अहं पश्यामि विध्वस्तान् सधूमांश्चैव पर्वतान्॥"
        ]
      }
    ],
    "chapterId": "अयोध्याकाण्ड-sarga-69",
    "chapterName": "अयोध्याकाण्ड, सर्ग 69",
    "verseNumber": 12
  },
  {
    "id": "valmiki-ramayana-2-sarga-69-shlok-14",
