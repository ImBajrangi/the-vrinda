    "slug": "valmiki-ramayana-2-sarga-69-shlok-8",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "एवं ब्रुवाणं सुहृदं भरतः प्रत्युवाच ह।",
          "शृणु त्वं यन्निमित्तं मे दैन्यमेतदुपागतम्॥७॥",
          "स्वप्ने पितरमद्राक्षं मलिनं मुक्तमूर्धजम्।",
          "पतन्तमद्रिशिखरात् कलुषे गोमये ह्रदे॥८॥"
        ]
      }
    ],
    "chapterId": "अयोध्याकाण्ड-sarga-69",
    "chapterName": "अयोध्याकाण्ड, सर्ग 69",
    "verseNumber": 8
  },
  {
    "id": "valmiki-ramayana-2-sarga-69-shlok-9",
    "collectionId": "valmiki-ramayana",
    "index": 5333,
    "titleDevanagari": "वाल्मीकि रामायण, अयोध्याकाण्ड, सर्ग 69, श्लोक 9",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-2-sarga-69-shlok-9",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "प्लवमानश्च मे दृष्टः स तस्मिन् गोमये ह्रदे।",
          "पिबन्नञ्जलिना तैलं हसन्निव मुहुर्मुहुः॥९॥"
        ]
      }
    ],
    "chapterId": "अयोध्याकाण्ड-sarga-69",
    "chapterName": "अयोध्याकाण्ड, सर्ग 69",
    "verseNumber": 9
  },
