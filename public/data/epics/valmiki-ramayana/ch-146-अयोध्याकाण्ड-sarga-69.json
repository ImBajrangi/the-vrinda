    "slug": "valmiki-ramayana-2-sarga-69-shlok-6",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "तमब्रवीत् प्रियसखो भरतं सखिभिर्वृतम्।",
          "सुहृद्भिः पर्युपासीनः किं सखे नानुमोदसे॥६॥"
        ]
      }
    ],
    "chapterId": "अयोध्याकाण्ड-sarga-69",
    "chapterName": "अयोध्याकाण्ड, सर्ग 69",
    "verseNumber": 6
  },
  {
    "id": "valmiki-ramayana-2-sarga-69-shlok-8",
