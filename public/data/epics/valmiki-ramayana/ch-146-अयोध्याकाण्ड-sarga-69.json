    "slug": "valmiki-ramayana-2-sarga-69-shlok-4",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "वादयन्ति तदा शान्तिं लासयन्त्यपि चापरे।",
          "नाटकान्यपरे स्माहुर्हास्यानि विविधानि च॥४॥"
        ]
      }
    ],
    "chapterId": "अयोध्याकाण्ड-sarga-69",
    "chapterName": "अयोध्याकाण्ड, सर्ग 69",
    "verseNumber": 4
  },
