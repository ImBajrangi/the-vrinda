    "slug": "valmiki-ramayana-2-sarga-69-shlok-5",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "स तैर्महात्मा भरतः सखिभिः प्रियवादिभिः।",
          "गोष्ठीहास्यानि कुर्वद्भिर्न प्राहृष्यत राघवः॥५॥"
        ]
      }
    ],
    "chapterId": "अयोध्याकाण्ड-sarga-69",
    "chapterName": "अयोध्याकाण्ड, सर्ग 69",
    "verseNumber": 5
  },
  {
