    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-2-sarga-69-shlok-14",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "पीठे कार्णायसे चैव निषष्ण्णं कृष्णवाससम्।",
          "प्रहरन्ति स्म राजानं प्रमदाः कृष्णपिङ्गलाः॥ १४॥"
        ]
      }
    ],
    "chapterId": "अयोध्याकाण्ड-sarga-69",
