    "slug": "valmiki-ramayana-2-sarga-69-shlok-15",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "त्वरमाणश्च धर्मात्मा रक्तमाल्यानुलेपनः।",
          "रथेन खरयुक्तेन प्रयातो दक्षिणामुखः॥१५॥"
        ]
      }
    ],
    "chapterId": "अयोध्याकाण्ड-sarga-69",
