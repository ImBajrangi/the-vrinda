    "titleDevanagari": "वाल्मीकि रामायण, अयोध्याकाण्ड, सर्ग 69, श्लोक 1",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-2-sarga-69-shlok-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "यामेव रात्रिं ते दताः प्रविशन्ति स्म तां पुरीम्।",
          "भरतेनापि तां रात्रिं स्वप्नो दृष्टोऽयमप्रियः॥१॥"
        ]
      }
    ],
    "chapterId": "अयोध्याकाण्ड-sarga-69",
    "chapterName": "अयोध्याकाण्ड, सर्ग 69",
    "verseNumber": 1
  },
  {
    "id": "valmiki-ramayana-2-sarga-69-shlok-2",
    "collectionId": "valmiki-ramayana",
    "index": 5328,
    "titleDevanagari": "वाल्मीकि रामायण, अयोध्याकाण्ड, सर्ग 69, श्लोक 2",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-2-sarga-69-shlok-2",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "व्युष्टामेव तु तां रात्रिं दृष्ट्वा तं स्वप्नमप्रियम्।",
          "पुत्रो राजाधिराजस्य सुभृशं पर्यतप्यत॥२॥",
          "तप्यमानं तमाज्ञाय वयस्याः प्रियवादिनः।",
          "आयासं विनयिष्यन्तः सभायां चक्रिरे कथाः॥"
        ]
      }
    ],
    "chapterId": "अयोध्याकाण्ड-sarga-69",
    "chapterName": "अयोध्याकाण्ड, सर्ग 69",
    "verseNumber": 2
  },
  {
