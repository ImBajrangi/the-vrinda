    "slug": "valmiki-ramayana-1-sarga-23-shlok-7-2",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "ते तु सर्वे सुविक्रान्ता दैतेया बलशालिनः।",
          "नानाप्रहरणास्तत्र प्रहृष्टा युद्धदुर्मदाः॥७॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-23",
    "chapterName": "बालकाण्ड, सर्ग 23",
    "verseNumber": 7
  },
  {
