    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "निवातकवचानां तु निवार्य रणकर्म तत्।",
          "वृद्धः पितामहो वाक्यमुवाच विदितार्थवत्॥११॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-23",
    "chapterName": "बालकाण्ड, सर्ग 23",
    "verseNumber": 11
  },
