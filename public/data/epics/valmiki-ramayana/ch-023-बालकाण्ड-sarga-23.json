    "slug": "valmiki-ramayana-1-sarga-23-shlok-24",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "यां ब्रुवन्ति नरा लोके सुरभिं नाम नामतः।",
          "प्रदक्षिणं तु तां कृत्वा रावणः परमाद्भुताम्।",
          "प्रविवेश महाघोरं गुप्तं बहुविधैर्बलैः॥२४॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-23",
    "chapterName": "बालकाण्ड, सर्ग 23",
    "verseNumber": 24
