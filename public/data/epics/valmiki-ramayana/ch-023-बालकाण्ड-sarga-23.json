    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 23, श्लोक 3",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-23-shlok-3",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "जयेन वर्धयित्वा च मारीचप्रमुखास्ततः।",
          "पुष्पकं भेजिरे सर्वे सान्त्विता रावणेन तु॥३॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-23",
    "chapterName": "बालकाण्ड, सर्ग 23",
    "verseNumber": 3
  },
  {
    "id": "valmiki-ramayana-1-sarga-23-shlok-4-2",
    "collectionId": "valmiki-ramayana",
    "index": 1114,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 23, श्लोक 4",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-23-shlok-4-2",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "ततो रसातलं रक्षः प्रविष्टः पयसां निधिम्।",
          "दैत्योरगगणाध्युष्टं वरुणेन सुरक्षितम्॥४॥",
          "स तु भोगवतीं गत्वा पुरीं वासुकिपालिताम्।",
          "कृत्वा नागान् वशे हृष्टो ययौ मणिमयीं पुरीम्॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-23",
    "chapterName": "बालकाण्ड, सर्ग 23",
    "verseNumber": 4
  },
  {
    "id": "valmiki-ramayana-1-sarga-23-shlok-5-1",
    "collectionId": "valmiki-ramayana",
    "index": 1115,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 23, श्लोक 5",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-23-shlok-5-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "ऋक्षवानरमुख्यास्त्वां बलिनं पर्युपासते।",
          "तेषां विलपितं कृच्छ्रमङ्गदस्य च शोचतः॥५॥",
          "मम चेमा गिरः श्रुत्वा किं त्वं न प्रतिबुध्यसे।"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-23",
    "chapterName": "बालकाण्ड, सर्ग 23",
    "verseNumber": 5
  },
  {
    "id": "valmiki-ramayana-1-sarga-23-shlok-6-2",
    "collectionId": "valmiki-ramayana",
    "index": 1116,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 23, श्लोक 6",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-23-shlok-6-2",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "निवातकवचास्तत्र दैत्या लब्धवरा वसन्।",
          "राक्षसस्तान् समागम्य युद्धाय समुपाह्वयत्॥६॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-23",
    "chapterName": "बालकाण्ड, सर्ग 23",
    "verseNumber": 6
  },
  {
