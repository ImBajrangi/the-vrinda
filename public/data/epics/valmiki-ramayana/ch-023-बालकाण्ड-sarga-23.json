    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 23, श्लोक 1",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-23-shlok-1-2",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "ततो जित्वा दशग्रीवो यमं त्रिदशपुङ्गवम्।",
          "रावणस्तु रणश्लाघी स्वसहायान् ददर्श ह॥१॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-23",
    "chapterName": "बालकाण्ड, सर्ग 23",
    "verseNumber": 1
  },
  {
    "id": "valmiki-ramayana-1-sarga-23-shlok-2",
    "collectionId": "valmiki-ramayana",
    "index": 1112,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 23, श्लोक 2",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-23-shlok-2",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "ततो रुधिरसिक्ताङ्गं प्रहारैर्जर्जरीकृतम्।",
          "रावणं राक्षसा दृष्ट्वा विस्मयं समुपागमन्॥२॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-23",
    "chapterName": "बालकाण्ड, सर्ग 23",
    "verseNumber": 2
  },
  {
