    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "स्वगात्रप्रभवे वीर शेषे रुधिरमण्डले॥१३॥",
          "कृमिरागपरिस्तोमे स्वकीये शयने यथा।"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-23",
    "chapterName": "बालकाण्ड, सर्ग 23",
