    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "तं विजित्य मुहर्तेन जघ्ने दैत्यांश्चतःशतम्॥१९॥",
          "ततः पाण्डुरमेघाभं कैलासमिव भास्वरम्।",
          "वरुणस्यालयं दिव्यमपश्यद् राक्षसाधिपः॥२०॥"
        ]
      }
