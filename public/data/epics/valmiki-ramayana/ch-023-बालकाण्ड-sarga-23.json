    "slug": "valmiki-ramayana-1-sarga-23-shlok-8-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "शूराय न प्रदातव्या कन्या खलु विपश्चिता॥८॥",
          "शूरभार्यां हतां पश्य सद्यो मां विधवां कृताम्।"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-23",
    "chapterName": "बालकाण्ड, सर्ग 23",
    "verseNumber": 8
  },
