    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "नह्ययं रावणो युद्धे शक्यो जेतुं सुरासुरैः।",
          "न भवन्तः क्षयं नेतुमपि सामरदानवैः॥१२॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-23",
    "chapterName": "बालकाण्ड, सर्ग 23",
    "verseNumber": 12
  },
