    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-23-shlok-9-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "अवभग्नश्च मे मानो भग्ना मे शाश्वती गतिः॥९॥",
          "अगाधे च निमग्नास्मि विपुले शोकसागरे।"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-23",
    "chapterName": "बालकाण्ड, सर्ग 23",
    "verseNumber": 9
  },
