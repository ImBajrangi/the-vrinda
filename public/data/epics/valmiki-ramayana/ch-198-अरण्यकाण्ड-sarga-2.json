    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "वसानं चर्म वैयाघ्रं वसाइँ रुधिरोक्षितम्।",
          "त्रासनं सर्वभूतानां व्यादितास्यमिवान्तकम्॥६॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-2",
    "chapterName": "अरण्यकाण्ड, सर्ग 2",
    "verseNumber": 6
  },
  {
