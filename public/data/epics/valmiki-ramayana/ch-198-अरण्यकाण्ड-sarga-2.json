    "slug": "valmiki-ramayana-3-sarga-2-shlok-9",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "स रामं लक्ष्मणं चैव सीतां दृष्ट्वा च मैथिलीम्।",
          "अभ्यधावत् सुसंक्रुद्धः प्रजाः काल इवान्तकः॥ ८॥",
          "स कृत्वा भैरवं नादं चालयन्निव मेदिनीम्॥९॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-2",
    "chapterName": "अरण्यकाण्ड, सर्ग 2",
    "verseNumber": 9
  },
