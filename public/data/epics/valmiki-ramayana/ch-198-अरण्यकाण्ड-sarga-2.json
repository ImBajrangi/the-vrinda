    "slug": "valmiki-ramayana-3-sarga-2-shlok-2",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "॥ श्रीसीतारामचन्द्राभ्यां नमः॥",
          "श्रीमद्वाल्मीकीय रामायण",
          "अरण्यकाण्डम्",
          "द्वितीयः सर्गः (सर्ग 2)",
          "इत्याचे श्रीमद्रामायणे वाल्मीकीये आदिकाव्येऽरण्यकाण्डे द्वितीयः सर्गः ॥२॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-2",
    "chapterName": "अरण्यकाण्ड, सर्ग 2",
    "verseNumber": 2
  },
  {
    "id": "valmiki-ramayana-3-sarga-2-shlok-3",
    "collectionId": "valmiki-ramayana",
