    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "अङ्केनादाय वैदेहीमपक्रम्य तदाब्रवीत्।",
          "युवां जटाचीरधरौ सभार्यो क्षीणजीवितौ॥१०॥",
          "प्रविष्टौ दण्डकारण्यं शरचापासिपाणिनौ।"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-2",
    "chapterName": "अरण्यकाण्ड, सर्ग 2",
    "verseNumber": 10
