    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "गभीराक्षं महावक्त्रं विकटं विकटोदरम्।",
          "बीभत्सं विषमं दीर्घ विकृतं घोरदर्शनम्॥५॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-2",
    "chapterName": "अरण्यकाण्ड, सर्ग 2",
    "verseNumber": 5
  },
