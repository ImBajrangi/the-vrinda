    "slug": "valmiki-ramayana-3-sarga-2-shlok-4",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "सीतया सह काकुत्स्थस्तस्मिन् घोरमृगायुते।",
          "ददर्श गिरिशृङ्गाभं पुरुषादं महास्वनम्॥४॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-2",
    "chapterName": "अरण्यकाण्ड, सर्ग 2",
    "verseNumber": 4
  },
