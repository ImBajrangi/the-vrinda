    "titleDevanagari": "वाल्मीकि रामायण, अरण्यकाण्ड, सर्ग 2, श्लोक 1",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-2-shlok-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "कृतातिथ्योऽथ रामस्तु सूर्यस्योदयनं प्रति।",
          "आमन्त्र्य स मुनीन् सर्वान् वनमेवान्वगाहत॥१॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-2",
    "chapterName": "अरण्यकाण्ड, सर्ग 2",
    "verseNumber": 1
  },
  {
