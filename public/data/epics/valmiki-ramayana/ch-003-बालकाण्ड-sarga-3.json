    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "सिंहविप्रेक्षितौ वीरौ महाबलपराक्रमौ।",
          "शक्रचापनिभे चापे गृहीत्वा शत्रुनाशनौ॥९॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-3",
    "chapterName": "बालकाण्ड, सर्ग 3",
    "verseNumber": 9
  },
  {
    "id": "valmiki-ramayana-1-sarga-3-shlok-10-1",
