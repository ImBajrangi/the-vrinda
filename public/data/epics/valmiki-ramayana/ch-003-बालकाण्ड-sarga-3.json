    "slug": "valmiki-ramayana-1-sarga-3-shlok-10-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "श्रीमन्तौ रूपसम्पन्नौ वृषभश्रेष्ठविक्रमौ।",
          "हस्तिहस्तोपमभुजौ द्युतिमन्तौ नरर्षभौ॥१०॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-3",
    "chapterName": "बालकाण्ड, सर्ग 3",
    "verseNumber": 10
  },
  {
    "id": "valmiki-ramayana-1-sarga-3-shlok-11",
