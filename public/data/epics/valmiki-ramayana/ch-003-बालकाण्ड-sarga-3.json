      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "अथाब्रवीद वैश्रवणः पितामहमुपस्थितम्॥१५॥",
          "भगवॅल्लोकपालत्वमिच्छेयं लोकरक्षणम्।"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-3",
    "chapterName": "बालकाण्ड, सर्ग 3",
