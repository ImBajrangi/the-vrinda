    "slug": "valmiki-ramayana-1-sarga-3-shlok-7-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "दृष्ट्वा श्रेयस्करी बुद्धिं धनाध्यक्षो भविष्यति।",
          "नाम चास्याकरोत् प्रीतः सार्धं देवर्षिभिस्तदा॥७॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-3",
    "chapterName": "बालकाण्ड, सर्ग 3",
    "verseNumber": 7
  },
  {
    "id": "valmiki-ramayana-1-sarga-3-shlok-8-1",
