    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 3, श्लोक 11",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-3-shlok-11",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "स तु वर्षसहस्राणि तपस्तप्त्वा महावने।",
          "यन्त्रितो नियमैरुग्रैश्चकार सुमहत्तपः॥११॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-3",
    "chapterName": "बालकाण्ड, सर्ग 3",
    "verseNumber": 11
  },
  {
    "id": "valmiki-ramayana-1-sarga-3-shlok-12-2",
