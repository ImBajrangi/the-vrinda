    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "परितुष्टोऽस्मि ते वत्स कर्मणानेन सुव्रत॥१४॥",
          "वरं वृणीष्व भद्रं ते वराहस्त्वं महामते।"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-3",
    "chapterName": "बालकाण्ड, सर्ग 3",
