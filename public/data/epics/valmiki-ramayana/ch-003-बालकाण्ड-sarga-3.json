[
  {
    "id": "valmiki-ramayana-1-sarga-3-shlok-1-1",
    "collectionId": "valmiki-ramayana",
    "index": 168,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 3, श्लोक 1",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-3-shlok-1-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "वचो विज्ञाय हनुमान् सुग्रीवस्य महात्मनः।",
          "पर्वतादृष्यमूकात् तु पुप्लुवे यत्र राघवौ॥१॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-3",
    "chapterName": "बालकाण्ड, सर्ग 3",
    "verseNumber": 1
  },
  {
    "id": "valmiki-ramayana-1-sarga-3-shlok-2-1",
    "collectionId": "valmiki-ramayana",
    "index": 169,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 3, श्लोक 2",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-3-shlok-2-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "कपिरूपं परित्यज्य हनुमान् मारुतात्मजः।",
          "भिक्षुरूपं ततो भेजे शठबुद्धितया कपिः॥२॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-3",
    "chapterName": "बालकाण्ड, सर्ग 3",
    "verseNumber": 2
  },
  {
    "id": "valmiki-ramayana-1-sarga-3-shlok-3-2",
    "collectionId": "valmiki-ramayana",
    "index": 170,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 3, श्लोक 3",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-3-shlok-3-2",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "॥ श्रीसीतारामचन्द्राभ्यां नमः॥",
          "श्रीमद्वाल्मीकीय रामायण",
          "उत्तरकाण्डम्",
          "तृतीयः सर्गः (सर्ग 3)",
          "ज्ञात्वा तस्य तु तद् वृत्तं भरद्वाजो महामुनिः।",
          "ददौ विश्रवसे भार्यां स्वसुतां देववर्णिनीम्॥३॥",
          "इत्याचे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये उत्तरकाण्डे तृतीयः सर्गः॥३॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-3",
    "chapterName": "बालकाण्ड, सर्ग 3",
    "verseNumber": 3
  },
  {
    "id": "valmiki-ramayana-1-sarga-3-shlok-4",
    "collectionId": "valmiki-ramayana",
    "index": 171,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 3, श्लोक 4",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-3-shlok-4",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "रामलक्ष्मणसीताभी राज्ञा दशरथेन च।",
          "सभार्येण सराष्ट्रण यत् प्राप्तं तत्र तत्त्वतः॥३॥",
          "हसितं भाषितं चैव गतिर्यावच्च चेष्टितम्।",
          "तत् सर्वं धर्मवीर्येण यथावत् सम्प्रपश्यति॥४॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-3",
    "chapterName": "बालकाण्ड, सर्ग 3",
    "verseNumber": 4
  },
  {
    "id": "valmiki-ramayana-1-sarga-3-shlok-5",
    "collectionId": "valmiki-ramayana",
    "index": 172,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 3, श्लोक 5",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-3-shlok-5",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "ततश्च हनुमान् वाचा श्लक्ष्णया सुमनोज्ञया।",
          "विनीतवदुपागम्य राघवौ प्रणिपत्य च॥३॥",
          "आबभाषे च तौ वीरौ यथावत् प्रशशंस च।",
          "सम्पूज्य विधिवद् वीरौ हनुमान् वानरोत्तमः॥४॥",
          "उवाच कामतो वाक्यं मृदु सत्यपराक्रमौ।",
          "राजर्षिदेवप्रतिमौ तापसौ संशितव्रतौ॥५॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-3",
    "chapterName": "बालकाण्ड, सर्ग 3",
    "verseNumber": 5
  },
  {
    "id": "valmiki-ramayana-1-sarga-3-shlok-6-2",
    "collectionId": "valmiki-ramayana",
    "index": 173,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 3, श्लोक 6",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-3-shlok-6-2",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "प्रतिगृह्य तु धर्मेण भरद्वाजसुतां तदा।",
          "प्रजान्वेषिकया बुद्ध्या श्रेयो ह्यस्य विचिन्तयन्॥४॥",
          "मुदा परमया युक्तो विश्रवा मुनिपुङ्गवः।",
          "स तस्यां वीर्यसम्पन्नमपत्यं परमाद्भुतम्॥५॥",
          "जनयामास धर्मज्ञः सर्वैर्ब्रह्मगुणैर्वृतम्।",
          "तस्मिजाते तु संहृष्टः स बभूव पितामहः॥६॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-3",
    "chapterName": "बालकाण्ड, सर्ग 3",
    "verseNumber": 6
  },
  {
    "id": "valmiki-ramayana-1-sarga-3-shlok-7-1",
    "collectionId": "valmiki-ramayana",
    "index": 174,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 3, श्लोक 7",
