    "slug": "valmiki-ramayana-6-sarga-22-shlok-8",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "तिर्यक् च सह नक्षत्रैः संगतौ चन्द्रभास्करौ।",
          "भास्करांशुभिरादीप्तं तमसा च समावृतम्॥८॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-22",
    "chapterName": "युद्धकाण्ड, सर्ग 22",
    "verseNumber": 8
  },
  {
