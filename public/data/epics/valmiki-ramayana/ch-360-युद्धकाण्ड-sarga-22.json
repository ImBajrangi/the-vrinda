    "slug": "valmiki-ramayana-6-sarga-22-shlok-5",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "ब्राह्मणास्त्रेण संयोज्य ब्रह्मदण्डनिभं शरम्।",
          "संयोज्य धनुषि श्रेष्ठ विचकर्ष महाबलः॥५॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-22",
    "chapterName": "युद्धकाण्ड, सर्ग 22",
    "verseNumber": 5
  },
