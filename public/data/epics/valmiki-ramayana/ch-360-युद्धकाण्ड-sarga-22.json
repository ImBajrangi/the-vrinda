    "slug": "valmiki-ramayana-6-sarga-22-shlok-6",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "तस्मिन् विकृष्टे सहसा राघवेण शरासने।",
          "रोदसी सम्पफालेव पर्वताश्च चकम्पिरे॥६॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-22",
    "chapterName": "युद्धकाण्ड, सर्ग 22",
    "verseNumber": 6
  },
  {
    "id": "valmiki-ramayana-6-sarga-22-shlok-7",
