    "slug": "valmiki-ramayana-6-sarga-22-shlok-3",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "मत्कार्मुकविसृष्टेन शरवर्षेण सागर।",
          "परं तीरं गमिष्यन्ति पद्भिरेव प्लवंगमाः॥३॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-22",
    "chapterName": "युद्धकाण्ड, सर्ग 22",
    "verseNumber": 3
  },
