    "slug": "valmiki-ramayana-6-sarga-22-shlok-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "अथोवाच रघुश्रेष्ठः सागरं दारुणं वचः।",
          "अद्य त्वां शोषयिष्यामि सपातालं महार्णव॥१॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-22",
    "chapterName": "युद्धकाण्ड, सर्ग 22",
    "verseNumber": 1
  },
