    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "पञ्चमेन तथा चाला प्लवगैः क्षिप्रकारिभिः।",
          "योजनानि त्रयोविंशत् सुवेलमधिकृत्य वै॥७२॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-22",
    "chapterName": "युद्धकाण्ड, सर्ग 22",
    "verseNumber": 72
  },
  {
