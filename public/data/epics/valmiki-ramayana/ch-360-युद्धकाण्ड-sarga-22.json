    "slug": "valmiki-ramayana-6-sarga-22-shlok-2",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "शरनिर्दग्धतोयस्य परिशुष्कस्य सागर।",
          "मया निहतसत्त्वस्य पांसुरुत्पद्यते महान्॥२॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-22",
    "chapterName": "युद्धकाण्ड, सर्ग 22",
    "verseNumber": 2
  },
  {
