      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "मम मातुर्वरो दत्तो मन्दरे विश्वकर्मणा।",
          "मया तु सदृशः पुत्रस्तव देवि भविष्यति॥५१॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-22",
    "chapterName": "युद्धकाण्ड, सर्ग 22",
    "verseNumber": 51
  },
  {
