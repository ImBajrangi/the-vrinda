    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "प्रचकाशे तदाऽऽकाशमुल्काशतविदीपितम्।",
          "अन्तरिक्षाच्च निर्घाता निर्जग्मुरतुलस्वनाः॥९॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-22",
    "chapterName": "युद्धकाण्ड, सर्ग 22",
    "verseNumber": 9
  },
  {
    "id": "valmiki-ramayana-6-sarga-22-shlok-10",
