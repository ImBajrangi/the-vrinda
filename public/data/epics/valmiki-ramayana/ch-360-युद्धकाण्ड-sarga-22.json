    "slug": "valmiki-ramayana-6-sarga-22-shlok-10",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "वपुःप्रकर्षेण ववुर्दिव्यमारुतपङ्क्तयः।",
          "बभञ्ज च तदा वृक्षाञ्जलदानुदहन्मुहुः॥१०॥",
          "आरुजंश्चैव शैलाग्रान् शिखराणि बभञ्ज च।"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-22",
    "chapterName": "युद्धकाण्ड, सर्ग 22",
    "verseNumber": 10
  },
  {
    "id": "valmiki-ramayana-6-sarga-22-shlok-11",
    "collectionId": "valmiki-ramayana",
    "index": 11907,
    "titleDevanagari": "वाल्मीकि रामायण, युद्धकाण्ड, सर्ग 22, श्लोक 11",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-6-sarga-22-shlok-11",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "दिवि च स्म महामेघाः संहताः समहास्वनाः॥११॥",
          "मुमुचुर्वैद्युतानग्नींस्ते महाशनयस्तदा।",
          "यानि भूतानि दृश्यानि चुक्रुशुश्चाशनेः समम्॥१२॥",
          "अदृश्यानि च भूतानि मुमुचुभैरवस्वनम्।",
          "शिश्यिरे चाभिभूतानि संत्रस्तान्युद्भिजन्ति च॥",
          "सम्प्रविव्यथिरे चापि न च पस्पन्दिरे भयात्।"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-22",
    "chapterName": "युद्धकाण्ड, सर्ग 22",
    "verseNumber": 11
  },
  {
