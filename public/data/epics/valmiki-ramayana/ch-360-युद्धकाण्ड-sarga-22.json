      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "स वानरवरः श्रीमान् विश्वकर्मात्मजो बली।",
          "बबन्ध सागरे सेतुं यथा चास्य पिता तथा॥७३॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-22",
    "chapterName": "युद्धकाण्ड, सर्ग 22",
    "verseNumber": 73
