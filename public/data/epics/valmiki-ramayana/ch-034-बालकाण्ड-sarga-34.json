    "slug": "valmiki-ramayana-1-sarga-34-shlok-2",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "इष्टयां तु वर्तमानायां कुशनाभं महीपतिम्।",
          "उवाच परमोदारः कुशो ब्रह्मसुतस्तदा ॥२॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-34",
    "chapterName": "बालकाण्ड, सर्ग 34",
    "verseNumber": 2
  },
  {
