    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-34-shlok-3-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "क्रुद्धं निःश्वसमानं तं प्रदीप्तमिव तेजसा।",
          "भ्रातुर्व्यसनसंतप्तं दृष्ट्वा दशरथात्मजम्॥२॥",
          "उत्पपात हरिश्रेष्ठो हित्वा सौवर्णमासनम्।",
          "महान् महेन्द्रस्य यथा स्वलंकृत इव ध्वजः॥३॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-34",
    "chapterName": "बालकाण्ड, सर्ग 34",
    "verseNumber": 3
  },
  {
