    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "तया स राजर्षिसुतोऽभिकामया समेयिवानुत्तमराजकन्यया।",
          "अतीव रामः शुशुभे मुदान्वितो विभुः श्रिया विष्णुरिवामरेश्वरः॥२९॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-77",
    "chapterName": "बालकाण्ड, सर्ग 77",
