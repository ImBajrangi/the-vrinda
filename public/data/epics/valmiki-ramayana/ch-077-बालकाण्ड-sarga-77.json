    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "गते च भरते रामो लक्ष्मणश्च महाबलः॥२०॥",
          "पितरं देवसंकाशं पूजयामासतुस्तदा।"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-77",
    "chapterName": "बालकाण्ड, सर्ग 77",
    "verseNumber": 20
  },
  {
    "id": "valmiki-ramayana-1-sarga-77-shlok-21",
    "collectionId": "valmiki-ramayana",
    "index": 2984,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 77, श्लोक 21",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-77-shlok-21",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "पितुराज्ञां पुरस्कृत्य पौरकार्याणि सर्वशः॥२१॥",
          "चकार रामः सर्वाणि प्रियाणि च हितानि च।",
          "मातृभ्यो मातृकार्याणि कृत्वा परमयन्त्रितः॥ २२॥",
          "गुरूणां गुरुकार्याणि काले कालेऽन्ववैक्षत।"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-77",
    "chapterName": "बालकाण्ड, सर्ग 77",
    "verseNumber": 21
  },
  {
    "id": "valmiki-ramayana-1-sarga-77-shlok-23",
    "collectionId": "valmiki-ramayana",
    "index": 2985,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 77, श्लोक 23",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-77-shlok-23",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "एवं दशरथः प्रीतो ब्राह्मणा नैगमास्तथा ॥२३॥",
          "रामस्य शीलवृत्तेन सर्वे विषयवासिनः।"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-77",
    "chapterName": "बालकाण्ड, सर्ग 77",
    "verseNumber": 23
  },
  {
    "id": "valmiki-ramayana-1-sarga-77-shlok-24",
    "collectionId": "valmiki-ramayana",
    "index": 2986,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 77, श्लोक 24",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-77-shlok-24",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "तेषामतियशा लोके रामः सत्यपराक्रमः॥२४॥",
          "स्वयंभूरिव भूतानां बभूव गुणवत्तरः।",
          "रामश्च सीतया सार्धं विजहार बहूनृतून्॥ २५॥",
          "मनस्वी तद्गतमनास्तस्या हृदि समर्पितः।"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-77",
    "chapterName": "बालकाण्ड, सर्ग 77",
    "verseNumber": 24
  },
  {
    "id": "valmiki-ramayana-1-sarga-77-shlok-28",
    "collectionId": "valmiki-ramayana",
