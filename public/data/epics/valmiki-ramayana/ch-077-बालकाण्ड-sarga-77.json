[
  {
    "id": "valmiki-ramayana-1-sarga-77-shlok-1",
    "collectionId": "valmiki-ramayana",
    "index": 2973,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 77, श्लोक 1",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-77-shlok-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "गते रामे प्रशान्तात्मा रामो दाशरथिर्धनुः ।",
          "वरुणायाप्रमेयाय ददौ हस्ते महायशाः॥१॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-77",
    "chapterName": "बालकाण्ड, सर्ग 77",
    "verseNumber": 1
  },
  {
    "id": "valmiki-ramayana-1-sarga-77-shlok-2",
    "collectionId": "valmiki-ramayana",
    "index": 2974,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 77, श्लोक 2",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-77-shlok-2",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "अभिवाद्य ततो रामो वसिष्ठप्रमुखानुषीन्।",
          "पितरं विकलं दृष्ट्वा प्रोवाच रघुनन्दनः॥२॥",
          "जामदग्न्यो गतो रामः प्रयातु चतुरंगिणी।",
          "अयोध्याभिमुखी सेना त्वया नाथेन पालिता॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-77",
    "chapterName": "बालकाण्ड, सर्ग 77",
    "verseNumber": 2
  },
  {
    "id": "valmiki-ramayana-1-sarga-77-shlok-3",
    "collectionId": "valmiki-ramayana",
    "index": 2975,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 77, श्लोक 3",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-77-shlok-3",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "‘पिताजी! जमदग्निकुमार परशुराम जी चले गये।अब आपके अधिनायकत्व में सुरक्षित यह चतुरंगिणी सेना",
          "अयोध्या"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-77",
    "chapterName": "बालकाण्ड, सर्ग 77",
    "verseNumber": 3
  },
  {
    "id": "valmiki-ramayana-1-sarga-77-shlok-6",
    "collectionId": "valmiki-ramayana",
    "index": 2976,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 77, श्लोक 6",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-77-shlok-6",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "चोदयामास तां सेनां जगामाशु ततः पुरीम्।",
          "पताकाध्वजिनीं रम्यां तूर्योद्घष्टनिनादिताम्॥६॥",
          "अयोध्या"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-77",
    "chapterName": "बालकाण्ड, सर्ग 77",
    "verseNumber": 6
  },
  {
    "id": "valmiki-ramayana-1-sarga-77-shlok-8",
    "collectionId": "valmiki-ramayana",
    "index": 2977,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 77, श्लोक 8",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-77-shlok-8",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "सिक्तराजपथारम्यां प्रकीर्णकुसुमोत्कराम्।",
          "राजप्रवेशसुमुखैः पौरैर्मङ्गलपाणिभिः॥७॥",
          "सम्पूर्णां प्राविशद् राजा जनौधैः समलंकृताम्।",
          "पौरैः प्रत्युद्गतो दूरं द्विजैश्च पुरवासिभिः॥८॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-77",
    "chapterName": "बालकाण्ड, सर्ग 77",
    "verseNumber": 8
  },
  {
    "id": "valmiki-ramayana-1-sarga-77-shlok-9",
    "collectionId": "valmiki-ramayana",
    "index": 2978,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 77, श्लोक 9",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-77-shlok-9",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "पुत्रैरनुगतः श्रीमान् श्रीमद्भिश्च महायशाः।",
          "प्रविवेश गृहं राजा हिमवत्सदृशं प्रियम्॥९॥",
          "ननन्द स्वजनै राजा गृहे कामैः सुपूजितः।",
          "कौसल्या च सुमित्रा च कैकेयी च सुमध्यमा॥ १०॥",
          "वधप्रतिग्रहे युक्ता याश्चान्या राजयोषितः।"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-77",
    "chapterName": "बालकाण्ड, सर्ग 77",
    "verseNumber": 9
  },
  {
    "id": "valmiki-ramayana-1-sarga-77-shlok-12",
    "collectionId": "valmiki-ramayana",
    "index": 2979,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 77, श्लोक 12",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-77-shlok-12",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "ततः सीतां महाभागामूर्मिलां च यशस्विनीम्॥११॥",
          "कुशध्वजसुते चोभे जगृहुर्नुपयोषितः।",
          "मंगलालापनैर्हो मैः शोभिताः क्षौमवाससः॥१२॥",
          "देवतायतनान्याशु सर्वास्ताः प्रत्यपूजयन्।",
          "अभिवाद्याभिवाद्यांश्च सर्वा राजसुतास्तदा॥ १३॥",
          "रेमिरे मुदिताः सर्वा भर्तृभिर्मुदिता रहः।",
          "कृतदाराः कृतास्त्राश्च सधनाः ससुहृज्जनाः॥ १४॥",
          "शुश्रूषमाणाः पितरं वर्तयन्ति नरर्षभाः।",
          "कस्यचित्त्वथ कालस्य राजा दशरथः सुतम्॥",
          "भरतं कैकयीपुत्रमब्रवीद् रघुनन्दनः।"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-77",
    "chapterName": "बालकाण्ड, सर्ग 77",
    "verseNumber": 12
  },
  {
    "id": "valmiki-ramayana-1-sarga-77-shlok-16",
    "collectionId": "valmiki-ramayana",
