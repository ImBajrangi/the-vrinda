    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 77, श्लोक 16",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-77-shlok-16",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "अयं केकयराजस्य पुत्रो वसति पुत्रक॥१६॥",
          "त्वां नेतुमागतो वीरो युधाजिन्मातुलस्तव।"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-77",
    "chapterName": "बालकाण्ड, सर्ग 77",
    "verseNumber": 16
  },
  {
    "id": "valmiki-ramayana-1-sarga-77-shlok-17",
    "collectionId": "valmiki-ramayana",
    "index": 2981,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 77, श्लोक 17",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-77-shlok-17",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "श्रुत्वा दशरथस्यैतद् भरतः कैकयीसुतः॥१७॥",
          "गमनायाभिचक्राम शत्रुघ्नसहितस्तदा।",
          "आपृच्छ्य पितरं शूरो रामं चाक्लिष्टकारिणम्॥ १८॥",
          "मातृश्चापि नरश्रेष्ठः शत्रुघ्नसहितो ययौ।"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-77",
    "chapterName": "बालकाण्ड, सर्ग 77",
    "verseNumber": 17
  },
  {
    "id": "valmiki-ramayana-1-sarga-77-shlok-19",
    "collectionId": "valmiki-ramayana",
    "index": 2982,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 77, श्लोक 19",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-77-shlok-19",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "युधाजित् प्राप्य भरतं सशत्रुघ्र प्रहर्षितः॥१९॥",
          "स्वपुरं प्राविशद् वीरः पिता तस्य तुतोष ह।"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-77",
    "chapterName": "बालकाण्ड, सर्ग 77",
    "verseNumber": 19
  },
