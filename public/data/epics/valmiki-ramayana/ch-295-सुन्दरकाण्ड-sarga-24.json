    "titleDevanagari": "वाल्मीकि रामायण, सुन्दरकाण्ड, सर्ग 24, श्लोक 1",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-5-sarga-24-shlok-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "ततः सीतां समस्तास्ता राक्षस्यो विकृताननाः।",
          "परुषं परुषानर्हामूचुस्तद्वाक्यमप्रियम्॥१॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-24",
    "chapterName": "सुन्दरकाण्ड, सर्ग 24",
    "verseNumber": 1
  },
  {
    "id": "valmiki-ramayana-5-sarga-24-shlok-2",
    "collectionId": "valmiki-ramayana",
    "index": 9733,
    "titleDevanagari": "वाल्मीकि रामायण, सुन्दरकाण्ड, सर्ग 24, श्लोक 2",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-5-sarga-24-shlok-2",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "किं त्वमन्तःपुरे सीते सर्वभूतमनोरमे।",
          "महार्हशयनोपेते न वासमनुमन्यसे ॥२॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-24",
    "chapterName": "सुन्दरकाण्ड, सर्ग 24",
    "verseNumber": 2
  },
  {
    "id": "valmiki-ramayana-5-sarga-24-shlok-3",
    "collectionId": "valmiki-ramayana",
    "index": 9734,
    "titleDevanagari": "वाल्मीकि रामायण, सुन्दरकाण्ड, सर्ग 24, श्लोक 3",
