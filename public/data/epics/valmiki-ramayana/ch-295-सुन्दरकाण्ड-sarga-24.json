    "slug": "valmiki-ramayana-5-sarga-24-shlok-4",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "त्रैलोक्यवसुभोक्तारं रावणं राक्षसेश्वरम्।",
          "भर्तारमुपसंगम्य विहरस्व यथासुखम्॥४॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-24",
    "chapterName": "सुन्दरकाण्ड, सर्ग 24",
    "verseNumber": 4
  },
  {
    "id": "valmiki-ramayana-5-sarga-24-shlok-5",
