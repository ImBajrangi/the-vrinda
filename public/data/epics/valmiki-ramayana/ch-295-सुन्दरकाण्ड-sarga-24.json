    "slug": "valmiki-ramayana-5-sarga-24-shlok-9",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "दीनो वा राज्यहीनो वा यो मे भर्ता स मे गुरुः।",
          "तं नित्यमनुरक्तास्मि यथा सूर्यं सुवर्चला॥९॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-24",
    "chapterName": "सुन्दरकाण्ड, सर्ग 24",
    "verseNumber": 9
  },
  {
    "id": "valmiki-ramayana-5-sarga-24-shlok-10",
