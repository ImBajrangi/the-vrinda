    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-5-sarga-24-shlok-5",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "मानुषी मानुषं तं तु राममिच्छसि शोभने।",
          "राज्याद् भ्रष्टमसिद्धार्थं विक्लवन्तमनिन्दिते॥५॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-24",
    "chapterName": "सुन्दरकाण्ड, सर्ग 24",
    "verseNumber": 5
  },
  {
