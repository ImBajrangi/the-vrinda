    "slug": "valmiki-ramayana-5-sarga-24-shlok-7",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "यदिदं लोकविद्विष्टमुदाहरत संगताः।",
          "नैतन्मनसि वाक्यं मे किल्बिषं प्रतितिष्ठति॥७॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-24",
    "chapterName": "सुन्दरकाण्ड, सर्ग 24",
    "verseNumber": 7
  },
  {
