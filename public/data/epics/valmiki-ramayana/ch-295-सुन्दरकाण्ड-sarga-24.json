    "slug": "valmiki-ramayana-5-sarga-24-shlok-6",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "राक्षसीनां वचः श्रुत्वा सीता पद्मनिभेक्षणा।",
          "नेत्राभ्यामश्रुपूर्णाभ्यामिदं वचनमब्रवीत्॥६॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-24",
    "chapterName": "सुन्दरकाण्ड, सर्ग 24",
    "verseNumber": 6
  },
  {
