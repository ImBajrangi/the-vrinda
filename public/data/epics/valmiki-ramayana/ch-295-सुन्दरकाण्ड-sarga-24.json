    "slug": "valmiki-ramayana-5-sarga-24-shlok-3",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "मानुषी मानुषस्यैव भार्यात्वं बहु मन्यसे।",
          "प्रत्याहर मनो रामान्नैवं जातु भविष्यति॥३॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-24",
    "chapterName": "सुन्दरकाण्ड, सर्ग 24",
    "verseNumber": 3
  },
  {
