    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "न मानुषी राक्षसस्य भार्या भवितुमर्हति।",
          "कामं खादत मां सर्वा न करिष्यामि वो वचः॥८॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-24",
    "chapterName": "सुन्दरकाण्ड, सर्ग 24",
    "verseNumber": 8
  },
  {
