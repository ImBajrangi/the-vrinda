        "stanzaNumber": 1,
        "linesDevanagari": [
          "प्रेषिताः प्रथमं ये च मयाऽऽज्ञाता महाजवाः।",
          "त्वरणार्थं तु भूयस्त्वं सम्प्रेषय हरीश्वरान्॥१०॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-37",
    "chapterName": "बालकाण्ड, सर्ग 37",
    "verseNumber": 10
  },
