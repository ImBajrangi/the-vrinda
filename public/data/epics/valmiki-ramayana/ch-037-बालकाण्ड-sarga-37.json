    "slug": "valmiki-ramayana-1-sarga-37-shlok-4",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "यदत्रानन्तरं कार्यं लोकानां हितकाम्यया।",
          "संविधत्स्व विधानज्ञ त्वं हि नः परमा गतिः॥४॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-37",
    "chapterName": "बालकाण्ड, सर्ग 37",
    "verseNumber": 4
  },
  {
