    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-37-shlok-3",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "येन सेनापतिर्देव दत्तो भगवता पुरा।",
          "स तपः परमास्थाय तप्यते स्म सहोमया॥३॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-37",
    "chapterName": "बालकाण्ड, सर्ग 37",
    "verseNumber": 3
  },
  {
