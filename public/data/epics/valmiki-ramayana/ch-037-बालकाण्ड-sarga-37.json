    "slug": "valmiki-ramayana-1-sarga-37-shlok-6",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "शैलपुत्र्या यदुक्तं तन्न प्रजाः स्वासु पत्निषु।",
          "तस्या वचनमक्लिष्टं सत्यमेव न संशयः॥६॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-37",
    "chapterName": "बालकाण्ड, सर्ग 37",
    "verseNumber": 6
  },
  {
