    "slug": "valmiki-ramayana-1-sarga-37-shlok-7",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "इयमाकाशगंगा च यस्यां पुत्रं हुताशनः।",
          "जनयिष्यति देवानां सेनापतिमरिंदमम्॥७॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-37",
    "chapterName": "बालकाण्ड, सर्ग 37",
    "verseNumber": 7
  },
  {
