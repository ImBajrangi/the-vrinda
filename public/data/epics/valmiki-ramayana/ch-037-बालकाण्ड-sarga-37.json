    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "ये प्रसक्ताश्च कामेषु दीर्घसूत्राश्च वानराः।",
          "इहानयस्व तान् शीघ्रं सर्वानेव कपीश्वरान्॥११॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-37",
    "chapterName": "बालकाण्ड, सर्ग 37",
    "verseNumber": 11
