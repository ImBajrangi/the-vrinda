    "slug": "valmiki-ramayana-1-sarga-37-shlok-5",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "देवतानां वचः श्रुत्वा सर्वलोकपितामहः।",
          "सान्त्वयन् मधुरैर्वाक्यैस्त्रिदशानिदमब्रवीत्॥५॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-37",
    "chapterName": "बालकाण्ड, सर्ग 37",
    "verseNumber": 5
  },
  {
