    "slug": "valmiki-ramayana-1-sarga-37-shlok-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "एवमुक्तस्तु सुग्रीवो लक्ष्मणेन महात्मना।",
          "हनूमन्तं स्थितं पार्वे वचनं चेदमब्रवीत्॥१॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-37",
    "chapterName": "बालकाण्ड, सर्ग 37",
    "verseNumber": 1
  },
  {
    "id": "valmiki-ramayana-1-sarga-37-shlok-2",
    "collectionId": "valmiki-ramayana",
    "index": 1773,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 37, श्लोक 2",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-37-shlok-2",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "ततोऽब्रुवन् सुराः सर्वे भगवन्तं पितामहम्।",
          "प्रणिपत्य सुराराम सेन्द्राः साग्निपुरोगमाः॥२॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-37",
    "chapterName": "बालकाण्ड, सर्ग 37",
    "verseNumber": 2
  },
  {
    "id": "valmiki-ramayana-1-sarga-37-shlok-3",
