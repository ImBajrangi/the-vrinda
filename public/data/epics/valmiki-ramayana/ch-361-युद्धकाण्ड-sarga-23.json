    "slug": "valmiki-ramayana-6-sarga-23-shlok-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "निमित्तानि निमित्तज्ञो दृष्ट्वा लक्ष्मणपूर्वजः।",
          "सौमित्रिं सम्परिष्वज्य इदं वचनमब्रवीत्॥१॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-23",
    "chapterName": "युद्धकाण्ड, सर्ग 23",
    "verseNumber": 1
  },
  {
