    "slug": "valmiki-ramayana-3-sarga-6-shlok-8",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "त्वमिक्ष्वाकुकुलस्यास्य पृथिव्याश्च महारथः।",
          "प्रधानश्चापि नाथश्च देवानां मघवानिव॥८॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-6",
    "chapterName": "अरण्यकाण्ड, सर्ग 6",
    "verseNumber": 8
  },
