    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "विश्रुतस्त्रिषु लोकेषु यशसा विक्रमेण च।",
          "पितृव्रतत्वं सत्यं च त्वयि धर्मश्च पुष्कलः॥९॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-6",
    "chapterName": "अरण्यकाण्ड, सर्ग 6",
    "verseNumber": 9
  },
  {
