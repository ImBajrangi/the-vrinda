        "stanzaNumber": 1,
        "linesDevanagari": [
          "यत् करोति परं धर्मं मुनिर्मूलफलाशनः ।",
          "तत्र राज्ञश्चतर्भागः प्रजा धर्मेण रक्षतः॥१४॥"
        ]
      }
