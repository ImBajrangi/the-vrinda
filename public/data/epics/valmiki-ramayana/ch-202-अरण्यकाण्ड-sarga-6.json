    "slug": "valmiki-ramayana-3-sarga-6-shlok-7",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "अभिगम्य च धर्मज्ञा रामं धर्मभृतां वरम्।",
          "ऊचुः परमधर्मज्ञमृषिसङ्घाः समागताः॥७॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-6",
    "chapterName": "अरण्यकाण्ड, सर्ग 6",
    "verseNumber": 7
  },
  {
