[
  {
    "id": "valmiki-ramayana-3-sarga-6-shlok-2",
    "collectionId": "valmiki-ramayana",
    "index": 6932,
    "titleDevanagari": "वाल्मीकि रामायण, अरण्यकाण्ड, सर्ग 6, श्लोक 2",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-6-shlok-2",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "वैखानसा वालखिल्याः सम्प्रक्षाला मरीचिपाः।",
          "अश्मकुट्टाश्च बहवः पत्राहाराश्च तापसाः॥२॥",
          "दन्तोलूखलिनश्चैव तथैवोन्मज्जकाः परे।",
          "गात्रशय्या अशय्याश्च तथैवानवकाशिकाः॥ ३॥",
          "मुनयः सलिलाहारा वायुभक्षास्तथापरे।",
          "आकाशनिलयाश्चैव तथा स्थण्डिलशायिनः॥ ४॥",
          "तथोर्ध्ववासिनो दान्तास्तथाऽऽर्द्रपटवाससः।",
          "सजपाश्च तपोनिष्ठास्तथा पञ्चतपोऽन्विताः॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-6",
    "chapterName": "अरण्यकाण्ड, सर्ग 6",
    "verseNumber": 2
  },
  {
    "id": "valmiki-ramayana-3-sarga-6-shlok-6",
    "collectionId": "valmiki-ramayana",
