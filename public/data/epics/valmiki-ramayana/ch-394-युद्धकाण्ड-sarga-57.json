    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "निर्याणादेव तूर्णं च चलिता हरिवाहिनी।",
          "नर्दतां राक्षसेन्द्राणां श्रुत्वा नादं द्रविष्यति॥८॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-57",
    "chapterName": "युद्धकाण्ड, सर्ग 57",
    "verseNumber": 8
  },
