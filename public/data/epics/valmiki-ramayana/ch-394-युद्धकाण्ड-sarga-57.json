    "slug": "valmiki-ramayana-6-sarga-57-shlok-6",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "अहं वा कुम्भकर्णो वा त्वं वा सेनापतिर्मम।",
          "इन्द्रजिद् वा निकुम्भो वा वहेयुर्भारमीदृशम्॥६॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-57",
    "chapterName": "युद्धकाण्ड, सर्ग 57",
    "verseNumber": 6
  },
