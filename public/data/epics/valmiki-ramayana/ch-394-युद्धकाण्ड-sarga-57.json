    "titleDevanagari": "वाल्मीकि रामायण, युद्धकाण्ड, सर्ग 57, श्लोक 1",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-6-sarga-57-shlok-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "अकम्पनवधं श्रुत्वा क्रुद्धो वै राक्षसेश्वरः।",
          "किंचिद् दीनमुखश्चापि सचिवांस्तानुदैक्षत॥१॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-57",
    "chapterName": "युद्धकाण्ड, सर्ग 57",
    "verseNumber": 1
  },
  {
    "id": "valmiki-ramayana-6-sarga-57-shlok-2",
    "collectionId": "valmiki-ramayana",
    "index": 13091,
    "titleDevanagari": "वाल्मीकि रामायण, युद्धकाण्ड, सर्ग 57, श्लोक 2",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-6-sarga-57-shlok-2",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "स तु ध्यात्वा मुहूर्तं तु मन्त्रिभिः संविचार्य च।",
          "ततस्तु रावणः पूर्वदिवसे राक्षसाधिपः।",
          "पुरीं परिययौ लङ्कां सर्वान् गुल्मानवेक्षितुम्॥२॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-57",
    "chapterName": "युद्धकाण्ड, सर्ग 57",
    "verseNumber": 2
  },
  {
    "id": "valmiki-ramayana-6-sarga-57-shlok-3",
    "collectionId": "valmiki-ramayana",
    "index": 13092,
    "titleDevanagari": "वाल्मीकि रामायण, युद्धकाण्ड, सर्ग 57, श्लोक 3",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-6-sarga-57-shlok-3",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "तां राक्षसगणैर्गुप्तां गुल्मैर्बहुभिरावृताम्।",
          "ददर्श नगरी राजा पताकाध्वजमालिनीम्॥३॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-57",
    "chapterName": "युद्धकाण्ड, सर्ग 57",
    "verseNumber": 3
  },
  {
