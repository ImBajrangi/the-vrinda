    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "पुरस्योपनिविष्टस्य सहसा पीडितस्य ह।",
          "नान्ययुद्धात् प्रपश्यामि मोक्षं युद्धविशारद ॥५॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-57",
    "chapterName": "युद्धकाण्ड, सर्ग 57",
    "verseNumber": 5
  },
  {
