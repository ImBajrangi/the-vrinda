    "slug": "valmiki-ramayana-6-sarga-57-shlok-4",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "रुद्धां तु नगरीं दृष्ट्वा रावणो राक्षसेश्वरः।",
          "उवाचात्महितं काले प्रहस्तं युद्धकोविदम्॥४॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-57",
    "chapterName": "युद्धकाण्ड, सर्ग 57",
    "verseNumber": 4
  },
  {
