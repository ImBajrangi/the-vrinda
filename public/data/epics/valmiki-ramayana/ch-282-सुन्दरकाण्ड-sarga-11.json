    "slug": "valmiki-ramayana-5-sarga-11-shlok-2",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "न रामेण वियुक्ता सा स्वप्तुमर्हति भामिनी।",
          "न भोक्तुं नाप्यलंकर्तुं न पानमुपसेवितुम्॥२॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-11",
    "chapterName": "सुन्दरकाण्ड, सर्ग 11",
    "verseNumber": 2
  },
  {
