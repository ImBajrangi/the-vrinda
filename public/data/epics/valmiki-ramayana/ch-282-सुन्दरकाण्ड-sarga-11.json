    "slug": "valmiki-ramayana-5-sarga-11-shlok-8",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "अंगनानां सहस्रेण भूषितेन विभूषणैः।",
          "रूपसंलापशीलेन युक्तगीतार्थभाषिणा॥७॥",
          "देशकालाभियुक्तेन युक्तवाक्याभिधायिना।",
          "रताधिकेन संयुक्तां ददर्श हरियूथपः॥८॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-11",
    "chapterName": "सुन्दरकाण्ड, सर्ग 11",
    "verseNumber": 8
  },
  {
