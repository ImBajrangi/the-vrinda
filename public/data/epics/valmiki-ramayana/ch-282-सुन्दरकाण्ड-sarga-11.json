    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "सितामध्वादिमधुरो द्राक्षादाडिमयो रसः।",
          "विरलश्चेत् कृतो रागः सान्द्रश्चेत् खाण्डवः स्मृतः॥",
          "महानपुरकेयूरैरपविद्धैर्महाधनैः।",
          "पानभाजनविक्षिप्तैः फलैश्च विविधैरपि॥१९॥",
          "कृतपुष्पोपहारा भूरधिकां पुष्यति श्रियम्।"
        ]
      }
