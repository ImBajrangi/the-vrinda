    "slug": "valmiki-ramayana-5-sarga-11-shlok-5",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "क्रीडितेनापराः क्लान्ता गीतेन च तथापराः।",
          "नृत्येन चापराः क्लान्ताः पानविप्रहतास्तथा॥५॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-11",
    "chapterName": "सुन्दरकाण्ड, सर्ग 11",
    "verseNumber": 5
  },
