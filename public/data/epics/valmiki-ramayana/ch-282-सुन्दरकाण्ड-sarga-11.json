    "slug": "valmiki-ramayana-5-sarga-11-shlok-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "अवधूय च तां बुद्धिं बभूवावस्थितस्तदा।",
          "जगाम चापरां चिन्तां सीतां प्रति महाकपिः॥१॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-11",
    "chapterName": "सुन्दरकाण्ड, सर्ग 11",
    "verseNumber": 1
  },
  {
