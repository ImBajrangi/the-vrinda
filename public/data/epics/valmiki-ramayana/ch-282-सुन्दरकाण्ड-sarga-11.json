        "stanzaNumber": 1,
        "linesDevanagari": [
          "नान्यं नरमुपस्थातुं सुराणामपि चेश्वरम्।",
          "न हि रामसमः कश्चिद् विद्यते त्रिदशेष्वपि॥३॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-11",
    "chapterName": "सुन्दरकाण्ड, सर्ग 11",
    "verseNumber": 3
  },
