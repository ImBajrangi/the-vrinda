    "slug": "valmiki-ramayana-5-sarga-16-shlok-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "प्रशस्य तु प्रशस्तव्यां सीतां तां हरिपुंगवः।",
          "गुणाभिरामं रामं च पुनश्चिन्तापरोऽभवत्॥१॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-16",
    "chapterName": "सुन्दरकाण्ड, सर्ग 16",
    "verseNumber": 1
  },
  {
    "id": "valmiki-ramayana-5-sarga-16-shlok-2",
    "collectionId": "valmiki-ramayana",
    "index": 9512,
    "titleDevanagari": "वाल्मीकि रामायण, सुन्दरकाण्ड, सर्ग 16, श्लोक 2",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-5-sarga-16-shlok-2",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "स मुहूर्तमिव ध्यात्वा बाष्पपर्याकुलेक्षणः।",
          "सीतामाश्रित्य तेजस्वी हनूमान् विललाप ह॥२॥",
          "मान्या गुरुविनीतस्य लक्ष्मणस्य गुरुप्रिया।",
          "यदि सीता हि दुःखार्ता कालो हि दुरतिक्रमः॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-16",
    "chapterName": "सुन्दरकाण्ड, सर्ग 16",
    "verseNumber": 2
  },
  {
    "id": "valmiki-ramayana-5-sarga-16-shlok-4",
    "collectionId": "valmiki-ramayana",
    "index": 9513,
    "titleDevanagari": "वाल्मीकि रामायण, सुन्दरकाण्ड, सर्ग 16, श्लोक 4",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-5-sarga-16-shlok-4",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "रामस्य व्यवसायज्ञा लक्ष्मणस्य च धीमतः।",
          "नात्यर्थं क्षुभ्यते देवी गंगेव जलदागमे॥४॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-16",
    "chapterName": "सुन्दरकाण्ड, सर्ग 16",
    "verseNumber": 4
  },
