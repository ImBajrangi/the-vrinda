    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-6-sarga-43-shlok-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "युध्यतां तु ततस्तेषां वानराणां महात्मनाम्।",
          "रक्षसां सम्बभूवाथ बलरोषः सुदारुणः॥१॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-43",
    "chapterName": "युद्धकाण्ड, सर्ग 43",
    "verseNumber": 1
  },
  {
    "id": "valmiki-ramayana-6-sarga-43-shlok-3",
    "collectionId": "valmiki-ramayana",
    "index": 12590,
    "titleDevanagari": "वाल्मीकि रामायण, युद्धकाण्ड, सर्ग 43, श्लोक 3",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-6-sarga-43-shlok-3",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "ते हयैः काञ्चनापीडैर्गजैश्चाग्निशिखोपमैः।",
          "रथैश्चादित्यसंकाशैः कवचैश्च मनोरमैः॥२॥",
          "निर्ययू राक्षसा वीरा नादयन्तो दिशो दश।",
          "राक्षसा भीमकर्माणो रावणस्य जयैषिणः॥३॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-43",
    "chapterName": "युद्धकाण्ड, सर्ग 43",
    "verseNumber": 3
  },
  {
    "id": "valmiki-ramayana-6-sarga-43-shlok-4",
    "collectionId": "valmiki-ramayana",
