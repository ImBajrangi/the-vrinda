    "slug": "valmiki-ramayana-6-sarga-43-shlok-4",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "वानराणामपि चमूर्बहती जयमिच्छताम्।",
          "अभ्यधावत तां सेनां रक्षसां घोरकर्मणाम्॥४॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-43",
    "chapterName": "युद्धकाण्ड, सर्ग 43",
    "verseNumber": 4
  },
