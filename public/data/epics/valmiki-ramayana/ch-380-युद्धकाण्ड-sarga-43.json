    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "एतस्मिन्नन्तरे तेषामन्योन्यमभिधावताम्।",
          "रक्षसां वानराणां च द्वन्द्वयुद्धमवर्तत॥५॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-43",
    "chapterName": "युद्धकाण्ड, सर्ग 43",
    "verseNumber": 5
  },
