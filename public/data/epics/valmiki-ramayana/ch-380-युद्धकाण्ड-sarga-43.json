        "linesDevanagari": [
          "अङ्गदेनेन्द्रजित्सार्धं वालिपुत्रेण राक्षसः।",
          "अयुध्यत महातेजास्त्र्यम्बकेण यथान्धकः॥६॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-43",
    "chapterName": "युद्धकाण्ड, सर्ग 43",
    "verseNumber": 6
  },
