    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "तस्य भार्या जनस्थाने भ्रष्टा सीतेति विश्रुता।",
          "वैदेहस्य सुता राज्ञो जनकस्य महात्मनः॥७॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-51",
    "chapterName": "सुन्दरकाण्ड, सर्ग 51",
    "verseNumber": 7
  },
