        "linesDevanagari": [
          "मार्गमाणस्तु तां देवीं राजपुत्रः सहानुजः।",
          "ऋष्यमूकमनुप्राप्तः सुग्रीवेण च संगतः॥८॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-51",
    "chapterName": "सुन्दरकाण्ड, सर्ग 51",
    "verseNumber": 8
  },
