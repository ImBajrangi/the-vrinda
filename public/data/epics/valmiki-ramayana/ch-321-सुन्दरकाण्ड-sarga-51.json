    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-5-sarga-51-shlok-6",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "ज्येष्ठस्तस्य महाबाहुः पुत्रः प्रियतरः प्रभुः।",
          "पितुर्निदेशान्निष्क्रान्तः प्रविष्टो दण्डकावनम्॥",
          "लक्ष्मणेन सह भ्राता सीतया सह भार्यया।",
          "रामो नाम महातेजा धन॑ पन्थानमाश्रितः॥६॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-51",
    "chapterName": "सुन्दरकाण्ड, सर्ग 51",
    "verseNumber": 6
  },
  {
    "id": "valmiki-ramayana-5-sarga-51-shlok-7",
    "collectionId": "valmiki-ramayana",
    "index": 10603,
    "titleDevanagari": "वाल्मीकि रामायण, सुन्दरकाण्ड, सर्ग 51, श्लोक 7",
