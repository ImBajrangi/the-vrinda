    "titleDevanagari": "वाल्मीकि रामायण, सुन्दरकाण्ड, सर्ग 51, श्लोक 3",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-5-sarga-51-shlok-3",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "भ्रातुः श्रृणु समादेशं सुग्रीवस्य महात्मनः।",
          "धर्मार्थसहितं वाक्यमिह चामुत्र च क्षमम्॥३॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-51",
    "chapterName": "सुन्दरकाण्ड, सर्ग 51",
    "verseNumber": 3
  },
