    "titleDevanagari": "वाल्मीकि रामायण, सुन्दरकाण्ड, सर्ग 51, श्लोक 2",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-5-sarga-51-shlok-2",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "अहं सुग्रीवसंदेशादिह प्राप्तस्तवान्तिके।",
          "राक्षसेश हरीशस्त्वां भ्राता कुशलमब्रवीत्॥२॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-51",
    "chapterName": "सुन्दरकाण्ड, सर्ग 51",
    "verseNumber": 2
  },
  {
