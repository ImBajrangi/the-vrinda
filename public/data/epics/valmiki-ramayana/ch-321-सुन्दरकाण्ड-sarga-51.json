    "slug": "valmiki-ramayana-5-sarga-51-shlok-4",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "राजा दशरथो नाम रथकुञ्जरवाजिमान्।",
          "पितेव बन्धुर्लोकस्य सुरेश्वरसमद्युतिः॥४॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-51",
    "chapterName": "सुन्दरकाण्ड, सर्ग 51",
    "verseNumber": 4
  },
  {
