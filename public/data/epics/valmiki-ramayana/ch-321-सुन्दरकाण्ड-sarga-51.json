    "slug": "valmiki-ramayana-5-sarga-51-shlok-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "तं समीक्ष्य महासत्त्वं सत्त्ववान् हरिसत्तमः।",
          "वाक्यमर्थवदव्यग्रस्तमुवाच दशाननम्॥१॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-51",
    "chapterName": "सुन्दरकाण्ड, सर्ग 51",
    "verseNumber": 1
  },
  {
