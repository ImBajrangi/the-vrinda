    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 71, श्लोक 12",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-71-shlok-12",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "महारोम्णस्तु धर्मात्मा स्वर्णरोमा व्यजायत।",
          "स्वर्णरोम्णस्तु राजर्षेईस्वरोमा व्यजायत॥१२॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-71",
    "chapterName": "बालकाण्ड, सर्ग 71",
    "verseNumber": 12
  },
  {
    "id": "valmiki-ramayana-1-sarga-71-shlok-13",
