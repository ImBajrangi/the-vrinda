    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-71-shlok-18",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "तस्याप्रदानान्महर्षे युद्धमासीन्मया सह।",
          "स हतोऽभिमुखो राजा सुधन्वा तु मया रणे॥ १८॥",
          "निहत्य तं मुनिश्रेष्ठ सुधन्वानं नराधिपम्।",
          "सांकाश्ये भ्रातरं शूरमभ्यषिञ्चं कुशध्वजम्॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-71",
    "chapterName": "बालकाण्ड, सर्ग 71",
    "verseNumber": 18
  },
  {
    "id": "valmiki-ramayana-1-sarga-71-shlok-20",
    "collectionId": "valmiki-ramayana",
    "index": 2861,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 71, श्लोक 20",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-71-shlok-20",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "कनीयानेष मे भ्राता अहं ज्येष्ठो महामुने।",
          "ददामि परमप्रीतो वध्वौ ते मुनिपुंगव॥२०॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-71",
    "chapterName": "बालकाण्ड, सर्ग 71",
    "verseNumber": 20
  },
  {
    "id": "valmiki-ramayana-1-sarga-71-shlok-22",
    "collectionId": "valmiki-ramayana",
    "index": 2862,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 71, श्लोक 22",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-71-shlok-22",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "सीतां रामाय भद्रं ते ऊर्मिलां लक्ष्मणाय वै।",
          "वीर्यशुल्कां मम सुतां सीतां सुरसुतोपमाम्॥२१॥",
          "द्वितीयामूर्मिलां चैव त्रिर्वदामि न संशयः।",
          "ददामि परमप्रीतो वध्वौ ते मुनिपुंगव॥ २२॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-71",
    "chapterName": "बालकाण्ड, सर्ग 71",
    "verseNumber": 22
  },
  {
    "id": "valmiki-ramayana-1-sarga-71-shlok-23",
    "collectionId": "valmiki-ramayana",
    "index": 2863,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 71, श्लोक 23",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-71-shlok-23",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "रामलक्ष्मणयो राजन् गोदानं कारयस्व ह।",
          "पितृकार्यं च भद्रं ते ततो वैवाहिकं कुरु॥२३॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-71",
    "chapterName": "बालकाण्ड, सर्ग 71",
