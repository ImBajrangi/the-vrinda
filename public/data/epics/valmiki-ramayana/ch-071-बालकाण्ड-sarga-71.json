    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 71, श्लोक 13",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-71-shlok-13",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "तस्य पुत्रद्वयं राज्ञो धर्मज्ञस्य महात्मनः।",
          "ज्येष्ठोऽहमनुजो भ्राता मम वीरः कुशध्वजः॥ १३॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-71",
    "chapterName": "बालकाण्ड, सर्ग 71",
    "verseNumber": 13
  },
  {
    "id": "valmiki-ramayana-1-sarga-71-shlok-14",
    "collectionId": "valmiki-ramayana",
    "index": 2858,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 71, श्लोक 14",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-71-shlok-14",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "मां तु ज्येष्ठं पिता राज्ये सोऽभिषिच्य पिता मम।",
          "कुशध्वजं समावेश्य भारं मयि वनं गतः॥१४॥",
          "वृद्धे पितरि स्वर्याते धर्मेण धुरमावहम्।",
          "भ्रातरं देवसंकाशं स्नेहात् पश्यन् कुशध्वजम्॥",
          "कस्यचित्त्वथ कालस्य सांकाश्यादागतः पुरात्।",
          "सुधन्वा वीर्यवान् राजा मिथिलामवरोधकः॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-71",
    "chapterName": "बालकाण्ड, सर्ग 71",
    "verseNumber": 14
  },
  {
    "id": "valmiki-ramayana-1-sarga-71-shlok-17",
    "collectionId": "valmiki-ramayana",
    "index": 2859,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 71, श्लोक 17",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-71-shlok-17",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "स च मे प्रेषयामास शैवं धनुरनुत्तमम्।",
          "सीता च कन्या पद्माक्षी मह्यं वै दीयतामिति॥ १७॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-71",
    "chapterName": "बालकाण्ड, सर्ग 71",
    "verseNumber": 17
  },
  {
    "id": "valmiki-ramayana-1-sarga-71-shlok-18",
