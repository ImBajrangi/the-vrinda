    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-71-shlok-11",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "महीध्रकसुतो राजा कीर्तिरातो महाबलः।",
          "कीर्तिरातस्य राजर्षेर्महारोमा व्यजायत॥११॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-71",
    "chapterName": "बालकाण्ड, सर्ग 71",
    "verseNumber": 11
  },
  {
    "id": "valmiki-ramayana-1-sarga-71-shlok-12",
    "collectionId": "valmiki-ramayana",
