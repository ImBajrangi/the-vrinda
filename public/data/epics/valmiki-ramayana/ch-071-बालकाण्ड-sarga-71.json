    "slug": "valmiki-ramayana-1-sarga-71-shlok-24",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "मघा ह्यद्य महाबाहो तृतीयदिवसे प्रभो।",
          "फल्गुन्यामुत्तरे राजेस्तस्मिन् वैवाहिकं कुरु।",
          "रामलक्ष्मणयोरर्थे दानं कार्यं सुखोदयम्॥२४॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-71",
