    "slug": "valmiki-ramayana-1-sarga-71-shlok-7",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "बृहद्रथस्य शूरोऽभून्महावीरः प्रतापवान्।",
          "महावीरस्य धृतिमान् सुधृतिः सत्यविक्रमः॥७॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-71",
    "chapterName": "बालकाण्ड, सर्ग 71",
    "verseNumber": 7
  },
  {
    "id": "valmiki-ramayana-1-sarga-71-shlok-9",
    "collectionId": "valmiki-ramayana",
    "index": 2854,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 71, श्लोक 9",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-71-shlok-9",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "हर्यश्वस्य मरुः पुत्रो मरोः पुत्रः प्रतीन्धकः।",
          "प्रतीन्धकस्य धर्मात्मा राजा कीर्तिरथः सुतः॥९॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-71",
    "chapterName": "बालकाण्ड, सर्ग 71",
    "verseNumber": 9
  },
  {
    "id": "valmiki-ramayana-1-sarga-71-shlok-11",
