[
  {
    "id": "valmiki-ramayana-1-sarga-71-shlok-2",
    "collectionId": "valmiki-ramayana",
    "index": 2850,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 71, श्लोक 2",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-71-shlok-2",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "एवं ब्रुवाणं जनकः प्रत्युवाच कृताञ्जलिः।",
          "श्रोतुमर्हसि भद्रं ते कुलं नः परिकीर्तितम्॥१॥",
          "प्रदाने हि मुनिश्रेष्ठ कुलं निरवशेषतः।",
          "वक्तव्यं कुलजातेन तन्निबोध महामते॥२॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-71",
    "chapterName": "बालकाण्ड, सर्ग 71",
    "verseNumber": 2
  },
  {
    "id": "valmiki-ramayana-1-sarga-71-shlok-3",
    "collectionId": "valmiki-ramayana",
    "index": 2851,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 71, श्लोक 3",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-71-shlok-3",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "राजाभूत् त्रिषु लोकेषु विश्रुतः स्वेन कर्मणा।",
          "निमिः परमधर्मात्मा सर्वसत्त्ववतां वरः॥३॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-71",
    "chapterName": "बालकाण्ड, सर्ग 71",
    "verseNumber": 3
  },
  {
    "id": "valmiki-ramayana-1-sarga-71-shlok-4",
    "collectionId": "valmiki-ramayana",
    "index": 2852,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 71, श्लोक 4",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-71-shlok-4",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "तस्य पुत्रो मिथिर्नाम जनको मिथिपुत्रकः।।",
          "प्रथमो जनको राजा जनकादप्युदावसुः॥४॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-71",
    "chapterName": "बालकाण्ड, सर्ग 71",
    "verseNumber": 4
  },
  {
