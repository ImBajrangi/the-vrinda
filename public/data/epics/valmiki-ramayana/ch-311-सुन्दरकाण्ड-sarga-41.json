    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-5-sarga-41-shlok-18",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "नानाशकुन्तविरुतैः प्रभिन्नसलिलाशयैः।",
          "तानैः किसलयैः क्लान्तैः क्लान्तद्रुमलतायुतैः॥१७॥",
          "न बभौ तद् वनं तत्र दावानलहतं यथा।",
          "व्याकुलावरणा रेजुर्विह्वला इव ता लताः॥१८॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-41",
    "chapterName": "सुन्दरकाण्ड, सर्ग 41",
    "verseNumber": 18
