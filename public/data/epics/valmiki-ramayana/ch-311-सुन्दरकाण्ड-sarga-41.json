    "slug": "valmiki-ramayana-5-sarga-41-shlok-15",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "ततस्तद्धनुमान् वीरो बभञ्ज प्रमदावनम्।",
          "मत्तद्विजसमाघुष्टं नानाद्रुमलतायुतम्॥१५॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-41",
