    "index": 10320,
    "titleDevanagari": "वाल्मीकि रामायण, सुन्दरकाण्ड, सर्ग 41, श्लोक 1",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-5-sarga-41-shlok-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "स च वाग्भिः प्रशस्ताभिर्गमिष्यन् पूजितस्तया।",
          "तस्माद् देशादपाक्रम्य चिन्तयामास वानरः॥१॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-41",
    "chapterName": "सुन्दरकाण्ड, सर्ग 41",
    "verseNumber": 1
  },
  {
    "id": "valmiki-ramayana-5-sarga-41-shlok-2",
    "collectionId": "valmiki-ramayana",
    "index": 10321,
    "titleDevanagari": "वाल्मीकि रामायण, सुन्दरकाण्ड, सर्ग 41, श्लोक 2",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-5-sarga-41-shlok-2",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "अल्पशेषमिदं कार्यं दृष्टेयमसितेक्षणा।",
          "त्रीनुपायानतिक्रम्य चतुर्थ इह दृश्यते॥२॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-41",
    "chapterName": "सुन्दरकाण्ड, सर्ग 41",
    "verseNumber": 2
  },
  {
    "id": "valmiki-ramayana-5-sarga-41-shlok-3",
    "collectionId": "valmiki-ramayana",
    "index": 10322,
    "titleDevanagari": "वाल्मीकि रामायण, सुन्दरकाण्ड, सर्ग 41, श्लोक 3",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-5-sarga-41-shlok-3",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "न साम रक्षःसु गुणाय कल्पते न दानमर्थोपचितेषु युज्यते।",
          "न भेदसाध्या बलदर्पिता जनाः पराक्रमस्त्वेष ममेह रोचते॥३॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-41",
    "chapterName": "सुन्दरकाण्ड, सर्ग 41",
    "verseNumber": 3
  },
  {
    "id": "valmiki-ramayana-5-sarga-41-shlok-4",
    "collectionId": "valmiki-ramayana",
    "index": 10323,
    "titleDevanagari": "वाल्मीकि रामायण, सुन्दरकाण्ड, सर्ग 41, श्लोक 4",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-5-sarga-41-shlok-4",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "न चास्य कार्यस्य पराक्रमादृते विनिश्चयः कश्चिदिहोपपद्यते।",
          "हतप्रवीराश्च रणे तु राक्षसाः कथंचिदीयुर्यदिहाद्य मार्दवम्॥४॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-41",
    "chapterName": "सुन्दरकाण्ड, सर्ग 41",
    "verseNumber": 4
  },
  {
    "id": "valmiki-ramayana-5-sarga-41-shlok-5",
    "collectionId": "valmiki-ramayana",
    "index": 10324,
    "titleDevanagari": "वाल्मीकि रामायण, सुन्दरकाण्ड, सर्ग 41, श्लोक 5",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-5-sarga-41-shlok-5",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "कार्ये कर्मणि निर्वृत्ते यो बहून्यपि साधयेत्।",
          "पूर्वकार्याविरोधेन स कार्यं कर्तुमर्हति॥५॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-41",
    "chapterName": "सुन्दरकाण्ड, सर्ग 41",
    "verseNumber": 5
  },
  {
    "id": "valmiki-ramayana-5-sarga-41-shlok-6",
    "collectionId": "valmiki-ramayana",
    "index": 10325,
    "titleDevanagari": "वाल्मीकि रामायण, सुन्दरकाण्ड, सर्ग 41, श्लोक 6",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-5-sarga-41-shlok-6",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "न ह्येकः साधको हेतुः स्वल्पस्यापीह कर्मणः।",
          "यो ह्यर्थं बहुधा वेद स समर्थोऽर्थसाधने॥६॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-41",
    "chapterName": "सुन्दरकाण्ड, सर्ग 41",
    "verseNumber": 6
  },
  {
    "id": "valmiki-ramayana-5-sarga-41-shlok-7",
    "collectionId": "valmiki-ramayana",
    "index": 10326,
    "titleDevanagari": "वाल्मीकि रामायण, सुन्दरकाण्ड, सर्ग 41, श्लोक 7",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-5-sarga-41-shlok-7",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "इहैव तावत्कृतनिश्चयो ह्यहं व्रजेयमद्य प्लवगेश्वरालयम्।",
          "परात्मसम्मर्दविशेषतत्त्ववित् ततः कृतं स्यान्मम भर्तृशासनम्॥७॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-41",
    "chapterName": "सुन्दरकाण्ड, सर्ग 41",
    "verseNumber": 7
  },
  {
    "id": "valmiki-ramayana-5-sarga-41-shlok-8",
    "collectionId": "valmiki-ramayana",
    "index": 10327,
    "titleDevanagari": "वाल्मीकि रामायण, सुन्दरकाण्ड, सर्ग 41, श्लोक 8",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-5-sarga-41-shlok-8",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "कथं नु खल्वद्य भवेत् सुखागतं प्रसह्य युद्धं मम राक्षसैः सह।",
          "तथैव खल्वात्मबलं च सारवत् समानयेन्मां च रणे दशाननः॥८॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-41",
    "chapterName": "सुन्दरकाण्ड, सर्ग 41",
    "verseNumber": 8
  },
  {
    "id": "valmiki-ramayana-5-sarga-41-shlok-9",
    "collectionId": "valmiki-ramayana",
    "index": 10328,
    "titleDevanagari": "वाल्मीकि रामायण, सुन्दरकाण्ड, सर्ग 41, श्लोक 9",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-5-sarga-41-shlok-9",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "ततः समासाद्य रणे दशाननं समन्त्रिवर्गं सबलं सयायिनम्।",
          "हृदि स्थितं तस्य मतं बलं च सुखेन मत्वाहमितः पुनर्ब्रजे॥९॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-41",
    "chapterName": "सुन्दरकाण्ड, सर्ग 41",
    "verseNumber": 9
  },
  {
    "id": "valmiki-ramayana-5-sarga-41-shlok-10",
    "collectionId": "valmiki-ramayana",
    "index": 10329,
    "titleDevanagari": "वाल्मीकि रामायण, सुन्दरकाण्ड, सर्ग 41, श्लोक 10",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-5-sarga-41-shlok-10",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "इदमस्य नृशंसस्य नन्दनोपममुत्तमम्।",
          "वनं नेत्रमनःकान्तं नानाद्रुमलतायुतम्॥१०॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-41",
    "chapterName": "सुन्दरकाण्ड, सर्ग 41",
    "verseNumber": 10
  },
  {
    "id": "valmiki-ramayana-5-sarga-41-shlok-11",
    "collectionId": "valmiki-ramayana",
    "index": 10330,
    "titleDevanagari": "वाल्मीकि रामायण, सुन्दरकाण्ड, सर्ग 41, श्लोक 11",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-5-sarga-41-shlok-11",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "इदं विध्वंसयिष्यामि शुष्कं वनमिवानलः।",
          "अस्मिन् भग्ने ततः कोपं करिष्यति स रावणः॥११॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-41",
    "chapterName": "सुन्दरकाण्ड, सर्ग 41",
    "verseNumber": 11
  },
  {
    "id": "valmiki-ramayana-5-sarga-41-shlok-12",
    "collectionId": "valmiki-ramayana",
    "index": 10331,
    "titleDevanagari": "वाल्मीकि रामायण, सुन्दरकाण्ड, सर्ग 41, श्लोक 12",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-5-sarga-41-shlok-12",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "ततो महत्साश्वमहारथद्विपं बलं समानेष्यति राक्षसाधिपः।",
          "त्रिशूलकालायसपट्टिशायुधं ततो महद्युद्धमिदं भविष्यति॥१२॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-41",
    "chapterName": "सुन्दरकाण्ड, सर्ग 41",
    "verseNumber": 12
  },
  {
