    "slug": "valmiki-ramayana-5-sarga-41-shlok-14",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "ततो मारुतवत् क्रुद्धो मारुतिर्भीमविक्रमः।",
          "ऊरुवेगेन महता द्रुमान् क्षेप्तुमथारभत्॥१४॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-41",
    "chapterName": "सुन्दरकाण्ड, सर्ग 41",
    "verseNumber": 14
  },
