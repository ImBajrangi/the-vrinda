    "slug": "valmiki-ramayana-5-sarga-41-shlok-13",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "अहं च तैः संयति चण्डविक्रमैः समेत्य रक्षोभिरभङ्गविक्रमः।",
          "निहत्य तद् रावणचोदितं बलं सुखं गमिष्यामि हरीश्वरालयम्॥१३॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-41",
    "chapterName": "सुन्दरकाण्ड, सर्ग 41",
    "verseNumber": 13
  },
  {
    "id": "valmiki-ramayana-5-sarga-41-shlok-14",
