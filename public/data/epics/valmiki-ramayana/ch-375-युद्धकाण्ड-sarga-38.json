    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-6-sarga-38-shlok-18",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "ते दृष्ट्वा वानराः सर्वे राक्षसान् युद्धकारिणः।",
          "मुमुचुर्विविधान् नादांस्तस्य रामस्य पश्यतः॥१८॥"
        ]
      }
    ],
