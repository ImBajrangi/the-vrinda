[
  {
    "id": "valmiki-ramayana-6-sarga-38-shlok-2",
    "collectionId": "valmiki-ramayana",
    "index": 12394,
    "titleDevanagari": "वाल्मीकि रामायण, युद्धकाण्ड, सर्ग 38, श्लोक 2",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-6-sarga-38-shlok-2",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "स तु कृत्वा सुवेलस्य मतिमारोहणं प्रति।",
          "लक्ष्मणानुगतो रामः सुग्रीवमिदमब्रवीत्॥१॥",
          "विभीषणं च धर्मज्ञमनुरक्तं निशाचरम्।",
          "मन्त्रज्ञं च विधिज्ञं च श्लक्ष्णया परया गिरा॥२॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-38",
    "chapterName": "युद्धकाण्ड, सर्ग 38",
    "verseNumber": 2
  },
  {
    "id": "valmiki-ramayana-6-sarga-38-shlok-3",
    "collectionId": "valmiki-ramayana",
    "index": 12395,
    "titleDevanagari": "वाल्मीकि रामायण, युद्धकाण्ड, सर्ग 38, श्लोक 3",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-6-sarga-38-shlok-3",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "सुवेलं साधु शैलेन्द्रमिमं धातुशतैश्चितम्।",
          "अध्यारोहामहे सर्वे वत्स्यामोऽत्र निशामिमाम्॥३॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-38",
    "chapterName": "युद्धकाण्ड, सर्ग 38",
    "verseNumber": 3
  },
  {
    "id": "valmiki-ramayana-6-sarga-38-shlok-4",
    "collectionId": "valmiki-ramayana",
    "index": 12396,
    "titleDevanagari": "वाल्मीकि रामायण, युद्धकाण्ड, सर्ग 38, श्लोक 4",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-6-sarga-38-shlok-4",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "लङ्कां चालोकयिष्यामो निलयं तस्य रक्षसः।",
          "येन मे मरणान्ताय हृता भार्या दुरात्मना॥४॥",
          "येन धर्मो न विज्ञातो न वृत्तं न कुलं तथा।",
          "राक्षस्या नीचया बुद्ध्या येन तद् गर्हितं कृतम्॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-38",
    "chapterName": "युद्धकाण्ड, सर्ग 38",
    "verseNumber": 4
  },
  {
    "id": "valmiki-ramayana-6-sarga-38-shlok-6",
    "collectionId": "valmiki-ramayana",
    "index": 12397,
    "titleDevanagari": "वाल्मीकि रामायण, युद्धकाण्ड, सर्ग 38, श्लोक 6",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-6-sarga-38-shlok-6",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "तस्मिन् मे वर्तते रोषः कीर्तिते राक्षसाधमे।",
          "यस्यापराधान्नीचस्य वधं द्रक्ष्यामि रक्षसाम्॥६॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-38",
    "chapterName": "युद्धकाण्ड, सर्ग 38",
    "verseNumber": 6
  },
  {
    "id": "valmiki-ramayana-6-sarga-38-shlok-7",
    "collectionId": "valmiki-ramayana",
    "index": 12398,
    "titleDevanagari": "वाल्मीकि रामायण, युद्धकाण्ड, सर्ग 38, श्लोक 7",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-6-sarga-38-shlok-7",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "एको हि कुरुते पापं कालपाशवशं गतः।",
          "नीचेनात्मापचारेण कुलं तेन विनश्यति॥७॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-38",
    "chapterName": "युद्धकाण्ड, सर्ग 38",
    "verseNumber": 7
  },
  {
    "id": "valmiki-ramayana-6-sarga-38-shlok-8",
    "collectionId": "valmiki-ramayana",
    "index": 12399,
    "titleDevanagari": "वाल्मीकि रामायण, युद्धकाण्ड, सर्ग 38, श्लोक 8",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-6-sarga-38-shlok-8",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "एवं सम्मन्त्रयन् नेव सक्रोधो रावणं प्रति।",
          "रामः सुवेलं वासाय चित्रसानुमुपारुहत्॥८॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-38",
    "chapterName": "युद्धकाण्ड, सर्ग 38",
    "verseNumber": 8
  },
  {
    "id": "valmiki-ramayana-6-sarga-38-shlok-9",
    "collectionId": "valmiki-ramayana",
    "index": 12400,
    "titleDevanagari": "वाल्मीकि रामायण, युद्धकाण्ड, सर्ग 38, श्लोक 9",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-6-sarga-38-shlok-9",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "पृष्ठतो लक्ष्मणश्चैनमन्वगच्छत् समाहितः।",
          "सशरं चापमुद्यम्य सुमहद्रिक्रमे रतः॥९॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-38",
    "chapterName": "युद्धकाण्ड, सर्ग 38",
    "verseNumber": 9
  },
  {
    "id": "valmiki-ramayana-6-sarga-38-shlok-13",
    "collectionId": "valmiki-ramayana",
    "index": 12401,
    "titleDevanagari": "वाल्मीकि रामायण, युद्धकाण्ड, सर्ग 38, श्लोक 13",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-6-sarga-38-shlok-13",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "तमन्वारोहत् सुग्रीवः सामात्यः सविभीषणः।",
          "हनुमानङ्गदो नीलो मैन्दो द्विविद एव च॥१०॥",
          "गजो गवाक्षो गवयः शरभो गन्धमादनः।",
          "पनसः कुमुदश्चैव हरो रम्भश्च यूथपः॥११॥",
          "जाम्बवांश्च सुषेणश्च ऋषभश्च महामतिः।",
          "दुर्मुखश्च महातेजास्तथा शतवलिः कपिः॥१२॥",
          "एते चान्ये च बहवो वानराः शीघ्रगामिनः।",
          "ते वायुवेगप्रवणास्तं गिरिं गिरिचारिणः॥१३॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-38",
    "chapterName": "युद्धकाण्ड, सर्ग 38",
    "verseNumber": 13
  },
  {
