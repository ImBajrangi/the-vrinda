    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-6-sarga-38-shlok-14",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "अध्यारोहन्त शतशः सुवेलं यत्र राघवः।",
          "ते त्वदीर्पण कालेन गिरिमारुह्य सर्वतः॥१४॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-38",
    "chapterName": "युद्धकाण्ड, सर्ग 38",
    "verseNumber": 14
  },
  {
