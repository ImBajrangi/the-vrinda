    "titleDevanagari": "वाल्मीकि रामायण, युद्धकाण्ड, सर्ग 38, श्लोक 15",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-6-sarga-38-shlok-15",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "ददृशुः शिखरे तस्य विषक्तामिव खे पुरीम्।",
          "तां शुभां प्रवरद्वारां प्राकारवरशोभिताम्॥१५॥",
          "लङ्कां राक्षससम्पूर्णां ददृशुर्हरियूथपाः।"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-38",
    "chapterName": "युद्धकाण्ड, सर्ग 38",
    "verseNumber": 15
  },
  {
    "id": "valmiki-ramayana-6-sarga-38-shlok-17",
    "collectionId": "valmiki-ramayana",
    "index": 12404,
    "titleDevanagari": "वाल्मीकि रामायण, युद्धकाण्ड, सर्ग 38, श्लोक 17",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-6-sarga-38-shlok-17",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "प्राकारवरसंस्थैश्च तथा नीलैश्च राक्षसैः॥१६॥",
          "ददृशुस्ते हरिश्रेष्ठाः प्राकारमपरं कृतम्॥१७॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-38",
    "chapterName": "युद्धकाण्ड, सर्ग 38",
    "verseNumber": 17
  },
  {
