    "slug": "valmiki-ramayana-1-sarga-51-shlok-8",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "अपि मे गुरुणा रामः पूजितः कुशिकात्मज।",
          "इहागतो महातेजाः पूजां प्राप्य महात्मनः॥८॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-51",
    "chapterName": "बालकाण्ड, सर्ग 51",
    "verseNumber": 8
  },
  {
