    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 51, श्लोक 1",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-51-shlok-1-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "इत्युक्त्वा हनुमांस्तत्र चीरकृष्णाजिनाम्बराम्।",
          "अब्रवीत् तां महाभागां तापसी धर्मचारिणीम्॥१॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-51",
    "chapterName": "बालकाण्ड, सर्ग 51",
    "verseNumber": 1
  },
  {
    "id": "valmiki-ramayana-1-sarga-51-shlok-2",
    "collectionId": "valmiki-ramayana",
    "index": 2299,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 51, श्लोक 2",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-51-shlok-2",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "गौतमस्य सुतो ज्येष्ठस्तपसा द्योतितप्रभः।",
          "रामसंदर्शनादेव परं विस्मयमागतः॥२॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-51",
    "chapterName": "बालकाण्ड, सर्ग 51",
    "verseNumber": 2
  },
  {
    "id": "valmiki-ramayana-1-sarga-51-shlok-3",
    "collectionId": "valmiki-ramayana",
    "index": 2300,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 51, श्लोक 3",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-51-shlok-3",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "एतौ निषण्णौ सम्प्रेक्ष्य शतानन्दो नृपात्मजौ।",
          "सुखासीनौ मुनिश्रेष्ठं विश्वामित्रमथाब्रवीत्॥३॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-51",
    "chapterName": "बालकाण्ड, सर्ग 51",
    "verseNumber": 3
  },
  {
    "id": "valmiki-ramayana-1-sarga-51-shlok-4-1",
    "collectionId": "valmiki-ramayana",
    "index": 2301,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 51, श्लोक 4",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-51-shlok-4-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "इदं प्रविष्टाः सहसा बिलं तिमिरसंवृतम्।",
          "क्षुत्पिपासापरिश्रान्ताः परिखिन्नाश्च सर्वशः॥२॥",
          "महद् धरण्या विवरं प्रविष्टाः स्म पिपासिताः।",
          "इमांस्त्वेवंविधान् भावान् विविधानद्भुतोपमान्॥",
          "३॥",
          "दृष्ट्वा वयं प्रव्यथिताः सम्भ्रान्ता नष्टचेतसः।",
          "कस्यैते काञ्चना वृक्षास्तरुणादित्यसंनिभाः॥४॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-51",
    "chapterName": "बालकाण्ड, सर्ग 51",
    "verseNumber": 4
  },
  {
    "id": "valmiki-ramayana-1-sarga-51-shlok-5-1",
    "collectionId": "valmiki-ramayana",
    "index": 2302,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 51, श्लोक 5",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-51-shlok-5-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "शुचीन्यभ्यवहाराणि मूलानि च फलानि च।",
          "काञ्चनानि विमानानि राजतानि गृहाणि च॥५॥",
          "तपनीयगवाक्षाणि मणिजालावृतानि च।",
          "पुष्पिताः फलवन्तश्च पुण्याः सुरभिगन्धयः॥६॥",
          "इमे जाम्बूनदमयाः पादपाः कस्य तेजसा।"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-51",
    "chapterName": "बालकाण्ड, सर्ग 51",
    "verseNumber": 5
  },
  {
    "id": "valmiki-ramayana-1-sarga-51-shlok-6",
    "collectionId": "valmiki-ramayana",
    "index": 2303,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 51, श्लोक 6",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-51-shlok-6",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "अपि रामाय कथितं यद् वृत्तं तत् पुरातनम्।",
          "मम मातुर्महातेजो देवेन दुरनुष्ठितम्॥६॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-51",
    "chapterName": "बालकाण्ड, सर्ग 51",
    "verseNumber": 6
  },
  {
    "id": "valmiki-ramayana-1-sarga-51-shlok-7-1",
    "collectionId": "valmiki-ramayana",
    "index": 2304,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 51, श्लोक 7",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-51-shlok-7-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "काञ्चनानि च पद्मानि जातानि विमले जले॥७॥",
          "कथं मत्स्याश्च सौवर्णा दृश्यन्ते सह कच्छपैः।",
          "आत्मनस्त्वनुभावाद् वा कस्य चैतत्तपोबलम्॥८॥",
          "अजानतां नः सर्वेषां सर्वमाख्यातुमर्हसि।"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-51",
    "chapterName": "बालकाण्ड, सर्ग 51",
    "verseNumber": 7
  },
  {
    "id": "valmiki-ramayana-1-sarga-51-shlok-8",
    "collectionId": "valmiki-ramayana",
    "index": 2305,
