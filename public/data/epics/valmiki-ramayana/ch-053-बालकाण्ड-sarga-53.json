[
  {
    "id": "valmiki-ramayana-1-sarga-53-shlok-1",
    "collectionId": "valmiki-ramayana",
    "index": 2354,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 53, श्लोक 1",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-53-shlok-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "ततस्ते ददृशुर्घोरं सागरं वरुणालयम्।",
          "अपारमभिगर्जन्तं घोरैरूर्मिभिराकुलम्॥१॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-53",
    "chapterName": "बालकाण्ड, सर्ग 53",
    "verseNumber": 1
  },
  {
    "id": "valmiki-ramayana-1-sarga-53-shlok-2-1",
    "collectionId": "valmiki-ramayana",
    "index": 2355,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 53, श्लोक 2",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-53-shlok-2-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "मयस्य मायाविहितं गिरिदुर्गं विचिन्वताम्।",
          "तेषां मासो व्यतिक्रान्तो यो राज्ञा समयः कृतः॥२॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-53",
    "chapterName": "बालकाण्ड, सर्ग 53",
    "verseNumber": 2
  },
  {
    "id": "valmiki-ramayana-1-sarga-53-shlok-3-1",
    "collectionId": "valmiki-ramayana",
    "index": 2356,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 53, श्लोक 3",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-53-shlok-3-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "विन्ध्यस्य तु गिरेः पादे सम्प्रपुष्पितपादपे।",
          "उपविश्य महात्मानश्चिन्तामापेदिरे तदा ॥३॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-53",
    "chapterName": "बालकाण्ड, सर्ग 53",
    "verseNumber": 3
  },
  {
    "id": "valmiki-ramayana-1-sarga-53-shlok-4-1",
    "collectionId": "valmiki-ramayana",
    "index": 2357,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 53, श्लोक 4",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-53-shlok-4-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "ततः पुष्पातिभाराग्राल्लताशतसमावृतान्।",
          "द्रुमान् वासन्तिकान् दृष्ट्वा बभूवुर्भयशङ्किताः॥४॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-53",
    "chapterName": "बालकाण्ड, सर्ग 53",
    "verseNumber": 4
  },
  {
    "id": "valmiki-ramayana-1-sarga-53-shlok-5",
    "collectionId": "valmiki-ramayana",
    "index": 2358,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 53, श्लोक 5",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-53-shlok-5",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "ते वसन्तमनुप्राप्तं प्रतिवेद्य परस्परम्।",
          "नष्टसंदेशकालार्था निपेतुर्धरणीतले॥५॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-53",
    "chapterName": "बालकाण्ड, सर्ग 53",
    "verseNumber": 5
  },
  {
    "id": "valmiki-ramayana-1-sarga-53-shlok-6",
    "collectionId": "valmiki-ramayana",
    "index": 2359,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 53, श्लोक 6",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-53-shlok-6",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "विश्वामित्रो हि राजर्षिर्हृष्टपुष्टस्तदाभवत्।",
          "सान्तःपुरवरो राजा सब्राह्मणपुरोहितः॥६॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-53",
    "chapterName": "बालकाण्ड, सर्ग 53",
    "verseNumber": 6
  },
  {
    "id": "valmiki-ramayana-1-sarga-53-shlok-7-1",
    "collectionId": "valmiki-ramayana",
    "index": 2360,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 53, श्लोक 7",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-53-shlok-7-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "ततस्तान् कपिवृद्धांश्च शिष्टांश्चैव वनौकसः।",
          "वाचा मधुरयाऽऽभाष्य यथावदनुमान्य च॥६॥",
          "स तु सिंहवृषस्कन्धः पीनायतभुजः कपिः।",
          "युवराजो महाप्राज्ञ अङ्गदो वाक्यमब्रवीत्॥७॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-53",
    "chapterName": "बालकाण्ड, सर्ग 53",
    "verseNumber": 7
  },
  {
    "id": "valmiki-ramayana-1-sarga-53-shlok-8",
    "collectionId": "valmiki-ramayana",
    "index": 2361,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 53, श्लोक 8",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-53-shlok-8",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "पूजितोऽहं त्वया ब्रह्मन् पूजाहेण सुसत्कृतः।",
          "श्रूयतामभिधास्यामि वाक्यं वाक्यविशारद॥८॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-53",
    "chapterName": "बालकाण्ड, सर्ग 53",
    "verseNumber": 8
  },
  {
    "id": "valmiki-ramayana-1-sarga-53-shlok-9",
    "collectionId": "valmiki-ramayana",
    "index": 2362,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 53, श्लोक 9",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-53-shlok-9",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "शासनात् कपिराजस्य वयं सर्वे विनिर्गताः।",
          "मासः पूर्णो बिलस्थानां हरयः किं न बुध्यत॥८॥",
          "वयमाश्वयुजे मासि कालसंख्याव्यवस्थिताः।",
          "प्रस्थिताः सोऽपि चातीतः किमतः कार्यमुत्तरम्॥९॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-53",
    "chapterName": "बालकाण्ड, सर्ग 53",
    "verseNumber": 9
  },
  {
    "id": "valmiki-ramayana-1-sarga-53-shlok-10",
    "collectionId": "valmiki-ramayana",
    "index": 2363,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 53, श्लोक 10",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-53-shlok-10",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "भवन्तः प्रत्ययं प्राप्ता नीतिमार्गविशारदाः।",
          "हितेष्वभिरता भर्तुर्निसृष्टाः सर्वकर्मसु॥१०॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-53",
    "chapterName": "बालकाण्ड, सर्ग 53",
    "verseNumber": 10
  },
  {
    "id": "valmiki-ramayana-1-sarga-53-shlok-12",
    "collectionId": "valmiki-ramayana",
    "index": 2364,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 53, श्लोक 12",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-53-shlok-12",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "कर्मस्वप्रतिमाः सर्वे दिक्षु विश्रुतपौरुषाः।",
          "मां पुरस्कृत्य निर्याताः पिङ्गाक्षप्रतिचोदिताः॥११॥",
          "इदानीमकृतार्थानां मर्तव्यं नात्र संशयः।",
          "हरिराजस्य संदेशमकृत्वा कः सुखी भवेत्॥१२॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-53",
    "chapterName": "बालकाण्ड, सर्ग 53",
    "verseNumber": 12
  },
  {
    "id": "valmiki-ramayana-1-sarga-53-shlok-13",
    "collectionId": "valmiki-ramayana",
    "index": 2365,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 53, श्लोक 13",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-53-shlok-13",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "अस्मिन्नतीते काले तु सुग्रीवेण कृते स्वयम्।",
          "प्रायोपवेशनं युक्तं सर्वेषां च वनौकसाम्॥१३॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-53",
    "chapterName": "बालकाण्ड, सर्ग 53",
    "verseNumber": 13
  },
  {
    "id": "valmiki-ramayana-1-sarga-53-shlok-14",
    "collectionId": "valmiki-ramayana",
    "index": 2366,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 53, श्लोक 14",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-53-shlok-14",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "तीक्ष्णः प्रकृत्या सुग्रीवः स्वामिभावे व्यवस्थितः।",
          "न क्षमिष्यति नः सर्वानपराधकृतो गतान्॥१४॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-53",
    "chapterName": "बालकाण्ड, सर्ग 53",
    "verseNumber": 14
  },
  {
    "id": "valmiki-ramayana-1-sarga-53-shlok-15",
    "collectionId": "valmiki-ramayana",
    "index": 2367,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 53, श्लोक 15",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-53-shlok-15",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "अप्रवृत्तौ च सीतायाः पापमेव करिष्यति।",
          "तस्मात् क्षममिहाद्यैव गन्तुं प्रायोपवेशनम्॥१५॥",
          "त्यक्त्वा पुत्रांश्च दारांश्च धनानि च गृहाणि च।"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-53",
    "chapterName": "बालकाण्ड, सर्ग 53",
    "verseNumber": 15
  },
  {
    "id": "valmiki-ramayana-1-sarga-53-shlok-16",
    "collectionId": "valmiki-ramayana",
    "index": 2368,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 53, श्लोक 16",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-53-shlok-16",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "ध्रुवं नो हिंसते राजा सर्वान् प्रतिगतानितः॥१६॥",
          "वधेनाप्रतिरूपेण श्रेयान् मृत्युरिहैव नः।"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-53",
    "chapterName": "बालकाण्ड, सर्ग 53",
    "verseNumber": 16
  },
  {
    "id": "valmiki-ramayana-1-sarga-53-shlok-17-1",
    "collectionId": "valmiki-ramayana",
    "index": 2369,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 53, श्लोक 17",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-53-shlok-17-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "न चाहं यौवराज्येन सुग्रीवेणाभिषेचितः॥१७॥",
          "नरेन्द्रेणाभिषिक्तोऽस्मि रामेणाक्लिष्टकर्मणा।"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-53",
    "chapterName": "बालकाण्ड, सर्ग 53",
    "verseNumber": 17
  },
  {
    "id": "valmiki-ramayana-1-sarga-53-shlok-18",
    "collectionId": "valmiki-ramayana",
    "index": 2370,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 53, श्लोक 18",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-53-shlok-18",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "स पूर्वं बद्धवैरो मां राजा दृष्ट्वा व्यतिक्रमम्॥१८॥",
          "घातयिष्यति दण्डेन तीक्ष्णेन कृतनिश्चयः।"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-53",
    "chapterName": "बालकाण्ड, सर्ग 53",
    "verseNumber": 18
  },
  {
    "id": "valmiki-ramayana-1-sarga-53-shlok-19",
    "collectionId": "valmiki-ramayana",
    "index": 2371,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 53, श्लोक 19",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-53-shlok-19",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "किं मे सुहृद्भिर्व्यसनं पश्यद्भिर्जीवितान्तरे।",
          "इहैव प्रायमासिष्ये पुण्ये सागररोधसि॥१९॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-53",
    "chapterName": "बालकाण्ड, सर्ग 53",
    "verseNumber": 19
  },
  {
    "id": "valmiki-ramayana-1-sarga-53-shlok-20-1",
    "collectionId": "valmiki-ramayana",
    "index": 2372,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 53, श्लोक 20",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-53-shlok-20-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "एतच्छ्रुत्वा कुमारेण युवराजेन भाषितम्।",
          "सर्वे ते वानरश्रेष्ठाः करुणं वाक्यमब्रुवन्॥२०॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-53",
    "chapterName": "बालकाण्ड, सर्ग 53",
    "verseNumber": 20
  },
  {
    "id": "valmiki-ramayana-1-sarga-53-shlok-21",
    "collectionId": "valmiki-ramayana",
    "index": 2373,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 53, श्लोक 21",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-53-shlok-21",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "यावदिच्छसि रत्नानि हिरण्यं वा द्विजोत्तम।",
          "तावद् ददामि ते सर्वं दीयतां शबला मम॥२१॥",
          "‘द्विजश्रेष्ठ! इनके अतिरिक्त भी आप जितने रत्न या सुवर्ण लेना चाहें, वह सब आपको देनेके लिये मैं तैयार हूँ; किंतु यह चितकबरी गाय मुझे दे दीजिये’।२१॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-53",
    "chapterName": "बालकाण्ड, सर्ग 53",
    "verseNumber": 21
