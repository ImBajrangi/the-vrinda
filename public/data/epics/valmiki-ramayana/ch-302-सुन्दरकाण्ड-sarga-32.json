[
  {
    "id": "valmiki-ramayana-5-sarga-32-shlok-2",
    "collectionId": "valmiki-ramayana",
    "index": 9929,
    "titleDevanagari": "वाल्मीकि रामायण, सुन्दरकाण्ड, सर्ग 32, श्लोक 2",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-5-sarga-32-shlok-2",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "ततः शाखान्तरे लीनं दृष्ट्वा चलितमानसा।",
          "वेष्टितार्जुनवस्त्रं तं विद्युत्संघातपिंगलम्॥१॥",
          "सा ददर्श कपिं तत्र प्रश्रितं प्रियवादिनम्।",
          "फुल्लाशोकोत्कराभासं तप्तचामीकरेक्षणम्॥२॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-32",
    "chapterName": "सुन्दरकाण्ड, सर्ग 32",
    "verseNumber": 2
  },
  {
    "id": "valmiki-ramayana-5-sarga-32-shlok-3",
    "collectionId": "valmiki-ramayana",
    "index": 9930,
    "titleDevanagari": "वाल्मीकि रामायण, सुन्दरकाण्ड, सर्ग 32, श्लोक 3",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-5-sarga-32-shlok-3",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "साथ दृष्ट्वा हरिश्रेष्ठं विनीतवदवस्थितम्।",
          "मैथिली चिन्तयामास विस्मयं परमं गता॥३॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-32",
    "chapterName": "सुन्दरकाण्ड, सर्ग 32",
    "verseNumber": 3
  },
  {
    "id": "valmiki-ramayana-5-sarga-32-shlok-4",
