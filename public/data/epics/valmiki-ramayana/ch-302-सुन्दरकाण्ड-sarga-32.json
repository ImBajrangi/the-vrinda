    "slug": "valmiki-ramayana-5-sarga-32-shlok-10",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "स्वप्नो हि नायं नहि मेऽस्ति निद्रा शोकेन दुःखेन च पीडितायाः।",
          "सुखं हि मे नास्ति यतो विहीना तेनेन्दुपूर्णप्रतिमाननेन॥१०॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-32",
    "chapterName": "सुन्दरकाण्ड, सर्ग 32",
    "verseNumber": 10
  },
  {
