    "titleDevanagari": "वाल्मीकि रामायण, सुन्दरकाण्ड, सर्ग 32, श्लोक 4",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-5-sarga-32-shlok-4",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "अहो भीममिदं सत्त्वं वानरस्य दुरासदम्।",
          "दुर्निरीक्ष्यमिदं मत्वा पुनरेव मुमोह सा॥४॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-32",
    "chapterName": "सुन्दरकाण्ड, सर्ग 32",
    "verseNumber": 4
  },
  {
    "id": "valmiki-ramayana-5-sarga-32-shlok-5",
    "collectionId": "valmiki-ramayana",
    "index": 9932,
    "titleDevanagari": "वाल्मीकि रामायण, सुन्दरकाण्ड, सर्ग 32, श्लोक 5",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-5-sarga-32-shlok-5",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "विललाप भृशं सीता करुणं भयमोहिता।",
          "राम रामेति दुःखार्ता लक्ष्मणेति च भामिनी॥५॥",
          "रुरोद सहसा सीता मन्दमन्दस्वरा सती।",
          "साथ दृष्ट्वा हरिवरं विनीतवदुपागतम्।",
          "मैथिली चिन्तयामास स्वप्नोऽयमिति भामिनी॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-32",
    "chapterName": "सुन्दरकाण्ड, सर्ग 32",
    "verseNumber": 5
  },
  {
    "id": "valmiki-ramayana-5-sarga-32-shlok-7",
    "collectionId": "valmiki-ramayana",
