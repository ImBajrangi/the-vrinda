    "slug": "valmiki-ramayana-5-sarga-32-shlok-9",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "स्वप्नो मयायं विकृतोऽद्य दृष्टः शाखामृगः शास्त्रगणैर्निषिद्धः।",
          "स्वस्त्यस्तु रामाय सलक्ष्मणाय तथा पितुर्मे जनकस्य राज्ञः॥९॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-32",
    "chapterName": "सुन्दरकाण्ड, सर्ग 32",
    "verseNumber": 9
  },
  {
