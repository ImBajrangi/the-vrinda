    "slug": "valmiki-ramayana-5-sarga-32-shlok-7",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "सा वीक्षमाणा पृथुभुग्नवक्त्रं शाखामृगेन्द्रस्य यथोक्तकारम्।",
          "ददर्श पिंगप्रवरं महार्ह वातात्मजं बुद्धिमतां वरिष्ठम्॥७॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-32",
    "chapterName": "सुन्दरकाण्ड, सर्ग 32",
    "verseNumber": 7
  },
  {
    "id": "valmiki-ramayana-5-sarga-32-shlok-8",
    "collectionId": "valmiki-ramayana",
    "index": 9934,
    "titleDevanagari": "वाल्मीकि रामायण, सुन्दरकाण्ड, सर्ग 32, श्लोक 8",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-5-sarga-32-shlok-8",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "सा तं समीक्ष्यैव भृशं विपन्ना गतासुकल्पेव बभूव सीता।",
          "चिरेण संज्ञां प्रतिलभ्य चैवं विचिन्तयामास विशालनेत्रा॥८॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-32",
    "chapterName": "सुन्दरकाण्ड, सर्ग 32",
    "verseNumber": 8
  },
  {
