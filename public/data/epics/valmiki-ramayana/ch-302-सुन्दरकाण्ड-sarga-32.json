    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-5-sarga-32-shlok-12",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "अहं हि तस्याद्य मनोभवेन सम्पीडिता तदगतसर्वभावा।",
          "विचिन्तयन्ती सततं तमेव तथैव पश्यामि तथा शृणोमि॥१२॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-32",
    "chapterName": "सुन्दरकाण्ड, सर्ग 32",
    "verseNumber": 12
  },
