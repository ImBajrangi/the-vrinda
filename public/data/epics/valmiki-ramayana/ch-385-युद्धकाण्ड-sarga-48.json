    "titleDevanagari": "वाल्मीकि रामायण, युद्धकाण्ड, सर्ग 48, श्लोक 1",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-6-sarga-48-shlok-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "भर्तारं निहतं दृष्ट्वा लक्ष्मणं च महाबलम्।",
          "विललाप भृशं सीता करुणं शोककर्शिता॥१॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-48",
    "chapterName": "युद्धकाण्ड, सर्ग 48",
    "verseNumber": 1
  },
  {
    "id": "valmiki-ramayana-6-sarga-48-shlok-2",
    "collectionId": "valmiki-ramayana",
    "index": 12762,
    "titleDevanagari": "वाल्मीकि रामायण, युद्धकाण्ड, सर्ग 48, श्लोक 2",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-6-sarga-48-shlok-2",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "ऊचुर्लाक्षणिका ये मां पुत्रिण्यविधवेति च।",
          "तेऽद्य सर्वे हते रामे ज्ञानिनोऽनृतवादिनः॥२॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-48",
    "chapterName": "युद्धकाण्ड, सर्ग 48",
    "verseNumber": 2
  },
  {
    "id": "valmiki-ramayana-6-sarga-48-shlok-3",
