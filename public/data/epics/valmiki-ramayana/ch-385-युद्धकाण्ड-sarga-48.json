    "slug": "valmiki-ramayana-6-sarga-48-shlok-8",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "सत्यनामानि पद्मानि स्त्रीणामुक्तानि लक्षणैः।",
          "तान्यद्य निहते रामे वितथानि भवन्ति मे॥८॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-48",
    "chapterName": "युद्धकाण्ड, सर्ग 48",
    "verseNumber": 8
  },
