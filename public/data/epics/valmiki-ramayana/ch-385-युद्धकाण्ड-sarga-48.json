    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "स्तनौ चाविरलौ पीनौ मामको मग्नचूचुकौ।",
          "मग्ना चोत्सेधनी नाभिः पावोरस्कं च मे चितम्॥११॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-48",
    "chapterName": "युद्धकाण्ड, सर्ग 48",
