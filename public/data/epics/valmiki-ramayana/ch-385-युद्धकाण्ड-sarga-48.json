    "slug": "valmiki-ramayana-6-sarga-48-shlok-3",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "यज्वनो महिषीं ये मामूचुः पत्नी च सत्रिणः।",
          "तेऽद्य सर्वे हते रामे ज्ञानिनोऽनृतवादिनः॥३॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-48",
    "chapterName": "युद्धकाण्ड, सर्ग 48",
    "verseNumber": 3
  },
  {
