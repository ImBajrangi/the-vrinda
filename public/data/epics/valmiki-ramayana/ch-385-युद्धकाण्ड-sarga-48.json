    "slug": "valmiki-ramayana-6-sarga-48-shlok-7",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "वैधव्यं यान्ति यैर्नार्योऽलक्षणैर्भाग्यदुर्लभाः।",
          "नात्मनस्तानि पश्यामि पश्यन्ती हतलक्षणा॥७॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-48",
    "chapterName": "युद्धकाण्ड, सर्ग 48",
    "verseNumber": 7
  },
