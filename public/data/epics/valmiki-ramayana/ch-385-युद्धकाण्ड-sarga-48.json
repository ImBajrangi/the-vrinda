    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "शले नेत्रे करौ पादौ गुल्फावूरू समौ चितौ।",
          "अनुवृत्तनखाः स्निग्धाः समाश्चाङ्गुलयो मम॥१०॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-48",
    "chapterName": "युद्धकाण्ड, सर्ग 48",
    "verseNumber": 10
