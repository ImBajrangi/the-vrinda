    "slug": "valmiki-ramayana-6-sarga-48-shlok-4",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "वीरपार्थिवपत्नीनां ये विदुर्भर्तृपूजिताम्।",
          "तेऽद्य सर्वे हते रामे ज्ञानिनोऽनृतवादिनः॥४॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-48",
    "chapterName": "युद्धकाण्ड, सर्ग 48",
    "verseNumber": 4
  },
  {
    "id": "valmiki-ramayana-6-sarga-48-shlok-5",
    "collectionId": "valmiki-ramayana",
    "index": 12765,
    "titleDevanagari": "वाल्मीकि रामायण, युद्धकाण्ड, सर्ग 48, श्लोक 5",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-6-sarga-48-shlok-5",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "ऊचुः संश्रवणे ये मां द्विजाः कार्तान्तिकाः",
          "शुभाम्। तेऽद्य सर्वे हते रामे ज्ञानिनोऽनृतवादिनः॥५॥",
          "इमानि खलु पद्मानि पादयोर्वै कुलस्त्रियः।",
          "आधिराज्येऽभिषिच्यन्ते नरेन्द्रैः पतिभिः सह ॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-48",
    "chapterName": "युद्धकाण्ड, सर्ग 48",
    "verseNumber": 5
  },
  {
    "id": "valmiki-ramayana-6-sarga-48-shlok-7",
