    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "केशाः सूक्ष्माः समा नीला भ्रवौ चासंहते मम।",
          "वृत्ते चारोमके जड़े दन्ताश्चाविरला मम॥९॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-48",
    "chapterName": "युद्धकाण्ड, सर्ग 48",
    "verseNumber": 9
  },
