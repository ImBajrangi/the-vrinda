    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-6-sarga-20-shlok-8",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "शार्दूलस्य वचः श्रुत्वा रावणो राक्षसेश्वरः।",
          "उवाच सहसा व्यग्रः सम्प्रधार्यार्थमात्मनः।",
          "शुकं साधु तदा रक्षो वाक्यमर्थविदां वरम्॥८॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-20",
    "chapterName": "युद्धकाण्ड, सर्ग 20",
    "verseNumber": 8
  },
  {
