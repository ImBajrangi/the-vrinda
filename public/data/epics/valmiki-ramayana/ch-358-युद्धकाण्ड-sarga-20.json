        "stanzaNumber": 1,
        "linesDevanagari": [
          "नहीयं हरिभिर्लङ्का प्राप्तुं शक्या कथंचन।",
          "देवैरपि सगन्धर्वैः किं पुनर्नरवानरैः॥१२॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-20",
    "chapterName": "युद्धकाण्ड, सर्ग 20",
    "verseNumber": 12
  },
