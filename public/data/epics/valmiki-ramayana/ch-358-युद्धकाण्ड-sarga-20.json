    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "तव दूता महाराज क्षिप्रमर्हन्ति वेदितुम्।",
          "उपप्रदानं सान्त्वं वा भेदो वात्र प्रयुज्यताम्॥७",
          "॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-20",
    "chapterName": "युद्धकाण्ड, सर्ग 20",
    "verseNumber": 7
  },
  {
