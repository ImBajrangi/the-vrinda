    "slug": "valmiki-ramayana-6-sarga-20-shlok-9",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "सुग्रीवं ब्रूहि गत्वाऽऽशु राजानं वचनान्मम।",
          "यथासंदेशमक्लीबं श्लक्ष्णया परया गिरा॥९॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-20",
    "chapterName": "युद्धकाण्ड, सर्ग 20",
    "verseNumber": 9
  },
  {
