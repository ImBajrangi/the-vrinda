    "slug": "valmiki-ramayana-6-sarga-20-shlok-6",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "एतौ सागरमासाद्य संनिविष्टौ महाद्युते॥५॥",
          "बलं चाकाशमावृत्य सर्वतो दशयोजनम्।",
          "तत्त्वभूतं महाराज क्षिप्रं वेदितुमर्हसि ॥६॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-20",
    "chapterName": "युद्धकाण्ड, सर्ग 20",
    "verseNumber": 6
  },
  {
