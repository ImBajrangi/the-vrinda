    "slug": "valmiki-ramayana-6-sarga-20-shlok-3",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "एष वै वानरौंघो लङ्कां समभिवर्तते॥३॥",
          "अगाधश्चाप्रमेयश्च द्वितीय इव सागरः।"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-20",
    "chapterName": "युद्धकाण्ड, सर्ग 20",
    "verseNumber": 3
