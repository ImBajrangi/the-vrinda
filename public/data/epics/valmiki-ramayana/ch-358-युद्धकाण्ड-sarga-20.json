    "slug": "valmiki-ramayana-6-sarga-20-shlok-14",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "स गत्वा दूरमध्वानमुपर्युपरि सागरम्।",
          "संस्थितो ह्यम्बरे वाक्यं सुग्रीवमिदमब्रवीत्॥१४॥",
          "सर्वमुक्तं यथाऽऽदिष्टं रावणेन दुरात्मना।"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-20",
    "chapterName": "युद्धकाण्ड, सर्ग 20",
    "verseNumber": 14
