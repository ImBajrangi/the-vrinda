    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "शयानः शरतल्पेऽस्मिन् सशोणितपरिस्रुतः।",
          "शरभूतस्ततो भासि भास्करोऽस्तमिव व्रजन्॥१५॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-49",
    "chapterName": "युद्धकाण्ड, सर्ग 49",
    "verseNumber": 15
  },
  {
