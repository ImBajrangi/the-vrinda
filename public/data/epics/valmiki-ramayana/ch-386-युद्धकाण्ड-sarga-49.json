    "titleDevanagari": "वाल्मीकि रामायण, युद्धकाण्ड, सर्ग 49, श्लोक 2",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-6-sarga-49-shlok-2",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "सर्वे ते वानर श्रेष्ठाः ससुग्रीवमहाबलाः।",
          "परिवार्य महात्मानौ तस्थुः शोकपरिप्लुताः॥२॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-49",
    "chapterName": "युद्धकाण्ड, सर्ग 49",
    "verseNumber": 2
  },
  {
    "id": "valmiki-ramayana-6-sarga-49-shlok-3",
    "collectionId": "valmiki-ramayana",
    "index": 12796,
    "titleDevanagari": "वाल्मीकि रामायण, युद्धकाण्ड, सर्ग 49, श्लोक 3",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-6-sarga-49-shlok-3",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "एतस्मिन्नन्तरे रामः प्रत्यबुध्यत वीर्यवान्।",
          "स्थिरत्वात् सत्त्वयोगाच्च शरैः संदानितोऽपि सन्॥३॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-49",
    "chapterName": "युद्धकाण्ड, सर्ग 49",
    "verseNumber": 3
  },
  {
    "id": "valmiki-ramayana-6-sarga-49-shlok-4",
    "collectionId": "valmiki-ramayana",
    "index": 12797,
    "titleDevanagari": "वाल्मीकि रामायण, युद्धकाण्ड, सर्ग 49, श्लोक 4",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-6-sarga-49-shlok-4",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "ततो दृष्ट्वा सरुधिरं निषण्णं गाढमर्पितम्।",
          "भ्रातरं दीनवदनं पर्यदेवयदातुरः॥४॥",
          "किं नु मे सीतया कार्यं लब्धया जीवितेन वा।",
          "शयानं योऽद्य पश्यामि भ्रातरं युधि निर्जितम्॥",
          "शक्या सीतासमा नारी मर्त्यलोके विचिन्वता।",
          "न लक्ष्मणसमो भ्राता सचिवः साम्परायिकः॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-49",
    "chapterName": "युद्धकाण्ड, सर्ग 49",
    "verseNumber": 4
  },
  {
    "id": "valmiki-ramayana-6-sarga-49-shlok-7",
    "collectionId": "valmiki-ramayana",
    "index": 12798,
    "titleDevanagari": "वाल्मीकि रामायण, युद्धकाण्ड, सर्ग 49, श्लोक 7",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-6-sarga-49-shlok-7",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "परित्यक्ष्याम्यहं प्राणान् वानराणां तु पश्यताम्।",
          "यदि पञ्चत्वमापन्नः सुमित्रानन्दवर्धनः॥७॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-49",
    "chapterName": "युद्धकाण्ड, सर्ग 49",
    "verseNumber": 7
  },
  {
    "id": "valmiki-ramayana-6-sarga-49-shlok-9",
    "collectionId": "valmiki-ramayana",
    "index": 12799,
    "titleDevanagari": "वाल्मीकि रामायण, युद्धकाण्ड, सर्ग 49, श्लोक 9",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-6-sarga-49-shlok-9",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "किं नु वक्ष्यामि कौसल्यां मातरं किं नु कैकयीम्।",
          "कथमम्बां सुमित्रां च पुत्रदर्शनलालसाम्॥८॥",
          "विवत्सां वेपमानां च वेपन्तीं कुररीमिव।",
          "कथमाश्वासयिष्यामि यदि यास्यामि तं विना॥९॥",
          "अयोध्या"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-49",
    "chapterName": "युद्धकाण्ड, सर्ग 49",
    "verseNumber": 9
  },
  {
    "id": "valmiki-ramayana-6-sarga-49-shlok-10",
    "collectionId": "valmiki-ramayana",
    "index": 12800,
    "titleDevanagari": "वाल्मीकि रामायण, युद्धकाण्ड, सर्ग 49, श्लोक 10",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-6-sarga-49-shlok-10",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "कथं वक्ष्यामि शत्रुघ्नं भरतं च यशस्विनम्।",
          "मया सह वनं यातो विना तेनाहमागतः॥१०॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-49",
    "chapterName": "युद्धकाण्ड, सर्ग 49",
    "verseNumber": 10
  },
  {
    "id": "valmiki-ramayana-6-sarga-49-shlok-11",
    "collectionId": "valmiki-ramayana",
    "index": 12801,
    "titleDevanagari": "वाल्मीकि रामायण, युद्धकाण्ड, सर्ग 49, श्लोक 11",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-6-sarga-49-shlok-11",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "उपालम्भं न शक्ष्यामि सोढ़मम्बासुमित्रया।",
          "इहैव देहं त्यक्ष्यामि नहि जीवितुमुत्सहे॥११॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-49",
    "chapterName": "युद्धकाण्ड, सर्ग 49",
    "verseNumber": 11
  },
  {
    "id": "valmiki-ramayana-6-sarga-49-shlok-12",
    "collectionId": "valmiki-ramayana",
    "index": 12802,
    "titleDevanagari": "वाल्मीकि रामायण, युद्धकाण्ड, सर्ग 49, श्लोक 12",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-6-sarga-49-shlok-12",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "धिङ्मां दुष्कृतकर्माणमनार्यं यत्कृते ह्यसौ।",
          "लक्ष्मणः पतितः शेते शरतल्पे गतासुवत्॥१२॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-49",
    "chapterName": "युद्धकाण्ड, सर्ग 49",
    "verseNumber": 12
  },
  {
