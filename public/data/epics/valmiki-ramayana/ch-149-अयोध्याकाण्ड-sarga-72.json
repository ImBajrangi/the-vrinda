    "slug": "valmiki-ramayana-2-sarga-72-shlok-3",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "स प्रविश्यैव धर्मात्मा स्वगृहं श्रीविवर्जितम्।",
          "भरतः प्रेक्ष्य जग्राह जनन्याश्चरणौ शुभौ॥३॥"
        ]
      }
    ],
    "chapterId": "अयोध्याकाण्ड-sarga-72",
