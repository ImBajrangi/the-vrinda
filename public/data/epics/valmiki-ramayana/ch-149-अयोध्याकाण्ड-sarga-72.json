    "slug": "valmiki-ramayana-2-sarga-72-shlok-2",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "अनुप्राप्तं तु तं दृष्ट्वा कैकेयी प्रोषितं सुतम्।",
          "उत्पपात तदा हृष्टा त्यक्त्वा सौवर्णमासनम्॥२॥"
        ]
      }
    ],
    "chapterId": "अयोध्याकाण्ड-sarga-72",
    "chapterName": "अयोध्याकाण्ड, सर्ग 72",
    "verseNumber": 2
  },
  {
