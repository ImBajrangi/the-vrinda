    "slug": "valmiki-ramayana-2-sarga-72-shlok-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "अपश्यंस्तु ततस्तत्र पितरं पितरालये।",
          "जगाम भरतो द्रष्टुं मातरं मातुरालये॥१॥"
        ]
      }
    ],
    "chapterId": "अयोध्याकाण्ड-sarga-72",
    "chapterName": "अयोध्याकाण्ड, सर्ग 72",
    "verseNumber": 1
  },
  {
