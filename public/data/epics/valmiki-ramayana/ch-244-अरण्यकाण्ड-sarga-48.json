    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "यस्य तत् पुष्पकं नाम विमानं कामगं शुभम्।",
          "वीर्यादावर्जितं भद्रे येन यामि विहायसम्॥६॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-48",
    "chapterName": "अरण्यकाण्ड, सर्ग 48",
    "verseNumber": 6
  },
