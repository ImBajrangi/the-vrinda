        "linesDevanagari": [
          "मम संजातरोषस्य मुखं दृष्ट्वैव मैथिलि।",
          "विद्रवन्ति परित्रस्ताः सुराः शक्रपुरोगमाः॥७॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-48",
    "chapterName": "अरण्यकाण्ड, सर्ग 48",
    "verseNumber": 7
  },
