    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "मद्भयार्तः परित्यज्य स्वमधिष्ठानमृद्धिमत्।",
          "कैलास पर्वतश्रेष्ठमध्यास्ते नरवाहनः॥५॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-48",
    "chapterName": "अरण्यकाण्ड, सर्ग 48",
    "verseNumber": 5
  },
