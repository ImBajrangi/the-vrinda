    "titleDevanagari": "वाल्मीकि रामायण, अरण्यकाण्ड, सर्ग 48, श्लोक 2",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-48-shlok-2",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "भ्राता वैश्रवणस्याहं सापत्नो वरवर्णिनि।",
          "रावणो नाम भद्रं ते दशग्रीवः प्रतापवान्॥२॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-48",
    "chapterName": "अरण्यकाण्ड, सर्ग 48",
    "verseNumber": 2
  },
  {
    "id": "valmiki-ramayana-3-sarga-48-shlok-4",
    "collectionId": "valmiki-ramayana",
    "index": 8047,
    "titleDevanagari": "वाल्मीकि रामायण, अरण्यकाण्ड, सर्ग 48, श्लोक 4",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-48-shlok-4",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "यस्य देवाः सगन्धर्वाः पिशाचपतगोरगाः।",
          "विद्रवन्ति सदा भीता मृत्योरिव सदा प्रजाः॥३॥",
          "येन वैश्रवणो भ्राता वैमात्राः कारणान्तरे।",
          "द्वन्द्वमासादितः क्रोधाद् रणे विक्रम्य निर्जितः॥ ४॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-48",
    "chapterName": "अरण्यकाण्ड, सर्ग 48",
    "verseNumber": 4
  },
  {
