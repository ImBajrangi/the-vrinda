      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "एकयामावशिष्टायां रात्र्यां प्रतिविबुध्य सः।",
          "अलंकारविधिं सम्यक् कारयामास वेश्मनः॥५॥"
        ]
      }
    ],
    "chapterId": "अयोध्याकाण्ड-sarga-6",
    "chapterName": "अयोध्याकाण्ड, सर्ग 6",
    "verseNumber": 5
  },
  {
