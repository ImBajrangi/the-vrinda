    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "तुष्टाव प्रणतश्चैव शिरसा मधुसूदनम्।",
          "विमलक्षौमसंवीतो वाचयामास स द्विजान्॥७॥"
        ]
      }
    ],
    "chapterId": "अयोध्याकाण्ड-sarga-6",
    "chapterName": "अयोध्याकाण्ड, सर्ग 6",
    "verseNumber": 7
  },
