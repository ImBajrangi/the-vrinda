    "slug": "valmiki-ramayana-2-sarga-6-shlok-6",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "॥ श्रीसीतारामचन्द्राभ्यां नमः॥",
          "श्रीमद्वाल्मीकीय रामायण",
          "अयोध्याकाण्डम्",
          "षष्ठः सर्गः (सर्ग 6)",
          "तत्र शृण्वन् सुखा वाचः सूतमागधवन्दिनाम्।",
          "पूर्वां संध्यामुपासीनो जजाप सुसमाहितः॥६॥",
          "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्येऽयोध्याकाण्डे षष्ठः सर्गः॥६॥"
        ]
      }
    ],
    "chapterId": "अयोध्याकाण्ड-sarga-6",
    "chapterName": "अयोध्याकाण्ड, सर्ग 6",
    "verseNumber": 6
  },
  {
