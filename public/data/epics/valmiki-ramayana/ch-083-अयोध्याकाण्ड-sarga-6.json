    "slug": "valmiki-ramayana-2-sarga-6-shlok-2",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "प्रगृह्य शिरसा पात्री हविषो विधिवत् ततः।",
          "महते दैवतायाज्यं जुहाव ज्वलितानले ॥२॥"
        ]
      }
    ],
    "chapterId": "अयोध्याकाण्ड-sarga-6",
    "chapterName": "अयोध्याकाण्ड, सर्ग 6",
    "verseNumber": 2
  },
  {
