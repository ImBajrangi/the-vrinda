    "slug": "valmiki-ramayana-2-sarga-6-shlok-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "गते पुरोहिते रामः स्नातो नियतमानसः।",
          "सह पत्न्या विशालाक्ष्या नारायणमुपागमत्॥१॥",
          "अयोध्या"
        ]
      }
    ],
    "chapterId": "अयोध्याकाण्ड-sarga-6",
    "chapterName": "अयोध्याकाण्ड, सर्ग 6",
    "verseNumber": 1
  },
