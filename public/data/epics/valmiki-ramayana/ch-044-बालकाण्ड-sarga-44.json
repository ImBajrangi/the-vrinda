    "slug": "valmiki-ramayana-1-sarga-44-shlok-3",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "न भूमौ नान्तरिक्षे वा नाम्बरे नामरालये।",
          "नाप्सु वा गतिसङ्गं ते पश्यामि हरिपुंगव॥३॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-44",
    "chapterName": "बालकाण्ड, सर्ग 44",
    "verseNumber": 3
  },
  {
