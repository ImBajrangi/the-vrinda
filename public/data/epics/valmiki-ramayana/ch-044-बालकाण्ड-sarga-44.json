      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "अतिबल बलमाश्रितस्तवाहं हरिवर विक्रम विक्रमैरनल्पैः।",
          "पवनसुत यथाधिगम्यते सा जनकसुता हनुमंस्तथा कुरुष्व॥१७॥"
        ]
      }
