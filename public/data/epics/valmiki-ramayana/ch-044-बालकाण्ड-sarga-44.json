        "stanzaNumber": 1,
        "linesDevanagari": [
          "गतिर्वेगश्च तेजश्च लाघवं च महाकपे।",
          "पितुस्ते सदृशं वीर मारुतस्य महौजसः॥५॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-44",
    "chapterName": "बालकाण्ड, सर्ग 44",
    "verseNumber": 5
  },
  {
