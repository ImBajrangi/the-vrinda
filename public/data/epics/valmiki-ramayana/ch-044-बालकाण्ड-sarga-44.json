      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "स तत् प्रकर्षन् हरिणां महद् बलं बभूव वीरः पवनात्मजः कपिः।",
          "गताम्बुदे व्योम्नि विशुद्धमण्डलः शशीव नक्षत्रगणोपशोभितः॥१६॥"
        ]
      }
