    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "अब्रवीच्च हनूमन्तं विक्रान्तमनिलात्मजम्।",
          "सुग्रीवः परमप्रीतः प्रभुः सर्ववनौकसाम्॥२॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-44",
    "chapterName": "बालकाण्ड, सर्ग 44",
    "verseNumber": 2
  },
  {
