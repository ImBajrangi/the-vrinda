    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "तेजसा वापि ते भूतं न समं भुवि विद्यते।",
          "तद यथा लभ्यते सीता तत्त्वमेवानुचिन्तय॥६॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-44",
    "chapterName": "बालकाण्ड, सर्ग 44",
    "verseNumber": 6
  },
