        "stanzaNumber": 1,
        "linesDevanagari": [
          "एष ते राम गंगाया विस्तरोऽभिहितो मया।",
          "स्वस्ति प्राप्नुहि भद्रं ते संध्याकालोऽतिवर्तते॥२०॥"
        ]
      }
