        "linesDevanagari": [
          "त्वय्येव हनुमन्नस्ति बलं बुद्धिः पराक्रमः।",
          "देशकालानुवृत्तिश्च नयश्च नयपण्डित ॥७॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-44",
    "chapterName": "बालकाण्ड, सर्ग 44",
    "verseNumber": 7
  },
