[
  {
    "id": "valmiki-ramayana-1-sarga-73-shlok-2",
    "collectionId": "valmiki-ramayana",
    "index": 2888,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 73, श्लोक 2",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-73-shlok-2",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "यस्मिंस्तु दिवसे राजा चक्रे गोदानमुत्तमम्।",
          "तस्मिंस्तु दिवसे वीरो युधाजित् समुपेयिवान्॥ १॥",
          "पुत्रः केकयराजस्य साक्षाद्भरतमातुलः।",
          "दृष्ट्वा पृष्ट्वा च कुशलं राजानमिदमब्रवीत्॥२॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-73",
    "chapterName": "बालकाण्ड, सर्ग 73",
    "verseNumber": 2
  },
  {
    "id": "valmiki-ramayana-1-sarga-73-shlok-4",
    "collectionId": "valmiki-ramayana",
    "index": 2889,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 73, श्लोक 4",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-73-shlok-4",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "केकयाधिपती राजा स्नेहात् कुशलमब्रवीत्।",
          "येषां कुशलकामोऽसि तेषां सम्प्रत्यनामयम्॥३॥",
          "स्वस्रीयं मम राजेन्द्र द्रष्टकामो महीपतिः।",
          "तदर्थमुपयातोऽहमयोध्यां रघुनन्दन॥४॥",
          "अयोध्या"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-73",
    "chapterName": "बालकाण्ड, सर्ग 73",
    "verseNumber": 4
  },
  {
    "id": "valmiki-ramayana-1-sarga-73-shlok-5",
    "collectionId": "valmiki-ramayana",
    "index": 2890,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 73, श्लोक 5",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-73-shlok-5",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "श्रुत्वा त्वहमयोध्यायां विवाहार्थं तवात्मजान्।",
          "मिथिलामुपयातांस्तु त्वया सह महीपते॥५॥",
          "त्वरयाभ्युपयातोऽहं द्रष्टुकामः स्वसुः सुतम्।",
          "‘परंतु पृथ्वीनाथ!",
          "अयोध्या"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-73",
    "chapterName": "बालकाण्ड, सर्ग 73",
    "verseNumber": 5
  },
  {
    "id": "valmiki-ramayana-1-sarga-73-shlok-6",
    "collectionId": "valmiki-ramayana",
    "index": 2891,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 73, श्लोक 6",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-73-shlok-6",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "अथ राजा दशरथः प्रियातिथिमुपस्थितम्॥६॥",
          "दृष्ट्वा परमसत्कारैः पूजनार्हमपूजयत्।"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-73",
    "chapterName": "बालकाण्ड, सर्ग 73",
    "verseNumber": 6
  },
