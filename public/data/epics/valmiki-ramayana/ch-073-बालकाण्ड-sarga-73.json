    "slug": "valmiki-ramayana-1-sarga-73-shlok-13",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "इत्युक्तः परमोदारो वसिष्ठेन महात्मना।",
          "प्रत्युवाच महातेजा वाक्यं परमधर्मवित्॥१३॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-73",
    "chapterName": "बालकाण्ड, सर्ग 73",
    "verseNumber": 13
  },
  {
    "id": "valmiki-ramayana-1-sarga-73-shlok-15",
    "collectionId": "valmiki-ramayana",
