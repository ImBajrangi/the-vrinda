      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "तद् वाक्यं जनकेनोक्तं श्रुत्वा दशरथस्तदा।",
          "प्रवेशयामास सुतान् सर्वानृषिगणानपि॥१७॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-73",
    "chapterName": "बालकाण्ड, सर्ग 73",
