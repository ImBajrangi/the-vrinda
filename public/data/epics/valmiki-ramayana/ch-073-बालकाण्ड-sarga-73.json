    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "इत्युक्त्वा प्राक्षिपद् राजा मन्त्रपूतं जलं तदा।",
          "साधुसाध्विति देवानामृषीणां वदतां तदा ॥२८॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-73",
    "chapterName": "बालकाण्ड, सर्ग 73",
