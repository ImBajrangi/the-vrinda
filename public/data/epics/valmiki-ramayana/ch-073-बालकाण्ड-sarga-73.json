    "slug": "valmiki-ramayana-1-sarga-73-shlok-8",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "ततस्तामुषितो रात्रिं सह पुत्रैर्महात्मभिः॥७॥",
          "प्रभाते पुनरुत्थाय कृत्वा कर्माणि तत्त्ववित् ।",
          "ऋषींस्तदा पुरस्कृत्य यज्ञवाटमुपागमत्॥८॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-73",
    "chapterName": "बालकाण्ड, सर्ग 73",
    "verseNumber": 8
  },
  {
    "id": "valmiki-ramayana-1-sarga-73-shlok-10",
    "collectionId": "valmiki-ramayana",
