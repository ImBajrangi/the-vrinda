    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 73, श्लोक 15",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-73-shlok-15",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "कः स्थितः प्रतिहारो मे कस्याज्ञां सम्प्रतीक्षते।",
          "कृतकौतुकसर्वस्वा वेदिमूलमुपागताः।",
          "मम कन्या मुनिश्रेष्ठ दीप्ता बढेरिवार्चिषः॥ १५॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-73",
    "chapterName": "बालकाण्ड, सर्ग 73",
    "verseNumber": 15
  },
  {
    "id": "valmiki-ramayana-1-sarga-73-shlok-16",
    "collectionId": "valmiki-ramayana",
