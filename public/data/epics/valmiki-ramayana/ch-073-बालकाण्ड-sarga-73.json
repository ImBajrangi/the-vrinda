    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 73, श्लोक 10",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-73-shlok-10",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "युक्ते मुहूर्ते विजये सर्वाभरणभूषितैः।।",
          "भ्रातृभिः सहितो रामः कृतकौतुकमंगलः॥९॥",
          "वसिष्ठं पुरतः कृत्वा महर्षीनपरानपि।",
          "वसिष्ठो भगवानेत्य वैदेहमिदमब्रवीत्॥१०॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-73",
    "chapterName": "बालकाण्ड, सर्ग 73",
    "verseNumber": 10
  },
  {
    "id": "valmiki-ramayana-1-sarga-73-shlok-11",
    "collectionId": "valmiki-ramayana",
    "index": 2894,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 73, श्लोक 11",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-73-shlok-11",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "राजा दशरथो राजन् कृतकौतुकमंगलैः।",
          "पुत्रैर्नरवर श्रेष्ठो दातारमभिकाङ्क्षते॥११॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-73",
    "chapterName": "बालकाण्ड, सर्ग 73",
    "verseNumber": 11
  },
  {
    "id": "valmiki-ramayana-1-sarga-73-shlok-12",
