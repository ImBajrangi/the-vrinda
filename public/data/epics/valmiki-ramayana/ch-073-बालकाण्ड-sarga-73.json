    "slug": "valmiki-ramayana-1-sarga-73-shlok-16",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "सद्योऽहं त्वत्प्रतीक्षोऽस्मि वेद्यामस्यां प्रतिष्ठितः ।",
          "अविनं क्रियतां सर्वं किमर्थं हि विलम्ब्यते॥ १६॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-73",
    "chapterName": "बालकाण्ड, सर्ग 73",
    "verseNumber": 16
  },
  {
