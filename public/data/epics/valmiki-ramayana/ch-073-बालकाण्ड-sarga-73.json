    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 73, श्लोक 12",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-73-shlok-12",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "दातृप्रतिग्रहीतृभ्यां सर्वार्थाः सम्भवन्ति हि।",
          "स्वधर्मं प्रतिपद्यस्व कृत्वा वैवाह्यमुत्तमम्॥१२॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-73",
    "chapterName": "बालकाण्ड, सर्ग 73",
    "verseNumber": 12
  },
