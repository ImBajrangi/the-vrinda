    "slug": "valmiki-ramayana-6-sarga-52-shlok-11",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "पार्वेषु दारिताः केचित् केचिद् राशीकृता द्रुमैः।",
          "शिलाभिश्चूर्णिताः केचित् केचिद् दन्तैर्विदारिताः॥११॥"
        ]
      }
    ],
