    "index": 12919,
    "titleDevanagari": "वाल्मीकि रामायण, युद्धकाण्ड, सर्ग 52, श्लोक 4",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-6-sarga-52-shlok-4",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "राक्षसास्त्वभिसंक्रुद्धा वानरान् निशितैः शरैः।",
          "विव्यधुर्घोरसंकाशैः कङ्कपत्रैरजिह्मगैः॥४॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-52",
    "chapterName": "युद्धकाण्ड, सर्ग 52",
    "verseNumber": 4
  },
  {
    "id": "valmiki-ramayana-6-sarga-52-shlok-6",
    "collectionId": "valmiki-ramayana",
    "index": 12920,
    "titleDevanagari": "वाल्मीकि रामायण, युद्धकाण्ड, सर्ग 52, श्लोक 6",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-6-sarga-52-shlok-6",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "ते गदाभिश्च भीमाभिः पट्टिशैः कूटमुद्गरैः।",
          "घोरैश्च परिचैश्चित्रैस्त्रिशूलैश्चापि संश्रितैः॥५॥",
          "विदार्यमाणा रक्षोभिर्वानरास्ते महाबलाः।",
          "अमर्षजनितोद्धर्षाश्चक्रुः कर्माण्यभीतवत्॥६॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-52",
    "chapterName": "युद्धकाण्ड, सर्ग 52",
    "verseNumber": 6
  },
  {
    "id": "valmiki-ramayana-6-sarga-52-shlok-7",
    "collectionId": "valmiki-ramayana",
    "index": 12921,
    "titleDevanagari": "वाल्मीकि रामायण, युद्धकाण्ड, सर्ग 52, श्लोक 7",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-6-sarga-52-shlok-7",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "शरनिर्भिन्नगात्रास्ते शूलनिर्भिन्नदेहिनः।",
          "जगृहस्ते द्रुमांस्तत्र शिलाश्च हरियूथपाः॥७॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-52",
    "chapterName": "युद्धकाण्ड, सर्ग 52",
    "verseNumber": 7
  },
  {
    "id": "valmiki-ramayana-6-sarga-52-shlok-8",
