        "linesDevanagari": [
          "ध्वजैर्विमथितैर्भग्नैः खड्गैश्च विनिपातितैः।",
          "रथैर्विध्वंसितैः केचिद् व्यथिता रजनीचराः॥१२॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-52",
    "chapterName": "युद्धकाण्ड, सर्ग 52",
    "verseNumber": 12
