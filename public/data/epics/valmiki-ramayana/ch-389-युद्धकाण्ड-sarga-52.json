    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "राक्षसा मथिताः केचिद् वानरैर्जितकाशिभिः।",
          "प्रवेमू रुधिरं केचिन्मुखै रुधिरभोजनाः॥१०॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-52",
    "chapterName": "युद्धकाण्ड, सर्ग 52",
    "verseNumber": 10
  },
