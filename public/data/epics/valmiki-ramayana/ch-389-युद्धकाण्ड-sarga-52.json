    "titleDevanagari": "वाल्मीकि रामायण, युद्धकाण्ड, सर्ग 52, श्लोक 1",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-6-sarga-52-shlok-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "धूम्राक्षं प्रेक्ष्य निर्यान्तं राक्षसं भीमविक्रमम्।",
          "विनेदुर्वानराः सर्वे प्रहृष्टा युद्धकाक्षिणः॥१॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-52",
    "chapterName": "युद्धकाण्ड, सर्ग 52",
    "verseNumber": 1
  },
  {
    "id": "valmiki-ramayana-6-sarga-52-shlok-2",
    "collectionId": "valmiki-ramayana",
    "index": 12917,
    "titleDevanagari": "वाल्मीकि रामायण, युद्धकाण्ड, सर्ग 52, श्लोक 2",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-6-sarga-52-shlok-2",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "तेषां सुतुमुलं युद्धं संजज्ञे कपिरक्षसाम्।",
          "अन्योन्यं पादपै?रैर्निजतां शूलमुद्गरैः॥२॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-52",
    "chapterName": "युद्धकाण्ड, सर्ग 52",
    "verseNumber": 2
  },
  {
    "id": "valmiki-ramayana-6-sarga-52-shlok-3",
    "collectionId": "valmiki-ramayana",
    "index": 12918,
    "titleDevanagari": "वाल्मीकि रामायण, युद्धकाण्ड, सर्ग 52, श्लोक 3",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-6-sarga-52-shlok-3",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "राक्षसैर्वानरा घोरा विनिकृत्ताः समन्ततः।",
          "वानरै राक्षसाश्चापि द्रुमैर्भूमिसमीकृताः॥३॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-52",
    "chapterName": "युद्धकाण्ड, सर्ग 52",
    "verseNumber": 3
  },
  {
    "id": "valmiki-ramayana-6-sarga-52-shlok-4",
