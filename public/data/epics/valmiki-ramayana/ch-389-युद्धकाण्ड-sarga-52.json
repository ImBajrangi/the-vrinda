    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-6-sarga-52-shlok-9",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "तद् बभूवाद्भुतं घोरं युद्धं वानररक्षसाम्।",
          "शिलाभिर्विविधाभिश्च बहुशाखैश्च पादपैः॥९॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-52",
    "chapterName": "युद्धकाण्ड, सर्ग 52",
    "verseNumber": 9
  },
  {
