          "आससाद महाकायं गृधं भीमपराक्रमम्॥१॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-14",
    "chapterName": "अरण्यकाण्ड, सर्ग 14",
    "verseNumber": 1
