    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-6-sarga-7-shlok-9",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "निर्जितास्ते महाबाहो नागा गत्वा रसातलम्।",
          "वासुकिस्तक्षकः शङ्को जटी च वशमाहृताः॥९॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-7",
    "chapterName": "युद्धकाण्ड, सर्ग 7",
    "verseNumber": 9
  },
