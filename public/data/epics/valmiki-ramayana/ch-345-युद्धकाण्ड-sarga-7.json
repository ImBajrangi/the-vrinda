      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "क्षत्रियैर्बहुभिवीरैः शक्रतुल्यपराक्रमैः।",
          "आसीद् वसुमती पूर्णा महद्भिरिव पादपैः॥१६॥"
        ]
      }
    ],
