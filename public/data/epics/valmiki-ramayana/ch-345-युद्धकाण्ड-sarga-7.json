    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-6-sarga-7-shlok-12",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "शूराश्च बलवन्तश्च वरुणस्य सुता रणे।",
          "निर्जितास्ते महाभाग चतुर्विधबलानुगाः॥१२॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-7",
    "chapterName": "युद्धकाण्ड, सर्ग 7",
    "verseNumber": 12
