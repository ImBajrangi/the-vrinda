    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "दानवेन्द्रो महाबाहो वीर्योत्सिक्तो दुरासदः।",
          "विगृह्य वशमानीतः कुम्भीनस्याः सुखावहः॥८॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-7",
    "chapterName": "युद्धकाण्ड, सर्ग 7",
    "verseNumber": 8
  },
