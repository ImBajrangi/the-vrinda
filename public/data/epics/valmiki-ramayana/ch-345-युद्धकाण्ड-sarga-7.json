    "titleDevanagari": "वाल्मीकि रामायण, युद्धकाण्ड, सर्ग 7, श्लोक 1",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-6-sarga-7-shlok-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "इत्युक्ता राक्षसेन्द्रेण राक्षसास्ते महाबलाः।",
          "ऊचुः प्राञ्जलयः सर्वे रावणं राक्षसेश्वरम्॥१॥",
          "द्विषत्पक्षमविज्ञाय नीतिबाह्यास्त्वबुद्धयः।"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-7",
    "chapterName": "युद्धकाण्ड, सर्ग 7",
    "verseNumber": 1
  },
  {
    "id": "valmiki-ramayana-6-sarga-7-shlok-2",
    "collectionId": "valmiki-ramayana",
    "index": 11485,
    "titleDevanagari": "वाल्मीकि रामायण, युद्धकाण्ड, सर्ग 7, श्लोक 2",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-6-sarga-7-shlok-2",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "राजन् परिघशक्त्यृष्टिशूलपट्टिशकुन्तलम्॥२॥",
          "सुमहन्नो बलं कस्माद् विषादं भजते भवान्।"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-7",
    "chapterName": "युद्धकाण्ड, सर्ग 7",
    "verseNumber": 2
  },
  {
    "id": "valmiki-ramayana-6-sarga-7-shlok-4",
    "collectionId": "valmiki-ramayana",
    "index": 11486,
    "titleDevanagari": "वाल्मीकि रामायण, युद्धकाण्ड, सर्ग 7, श्लोक 4",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-6-sarga-7-shlok-4",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "त्वया भोगवतीं गत्वा निर्जिताः पन्नगा युधि॥",
          "कैलासशिखरावासी यक्षैर्बहुभिरावृतः।",
          "सुमहत्कदनं कृत्वा वश्यस्ते धनदः कृतः॥४॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-7",
    "chapterName": "युद्धकाण्ड, सर्ग 7",
    "verseNumber": 4
  },
  {
    "id": "valmiki-ramayana-6-sarga-7-shlok-5",
    "collectionId": "valmiki-ramayana",
    "index": 11487,
    "titleDevanagari": "वाल्मीकि रामायण, युद्धकाण्ड, सर्ग 7, श्लोक 5",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-6-sarga-7-shlok-5",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "स महेश्वरसख्येन श्लाघमानस्त्वया विभो।",
          "निर्जितः समरे रोषाल्लोकपालो महाबलः॥५॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-7",
    "chapterName": "युद्धकाण्ड, सर्ग 7",
    "verseNumber": 5
  },
  {
    "id": "valmiki-ramayana-6-sarga-7-shlok-6",
    "collectionId": "valmiki-ramayana",
    "index": 11488,
    "titleDevanagari": "वाल्मीकि रामायण, युद्धकाण्ड, सर्ग 7, श्लोक 6",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-6-sarga-7-shlok-6",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "विनिपात्य च यक्षौघान् विक्षोभ्य विनिगृह्य च।",
          "त्वया कैलासशिखराद् विमानमिदमाहृतम्॥६॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-7",
    "chapterName": "युद्धकाण्ड, सर्ग 7",
    "verseNumber": 6
  },
  {
    "id": "valmiki-ramayana-6-sarga-7-shlok-7",
