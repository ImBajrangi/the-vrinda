    "slug": "valmiki-ramayana-6-sarga-51-shlok-8",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "तथोक्तास्ते सुसम्भ्रान्ताः प्राकारमधिरुह्य च।",
          "ददृशुः पालितां सेनां सुग्रीवेण महात्मना॥८॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-51",
    "chapterName": "युद्धकाण्ड, सर्ग 51",
    "verseNumber": 8
  },
