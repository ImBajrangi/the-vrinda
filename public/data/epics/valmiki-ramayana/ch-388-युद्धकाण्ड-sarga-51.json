    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "संत्रस्तहृदयाः सर्वे प्राकारादवरुह्य ते।",
          "विवर्णा राक्षसा घोरा राक्षसेन्द्रमुपस्थिताः॥१०॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-51",
    "chapterName": "युद्धकाण्ड, सर्ग 51",
    "verseNumber": 10
  },
  {
