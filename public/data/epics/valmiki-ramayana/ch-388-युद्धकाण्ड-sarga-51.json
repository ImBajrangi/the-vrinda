    "titleDevanagari": "वाल्मीकि रामायण, युद्धकाण्ड, सर्ग 51, श्लोक 1",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-6-sarga-51-shlok-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "तेषां तु तुमुलं शब्दं वानराणां महौजसाम्।",
          "नर्दतां राक्षसैः सार्धं तदा शुश्राव रावणः॥१॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-51",
    "chapterName": "युद्धकाण्ड, सर्ग 51",
    "verseNumber": 1
  },
  {
    "id": "valmiki-ramayana-6-sarga-51-shlok-2",
    "collectionId": "valmiki-ramayana",
    "index": 12886,
    "titleDevanagari": "वाल्मीकि रामायण, युद्धकाण्ड, सर्ग 51, श्लोक 2",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-6-sarga-51-shlok-2",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "स्निग्धगम्भीरनिर्घोषं श्रुत्वा तं निनदं भृशम्।",
          "सचिवानां ततस्तेषां मध्ये वचनमब्रवीत्॥२॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-51",
    "chapterName": "युद्धकाण्ड, सर्ग 51",
    "verseNumber": 2
  },
  {
    "id": "valmiki-ramayana-6-sarga-51-shlok-4",
    "collectionId": "valmiki-ramayana",
    "index": 12887,
    "titleDevanagari": "वाल्मीकि रामायण, युद्धकाण्ड, सर्ग 51, श्लोक 4",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-6-sarga-51-shlok-4",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "यथासौ सम्प्रहृष्टानां वानराणामुपस्थितः।",
          "बहूनां सुमहान् नादो मेघानामिव गर्जताम्॥३॥",
          "सुव्यक्तं महती प्रीतिरेतेषां नात्र संशयः।",
          "तथाहि विपुलैर्नादैश्चुक्षुभे लवणार्णवः॥४॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-51",
    "chapterName": "युद्धकाण्ड, सर्ग 51",
    "verseNumber": 4
  },
  {
    "id": "valmiki-ramayana-6-sarga-51-shlok-5",
    "collectionId": "valmiki-ramayana",
    "index": 12888,
    "titleDevanagari": "वाल्मीकि रामायण, युद्धकाण्ड, सर्ग 51, श्लोक 5",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-6-sarga-51-shlok-5",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "तौ तु बद्धौ शरैस्तीक्ष्णैर्धातरौ रामलक्ष्मणौ।",
          "अयं च सुमहान् नादः शङ्कां जनयतीव मे॥५॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-51",
    "chapterName": "युद्धकाण्ड, सर्ग 51",
    "verseNumber": 5
  },
  {
