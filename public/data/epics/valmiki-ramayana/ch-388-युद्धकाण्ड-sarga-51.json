    "slug": "valmiki-ramayana-6-sarga-51-shlok-6",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "एवं च वचनं चोक्त्वा मन्त्रिणो राक्षसेश्वरः।",
          "उवाच नैर्ऋतांस्तत्र समीपपरिवर्तिनः॥६॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-51",
    "chapterName": "युद्धकाण्ड, सर्ग 51",
    "verseNumber": 6
  },
  {
