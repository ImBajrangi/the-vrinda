    "slug": "valmiki-ramayana-6-sarga-51-shlok-11",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "तदप्रियं दीनमुखा रावणस्य च राक्षसाः।",
          "कृत्स्नं निवेदयामासुर्यथावद् वाक्यकोविदाः॥११॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-51",
    "chapterName": "युद्धकाण्ड, सर्ग 51",
    "verseNumber": 11
  },
  {
