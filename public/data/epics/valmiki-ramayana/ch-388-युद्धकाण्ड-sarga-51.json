    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-6-sarga-51-shlok-14",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "तच्छ्रुत्वा वचनं तेषां राक्षसेन्द्रो महाबलः।",
          "चिन्ताशोकसमाक्रान्तो विवर्णवदनोऽभवत्॥१४॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-51",
    "chapterName": "युद्धकाण्ड, सर्ग 51",
    "verseNumber": 14
