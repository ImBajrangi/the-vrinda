    "slug": "valmiki-ramayana-6-sarga-51-shlok-9",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "तौ च मुक्तौ सुघोरेण शरबन्धेन राघवौ।",
          "समुत्थितौ महाभागौ विषेदुः सर्वराक्षसाः॥९॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-51",
    "chapterName": "युद्धकाण्ड, सर्ग 51",
    "verseNumber": 9
  },
  {
