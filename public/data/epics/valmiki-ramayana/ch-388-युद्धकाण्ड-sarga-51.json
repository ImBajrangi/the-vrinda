    "slug": "valmiki-ramayana-6-sarga-51-shlok-7",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "ज्ञायतां तूर्णमेतेषां सर्वेषां च वनौकसाम्।",
          "शोककाले समुत्पन्ने हर्षकारणमुत्थितम्॥७॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-51",
    "chapterName": "युद्धकाण्ड, सर्ग 51",
    "verseNumber": 7
  },
  {
