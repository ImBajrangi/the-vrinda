    "slug": "valmiki-ramayana-5-sarga-30-shlok-3",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "यां कपीनां सहस्राणि सुबहून्ययुतानि च।",
          "दिक्षु सर्वासु मार्गन्ते सेयमासादिता मया॥३॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-30",
    "chapterName": "सुन्दरकाण्ड, सर्ग 30",
    "verseNumber": 3
  },
  {
