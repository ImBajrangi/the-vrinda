    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-5-sarga-30-shlok-2",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "अवेक्षमाणस्तां देवी देवतामिव नन्दने।",
          "ततो बहुविधां चिन्तां चिन्तयामास वानरः॥२॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-30",
    "chapterName": "सुन्दरकाण्ड, सर्ग 30",
    "verseNumber": 2
  },
  {
