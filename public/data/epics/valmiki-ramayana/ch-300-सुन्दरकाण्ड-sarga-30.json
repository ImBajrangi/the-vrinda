    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "यथा तस्याप्रमेयस्य सर्वसत्त्वदयावतः।",
          "समाश्वासयितुं भार्यां पतिदर्शनकांक्षिणीम्॥६॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-30",
    "chapterName": "सुन्दरकाण्ड, सर्ग 30",
    "verseNumber": 6
  },
