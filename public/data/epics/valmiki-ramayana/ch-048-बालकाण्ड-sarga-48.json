    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "स चात्र तप आतिष्ठदहल्यासहितः पुरा।",
          "वर्षपूगान्यनेकानि राजपुत्र महायशः॥१६॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-48",
    "chapterName": "बालकाण्ड, सर्ग 48",
