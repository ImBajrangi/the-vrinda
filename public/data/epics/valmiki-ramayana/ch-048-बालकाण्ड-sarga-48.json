    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-48-shlok-13-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "तस्य तस्मिन् वने पुत्रो बालको दशवार्षिकः॥१३॥",
          "प्रणष्टो जीवितान्ताय क्रुद्धस्तेन महामुनिः।"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-48",
    "chapterName": "बालकाण्ड, सर्ग 48",
    "verseNumber": 13
  },
