    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-48-shlok-11-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "न चात्र वृक्षा नौषध्यो न वल्लयो नापि वीरुधः ।",
          "स्निग्धपत्राः स्थले यत्र पद्मिन्यः फुल्लपङ्कजाः॥११॥",
          "प्रेक्षणीयाः सुगन्धाश्च भ्रमरैश्च विवर्जिताः।"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-48",
    "chapterName": "बालकाण्ड, सर्ग 48",
    "verseNumber": 11
  },
  {
    "id": "valmiki-ramayana-1-sarga-48-shlok-12",
    "collectionId": "valmiki-ramayana",
    "index": 2225,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 48, श्लोक 12",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-48-shlok-12",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "कण्डुर्नाम महाभागः सत्यवादी तपोधनः॥१२॥",
          "महर्षिः परमामर्षी नियमैर्दुष्प्रधर्षणः।"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-48",
    "chapterName": "बालकाण्ड, सर्ग 48",
    "verseNumber": 12
  },
