    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 48, श्लोक 1",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-48-shlok-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "सह ताराङ्गदाभ्यां तु सहसा हनुमान् कपिः।",
          "सुग्रीवेण यथोद्दिष्टं गन्तुं देशं प्रचक्रमे॥१॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-48",
    "chapterName": "बालकाण्ड, सर्ग 48",
    "verseNumber": 1
  },
  {
    "id": "valmiki-ramayana-1-sarga-48-shlok-2",
    "collectionId": "valmiki-ramayana",
    "index": 2215,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 48, श्लोक 2",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-48-shlok-2",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "इमौ कुमारौ भद्रं ते देवतुल्यपराक्रमौ।",
          "गजसिंहगती वीरौ शार्दूलवृषभोपमौ॥२॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-48",
    "chapterName": "बालकाण्ड, सर्ग 48",
    "verseNumber": 2
  },
  {
    "id": "valmiki-ramayana-1-sarga-48-shlok-3",
