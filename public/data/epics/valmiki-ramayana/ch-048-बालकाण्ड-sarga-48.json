    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-48-shlok-10",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "न सन्ति महिषा यत्र न मृगा न च हस्तिनः।",
          "शार्दूलाः पक्षिणो वापि ये चान्ये वनगोचराः॥१०॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-48",
    "chapterName": "बालकाण्ड, सर्ग 48",
    "verseNumber": 10
  },
  {
