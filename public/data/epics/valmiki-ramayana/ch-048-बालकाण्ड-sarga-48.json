    "index": 2222,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 48, श्लोक 9",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-48-shlok-9",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "यत्र वन्ध्यफला वृक्षा विपुष्पाः पर्णवर्जिताः।",
          "निस्तोयाः सरितो यत्र मूलं यत्र सुदुर्लभम्॥९॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-48",
    "chapterName": "बालकाण्ड, सर्ग 48",
    "verseNumber": 9
  },
  {
