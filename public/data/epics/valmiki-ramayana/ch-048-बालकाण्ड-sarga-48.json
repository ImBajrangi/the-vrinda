    "slug": "valmiki-ramayana-1-sarga-48-shlok-3",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "पद्मपत्रविशालाक्षौ खड्गतूणधनुर्धरौ।",
          "अश्विनाविव रूपेण समुपस्थितयौवनौ॥३॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-48",
    "chapterName": "बालकाण्ड, सर्ग 48",
    "verseNumber": 3
  },
  {
    "id": "valmiki-ramayana-1-sarga-48-shlok-4-1",
    "collectionId": "valmiki-ramayana",
    "index": 2217,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 48, श्लोक 4",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-48-shlok-4-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "स तु दूरमुपागम्य सर्वैस्तैः कपिसत्तमैः।",
          "ततो विचित्य विन्ध्यस्य गुहाश्च गहनानि च॥२॥",
          "पर्वताग्रनदीदुर्गान् सरांसि विपुलद्रुमान्।",
          "वृक्षषण्डांश्च विविधान् पर्वतान् वनपादपान्॥",
          "अन्वेषमाणास्ते सर्वे वानराः सर्वतो दिशम्।",
          "न सीतां ददृशुर्वीरा मैथिली जनकात्मजाम्॥४॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-48",
    "chapterName": "बालकाण्ड, सर्ग 48",
    "verseNumber": 4
  },
  {
    "id": "valmiki-ramayana-1-sarga-48-shlok-5-1",
    "collectionId": "valmiki-ramayana",
    "index": 2218,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 48, श्लोक 5",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-48-shlok-5-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "ते भक्षयन्तो मूलानि फलानि विविधान्यपि।",
          "अन्वेषमाणा दुर्धर्षा न्यवसंस्तत्र तत्र ह॥५॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-48",
    "chapterName": "बालकाण्ड, सर्ग 48",
    "verseNumber": 5
  },
  {
    "id": "valmiki-ramayana-1-sarga-48-shlok-6",
    "collectionId": "valmiki-ramayana",
    "index": 2219,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 48, श्लोक 6",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-48-shlok-6",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "स तु देशो दुरन्वेषो गुहागहनवान् महान्।",
          "निर्जलं निर्जनं शून्यं गहनं घोरदर्शनम्॥६॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-48",
    "chapterName": "बालकाण्ड, सर्ग 48",
    "verseNumber": 6
  },
  {
    "id": "valmiki-ramayana-1-sarga-48-shlok-7-1",
    "collectionId": "valmiki-ramayana",
    "index": 2220,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 48, श्लोक 7",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-48-shlok-7-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "तादृशान्यप्यरण्यानि विचित्य भृशपीडिताः।",
          "स देशश्च दुरन्वेष्यो गुहागहनवान् महान्॥७॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-48",
    "chapterName": "बालकाण्ड, सर्ग 48",
    "verseNumber": 7
  },
  {
    "id": "valmiki-ramayana-1-sarga-48-shlok-8-1",
    "collectionId": "valmiki-ramayana",
    "index": 2221,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 48, श्लोक 8",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-48-shlok-8-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "त्यक्त्वा तु तं ततो देशं सर्वे वै हरियूथपाः।",
          "देशमन्यं दुराधर्षं विविशुश्चाकुतोभयाः॥८॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-48",
    "chapterName": "बालकाण्ड, सर्ग 48",
    "verseNumber": 8
  },
  {
