    "slug": "valmiki-ramayana-1-sarga-48-shlok-14",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "तेन धर्मात्मना शप्तं कृत्स्नं तत्र महदनम्॥१४॥",
          "अशरण्यं दुराधर्षं मृगपक्षिविवर्जितम्।"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-48",
    "chapterName": "बालकाण्ड, सर्ग 48",
    "verseNumber": 14
