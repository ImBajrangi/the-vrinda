    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-48-shlok-15",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "तस्य ते काननान्तांस्तु गिरीणां कन्दराणि च॥१५॥",
          "प्रभवाणि नदीनां च विचिन्वन्ति समाहिताः।",
          "तत्र चापि महात्मानो नापश्यञ्जनकात्मजाम्॥१६॥",
          "हर्तारं रावणं वापि सुग्रीवप्रियकारिणः।"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-48",
    "chapterName": "बालकाण्ड, सर्ग 48",
    "verseNumber": 15
  },
