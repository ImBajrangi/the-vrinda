    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-5-sarga-23-shlok-11",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "वीर्योत्सिक्तस्य शूरस्य संग्रामेष्वनिवर्तिनः।",
          "बलिनो वीर्ययुक्तस्य भार्यात्वं किं न लिप्ससे॥११॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-23",
    "chapterName": "सुन्दरकाण्ड, सर्ग 23",
    "verseNumber": 11
  },
  {
