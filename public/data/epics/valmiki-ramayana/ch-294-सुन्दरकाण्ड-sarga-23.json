    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-5-sarga-23-shlok-13",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "प्रियां बहुमतां भार्यां त्यक्त्वा राजा महाबलः।",
          "सर्वासां च महाभागां त्वामुपैष्यति रावणः॥१२॥",
          "समृद्धं स्त्रीसहस्रेण नानारत्नोपशोभितम्।",
          "अन्तःपुरं तदुत्सृज्य त्वामुपैष्यति रावणः॥१३॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-23",
    "chapterName": "सुन्दरकाण्ड, सर्ग 23",
    "verseNumber": 13
  },
  {
