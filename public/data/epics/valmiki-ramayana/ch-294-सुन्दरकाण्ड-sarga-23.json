    "index": 9719,
    "titleDevanagari": "वाल्मीकि रामायण, सुन्दरकाण्ड, सर्ग 23, श्लोक 3",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-5-sarga-23-shlok-3",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "ततः सीतामुपागम्य राक्षस्यः क्रोधमूर्च्छिताः।",
          "परं परुषया वाचा वैदेहीमिदमब्रुवन्॥३॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-23",
    "chapterName": "सुन्दरकाण्ड, सर्ग 23",
    "verseNumber": 3
  },
