    "slug": "valmiki-ramayana-5-sarga-23-shlok-8",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "तस्य पुत्रो विशालाक्षि रावणः शत्रुरावणः।",
          "तस्य त्वं राक्षसेन्द्रस्य भार्या भवितुमर्हसि॥८॥",
          "मयोक्तं चारुसर्वाङ्गि वाक्यं किं नानुमन्यसे।"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-23",
    "chapterName": "सुन्दरकाण्ड, सर्ग 23",
    "verseNumber": 8
  },
  {
