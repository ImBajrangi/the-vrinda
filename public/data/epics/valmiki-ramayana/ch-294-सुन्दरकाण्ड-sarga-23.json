        "linesDevanagari": [
          "पौलस्त्यस्य वरिष्ठस्य रावणस्य महात्मनः।",
          "दशग्रीवस्य भार्यात्वं सीते न बहु मन्यसे॥४॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-23",
    "chapterName": "सुन्दरकाण्ड, सर्ग 23",
    "verseNumber": 4
