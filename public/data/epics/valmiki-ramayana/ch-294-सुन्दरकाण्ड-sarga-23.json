        "linesDevanagari": [
          "ततस्त्वेकजटा नाम राक्षसी वाक्यमब्रवीत्।",
          "आमन्त्र्य क्रोधताम्राक्षी सीतां करतलोदरीम्॥५॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-23",
    "chapterName": "सुन्दरकाण्ड, सर्ग 23",
    "verseNumber": 5
