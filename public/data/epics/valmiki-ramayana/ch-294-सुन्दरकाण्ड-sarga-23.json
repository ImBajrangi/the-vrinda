    "titleDevanagari": "वाल्मीकि रामायण, सुन्दरकाण्ड, सर्ग 23, श्लोक 1",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-5-sarga-23-shlok-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "इत्युक्त्वा मैथिली राजा रावणः शत्रुरावणः।",
          "संदिश्य च ततः सर्वा राक्षसीर्निर्जगाम ह॥१॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-23",
    "chapterName": "सुन्दरकाण्ड, सर्ग 23",
    "verseNumber": 1
  },
  {
    "id": "valmiki-ramayana-5-sarga-23-shlok-2",
    "collectionId": "valmiki-ramayana",
    "index": 9718,
    "titleDevanagari": "वाल्मीकि रामायण, सुन्दरकाण्ड, सर्ग 23, श्लोक 2",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-5-sarga-23-shlok-2",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "निष्क्रान्ते राक्षसेन्द्रे तु पुनरन्तःपुरं गते।",
          "राक्षस्यो भीमरूपास्ताः सीतां समभिदुद्रुवुः॥२॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-23",
    "chapterName": "सुन्दरकाण्ड, सर्ग 23",
    "verseNumber": 2
  },
  {
    "id": "valmiki-ramayana-5-sarga-23-shlok-3",
