    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-9-shlok-9",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "॥ श्रीसीतारामचन्द्राभ्यां नमः॥",
          "श्रीमद्वाल्मीकीय रामायण",
          "अरण्यकाण्डम्",
          "नवमः सर्गः (सर्ग 9)",
          "तृतीयं यदिदं रौद्रं परप्राणाभिहिंसनम्।",
          "निर्वैरं क्रियते मोहात् तच्च ते समुपस्थितम्॥९॥",
          "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्येऽरण्यकाण्डे नवमः सर्गः॥९॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-9",
    "chapterName": "अरण्यकाण्ड, सर्ग 9",
    "verseNumber": 9
  },
  {
    "id": "valmiki-ramayana-3-sarga-9-shlok-10",
    "collectionId": "valmiki-ramayana",
    "index": 6999,
    "titleDevanagari": "वाल्मीकि रामायण, अरण्यकाण्ड, सर्ग 9, श्लोक 10",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-9-shlok-10",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "प्रतिज्ञातस्त्वया वीर दण्डकारण्यवासिनाम्।",
          "ऋषीणां रक्षणार्थाय वधः संयति रक्षसाम्॥ १०॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-9",
    "chapterName": "अरण्यकाण्ड, सर्ग 9",
    "verseNumber": 10
  },
