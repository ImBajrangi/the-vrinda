    "slug": "valmiki-ramayana-3-sarga-9-shlok-12",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "ततस्त्वां प्रस्थितं दृष्ट्वा मम चिन्ताकुलं मनः।",
          "त्वद्धृत्तं चिन्तयन्त्या वै भवेन्निःश्रेयसं हितम्॥ १२॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-9",
    "chapterName": "अरण्यकाण्ड, सर्ग 9",
    "verseNumber": 12
  },
  {
