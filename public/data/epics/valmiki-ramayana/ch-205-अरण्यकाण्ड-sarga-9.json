    "titleDevanagari": "वाल्मीकि रामायण, अरण्यकाण्ड, सर्ग 9, श्लोक 1",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-9-shlok-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "सुतीक्ष्णेनाभ्यनुज्ञातं प्रस्थितं रघुनन्दनम्।",
          "हृद्यया स्निग्धया वाचा भर्तारमिदमब्रवीत्॥१॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-9",
    "chapterName": "अरण्यकाण्ड, सर्ग 9",
    "verseNumber": 1
  },
  {
    "id": "valmiki-ramayana-3-sarga-9-shlok-2",
    "collectionId": "valmiki-ramayana",
    "index": 6994,
    "titleDevanagari": "वाल्मीकि रामायण, अरण्यकाण्ड, सर्ग 9, श्लोक 2",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-9-shlok-2",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "अधर्मं तु सुसूक्ष्मेण विधिना प्राप्यते महान्।",
          "निवृत्तेन च शक्योऽयं व्यसनात् कामजादिह॥ २॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-9",
    "chapterName": "अरण्यकाण्ड, सर्ग 9",
    "verseNumber": 2
  },
  {
    "id": "valmiki-ramayana-3-sarga-9-shlok-4",
    "collectionId": "valmiki-ramayana",
    "index": 6995,
    "titleDevanagari": "वाल्मीकि रामायण, अरण्यकाण्ड, सर्ग 9, श्लोक 4",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-9-shlok-4",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "त्रीण्येव व्यसनान्यत्र कामजानि भवन्त्युत।",
          "मिथ्यावाक्यं तु परमं तस्माद् गुरुतरावुभौ ॥३॥",
          "परदाराभिगमनं विना वैरं च रौद्रता।",
          "मिथ्यावाक्यं न ते भूतं न भविष्यति राघव॥४॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-9",
    "chapterName": "अरण्यकाण्ड, सर्ग 9",
    "verseNumber": 4
  },
  {
    "id": "valmiki-ramayana-3-sarga-9-shlok-7",
    "collectionId": "valmiki-ramayana",
    "index": 6996,
    "titleDevanagari": "वाल्मीकि रामायण, अरण्यकाण्ड, सर्ग 9, श्लोक 7",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-9-shlok-7",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "कुतोऽभिलषणं स्त्रीणां परेषां धर्मनाशनम्।",
          "तव नास्ति मनुष्येन्द्र न चाभूत् ते कदाचन ॥५॥",
          "मनस्यपि तथा राम न चैतद् विद्यते क्वचित्।",
          "स्वदारनिरतश्चैव नित्यमेव नृपात्मज॥६॥",
          "धर्मिष्ठः सत्यसंधश्च पितुर्निर्देशकारकः।",
          "त्वयि धर्मश्च सत्यं च त्वयि सर्वं प्रतिष्ठितम्॥७॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-9",
    "chapterName": "अरण्यकाण्ड, सर्ग 9",
    "verseNumber": 7
  },
  {
    "id": "valmiki-ramayana-3-sarga-9-shlok-8",
    "collectionId": "valmiki-ramayana",
    "index": 6997,
    "titleDevanagari": "वाल्मीकि रामायण, अरण्यकाण्ड, सर्ग 9, श्लोक 8",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-9-shlok-8",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "तच्च सर्वं महाबाहो शक्यं वोढुं जितेन्द्रियैः।",
          "तव वश्येन्द्रियत्वं च जानामि शुभदर्शन॥८॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-9",
    "chapterName": "अरण्यकाण्ड, सर्ग 9",
    "verseNumber": 8
  },
  {
    "id": "valmiki-ramayana-3-sarga-9-shlok-9",
