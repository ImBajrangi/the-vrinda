    "slug": "valmiki-ramayana-1-sarga-13-shlok-6",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "मनोहरं सर्वसुखं कारयामास राक्षसः।।",
          "सर्वत्र सुखदं नित्यं मेरोः पुण्यां गुहामिव॥६॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-13",
    "chapterName": "बालकाण्ड, सर्ग 13",
    "verseNumber": 6
  },
  {
