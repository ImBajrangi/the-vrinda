    "slug": "valmiki-ramayana-1-sarga-13-shlok-11",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "तथा पौरजनस्यापि कर्तव्याश्च सुविस्तराः।",
          "आगतानां सुदूराच्च पार्थिवानां पृथक् पृथक्॥११॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-13",
    "chapterName": "बालकाण्ड, सर्ग 13",
    "verseNumber": 11
  },
  {
    "id": "valmiki-ramayana-1-sarga-13-shlok-12-1",
