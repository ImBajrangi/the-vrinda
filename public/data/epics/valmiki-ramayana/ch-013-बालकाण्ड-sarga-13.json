    "slug": "valmiki-ramayana-1-sarga-13-shlok-14-2",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "पृष्ट्वा च कुशलं राज्ञो ज्ञातीनां च विभीषणः।",
          "सभायां दर्शयामास तमासीनं दशाननम्॥१४॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-13",
    "chapterName": "बालकाण्ड, सर्ग 13",
    "verseNumber": 14
  },
