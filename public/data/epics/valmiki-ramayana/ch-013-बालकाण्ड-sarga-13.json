    "slug": "valmiki-ramayana-1-sarga-13-shlok-16-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "स तत्रोत्तमपर्यङ्के वरास्तरणशोभिते।",
          "उपविष्टं दशग्रीवं दूतो वाक्यमथाब्रवीत्॥१६॥"
        ]
      }
    ],
