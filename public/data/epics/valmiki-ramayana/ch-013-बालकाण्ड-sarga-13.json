    "slug": "valmiki-ramayana-1-sarga-13-shlok-7",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "तत्र निद्रां समाविष्टः कुम्भकर्णो महाबलः।",
          "बहून्यब्दसहस्राणि शयानो न च बुध्यते॥७॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-13",
    "chapterName": "बालकाण्ड, सर्ग 13",
    "verseNumber": 7
  },
  {
    "id": "valmiki-ramayana-1-sarga-13-shlok-8-1",
    "collectionId": "valmiki-ramayana",
