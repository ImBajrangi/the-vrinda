    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "नदीं गज इव क्रीडन् वृक्षान् वायुरिव क्षिपन्।",
          "नगान् वज्र इवोत्सृष्टो विध्वंसयति राक्षसः॥१०॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-13",
    "chapterName": "बालकाण्ड, सर्ग 13",
    "verseNumber": 10
  },
