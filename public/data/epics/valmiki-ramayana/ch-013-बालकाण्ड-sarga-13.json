    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 13, श्लोक 1",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-13-shlok-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "ऋष्यमूकात् स धर्मात्मा किष्किन्धां लक्ष्मणाग्रजः।",
          "जगाम सह सुग्रीवो वालिविक्रमपालिताम्॥१॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-13",
    "chapterName": "बालकाण्ड, सर्ग 13",
    "verseNumber": 1
  },
  {
    "id": "valmiki-ramayana-1-sarga-13-shlok-2",
    "collectionId": "valmiki-ramayana",
    "index": 656,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 13, श्लोक 2",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-13-shlok-2",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "ततो भ्रातरमासीनं कुम्भकर्णोऽब्रवीद् वचः।",
          "निद्रा मां बाधते राजन् कारयस्व ममालयम्॥२॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-13",
    "chapterName": "बालकाण्ड, सर्ग 13",
    "verseNumber": 2
  },
  {
    "id": "valmiki-ramayana-1-sarga-13-shlok-3",
    "collectionId": "valmiki-ramayana",
    "index": 657,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 13, श्लोक 3",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-13-shlok-3",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "अग्रतस्तु ययौ तस्य राघवस्य महात्मनः।",
          "सुग्रीवः संहतग्रीवो लक्ष्मणश्च महाबलः॥३॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-13",
    "chapterName": "बालकाण्ड, सर्ग 13",
    "verseNumber": 3
  },
  {
    "id": "valmiki-ramayana-1-sarga-13-shlok-4",
    "collectionId": "valmiki-ramayana",
    "index": 658,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 13, श्लोक 4",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-13-shlok-4",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "विनियक्तास्ततो राज्ञा शिल्पिनो विश्वकर्मवत्।",
          "विस्तीर्णं योजनं स्निग्धं ततो द्विगुणमायतम्॥",
          "दर्शनीयं निराबाधं कुम्भकर्णस्य चक्रिरे।",
          "स्फाटिकैः काञ्चनैश्चित्रैः स्तम्भैः सर्वत्र शोभितम्॥४॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-13",
    "chapterName": "बालकाण्ड, सर्ग 13",
    "verseNumber": 4
  },
  {
    "id": "valmiki-ramayana-1-sarga-13-shlok-5",
    "collectionId": "valmiki-ramayana",
    "index": 659,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 13, श्लोक 5",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-13-shlok-5",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "वैदूर्यकृतसोपानं किङ्किणीजालकं तथा।",
          "दान्ततोरणविन्यस्तं वज्रस्फटिकवेदिकम्॥५॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-13",
    "chapterName": "बालकाण्ड, सर्ग 13",
    "verseNumber": 5
  },
  {
