    "slug": "valmiki-ramayana-1-sarga-13-shlok-8-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "कारण्डैः सारसैहँसैर्वजुलैर्जलकुक्कुटैः।",
          "चक्रवाकैस्तथा चान्यैः शकुनैः प्रतिनादितान्॥ ८॥",
          "मृदुशष्याङ्कराहारान्निर्भयान् वनगोचरान्।",
          "चरतः सर्वतः पश्यन् स्थलीषु हरिणान् स्थितान्॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-13",
    "chapterName": "बालकाण्ड, सर्ग 13",
    "verseNumber": 8
  },
  {
    "id": "valmiki-ramayana-1-sarga-13-shlok-9",
    "collectionId": "valmiki-ramayana",
    "index": 663,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 13, श्लोक 9",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-13-shlok-9",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "उद्यानानि विचित्राणि नन्दनादीनि यानि च।",
          "तानि गत्वा सुसंक्रुद्धो भिनत्ति स्म दशाननः॥९॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-13",
    "chapterName": "बालकाण्ड, सर्ग 13",
    "verseNumber": 9
  },
