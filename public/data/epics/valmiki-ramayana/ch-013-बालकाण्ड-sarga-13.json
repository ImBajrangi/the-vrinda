    "slug": "valmiki-ramayana-1-sarga-13-shlok-15-2",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "स दृष्ट्वा तत्र राजानं दीप्यमानं स्वतेजसा।",
          "जयेति वाचा सम्पूज्य तूष्णीं समभिवर्तत ॥१५॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-13",
    "chapterName": "बालकाण्ड, सर्ग 13",
    "verseNumber": 15
  },
