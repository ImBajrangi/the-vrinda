    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "मनसास्मि गतो यत् त्वां परिष्वज्य यशस्विनि।",
          "वीर्यवान् बुद्धिसम्पन्नस्तव पुत्रो भविष्यति॥१८॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-66",
    "chapterName": "बालकाण्ड, सर्ग 66",
