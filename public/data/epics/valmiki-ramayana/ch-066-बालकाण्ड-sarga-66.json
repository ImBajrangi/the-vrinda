    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "अञ्जनाया वचः श्रुत्वा मारुतः प्रत्यभाषत।",
          "न त्वां हिंसामि सुश्रोणि मा भूत् ते मनसो भयम्॥१७॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-66",
    "chapterName": "बालकाण्ड, सर्ग 66",
    "verseNumber": 17
  },
