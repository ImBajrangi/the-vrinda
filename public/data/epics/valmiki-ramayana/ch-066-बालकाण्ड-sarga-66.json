[
  {
    "id": "valmiki-ramayana-1-sarga-66-shlok-1",
    "collectionId": "valmiki-ramayana",
    "index": 2706,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 66, श्लोक 1",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-66-shlok-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "अनेकशतसाहस्री विषण्णां हरिवाहिनीम्।",
          "जाम्बवान् समुदीक्ष्यैवं हनूमन्तमथाब्रवीत्॥१॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-66",
    "chapterName": "बालकाण्ड, सर्ग 66",
    "verseNumber": 1
  },
  {
    "id": "valmiki-ramayana-1-sarga-66-shlok-2",
    "collectionId": "valmiki-ramayana",
    "index": 2707,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 66, श्लोक 2",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-66-shlok-2",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "वीर वानरलोकस्य सर्वशास्त्रविदां वर।",
          "तूष्णीमेकान्तमाश्रित्य हनूमन् किं न जल्पसि॥२॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-66",
    "chapterName": "बालकाण्ड, सर्ग 66",
    "verseNumber": 2
  },
  {
    "id": "valmiki-ramayana-1-sarga-66-shlok-3",
    "collectionId": "valmiki-ramayana",
    "index": 2708,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 66, श्लोक 3",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-66-shlok-3",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "हनूमन् हरिराजस्य सुग्रीवस्य समो ह्यसि।",
          "रामलक्ष्मणयोश्चापि तेजसा च बलेन च॥३॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-66",
    "chapterName": "बालकाण्ड, सर्ग 66",
    "verseNumber": 3
  },
  {
    "id": "valmiki-ramayana-1-sarga-66-shlok-4-1",
    "collectionId": "valmiki-ramayana",
    "index": 2709,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 66, श्लोक 4",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-66-shlok-4-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "अरिष्टनेमिनः पुत्रो वैनतेयो महाबलः।",
          "गरुत्मानिव विख्यात उत्तमः सर्वपक्षिणाम्॥४॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-66",
    "chapterName": "बालकाण्ड, सर्ग 66",
    "verseNumber": 4
  },
  {
    "id": "valmiki-ramayana-1-sarga-66-shlok-5",
    "collectionId": "valmiki-ramayana",
    "index": 2710,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 66, श्लोक 5",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-66-shlok-5",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "बहुशो हि मया दृष्टः सागरे स महाबलः।",
          "भुजङ्गानुद्धरन् पक्षी महाबाहुर्महाबलः॥५॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-66",
    "chapterName": "बालकाण्ड, सर्ग 66",
    "verseNumber": 5
  },
  {
    "id": "valmiki-ramayana-1-sarga-66-shlok-6-1",
    "collectionId": "valmiki-ramayana",
    "index": 2711,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 66, श्लोक 6",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-66-shlok-6-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "पक्षयोर्यद् बलं तस्य भुजवीर्यबलं तव।",
          "विक्रमश्चापि वेगश्च न ते तेनापहीयते॥६॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-66",
    "chapterName": "बालकाण्ड, सर्ग 66",
    "verseNumber": 6
  },
  {
    "id": "valmiki-ramayana-1-sarga-66-shlok-7-1",
    "collectionId": "valmiki-ramayana",
    "index": 2712,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 66, श्लोक 7",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-66-shlok-7-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "बलं बुद्धिश्च तेजश्च सत्त्वं च हरिपुङ्गव।",
          "विशिष्टं सर्वभूतेषु किमात्मानं न सज्जसे॥७॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-66",
    "chapterName": "बालकाण्ड, सर्ग 66",
    "verseNumber": 7
  },
  {
    "id": "valmiki-ramayana-1-sarga-66-shlok-8",
    "collectionId": "valmiki-ramayana",
    "index": 2713,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 66, श्लोक 8",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-66-shlok-8",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "अप्सराऽप्सरसां श्रेष्ठा विख्याता पुञ्जिकस्थला।",
          "अञ्जनेति परिख्याता पत्नी केसरिणो हरेः॥८॥",
          "विख्याता त्रिषु लोकेषु रूपेणाप्रतिमा भुवि।",
          "अभिशापादभूत् तात कपित्वे कामरूपिणी॥९॥",
          "दुहिता वानरेन्द्रस्य कुञ्जरस्य महात्मनः।"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-66",
    "chapterName": "बालकाण्ड, सर्ग 66",
    "verseNumber": 8
  },
  {
    "id": "valmiki-ramayana-1-sarga-66-shlok-10",
    "collectionId": "valmiki-ramayana",
    "index": 2714,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 66, श्लोक 10",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-66-shlok-10",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "दक्षयज्ञवधे पूर्वं धनुरायम्य वीर्यवान्।",
          "विध्वंस्य त्रिदशान् रोषात् सलीलमिदमब्रवीत्॥",
          "यस्माद् भागार्थिनो भागं नाकल्पयत मे सुराः।",
          "वरांगानि महार्हाणि धनुषा शातयामि वः॥१०॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-66",
    "chapterName": "बालकाण्ड, सर्ग 66",
    "verseNumber": 10
  },
  {
    "id": "valmiki-ramayana-1-sarga-66-shlok-11",
    "collectionId": "valmiki-ramayana",
    "index": 2715,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 66, श्लोक 11",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-66-shlok-11",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "मानुषं विग्रहं कृत्वा रूपयौवनशालिनी॥१०॥",
          "विचित्रमाल्याभरणा कदाचित् क्षौमधारिणी।",
          "अचरत् पर्वतस्याग्रे प्रावृडम्बुदसंनिभे॥११॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-66",
    "chapterName": "बालकाण्ड, सर्ग 66",
    "verseNumber": 11
  },
  {
    "id": "valmiki-ramayana-1-sarga-66-shlok-12",
    "collectionId": "valmiki-ramayana",
    "index": 2716,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 66, श्लोक 12",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-66-shlok-12",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "तस्या वस्त्रं विशालाक्ष्याः पीतं रक्तदशं शुभम्।",
          "स्थितायाः पर्वतस्याग्रे मारुतोऽपाहरच्छनैः॥१२॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-66",
    "chapterName": "बालकाण्ड, सर्ग 66",
    "verseNumber": 12
  },
  {
    "id": "valmiki-ramayana-1-sarga-66-shlok-13",
    "collectionId": "valmiki-ramayana",
    "index": 2717,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 66, श्लोक 13",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-66-shlok-13",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "स ददर्श ततस्तस्या वृत्तावूरू सुसंहतौ।",
          "स्तनौ च पीनौ सहितौ सुजातं चारु चाननम्॥१३॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-66",
    "chapterName": "बालकाण्ड, सर्ग 66",
    "verseNumber": 13
  },
  {
    "id": "valmiki-ramayana-1-sarga-66-shlok-14",
    "collectionId": "valmiki-ramayana",
    "index": 2718,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 66, श्लोक 14",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-66-shlok-14",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "तां बलादायतश्रोणी तनुमध्यां यशस्विनीम्।",
          "दृष्ट्वैव शुभसर्वाङ्गीं पवनः काममोहितः॥१४॥",
          "स तां भुजाभ्यां दीर्घाभ्यां पर्यष्वजत मारुतः।",
          "मन्मथाविष्टसर्वाङ्गो गतात्मा तामनिन्दिताम्॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-66",
    "chapterName": "बालकाण्ड, सर्ग 66",
    "verseNumber": 14
  },
  {
    "id": "valmiki-ramayana-1-sarga-66-shlok-16",
    "collectionId": "valmiki-ramayana",
    "index": 2719,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 66, श्लोक 16",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-66-shlok-16",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "सा तु तत्रैव सम्भ्रान्ता सुव्रता वाक्यमब्रवीत्।"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-66",
    "chapterName": "बालकाण्ड, सर्ग 66",
    "verseNumber": 16
  },
