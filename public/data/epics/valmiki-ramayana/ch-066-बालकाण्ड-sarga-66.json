    "slug": "valmiki-ramayana-1-sarga-66-shlok-19-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "महासत्त्वो महातेजा महाबलपराक्रमः।",
          "लङ्घने प्लवने चैव भविष्यति मया समः॥१९॥"
        ]
      }
