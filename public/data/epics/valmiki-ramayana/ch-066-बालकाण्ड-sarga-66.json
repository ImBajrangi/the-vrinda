    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "एवमुक्ता ततस्तुष्टा जननी ते महाकपे।",
          "गुहायां त्वां महाबाहो प्रजज्ञे प्लवगर्षभ॥२०॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-66",
    "chapterName": "बालकाण्ड, सर्ग 66",
    "verseNumber": 20
  },
