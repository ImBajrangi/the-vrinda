    "slug": "valmiki-ramayana-5-sarga-6-shlok-31",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "राक्षसांश्च महाकायान् नानाप्रहरणोधतान्।",
          "रक्तान् श्वेतान् सितांश्चापि हरीश्चापि महाजवान्॥३१॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-6",
    "chapterName": "सुन्दरकाण्ड, सर्ग 6",
    "verseNumber": 31
  },
  {
