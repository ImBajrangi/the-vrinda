        "stanzaNumber": 1,
        "linesDevanagari": [
          "सर्वेषां समतिक्रम्य भवनानि समन्ततः।",
          "आससादाथ लक्ष्मीवान् राक्षसेन्द्रनिवेशनम्॥२८॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-6",
    "chapterName": "सुन्दरकाण्ड, सर्ग 6",
    "verseNumber": 28
  },
