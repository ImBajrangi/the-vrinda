    "slug": "valmiki-ramayana-5-sarga-62-shlok-9",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "मधूनि द्रोणमात्राणि बाहुभिः परिगृह्य ते।",
          "पिबन्ति कपयः केचित् सङ्घशस्तत्र हृष्टवत्॥९॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-62",
    "chapterName": "सुन्दरकाण्ड, सर्ग 62",
    "verseNumber": 9
  },
  {
