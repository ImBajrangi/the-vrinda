    "titleDevanagari": "वाल्मीकि रामायण, सुन्दरकाण्ड, सर्ग 62, श्लोक 1",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-5-sarga-62-shlok-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "तानुवाच हरिश्रेष्ठो हनूमान् वानरर्षभः।",
          "अव्यग्रमनसो यूयं मधु सेवत वानराः॥१॥",
          "अहमावर्जयिष्यामि युष्माकं परिपन्थिनः।"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-62",
    "chapterName": "सुन्दरकाण्ड, सर्ग 62",
    "verseNumber": 1
  },
  {
    "id": "valmiki-ramayana-5-sarga-62-shlok-2",
    "collectionId": "valmiki-ramayana",
    "index": 11069,
    "titleDevanagari": "वाल्मीकि रामायण, सुन्दरकाण्ड, सर्ग 62, श्लोक 2",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-5-sarga-62-shlok-2",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "श्रुत्वा हनूमतो वाक्यं हरीणां प्रवरोऽङ्गदः॥२॥",
          "प्रत्युवाच प्रसन्नात्मा पिबन्तु हरयो मधु।",
          "अवश्यं कृतकार्यस्य वाक्यं हनुमतो मया॥३॥",
          "अकार्यमपि कर्तव्यं किमळं पुनरीदृशम्।।"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-62",
    "chapterName": "सुन्दरकाण्ड, सर्ग 62",
    "verseNumber": 2
  },
  {
    "id": "valmiki-ramayana-5-sarga-62-shlok-4",
    "collectionId": "valmiki-ramayana",
    "index": 11070,
    "titleDevanagari": "वाल्मीकि रामायण, सुन्दरकाण्ड, सर्ग 62, श्लोक 4",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-5-sarga-62-shlok-4",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "अङ्गदस्य मुखाच्छ्रुत्वा वचनं वानरर्षभाः॥४॥",
          "साधु साध्विति संहृष्टा वानराः प्रत्यपूजयन्।"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-62",
    "chapterName": "सुन्दरकाण्ड, सर्ग 62",
    "verseNumber": 4
  },
  {
    "id": "valmiki-ramayana-5-sarga-62-shlok-5",
    "collectionId": "valmiki-ramayana",
    "index": 11071,
    "titleDevanagari": "वाल्मीकि रामायण, सुन्दरकाण्ड, सर्ग 62, श्लोक 5",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-5-sarga-62-shlok-5",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "पूजयित्वाङ्गदं सर्वे वानरा वानरर्षभम्॥५॥",
          "जग्मुर्मधुवनं यत्र नदीवेग इव द्रुमम्।"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-62",
    "chapterName": "सुन्दरकाण्ड, सर्ग 62",
    "verseNumber": 5
  },
  {
    "id": "valmiki-ramayana-5-sarga-62-shlok-7",
