        "stanzaNumber": 1,
        "linesDevanagari": [
          "अत्यर्थं च मदग्लानाः पर्णान्यास्तीर्य शेरते।",
          "उन्मत्तवेगाः प्लवगा मधुमत्ताश्च हृष्टवत्॥१२॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-62",
    "chapterName": "सुन्दरकाण्ड, सर्ग 62",
    "verseNumber": 12
  },
