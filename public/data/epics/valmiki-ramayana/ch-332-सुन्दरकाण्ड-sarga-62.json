    "slug": "valmiki-ramayana-5-sarga-62-shlok-7",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "ते प्रविष्टा मधुवनं पालानाक्रम्य शक्तितः॥६॥",
          "अतिसर्गाच्च पटवो दृष्ट्वा श्रुत्वा च मैथिलीम्।",
          "पपुः सर्वे मधु तदा रसवत् फलमाददुः॥७॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-62",
    "chapterName": "सुन्दरकाण्ड, सर्ग 62",
    "verseNumber": 7
  },
  {
    "id": "valmiki-ramayana-5-sarga-62-shlok-8",
    "collectionId": "valmiki-ramayana",
    "index": 11073,
    "titleDevanagari": "वाल्मीकि रामायण, सुन्दरकाण्ड, सर्ग 62, श्लोक 8",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-5-sarga-62-shlok-8",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "उत्पत्य च ततः सर्वे वनपालान् समागतान्।",
          "ते ताडयन्तः शतशः सक्ता मधुवने तदा॥८॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-62",
    "chapterName": "सुन्दरकाण्ड, सर्ग 62",
    "verseNumber": 8
  },
  {
