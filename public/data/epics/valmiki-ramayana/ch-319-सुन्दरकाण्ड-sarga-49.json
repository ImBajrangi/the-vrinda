    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "वज्रसंयोगसंयुक्तैर्महार्हमणिविग्रहैः ।",
          "हैमैराभरणैश्चित्रैर्मनसेव प्रकल्पितैः॥३॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-49",
    "chapterName": "सुन्दरकाण्ड, सर्ग 49",
    "verseNumber": 3
  },
  {
