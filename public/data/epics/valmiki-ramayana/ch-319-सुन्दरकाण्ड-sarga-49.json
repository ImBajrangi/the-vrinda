    "slug": "valmiki-ramayana-5-sarga-49-shlok-12",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "दुर्धरेण प्रहस्तेन महापाइँन रक्षसा।",
          "मन्त्रिभिर्मन्त्रतत्त्वज्ञैर्निकुम्भेन च मन्त्रिणा॥११॥",
          "उपोपविष्टं रक्षोभिश्चतुर्भिर्बलदर्पितम्।",
          "कृत्स्नं परिवृतं लोकं चतुर्भिरिव सागरैः॥१२॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-49",
    "chapterName": "सुन्दरकाण्ड, सर्ग 49",
    "verseNumber": 12
  },
  {
    "id": "valmiki-ramayana-5-sarga-49-shlok-13",
    "collectionId": "valmiki-ramayana",
    "index": 10575,
    "titleDevanagari": "वाल्मीकि रामायण, सुन्दरकाण्ड, सर्ग 49, श्लोक 13",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-5-sarga-49-shlok-13",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "मन्त्रिभिर्मन्त्रतत्त्वज्ञैरन्यैश्च शुभदर्शिभिः।",
          "आश्वास्यमानं सचिवैः सुरैरिव सुरेश्वरम्॥१३॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-49",
    "chapterName": "सुन्दरकाण्ड, सर्ग 49",
    "verseNumber": 13
  },
