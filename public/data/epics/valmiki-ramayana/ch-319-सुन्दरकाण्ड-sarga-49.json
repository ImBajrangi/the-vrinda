    "index": 10568,
    "titleDevanagari": "वाल्मीकि रामायण, सुन्दरकाण्ड, सर्ग 49, श्लोक 5",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-5-sarga-49-shlok-5",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "विचित्रं दर्शनीयैश्च रक्ताक्षैर्भीमदर्शनैः।",
          "दीप्ततीक्ष्णमहादंष्ट्र प्रलम्बं दशनच्छदैः॥५॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-49",
    "chapterName": "सुन्दरकाण्ड, सर्ग 49",
    "verseNumber": 5
  },
  {
