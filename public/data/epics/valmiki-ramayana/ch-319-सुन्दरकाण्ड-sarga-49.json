    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "महार्हक्षौमसंवीतं रक्तचन्दनरूषितम्।",
          "स्वनुलिप्तं विचित्राभिर्विविधाभिश्च भक्तिभिः॥४॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-49",
    "chapterName": "सुन्दरकाण्ड, सर्ग 49",
    "verseNumber": 4
  },
  {
