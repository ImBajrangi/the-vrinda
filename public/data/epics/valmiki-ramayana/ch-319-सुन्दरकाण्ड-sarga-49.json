        "linesDevanagari": [
          "बाहुभिर्बद्धकेयूरैश्चन्दनोत्तमरूषितैः।",
          "भ्राजमानाङ्गदैर्भीमैः पञ्चशीरिवोरगैः॥८॥"
        ]
      }
