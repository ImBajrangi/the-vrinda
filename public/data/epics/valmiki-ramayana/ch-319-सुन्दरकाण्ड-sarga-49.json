    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "शिरोभिर्दशभिर्वीरो भ्राजमानं महौजसम्।",
          "नानाव्यालसमाकीर्णैः शिखरैरिव मन्दरम्॥६॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-49",
    "chapterName": "सुन्दरकाण्ड, सर्ग 49",
    "verseNumber": 6
  },
