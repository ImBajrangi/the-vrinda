        "stanzaNumber": 1,
        "linesDevanagari": [
          "अपश्यद् राक्षसपतिं हनूमानतितेजसम्।",
          "वेष्टितं मेरुशिखरे सतोयमिव तोयदम्॥१४॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-49",
    "chapterName": "सुन्दरकाण्ड, सर्ग 49",
    "verseNumber": 14
  },
