    "slug": "valmiki-ramayana-5-sarga-49-shlok-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "ततः स कर्मणा तस्य विस्मितो भीमविक्रमः।",
          "हनूमान् क्रोधताम्राक्षो रक्षोऽधिपमवैक्षत ॥१॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-49",
    "chapterName": "सुन्दरकाण्ड, सर्ग 49",
    "verseNumber": 1
  },
  {
