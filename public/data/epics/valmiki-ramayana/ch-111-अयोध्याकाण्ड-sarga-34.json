        "linesDevanagari": [
          "स सत्यवाक्यो धर्मात्मा गाम्भीर्यात् सागरोपमः।",
          "आकाश इव निष्पङ्को नरेन्द्रः प्रत्युवाच तम्॥९॥"
        ]
      }
    ],
    "chapterId": "अयोध्याकाण्ड-sarga-34",
    "chapterName": "अयोध्याकाण्ड, सर्ग 34",
    "verseNumber": 9
  },
