        "stanzaNumber": 1,
        "linesDevanagari": [
          "सुमन्त्रानय मे दारान् ये केचिदिह मामकाः।",
          "दारैः परिवृतः सर्वैर्द्रष्टमिच्छामि राघवम्॥१०॥"
        ]
      }
