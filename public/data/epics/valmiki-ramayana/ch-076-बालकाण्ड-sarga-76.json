    "slug": "valmiki-ramayana-1-sarga-76-shlok-12",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "तेजोभिर्गतवीर्यत्वाज्जामदग्न्यो जडीकृतः।",
          "रामं कमलपत्राक्षं मन्दं मन्दमुवाच ह॥१२॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-76",
    "chapterName": "बालकाण्ड, सर्ग 76",
    "verseNumber": 12
  },
