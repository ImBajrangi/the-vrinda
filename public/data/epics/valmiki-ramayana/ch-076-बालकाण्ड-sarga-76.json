    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "जडीकृते तदा लोके रामे वरधनुर्धरे।",
          "निर्वीर्यो जामदग्न्योऽसौ रामो राममुदैक्षत॥११॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-76",
    "chapterName": "बालकाण्ड, सर्ग 76",
    "verseNumber": 11
  },
  {
    "id": "valmiki-ramayana-1-sarga-76-shlok-12",
