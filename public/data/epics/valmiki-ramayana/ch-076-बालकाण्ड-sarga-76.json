    "slug": "valmiki-ramayana-1-sarga-76-shlok-14",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "सोऽहं गुरुवचः कुर्वन् पृथिव्यां न वसे निशाम्।",
          "तदाप्रभृति काकुत्स्थ कृता मे काश्यपस्य ह॥ १४॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-76",
    "chapterName": "बालकाण्ड, सर्ग 76",
    "verseNumber": 14
