    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 76, श्लोक 1",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-76-shlok-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "श्रुत्वा तु जामदग्न्यस्य वाक्यं दाशरथिस्तदा।",
          "गौरवाद्यन्त्रितकथः पितू राममथाब्रवीत्॥१॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-76",
    "chapterName": "बालकाण्ड, सर्ग 76",
    "verseNumber": 1
  },
  {
    "id": "valmiki-ramayana-1-sarga-76-shlok-2",
    "collectionId": "valmiki-ramayana",
    "index": 2951,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 76, श्लोक 2",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-76-shlok-2",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "कृतवानसि यत् कर्म श्रुतवानस्मि भार्गव।",
          "अनुरुध्यामहे ब्रह्मन् पितुरानृण्यमास्थितः॥२॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-76",
    "chapterName": "बालकाण्ड, सर्ग 76",
    "verseNumber": 2
  },
  {
    "id": "valmiki-ramayana-1-sarga-76-shlok-3",
    "collectionId": "valmiki-ramayana",
    "index": 2952,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 76, श्लोक 3",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-76-shlok-3",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "वीर्यहीनमिवाशक्तं क्षत्रधर्मेण भार्गव।",
          "अवजानासि मे तेजः पश्य मेऽद्य पराक्रमम्॥३॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-76",
    "chapterName": "बालकाण्ड, सर्ग 76",
    "verseNumber": 3
  },
  {
    "id": "valmiki-ramayana-1-sarga-76-shlok-4",
    "collectionId": "valmiki-ramayana",
    "index": 2953,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 76, श्लोक 4",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-76-shlok-4",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "इत्युक्त्वा राघवः क्रुद्धो भार्गवस्य वरायुधम्।",
          "शरं च प्रतिजग्राह हस्ताल्लघुपराक्रमः॥४॥",
          "आरोप्य स धनू रामः शरं सज्यं चकार ह।",
          "जामदग्न्यं ततो रामं रामः क्रुद्धोऽब्रवीदिदम्॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-76",
    "chapterName": "बालकाण्ड, सर्ग 76",
    "verseNumber": 4
  },
  {
    "id": "valmiki-ramayana-1-sarga-76-shlok-6",
    "collectionId": "valmiki-ramayana",
    "index": 2954,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 76, श्लोक 6",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-76-shlok-6",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "ब्राह्मणोऽसीति पूज्यो मे विश्वामित्रकृतेन च।",
          "तस्माच्छक्तो न ते राम मोक्तुं प्राणहरं शरम्॥६॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-76",
    "chapterName": "बालकाण्ड, सर्ग 76",
    "verseNumber": 6
  },
  {
    "id": "valmiki-ramayana-1-sarga-76-shlok-8",
    "collectionId": "valmiki-ramayana",
    "index": 2955,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 76, श्लोक 8",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-76-shlok-8",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "इमां वा त्वद्गतिं राम तपोबलसमर्जितान्।",
          "लोकानप्रतिमान् वापि हनिष्यामीति मे मतिः॥ ७॥",
          "न ह्ययं वैष्णवो दिव्यः शरः परपुरंजयः।",
          "मोघः पतति वीर्येण बलदर्पविनाशनः॥८॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-76",
    "chapterName": "बालकाण्ड, सर्ग 76",
    "verseNumber": 8
  },
  {
    "id": "valmiki-ramayana-1-sarga-76-shlok-9",
    "collectionId": "valmiki-ramayana",
    "index": 2956,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 76, श्लोक 9",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-76-shlok-9",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "वरायुधधरं रामं द्रष्टुं सर्षिगणाः सुराः।",
          "पितामहं पुरस्कृत्य समेतास्तत्र सर्वशः॥९॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-76",
    "chapterName": "बालकाण्ड, सर्ग 76",
    "verseNumber": 9
  },
  {
    "id": "valmiki-ramayana-1-sarga-76-shlok-10",
