    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "काश्यपाय मया दत्ता यदा पूर्वं वसुंधरा।",
          "विषये मे न वस्तव्यमिति मां काश्यपोऽब्रवीत्॥ १३॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-76",
    "chapterName": "बालकाण्ड, सर्ग 76",
    "verseNumber": 13
  },
  {
