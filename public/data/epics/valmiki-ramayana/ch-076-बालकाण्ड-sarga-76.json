      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "गन्धर्वाप्सरसश्चैव सिद्धचारणकिन्नराः।",
          "यक्षराक्षसनागाश्च तद् द्रष्टुं महदद्भुतम्॥१०॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-76",
    "chapterName": "बालकाण्ड, सर्ग 76",
    "verseNumber": 10
  },
  {
