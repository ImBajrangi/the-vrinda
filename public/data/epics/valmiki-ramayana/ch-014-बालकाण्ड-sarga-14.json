    "slug": "valmiki-ramayana-1-sarga-14-shlok-8-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "कृताभिज्ञानचिह्नस्त्वमनया गजसाह्वया॥८॥",
          "लक्ष्मणेन समुत्पाट्य एषा कण्ठे कृता तव।",
          "शोभसेऽप्यधिकं वीर लतया कण्ठसक्तया॥९॥",
          "विपरीत इवाकाशे सूर्यो नक्षत्रमालया।"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-14",
    "chapterName": "बालकाण्ड, सर्ग 14",
    "verseNumber": 8
  },
  {
