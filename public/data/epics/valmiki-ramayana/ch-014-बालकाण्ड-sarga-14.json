    "index": 708,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 14, श्लोक 14",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-14-shlok-14",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "॥ श्रीसीतारामचन्द्राभ्यां नमः॥",
          "श्रीमद्वाल्मीकीय रामायण",
          "उत्तरकाण्डम्",
          "चतुर्दशः सर्गः (सर्ग 14)",
          "स महात्मा समुद्यम्य कालदण्डोपमां गदाम्।",
          "प्रविवेश ततः सैन्यं नयन् यक्षान् यमक्षयम्॥१४॥",
          "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये उत्तरकाण्डे चतुर्दशः सर्गः॥१४॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-14",
    "chapterName": "बालकाण्ड, सर्ग 14",
    "verseNumber": 14
  },
  {
    "id": "valmiki-ramayana-1-sarga-14-shlok-15-1",
    "collectionId": "valmiki-ramayana",
    "index": 709,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 14, श्लोक 15",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-14-shlok-15-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "अनृतं नोक्तपूर्वं मे चिरं कृच्छ्रेऽपि तिष्ठता॥१४॥",
          "धर्मलोभपरीतेन न च वक्ष्ये कथंचन।",
          "सफलां च करिष्यामि प्रतिज्ञा जहि संभ्रमम्॥ १५॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-14",
    "chapterName": "बालकाण्ड, सर्ग 14",
    "verseNumber": 15
  },
  {
