    "slug": "valmiki-ramayana-1-sarga-14-shlok-10-2",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "ये तु ते राक्षसेन्द्रस्य सचिवा घोरविक्रमाः।",
          "तेषां सहस्रमेकैको यक्षाणां समयोधयत्॥१०॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-14",
    "chapterName": "बालकाण्ड, सर्ग 14",
    "verseNumber": 10
  },
  {
