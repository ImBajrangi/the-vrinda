    "index": 710,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 14, श्लोक 16",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-14-shlok-16-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "प्रसूतं कलमक्षेत्रं वर्षेणेव शतक्रतुः।",
          "तदाह्वाननिमित्तं च वालिनो हेममालिनः॥१६॥",
          "सुग्रीव कुरु तं शब्दं निष्पतेद् येन वानरः।",
          "जितकाशी जयश्लाघी त्वया चाधर्षितः पुरात्॥ १७॥",
          "निष्पतिष्यत्यसक्रेन वाली स प्रियसंयुगः।"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-14",
    "chapterName": "बालकाण्ड, सर्ग 14",
    "verseNumber": 16
  },
