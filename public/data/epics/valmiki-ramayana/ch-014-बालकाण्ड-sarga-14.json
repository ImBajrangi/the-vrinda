    "slug": "valmiki-ramayana-1-sarga-14-shlok-4",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "गर्जन्निव महामेघो वायुवेगपुरःसरः।",
          "अथ बालार्कसदृशो दृप्तसिंहगतिस्ततः॥४॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-14",
    "chapterName": "बालकाण्ड, सर्ग 14",
    "verseNumber": 4
  },
  {
    "id": "valmiki-ramayana-1-sarga-14-shlok-5-1",
    "collectionId": "valmiki-ramayana",
    "index": 699,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 14, श्लोक 5",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-14-shlok-5-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "दृष्ट्वा रामं क्रियादक्षं सुग्रीवो वाक्यमब्रवीत्।",
          "हरिवागुरया व्याप्तां तप्तकाञ्चनतोरणाम्॥५॥",
          "प्राप्ताः स्म ध्वजयन्त्राढ्यां किष्किन्धां वालिनः",
          "पुरीम्। प्रतिज्ञा या कृता वीर त्वया वालिवधे पुरा॥६॥",
          "सफलां कुरु तां क्षिप्रं लतां काल इवागतः।"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-14",
    "chapterName": "बालकाण्ड, सर्ग 14",
    "verseNumber": 5
  },
  {
