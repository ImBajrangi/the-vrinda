    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "ते गत्वा सर्वमाचख्यु तुस्तस्य चिकीर्षितम्।",
          "अनुज्ञाता ययुर्हृष्टा युद्धाय धनदेन ते॥६॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-14",
    "chapterName": "बालकाण्ड, सर्ग 14",
    "verseNumber": 6
  },
