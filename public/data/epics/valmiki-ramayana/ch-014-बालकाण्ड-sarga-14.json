    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 14, श्लोक 11",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-14-shlok-11",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "मम दर्शय सुग्रीव वैरिणं भ्रातृरूपिणम्॥११॥",
          "वाली विनिहतो यावदने पांसुषु चेष्टते।"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-14",
    "chapterName": "बालकाण्ड, सर्ग 14",
    "verseNumber": 11
  },
  {
    "id": "valmiki-ramayana-1-sarga-14-shlok-12",
