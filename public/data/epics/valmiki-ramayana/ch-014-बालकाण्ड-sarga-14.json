    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-14-shlok-7-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "एवमुक्तस्तु धर्मात्मा सुग्रीवेण स राघवः॥७॥",
          "तमेवोवाच वचनं सुग्रीवं शत्रुसूदनः।"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-14",
    "chapterName": "बालकाण्ड, सर्ग 14",
    "verseNumber": 7
  },
