    "collectionId": "valmiki-ramayana",
    "index": 707,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 14, श्लोक 13",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-14-shlok-13-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "न चकार व्यथां चैव यक्षशस्त्रैः समाहतः।",
          "महीधर इवाम्भोदैर्धाराशतसमुक्षितः॥१३॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-14",
    "chapterName": "बालकाण्ड, सर्ग 14",
    "verseNumber": 13
  },
  {
    "id": "valmiki-ramayana-1-sarga-14-shlok-14",
