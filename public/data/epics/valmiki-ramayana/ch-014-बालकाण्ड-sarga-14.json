[
  {
    "id": "valmiki-ramayana-1-sarga-14-shlok-1",
    "collectionId": "valmiki-ramayana",
    "index": 695,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 14, श्लोक 1",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-14-shlok-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "सर्वे ते त्वरितं गत्वा किष्किन्धां वालिनः पुरीम्।",
          "वृक्षरात्मानमावृत्य व्यतिष्ठन् गहने वने॥१॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-14",
    "chapterName": "बालकाण्ड, सर्ग 14",
    "verseNumber": 1
  },
  {
    "id": "valmiki-ramayana-1-sarga-14-shlok-2",
    "collectionId": "valmiki-ramayana",
    "index": 696,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 14, श्लोक 2",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-14-shlok-2",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "ततः स सचिवैः सार्धं षड्भिनित्यबलोद्धतः।",
          "महोदरप्रहस्ताभ्यां मारीचशुकसारणैः॥१॥",
          "धूम्राक्षेण च वीरेण नित्यं समरगर्द्धिना।",
          "वृतः सम्प्रययौ श्रीमान् क्रोधाल्लोकान् दहन्निव॥२॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-14",
    "chapterName": "बालकाण्ड, सर्ग 14",
    "verseNumber": 2
  },
  {
    "id": "valmiki-ramayana-1-sarga-14-shlok-3-1",
    "collectionId": "valmiki-ramayana",
    "index": 697,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 14, श्लोक 3",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-14-shlok-3-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "ततस्तु निनदं घोरं कृत्वा युद्धाय चाह्वयत्।",
          "परिवारैः परिवृतो नादैभिन्दन्निवाम्बरम्॥३॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-14",
    "chapterName": "बालकाण्ड, सर्ग 14",
    "verseNumber": 3
  },
  {
    "id": "valmiki-ramayana-1-sarga-14-shlok-4",
