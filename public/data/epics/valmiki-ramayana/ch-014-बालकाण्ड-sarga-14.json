    "slug": "valmiki-ramayana-1-sarga-14-shlok-9",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "स दृष्ट्वा तादृशं सैन्यं दशग्रीवो निशाचरः।",
          "हर्षनादान् बहून् कृत्वा स क्रोधादभ्यधावत॥९॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-14",
    "chapterName": "बालकाण्ड, सर्ग 14",
    "verseNumber": 9
  },
  {
