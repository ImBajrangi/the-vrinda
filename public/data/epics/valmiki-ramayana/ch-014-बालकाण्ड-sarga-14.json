    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "रिपूणां धर्षितं श्रुत्वा मर्षयन्ति न संयुगे॥१८॥",
          "जानन्तस्तु स्वकं वीर्यं स्त्रीसमक्षं विशेषतः।"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-14",
    "chapterName": "बालकाण्ड, सर्ग 14",
    "verseNumber": 18
  },
  {
    "id": "valmiki-ramayana-1-sarga-14-shlok-19-1",
    "collectionId": "valmiki-ramayana",
