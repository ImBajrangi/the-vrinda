    "slug": "valmiki-ramayana-2-sarga-26-shlok-2",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "विराजयन् राजसुतो राजमार्ग नरैर्वृतम्।",
          "हृदयान्याममन्थेव जनस्य गुणवत्तया॥२॥"
        ]
      }
    ],
    "chapterId": "अयोध्याकाण्ड-sarga-26",
