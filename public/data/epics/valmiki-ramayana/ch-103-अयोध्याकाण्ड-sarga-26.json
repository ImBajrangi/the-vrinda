    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "देवकार्यं स्म सा कृत्वा कृतज्ञा हृष्टचेतना।",
          "अभिज्ञा राजधर्माणां राजपुत्री प्रतीक्षति॥४॥"
        ]
      }
    ],
    "chapterId": "अयोध्याकाण्ड-sarga-26",
    "chapterName": "अयोध्याकाण्ड, सर्ग 26",
    "verseNumber": 4
  },
  {
