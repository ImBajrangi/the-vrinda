    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "अभिवाद्य तु कौसल्यां रामः सम्प्रस्थितो वनम्।",
          "कृतस्वस्त्ययनो मात्रा धर्मिष्ठे वर्त्मनि स्थितः॥१॥"
        ]
      }
    ],
    "chapterId": "अयोध्याकाण्ड-sarga-26",
    "chapterName": "अयोध्याकाण्ड, सर्ग 26",
    "verseNumber": 1
  },
