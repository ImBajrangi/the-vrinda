    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "तां दृष्ट्वा स हि धर्मात्मा न शशाक मनोगतम्।",
          "तं शोकं राघवः सोढुं ततो विवृततां गतः॥७॥"
        ]
      }
    ],
    "chapterId": "अयोध्याकाण्ड-sarga-26",
    "chapterName": "अयोध्याकाण्ड, सर्ग 26",
    "verseNumber": 7
  },
