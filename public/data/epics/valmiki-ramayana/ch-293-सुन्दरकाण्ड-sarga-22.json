    "collectionId": "valmiki-ramayana",
    "index": 9703,
    "titleDevanagari": "वाल्मीकि रामायण, सुन्दरकाण्ड, सर्ग 22, श्लोक 27",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-5-sarga-22-shlok-27",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "ताभ्यां स परिपूर्णाभ्यां भुजाभ्यां राक्षसेश्वरः।",
          "शुशुभेऽचलसंकाशः शृंगाभ्यामिव मन्दरः॥२७॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-22",
    "chapterName": "सुन्दरकाण्ड, सर्ग 22",
    "verseNumber": 27
  },
  {
