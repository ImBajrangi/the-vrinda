        "linesDevanagari": [
          "यथा यथा सान्त्वयिता वश्यः स्त्रीणां तथा तथा।",
          "यथा यथा प्रियं वक्ता परिभूतस्तथा तथा॥२॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-22",
    "chapterName": "सुन्दरकाण्ड, सर्ग 22",
    "verseNumber": 2
