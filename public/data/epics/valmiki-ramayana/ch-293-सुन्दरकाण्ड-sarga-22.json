    "slug": "valmiki-ramayana-5-sarga-22-shlok-28",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "तरुणादित्यवर्णाभ्यां कुण्डलाभ्यां विभूषितः।",
          "रक्तपल्लवपुष्पाभ्यामशोकाभ्यामिवाचलः॥२८॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-22",
    "chapterName": "सुन्दरकाण्ड, सर्ग 22",
    "verseNumber": 28
  },
