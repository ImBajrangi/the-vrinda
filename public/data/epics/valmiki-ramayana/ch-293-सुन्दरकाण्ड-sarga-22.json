    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "सीताया वचनं श्रुत्वा रावणो राक्षसाधिपः।",
          "विवृत्य नयने क्रूर जानकीमन्ववैक्षत॥२३॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-22",
    "chapterName": "सुन्दरकाण्ड, सर्ग 22",
