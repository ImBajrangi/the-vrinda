    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "नीलजीमूतसंकाशो महाभुजशिरोधरः।",
          "सिंहसत्त्वगतिः श्रीमान् दीप्तजिह्वोग्रलोचनः॥२४॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-22",
    "chapterName": "सुन्दरकाण्ड, सर्ग 22",
    "verseNumber": 24
  },
