    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-5-sarga-22-shlok-32",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "इत्युक्त्वा मैथिली राजा रावणः शत्रुरावणः।",
          "संददर्श ततः सर्वा राक्षसी?रदर्शनाः॥३२॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-22",
    "chapterName": "सुन्दरकाण्ड, सर्ग 22",
    "verseNumber": 32
  },
  {
