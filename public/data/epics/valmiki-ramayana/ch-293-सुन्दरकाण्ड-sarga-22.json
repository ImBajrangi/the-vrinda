    "slug": "valmiki-ramayana-5-sarga-22-shlok-29",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "स कल्पवृक्षप्रतिमो वसन्त इव मूर्तिमान्।",
          "श्मशानचैत्यप्रतिमो भूषितोऽपि भयंकरः॥२९॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-22",
    "chapterName": "सुन्दरकाण्ड, सर्ग 22",
    "verseNumber": 29
  },
  {
    "id": "valmiki-ramayana-5-sarga-22-shlok-30",
