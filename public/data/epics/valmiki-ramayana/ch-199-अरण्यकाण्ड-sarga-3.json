          "हन्त वक्ष्यामि ते राजन् निबोध मम राघव॥४॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-3",
    "chapterName": "अरण्यकाण्ड, सर्ग 3",
    "verseNumber": 4
  },
