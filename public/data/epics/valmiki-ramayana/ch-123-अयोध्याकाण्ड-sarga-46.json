      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "अद्यायोध्या तु नगरी राजधानी पितुर्मम।",
          "सस्त्रीपुंसा गतानस्मान् शोचिष्यति न संशयः॥ ४॥",
          "अयोध्या"
        ]
      }
    ],
    "chapterId": "अयोध्याकाण्ड-sarga-46",
    "chapterName": "अयोध्याकाण्ड, सर्ग 46",
    "verseNumber": 4
  },
  {
