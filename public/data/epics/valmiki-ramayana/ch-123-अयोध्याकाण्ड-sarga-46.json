    "slug": "valmiki-ramayana-2-sarga-46-shlok-5",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "अनुरक्ता हि मनुजा राजानं बहुभिर्गुणैः।",
          "त्वां च मां च नरव्याघ्र शत्रुघ्नभरतौ तथा॥५॥",
          "‘पुरुषसिंह!",
          "अयोध्या",
          "पितरं चानुशोचामि मातरं च यशस्विनीम्।",
          "अपि नान्धौ भवेतां नौ रुदन्तौ तावभीक्ष्णशः॥"
        ]
      }
    ],
    "chapterId": "अयोध्याकाण्ड-sarga-46",
    "chapterName": "अयोध्याकाण्ड, सर्ग 46",
    "verseNumber": 5
  },
