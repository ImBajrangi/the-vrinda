    "slug": "valmiki-ramayana-6-sarga-37-shlok-10",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "पूर्वं प्रहस्तः सबलो द्वारमासाद्य तिष्ठति।",
          "दक्षिणं च महावीयौँ महापार्श्वमहोदरौ॥१०॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-37",
    "chapterName": "युद्धकाण्ड, सर्ग 37",
    "verseNumber": 10
  },
  {
