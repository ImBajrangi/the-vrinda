    "titleDevanagari": "वाल्मीकि रामायण, युद्धकाण्ड, सर्ग 37, श्लोक 3",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-6-sarga-37-shlok-3",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "नरवानरराजानौ स तु वायुसुतः कपिः।",
          "जाम्बवानृक्षराजश्च राक्षसश्च विभीषणः॥१॥",
          "अङ्गदो वालिपुत्रश्च सौमित्रिः शरभः कपिः।",
          "सुषेणः सहदायादो मैन्दो द्विविद एव च ॥२॥",
          "गजो गवाक्षः कुमुदो नलोऽथ पनसस्तथा।",
          "अमित्रविषयं प्राप्ताः समवेताः समर्थयन्॥३॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-37",
    "chapterName": "युद्धकाण्ड, सर्ग 37",
    "verseNumber": 3
  },
  {
    "id": "valmiki-ramayana-6-sarga-37-shlok-4",
    "collectionId": "valmiki-ramayana",
    "index": 12364,
    "titleDevanagari": "वाल्मीकि रामायण, युद्धकाण्ड, सर्ग 37, श्लोक 4",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-6-sarga-37-shlok-4",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "इयं सा लक्ष्यते लङ्का पुरी रावणपालिता।",
          "सासुरोरगगन्धर्वैरमरैरपि दुर्जया॥४॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-37",
    "chapterName": "युद्धकाण्ड, सर्ग 37",
    "verseNumber": 4
  },
  {
    "id": "valmiki-ramayana-6-sarga-37-shlok-5",
    "collectionId": "valmiki-ramayana",
    "index": 12365,
    "titleDevanagari": "वाल्मीकि रामायण, युद्धकाण्ड, सर्ग 37, श्लोक 5",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-6-sarga-37-shlok-5",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "कार्यसिद्धिं पुरस्कृत्य मन्त्रयध्वं विनिर्णये।",
          "नित्यं संनिहितो यत्र रावणो राक्षसाधिपः॥५॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-37",
    "chapterName": "युद्धकाण्ड, सर्ग 37",
    "verseNumber": 5
  },
  {
