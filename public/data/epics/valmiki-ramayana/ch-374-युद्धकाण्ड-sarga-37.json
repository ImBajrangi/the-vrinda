    "slug": "valmiki-ramayana-6-sarga-37-shlok-14",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "विरूपाक्षस्तु महता शूलखड्गधनुष्मता।",
          "बलेन राक्षसैः सार्धं मध्यमं गुल्ममाश्रितः॥१४॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-37",
    "chapterName": "युद्धकाण्ड, सर्ग 37",
    "verseNumber": 14
  },
