    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-6-sarga-37-shlok-11",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "इन्द्रजित् पश्चिमं द्वारं राक्षसैर्बहुभिर्वृतः।",
          "पट्टिशासिधनुष्मद्भिः शूलमुद्गरपाणिभिः॥११॥",
          "नानाप्रहरणैः शूरैरावृतो रावणात्मजः।"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-37",
    "chapterName": "युद्धकाण्ड, सर्ग 37",
    "verseNumber": 11
  },
  {
