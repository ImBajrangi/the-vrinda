    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-6-sarga-37-shlok-6",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "अथ तेषु ब्रुवाणेषु रावणावरजोऽब्रवीत्।।",
          "वाक्यमग्राम्यपदवत् पुष्कलार्थं विभीषणः॥६॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-37",
    "chapterName": "युद्धकाण्ड, सर्ग 37",
    "verseNumber": 6
  },
  {
    "id": "valmiki-ramayana-6-sarga-37-shlok-7",
