        "stanzaNumber": 1,
        "linesDevanagari": [
          "एतानेवं विधान् गुल्मॉल्लङ्कायां समुदीक्ष्य ते।",
          "मामका मन्त्रिणः सर्वे शीघ्रं पुनरिहागताः॥१५॥"
        ]
      }
    ],
