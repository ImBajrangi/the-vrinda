    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-6-sarga-37-shlok-8",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "भूत्वा शकुनयः सर्वे प्रविष्टाश्च रिपोर्बलम्।",
          "विधानं विहितं यच्च तद् दृष्ट्वा समुपस्थिताः॥८॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-37",
    "chapterName": "युद्धकाण्ड, सर्ग 37",
    "verseNumber": 8
  },
