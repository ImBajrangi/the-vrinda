    "index": 12367,
    "titleDevanagari": "वाल्मीकि रामायण, युद्धकाण्ड, सर्ग 37, श्लोक 7",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-6-sarga-37-shlok-7",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "अनलः पनसश्चैव सम्पातिः प्रमतिस्तथा।",
          "गत्वा लङ्कां ममामात्याः पुरी पुनरिहागताः॥७॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-37",
    "chapterName": "युद्धकाण्ड, सर्ग 37",
    "verseNumber": 7
  },
  {
