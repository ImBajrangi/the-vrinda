    "titleDevanagari": "वाल्मीकि रामायण, युद्धकाण्ड, सर्ग 37, श्लोक 13",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-6-sarga-37-shlok-13",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "राक्षसानां सहस्रेस्तु बहुभिः शस्त्रपाणिभिः॥१२॥",
          "युक्तः परमसंविग्नो राक्षसैः सह मन्त्रवित्।",
          "उत्तरं नगरद्वारं रावणः स्वयमास्थितः॥१३॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-37",
    "chapterName": "युद्धकाण्ड, सर्ग 37",
    "verseNumber": 13
  },
