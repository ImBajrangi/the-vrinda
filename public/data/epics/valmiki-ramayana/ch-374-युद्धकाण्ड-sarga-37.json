    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-6-sarga-37-shlok-9",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "संविधानं यथाहुस्ते रावणस्य दुरात्मनः।",
          "राम तद् ब्रुवतः सर्वं याथातथ्येन मे शृणु॥९॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-37",
    "chapterName": "युद्धकाण्ड, सर्ग 37",
    "verseNumber": 9
  },
