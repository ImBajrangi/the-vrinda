        "stanzaNumber": 1,
        "linesDevanagari": [
          "॥ श्रीसीतारामचन्द्राभ्यां नमः॥",
          "श्रीमद्वाल्मीकीय रामायण",
          "बालकाण्डम्",
          "चतुःसप्ततितमः सर्गः (सर्ग 74)",
          "इत्याचे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये बालकाण्डे चतुःसप्ततितमः सर्गः॥ ७४॥"
        ]
      }
