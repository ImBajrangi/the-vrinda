[
  {
    "id": "valmiki-ramayana-1-sarga-74-shlok-1",
    "collectionId": "valmiki-ramayana",
    "index": 2912,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 74, श्लोक 1",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-74-shlok-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "अथ रात्र्यां व्यतीतायां विश्वामित्रो महामुनिः।",
          "आपृष्ट्वा तौ च राजानौ जगामोत्तरपर्वतम्॥१॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-74",
    "chapterName": "बालकाण्ड, सर्ग 74",
    "verseNumber": 1
  },
  {
    "id": "valmiki-ramayana-1-sarga-74-shlok-2",
    "collectionId": "valmiki-ramayana",
    "index": 2913,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 74, श्लोक 2",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-74-shlok-2",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "विश्वामित्रे गते राजा वैदेहं मिथिलाधिपम्।",
          "आपृष्ट्वैव जगामाशु राजा दशरथः पुरीम्॥२॥",
          "अयोध्या"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-74",
    "chapterName": "बालकाण्ड, सर्ग 74",
    "verseNumber": 2
  },
  {
    "id": "valmiki-ramayana-1-sarga-74-shlok-4",
    "collectionId": "valmiki-ramayana",
    "index": 2914,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 74, श्लोक 4",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-74-shlok-4",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "अथ राजा विदेहानां ददौ कन्याधनं बहु।",
          "गवां शतसहस्राणि बहूनि मिथिलेश्वरः॥३॥",
          "कम्बलानां च मुख्यानां क्षौमान् कोट्यम्बराणि च।",
          "हस्त्यश्वरथपादातं दिव्यरूपं स्वलंकृतम्॥४॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-74",
    "chapterName": "बालकाण्ड, सर्ग 74",
    "verseNumber": 4
  },
  {
    "id": "valmiki-ramayana-1-sarga-74-shlok-5",
    "collectionId": "valmiki-ramayana",
    "index": 2915,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 74, श्लोक 5",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-74-shlok-5",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "ददौ कन्याशतं तासां दासीदासमनुत्तमम्।",
          "हिरण्यस्य सुवर्णस्य मुक्तानां विद्रुमस्य च॥५॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-74",
    "chapterName": "बालकाण्ड, सर्ग 74",
    "verseNumber": 5
  },
  {
    "id": "valmiki-ramayana-1-sarga-74-shlok-6",
    "collectionId": "valmiki-ramayana",
    "index": 2916,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 74, श्लोक 6",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-74-shlok-6",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "ददौ राजा सुसंहृष्टः कन्याधनमनुत्तमम्।",
          "दत्त्वा बहुविधं राजा समनुज्ञाप्य पार्थिवम्॥६॥",
          "प्रविवेश स्वनिलयं मिथिलां मिथिलेश्वरः।",
          "राजाप्ययोध्याधिपतिः सह पुत्रैर्महात्मभिः॥७॥",
          "ऋषीन् सर्वान् पुरस्कृत्य जगाम सबलानुगः।"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-74",
    "chapterName": "बालकाण्ड, सर्ग 74",
    "verseNumber": 6
  },
  {
    "id": "valmiki-ramayana-1-sarga-74-shlok-8",
    "collectionId": "valmiki-ramayana",
    "index": 2917,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 74, श्लोक 8",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-74-shlok-8",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "गच्छन्तं तु नरव्याघ्रं सर्षिसङ्गं सराघवम्॥८॥",
          "घोरास्त पक्षिणो वाचो व्याहरन्ति समन्ततः।",
          "भौमाश्चैव मृगाः सर्वे गच्छन्ति स्म प्रदक्षिणम्॥",
          "तान् दृष्ट्वा राजशार्दूलो वसिष्ठं पर्यपृच्छत।",
          "असौम्याः पक्षिणो घोरा मृगाश्चापि प्रदक्षिणाः॥ १०॥",
          "किमिदं हृदयोत्कम्पि मनो मम विषीदति।"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-74",
    "chapterName": "बालकाण्ड, सर्ग 74",
    "verseNumber": 8
  },
  {
    "id": "valmiki-ramayana-1-sarga-74-shlok-11",
    "collectionId": "valmiki-ramayana",
    "index": 2918,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 74, श्लोक 11",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-74-shlok-11",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "राज्ञो दशरथस्यैतच्छ्रुत्वा वाक्यं महानृषिः॥११॥",
          "उवाच मधुरां वाणीं श्रूयतामस्य यत् फलम्।",
          "उपस्थितं भयं घोरं दिव्यं पक्षिमुखाच्च्युतम्॥ १२॥",
          "मृगाः प्रशमयन्त्येते संतापस्त्यज्यतामयम्।"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-74",
    "chapterName": "बालकाण्ड, सर्ग 74",
    "verseNumber": 11
  },
  {
    "id": "valmiki-ramayana-1-sarga-74-shlok-13",
    "collectionId": "valmiki-ramayana",
    "index": 2919,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 74, श्लोक 13",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-74-shlok-13",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "तेषां संवदतां तत्र वायुः प्रादुर्बभूव ह॥१३॥",
          "कम्पयन् मेदिनी सर्वां पातयंश्च महाद्रुमान्।",
          "तमसा संवृतः सूर्यः सर्वे नावेदिषुर्दिशः॥१४॥",
          "भस्मना चावृतं सर्वं सम्मूढमिव तबलम्।"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-74",
    "chapterName": "बालकाण्ड, सर्ग 74",
    "verseNumber": 13
  },
  {
    "id": "valmiki-ramayana-1-sarga-74-shlok-16",
    "collectionId": "valmiki-ramayana",
    "index": 2920,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 74, श्लोक 16",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-74-shlok-16",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "वसिष्ठ ऋषयश्चान्ये राजा च ससुतस्तदा ॥ १५॥",
          "ससंज्ञा इव तत्रासन् सर्वमन्यद्विचेतनम्।",
          "तस्मिंस्तमसि घोरे तु भस्मच्छन्नेव सा चमूः॥ १६॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-74",
    "chapterName": "बालकाण्ड, सर्ग 74",
    "verseNumber": 16
  },
  {
    "id": "valmiki-ramayana-1-sarga-74-shlok-19",
    "collectionId": "valmiki-ramayana",
    "index": 2921,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 74, श्लोक 19",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-74-shlok-19",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "ददर्श भीमसंकाशं जटामण्डलधारिणम्।",
          "भार्गवं जामदग्नयेयं राजा राजविमर्दनम्॥१७॥",
          "कैलासमिव दुर्धर्षं कालाग्निमिव दुःसहम्।",
          "ज्वलन्तमिव तेजोभिर्दुर्निरीक्ष्यं पृथग्जनैः॥ १८॥",
          "स्कन्धे चासज्ज्य परशुं धनुर्विद्युद्गणोपमम्।",
          "प्रगृह्य शरमुग्रं च त्रिपुरनं यथा शिवम्॥१९॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-74",
    "chapterName": "बालकाण्ड, सर्ग 74",
    "verseNumber": 19
  },
  {
    "id": "valmiki-ramayana-1-sarga-74-shlok-20",
    "collectionId": "valmiki-ramayana",
    "index": 2922,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 74, श्लोक 20",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-74-shlok-20",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "तं दृष्ट्वा भीमसंकाशं ज्वलन्तमिव पावकम्।",
          "वसिष्ठप्रमुखा विप्रा जपहोमपरायणाः॥२०॥",
          "संगता मुनयः सर्वे संजजल्पुरथो मिथः।"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-74",
    "chapterName": "बालकाण्ड, सर्ग 74",
    "verseNumber": 20
  },
  {
    "id": "valmiki-ramayana-1-sarga-74-shlok-22",
    "collectionId": "valmiki-ramayana",
    "index": 2923,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 74, श्लोक 22",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-74-shlok-22",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "कच्चित् पितृवधामर्षी क्षत्रं नोत्सादयिष्यति॥ २१॥",
          "पूर्वं क्षत्रवधं कृत्वा गतमन्युर्गतज्वरः।",
          "क्षत्रस्योत्सादनं भूयो न खल्वस्य चिकीर्षितम्॥ २२॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-74",
    "chapterName": "बालकाण्ड, सर्ग 74",
    "verseNumber": 22
  },
  {
    "id": "valmiki-ramayana-1-sarga-74-shlok-23",
    "collectionId": "valmiki-ramayana",
    "index": 2924,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 74, श्लोक 23",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-74-shlok-23",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "एवमुक्त्वाय॑मादाय भार्गवं भीमदर्शनम्।",
          "ऋषयो राम रामेति मधुरं वाक्यमब्रुवन्॥२३॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-74",
    "chapterName": "बालकाण्ड, सर्ग 74",
    "verseNumber": 23
  },
  {
    "id": "valmiki-ramayana-1-sarga-74-shlok-24",
    "collectionId": "valmiki-ramayana",
