    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-2-sarga-86-shlok-2",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "तं जाग्रतं गुणैर्युक्तं वरचापेषुधारिणम्।",
          "भ्रातृगुप्त्यर्थमत्यन्तमहं लक्ष्मणमब्रुवम्॥२॥"
        ]
      }
    ],
    "chapterId": "अयोध्याकाण्ड-sarga-86",
    "chapterName": "अयोध्याकाण्ड, सर्ग 86",
    "verseNumber": 2
  },
  {
