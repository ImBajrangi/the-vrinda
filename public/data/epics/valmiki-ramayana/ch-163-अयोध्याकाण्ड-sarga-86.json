    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "सोऽहं प्रियसखं रामं शयानं सह सीतया।",
          "रक्षिष्यामि धनुष्पाणिः सर्वैः स्वैातिभिः सह॥ ७॥"
        ]
      }
