    "slug": "valmiki-ramayana-2-sarga-86-shlok-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "आचचक्षेऽथ सद्भावं लक्ष्मणस्य महात्मनः।",
          "भरतायाप्रमेयाय गुहो गहनगोचरः॥१॥"
        ]
      }
    ],
    "chapterId": "अयोध्याकाण्ड-sarga-86",
    "chapterName": "अयोध्याकाण्ड, सर्ग 86",
    "verseNumber": 1
  },
