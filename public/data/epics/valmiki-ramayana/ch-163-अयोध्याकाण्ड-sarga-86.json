    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "नहि रामात् प्रियतरो ममास्ति भुवि कश्चन।",
          "मोत्सुको भूर्ब्रवीम्येतदथ सत्यं तवाग्रतः॥५॥"
        ]
      }
    ],
    "chapterId": "अयोध्याकाण्ड-sarga-86",
    "chapterName": "अयोध्याकाण्ड, सर्ग 86",
    "verseNumber": 5
  },
