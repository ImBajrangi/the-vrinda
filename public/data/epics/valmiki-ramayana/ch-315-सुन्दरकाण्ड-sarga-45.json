    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-5-sarga-45-shlok-14",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "ततस्तेष्ववसन् नेषु भूमौ निपतितेषु च।",
          "तत्सैन्यमगमत् सर्वं दिशो दश भयादितम्॥१४॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-45",
