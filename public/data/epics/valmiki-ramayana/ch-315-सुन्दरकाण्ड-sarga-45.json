    "titleDevanagari": "वाल्मीकि रामायण, सुन्दरकाण्ड, सर्ग 45, श्लोक 1",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-5-sarga-45-shlok-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "ततस्ते राक्षसेन्द्रेण चोदिता मन्त्रिणः सुताः।",
          "निर्ययुर्भवनात् तस्मात् सप्त सप्तार्चिवर्चसः॥१॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-45",
    "chapterName": "सुन्दरकाण्ड, सर्ग 45",
    "verseNumber": 1
  },
  {
    "id": "valmiki-ramayana-5-sarga-45-shlok-2",
    "collectionId": "valmiki-ramayana",
    "index": 10418,
    "titleDevanagari": "वाल्मीकि रामायण, सुन्दरकाण्ड, सर्ग 45, श्लोक 2",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-5-sarga-45-shlok-2",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "महबलपरीवारा धनुष्मन्तो महाबलाः।",
          "कृतास्त्रास्त्रविदां श्रेष्ठाः परस्परजयैषिणः॥२॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-45",
    "chapterName": "सुन्दरकाण्ड, सर्ग 45",
    "verseNumber": 2
  },
  {
    "id": "valmiki-ramayana-5-sarga-45-shlok-4",
    "collectionId": "valmiki-ramayana",
    "index": 10419,
    "titleDevanagari": "वाल्मीकि रामायण, सुन्दरकाण्ड, सर्ग 45, श्लोक 4",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-5-sarga-45-shlok-4",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "हेमजालपरिक्षिप्तैर्ध्वजवद्भिः पताकिभिः।",
          "तोयदस्वननिर्घोषैर्वाजियुक्तैर्महारथैः ॥ ३॥",
          "तप्तकाञ्चनचित्राणि चापान्यमितविक्रमाः।",
          "विस्फारयन्तः संहृष्टास्तडिद्वन्त इवाम्बुदाः॥४॥",
          "जनन्यस्तास्ततस्तेषां विदित्वा किंकरान् हतान्।",
          "बभूवुः शोकसम्भ्रान्ताः सबान्धवसुहृज्जनाः॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-45",
    "chapterName": "सुन्दरकाण्ड, सर्ग 45",
    "verseNumber": 4
  },
  {
    "id": "valmiki-ramayana-5-sarga-45-shlok-6",
    "collectionId": "valmiki-ramayana",
    "index": 10420,
    "titleDevanagari": "वाल्मीकि रामायण, सुन्दरकाण्ड, सर्ग 45, श्लोक 6",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-5-sarga-45-shlok-6",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "ते परस्परसंघर्षात् तप्तकाञ्चनभूषणाः।",
          "अभिपेतुर्हनूमन्तं तोरणस्थमवस्थितम्॥६॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-45",
    "chapterName": "सुन्दरकाण्ड, सर्ग 45",
    "verseNumber": 6
  },
  {
