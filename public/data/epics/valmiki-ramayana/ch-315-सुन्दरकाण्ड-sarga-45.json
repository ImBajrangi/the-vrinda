    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "स शरान् वञ्चयामास तेषामाशुचरः कपिः।",
          "रथवेगांश्च वीराणां विचरन् विमलेऽम्बरे॥९॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-45",
    "chapterName": "सुन्दरकाण्ड, सर्ग 45",
    "verseNumber": 9
  },
