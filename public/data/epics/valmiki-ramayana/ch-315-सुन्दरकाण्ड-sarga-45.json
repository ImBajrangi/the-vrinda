    "collectionId": "valmiki-ramayana",
    "index": 10421,
    "titleDevanagari": "वाल्मीकि रामायण, सुन्दरकाण्ड, सर्ग 45, श्लोक 7",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-5-sarga-45-shlok-7",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "सृजन्तो बाणवृष्टिं ते रथगर्जितनिःस्वनाः।",
          "प्रावृट्काल इवाम्भोदा विचेरुर्नैर्ऋताम्बुदाः॥७॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-45",
    "chapterName": "सुन्दरकाण्ड, सर्ग 45",
    "verseNumber": 7
  },
  {
    "id": "valmiki-ramayana-5-sarga-45-shlok-8",
    "collectionId": "valmiki-ramayana",
    "index": 10422,
    "titleDevanagari": "वाल्मीकि रामायण, सुन्दरकाण्ड, सर्ग 45, श्लोक 8",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-5-sarga-45-shlok-8",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "अवकीर्णस्ततस्ताभिर्हनूमान् शरवृष्टिभिः।",
          "अभवत् संवृताकारः शैलराडिव वृष्टिभिः॥८॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-45",
    "chapterName": "सुन्दरकाण्ड, सर्ग 45",
    "verseNumber": 8
  },
  {
