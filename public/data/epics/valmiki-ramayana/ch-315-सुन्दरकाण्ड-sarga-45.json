      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "स कृत्वा निनदं घोरं त्रासयंस्तां महाचमूम्।",
          "चकार हनुमान् वेगं तेषु रक्षःसु वीर्यवान्॥११॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-45",
    "chapterName": "सुन्दरकाण्ड, सर्ग 45",
    "verseNumber": 11
  },
  {
