    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-5-sarga-45-shlok-10",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "स तैः क्रीडन् धनुष्मद्भिर्कोम्नि वीरः प्रकाशते।",
          "धनुष्मद्भिर्यथा मेघैर्मारुतः प्रभुरम्बरे॥१०॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-45",
    "chapterName": "सुन्दरकाण्ड, सर्ग 45",
    "verseNumber": 10
  },
  {
