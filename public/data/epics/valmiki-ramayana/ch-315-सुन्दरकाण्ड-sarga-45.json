    "slug": "valmiki-ramayana-5-sarga-45-shlok-13",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "प्रममाथोरसा कांश्चिदूरुभ्यामपरानपि।",
          "केचित् तस्यैव नादेन तत्रैव पतिता भुवि॥१३॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-45",
    "chapterName": "सुन्दरकाण्ड, सर्ग 45",
    "verseNumber": 13
  },
