    "titleDevanagari": "वाल्मीकि रामायण, अरण्यकाण्ड, सर्ग 4, श्लोक 2",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-4-shlok-2",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "एष दाशरथी रामः सत्यवाञ्छीलवान् शुचिः।",
          "रक्षसा रौद्ररूपेण ह्रियते सहलक्ष्मणः॥२॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-4",
    "chapterName": "अरण्यकाण्ड, सर्ग 4",
    "verseNumber": 2
  },
  {
    "id": "valmiki-ramayana-3-sarga-4-shlok-3",
    "collectionId": "valmiki-ramayana",
    "index": 6867,
    "titleDevanagari": "वाल्मीकि रामायण, अरण्यकाण्ड, सर्ग 4, श्लोक 3",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-4-shlok-3",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "मामृक्षा भक्षयिष्यन्ति शार्दूलद्वीपिनस्तथा।",
          "मां हरोत्सृज काकुत्स्थौ नमस्ते राक्षसोत्तम॥३॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-4",
    "chapterName": "अरण्यकाण्ड, सर्ग 4",
    "verseNumber": 3
  },
  {
    "id": "valmiki-ramayana-3-sarga-4-shlok-4",
