    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "मुष्टिभिर्बाहुभिः पद्भिः सूदयन्तौ तु राक्षसम्।",
          "उद्यम्योद्यम्य चाप्येनं स्थण्डिले निष्पिपेषतुः ॥७॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-4",
    "chapterName": "अरण्यकाण्ड, सर्ग 4",
    "verseNumber": 7
  },
