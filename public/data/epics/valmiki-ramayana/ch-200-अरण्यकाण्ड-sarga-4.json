    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-4-shlok-6",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "स भग्नबाहुः संविग्नः पपाताशु विमूर्च्छितः।",
          "धरण्यां मेघसंकाशो वज्रभिन्न इवाचलः॥६॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-4",
    "chapterName": "अरण्यकाण्ड, सर्ग 4",
    "verseNumber": 6
  },
