    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-4-shlok-4",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "॥ श्रीसीतारामचन्द्राभ्यां नमः॥",
          "श्रीमद्वाल्मीकीय रामायण",
          "अरण्यकाण्डम्",
          "चतुर्थः सर्गः (सर्ग 4)",
          "तस्यास्तद् वचनं श्रुत्वा वैदेह्या रामलक्ष्मणौ।",
          "वेगं प्रचक्रतुर्वीरौ वधे तस्य दुरात्मनः॥४॥",
          "इत्याचे श्रीमद्रामायणे वाल्मीकीये आदिकाव्येऽरण्यकाण्डे चतुर्थः सर्गः॥४॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-4",
    "chapterName": "अरण्यकाण्ड, सर्ग 4",
    "verseNumber": 4
  },
  {
    "id": "valmiki-ramayana-3-sarga-4-shlok-5",
    "collectionId": "valmiki-ramayana",
    "index": 6869,
    "titleDevanagari": "वाल्मीकि रामायण, अरण्यकाण्ड, सर्ग 4, श्लोक 5",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-4-shlok-5",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "तस्य रौद्रस्य सौमित्रिः सव्यं बाहुं बभञ्ज ह।",
          "रामस्तु दक्षिणं बाहं तरसा तस्य रक्षसः॥५॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-4",
    "chapterName": "अरण्यकाण्ड, सर्ग 4",
    "verseNumber": 5
  },
