    "titleDevanagari": "वाल्मीकि रामायण, अरण्यकाण्ड, सर्ग 4, श्लोक 1",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-4-shlok-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "ह्रियमाणौ तु काकुत्स्थौ दृष्ट्वा सीता रघूत्तमौ।",
          "उच्चैः स्वरेण चुक्रोश प्रगृह्य सुमहाभुजौ॥१॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-4",
    "chapterName": "अरण्यकाण्ड, सर्ग 4",
    "verseNumber": 1
  },
  {
    "id": "valmiki-ramayana-3-sarga-4-shlok-2",
