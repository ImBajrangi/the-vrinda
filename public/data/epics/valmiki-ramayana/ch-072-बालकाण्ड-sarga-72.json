    "slug": "valmiki-ramayana-1-sarga-72-shlok-7",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "पुत्रा दशरथस्येमे रूपयौवनशालिनः।",
          "लोकपालसमाः सर्वे देवतुल्यपराक्रमाः॥७॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-72",
    "chapterName": "बालकाण्ड, सर्ग 72",
    "verseNumber": 7
  },
