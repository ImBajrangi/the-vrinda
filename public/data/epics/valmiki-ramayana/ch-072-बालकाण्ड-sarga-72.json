    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 72, श्लोक 3",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-72-shlok-3",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "सदृशो धर्मसम्बन्धः सदृशो रूपसम्पदा।",
          "रामलक्ष्मणयो राजन् सीता चोर्मिलया सह॥३॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-72",
    "chapterName": "बालकाण्ड, सर्ग 72",
    "verseNumber": 3
  },
  {
    "id": "valmiki-ramayana-1-sarga-72-shlok-6",
    "collectionId": "valmiki-ramayana",
    "index": 2869,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 72, श्लोक 6",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-72-shlok-6",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "वक्तव्यं च नरश्रेष्ठ श्रूयतां वचनं मम।",
          "भ्राता यवीयान् धर्मज्ञ एष राजा कुशध्वजः॥४॥",
          "अस्य धर्मात्मनो राजन् रूपेणाप्रतिमं भुवि।",
          "सुताद्वयं नरश्रेष्ठ पत्न्यर्थं वरयामहे ॥५॥",
          "भरतस्य कुमारस्य शत्रुघ्नस्य च धीमतः।",
          "वरये ते सुते राजंस्तयोरर्थे महात्मनोः॥६॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-72",
    "chapterName": "बालकाण्ड, सर्ग 72",
    "verseNumber": 6
  },
  {
    "id": "valmiki-ramayana-1-sarga-72-shlok-7",
    "collectionId": "valmiki-ramayana",
