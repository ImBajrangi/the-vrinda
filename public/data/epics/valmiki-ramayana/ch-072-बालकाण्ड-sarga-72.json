    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 72, श्लोक 1",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-72-shlok-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "तमुक्तवन्तं वैदेहं विश्वामित्रो महामुनिः।",
          "उवाच वचनं वीरं वसिष्ठसहितो नृपम्॥१॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-72",
    "chapterName": "बालकाण्ड, सर्ग 72",
    "verseNumber": 1
  },
  {
    "id": "valmiki-ramayana-1-sarga-72-shlok-2",
