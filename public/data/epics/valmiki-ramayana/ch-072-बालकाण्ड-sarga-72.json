    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 72, श्लोक 2",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-72-shlok-2",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "अचिन्त्यान्यप्रमेयाणि कुलानि नरपुंगव।",
          "इक्ष्वाकूणां विदेहानां नैषां तुल्योऽस्ति कश्चन॥ २॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-72",
    "chapterName": "बालकाण्ड, सर्ग 72",
    "verseNumber": 2
  },
  {
