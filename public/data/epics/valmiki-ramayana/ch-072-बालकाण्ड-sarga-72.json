      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "उभयोरपि राजेन्द्र सम्बन्धेनानुबध्यताम्।",
          "इक्ष्वाकुकुलमव्यग्रं भवतः पुण्यकर्मणः॥८॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-72",
    "chapterName": "बालकाण्ड, सर्ग 72",
    "verseNumber": 8
  },
