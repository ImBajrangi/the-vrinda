    "slug": "valmiki-ramayana-1-sarga-63-shlok-5-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "उदितां मरणे बुद्धिं मुनिवाक्यैर्निवर्तये।",
          "बुद्धिर्या तेन मे दत्ता प्राणानां रक्षणे मम॥५॥",
          "सा मेऽपनयते दुःखं दीप्तेवाग्निशिखा तमः।"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-63",
    "chapterName": "बालकाण्ड, सर्ग 63",
    "verseNumber": 5
  },
  {
