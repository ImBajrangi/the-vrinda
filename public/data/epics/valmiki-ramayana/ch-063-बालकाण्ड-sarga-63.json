    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "महाप्रस्थानमासाद्य स्वर्गते तु निशाकरे।",
          "मां निर्दहति संतापो वितर्बहुभिर्वृतम्॥४॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-63",
    "chapterName": "बालकाण्ड, सर्ग 63",
    "verseNumber": 4
  },
