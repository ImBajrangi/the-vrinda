    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "कन्दरात् तु विसर्पित्वा पर्वतस्य शनैः शनैः ।",
          "अहं विन्ध्यं समारुह्य भवतः प्रतिपालये॥२॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-63",
    "chapterName": "बालकाण्ड, सर्ग 63",
    "verseNumber": 2
