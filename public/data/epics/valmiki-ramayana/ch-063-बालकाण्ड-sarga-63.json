          "न मे दशरथस्नेहात् पुत्रेणोत्पादितं प्रियम्।"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-63",
    "chapterName": "बालकाण्ड, सर्ग 63",
    "verseNumber": 7
