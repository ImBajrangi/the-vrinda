    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "अद्य त्वेतस्य कालस्य वर्षं साग्रशतं गतम्।",
          "देशकालप्रतीक्षोऽस्मि हृदि कृत्वा मुनेर्वचः॥ ३॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-63",
    "chapterName": "बालकाण्ड, सर्ग 63",
    "verseNumber": 3
  },
