        "linesDevanagari": [
          "सान्त्विता मामिका माता दत्तं राज्यमिदं मम।",
          "तद् ददामि तवैवाहं भुक्ष्व राज्यमकण्टकम्॥ ४॥"
        ]
      }
    ],
