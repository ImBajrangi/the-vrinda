    "slug": "valmiki-ramayana-2-sarga-105-shlok-3",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "तूष्णीं ते समुपासीना न कश्चित् किंचिदब्रवीत्।",
          "भरतस्तु सुहृन्मध्ये रामं वचनमब्रवीत्॥३॥"
        ]
      }
    ],
    "chapterId": "अयोध्याकाण्ड-sarga-105",
    "chapterName": "अयोध्याकाण्ड, सर्ग 105",
    "verseNumber": 3
  },
