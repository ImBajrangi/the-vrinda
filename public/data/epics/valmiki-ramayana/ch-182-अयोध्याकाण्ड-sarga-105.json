    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-2-sarga-105-shlok-2",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "ततः पुरुषसिंहानां वृतानां तैः सुहृद्गणैः।",
          "शोचतामेव रजनी दुःखेन व्यत्यवर्तत॥१॥",
          "रजन्यां सुप्रभातायां भ्रातरस्ते सुहृवृताः।",
          "मन्दाकिन्यां हुतं जप्यं कृत्वा राममुपागमन्॥२॥"
        ]
      }
    ],
    "chapterId": "अयोध्याकाण्ड-sarga-105",
    "chapterName": "अयोध्याकाण्ड, सर्ग 105",
    "verseNumber": 2
  },
  {
