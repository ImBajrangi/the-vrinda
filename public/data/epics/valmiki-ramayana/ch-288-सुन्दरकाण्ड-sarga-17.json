    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "एकाक्षीमेककर्णां च कर्णप्रावरणां तथा।",
          "अकर्णां शङ्ककर्णां च मस्तकोच्छ्वासनासिकाम्॥५॥",
          "अतिकायोत्तमांगीं च तनुदीर्घशिरोधराम्।",
          "ध्वस्तकेशी तथाकेशी केशकम्बलधारिणीम्॥"
        ]
      }
    ],
