    "slug": "valmiki-ramayana-1-sarga-17-shlok-3-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "स दृष्ट्वा रूपसम्पन्नां कन्यां तां सुमहाव्रताम्।",
          "काममोहपरीतात्मा पप्रच्छ प्रहसन्निव॥३॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-17",
    "chapterName": "बालकाण्ड, सर्ग 17",
    "verseNumber": 3
  },
  {
