    "slug": "valmiki-ramayana-1-sarga-17-shlok-9",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "तस्याहं कुर्वतो नित्यं वेदाभ्यासं महात्मनः॥९॥",
          "सम्भूता वाङ्मयी कन्या नाम्ना वेदवती स्मृता।"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-17",
    "chapterName": "बालकाण्ड, सर्ग 17",
