    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-17-shlok-13",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "लक्ष्मणानुचरो रामो ददर्शोपससर्प च।",
          "तं तथा पतितं वीरं गतार्चिषमिवानलम्॥१२॥",
          "बहुमान्य च तं वीरं वीक्षमाणं शनैरिव।",
          "उपयातौ महावीर्यौ भ्रातरौ रामलक्ष्मणौ ॥१३॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-17",
    "chapterName": "बालकाण्ड, सर्ग 17",
    "verseNumber": 13
  },
  {
    "id": "valmiki-ramayana-1-sarga-17-shlok-14-2",
    "collectionId": "valmiki-ramayana",
    "index": 850,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 17, श्लोक 14",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-17-shlok-14-2",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "पितुस्तु मम जामाता विष्णुः किल सुरेश्वरः॥१२॥",
          "अभिप्रेतस्त्रिलोकेशस्तस्मान्नान्यस्य मे पिता।",
          "दातुमिच्छति तस्मै तु तच्छ्रुत्वा बलदर्पितः॥१३॥",
          "शम्भुर्नाम ततो राजा दैत्यानां कुपितोऽभवत्।",
          "तेन रात्रौ शयानो मे पिता पापेन हिंसितः॥१४॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-17",
    "chapterName": "बालकाण्ड, सर्ग 17",
    "verseNumber": 14
  },
