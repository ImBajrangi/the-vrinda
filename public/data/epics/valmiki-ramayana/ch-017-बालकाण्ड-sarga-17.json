    "slug": "valmiki-ramayana-1-sarga-17-shlok-16-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "त्वं नराधिपतेः पुत्रः प्रथितः प्रियदर्शनः।",
          "परामखवधं कृत्वा कोऽत्र प्राप्तस्त्वया गुणः।",
          "यदहं युद्धसंरब्धस्त्वत्कृते निधनं गतः॥१६॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-17",
    "chapterName": "बालकाण्ड, सर्ग 17",
    "verseNumber": 16
  },
