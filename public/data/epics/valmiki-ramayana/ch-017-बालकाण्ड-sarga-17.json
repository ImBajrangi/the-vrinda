    "slug": "valmiki-ramayana-1-sarga-17-shlok-12",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "धनदस्य सुतः श्रीमान् वानरो गन्धमादनः।",
          "विश्वकर्मा त्वजनयन्नलं नाम महाकपिम्॥१२॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-17",
    "chapterName": "बालकाण्ड, सर्ग 17",
    "verseNumber": 12
  },
  {
