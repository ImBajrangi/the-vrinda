    "slug": "valmiki-ramayana-1-sarga-17-shlok-1-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "अथ राजन् महाबाहुर्विचरन् पृथिवीतले।",
          "हिमवदनमासाद्य परिचक्राम रावणः॥१॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-17",
    "chapterName": "बालकाण्ड, सर्ग 17",
    "verseNumber": 1
  },
  {
