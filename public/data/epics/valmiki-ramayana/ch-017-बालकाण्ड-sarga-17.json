    "slug": "valmiki-ramayana-1-sarga-17-shlok-7-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "तस्य माला च देहश्च मर्मघाती च यः शरः।",
          "त्रिधेव रचिता लक्ष्मीः पतितस्यापि शोभते॥७॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-17",
    "chapterName": "बालकाण्ड, सर्ग 17",
    "verseNumber": 7
  },
  {
