    "slug": "valmiki-ramayana-1-sarga-17-shlok-2-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "तत्रापश्यत् स वै कन्यां कृष्णाजिनजटाधराम्।",
          "आर्षेण विधिना चैनां दीप्यन्ती देवतामिव॥२॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-17",
    "chapterName": "बालकाण्ड, सर्ग 17",
    "verseNumber": 2
  },
  {
