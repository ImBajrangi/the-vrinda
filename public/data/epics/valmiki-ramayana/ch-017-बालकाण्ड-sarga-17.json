    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "तदस्त्रं तस्य वीरस्य स्वर्गमार्गप्रभावनम्।",
          "रामबाणासनक्षिप्तमावहत् परमां गतिम्॥८॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-17",
    "chapterName": "बालकाण्ड, सर्ग 17",
    "verseNumber": 8
  },
  {
