    "slug": "valmiki-ramayana-1-sarga-17-shlok-10-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "ततो देवाः सगन्धर्वा यक्षराक्षसपन्नगाः॥१०॥",
          "ते चापि गत्वा पितरं वरणं रोचयन्ति मे।"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-17",
    "chapterName": "बालकाण्ड, सर्ग 17",
    "verseNumber": 10
  },
  {
