    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "ततो मे जननी दीना तच्छरीरं पितुर्मम।",
          "परिष्वज्य महाभागा प्रविष्टा हव्यवाहनम्॥१५॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-17",
    "chapterName": "बालकाण्ड, सर्ग 17",
    "verseNumber": 15
