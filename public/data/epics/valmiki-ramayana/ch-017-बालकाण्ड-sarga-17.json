    "slug": "valmiki-ramayana-1-sarga-17-shlok-4-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "भूमौ निपतितस्यापि तस्य देहं महात्मनः।",
          "न श्रीर्जहाति न प्राणा न तेजो न पराक्रमः॥४॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-17",
    "chapterName": "बालकाण्ड, सर्ग 17",
    "verseNumber": 4
  },
  {
    "id": "valmiki-ramayana-1-sarga-17-shlok-5-1",
    "collectionId": "valmiki-ramayana",
    "index": 841,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 17, श्लोक 5",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-17-shlok-5-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "रूपं तेऽनुपमं भीरु कामोन्मादकरं नृणाम्।",
          "न युक्तं तपसि स्थातुं निर्गतो ह्येष निर्णयः॥५॥",
          "कस्यासि किमिदं भद्रे कश्च भर्ता वरानने।",
          "येन सम्भुज्यसे भीरु स नरः पुण्यभाग् भुवि॥",
          "पृच्छतः शंस मे सर्वं कस्य हेतोः परिश्रमः।"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-17",
    "chapterName": "बालकाण्ड, सर्ग 17",
    "verseNumber": 5
  },
  {
    "id": "valmiki-ramayana-1-sarga-17-shlok-6",
    "collectionId": "valmiki-ramayana",
    "index": 842,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 17, श्लोक 6",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-17-shlok-6",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "स तया मालया वीरो हैमया हरियथपः।",
          "संध्यानुगतपर्यन्तः पयोधर इवाभवत्॥६॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-17",
    "chapterName": "बालकाण्ड, सर्ग 17",
    "verseNumber": 6
  },
  {
