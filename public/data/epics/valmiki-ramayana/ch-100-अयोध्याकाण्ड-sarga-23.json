    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "तदा तु बद्ध्वा भ्रुकुटी ध्रुवोर्मध्ये नरर्षभः।",
          "निशश्वास महासर्पो बिलस्थ इव रोषितः॥२॥"
        ]
      }
    ],
    "chapterId": "अयोध्याकाण्ड-sarga-23",
    "chapterName": "अयोध्याकाण्ड, सर्ग 23",
    "verseNumber": 2
  },
  {
