    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "तस्य दुष्प्रतिवीक्ष्यं तद् भृकुटीसहितं तदा।",
          "बभौ क्रुद्धस्य सिंहस्य मुखस्य सदृशं मुखम्॥३॥"
        ]
      }
    ],
    "chapterId": "अयोध्याकाण्ड-sarga-23",
    "chapterName": "अयोध्याकाण्ड, सर्ग 23",
    "verseNumber": 3
  },
  {
