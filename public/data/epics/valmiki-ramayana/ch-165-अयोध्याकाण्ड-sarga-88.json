    "slug": "valmiki-ramayana-2-sarga-88-shlok-9",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "गीतवादित्रनिर्घोषैर्वराभरणनिःस्वनैः।",
          "मृदङ्गवरशब्दैश्च सततं प्रतिबोधितः॥८॥",
          "बन्दिभिर्वन्दितः काले बहुभिः सूतमागधैः।",
          "गाथाभिरनुरूपाभिः स्तुतिभिश्च परंतपः॥९॥"
        ]
      }
    ],
    "chapterId": "अयोध्याकाण्ड-sarga-88",
    "chapterName": "अयोध्याकाण्ड, सर्ग 88",
    "verseNumber": 9
  },
