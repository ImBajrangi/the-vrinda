        "linesDevanagari": [
          "तच्छ्रुत्वा निपुणं सर्वं भरतः सह मन्त्रिभिः।",
          "इङ्गदीमूलमागम्य रामशय्यामवैक्षत॥१॥"
        ]
      }
    ],
    "chapterId": "अयोध्याकाण्ड-sarga-88",
    "chapterName": "अयोध्याकाण्ड, सर्ग 88",
    "verseNumber": 1
  },
  {
