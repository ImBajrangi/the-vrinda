    "slug": "valmiki-ramayana-2-sarga-84-shlok-3",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "यदा नु खलु दुर्बुद्धिर्भरतः स्वयमागतः।",
          "स एष हि महाकायः कोविदारध्वजो रथे॥३॥"
        ]
      }
    ],
    "chapterId": "अयोध्याकाण्ड-sarga-84",
