    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-44-shlok-8",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "दर्शनादर्शनेनैव सोऽपाकर्षत राघवम्।",
          "स दूरमाश्रमस्यास्य मारीचो मृगतां गतः॥८॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-44",
    "chapterName": "अरण्यकाण्ड, सर्ग 44",
    "verseNumber": 8
  },
