    "slug": "valmiki-ramayana-3-sarga-44-shlok-9",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "आसीत् क्रुद्धस्तु काकुत्स्थो विवशस्तेन मोहितः।",
          "अथावतस्थे सुश्रान्तश्छायामाश्रित्य शादले॥९॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-44",
    "chapterName": "अरण्यकाण्ड, सर्ग 44",
    "verseNumber": 9
  },
