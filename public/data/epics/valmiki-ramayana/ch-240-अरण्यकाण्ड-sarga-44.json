    "titleDevanagari": "वाल्मीकि रामायण, अरण्यकाण्ड, सर्ग 44, श्लोक 2",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-44-shlok-2",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "ततस्त्रिविनतं चापमादायात्मविभूषणम्।",
          "आबध्य च कपालौ द्वौ जगामोदग्रविक्रमः॥२॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-44",
    "chapterName": "अरण्यकाण्ड, सर्ग 44",
    "verseNumber": 2
  },
  {
    "id": "valmiki-ramayana-3-sarga-44-shlok-3",
    "collectionId": "valmiki-ramayana",
