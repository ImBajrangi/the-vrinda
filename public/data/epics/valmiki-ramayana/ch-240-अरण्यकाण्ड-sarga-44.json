    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-44-shlok-12",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "पुनरेव ततो दूराद् वृक्षखण्डाद् विनिःसृतः।",
          "दृष्ट्वा रामो महातेजास्तं हन्तुं कृतनिश्चयः॥१२॥"
        ]
      }
