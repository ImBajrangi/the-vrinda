    "slug": "valmiki-ramayana-3-sarga-44-shlok-10",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "स तमुन्मादयामास मृगरूपो निशाचरः।",
          "मृगैः परिवृतोऽथान्यैरदूरात् प्रत्यदृश्यत॥१०॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-44",
