    "titleDevanagari": "वाल्मीकि रामायण, अरण्यकाण्ड, सर्ग 44, श्लोक 1",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-44-shlok-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "तथा तु तं समादिश्य भ्रातरं रघुनन्दनः।",
          "बबन्धासिं महातेजा जाम्बूनदमयत्सरुम्॥१॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-44",
    "chapterName": "अरण्यकाण्ड, सर्ग 44",
    "verseNumber": 1
  },
  {
    "id": "valmiki-ramayana-3-sarga-44-shlok-2",
    "collectionId": "valmiki-ramayana",
