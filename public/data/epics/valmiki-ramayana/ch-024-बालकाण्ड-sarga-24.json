    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-24-shlok-10-2",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "दशग्रीववशं प्राप्तास्तास्तु शोकाकुलाः स्त्रियः॥१०॥",
          "दीनवक्त्रेक्षणाः श्यामा मृग्यः सिंहवशा इव।"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-24",
    "chapterName": "बालकाण्ड, सर्ग 24",
    "verseNumber": 10
  },
