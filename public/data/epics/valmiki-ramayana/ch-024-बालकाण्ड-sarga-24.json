    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "महाबलानां हरियूथपानामिदं कुलं राघव मन्निमित्तम्।",
          "अस्याङ्गदस्यापि च शोकतापा दर्धस्थितप्राणमितीव मन्ये॥१९॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-24",
    "chapterName": "बालकाण्ड, सर्ग 24",
    "verseNumber": 19
