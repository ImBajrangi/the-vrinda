    "slug": "valmiki-ramayana-1-sarga-24-shlok-18-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "अंहो बतेदं नवराविषह्यं निवर्तते मे हृदि साधुवृत्तम्।",
          "अग्नौ विवर्णं परितप्यमानं किनॊ यथा राघव जातरूपम्॥१८॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-24",
    "chapterName": "बालकाण्ड, सर्ग 24",
    "verseNumber": 18
  },
