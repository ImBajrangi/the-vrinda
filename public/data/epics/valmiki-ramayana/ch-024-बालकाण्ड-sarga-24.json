[
  {
    "id": "valmiki-ramayana-1-sarga-24-shlok-1-2",
    "collectionId": "valmiki-ramayana",
    "index": 1163,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 24, श्लोक 1",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-24-shlok-1-2",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "निवर्तमानः संहृष्टो रावणः स दुरात्मवान्।",
          "जढे पथि नरेन्द्रर्षिदेवदानवकन्यकाः॥१॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-24",
    "chapterName": "बालकाण्ड, सर्ग 24",
    "verseNumber": 1
  },
  {
    "id": "valmiki-ramayana-1-sarga-24-shlok-2-1",
    "collectionId": "valmiki-ramayana",
    "index": 1164,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 24, श्लोक 2",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-24-shlok-2-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "स बाष्पपूर्णेन मुखेन पश्यन् क्षणेन निर्विण्णमना मनस्वी।",
          "जगाम रामस्य शनैः समीपं भृत्यैर्वृतः सम्परिदूयमानः॥२॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-24",
    "chapterName": "बालकाण्ड, सर्ग 24",
    "verseNumber": 2
  },
  {
    "id": "valmiki-ramayana-1-sarga-24-shlok-3",
    "collectionId": "valmiki-ramayana",
    "index": 1165,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 24, श्लोक 3",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-24-shlok-3",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "एवं पन्नगकन्याश्च राक्षसासुरमानुषीः।",
          "यक्षदानवकन्याश्च विमाने सोऽध्यरोपयत्॥३॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-24",
    "chapterName": "बालकाण्ड, सर्ग 24",
    "verseNumber": 3
  },
  {
