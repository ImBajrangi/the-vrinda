    "slug": "valmiki-ramayana-1-sarga-24-shlok-6",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "नागगन्धर्वकन्याश्च महर्षितनयाश्च याः।",
          "दैत्यदानवकन्याश्च विमाने शतशोऽरुदन्॥६॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-24",
    "chapterName": "बालकाण्ड, सर्ग 24",
    "verseNumber": 6
  },
  {
