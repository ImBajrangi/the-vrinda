    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "सा बाष्पपरिरुद्धाक्षी रक्ताक्षी वाक्यमब्रवीत्॥२६॥",
          "कृतास्मि विधवा राजंस्त्वया बलवता बलात्।"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-24",
    "chapterName": "बालकाण्ड, सर्ग 24",
