    "slug": "valmiki-ramayana-1-sarga-24-shlok-7",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "श्रेयोऽद्य मन्ये मम शैलमुख्ये तस्मिन् हि वासश्चिरमृष्यमूके।",
          "यथा तथा वर्तयतः स्ववृत्त्या नेमं निहत्य त्रिदिवस्य लाभः॥७॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-24",
    "chapterName": "बालकाण्ड, सर्ग 24",
    "verseNumber": 7
  },
  {
    "id": "valmiki-ramayana-1-sarga-24-shlok-8-2",
    "collectionId": "valmiki-ramayana",
    "index": 1170,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 24, श्लोक 8",
