    "slug": "valmiki-ramayana-1-sarga-24-shlok-15-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "नार्हामि सम्मानमिमं प्रजानां न यौवराज्यं कुत एव राज्यम्।",
          "अधर्मयुक्तं कुलनाशयुक्तमेवंविधं राघव कर्म कृत्वा॥१५॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-24",
    "chapterName": "बालकाण्ड, सर्ग 24",
    "verseNumber": 15
  },
  {
    "id": "valmiki-ramayana-1-sarga-24-shlok-16",
    "collectionId": "valmiki-ramayana",
    "index": 1178,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 24, श्लोक 16",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-24-shlok-16",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "हा कथं नु करिष्यामि भर्तुस्तस्मादहं विना॥१४॥",
          "मृत्यो प्रसादयामि त्वां नय मां दुःखभागिनीम्।",
          "किं नु तद् दुष्कृतं कर्म पुरा देहान्तरे कृतम्॥१५॥",
          "एवं स्म दुःखिताः सर्वाः पतिताः शोकसागरे।",
          "न खल्विदानीं पश्यामो दुःखस्यास्यान्तमात्मनः॥१६॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-24",
    "chapterName": "बालकाण्ड, सर्ग 24",
    "verseNumber": 16
  },
  {
