    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 24, श्लोक 5",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-24-shlok-5-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "ताभिः सर्वानवद्याभिर्नदीभिरिव सागरः।",
          "आपूरितं विमानं तद् भयशोकाशिवाश्रुभिः॥५॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-24",
    "chapterName": "बालकाण्ड, सर्ग 24",
    "verseNumber": 5
  },
  {
