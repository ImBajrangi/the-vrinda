    "slug": "valmiki-ramayana-1-sarga-24-shlok-12",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "भ्रातृत्वमार्यभावश्च धर्मश्चानेन रक्षितः।",
          "मया क्रोधश्च कामश्च कपित्वं च प्रदर्शितम्॥ १२॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-24",
    "chapterName": "बालकाण्ड, सर्ग 24",
    "verseNumber": 12
  },
