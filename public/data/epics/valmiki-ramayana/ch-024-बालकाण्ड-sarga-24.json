    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "पाप्मानमिन्द्रस्य मही जलं च वृक्षाश्च कामं जगृहुः स्त्रियश्च।"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-24",
    "chapterName": "बालकाण्ड, सर्ग 24",
    "verseNumber": 14
  },
  {
