    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-24-shlok-4-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "यथा प्रतिज्ञातमिदं नरेन्द्र कृतं त्वया दृष्टफलं च कर्म।",
          "ममाद्य भोगेषु नरेन्द्रसूनो मनो निवृत्तं हतजीवितेन॥४॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-24",
    "chapterName": "बालकाण्ड, सर्ग 24",
    "verseNumber": 4
  },
  {
    "id": "valmiki-ramayana-1-sarga-24-shlok-5-1",
    "collectionId": "valmiki-ramayana",
