    "slug": "valmiki-ramayana-1-sarga-24-shlok-13-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "कथं नु खलु मे पुत्रो भविष्यति मया विना॥१३॥",
          "कथं माता कथं भ्राता निमग्नाः शोकसागरे।"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-24",
    "chapterName": "बालकाण्ड, सर्ग 24",
    "verseNumber": 13
