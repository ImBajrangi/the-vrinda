    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-24-shlok-9",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "शोकदुःखभयत्रस्ता विह्वलाश्च सुमध्यमाः।",
          "तासां निःश्वासवातेन सर्वतः सम्प्रदीपितम्॥९॥",
          "अग्निहोत्रमिवाभाति संनिरुद्धाग्नि पुष्पकम्।"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-24",
    "chapterName": "बालकाण्ड, सर्ग 24",
    "verseNumber": 9
  },
  {
