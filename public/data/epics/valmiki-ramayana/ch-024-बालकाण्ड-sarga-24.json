    "collectionId": "valmiki-ramayana",
    "index": 1179,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 24, श्लोक 17",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-24-shlok-17",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "अहो धिमानुषं लोकं नास्ति खल्वधमः परः।",
          "यद् दुर्बला बलवता भर्तारो रावणेन नः ॥१७॥",
          "सूर्येणोदयता काले नक्षत्राणीव नाशिताः।"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-24",
    "chapterName": "बालकाण्ड, सर्ग 24",
    "verseNumber": 17
  },
