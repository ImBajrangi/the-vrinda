      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "शप्तः स्त्रीभिः स तु समं हतौजा इव निष्प्रभः॥२२॥",
          "पतिव्रताभिः साध्वीभिर्बभूव विमना इव।"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-24",
    "chapterName": "बालकाण्ड, सर्ग 24",
    "verseNumber": 22
  },
  {
