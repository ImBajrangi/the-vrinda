    "slug": "valmiki-ramayana-1-sarga-24-shlok-8-2",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "दीर्घकेश्यः सुचाङ्ग्यः पूर्णचन्द्रनिभाननाः।",
          "पीनस्तनतटा मध्ये वज्रवेदिसमप्रभाः॥७॥",
          "रथकूबरसंकाशैः श्रोणिदेशैर्मनोहराः।।",
          "स्त्रियः सुराङ्गनाप्रख्या निष्टप्तकनकप्रभाः॥८॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-24",
    "chapterName": "बालकाण्ड, सर्ग 24",
    "verseNumber": 8
  },
  {
    "id": "valmiki-ramayana-1-sarga-24-shlok-9",
    "collectionId": "valmiki-ramayana",
    "index": 1171,
