    "slug": "valmiki-ramayana-1-sarga-24-shlok-11-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "काचिच्चिन्तयती तत्र किं न मां भक्षयिष्यति॥११॥",
          "काचिद् दध्यौ सुदुःखार्ता अपि मां मारयेदयम्।"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-24",
    "chapterName": "बालकाण्ड, सर्ग 24",
    "verseNumber": 11
  },
  {
