    "slug": "valmiki-ramayana-1-sarga-24-shlok-25",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "तां स्वसारं समुत्थाप्य रावणः परिसान्त्वयन्॥२५॥",
          "अब्रवीत् किमिदं भद्रे वक्तुकामासि मां द्रुतम्।"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-24",
    "chapterName": "बालकाण्ड, सर्ग 24",
    "verseNumber": 25
  },
