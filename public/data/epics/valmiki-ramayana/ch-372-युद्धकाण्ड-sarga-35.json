    "slug": "valmiki-ramayana-6-sarga-35-shlok-10",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "तन्मह्यं रोचते संधिः सह रामेण रावण।",
          "यदर्थमभियुक्तोऽसि सीता तस्मै प्रदीयताम्॥१०॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-35",
    "chapterName": "युद्धकाण्ड, सर्ग 35",
    "verseNumber": 10
  },
