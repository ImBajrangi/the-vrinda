        "linesDevanagari": [
          "धर्मो हि श्रूयते पक्ष अमराणां महात्मनाम्।",
          "अधर्मो रक्षसां पक्षो ह्यसुराणां च राक्षस॥१३॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-35",
    "chapterName": "युद्धकाण्ड, सर्ग 35",
    "verseNumber": 13
  },
