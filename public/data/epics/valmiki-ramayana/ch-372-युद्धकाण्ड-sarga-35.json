    "slug": "valmiki-ramayana-6-sarga-35-shlok-8",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "संदधानो हि कालेन विगृह्णश्चारिभिः सह।",
          "स्वपक्षे वर्धनं कुर्वन्महदैश्वर्यमश्नुते॥८॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-35",
    "chapterName": "युद्धकाण्ड, सर्ग 35",
    "verseNumber": 8
  },
  {
    "id": "valmiki-ramayana-6-sarga-35-shlok-9",
