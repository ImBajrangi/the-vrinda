    "slug": "valmiki-ramayana-6-sarga-35-shlok-9",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "हीयमानेन कर्तव्यो राज्ञा संधिः समेन च।",
          "न शत्रुमवमन्येत ज्यायान् कुर्वीत विग्रहम्॥९॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-35",
    "chapterName": "युद्धकाण्ड, सर्ग 35",
    "verseNumber": 9
  },
  {
    "id": "valmiki-ramayana-6-sarga-35-shlok-10",
    "collectionId": "valmiki-ramayana",
