          "असृजद् भगवान् पक्षौ दावेव हि पितामहः।",
          "सुराणामसुराणां च धर्माधर्मों तदाश्रयौ॥१२॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-35",
    "chapterName": "युद्धकाण्ड, सर्ग 35",
    "verseNumber": 12
  },
