    "index": 12309,
    "titleDevanagari": "वाल्मीकि रामायण, युद्धकाण्ड, सर्ग 35, श्लोक 3",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-6-sarga-35-shlok-3",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "अथ तान् सचिवांस्तत्र सर्वानाभाष्य रावणः।",
          "सभां संनादयन् सर्वामित्युवाच महाबलः॥३॥",
          "जगत्संतापनः क्रूरोऽगर्हयन् राक्षसेश्वरः।"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-35",
    "chapterName": "युद्धकाण्ड, सर्ग 35",
    "verseNumber": 3
  },
  {
    "id": "valmiki-ramayana-6-sarga-35-shlok-4",
    "collectionId": "valmiki-ramayana",
    "index": 12310,
    "titleDevanagari": "वाल्मीकि रामायण, युद्धकाण्ड, सर्ग 35, श्लोक 4",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-6-sarga-35-shlok-4",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "तरणं सागरस्यास्य विक्रमं बलपौरुषम्॥४॥",
          "यदुक्तवन्तो रामस्य भवन्तस्तन्मया श्रुतम्।",
          "भवतश्चाप्यहं वेद्मि युद्धे सत्यपराक्रमान्।",
          "तूष्णीकानीक्षतोऽन्योन्यं विदित्वा रामविक्रमम्॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-35",
    "chapterName": "युद्धकाण्ड, सर्ग 35",
    "verseNumber": 4
  },
  {
    "id": "valmiki-ramayana-6-sarga-35-shlok-7",
    "collectionId": "valmiki-ramayana",
    "index": 12311,
    "titleDevanagari": "वाल्मीकि रामायण, युद्धकाण्ड, सर्ग 35, श्लोक 7",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-6-sarga-35-shlok-7",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "विद्यास्वभिविनीतो यो राजा राजन् नयानुगः।",
          "स शास्ति चिरमैश्वर्यमरीश्च कुरुते वशे॥७॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-35",
    "chapterName": "युद्धकाण्ड, सर्ग 35",
    "verseNumber": 7
  },
  {
