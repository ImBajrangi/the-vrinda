    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "तस्य देवर्षयः सर्वे गन्धर्वाश्च जयैषिणः।",
          "विरोधं मा गमस्तेन संधिस्ते तेन रोचताम्॥११॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-35",
    "chapterName": "युद्धकाण्ड, सर्ग 35",
    "verseNumber": 11
  },
  {
