    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-5-sarga-4-shlok-8",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "तां चित्रमाल्याभरणां कपिराजहितंकरः॥८॥",
          "राघवार्थे चरन् श्रीमान् ददर्श च ननन्द च।"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-4",
    "chapterName": "सुन्दरकाण्ड, सर्ग 4",
    "verseNumber": 8
  },
