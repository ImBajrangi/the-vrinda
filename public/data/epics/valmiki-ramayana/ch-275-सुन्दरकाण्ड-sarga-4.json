[
  {
    "id": "valmiki-ramayana-5-sarga-4-shlok-2",
    "collectionId": "valmiki-ramayana",
    "index": 9084,
    "titleDevanagari": "वाल्मीकि रामायण, सुन्दरकाण्ड, सर्ग 4, श्लोक 2",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-5-sarga-4-shlok-2",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "स निर्जित्य पुरीं लंकां श्रेष्ठां तां कामरूपिणीम्।",
          "विक्रमेण महातेजा हनूमान् कपिसत्तमः॥१॥",
          "अद्वारेण महावीर्यः प्राकारमवपुप्लुवे।",
          "निशि लंकां महासत्त्वो विवेश कपिकुञ्जरः॥२॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-4",
    "chapterName": "सुन्दरकाण्ड, सर्ग 4",
    "verseNumber": 2
  },
  {
    "id": "valmiki-ramayana-5-sarga-4-shlok-3",
    "collectionId": "valmiki-ramayana",
    "index": 9085,
    "titleDevanagari": "वाल्मीकि रामायण, सुन्दरकाण्ड, सर्ग 4, श्लोक 3",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-5-sarga-4-shlok-3",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "प्रविश्य नगरी लंकां कपिराजहितंकरः।",
          "चक्रेऽथ पादं सव्यं च शत्रूणां स तु मूर्धनि॥३॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-4",
    "chapterName": "सुन्दरकाण्ड, सर्ग 4",
    "verseNumber": 3
  },
  {
    "id": "valmiki-ramayana-5-sarga-4-shlok-4",
    "collectionId": "valmiki-ramayana",
    "index": 9086,
    "titleDevanagari": "वाल्मीकि रामायण, सुन्दरकाण्ड, सर्ग 4, श्लोक 4",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-5-sarga-4-shlok-4",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "॥ श्रीसीतारामचन्द्राभ्यां नमः॥",
          "श्रीमद्वाल्मीकीय रामायण",
          "सुन्दरकाण्डम्",
          "चतुर्थः सर्गः (4)",
          "प्रविष्टः सत्त्वसम्पन्नो निशायां मारुतात्मजः।",
          "स महापथमास्थाय मुक्तपुष्पविराजितम्॥४॥",
          "ततस्तु तां पुरी लंकां रम्यामभिययौ कपिः।",
          "इ",
          "त्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये सुन्दरकाण्डे चतुर्थः सर्गः॥४॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-4",
    "chapterName": "सुन्दरकाण्ड, सर्ग 4",
    "verseNumber": 4
  },
  {
    "id": "valmiki-ramayana-5-sarga-4-shlok-6",
    "collectionId": "valmiki-ramayana",
    "index": 9087,
    "titleDevanagari": "वाल्मीकि रामायण, सुन्दरकाण्ड, सर्ग 4, श्लोक 6",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-5-sarga-4-shlok-6",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "हसितोत्कृष्टनिनदैस्तूर्यघोषपुरस्कृतैः॥५॥",
          "वज्राङ्कशनिकाशैश्च वज्रजालविभूषितैः।",
          "गृहमेघैः पुरी रम्या बभासे द्यौरिवाम्बुदैः॥६॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-4",
    "chapterName": "सुन्दरकाण्ड, सर्ग 4",
    "verseNumber": 6
  },
  {
    "id": "valmiki-ramayana-5-sarga-4-shlok-7",
    "collectionId": "valmiki-ramayana",
    "index": 9088,
    "titleDevanagari": "वाल्मीकि रामायण, सुन्दरकाण्ड, सर्ग 4, श्लोक 7",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-5-sarga-4-shlok-7",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "प्रजज्वाल तदा लंका रक्षोगणगृहैः शुभैः।",
          "सिताभ्रसदृशैश्चित्रैः पद्मस्वस्तिकसंस्थितैः॥७॥",
          "वर्धमानगृहैश्चापि सर्वतः सुविभूषितैः।",
          "चतुःशालं चतुर्दारं सर्वतोभद्रसंज्ञितम्।",
          "पश्चिमद्वाररहितं नन्द्यावर्ताह्वयन्तु तत्॥",
          "दक्षिणद्वाररहितं वर्धमानं धनप्रदम्।",
          "प्रारद्वाररहितं स्वस्तिकाख्यं पुत्रधनप्रदम्॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-4",
    "chapterName": "सुन्दरकाण्ड, सर्ग 4",
    "verseNumber": 7
  },
  {
