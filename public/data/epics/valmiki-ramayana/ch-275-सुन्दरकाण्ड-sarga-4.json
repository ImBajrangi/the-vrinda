    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-5-sarga-4-shlok-10",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "भवनाद् भवनं गच्छन् ददर्श कपिकुञ्जरः॥९॥",
          "विविधाकृतिरूपाणि भवनानि ततस्ततः।",
          "शुश्राव रुचिरं गीतं त्रिस्थानस्वरभूषितम्॥१०॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-4",
    "chapterName": "सुन्दरकाण्ड, सर्ग 4",
    "verseNumber": 10
  },
