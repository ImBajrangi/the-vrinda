    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "कौसल्यायां महातेजा यथा मातरि वर्तते।",
          "तथा यो वर्ततेऽस्मासु महात्मा क्व नु गच्छति॥ ४॥"
        ]
      }
    ],
    "chapterId": "अयोध्याकाण्ड-sarga-41",
    "chapterName": "अयोध्याकाण्ड, सर्ग 41",
    "verseNumber": 4
  },
  {
