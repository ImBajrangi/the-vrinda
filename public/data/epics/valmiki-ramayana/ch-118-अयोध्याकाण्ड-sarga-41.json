    "slug": "valmiki-ramayana-2-sarga-41-shlok-3",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "न क्रुध्यत्यभिशस्तोऽपि क्रोधनीयानि वर्जयन्।",
          "क्रुद्वान् प्रसादयन् सर्वान् समदुःखः क्व गच्छति॥३॥"
        ]
      }
    ],
    "chapterId": "अयोध्याकाण्ड-sarga-41",
    "chapterName": "अयोध्याकाण्ड, सर्ग 41",
    "verseNumber": 3
  },
  {
