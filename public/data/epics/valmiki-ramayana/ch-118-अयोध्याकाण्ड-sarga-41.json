        "linesDevanagari": [
          "त्रिशङ्कर्लोहिताङ्गश्च बृहस्पतिबुधावपि।",
          "दारुणाः सोममभ्येत्य ग्रहाः सर्वे व्यवस्थिताः॥ ११॥"
        ]
      }
    ],
