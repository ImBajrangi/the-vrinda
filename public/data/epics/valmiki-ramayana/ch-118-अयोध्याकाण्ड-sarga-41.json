    "slug": "valmiki-ramayana-2-sarga-41-shlok-2",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "अनाथस्य जनस्यास्य दुर्बलस्य तपस्विनः।",
          "यो गतिः शरणं चासीत् स नाथः क्व नु गच्छति॥२॥"
        ]
      }
    ],
    "chapterId": "अयोध्याकाण्ड-sarga-41",
    "chapterName": "अयोध्याकाण्ड, सर्ग 41",
    "verseNumber": 2
  },
  {
