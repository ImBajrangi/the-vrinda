    "slug": "valmiki-ramayana-2-sarga-41-shlok-5",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "कैकेय्या क्लिश्यमानेन राज्ञा संचोदितो वनम्।",
          "परित्राता जनस्यास्य जगतः क्व नु गच्छति॥५॥"
        ]
      }
    ],
    "chapterId": "अयोध्याकाण्ड-sarga-41",
    "chapterName": "अयोध्याकाण्ड, सर्ग 41",
    "verseNumber": 5
  },
  {
    "id": "valmiki-ramayana-2-sarga-41-shlok-6",
