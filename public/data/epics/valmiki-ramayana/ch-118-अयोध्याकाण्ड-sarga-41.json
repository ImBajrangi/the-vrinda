    "slug": "valmiki-ramayana-2-sarga-41-shlok-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "तस्मिंस्तु पुरुषव्याघ्र निष्क्रामति कृताञ्जलौ।",
          "आर्तशब्दो हि संजज्ञे स्त्रीणामन्तःपुरे महान्॥१॥"
        ]
      }
    ],
    "chapterId": "अयोध्याकाण्ड-sarga-41",
    "chapterName": "अयोध्याकाण्ड, सर्ग 41",
    "verseNumber": 1
  },
  {
