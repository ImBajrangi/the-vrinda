    "slug": "valmiki-ramayana-3-sarga-50-shlok-9",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "अर्थं वा यदि वा कामं शिष्टाः शास्त्रेष्वनागतम्।",
          "व्यवस्यन्त्यनुराजानं धर्मं पौलस्त्यनन्दन॥९॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-50",
    "chapterName": "अरण्यकाण्ड, सर्ग 50",
    "verseNumber": 9
  },
