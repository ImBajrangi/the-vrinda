    "slug": "valmiki-ramayana-3-sarga-50-shlok-7",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "कथं राजा स्थितो धर्मे परदारान् परामृशेत्॥६॥",
          "रक्षणीया विशेषेण राजदारा महाबल।",
          "निवर्तय गतिं नीचां परदाराभिमर्शनात्॥७॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-50",
    "chapterName": "अरण्यकाण्ड, सर्ग 50",
    "verseNumber": 7
  },
  {
