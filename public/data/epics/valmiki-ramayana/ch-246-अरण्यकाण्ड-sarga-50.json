    "slug": "valmiki-ramayana-3-sarga-50-shlok-12",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "कामस्वभावो यःसोऽसौ न शक्यस्तं प्रमार्जितुम्।",
          "नहि दुष्टात्मनामार्यमावसत्यालये चिरम्॥१२॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-50",
