    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-50-shlok-5",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "तस्यैषा लोकनाथस्य धर्मपत्नी यशस्विनी॥५॥",
          "सीता नाम वरारोहा यां त्वं हर्तुमिहेच्छसि।"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-50",
    "chapterName": "अरण्यकाण्ड, सर्ग 50",
    "verseNumber": 5
  },
  {
