    "titleDevanagari": "वाल्मीकि रामायण, अरण्यकाण्ड, सर्ग 50, श्लोक 1",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-50-shlok-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "तं शब्दमवसुप्तस्तु जटायुरथ शुश्रुवे।",
          "निरैक्षद् रावणं क्षिप्रं वैदेहीं च ददर्श सः॥१॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-50",
    "chapterName": "अरण्यकाण्ड, सर्ग 50",
    "verseNumber": 1
  },
  {
    "id": "valmiki-ramayana-3-sarga-50-shlok-2",
    "collectionId": "valmiki-ramayana",
    "index": 8107,
    "titleDevanagari": "वाल्मीकि रामायण, अरण्यकाण्ड, सर्ग 50, श्लोक 2",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-50-shlok-2",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "ततः पर्वतशृङ्गाभस्तीक्ष्णतुण्डः खगोत्तमः।",
          "वनस्पतिगतः श्रीमान् व्याजहार शुभां गिरम्॥ २॥",
          "दशग्रीव स्थितो धर्मे पुराणे सत्यसंश्रयः।",
          "भ्रातस्त्वं निन्दितं कर्म कर्तुं नार्हसि साम्प्रतम्॥ ३॥",
          "जटायुर्नाम नाम्नाहं गृध्रराजो महाबलः।"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-50",
    "chapterName": "अरण्यकाण्ड, सर्ग 50",
    "verseNumber": 2
  },
  {
    "id": "valmiki-ramayana-3-sarga-50-shlok-4",
    "collectionId": "valmiki-ramayana",
    "index": 8108,
    "titleDevanagari": "वाल्मीकि रामायण, अरण्यकाण्ड, सर्ग 50, श्लोक 4",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-50-shlok-4",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "राजा सर्वस्य लोकस्य महेन्द्रवरुणोपमः॥४॥",
          "लोकानां च हिते युक्तो रामो दशरथात्मजः।"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-50",
    "chapterName": "अरण्यकाण्ड, सर्ग 50",
    "verseNumber": 4
  },
  {
