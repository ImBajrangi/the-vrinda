        "stanzaNumber": 1,
        "linesDevanagari": [
          "न शक्तस्त्वं बलाद्धा वैदेहीं मम पश्यतः।",
          "हेतुभिर्यायसंयुक्तैर्बुवां वेदश्रुतीमिव॥२२॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-50",
