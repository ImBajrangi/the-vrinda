    "slug": "valmiki-ramayana-3-sarga-50-shlok-10",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "राजा धर्मश्च कामश्च द्रव्याणां चोत्तमो निधिः।",
          "धर्मः शुभं वा पापं वा राजमूलं प्रवर्तते॥१०॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-50",
    "chapterName": "अरण्यकाण्ड, सर्ग 50",
    "verseNumber": 10
  },
