    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-73-shlok-28",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "ततस्तद्राम पम्पायास्तीरमाश्रित्य पश्चिमम्।",
          "आश्रमस्थानमतुलं गुह्यं काकुत्स्थ पश्यसि॥ २८॥"
        ]
      }
    ],
