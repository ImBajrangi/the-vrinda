    "titleDevanagari": "वाल्मीकि रामायण, अरण्यकाण्ड, सर्ग 73, श्लोक 1",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-73-shlok-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "दर्शयित्वा तु रामाय सीतायाः परिमार्गणे।",
          "वाक्यमन्वर्थमर्थज्ञः कबन्धः पुनरब्रवीत्॥१॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-73",
    "chapterName": "अरण्यकाण्ड, सर्ग 73",
    "verseNumber": 1
  },
  {
    "id": "valmiki-ramayana-3-sarga-73-shlok-2",
    "collectionId": "valmiki-ramayana",
    "index": 8702,
    "titleDevanagari": "वाल्मीकि रामायण, अरण्यकाण्ड, सर्ग 73, श्लोक 2",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-73-shlok-2",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "एष राम शिवः पन्था यत्रैते पुष्पिता द्रुमाः।",
          "प्रतीची दिशमाश्रित्य प्रकाशन्ते मनोरमाः॥२॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-73",
    "chapterName": "अरण्यकाण्ड, सर्ग 73",
    "verseNumber": 2
  },
  {
    "id": "valmiki-ramayana-3-sarga-73-shlok-3",
    "collectionId": "valmiki-ramayana",
    "index": 8703,
    "titleDevanagari": "वाल्मीकि रामायण, अरण्यकाण्ड, सर्ग 73, श्लोक 3",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-73-shlok-3",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "जम्बूप्रियालपनसा न्यग्रोधप्लक्षतिन्दुकाः।",
          "अश्वत्थाः कर्णिकाराश्च चूताश्चान्ये च पादपाः॥३॥",
          "धन्वना नागवृक्षाश्च तिलका नक्तमालकाः।",
          "नीलाशोकाः कदम्बाश्च करवीराश्च पुष्पिताः॥ ४॥",
          "अग्निमुख्या अशोकाश्च सुरक्ताः पारिभद्रकाः।",
          "तानारुह्याथवा भूमौ पातयित्वा च तान् बलात्॥",
          "फलान्यमृतकल्पानि भक्षयित्वा गमिष्यथः।"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-73",
    "chapterName": "अरण्यकाण्ड, सर्ग 73",
    "verseNumber": 3
  },
  {
    "id": "valmiki-ramayana-3-sarga-73-shlok-7",
    "collectionId": "valmiki-ramayana",
    "index": 8704,
    "titleDevanagari": "वाल्मीकि रामायण, अरण्यकाण्ड, सर्ग 73, श्लोक 7",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-73-shlok-7",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "तदतिक्रम्य काकुत्स्थ वनं पुष्पितपादपम्॥६॥",
          "नन्दनप्रतिमं चान्यत् कुरवस्तूत्तरा इव।",
          "सर्वकालफला यत्र पादपा मधुरस्रवाः॥७॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-73",
    "chapterName": "अरण्यकाण्ड, सर्ग 73",
    "verseNumber": 7
  },
  {
