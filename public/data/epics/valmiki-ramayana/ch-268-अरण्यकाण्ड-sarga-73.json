    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-73-shlok-27",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "तेषां गतानामद्यापि दृश्यते परिचारिणी।",
          "श्रमणी शबरी नाम काकुत्स्थ चिरजीविनी॥ २६॥",
          "त्वां तु धर्मे स्थिता नित्यं सर्वभूतनमस्कृतम्।",
          "दृष्ट्वा देवोपमं राम स्वर्गलोकं गमिष्यति॥२७॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-73",
    "chapterName": "अरण्यकाण्ड, सर्ग 73",
    "verseNumber": 27
  },
  {
