    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "आकाशमिव दुष्पारं सागरं प्रेक्ष्य वानराः।",
          "विषेदुः सहिताः सर्वे कथं कार्यमिति ब्रुवन्॥७॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-64",
    "chapterName": "बालकाण्ड, सर्ग 64",
    "verseNumber": 7
