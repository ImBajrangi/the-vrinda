    "slug": "valmiki-ramayana-1-sarga-64-shlok-2-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "सम्पातेर्वचनं श्रुत्वा हरयो रावणक्षयम्।",
          "हृष्टाः सागरमाजग्मुः सीतादर्शनकांक्षिणः॥२॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-64",
    "chapterName": "बालकाण्ड, सर्ग 64",
    "verseNumber": 2
  },
  {
