    "slug": "valmiki-ramayana-1-sarga-64-shlok-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "आख्याता गृध्रराजेन समुत्प्लुत्य प्लवङ्गमाः।",
          "संगताः प्रीतिसंयुक्ता विनेदुः सिंहविक्रमाः॥१॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-64",
    "chapterName": "बालकाण्ड, सर्ग 64",
    "verseNumber": 1
  },
  {
    "id": "valmiki-ramayana-1-sarga-64-shlok-2-1",
    "collectionId": "valmiki-ramayana",
    "index": 2643,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 64, श्लोक 2",
