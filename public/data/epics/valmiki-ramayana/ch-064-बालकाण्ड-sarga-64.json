    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "दक्षिणस्य समुद्रस्य समासाद्योत्तरां दिशम्।",
          "संनिवेशं ततश्चक्रुर्हरिवीरा महाबलाः॥४॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-64",
    "chapterName": "बालकाण्ड, सर्ग 64",
    "verseNumber": 4
  },
  {
