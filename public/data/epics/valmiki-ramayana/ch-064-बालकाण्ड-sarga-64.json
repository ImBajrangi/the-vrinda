    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "प्रसुप्तमिव चान्यत्र क्रीडन्तमिव चान्यतः।",
          "क्वचित् पर्वतमात्रैश्च जलराशिभिरावृतम्॥५॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-64",
    "chapterName": "बालकाण्ड, सर्ग 64",
    "verseNumber": 5
  },
