        "linesDevanagari": [
          "संकुलं दानवेन्द्रश्च पातालतलवासिभिः।",
          "रोमहर्षकरं दृष्ट्वा विषेदुः कपिकुञ्जराः॥६॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-64",
    "chapterName": "बालकाण्ड, सर्ग 64",
    "verseNumber": 6
