    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "अभिगम्य तु तं देशं ददृशुर्भीमविक्रमाः।",
          "कृत्स्नं लोकस्य महतः प्रतिबिम्बमवस्थितम्॥३॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-64",
    "chapterName": "बालकाण्ड, सर्ग 64",
    "verseNumber": 3
  },
  {
