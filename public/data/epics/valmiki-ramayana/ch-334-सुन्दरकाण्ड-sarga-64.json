    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-5-sarga-64-shlok-15",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "पीत्वा मधु यथाकामं विक्रान्ता वनचारिणः।",
          "किं शेषं गमनं तत्र सुग्रीवो यत्र वानरः॥१५॥",
          "सर्वे यथा मां वक्ष्यन्ति समेत्य हरिपुङ्गवाः।",
          "तथास्मि कर्ता कर्तव्ये भवद्भिः परवानहम्॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-64",
    "chapterName": "सुन्दरकाण्ड, सर्ग 64",
    "verseNumber": 15
  },
