[
  {
    "id": "valmiki-ramayana-5-sarga-64-shlok-1",
    "collectionId": "valmiki-ramayana",
    "index": 11131,
    "titleDevanagari": "वाल्मीकि रामायण, सुन्दरकाण्ड, सर्ग 64, श्लोक 1",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-5-sarga-64-shlok-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "सुग्रीवेणैवमुक्तस्तु हृष्टो दधिमुखः कपिः।",
          "राघवं लक्ष्मणं चैव सुग्रीवं चाभ्यवादयत्॥१॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-64",
    "chapterName": "सुन्दरकाण्ड, सर्ग 64",
    "verseNumber": 1
  },
  {
    "id": "valmiki-ramayana-5-sarga-64-shlok-2",
    "collectionId": "valmiki-ramayana",
    "index": 11132,
    "titleDevanagari": "वाल्मीकि रामायण, सुन्दरकाण्ड, सर्ग 64, श्लोक 2",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-5-sarga-64-shlok-2",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "स प्रणम्य च सुग्रीवं राघवौ च महाबलौ।",
          "वानरैः सहितः शूरैर्दिवमेवोत्पपात ह॥२॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-64",
    "chapterName": "सुन्दरकाण्ड, सर्ग 64",
    "verseNumber": 2
  },
  {
    "id": "valmiki-ramayana-5-sarga-64-shlok-3",
    "collectionId": "valmiki-ramayana",
    "index": 11133,
    "titleDevanagari": "वाल्मीकि रामायण, सुन्दरकाण्ड, सर्ग 64, श्लोक 3",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-5-sarga-64-shlok-3",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "स यथैवागतः पूर्वं तथैव त्वरितं गतः।",
          "निपत्य गगनाद् भूमौ तद् वनं प्रविवेश ह॥३॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-64",
    "chapterName": "सुन्दरकाण्ड, सर्ग 64",
    "verseNumber": 3
  },
  {
    "id": "valmiki-ramayana-5-sarga-64-shlok-4",
    "collectionId": "valmiki-ramayana",
    "index": 11134,
    "titleDevanagari": "वाल्मीकि रामायण, सुन्दरकाण्ड, सर्ग 64, श्लोक 4",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-5-sarga-64-shlok-4",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "स प्रविष्टो मधुवनं ददर्श हरियूथपान्।",
          "विमदानुद्धतान् सर्वान् मेहमानान् मधूदकम्॥४॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-64",
    "chapterName": "सुन्दरकाण्ड, सर्ग 64",
    "verseNumber": 4
  },
  {
    "id": "valmiki-ramayana-5-sarga-64-shlok-5",
    "collectionId": "valmiki-ramayana",
    "index": 11135,
    "titleDevanagari": "वाल्मीकि रामायण, सुन्दरकाण्ड, सर्ग 64, श्लोक 5",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-5-sarga-64-shlok-5",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "स तानुपागमद् वीरो बद्ध्वा करपुटाञ्जलिम्।",
          "उवाच वचनं श्लक्ष्णमिदं हृष्टवदङ्गदम्॥५॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-64",
    "chapterName": "सुन्दरकाण्ड, सर्ग 64",
    "verseNumber": 5
  },
  {
    "id": "valmiki-ramayana-5-sarga-64-shlok-6",
    "collectionId": "valmiki-ramayana",
    "index": 11136,
    "titleDevanagari": "वाल्मीकि रामायण, सुन्दरकाण्ड, सर्ग 64, श्लोक 6",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-5-sarga-64-shlok-6",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "सौम्य रोषो न कर्तव्यो यदेभिः परिवारणम्।",
          "अज्ञानाद् रक्षिभिः क्रोधाद् भवन्तः प्रतिषेधिताः॥६॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-64",
    "chapterName": "सुन्दरकाण्ड, सर्ग 64",
    "verseNumber": 6
  },
  {
    "id": "valmiki-ramayana-5-sarga-64-shlok-7",
    "collectionId": "valmiki-ramayana",
    "index": 11137,
    "titleDevanagari": "वाल्मीकि रामायण, सुन्दरकाण्ड, सर्ग 64, श्लोक 7",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-5-sarga-64-shlok-7",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "श्रान्तो दूरादनुप्राप्तो भक्षयस्व स्वकं मधु।",
          "युवराजस्त्वमीशश्च वनस्यास्य महाबल॥७॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-64",
    "chapterName": "सुन्दरकाण्ड, सर्ग 64",
    "verseNumber": 7
  },
  {
    "id": "valmiki-ramayana-5-sarga-64-shlok-8",
    "collectionId": "valmiki-ramayana",
    "index": 11138,
    "titleDevanagari": "वाल्मीकि रामायण, सुन्दरकाण्ड, सर्ग 64, श्लोक 8",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-5-sarga-64-shlok-8",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "मौात् पूर्वं कृतो रोषस्तद् भवान् क्षन्तुमर्हति।",
          "यथैव हि पिता तेऽभूत् पूर्वं हरिगणेश्वरः॥८॥",
          "तथा त्वमपि सुग्रीवो नान्यस्तु हरिसत्तम।"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-64",
    "chapterName": "सुन्दरकाण्ड, सर्ग 64",
    "verseNumber": 8
  },
  {
    "id": "valmiki-ramayana-5-sarga-64-shlok-9",
    "collectionId": "valmiki-ramayana",
    "index": 11139,
    "titleDevanagari": "वाल्मीकि रामायण, सुन्दरकाण्ड, सर्ग 64, श्लोक 9",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-5-sarga-64-shlok-9",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "आख्यातं हि मया गत्वा पितृव्यस्य तवानघ॥९॥",
          "इहोपयानं सर्वेषामेतेषां वनचारिणाम्।",
          "भवदागमनं श्रुत्वा सहैभिर्वनचारिभिः॥१०॥",
          "प्रहृष्टो न तु रुष्टोऽसौ वनं श्रुत्वा प्रधर्षितम्।"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-64",
    "chapterName": "सुन्दरकाण्ड, सर्ग 64",
    "verseNumber": 9
  },
  {
