    "slug": "valmiki-ramayana-5-sarga-64-shlok-14",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "शङ्के श्रुतोऽयं वृत्तान्तो रामेण हरियूथपाः॥१३॥",
          "अयं च हर्षादाख्याति तेन जानामि हेतुना।",
          "तत् क्षमं नेह नः स्थातुं कृते कार्ये परंतपाः॥१४॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-64",
    "chapterName": "सुन्दरकाण्ड, सर्ग 64",
    "verseNumber": 14
  },
  {
