    "slug": "valmiki-ramayana-5-sarga-64-shlok-12",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "श्रुत्वा दधिमुखस्यैतद् वचनं श्लक्ष्णमङ्गदः॥१२॥",
          "अब्रवीत् तान् हरिश्रेष्ठो वाक्यं वाक्यविशारदः।"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-64",
    "chapterName": "सुन्दरकाण्ड, सर्ग 64",
    "verseNumber": 12
