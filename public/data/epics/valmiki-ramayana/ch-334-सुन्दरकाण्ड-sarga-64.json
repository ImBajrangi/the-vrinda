    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-5-sarga-64-shlok-11",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "प्रहृष्टो मां पितृव्यस्ते सुग्रीवो वानरेश्वरः॥११॥",
          "शीघ्रं प्रेषय सर्वांस्तानिति होवाच पार्थिवः।"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-64",
    "chapterName": "सुन्दरकाण्ड, सर्ग 64",
    "verseNumber": 11
  },
