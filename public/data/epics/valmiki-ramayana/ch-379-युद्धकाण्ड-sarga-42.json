    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "स चिन्तयित्वा सुचिरं धैर्यमालम्ब्य रावणः।",
          "राघवं हरियूथांश्च ददर्शायतलोचनः॥५॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-42",
    "chapterName": "युद्धकाण्ड, सर्ग 42",
    "verseNumber": 5
  },
