    "slug": "valmiki-ramayana-6-sarga-42-shlok-3",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "स ददर्श वृतां लङ्कां सशैलवनकाननाम्।",
          "असंख्येयैर्हरिगणैः सर्वतो युद्धकातिभिः॥३॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-42",
    "chapterName": "युद्धकाण्ड, सर्ग 42",
    "verseNumber": 3
  },
  {
