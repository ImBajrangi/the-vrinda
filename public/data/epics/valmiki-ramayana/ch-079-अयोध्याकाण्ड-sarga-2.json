      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "राजलक्षणयुक्तेन कान्तेनानुपमेन च।",
          "उवाच रसयुक्तेन स्वरेण नृपतिर्नुपान्॥३॥"
        ]
      }
    ],
    "chapterId": "अयोध्याकाण्ड-sarga-2",
    "chapterName": "अयोध्याकाण्ड, सर्ग 2",
