    "slug": "valmiki-ramayana-2-sarga-5-shlok-2",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "गच्छोपवासं काकुत्स्थं कारयाद्य तपोधन।",
          "श्रेयसे राज्यलाभाय वध्वा सह यतव्रत॥२॥"
        ]
      }
    ],
    "chapterId": "अयोध्याकाण्ड-sarga-5",
    "chapterName": "अयोध्याकाण्ड, सर्ग 5",
    "verseNumber": 2
  },
  {
