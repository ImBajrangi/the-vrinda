    "slug": "valmiki-ramayana-2-sarga-5-shlok-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "संदिश्य रामं नृपतिः श्वोभाविन्यभिषेचने।",
          "पुरोहितं समाहूय वसिष्ठमिदमब्रवीत्॥१॥"
        ]
      }
    ],
    "chapterId": "अयोध्याकाण्ड-sarga-5",
    "chapterName": "अयोध्याकाण्ड, सर्ग 5",
    "verseNumber": 1
  },
  {
