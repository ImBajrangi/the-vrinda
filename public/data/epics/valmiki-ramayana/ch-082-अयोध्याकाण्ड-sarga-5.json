        "stanzaNumber": 1,
        "linesDevanagari": [
          "अभ्येत्य त्वरमाणोऽथ रथाभ्याशं मनीषिणः।",
          "ततोऽवतारयामास परिगृह्य रथात् स्वयम्॥७॥"
        ]
      }
    ],
    "chapterId": "अयोध्याकाण्ड-sarga-5",
    "chapterName": "अयोध्याकाण्ड, सर्ग 5",
    "verseNumber": 7
  },
