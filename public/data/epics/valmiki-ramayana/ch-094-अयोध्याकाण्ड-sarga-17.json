    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-2-sarga-17-shlok-7",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "आशीर्वादान् बहून् शृण्वन् सुहृद्भिः समुदीरितान्॥७॥",
          "यथार्हं चापि सम्पूज्य सर्वानेव नरान् ययौ।"
        ]
      }
    ],
    "chapterId": "अयोध्याकाण्ड-sarga-17",
    "chapterName": "अयोध्याकाण्ड, सर्ग 17",
    "verseNumber": 7
  },
  {
