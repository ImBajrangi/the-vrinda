    "titleDevanagari": "वाल्मीकि रामायण, अयोध्याकाण्ड, सर्ग 17, श्लोक 19",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-2-sarga-17-shlok-19",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "स राजकुलमासाद्य मेघसङ्घोपमैः शुभैः।",
          "प्रासादशृङ्गैर्विविधैः कैलासशिखरोपमैः॥१७॥",
          "आवारयद्भिर्गगनं विमानैरिव पाण्डुरैः।",
          "वर्धमानगृहैश्चापि रत्नजालपरिष्कृतैः॥१८॥",
          "तत् पृथिव्यां गृहवरं महेन्द्रसदनोपमम्।",
          "राजपुत्रः पितुर्वेश्म प्रविवेश श्रिया ज्वलन्॥ १९॥"
        ]
      }
    ],
    "chapterId": "अयोध्याकाण्ड-sarga-17",
    "chapterName": "अयोध्याकाण्ड, सर्ग 17",
    "verseNumber": 19
  },
