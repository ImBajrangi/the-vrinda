    "slug": "valmiki-ramayana-2-sarga-17-shlok-13",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "न हि तस्मान्मनः कश्चिच्चक्षुषी वा नरोत्तमात्।",
          "नरः शक्नोत्यपाक्रष्टमतिक्रान्तेऽपि राघवे॥१३॥"
        ]
      }
    ],
    "chapterId": "अयोध्याकाण्ड-sarga-17",
