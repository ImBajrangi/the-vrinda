    "slug": "valmiki-ramayana-2-sarga-17-shlok-10",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "अलमद्य हि भुक्तेन परमार्थैरलं च नः।",
          "यदि पश्याम निर्यान्तं रामं राज्ये प्रतिष्ठितम्॥ १०॥"
        ]
      }
    ],
    "chapterId": "अयोध्याकाण्ड-sarga-17",
