    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-2-sarga-17-shlok-16",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "सर्वेषु स हि धर्मात्मा वर्णानां कुरुते दयाम्।",
          "चतुर्णां हि वयःस्थानां तेन ते तमनुव्रताः॥१६॥",
          "चतुष्पथान् देवपथांश्चैत्यांश्चायतनानि च।",
          "प्रदक्षिणं परिहरज्जगाम नृपतेः सुतः॥१६॥"
        ]
      }
    ],
    "chapterId": "अयोध्याकाण्ड-sarga-17",
    "chapterName": "अयोध्याकाण्ड, सर्ग 17",
    "verseNumber": 16
  },
  {
