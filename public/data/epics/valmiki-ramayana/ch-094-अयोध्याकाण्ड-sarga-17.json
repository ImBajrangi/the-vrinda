    "slug": "valmiki-ramayana-2-sarga-17-shlok-14",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "यश्च रामं न पश्येत्तु यं च रामो न पश्यति।",
          "निन्दितः सर्वलोकेष स्वात्माप्येनं विगर्हते॥१४॥"
        ]
      }
    ],
    "chapterId": "अयोध्याकाण्ड-sarga-17",
    "chapterName": "अयोध्याकाण्ड, सर्ग 17",
