    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-2-sarga-17-shlok-9",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "यथा स्म पोषिताः पित्रा यथा सर्वैः पितामहैः।",
          "ततः सुखतरं सर्वे रामे वत्स्याम राजनि॥९॥"
        ]
      }
    ],
    "chapterId": "अयोध्याकाण्ड-sarga-17",
    "chapterName": "अयोध्याकाण्ड, सर्ग 17",
    "verseNumber": 9
  },
