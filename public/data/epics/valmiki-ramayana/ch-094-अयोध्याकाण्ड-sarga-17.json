[
  {
    "id": "valmiki-ramayana-2-sarga-17-shlok-1",
    "collectionId": "valmiki-ramayana",
    "index": 3598,
    "titleDevanagari": "वाल्मीकि रामायण, अयोध्याकाण्ड, सर्ग 17, श्लोक 1",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-2-sarga-17-shlok-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "स रामो रथमास्थाय सम्प्रहृष्टसुहृज्जनः।",
          "पताकाध्वजसम्पन्नं महागुरुधूपितम्॥१॥",
          "अपश्यन्नगरं श्रीमान् नानाजनसमन्वितम्।",
          "स गृहैरभ्रसंकाशैः पाण्डुरैरुपशोभितम्॥२॥",
          "राजमार्ग ययौ रामो मध्येनागुरुधूपितम्।"
        ]
      }
    ],
    "chapterId": "अयोध्याकाण्ड-sarga-17",
    "chapterName": "अयोध्याकाण्ड, सर्ग 17",
    "verseNumber": 1
  },
  {
    "id": "valmiki-ramayana-2-sarga-17-shlok-5",
    "collectionId": "valmiki-ramayana",
    "index": 3599,
    "titleDevanagari": "वाल्मीकि रामायण, अयोध्याकाण्ड, सर्ग 17, श्लोक 5",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-2-sarga-17-shlok-5",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "चन्दनानां च मुख्यानामगुरूणां च संचयैः ॥ ३॥",
          "उत्तमानां च गन्धानां क्षौमकौशाम्बरस्य च।",
          "अविद्धाभिश्च मुक्ताभिरुत्तमैः स्फाटिकैरपि॥ ४॥",
          "शोभमानमसम्बाधं तं राजपथमुत्तमम्।",
          "संवृतं विविधैः पुष्पैर्भक्ष्यैरुच्चावचैरपि॥५॥",
          "ददर्श तं राजपथं दिवि देवपतिर्यथा।",
          "दध्यक्षतहविर्लाजैबूंपैरगुरुचन्दनैः॥६॥",
          "नानामाल्योपगन्धैश्च सदाभ्यर्चितचत्वरम्।"
        ]
      }
    ],
    "chapterId": "अयोध्याकाण्ड-sarga-17",
    "chapterName": "अयोध्याकाण्ड, सर्ग 17",
    "verseNumber": 5
  },
  {
