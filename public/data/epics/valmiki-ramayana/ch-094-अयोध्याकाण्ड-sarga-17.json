    "titleDevanagari": "वाल्मीकि रामायण, अयोध्याकाण्ड, सर्ग 17, श्लोक 8",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-2-sarga-17-shlok-8",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "पितामहैराचरितं तथैव प्रपितामहैः॥८॥",
          "अद्योपादाय तं मार्गमभिषिक्तोऽनुपालय। ।"
        ]
      }
    ],
    "chapterId": "अयोध्याकाण्ड-sarga-17",
    "chapterName": "अयोध्याकाण्ड, सर्ग 17",
    "verseNumber": 8
  },
