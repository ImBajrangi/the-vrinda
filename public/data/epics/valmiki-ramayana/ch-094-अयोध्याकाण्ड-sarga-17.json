    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "॥ श्रीसीतारामचन्द्राभ्यां नमः॥",
          "श्रीमद्वाल्मीकीय रामायण",
          "अयोध्याकाण्डम्",
          "सप्तदशः सर्गः (सर्ग 17)",
          "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्येऽयोध्याकाण्डे सप्तदशः सर्गः॥१७॥"
        ]
      }
    ],
    "chapterId": "अयोध्याकाण्ड-sarga-17",
    "chapterName": "अयोध्याकाण्ड, सर्ग 17",
    "verseNumber": 17
  },
  {
    "id": "valmiki-ramayana-2-sarga-17-shlok-19",
