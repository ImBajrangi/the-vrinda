    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "गुहेन सार्धं तत्रैव स्थितोऽस्मि दिवसान् बहून्।",
          "आशया यदि मां रामः पुनः शब्दापयेदिति॥३॥"
        ]
      }
    ],
    "chapterId": "अयोध्याकाण्ड-sarga-59",
    "chapterName": "अयोध्याकाण्ड, सर्ग 59",
    "verseNumber": 3
  },
