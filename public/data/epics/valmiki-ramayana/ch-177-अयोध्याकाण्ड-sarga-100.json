    "slug": "valmiki-ramayana-2-sarga-100-shlok-4",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "क्व नु तेऽभूत् पिता तात यदरण्यं त्वमागतः।",
          "न हि त्वं जीवतस्तस्य वनमागन्तुमर्हसि ॥४॥"
        ]
      }
    ],
    "chapterId": "अयोध्याकाण्ड-sarga-100",
    "chapterName": "अयोध्याकाण्ड, सर्ग 100",
    "verseNumber": 4
  },
  {
