    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-2-sarga-100-shlok-5",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "चिरस्य बत पश्यामि दूराद् भरतमागतम्।",
          "दुष्प्रतीकमरण्येऽस्मिन् किं तात वनमागतः॥५॥",
          "कच्चिन्नु धरते तात राजा यत् त्वमिहागतः।",
          "कच्चिन्न दीनः सहसा राजा लोकान्तरं गतः॥"
        ]
      }
    ],
    "chapterId": "अयोध्याकाण्ड-sarga-100",
    "chapterName": "अयोध्याकाण्ड, सर्ग 100",
    "verseNumber": 5
  },
  {
