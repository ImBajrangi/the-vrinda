    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-37-shlok-7",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "त्वद्विधः कामवृत्तो हि दुःशीलः पापमन्त्रितः।",
          "आत्मानं स्वजनं राष्ट्र स राजा हन्ति दुर्मतिः॥७॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-37",
    "chapterName": "अरण्यकाण्ड, सर्ग 37",
    "verseNumber": 7
  },
  {
    "id": "valmiki-ramayana-3-sarga-37-shlok-8",
