    "slug": "valmiki-ramayana-3-sarga-37-shlok-9",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "न च धर्मगुणहीनः कौसल्यानन्दवर्धनः।",
          "न च तीक्ष्णो हि भूतानां सर्वभूतहिते रतः॥९॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-37",
    "chapterName": "अरण्यकाण्ड, सर्ग 37",
    "verseNumber": 9
  },
  {
