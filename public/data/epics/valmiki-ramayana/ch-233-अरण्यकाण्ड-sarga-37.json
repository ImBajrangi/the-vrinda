    "titleDevanagari": "वाल्मीकि रामायण, अरण्यकाण्ड, सर्ग 37, श्लोक 1",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-37-shlok-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "तच्छ्रत्वा राक्षसेन्द्रस्य वाक्यं वाक्यविशारदः।",
          "प्रत्युवाच महातेजा मारीचो राक्षसेश्वरम्॥१॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-37",
    "chapterName": "अरण्यकाण्ड, सर्ग 37",
    "verseNumber": 1
  },
  {
    "id": "valmiki-ramayana-3-sarga-37-shlok-2",
    "collectionId": "valmiki-ramayana",
    "index": 7751,
    "titleDevanagari": "वाल्मीकि रामायण, अरण्यकाण्ड, सर्ग 37, श्लोक 2",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-37-shlok-2",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "सुलभाः पुरुषा राजन् सततं प्रियवादिनः।",
          "अप्रियस्य च पथ्यस्य वक्ता श्रोता च दुर्लभः॥ २॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-37",
    "chapterName": "अरण्यकाण्ड, सर्ग 37",
    "verseNumber": 2
  },
  {
    "id": "valmiki-ramayana-3-sarga-37-shlok-3",
    "collectionId": "valmiki-ramayana",
    "index": 7752,
    "titleDevanagari": "वाल्मीकि रामायण, अरण्यकाण्ड, सर्ग 37, श्लोक 3",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-37-shlok-3",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "न नूनं बुध्यसे रामं महावीर्यगुणोन्नतम्।",
          "अयुक्तचारश्चपलो महेन्द्रवरुणोपमम्॥३॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-37",
    "chapterName": "अरण्यकाण्ड, सर्ग 37",
    "verseNumber": 3
  },
  {
    "id": "valmiki-ramayana-3-sarga-37-shlok-4",
    "collectionId": "valmiki-ramayana",
    "index": 7753,
    "titleDevanagari": "वाल्मीकि रामायण, अरण्यकाण्ड, सर्ग 37, श्लोक 4",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-37-shlok-4",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "अपि स्वस्ति भवेत् तात सर्वेषामपि रक्षसाम्।",
          "अपि रामो न संक्रुद्धः कुर्याल्लोकानराक्षसान्॥ ४॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-37",
    "chapterName": "अरण्यकाण्ड, सर्ग 37",
    "verseNumber": 4
  },
  {
    "id": "valmiki-ramayana-3-sarga-37-shlok-5",
    "collectionId": "valmiki-ramayana",
    "index": 7754,
    "titleDevanagari": "वाल्मीकि रामायण, अरण्यकाण्ड, सर्ग 37, श्लोक 5",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-37-shlok-5",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "अपि ते जीवितान्ताय नोत्पन्ना जनकात्मजा।",
          "अपि सीतानिमित्तं च न भवेद् व्यसनं महत्॥५॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-37",
    "chapterName": "अरण्यकाण्ड, सर्ग 37",
    "verseNumber": 5
  },
  {
    "id": "valmiki-ramayana-3-sarga-37-shlok-6",
    "collectionId": "valmiki-ramayana",
    "index": 7755,
    "titleDevanagari": "वाल्मीकि रामायण, अरण्यकाण्ड, सर्ग 37, श्लोक 6",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-37-shlok-6",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "अपि त्वामीश्वरं प्राप्य कामवृत्तं निरङ्कशम्।",
          "न विनश्येत् पुरी लङ्का त्वया सह सराक्षसा॥६॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-37",
    "chapterName": "अरण्यकाण्ड, सर्ग 37",
    "verseNumber": 6
  },
  {
    "id": "valmiki-ramayana-3-sarga-37-shlok-7",
