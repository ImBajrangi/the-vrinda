    "slug": "valmiki-ramayana-3-sarga-37-shlok-19",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "तस्य वै नरसिंहस्य सिंहोरस्कस्य भामिनी।",
          "प्राणेभ्योऽपि प्रियतरा भार्या नित्यमनुव्रता॥१९॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-37",
