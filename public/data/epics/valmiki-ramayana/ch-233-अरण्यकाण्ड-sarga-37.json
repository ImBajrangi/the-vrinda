    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-37-shlok-12",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "न रामः कर्कशस्तात नाविद्वान् नाजितेन्द्रियः।",
          "अनृतं न श्रुतं चैव नैव त्वं वक्तुमर्हसि ॥१२॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-37",
    "chapterName": "अरण्यकाण्ड, सर्ग 37",
    "verseNumber": 12
  },
