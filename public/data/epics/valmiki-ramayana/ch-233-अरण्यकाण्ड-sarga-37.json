    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-37-shlok-13",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "रामो विग्रहवान् धर्मः साधुः सत्यपराक्रमः।",
          "राजा सर्वस्य लोकस्य देवानामिव वासवः॥ १३॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-37",
    "chapterName": "अरण्यकाण्ड, सर्ग 37",
    "verseNumber": 13
  },
