    "slug": "valmiki-ramayana-3-sarga-37-shlok-15",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "शरार्चिषमनाधृष्यं चापखड्गेन्धनं रणे।",
          "रामाग्निं सहसा दीप्तं न प्रवेष्टं त्वमर्हसि॥१५॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-37",
