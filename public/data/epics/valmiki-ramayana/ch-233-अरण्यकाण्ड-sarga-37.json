    "slug": "valmiki-ramayana-3-sarga-37-shlok-14",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "कथं नु तस्य वैदेहीं रक्षितां स्वेन तेजसा।",
          "इच्छसे प्रसभं हर्तुं प्रभामिव विवस्वतः॥१४॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-37",
    "chapterName": "अरण्यकाण्ड, सर्ग 37",
    "verseNumber": 14
