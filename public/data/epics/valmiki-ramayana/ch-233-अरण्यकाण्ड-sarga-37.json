      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "अप्रमेयं हि तत्तेजो यस्य सा जनकात्मजा।",
          "न त्वं समर्थस्तां हर्तुं रामचापाश्रयां वने॥१८॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-37",
    "chapterName": "अरण्यकाण्ड, सर्ग 37",
    "verseNumber": 18
