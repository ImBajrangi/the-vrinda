        "stanzaNumber": 1,
        "linesDevanagari": [
          "किमुद्यम व्यर्थमिमं कृत्वा ते राक्षसाधिप।",
          "दृष्टश्चेत् त्वं रणे तेन तदन्तमुपजीवितम्॥ २१॥"
        ]
      }
