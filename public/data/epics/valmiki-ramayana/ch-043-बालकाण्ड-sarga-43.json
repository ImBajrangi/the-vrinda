    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "तस्यावलेपनं ज्ञात्वा क्रुद्धस्तु भगवान् हरः॥६॥",
          "तिरोभावयितुं बुद्धिं चक्रे त्रिनयनस्तदा।"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-43",
    "chapterName": "बालकाण्ड, सर्ग 43",
    "verseNumber": 6
  },
