    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 43, श्लोक 1",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-43-shlok-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "देवदेवे गते तस्मिन् सोऽङ्गुष्ठाग्रनिपीडिताम्।",
          "कृत्वा वसुमतीं राम वत्सरं समुपासत॥१॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-43",
    "chapterName": "बालकाण्ड, सर्ग 43",
    "verseNumber": 1
  },
  {
    "id": "valmiki-ramayana-1-sarga-43-shlok-2-1",
    "collectionId": "valmiki-ramayana",
    "index": 2050,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 43, श्लोक 2",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-43-shlok-2-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "ततः संदिश्य सुग्रीवः श्वशुरं पश्चिमां दिशम्।",
          "वीरं शतबलिं नाम वानरं वानरेश्वरः॥१॥",
          "उवाच राजा सर्वज्ञः सर्ववानरसत्तमः।",
          "वाक्यमात्महितं चैव रामस्य च हितं तदा ॥२॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-43",
    "chapterName": "बालकाण्ड, सर्ग 43",
    "verseNumber": 2
  },
  {
    "id": "valmiki-ramayana-1-sarga-43-shlok-3",
    "collectionId": "valmiki-ramayana",
    "index": 2051,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 43, श्लोक 3",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-43-shlok-3",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "प्रीतस्तेऽहं नरश्रेष्ठ करिष्यामि तव प्रियम्।",
          "शिरसा धारयिष्यामि शैलराजसुतामहम्॥३॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-43",
    "chapterName": "बालकाण्ड, सर्ग 43",
    "verseNumber": 3
  },
  {
    "id": "valmiki-ramayana-1-sarga-43-shlok-4",
    "collectionId": "valmiki-ramayana",
    "index": 2052,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 43, श्लोक 4",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-43-shlok-4",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "वृतः शतसहस्रेण त्वद्विधानां वनौकसाम्।",
          "वैवस्वतसुतैः सार्धं प्रविष्टः सर्वमन्त्रिभिः॥३॥",
          "दिशं युदीची विक्रान्तां हिमशैलावतंसिकाम्।",
          "सर्वतः परिमार्गध्वं रामपत्नी यशस्विनीम्॥४॥",
          "अस्मिन् कार्ये विनिर्वृत्ते कृते दाशरथेः प्रिये।",
          "ऋणान्मुक्ता भविष्यामः कृतार्थार्थविदां वराः॥",
          "कृतं हि प्रियमस्माकं राघवेण महात्मना।",
          "तस्य चेत्प्रतिकारोऽस्ति सफलं जीवितं भवेत्॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-43",
    "chapterName": "बालकाण्ड, सर्ग 43",
    "verseNumber": 4
  },
  {
