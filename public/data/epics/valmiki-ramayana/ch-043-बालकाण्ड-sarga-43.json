        "stanzaNumber": 1,
        "linesDevanagari": [
          "विससर्ज ततो गंगां हरो बिन्दुसरः प्रति।",
          "तस्यां विसृज्यमानायां सप्त स्रोतांसि जज्ञिरे॥ ११॥"
        ]
      }
