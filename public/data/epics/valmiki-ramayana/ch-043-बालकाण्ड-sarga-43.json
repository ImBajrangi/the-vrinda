    "slug": "valmiki-ramayana-1-sarga-43-shlok-5",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "अचिन्तयच्च सा देवी गंगा परमदुर्धरा॥५॥",
          "विशाम्यहं हि पातालं स्रोतसा गृह्य शङ्करम्।"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-43",
    "chapterName": "बालकाण्ड, सर्ग 43",
    "verseNumber": 5
  },
