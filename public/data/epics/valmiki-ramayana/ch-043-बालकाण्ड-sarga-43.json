    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "अर्थिनः कार्यनिर्वृत्तिमकर्तुरपि यश्चरेत्।",
          "तस्य स्यात् सफलं जन्म किं पुनः पूर्वकारिणः॥७॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-43",
    "chapterName": "बालकाण्ड, सर्ग 43",
