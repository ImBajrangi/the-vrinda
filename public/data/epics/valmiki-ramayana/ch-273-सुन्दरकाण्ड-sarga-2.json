    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "शतान्यहं योजनानां क्रमेयं सुबहून्यपि।",
          "किं पुनः सागरस्यान्तं संख्यातं शतयोजनम्॥४॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-2",
    "chapterName": "सुन्दरकाण्ड, सर्ग 2",
    "verseNumber": 4
  },
