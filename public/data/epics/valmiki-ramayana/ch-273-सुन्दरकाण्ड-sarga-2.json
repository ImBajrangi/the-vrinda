    "slug": "valmiki-ramayana-5-sarga-2-shlok-3",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "योजनानां शतं श्रीमांस्ती प्युत्तमविक्रमः।",
          "अनिःश्वसन् कपिस्तत्र न ग्लानिमधिगच्छति॥३॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-2",
    "chapterName": "सुन्दरकाण्ड, सर्ग 2",
    "verseNumber": 3
  },
  {
