    "slug": "valmiki-ramayana-5-sarga-2-shlok-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "स सागरमनाधृष्यमतिक्रम्य महाबलः।",
          "त्रिकूटस्य तटे लंकां स्थितः स्वस्थो ददर्श ह॥१॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-2",
    "chapterName": "सुन्दरकाण्ड, सर्ग 2",
    "verseNumber": 1
  },
  {
    "id": "valmiki-ramayana-5-sarga-2-shlok-2",
