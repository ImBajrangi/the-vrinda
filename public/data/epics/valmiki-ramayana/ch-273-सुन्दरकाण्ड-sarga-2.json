    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "स तु वीर्यवतां श्रेष्ठः प्लवतामपि चोत्तमः।",
          "जगाम वेगवाल्लंकां लङ्कयित्वा महोदधिम्॥५॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-2",
    "chapterName": "सुन्दरकाण्ड, सर्ग 2",
    "verseNumber": 5
  },
