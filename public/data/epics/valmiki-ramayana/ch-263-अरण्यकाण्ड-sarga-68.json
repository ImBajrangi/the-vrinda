    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "किंनिमित्तो जहारार्यां रावणस्तस्य किं मया।",
          "अपराधं तु यं दृष्ट्वा रावणेन हृता प्रिया॥५॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-68",
    "chapterName": "अरण्यकाण्ड, सर्ग 68",
    "verseNumber": 5
  },
