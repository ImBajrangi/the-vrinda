      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "जटायो यदि शक्नोषि वाक्यं व्याहरितुं पुनः।",
          "सीतामाख्याहि भद्रं ते वधमाख्याहि चात्मनः॥ ४॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-68",
    "chapterName": "अरण्यकाण्ड, सर्ग 68",
    "verseNumber": 4
  },
  {
