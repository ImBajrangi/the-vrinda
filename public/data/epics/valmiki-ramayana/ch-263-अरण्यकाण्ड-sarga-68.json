    "slug": "valmiki-ramayana-3-sarga-68-shlok-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "रामः प्रेक्ष्य तु तं गृधं भुवि रौद्रेण पातितम्।",
          "सौमित्रिं मित्रसम्पन्नमिदं वचनमब्रवीत्॥१॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-68",
    "chapterName": "अरण्यकाण्ड, सर्ग 68",
    "verseNumber": 1
  },
  {
