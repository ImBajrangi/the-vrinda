    "slug": "valmiki-ramayana-3-sarga-68-shlok-9",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "सा हृता राक्षसेन्द्रेण रावणेन दुरात्मना।",
          "मायामास्थाय विपुलां वातदुर्दिनसंकुलाम्॥९॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-68",
    "chapterName": "अरण्यकाण्ड, सर्ग 68",
    "verseNumber": 9
