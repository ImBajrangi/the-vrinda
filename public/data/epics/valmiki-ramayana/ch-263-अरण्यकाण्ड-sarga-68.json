    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "कथंवीर्यः कथंरूपः किंकर्मा स च राक्षसः।",
          "क्व चास्य भवनं तात ब्रूहि मे परिपृच्छतः॥७॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-68",
    "chapterName": "अरण्यकाण्ड, सर्ग 68",
    "verseNumber": 7
  },
  {
