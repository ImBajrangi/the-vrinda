        "linesDevanagari": [
          "तमुद्रीक्ष्य स धर्मात्मा विलपन्तमनाथवत्।",
          "वाचा विक्लवया राममिदं वचनमब्रवीत्॥८॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-68",
    "chapterName": "अरण्यकाण्ड, सर्ग 68",
    "verseNumber": 8
  },
  {
