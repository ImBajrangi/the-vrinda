        "linesDevanagari": [
          "अतिखिन्नः शरीरेऽस्मिन् प्राणो लक्ष्मण विद्यते।",
          "तथा स्वरविहीनोऽयं विक्लवं समुदीक्षते॥३॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-68",
    "chapterName": "अरण्यकाण्ड, सर्ग 68",
    "verseNumber": 3
