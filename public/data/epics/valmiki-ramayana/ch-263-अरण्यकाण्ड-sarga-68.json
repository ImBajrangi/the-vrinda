    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-68-shlok-14",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "न च त्वया व्यथा कार्या जनकस्य सुतां प्रति।",
          "वैदेह्या रंस्यसे क्षिप्रं हत्वा तं रणमूर्धनि॥१४॥",
          "असम्मूढस्य गृध्रस्य रामं प्रत्यनुभाषतः।",
          "आस्यात् सुस्राव रुधिरं म्रियमाणस्य सामिषम्॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-68",
    "chapterName": "अरण्यकाण्ड, सर्ग 68",
    "verseNumber": 14
