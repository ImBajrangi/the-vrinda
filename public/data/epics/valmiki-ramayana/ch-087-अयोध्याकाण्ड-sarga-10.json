    "slug": "valmiki-ramayana-2-sarga-10-shlok-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "विदर्शिता यदा देवी कुब्जया पापया भृशम्।",
          "तदा शेते स्म सा भूमौ दिग्धविद्धेव किंनरी॥१॥"
        ]
      }
    ],
    "chapterId": "अयोध्याकाण्ड-sarga-10",
    "chapterName": "अयोध्याकाण्ड, सर्ग 10",
    "verseNumber": 1
  },
  {
    "id": "valmiki-ramayana-2-sarga-10-shlok-2",
    "collectionId": "valmiki-ramayana",
    "index": 3316,
    "titleDevanagari": "वाल्मीकि रामायण, अयोध्याकाण्ड, सर्ग 10, श्लोक 2",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-2-sarga-10-shlok-2",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "निश्चित्य मनसा कृत्यं सा सम्यगिति भामिनी।",
          "मन्थरायै शनैः सर्वमाचचक्षे विचक्षणा॥२॥",
          "सा दीना निश्चयं कृत्वा मन्थरावाक्यमोहिता।",
          "नागकन्येव निःश्वस्य दीर्घमुष्णं च भामिनी॥ ३॥",
          "मुहूर्तं चिन्तयामास मार्गमात्मसुखावहम्।",
          "सा सुहृच्चार्थकामा च तं निशम्य विनिश्चयम्॥ ४॥",
          "बभूव परमप्रीता सिद्धिं प्राप्येव मन्थरा।"
        ]
      }
    ],
    "chapterId": "अयोध्याकाण्ड-sarga-10",
    "chapterName": "अयोध्याकाण्ड, सर्ग 10",
    "verseNumber": 2
  },
  {
