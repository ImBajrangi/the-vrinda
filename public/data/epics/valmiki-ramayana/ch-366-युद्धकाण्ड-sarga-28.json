    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-6-sarga-28-shlok-29",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "तेजसा यशसा बुद्ध्या बलेनाभिजनेन च।",
          "यः कपीनतिबभ्राज हिमवानिव पर्वतः॥२९॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-28",
