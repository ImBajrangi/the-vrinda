    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-6-sarga-28-shlok-27",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "यस्तु सव्यमसौ पक्षं रामस्याश्रित्य तिष्ठति।",
          "रक्षोगणपरिक्षिप्तो राजा ह्येष विभीषणः॥२६॥",
          "श्रीमता राजराजेन लङ्कायामभिषेचितः।",
          "त्वामसौ प्रतिसंरब्धो युद्धायैषोऽभिवर्तते॥२७॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-28",
    "chapterName": "युद्धकाण्ड, सर्ग 28",
    "verseNumber": 27
  },
  {
    "id": "valmiki-ramayana-6-sarga-28-shlok-28",
    "collectionId": "valmiki-ramayana",
