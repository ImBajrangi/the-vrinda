    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-6-sarga-28-shlok-14",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "अनाधृष्यतमं देवमपि देवर्षिराक्षसैः।",
          "अनासाद्यैव पतितो भास्करोदयने गिरौ॥१४॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-28",
    "chapterName": "युद्धकाण्ड, सर्ग 28",
    "verseNumber": 14
  },
  {
    "id": "valmiki-ramayana-6-sarga-28-shlok-15",
    "collectionId": "valmiki-ramayana",
