    "titleDevanagari": "वाल्मीकि रामायण, युद्धकाण्ड, सर्ग 28, श्लोक 1",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-6-sarga-28-shlok-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "सारणस्य वचः श्रुत्वा रावणं राक्षसाधिपम्।",
          "बलमादिश्य तत् सर्वं शुको वाक्यमथाब्रवीत्॥१॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-28",
    "chapterName": "युद्धकाण्ड, सर्ग 28",
    "verseNumber": 1
  },
  {
    "id": "valmiki-ramayana-6-sarga-28-shlok-3",
    "collectionId": "valmiki-ramayana",
    "index": 12112,
    "titleDevanagari": "वाल्मीकि रामायण, युद्धकाण्ड, सर्ग 28, श्लोक 3",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-6-sarga-28-shlok-3",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "स्थितान् पश्यसि यानेतान् मत्तानिव महाद्विपान्।",
          "न्यग्रोधानिव गाङ्गेयान् सालान् हैमवतानिव॥२॥",
          "एते दुष्प्रसहा राजन् बलिनः कामरूपिणः।",
          "दैत्यदानवसंकाशा युद्धे देवपराक्रमाः॥३॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-28",
    "chapterName": "युद्धकाण्ड, सर्ग 28",
    "verseNumber": 3
  },
  {
    "id": "valmiki-ramayana-6-sarga-28-shlok-5",
    "collectionId": "valmiki-ramayana",
    "index": 12113,
    "titleDevanagari": "वाल्मीकि रामायण, युद्धकाण्ड, सर्ग 28, श्लोक 5",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-6-sarga-28-shlok-5",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "एषां कोटिसहस्राणि नव पञ्च च सप्त च।",
          "तथा शङ्कसहस्राणि तथा वृन्दशतानि च॥४॥",
          "एते सुग्रीवसचिवाः किष्किन्धानिलयाः सदा।",
          "हरयो देवगन्धर्वैरुत्पन्नाः कामरूपिणः॥५॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-28",
    "chapterName": "युद्धकाण्ड, सर्ग 28",
    "verseNumber": 5
  },
  {
    "id": "valmiki-ramayana-6-sarga-28-shlok-7",
    "collectionId": "valmiki-ramayana",
    "index": 12114,
    "titleDevanagari": "वाल्मीकि रामायण, युद्धकाण्ड, सर्ग 28, श्लोक 7",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-6-sarga-28-shlok-7",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "यौ तौ पश्यसि तिष्ठन्तौ कुमारौ देवरूपिणौ।",
          "मैन्दश्च द्विविदश्चैव ताभ्यां नास्ति समो युधि॥",
          "ब्रह्मणा समनुज्ञातावमृतप्राशिनावुभौ।",
          "आशंसेते यथा लङ्कामेतौ मर्दितुमोजसा॥७॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-28",
    "chapterName": "युद्धकाण्ड, सर्ग 28",
    "verseNumber": 7
  },
  {
    "id": "valmiki-ramayana-6-sarga-28-shlok-11",
    "collectionId": "valmiki-ramayana",
    "index": 12115,
    "titleDevanagari": "वाल्मीकि रामायण, युद्धकाण्ड, सर्ग 28, श्लोक 11",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-6-sarga-28-shlok-11",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "कामरूपो हरिश्रेष्ठो बलरूपसमन्वितः।",
          "अनिवार्यगतिश्चैव यथा सततगः प्रभुः॥११॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-28",
    "chapterName": "युद्धकाण्ड, सर्ग 28",
    "verseNumber": 11
  },
  {
