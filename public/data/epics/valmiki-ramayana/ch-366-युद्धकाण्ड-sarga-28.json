    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-6-sarga-28-shlok-25",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "नह्येष राघवस्यार्थे जीवितं परिरक्षति।",
          "एषैवाशंसते युद्धे निहन्तुं सर्वराक्षसान्॥२५॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-28",
    "chapterName": "युद्धकाण्ड, सर्ग 28",
    "verseNumber": 25
  },
  {
    "id": "valmiki-ramayana-6-sarga-28-shlok-27",
