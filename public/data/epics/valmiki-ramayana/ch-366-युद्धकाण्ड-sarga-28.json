    "titleDevanagari": "वाल्मीकि रामायण, युद्धकाण्ड, सर्ग 28, श्लोक 15",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-6-sarga-28-shlok-15",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "पतितस्य कपेरस्य हनुरेका शिलातले।",
          "किंचिद् भिन्ना दृढहनुर्हनूमानेष तेन वै॥१५॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-28",
    "chapterName": "युद्धकाण्ड, सर्ग 28",
    "verseNumber": 15
  },
  {
    "id": "valmiki-ramayana-6-sarga-28-shlok-17",
    "collectionId": "valmiki-ramayana",
    "index": 12118,
    "titleDevanagari": "वाल्मीकि रामायण, युद्धकाण्ड, सर्ग 28, श्लोक 17",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-6-sarga-28-shlok-17",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "सत्यमागमयोगेन ममैष विदितो हरिः।",
          "नास्य शक्यं बलं रूपं प्रभावो वानुभाषितुम्॥१६॥",
          "एष आशंसते लङ्कामेको मथितुमोजसा।",
          "येन जाज्वल्यतेऽसौ वै धूमकेतुस्तवाद्य वै।",
          "लङ्कायां निहितश्चापि कथं विस्मरसे कपिम्॥१७॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-28",
    "chapterName": "युद्धकाण्ड, सर्ग 28",
    "verseNumber": 17
  },
  {
    "id": "valmiki-ramayana-6-sarga-28-shlok-18",
    "collectionId": "valmiki-ramayana",
    "index": 12119,
    "titleDevanagari": "वाल्मीकि रामायण, युद्धकाण्ड, सर्ग 28, श्लोक 18",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-6-sarga-28-shlok-18",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "यश्चैषोऽनन्तरः शूरः श्यामः पद्मनिभेक्षणः।",
          "इक्ष्वाकूणामतिरथो लोके विश्रुतपौरुषः॥१८॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-28",
    "chapterName": "युद्धकाण्ड, सर्ग 28",
    "verseNumber": 18
  },
  {
