    "slug": "valmiki-ramayana-6-sarga-28-shlok-28",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "॥ श्रीसीतारामचन्द्राभ्यां नमः॥",
          "श्रीमद्वाल्मीकीय रामायण",
          "युद्धकाण्डम्",
          "अष्टाविंशः सर्गः (28)",
          "यं तु पश्यसि तिष्ठन्तं मध्ये गिरिमिवाचलम्।",
          "सर्वशाखामृगेन्द्राणां भर्तारममितौजसम्॥२८॥",
          "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये युद्धकाण्डेऽष्टाविंशः सर्गः ॥२८॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-28",
    "chapterName": "युद्धकाण्ड, सर्ग 28",
    "verseNumber": 28
  },
  {
    "id": "valmiki-ramayana-6-sarga-28-shlok-29",
