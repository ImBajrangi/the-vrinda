    "slug": "valmiki-ramayana-6-sarga-28-shlok-24",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "अमर्षी दुर्जयो जेता विक्रान्तश्च जयी बली।",
          "रामस्य दक्षिणो बाहुर्नित्यं प्राणो बहिश्चरः॥२४॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-28",
    "chapterName": "युद्धकाण्ड, सर्ग 28",
    "verseNumber": 24
  },
  {
