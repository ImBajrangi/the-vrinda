    "index": 12122,
    "titleDevanagari": "वाल्मीकि रामायण, युद्धकाण्ड, सर्ग 28, श्लोक 21",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-6-sarga-28-shlok-21",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "यस्य भार्या जनस्थानात् सीता चापि हृता त्वया।",
          "स एष रामस्त्वां राजन् योद्धं समभिवर्तते॥२१॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-28",
    "chapterName": "युद्धकाण्ड, सर्ग 28",
    "verseNumber": 21
  },
  {
    "id": "valmiki-ramayana-6-sarga-28-shlok-23",
