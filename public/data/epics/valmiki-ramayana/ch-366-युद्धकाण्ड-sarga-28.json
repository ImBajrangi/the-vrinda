    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-6-sarga-28-shlok-20",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "यो भिन्द्याद् गगनं बाणैर्मेदिनीं वापि दारयेत्।",
          "यस्य मृत्योरिव क्रोधः शक्रस्येव पराक्रमः॥२०॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-28",
    "chapterName": "युद्धकाण्ड, सर्ग 28",
    "verseNumber": 20
  },
  {
    "id": "valmiki-ramayana-6-sarga-28-shlok-21",
