    "slug": "valmiki-ramayana-6-sarga-28-shlok-19",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "यस्मिन् न चलते धर्मो यो धर्मं नातिवर्तते।",
          "यो ब्राह्ममस्त्रं वेदांश्च वेद वेदविदां वरः॥१९॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-28",
    "chapterName": "युद्धकाण्ड, सर्ग 28",
    "verseNumber": 19
  },
  {
