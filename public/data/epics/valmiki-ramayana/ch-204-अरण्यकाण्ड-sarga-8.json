    "titleDevanagari": "वाल्मीकि रामायण, अरण्यकाण्ड, सर्ग 8, श्लोक 1",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-8-shlok-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "रामस्तु सहसौमित्रिः सुतीक्ष्णेनाभिपूजितः।",
          "परिणाम्य निशां तत्र प्रभाते प्रत्यबुध्यत॥१॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-8",
    "chapterName": "अरण्यकाण्ड, सर्ग 8",
    "verseNumber": 1
  },
  {
    "id": "valmiki-ramayana-3-sarga-8-shlok-4",
    "collectionId": "valmiki-ramayana",
    "index": 6976,
    "titleDevanagari": "वाल्मीकि रामायण, अरण्यकाण्ड, सर्ग 8, श्लोक 4",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-8-shlok-4",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "उत्थाय च यथाकालं राघवः सह सीतया।",
          "उपस्पश्य सशीतेन तोयेनोत्पलगन्धिना॥२॥",
          "अथ तेऽग्निं सुरांश्चैव वैदेही रामलक्ष्मणौ।",
          "काल्यं विधिवदभ्यर्च्य तपस्विशरणे वने॥३॥",
          "उदयन्तं दिनकरं दृष्ट्वा विगतकल्मषाः।",
          "सुतीक्ष्णमभिगम्येदं श्लक्ष्णं वचनमब्रुवन्॥४॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-8",
    "chapterName": "अरण्यकाण्ड, सर्ग 8",
    "verseNumber": 4
  },
  {
    "id": "valmiki-ramayana-3-sarga-8-shlok-5",
    "collectionId": "valmiki-ramayana",
    "index": 6977,
    "titleDevanagari": "वाल्मीकि रामायण, अरण्यकाण्ड, सर्ग 8, श्लोक 5",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-8-shlok-5",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "सुखोषिताः स्म भगवंस्त्वया पूज्येन पूजिताः।",
          "आपृच्छामः प्रयास्यामो मुनयस्त्वरयन्ति नः॥५॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-8",
    "chapterName": "अरण्यकाण्ड, सर्ग 8",
    "verseNumber": 5
  },
  {
