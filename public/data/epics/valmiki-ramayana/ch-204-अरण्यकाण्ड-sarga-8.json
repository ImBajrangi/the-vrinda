    "slug": "valmiki-ramayana-3-sarga-8-shlok-8",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "॥ श्रीसीतारामचन्द्राभ्यां नमः॥",
          "श्रीमद्वाल्मीकीय रामायण",
          "अरण्यकाण्डम्",
          "अष्टमः सर्गः (सर्ग 8)",
          "इत्याचे श्रीमद्रामायणे वाल्मीकीये आदिकाव्येऽरण्यकाण्डेऽष्टमः सर्गः॥८॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-8",
    "chapterName": "अरण्यकाण्ड, सर्ग 8",
    "verseNumber": 8
  },
  {
