    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "अभ्यनुज्ञातुमिच्छामः सहैभिर्मुनिपुंगवैः।",
          "धर्मनित्यैस्तपोदान्तैर्विशिखैरिव पावकैः॥७॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-8",
    "chapterName": "अरण्यकाण्ड, सर्ग 8",
    "verseNumber": 7
  },
  {
