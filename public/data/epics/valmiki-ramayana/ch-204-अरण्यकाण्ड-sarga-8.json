    "slug": "valmiki-ramayana-3-sarga-8-shlok-6",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "त्वरामहे वयं द्रष्टुं कृत्स्नमाश्रममण्डलम्।",
          "ऋषीणां पुण्यशीलानां दण्डकारण्यवासिनाम्॥ ६॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-8",
    "chapterName": "अरण्यकाण्ड, सर्ग 8",
    "verseNumber": 6
  },
