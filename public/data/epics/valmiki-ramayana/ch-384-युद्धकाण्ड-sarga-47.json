    "slug": "valmiki-ramayana-6-sarga-47-shlok-6",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "राक्षस्यस्त्रिजटा चापि शासनात् तमुपस्थिताः।",
          "ता उवाच ततो हृष्टो राक्षसी राक्षसाधिपः॥६॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-47",
    "chapterName": "युद्धकाण्ड, सर्ग 47",
    "verseNumber": 6
  },
