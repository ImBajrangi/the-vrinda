    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-6-sarga-47-shlok-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "तस्मिन् प्रविष्टे लङ्कायां कृतार्थे रावणात्मजे।",
          "राघवं परिवार्याथ ररक्षुर्वानरर्षभाः॥१॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-47",
    "chapterName": "युद्धकाण्ड, सर्ग 47",
    "verseNumber": 1
  },
  {
    "id": "valmiki-ramayana-6-sarga-47-shlok-3",
    "collectionId": "valmiki-ramayana",
    "index": 12741,
    "titleDevanagari": "वाल्मीकि रामायण, युद्धकाण्ड, सर्ग 47, श्लोक 3",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-6-sarga-47-shlok-3",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "हनुमानङ्गदो नीलः सुषेणः कुमुदो नलः।",
          "गजो गवाक्षो गवयः शरभो गन्धमादनः॥२॥",
          "जाम्बवानृषभः स्कन्धो रम्भः शतबलिः पृथुः।",
          "व्यूढानीकाश्च यत्ताश्च द्रुमानादाय सर्वतः॥३॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-47",
    "chapterName": "युद्धकाण्ड, सर्ग 47",
    "verseNumber": 3
  },
  {
