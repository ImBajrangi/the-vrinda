    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-6-sarga-47-shlok-5",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "रावणश्चापि संहृष्टो विसृज्येन्द्रजितं सुतम्।",
          "आजुहाव ततः सीतारक्षणी राक्षसीस्तदा॥५॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-47",
    "chapterName": "युद्धकाण्ड, सर्ग 47",
    "verseNumber": 5
  },
  {
