    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "अचिरेण तु कालेन परिवाहान् बहूदकान्।",
          "चक्रुर्बहुविधाकारान् सागरप्रतिमान् बहून्॥११॥"
        ]
      }
    ],
    "chapterId": "अयोध्याकाण्ड-sarga-80",
    "chapterName": "अयोध्याकाण्ड, सर्ग 80",
