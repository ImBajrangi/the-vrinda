[
  {
    "id": "valmiki-ramayana-2-sarga-80-shlok-3",
    "collectionId": "valmiki-ramayana",
    "index": 5673,
    "titleDevanagari": "वाल्मीकि रामायण, अयोध्याकाण्ड, सर्ग 80, श्लोक 3",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-2-sarga-80-shlok-3",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "अथ भूमिप्रदेशज्ञाः सूत्रकर्मविशारदाः।",
          "स्वकर्माभिरताः शूराः खनका यन्त्रकास्तथा॥ १॥",
          "कान्तिकाः स्थपतयः पुरुषा यन्त्रकोविदाः।",
          "तथा वर्धकयश्चैव मार्गिणो वृक्षतक्षकाः॥२॥",
          "सूपकाराः सुधाकारा वंशचर्मकृतस्तथा।",
          "समर्था ये च द्रष्टारः पुरतश्च प्रतस्थिरे॥३॥"
        ]
      }
    ],
    "chapterId": "अयोध्याकाण्ड-sarga-80",
    "chapterName": "अयोध्याकाण्ड, सर्ग 80",
    "verseNumber": 3
  },
  {
    "id": "valmiki-ramayana-2-sarga-80-shlok-4",
