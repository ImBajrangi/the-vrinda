    "titleDevanagari": "वाल्मीकि रामायण, अयोध्याकाण्ड, सर्ग 80, श्लोक 4",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-2-sarga-80-shlok-4",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "स तु हर्षात् तमुद्देशं जनौघो विपुलः प्रयान्।",
          "अशोभत महावेगः सागरस्येव पर्वणि॥४॥"
        ]
      }
    ],
    "chapterId": "अयोध्याकाण्ड-sarga-80",
    "chapterName": "अयोध्याकाण्ड, सर्ग 80",
    "verseNumber": 4
  },
  {
    "id": "valmiki-ramayana-2-sarga-80-shlok-5",
