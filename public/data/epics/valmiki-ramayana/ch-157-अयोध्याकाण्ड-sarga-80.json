    "slug": "valmiki-ramayana-2-sarga-80-shlok-17",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "नक्षत्रेषु प्रशस्तेषु मुहूर्तेषु च तद्विदः।",
          "निवेशान् स्थापयामासुर्भरतस्य महात्मनः॥१७॥"
        ]
      }
    ],
    "chapterId": "अयोध्याकाण्ड-sarga-80",
