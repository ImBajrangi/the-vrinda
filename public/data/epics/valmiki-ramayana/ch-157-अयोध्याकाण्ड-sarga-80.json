    "slug": "valmiki-ramayana-2-sarga-80-shlok-7",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "अवृक्षेषु च देशेषु केचिद् वृक्षानरोपयन्।",
          "केचित् कुठारैष्टकैश्च दात्रैश्छिन्दन् क्वचित् क्वचित्॥७॥"
        ]
      }
    ],
    "chapterId": "अयोध्याकाण्ड-sarga-80",
    "chapterName": "अयोध्याकाण्ड, सर्ग 80",
    "verseNumber": 7
  },
  {
