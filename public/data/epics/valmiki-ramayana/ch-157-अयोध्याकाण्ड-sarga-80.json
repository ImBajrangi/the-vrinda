    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-2-sarga-80-shlok-14",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "ससुधाकुट्टिमतलः प्रपुष्पितमहीरुहः।",
          "मत्तो ष्टद्विजगणः पताकाभिरलंकृतः॥१३॥",
          "चन्दनोदकसंसिक्तो नानाकुसुमभूषितः।",
          "बह्वशोभत सेनायाः पन्थाः सुरपथोपमः॥१४॥"
        ]
      }
    ],
    "chapterId": "अयोध्याकाण्ड-sarga-80",
    "chapterName": "अयोध्याकाण्ड, सर्ग 80",
    "verseNumber": 14
