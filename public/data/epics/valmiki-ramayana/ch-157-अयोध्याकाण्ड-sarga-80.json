    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-2-sarga-80-shlok-12",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "निर्जलेषु च देशेषु खानयामासुरुत्तमान्।",
          "उदपानान् बहुविधान् वेदिकापरिमण्डितान्॥ १२॥"
        ]
      }
    ],
    "chapterId": "अयोध्याकाण्ड-sarga-80",
