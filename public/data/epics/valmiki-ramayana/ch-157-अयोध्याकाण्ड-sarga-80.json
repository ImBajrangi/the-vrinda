    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-2-sarga-80-shlok-16",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "आज्ञाप्याथ यथाज्ञप्ति युक्तास्तेऽधिकृता नराः।",
          "रमणीयेषु देशेषु बहुस्वादुफलेषु च॥१५॥",
          "यो निवेशस्त्वभिप्रेतो भरतस्य महात्मनः।",
          "भूयस्तं शोभयामासुभूषाभिभूषणोपमम्॥१६॥"
        ]
      }
    ],
    "chapterId": "अयोध्याकाण्ड-sarga-80",
    "chapterName": "अयोध्याकाण्ड, सर्ग 80",
    "verseNumber": 16
  },
