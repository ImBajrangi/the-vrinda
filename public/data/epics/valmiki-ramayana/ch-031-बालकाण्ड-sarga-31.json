    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "नहि वै त्वद्विधो लोके पापमेवं समाचरेत्।",
          "कोपमार्येण यो हन्ति स वीरः पुरुषोत्तमः॥६॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-31",
    "chapterName": "बालकाण्ड, सर्ग 31",
    "verseNumber": 6
  },
