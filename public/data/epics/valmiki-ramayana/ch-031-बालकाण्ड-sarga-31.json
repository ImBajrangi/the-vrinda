    "slug": "valmiki-ramayana-1-sarga-31-shlok-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "स कामिनं दीनमदीनसत्त्वं शोकाभिपन्नं समुदीर्णकोपम्।",
          "नरेन्द्रसूनुर्नरदेवपुत्रं रामानुजः पूर्वजमित्युवाच॥१॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-31",
    "chapterName": "बालकाण्ड, सर्ग 31",
    "verseNumber": 1
  },
  {
    "id": "valmiki-ramayana-1-sarga-31-shlok-2",
    "collectionId": "valmiki-ramayana",
    "index": 1560,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 31, श्लोक 2",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-31-shlok-2",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "न वानरः स्थास्यति साधुवृत्ते न मन्यते कर्मफलानुषङ्गान्।",
          "न भोक्ष्यते वानरराज्यलक्ष्मी तथा हि नातिक्रमतेऽस्य बुद्धिः॥२॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-31",
    "chapterName": "बालकाण्ड, सर्ग 31",
    "verseNumber": 2
  },
  {
