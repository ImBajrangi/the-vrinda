    "slug": "valmiki-ramayana-1-sarga-31-shlok-4-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "न धारये कोपमुदीर्णवेगं निहन्मि सुग्रीवमसत्यमद्य।",
          "हरिप्रवीरैः सह वालिपुत्रो नरेन्द्रपुत्र्या विचयं करोतु॥४॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-31",
    "chapterName": "बालकाण्ड, सर्ग 31",
    "verseNumber": 4
  },
  {
