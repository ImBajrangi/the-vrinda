    "slug": "valmiki-ramayana-1-sarga-31-shlok-5-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "तमात्तबाणासनमुत्पतन्तं निवेदितार्थं रणचण्डकोपम्।",
          "उवाच रामः परवीरहन्ता स्ववीक्षितं सानुनयं च वाक्यम्॥५॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-31",
    "chapterName": "बालकाण्ड, सर्ग 31",
    "verseNumber": 5
  },
  {
