    "collectionId": "valmiki-ramayana",
    "index": 1561,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 31, श्लोक 3",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-31-shlok-3",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "मतिक्षयाद् ग्राम्यसुखेषु सक्तस्तव प्रसादात् प्रतिकारबुद्धिः।",
          "हतोऽग्रजं पश्यतु वीरवालिनं न राज्यमेवं विगुणस्य देयम्॥३॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-31",
    "chapterName": "बालकाण्ड, सर्ग 31",
    "verseNumber": 3
  },
  {
