    "slug": "valmiki-ramayana-3-sarga-15-shlok-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "ततः पञ्चवटीं गत्वा नानाव्यालमृगायुताम्।",
          "उवाच लक्ष्मणं रामो भ्रातरं दीप्ततेजसम्॥१॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-15",
    "chapterName": "अरण्यकाण्ड, सर्ग 15",
    "verseNumber": 1
  },
  {
