    "slug": "valmiki-ramayana-3-sarga-15-shlok-3",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "सर्वतश्चार्यतां दृष्टिः कानने निपुणो ह्यसि।",
          "आश्रमः कतरस्मिन् नो देशे भवति सम्मतः॥३॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-15",
    "chapterName": "अरण्यकाण्ड, सर्ग 15",
    "verseNumber": 3
  },
  {
