    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-15-shlok-9",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "सुप्रीतस्तेन वाक्येन लक्ष्मणस्य महाद्युतिः।",
          "विमृशन् रोचयामास देशं सर्वगुणान्वितम्॥८॥",
          "स तं रुचिरमाक्रम्य देशमाश्रमकर्मणि।।",
          "हस्ते गृहीत्वा हस्तेन रामः सौमित्रिमब्रवीत्॥९॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-15",
    "chapterName": "अरण्यकाण्ड, सर्ग 15",
    "verseNumber": 9
  },
  {
