    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-15-shlok-7",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "परवानस्मि काकुत्स्थ त्वयि वर्षशतं स्थिते।",
          "स्वयं तु रुचिरे देशे क्रियतामिति मां वद॥७॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-15",
    "chapterName": "अरण्यकाण्ड, सर्ग 15",
    "verseNumber": 7
  },
  {
