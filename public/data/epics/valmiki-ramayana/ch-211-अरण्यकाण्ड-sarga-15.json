    "slug": "valmiki-ramayana-3-sarga-15-shlok-6",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "एवमुक्तस्तु रामेण लक्ष्मणः संयताञ्जलिः।",
          "सीतासमक्षं काकुत्स्थमिदं वचनमब्रवीत्॥६॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-15",
    "chapterName": "अरण्यकाण्ड, सर्ग 15",
    "verseNumber": 6
  },
  {
