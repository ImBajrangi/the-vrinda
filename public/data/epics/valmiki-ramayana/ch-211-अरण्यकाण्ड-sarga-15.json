    "slug": "valmiki-ramayana-3-sarga-15-shlok-14",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "मयूरनादिता रम्याः प्रांशवो बहुकन्दराः।",
          "दृश्यन्ते गिरयः सौम्य फुल्लैस्तरुभिरावृताः॥ १४॥",
          "सौवर्णै राजतैस्तानैर्देशे देशे तथा शुभैः।",
          "गवाक्षिता इवाभान्ति गजाः परमभक्तिभिः॥"
        ]
      }
    ],
