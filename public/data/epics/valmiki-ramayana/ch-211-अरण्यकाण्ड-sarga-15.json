    "slug": "valmiki-ramayana-3-sarga-15-shlok-2",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "आगताः स्म यथोद्दिष्टं यं देशं मुनिरब्रवीत्।",
          "अयं पञ्चवटीदेशः सौम्य पुष्पितकाननः॥२॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-15",
    "chapterName": "अरण्यकाण्ड, सर्ग 15",
    "verseNumber": 2
  },
  {
