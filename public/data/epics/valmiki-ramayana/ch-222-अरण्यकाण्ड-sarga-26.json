    "slug": "valmiki-ramayana-3-sarga-26-shlok-6",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "ततः सेनापतिः क्रुद्धो दूषणः शत्रुदूषणः॥६॥",
          "शरैरशनिकल्पैस्तं राघवं समवारयत्।"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-26",
    "chapterName": "अरण्यकाण्ड, सर्ग 26",
    "verseNumber": 6
  },
