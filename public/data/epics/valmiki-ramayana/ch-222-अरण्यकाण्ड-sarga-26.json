    "titleDevanagari": "वाल्मीकि रामायण, अरण्यकाण्ड, सर्ग 26, श्लोक 1",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-26-shlok-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "दूषणस्तु स्वकं सैन्यं हन्यमानं विलोक्य च।",
          "संदिदेश महाबाहुर्भीमवेगान् दुरासदान्॥१॥",
          "राक्षसान् पञ्चसाहस्रान् समरेष्वनिवर्तिनः।"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-26",
    "chapterName": "अरण्यकाण्ड, सर्ग 26",
    "verseNumber": 1
  },
  {
    "id": "valmiki-ramayana-3-sarga-26-shlok-2",
    "collectionId": "valmiki-ramayana",
    "index": 7457,
    "titleDevanagari": "वाल्मीकि रामायण, अरण्यकाण्ड, सर्ग 26, श्लोक 2",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-26-shlok-2",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "ते शूलैः पट्टिशैः खड्गैः शिलावधैं मैरपि॥२॥",
          "शरवर्षैरविच्छिन्नं ववर्षुस्तं समन्ततः।"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-26",
    "chapterName": "अरण्यकाण्ड, सर्ग 26",
    "verseNumber": 2
  },
  {
