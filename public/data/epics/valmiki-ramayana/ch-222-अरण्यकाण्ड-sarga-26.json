    "slug": "valmiki-ramayana-3-sarga-26-shlok-5",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "ततः क्रोधसमाविष्टः प्रदीप्त इव तेजसा॥५॥",
          "शरैरभ्यकिरत् सैन्यं सर्वतः सहदूषणम्।।"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-26",
    "chapterName": "अरण्यकाण्ड, सर्ग 26",
    "verseNumber": 5
  },
  {
