    "slug": "valmiki-ramayana-3-sarga-26-shlok-3",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "तद् द्रुमाणां शिलानां च वर्षं प्राणहरं महत्॥३॥",
          "प्रतिजग्राह धर्मात्मा राघवस्तीक्ष्णसायकैः।"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-26",
    "chapterName": "अरण्यकाण्ड, सर्ग 26",
    "verseNumber": 3
  },
  {
