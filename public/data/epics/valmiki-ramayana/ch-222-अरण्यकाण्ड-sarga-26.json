    "slug": "valmiki-ramayana-3-sarga-26-shlok-4",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "प्रतिगृह्य च तद् वर्षं निमीलित इवर्षभः॥४॥",
          "रामः क्रोधं परं लेभे वधार्थं सर्वरक्षसाम्।"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-26",
    "chapterName": "अरण्यकाण्ड, सर्ग 26",
    "verseNumber": 4
  },
  {
