    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-6-sarga-26-shlok-19",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "एतस्य सा मतिः सर्वा यद् दृष्टा जनकात्मजा।",
          "हनूमता वेगवता राघवस्य हितैषिणा॥१९॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-26",
    "chapterName": "युद्धकाण्ड, सर्ग 26",
