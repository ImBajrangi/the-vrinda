    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-6-sarga-26-shlok-3",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "त्वं तु सौम्य परित्रस्तो हरिभिः पीडितो भृशम्।",
          "प्रतिप्रदानमद्यैव सीतायाः साधु मन्यसे॥३॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-26",
    "chapterName": "युद्धकाण्ड, सर्ग 26",
    "verseNumber": 3
  },
  {
