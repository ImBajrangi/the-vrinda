    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-6-sarga-26-shlok-10",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "सारणो राक्षसेन्द्रस्य वचनं परिपृच्छतः॥१०॥",
          "आबभाषेऽथ मुख्यज्ञो मुख्यास्तत्र वनौकसः।"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-26",
    "chapterName": "युद्धकाण्ड, सर्ग 26",
    "verseNumber": 10
  },
  {
    "id": "valmiki-ramayana-6-sarga-26-shlok-11",
    "collectionId": "valmiki-ramayana",
    "index": 12071,
    "titleDevanagari": "वाल्मीकि रामायण, युद्धकाण्ड, सर्ग 26, श्लोक 11",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-6-sarga-26-shlok-11",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "एष योऽभिमुखो लङ्कां नर्दस्तिष्ठति वानरः॥११॥",
          "यूथपानां सहस्राणां शतेन परिवारितः।",
          "यस्य घोषेण महता सप्राकारा सतोरणा॥१२॥",
          "लङ्का प्रतिहता सर्वा सशैलवनकानना।",
          "सर्वशाखामृगेन्द्रस्य सुग्रीवस्य महात्मनः॥१३॥",
          "बलाग्रे तिष्ठते वीरो नीलो नामैष यूथपः।"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-26",
    "chapterName": "युद्धकाण्ड, सर्ग 26",
    "verseNumber": 11
  },
  {
    "id": "valmiki-ramayana-6-sarga-26-shlok-17",
    "collectionId": "valmiki-ramayana",
    "index": 12072,
    "titleDevanagari": "वाल्मीकि रामायण, युद्धकाण्ड, सर्ग 26, श्लोक 17",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-6-sarga-26-shlok-17",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "बाहू प्रगृह्य यः पद्भ्यां महीं गच्छति वीर्यवान्॥१४॥",
          "लङ्कामभिमुखः कोपादभीक्ष्णं च विजृम्भते।",
          "गिरिशृङ्गप्रतीकाशः पद्मकिंजल्कसंनिभः॥१५॥",
          "स्फोटयत्यतिसंरब्धो लाङ्गलं च पुनः पुनः।",
          "यस्य लाङ्गलशब्देन स्वनन्ति प्रदिशो दश॥१६॥",
          "एष वानरराजेन सुग्रीवेणाभिषेचितः।",
          "युवराजोऽङ्गदो नाम त्वामाह्वयति संयुगे॥१७॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-26",
    "chapterName": "युद्धकाण्ड, सर्ग 26",
    "verseNumber": 17
  },
  {
