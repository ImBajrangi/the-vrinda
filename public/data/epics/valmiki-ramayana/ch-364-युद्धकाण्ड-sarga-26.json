    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "बहूनि वानरेन्द्राणामेष यूथानि वीर्यवान्।",
          "परिगृह्याभियाति त्वां स्वेनानीकेन मर्दितुम्॥२०॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-26",
    "chapterName": "युद्धकाण्ड, सर्ग 26",
    "verseNumber": 20
  },
  {
