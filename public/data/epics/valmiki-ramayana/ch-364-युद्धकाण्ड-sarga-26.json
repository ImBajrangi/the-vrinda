    "slug": "valmiki-ramayana-6-sarga-26-shlok-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "तद्वचः सत्यमक्लीबं सारणेनाभिभाषितम्।",
          "निशम्य रावणो राजा प्रत्यभाषत सारणम्॥१॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-26",
    "chapterName": "युद्धकाण्ड, सर्ग 26",
    "verseNumber": 1
  },
  {
