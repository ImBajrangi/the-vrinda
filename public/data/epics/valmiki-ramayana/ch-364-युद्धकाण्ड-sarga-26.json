    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-6-sarga-26-shlok-5",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "इत्युक्त्वा परुषं वाक्यं रावणो राक्षसाधिपः॥४॥",
          "आरुरोह ततः श्रीमान् प्रासादं हिमपाण्डुरम्।",
          "बहुतालसमुत्सेधं रावणोऽथ दिदृक्षया॥५॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-26",
    "chapterName": "युद्धकाण्ड, सर्ग 26",
    "verseNumber": 5
  },
  {
    "id": "valmiki-ramayana-6-sarga-26-shlok-6",
    "collectionId": "valmiki-ramayana",
    "index": 12067,
    "titleDevanagari": "वाल्मीकि रामायण, युद्धकाण्ड, सर्ग 26, श्लोक 6",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-6-sarga-26-shlok-6",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "ताभ्यां चराभ्यां सहितो रावणः क्रोधमूर्च्छितः।",
          "पश्यमानः समुद्रं तं पर्वतांश्च वनानि च॥६॥",
          "ददर्श पृथिवीदेशं सुसम्पूर्णं प्लवंगमैः।"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-26",
    "chapterName": "युद्धकाण्ड, सर्ग 26",
    "verseNumber": 6
  },
  {
