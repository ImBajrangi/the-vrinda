        "linesDevanagari": [
          "सारणाचक्ष्व मे सर्वं किंप्रभावाः प्लवंगमाः।"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-26",
    "chapterName": "युद्धकाण्ड, सर्ग 26",
    "verseNumber": 9
  },
  {
