    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-6-sarga-26-shlok-21",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "अनुवालिसुतस्यापि बलेन महता वृतः।",
          "वीरस्तिष्ठति संग्रामे सेतुहेतुरयं नलः॥२१॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-26",
