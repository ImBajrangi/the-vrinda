    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-6-sarga-26-shlok-2",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "यदि मामभियुञ्जीरन् देवगन्धर्वदानवाः।",
          "नैव सीतामहं दद्यां सर्वलोकभयादपि॥२॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-26",
    "chapterName": "युद्धकाण्ड, सर्ग 26",
    "verseNumber": 2
  },
