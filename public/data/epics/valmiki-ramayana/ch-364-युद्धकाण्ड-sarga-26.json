    "slug": "valmiki-ramayana-6-sarga-26-shlok-7",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "तदपारमसह्यं च वानराणां महाबलम्॥७॥",
          "आलोक्य रावणो राजा परिपप्रच्छ सारणम्।"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-26",
    "chapterName": "युद्धकाण्ड, सर्ग 26",
    "verseNumber": 7
  },
