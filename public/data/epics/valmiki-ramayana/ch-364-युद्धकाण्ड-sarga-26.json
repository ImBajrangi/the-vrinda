      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "वालिनः सदृशः पुत्रः सुग्रीवस्य सदा प्रियः।",
          "राघवार्थे पराक्रान्तः शक्रार्थे वरुणो यथा॥१८॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-26",
    "chapterName": "युद्धकाण्ड, सर्ग 26",
    "verseNumber": 18
  },
