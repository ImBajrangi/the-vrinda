    "titleDevanagari": "वाल्मीकि रामायण, युद्धकाण्ड, सर्ग 62, श्लोक 1",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-6-sarga-62-shlok-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "स तु राक्षसशार्दूलो निद्रामदसमाकुलः।",
          "राजमार्गं श्रिया जुष्टं ययौ विपुलविक्रमः॥१॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-62",
    "chapterName": "युद्धकाण्ड, सर्ग 62",
    "verseNumber": 1
  },
  {
    "id": "valmiki-ramayana-6-sarga-62-shlok-2",
    "collectionId": "valmiki-ramayana",
    "index": 13443,
    "titleDevanagari": "वाल्मीकि रामायण, युद्धकाण्ड, सर्ग 62, श्लोक 2",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-6-sarga-62-shlok-2",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "राक्षसानां सहस्रैश्च वृतः परमदुर्जयः।",
          "गृहेभ्यः पुष्पवर्षेण कीर्यमाणस्तदा ययौ॥२॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-62",
    "chapterName": "युद्धकाण्ड, सर्ग 62",
    "verseNumber": 2
  },
  {
    "id": "valmiki-ramayana-6-sarga-62-shlok-3",
    "collectionId": "valmiki-ramayana",
    "index": 13444,
    "titleDevanagari": "वाल्मीकि रामायण, युद्धकाण्ड, सर्ग 62, श्लोक 3",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-6-sarga-62-shlok-3",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "स हेमजालविततं भानुभास्वरदर्शनम्।",
          "ददर्श विपुलं रम्यं राक्षसेन्द्रनिवेशनम्॥३॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-62",
    "chapterName": "युद्धकाण्ड, सर्ग 62",
    "verseNumber": 3
  },
  {
    "id": "valmiki-ramayana-6-sarga-62-shlok-4",
    "collectionId": "valmiki-ramayana",
    "index": 13445,
    "titleDevanagari": "वाल्मीकि रामायण, युद्धकाण्ड, सर्ग 62, श्लोक 4",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-6-sarga-62-shlok-4",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "स तत्तदा सूर्य इवाभ्रजालं प्रविश्य रक्षोधिपतेर्निवेशनम्।",
          "ददर्श दूरेऽग्रजमासनस्थं स्वयंभुवं शक्र इवासनस्थम्॥४॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-62",
    "chapterName": "युद्धकाण्ड, सर्ग 62",
    "verseNumber": 4
  },
  {
    "id": "valmiki-ramayana-6-sarga-62-shlok-5",
    "collectionId": "valmiki-ramayana",
    "index": 13446,
    "titleDevanagari": "वाल्मीकि रामायण, युद्धकाण्ड, सर्ग 62, श्लोक 5",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-6-sarga-62-shlok-5",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "भ्रातुः स भवनं गच्छन् रक्षोगणसमन्वितः।",
          "कुम्भकर्णः पदन्यासैरकम्पयत मेदिनीम्॥५॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-62",
    "chapterName": "युद्धकाण्ड, सर्ग 62",
    "verseNumber": 5
  },
  {
    "id": "valmiki-ramayana-6-sarga-62-shlok-6",
    "collectionId": "valmiki-ramayana",
    "index": 13447,
    "titleDevanagari": "वाल्मीकि रामायण, युद्धकाण्ड, सर्ग 62, श्लोक 6",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-6-sarga-62-shlok-6",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "सोऽभिगम्य गृहं भ्रातुः कक्ष्यामभिविगाह्य च।",
          "ददर्शोद्विग्नमासीनं विमाने पुष्पके गुरुम्॥६॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-62",
    "chapterName": "युद्धकाण्ड, सर्ग 62",
    "verseNumber": 6
  },
  {
    "id": "valmiki-ramayana-6-sarga-62-shlok-7",
    "collectionId": "valmiki-ramayana",
    "index": 13448,
    "titleDevanagari": "वाल्मीकि रामायण, युद्धकाण्ड, सर्ग 62, श्लोक 7",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-6-sarga-62-shlok-7",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "अथ दृष्ट्वा दशग्रीवः कुम्भकर्णमुपस्थितम्।",
          "तूर्णमुत्थाय संहृष्टः संनिकर्षमुपानयत्॥७॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-62",
    "chapterName": "युद्धकाण्ड, सर्ग 62",
    "verseNumber": 7
  },
  {
    "id": "valmiki-ramayana-6-sarga-62-shlok-8",
    "collectionId": "valmiki-ramayana",
    "index": 13449,
    "titleDevanagari": "वाल्मीकि रामायण, युद्धकाण्ड, सर्ग 62, श्लोक 8",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-6-sarga-62-shlok-8",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "अथासीनस्य पर्यङ्के कुम्भकर्णो महाबलः।",
          "भ्रातुर्ववन्दे चरणौ किं कृत्यमिति चाब्रवीत्॥८॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-62",
    "chapterName": "युद्धकाण्ड, सर्ग 62",
    "verseNumber": 8
  },
  {
    "id": "valmiki-ramayana-6-sarga-62-shlok-9",
    "collectionId": "valmiki-ramayana",
    "index": 13450,
    "titleDevanagari": "वाल्मीकि रामायण, युद्धकाण्ड, सर्ग 62, श्लोक 9",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-6-sarga-62-shlok-9",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "उत्पत्य चैनं मुदितो रावणः परिषस्वजे।",
          "स भ्रात्रा सम्परिष्वक्तो यथावच्चाभिनन्दितः॥९॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-62",
    "chapterName": "युद्धकाण्ड, सर्ग 62",
    "verseNumber": 9
  },
  {
