    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "पराक्रमोत्साहमनस्विनां च सुरासुराणामपि दुर्जयेन।",
          "त्वयाप्रमेयेण सुरेन्द्रसङ्घा जिताश्च युद्धेष्वसकृन्नरेन्द्राः॥१८॥"
        ]
      }
    ],
