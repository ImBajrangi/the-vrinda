[
  {
    "id": "valmiki-ramayana-5-sarga-52-shlok-1",
    "collectionId": "valmiki-ramayana",
    "index": 10641,
    "titleDevanagari": "वाल्मीकि रामायण, सुन्दरकाण्ड, सर्ग 52, श्लोक 1",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-5-sarga-52-shlok-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "स तस्य वचनं श्रुत्वा वानरस्य महात्मनः।",
          "आज्ञापयद् वधं तस्य रावणः क्रोधमूर्च्छितः॥१॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-52",
    "chapterName": "सुन्दरकाण्ड, सर्ग 52",
    "verseNumber": 1
  },
  {
    "id": "valmiki-ramayana-5-sarga-52-shlok-2",
    "collectionId": "valmiki-ramayana",
    "index": 10642,
    "titleDevanagari": "वाल्मीकि रामायण, सुन्दरकाण्ड, सर्ग 52, श्लोक 2",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-5-sarga-52-shlok-2",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "वधे तस्य समाज्ञप्ते रावणेन दुरात्मना।",
          "निवेदितवतो दौत्यं नानुमेने विभीषणः॥२॥",
          "तं रक्षोऽधिपतिं क्रुद्धं तच्च कार्यमुपस्थितम्।",
          "विदित्वा चिन्तयामास कार्यं कार्यविधौ स्थितः॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-52",
    "chapterName": "सुन्दरकाण्ड, सर्ग 52",
    "verseNumber": 2
  },
  {
    "id": "valmiki-ramayana-5-sarga-52-shlok-4",
    "collectionId": "valmiki-ramayana",
    "index": 10643,
    "titleDevanagari": "वाल्मीकि रामायण, सुन्दरकाण्ड, सर्ग 52, श्लोक 4",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-5-sarga-52-shlok-4",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "निश्चितार्थस्ततः साम्ना पूज्यं शत्रुजिदग्रजम्।",
          "उवाच हितमत्यर्थं वाक्यं वाक्यविशारदः॥४॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-52",
    "chapterName": "सुन्दरकाण्ड, सर्ग 52",
    "verseNumber": 4
  },
  {
    "id": "valmiki-ramayana-5-sarga-52-shlok-5",
    "collectionId": "valmiki-ramayana",
    "index": 10644,
    "titleDevanagari": "वाल्मीकि रामायण, सुन्दरकाण्ड, सर्ग 52, श्लोक 5",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-5-sarga-52-shlok-5",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "क्षमस्व रोषं त्यज राक्षसेन्द्र प्रसीद मे वाक्यमिदं शृणुष्व।",
          "वधं न कुर्वन्ति परावरज्ञा दूतस्य सन्तो वसुधाधिपेन्द्राः॥५॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-52",
    "chapterName": "सुन्दरकाण्ड, सर्ग 52",
    "verseNumber": 5
  },
  {
    "id": "valmiki-ramayana-5-sarga-52-shlok-6",
    "collectionId": "valmiki-ramayana",
    "index": 10645,
    "titleDevanagari": "वाल्मीकि रामायण, सुन्दरकाण्ड, सर्ग 52, श्लोक 6",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-5-sarga-52-shlok-6",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "राजन् धर्मविरुद्धं च लोकवृत्तेश्च गर्हितम्।",
          "तव चासदृशं वीर कपेरस्य प्रमापणम्॥६॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-52",
    "chapterName": "सुन्दरकाण्ड, सर्ग 52",
    "verseNumber": 6
  },
  {
    "id": "valmiki-ramayana-5-sarga-52-shlok-8",
    "collectionId": "valmiki-ramayana",
    "index": 10646,
    "titleDevanagari": "वाल्मीकि रामायण, सुन्दरकाण्ड, सर्ग 52, श्लोक 8",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-5-sarga-52-shlok-8",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "धर्मज्ञश्च कृतज्ञश्च राजधर्मविशारदः।",
          "परावरज्ञो भूतानां त्वमेव परमार्थवित्॥७॥",
          "गृह्यन्ते यदि रोषेण त्वादृशोऽपि विचक्षणाः।",
          "ततः शास्त्रविपश्चित्त्वं श्रम एव हि केवलम्॥८॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-52",
    "chapterName": "सुन्दरकाण्ड, सर्ग 52",
    "verseNumber": 8
  },
  {
    "id": "valmiki-ramayana-5-sarga-52-shlok-9",
    "collectionId": "valmiki-ramayana",
    "index": 10647,
    "titleDevanagari": "वाल्मीकि रामायण, सुन्दरकाण्ड, सर्ग 52, श्लोक 9",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-5-sarga-52-shlok-9",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "तस्मात् प्रसीद शत्रुघ्न राक्षसेन्द्र दुरासद।",
          "युक्तायुक्तं विनिश्चित्य दूतदण्डो विधीयताम्॥९॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-52",
    "chapterName": "सुन्दरकाण्ड, सर्ग 52",
    "verseNumber": 9
  },
  {
