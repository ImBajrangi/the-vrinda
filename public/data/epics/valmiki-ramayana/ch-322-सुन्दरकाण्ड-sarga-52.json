    "slug": "valmiki-ramayana-5-sarga-52-shlok-13",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "प्रसीद लङ्केश्वर राक्षसेन्द्र धर्मार्थतत्त्वं वचनं शृणुष्व।",
          "दूता न वध्याः समयेषु राजन् सर्वेषु सर्वत्र वदन्ति सन्तः॥१३॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-52",
    "chapterName": "सुन्दरकाण्ड, सर्ग 52",
