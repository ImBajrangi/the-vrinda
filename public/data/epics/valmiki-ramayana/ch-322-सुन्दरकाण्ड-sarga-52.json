    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "कथं च धर्मार्थविनीतबुद्धिः परावरप्रत्ययनिश्चितार्थः।",
          "भवद्विधः कोपवशे हि तिष्ठेत् कोपं न गच्छन्ति हि सत्त्ववन्तः॥१६॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-52",
    "chapterName": "सुन्दरकाण्ड, सर्ग 52",
    "verseNumber": 16
