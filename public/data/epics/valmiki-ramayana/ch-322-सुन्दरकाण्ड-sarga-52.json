    "slug": "valmiki-ramayana-5-sarga-52-shlok-10",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "विभीषणवचः श्रुत्वा रावणो राक्षसेश्वरः।",
          "कोपेन महताऽऽविष्टो वाक्यमुत्तरमब्रवीत्॥१०॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-52",
    "chapterName": "सुन्दरकाण्ड, सर्ग 52",
    "verseNumber": 10
  },
  {
