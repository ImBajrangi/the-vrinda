    "slug": "valmiki-ramayana-5-sarga-52-shlok-11",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "न पापानां वधे पापं विद्यते शत्रुसूदन।",
          "तस्मादिमं वधिष्यामि वानरं पापकारिणम्॥११॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-52",
    "chapterName": "सुन्दरकाण्ड, सर्ग 52",
    "verseNumber": 11
  },
  {
