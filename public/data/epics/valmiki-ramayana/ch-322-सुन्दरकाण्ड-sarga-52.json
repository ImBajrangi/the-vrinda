    "slug": "valmiki-ramayana-5-sarga-52-shlok-14",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "असंशयं शत्रुरयं प्रवृद्धः कृतं ह्यनेनाप्रियमप्रमेयम्।",
          "न दूतवध्यां प्रवदन्ति सन्तो दूतस्य दृष्टा बहवो हि दण्डाः ॥१४॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-52",
    "chapterName": "सुन्दरकाण्ड, सर्ग 52",
    "verseNumber": 14
  },
  {
