    "slug": "valmiki-ramayana-5-sarga-52-shlok-15",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "वैरूप्यमङ्गेषु कशाभिघातो मौण्ड्यं तथा लक्षणसंनिपातः।",
          "एतान् हि दूते प्रवदन्ति दण्डान् वधस्तु दूतस्य न नः श्रुतोऽस्ति॥१५॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-52",
    "chapterName": "सुन्दरकाण्ड, सर्ग 52",
    "verseNumber": 15
  },
