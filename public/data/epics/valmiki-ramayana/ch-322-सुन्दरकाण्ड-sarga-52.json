    "slug": "valmiki-ramayana-5-sarga-52-shlok-12",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "अधर्ममूलं बहुदोषयुक्तमनार्यजुष्टं वचनं निशम्य।",
          "उवाच वाक्यं परमार्थतत्त्वं विभीषणो बुद्धिमतां वरिष्ठः॥१२॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-52",
    "chapterName": "सुन्दरकाण्ड, सर्ग 52",
    "verseNumber": 12
  },
  {
