    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "एतत् तु वचनं श्रुत्वा सीता रामस्य दुःखिता।",
          "प्रसक्ताश्रुमुखी मन्दमिदं वचनमब्रवीत्॥१॥"
        ]
      }
    ],
    "chapterId": "अयोध्याकाण्ड-sarga-29",
    "chapterName": "अयोध्याकाण्ड, सर्ग 29",
    "verseNumber": 1
  },
