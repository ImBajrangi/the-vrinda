    "slug": "valmiki-ramayana-2-sarga-29-shlok-2",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "ये त्वया कीर्तिता दोषा वने वस्तव्यतां प्रति।",
          "गुणानित्येव तान् विद्धि तव स्नेहपुरस्कृता॥२॥"
        ]
      }
    ],
    "chapterId": "अयोध्याकाण्ड-sarga-29",
    "chapterName": "अयोध्याकाण्ड, सर्ग 29",
    "verseNumber": 2
  },
  {
