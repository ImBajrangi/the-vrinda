    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-70-shlok-19",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "विरूपं यच्च मे रूपं प्राप्तं ह्यविनयाद् यथा।",
          "तन्मे शृणु नरव्याघ्र तत्त्वतः शंसतस्तव॥१९॥"
        ]
      }
    ],
