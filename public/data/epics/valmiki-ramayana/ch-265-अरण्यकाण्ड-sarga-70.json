    "collectionId": "valmiki-ramayana",
    "index": 8649,
    "titleDevanagari": "वाल्मीकि रामायण, अरण्यकाण्ड, सर्ग 70, श्लोक 10",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-70-shlok-10",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "स पपात महाबाहुश्छिन्नबाहुर्महास्वनः।",
          "खं च गां च दिशश्चैव नादयञ्जलदो यथा॥ १०॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-70",
    "chapterName": "अरण्यकाण्ड, सर्ग 70",
    "verseNumber": 10
  },
  {
