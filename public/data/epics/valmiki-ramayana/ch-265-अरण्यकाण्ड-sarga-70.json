    "titleDevanagari": "वाल्मीकि रामायण, अरण्यकाण्ड, सर्ग 70, श्लोक 1",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-70-shlok-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "तौ तु तत्र स्थितौ दृष्ट्वा भ्रातरौ रामलक्ष्मणौ।",
          "बाहुपाशपरिक्षिप्तौ कबन्धो वाक्यमब्रवीत्॥१॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-70",
    "chapterName": "अरण्यकाण्ड, सर्ग 70",
    "verseNumber": 1
  },
  {
    "id": "valmiki-ramayana-3-sarga-70-shlok-2",
    "collectionId": "valmiki-ramayana",
    "index": 8642,
    "titleDevanagari": "वाल्मीकि रामायण, अरण्यकाण्ड, सर्ग 70, श्लोक 2",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-70-shlok-2",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "तिष्ठतः किं नु मां दृष्ट्वा क्षुधार्तं क्षत्रियर्षभौ।",
          "आहारार्थं तु संदिष्टौ दैवेन हतचेतनौ॥२॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-70",
    "chapterName": "अरण्यकाण्ड, सर्ग 70",
    "verseNumber": 2
  },
  {
    "id": "valmiki-ramayana-3-sarga-70-shlok-3",
    "collectionId": "valmiki-ramayana",
    "index": 8643,
    "titleDevanagari": "वाल्मीकि रामायण, अरण्यकाण्ड, सर्ग 70, श्लोक 3",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-70-shlok-3",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "तच्छ्रुत्वा लक्ष्मणो वाक्यं प्राप्तकालं हितं तदा।",
          "उवाचार्तिसमापन्नो विक्रमे कृतनिश्चयः॥३॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-70",
    "chapterName": "अरण्यकाण्ड, सर्ग 70",
    "verseNumber": 3
  },
  {
    "id": "valmiki-ramayana-3-sarga-70-shlok-4",
    "collectionId": "valmiki-ramayana",
    "index": 8644,
    "titleDevanagari": "वाल्मीकि रामायण, अरण्यकाण्ड, सर्ग 70, श्लोक 4",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-70-shlok-4",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "त्वां च मां च पुरा तूर्णमादत्ते राक्षसाधमः।",
          "तस्मादसिभ्यामस्याशु बाहू छिन्दावहे गुरू॥४॥",
          "भीषणोऽयं महाकायो राक्षसा भुजविक्रमः।",
          "लोकं ह्यतिजितं कृत्वा ह्यावां हन्तुमिहेच्छति॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-70",
    "chapterName": "अरण्यकाण्ड, सर्ग 70",
    "verseNumber": 4
  },
  {
    "id": "valmiki-ramayana-3-sarga-70-shlok-6",
    "collectionId": "valmiki-ramayana",
    "index": 8645,
    "titleDevanagari": "वाल्मीकि रामायण, अरण्यकाण्ड, सर्ग 70, श्लोक 6",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-70-shlok-6",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "निश्चेष्टानां वधो राजन् कुत्सितो जगतीपतेः।",
          "क्रतुमध्योपनीतानां पशूनामिव राघव॥६॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-70",
    "chapterName": "अरण्यकाण्ड, सर्ग 70",
    "verseNumber": 6
  },
  {
    "id": "valmiki-ramayana-3-sarga-70-shlok-7",
    "collectionId": "valmiki-ramayana",
    "index": 8646,
    "titleDevanagari": "वाल्मीकि रामायण, अरण्यकाण्ड, सर्ग 70, श्लोक 7",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-70-shlok-7",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "एतत् संजल्पितं श्रुत्वा तयोः क्रुद्धस्तु राक्षसः।",
          "विदार्यास्यं ततो रौद्रं तौ भक्षयितुमारभत्॥७॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-70",
    "chapterName": "अरण्यकाण्ड, सर्ग 70",
    "verseNumber": 7
  },
  {
    "id": "valmiki-ramayana-3-sarga-70-shlok-8",
    "collectionId": "valmiki-ramayana",
    "index": 8647,
    "titleDevanagari": "वाल्मीकि रामायण, अरण्यकाण्ड, सर्ग 70, श्लोक 8",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-70-shlok-8",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "ततस्तौ देशकालज्ञौ खड्गाभ्यामेव राघवौ।",
          "अच्छिन्दन्तां सुसंहृष्टौ बाहू तस्यांसदेशतः॥८॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-70",
    "chapterName": "अरण्यकाण्ड, सर्ग 70",
    "verseNumber": 8
  },
  {
    "id": "valmiki-ramayana-3-sarga-70-shlok-9",
    "collectionId": "valmiki-ramayana",
    "index": 8648,
    "titleDevanagari": "वाल्मीकि रामायण, अरण्यकाण्ड, सर्ग 70, श्लोक 9",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-70-shlok-9",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "दक्षिणो दक्षिणं बाहुमसक्तमसिना ततः।",
          "चिच्छेद रामो वेगेन सव्यं वीरस्तु लक्ष्मणः॥९॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-70",
    "chapterName": "अरण्यकाण्ड, सर्ग 70",
    "verseNumber": 9
  },
  {
