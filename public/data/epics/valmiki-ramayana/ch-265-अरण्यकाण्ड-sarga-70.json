    "slug": "valmiki-ramayana-3-sarga-70-shlok-18",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "स्वागतं वां नरव्याघ्रौ दिष्ट्या पश्यामि वामहम्।",
          "दिष्ट्या चेमौ निकृत्तौ मे युवाभ्यां बाहुबन्धनौ॥ १८॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-70",
