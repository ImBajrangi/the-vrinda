        "stanzaNumber": 1,
        "linesDevanagari": [
          "॥ श्रीसीतारामचन्द्राभ्यां नमः॥",
          "श्रीमद्वाल्मीकीय रामायण",
          "अरण्यकाण्डम्",
          "सप्ततितमः सर्गः (सर्ग 70)",
          "इत्याचे श्रीमद्रामायणे वाल्मीकीये आदिकाव्येऽरण्यकाण्डे सप्ततितमः सर्गः॥७०॥"
        ]
      }
    ],
