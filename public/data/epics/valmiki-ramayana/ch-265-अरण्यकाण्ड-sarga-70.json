    "slug": "valmiki-ramayana-3-sarga-70-shlok-17",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "एवमुक्तः कबन्धस्तु लक्ष्मणेनोत्तरं वचः।",
          "उवाच वचनं प्रीतस्तदिन्द्रवचनं स्मरन्॥ १७॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-70",
    "chapterName": "अरण्यकाण्ड, सर्ग 70",
    "verseNumber": 17
  },
  {
