    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-70-shlok-13",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "अयमिक्ष्वाकुदायादो रामो नाम जनैः श्रुतः।",
          "तस्यैवावरजं विद्धि भ्रातरं मां च लक्ष्मणम्॥ १३॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-70",
    "chapterName": "अरण्यकाण्ड, सर्ग 70",
    "verseNumber": 13
  },
  {
    "id": "valmiki-ramayana-3-sarga-70-shlok-15",
    "collectionId": "valmiki-ramayana",
    "index": 8652,
    "titleDevanagari": "वाल्मीकि रामायण, अरण्यकाण्ड, सर्ग 70, श्लोक 15",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-70-shlok-15",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "मात्रा प्रतिहते राज्ये रामः प्रताजितो वनम्।",
          "मया सह चरत्येष भार्यया च महद् वनम्॥१४॥",
          "अस्य देवप्रभावस्य वसतो विजने वने।",
          "रक्षसापहृता भार्या यामिच्छन्ताविहागतौ॥१५॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-70",
    "chapterName": "अरण्यकाण्ड, सर्ग 70",
    "verseNumber": 15
  },
  {
    "id": "valmiki-ramayana-3-sarga-70-shlok-16",
    "collectionId": "valmiki-ramayana",
    "index": 8653,
    "titleDevanagari": "वाल्मीकि रामायण, अरण्यकाण्ड, सर्ग 70, श्लोक 16",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-70-shlok-16",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "आस्येनोरसि दीप्तेन भग्नजङ्घो विचेष्टसे॥१६॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-70",
    "chapterName": "अरण्यकाण्ड, सर्ग 70",
    "verseNumber": 16
  },
  {
