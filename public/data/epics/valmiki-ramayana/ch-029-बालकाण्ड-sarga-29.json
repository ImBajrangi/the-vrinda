    "slug": "valmiki-ramayana-1-sarga-29-shlok-3",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "तस्मिंस्तु तामसे युद्धे सर्वे ते देवराक्षसाः।",
          "अन्योन्यं नाभ्यजानन्त युद्ध्यमानाः परस्परम्॥३॥",
          "तस्मिंस्तु तामसे युद्धे सर्वे ते देवराक्षसाः।",
          "अन्योन्यं नाभ्यजानन्त युद्ध्यमानाः परस्परम्॥३॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-29",
    "chapterName": "बालकाण्ड, सर्ग 29",
    "verseNumber": 3
  },
  {
