    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "ततस्तु देवसैन्येन राक्षसानां बृहद् बलम्।",
          "दशांशं स्थापितं युद्धे शेषं नीतं यमक्षयम्॥२॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-29",
    "chapterName": "बालकाण्ड, सर्ग 29",
    "verseNumber": 2
  },
  {
