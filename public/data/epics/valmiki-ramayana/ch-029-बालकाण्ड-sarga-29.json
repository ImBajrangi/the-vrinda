      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "इन्द्रश्च रावणश्चैव रावणिश्च महाबलः।",
          "तस्मिंस्तमोजालवृते मोहमीयुर्न ते त्रयः॥४॥",
          "इन्द्रश्च रावणश्चैव रावणिश्च महाबलः।",
          "तस्मिंस्तमोजालवृते मोहमीयुर्न ते त्रयः॥४॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-29",
    "chapterName": "बालकाण्ड, सर्ग 29",
    "verseNumber": 4
  },
  {
