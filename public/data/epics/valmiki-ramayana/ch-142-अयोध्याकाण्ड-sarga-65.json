    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "सूताः परमसंस्कारा मागधाश्चोत्तमश्रुताः।",
          "गायकाः श्रुतिशीलाश्च निगदन्तः पृथक्पृथक्॥ २॥"
        ]
      }
