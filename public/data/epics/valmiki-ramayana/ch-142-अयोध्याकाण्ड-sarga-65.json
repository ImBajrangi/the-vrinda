    "slug": "valmiki-ramayana-2-sarga-65-shlok-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "अथ रात्र्यां व्यतीतायां प्रातरेवापरेऽहनि।",
          "वन्दिनः पर्युपातिष्ठस्तत्पार्थिवनिवेशनम्॥१॥"
        ]
      }
    ],
    "chapterId": "अयोध्याकाण्ड-sarga-65",
    "chapterName": "अयोध्याकाण्ड, सर्ग 65",
    "verseNumber": 1
  },
