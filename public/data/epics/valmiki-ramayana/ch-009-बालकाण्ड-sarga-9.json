    "slug": "valmiki-ramayana-1-sarga-9-shlok-12",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "ईदृशास्ते भविष्यन्ति पुत्राः पुत्रि न संशयः।",
          "तेजसा भास्करसमो तादृशोऽयं धनेश्वरः॥१२॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-9",
    "chapterName": "बालकाण्ड, सर्ग 9",
    "verseNumber": 12
