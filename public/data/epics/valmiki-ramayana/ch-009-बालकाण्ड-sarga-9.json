    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 9, श्लोक 1",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-9-shlok-1-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "वाली नाम मम भ्राता ज्येष्ठः शत्रुनिषूदनः।",
          "पितुर्बहमतो नित्यं मम चापि तथा पुरा॥१॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-9",
    "chapterName": "बालकाण्ड, सर्ग 9",
    "verseNumber": 1
  },
  {
    "id": "valmiki-ramayana-1-sarga-9-shlok-2",
    "collectionId": "valmiki-ramayana",
    "index": 437,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 9, श्लोक 2",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-9-shlok-2",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "कस्यचित् त्वथ कालस्य सुमाली नाम राक्षसः।",
          "रसातलान्मर्त्यलोकं सर्वं वै विचचार ह॥१॥",
          "नीलजीमूतसंकाशस्तप्तकाञ्चनकुण्डलः।",
          "कन्यां दुहितरं गृह्य विना पद्ममिव श्रियम्॥२॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-9",
    "chapterName": "बालकाण्ड, सर्ग 9",
    "verseNumber": 2
  },
  {
    "id": "valmiki-ramayana-1-sarga-9-shlok-3-1",
    "collectionId": "valmiki-ramayana",
    "index": 438,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 9, श्लोक 3",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-9-shlok-3-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "राक्षसेन्द्रः स तु तदा विचरन् वै महीतले।",
          "तदापश्यत् स गच्छन्तं पुष्पकेण धनेश्वरम्॥३॥",
          "गच्छन्तं पितरं द्रष्टुं पुलस्त्यतनयं विभुम्।",
          "तं दृष्ट्वामरसंकाशं गच्छन्तं पावकोपमम्॥४॥",
          "रसातलं प्रविष्टः सन्मर्त्यलोकात् सविस्मयः।"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-9",
    "chapterName": "बालकाण्ड, सर्ग 9",
    "verseNumber": 3
  },
  {
    "id": "valmiki-ramayana-1-sarga-9-shlok-4",
    "collectionId": "valmiki-ramayana",
    "index": 439,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 9, श्लोक 4",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-9-shlok-4",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "मायावी नाम तेजस्वी पूर्वजो दुन्दुभेः सुतः।",
          "तेन तस्य महबेरं वालिनः स्त्रीकृतं पुरा॥४॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-9",
    "chapterName": "बालकाण्ड, सर्ग 9",
    "verseNumber": 4
  },
  {
