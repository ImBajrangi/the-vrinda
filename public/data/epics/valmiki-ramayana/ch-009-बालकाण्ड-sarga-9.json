    "slug": "valmiki-ramayana-1-sarga-9-shlok-11-2",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "सा त्वं मुनिवरं श्रेष्ठं प्रजापतिकुलोद्भवम्।",
          "भज विश्रवसं पुत्रि पौलस्त्यं वरय स्वयम्॥११॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-9",
    "chapterName": "बालकाण्ड, सर्ग 9",
    "verseNumber": 11
  },
