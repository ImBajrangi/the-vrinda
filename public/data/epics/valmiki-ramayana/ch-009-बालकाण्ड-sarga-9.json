        "stanzaNumber": 1,
        "linesDevanagari": [
          "ऋष्यश्रृंगस्तु जामाता पुत्रांस्तव विधास्यति।",
          "सनत्कुमारकथितमेतावद् व्याहृतं मया॥१९॥"
        ]
      }
