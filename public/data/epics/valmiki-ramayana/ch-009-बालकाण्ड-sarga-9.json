    "index": 443,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 9, श्लोक 8",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-9-shlok-8",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "त्वत्कृते च वयं सर्वे यन्त्रिता धर्मबुद्धयः।",
          "त्वं हि सर्वगुणोपेता श्रीः साक्षादिव पुत्रिके॥८॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-9",
    "chapterName": "बालकाण्ड, सर्ग 9",
    "verseNumber": 8
  },
  {
