    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "मातुः कुलं पितृकुलं यत्र चैव च दीयते।",
          "कुलत्रयं सदा कन्या संशये स्थाप्य तिष्ठति॥१०॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-9",
    "chapterName": "बालकाण्ड, सर्ग 9",
    "verseNumber": 10
  },
