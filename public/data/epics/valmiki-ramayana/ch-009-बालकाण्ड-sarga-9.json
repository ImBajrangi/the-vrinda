    "slug": "valmiki-ramayana-1-sarga-9-shlok-16",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "विलिखन्ती मुहुर्भूमिमङ्गष्ठाग्रेण भामिनी।",
          "स तु तां वीक्ष्य सुश्रोणी पूर्णचन्द्रनिभाननाम्॥१६॥",
          "अब्रवीत् परमोदारो दीप्यमानां स्वतेजसा।"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-9",
    "chapterName": "बालकाण्ड, सर्ग 9",
    "verseNumber": 16
  },
