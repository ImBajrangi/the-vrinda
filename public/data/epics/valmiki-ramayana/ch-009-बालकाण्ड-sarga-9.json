    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 9, श्लोक 5",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-9-shlok-5",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "इत्येवं चिन्तयामास राक्षसानां महामतिः॥५॥",
          "किं कृत्वा श्रेय इत्येवं वर्धेमहि कथं वयम्।"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-9",
    "chapterName": "बालकाण्ड, सर्ग 9",
    "verseNumber": 5
  },
  {
    "id": "valmiki-ramayana-1-sarga-9-shlok-6",
    "collectionId": "valmiki-ramayana",
    "index": 441,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 9, श्लोक 6",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-9-shlok-6",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "प्रसुप्तस्तु मम भ्राता नर्दतो भैरवस्वनम्।",
          "श्रुत्वा न ममृषे वाली निष्पपात जवात् तदा॥६॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-9",
    "chapterName": "बालकाण्ड, सर्ग 9",
    "verseNumber": 6
  },
  {
    "id": "valmiki-ramayana-1-sarga-9-shlok-7",
    "collectionId": "valmiki-ramayana",
    "index": 442,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 9, श्लोक 7",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-9-shlok-7",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "अथाब्रवीत् सुतां रक्षः कैकसीं नाम नामतः॥६॥",
          "पुत्र प्रदानकालोऽयं यौवनं व्यतिवर्तते।",
          "प्रत्याख्यानाच्च भीतैस्त्वं न वरैः प्रतिगृह्यसे॥७॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-9",
    "chapterName": "बालकाण्ड, सर्ग 9",
    "verseNumber": 7
  },
  {
    "id": "valmiki-ramayana-1-sarga-9-shlok-8",
