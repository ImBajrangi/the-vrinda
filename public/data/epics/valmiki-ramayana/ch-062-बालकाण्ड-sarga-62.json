    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "एवमुक्त्वा मुनिश्रेष्ठमरुदं भृशदुःखितः।",
          "अथ ध्यात्वा मुहूर्तं च भगवानिदमब्रवीत्॥१॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-62",
    "chapterName": "बालकाण्ड, सर्ग 62",
    "verseNumber": 1
  },
