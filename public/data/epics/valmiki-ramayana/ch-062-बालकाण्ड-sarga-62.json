    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "पक्षौ च ते प्रपक्षौ च पुनरन्यौ भविष्यतः।",
          "चक्षुषी चैव प्राणाश्च विक्रमश्च बलं च ते॥२॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-62",
    "chapterName": "बालकाण्ड, सर्ग 62",
    "verseNumber": 2
  },
  {
