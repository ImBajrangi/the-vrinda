    "slug": "valmiki-ramayana-2-sarga-119-shlok-2",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "व्यक्ताक्षरपदं चित्रं भाषितं मधुरं त्वया।",
          "यथा स्वयंवरं वृत्तं तत् सर्वं च श्रुतं मया॥२॥"
        ]
      }
    ],
    "chapterId": "अयोध्याकाण्ड-sarga-119",
    "chapterName": "अयोध्याकाण्ड, सर्ग 119",
    "verseNumber": 2
  },
  {
