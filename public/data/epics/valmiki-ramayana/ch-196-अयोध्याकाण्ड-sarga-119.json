    "slug": "valmiki-ramayana-2-sarga-119-shlok-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "अनसूया तु धर्मज्ञा श्रुत्वा तां महतीं कथाम्।",
          "पर्यष्वजत बाहुभ्यां शिरस्याघ्राय मैथिलीम्॥१॥"
        ]
      }
    ],
    "chapterId": "अयोध्याकाण्ड-sarga-119",
    "chapterName": "अयोध्याकाण्ड, सर्ग 119",
    "verseNumber": 1
  },
  {
