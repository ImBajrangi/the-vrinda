      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "रूपाजीवाश्च वादिन्यो वणिजश्च महाधनाः।",
          "शोभयन्तु कुमारस्य वाहिनीः सुप्रसारिताः॥३॥"
        ]
      }
    ],
    "chapterId": "अयोध्याकाण्ड-sarga-36",
    "chapterName": "अयोध्याकाण्ड, सर्ग 36",
    "verseNumber": 3
  },
  {
