    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "ततः समन्त्रमैक्ष्वाकः पीडितोऽत्र प्रतिज्ञया।",
          "सबाष्पमतिनिःश्वस्य जगादेदं पुनर्वचः॥१॥"
        ]
      }
    ],
    "chapterId": "अयोध्याकाण्ड-sarga-36",
    "chapterName": "अयोध्याकाण्ड, सर्ग 36",
    "verseNumber": 1
  },
