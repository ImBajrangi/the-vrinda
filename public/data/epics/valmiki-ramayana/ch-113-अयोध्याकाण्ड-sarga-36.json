    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "धान्यकोशश्च यः कश्चिद् धनकोशश्च मामकः।",
          "तौ राममनुगच्छेतां वसन्तं निर्जने वने॥७॥"
        ]
      }
    ],
    "chapterId": "अयोध्याकाण्ड-sarga-36",
    "chapterName": "अयोध्याकाण्ड, सर्ग 36",
    "verseNumber": 7
  },
