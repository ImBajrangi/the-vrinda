    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "निघ्नन् मृगान् कुञ्जरांश्च पिबंश्चारण्यकं मधु।",
          "नदीश्च विविधाः पश्यन् न राज्यं संस्मरिष्यति॥ ६॥"
        ]
      }
    ],
    "chapterId": "अयोध्याकाण्ड-sarga-36",
    "chapterName": "अयोध्याकाण्ड, सर्ग 36",
    "verseNumber": 6
  },
