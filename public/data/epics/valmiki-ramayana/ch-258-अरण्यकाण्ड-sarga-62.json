    "slug": "valmiki-ramayana-3-sarga-62-shlok-10",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "सीतया सह निर्यातो विना सीतामुपागतः॥१०॥",
          "कथं नाम प्रवेक्ष्यामि शून्यमन्तःपुरं मम।",
          "अयोध्या"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-62",
    "chapterName": "अरण्यकाण्ड, सर्ग 62",
    "verseNumber": 10
  },
