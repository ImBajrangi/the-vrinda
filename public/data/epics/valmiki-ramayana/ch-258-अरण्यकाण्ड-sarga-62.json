    "titleDevanagari": "वाल्मीकि रामायण, अरण्यकाण्ड, सर्ग 62, श्लोक 5",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-62-shlok-5",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "कर्णिकारवनं भद्रे हसन्ती देवि सेवसे।",
          "अलं ते परिहासेन मम बाधावहेन वै॥५॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-62",
    "chapterName": "अरण्यकाण्ड, सर्ग 62",
    "verseNumber": 5
  },
  {
    "id": "valmiki-ramayana-3-sarga-62-shlok-6",
    "collectionId": "valmiki-ramayana",
    "index": 8441,
    "titleDevanagari": "वाल्मीकि रामायण, अरण्यकाण्ड, सर्ग 62, श्लोक 6",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-62-shlok-6",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "विशेषेणाश्रमस्थाने हासोऽयं न प्रशस्यते।",
          "अवगच्छामि ते शीलं परिहासप्रियं प्रिये॥६॥",
          "आगच्छ त्वं विशालाक्षि शून्योऽयमुटजस्तव।",
          "सुव्यक्तं राक्षसैः सीता भक्षिता वा हृतापि वा। ७॥",
          "न हि सा विलपन्तं मामुपसम्प्रेति लक्ष्मण।"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-62",
    "chapterName": "अरण्यकाण्ड, सर्ग 62",
    "verseNumber": 6
  },
  {
    "id": "valmiki-ramayana-3-sarga-62-shlok-8",
    "collectionId": "valmiki-ramayana",
    "index": 8442,
    "titleDevanagari": "वाल्मीकि रामायण, अरण्यकाण्ड, सर्ग 62, श्लोक 8",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-62-shlok-8",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "एतानि मृगयथानि साश्रुनेत्राणि लक्ष्मण॥८॥",
          "शंसन्तीव हि मे देवीं भक्षितां रजनीचरैः।",
          "हा ममार्ये क्व यातासि हा साध्वि वरवर्णिनि॥",
          "हा सकामाद्य कैकेयी देवि मेऽद्य भविष्यति।"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-62",
    "chapterName": "अरण्यकाण्ड, सर्ग 62",
    "verseNumber": 8
  },
  {
