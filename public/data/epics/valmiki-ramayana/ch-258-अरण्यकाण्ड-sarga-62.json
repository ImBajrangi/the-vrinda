    "index": 8446,
    "titleDevanagari": "वाल्मीकि रामायण, अरण्यकाण्ड, सर्ग 62, श्लोक 14",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-62-shlok-14",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "अथवा न गमिष्यामि पुरीं भरतपालिताम्॥१४॥",
          "स्वर्गोऽपि हि तया हीनः शून्य एव मतो मम।",
          "तन्मामुत्सृज्य हि वने गच्छायोध्यापुरीं शुभाम्॥ १५॥",
          "न त्वहं तां विना सीतां जीवेयं हि कथंचन।",
          "गाढमाश्लिष्य भरतो वाच्यो मद्रचनात् त्वया॥ १६॥",
          "अनुज्ञातोऽसि रामेण पालयेति वसुंधराम्।"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-62",
    "chapterName": "अरण्यकाण्ड, सर्ग 62",
    "verseNumber": 14
  },
  {
    "id": "valmiki-ramayana-3-sarga-62-shlok-18",
    "collectionId": "valmiki-ramayana",
    "index": 8447,
    "titleDevanagari": "वाल्मीकि रामायण, अरण्यकाण्ड, सर्ग 62, श्लोक 18",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-62-shlok-18",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "अम्बा च मम कैकेयी सुमित्रा च त्वया विभो॥ १७॥",
          "कौसल्या च यथान्यायमभिवाद्या ममाज्ञया।",
          "रक्षणीया प्रयत्नेन भवता सूक्तचारिणा॥१८॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-62",
    "chapterName": "अरण्यकाण्ड, सर्ग 62",
    "verseNumber": 18
  },
