    "titleDevanagari": "वाल्मीकि रामायण, अरण्यकाण्ड, सर्ग 62, श्लोक 1",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-62-shlok-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "सीतामपश्यन् धर्मात्मा शोकोपहतचेतनः।",
          "विललाप महाबाहू रामः कमललोचनः॥१॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-62",
    "chapterName": "अरण्यकाण्ड, सर्ग 62",
    "verseNumber": 1
  },
  {
    "id": "valmiki-ramayana-3-sarga-62-shlok-2",
    "collectionId": "valmiki-ramayana",
