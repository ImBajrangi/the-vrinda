    "titleDevanagari": "वाल्मीकि रामायण, अरण्यकाण्ड, सर्ग 62, श्लोक 2",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-62-shlok-2",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "पश्यन्निव च तां सीतामपश्यन्मन्मथार्दितः।",
          "उवाच राघवो वाक्यं विलापाश्रयदुर्वचम्॥२॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-62",
    "chapterName": "अरण्यकाण्ड, सर्ग 62",
    "verseNumber": 2
  },
  {
    "id": "valmiki-ramayana-3-sarga-62-shlok-3",
    "collectionId": "valmiki-ramayana",
    "index": 8438,
    "titleDevanagari": "वाल्मीकि रामायण, अरण्यकाण्ड, सर्ग 62, श्लोक 3",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-62-shlok-3",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "त्वमशोकस्य शाखाभिः पुष्पप्रियतरा प्रिये।",
          "आवृणोषि शरीरं ते मम शोकविवर्धनी॥३॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-62",
    "chapterName": "अरण्यकाण्ड, सर्ग 62",
    "verseNumber": 3
  },
  {
    "id": "valmiki-ramayana-3-sarga-62-shlok-4",
    "collectionId": "valmiki-ramayana",
