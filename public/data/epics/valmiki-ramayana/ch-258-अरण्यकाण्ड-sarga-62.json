    "slug": "valmiki-ramayana-3-sarga-62-shlok-13",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "विदेहराजो नूनं मां दृष्ट्वा विरहितं तया॥१३॥",
          "सुताविनाशसंतप्तो मोहस्य वशमेष्यति।"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-62",
    "chapterName": "अरण्यकाण्ड, सर्ग 62",
    "verseNumber": 13
  },
  {
    "id": "valmiki-ramayana-3-sarga-62-shlok-14",
