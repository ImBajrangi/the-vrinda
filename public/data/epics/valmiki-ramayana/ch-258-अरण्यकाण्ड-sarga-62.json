    "titleDevanagari": "वाल्मीकि रामायण, अरण्यकाण्ड, सर्ग 62, श्लोक 4",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-62-shlok-4",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "कदलीकाण्डसदृशौ कदल्या संवृतावुभौ।",
          "ऊरू पश्यामि ते देवि नासि शक्ता निगुहितुम्॥ ४॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-62",
    "chapterName": "अरण्यकाण्ड, सर्ग 62",
    "verseNumber": 4
  },
  {
    "id": "valmiki-ramayana-3-sarga-62-shlok-5",
