    "slug": "valmiki-ramayana-3-sarga-62-shlok-12",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "निवृत्तवनवासश्च जनकं मिथिलाधिपम्॥१२॥",
          "कुशलं परिपृच्छन्तं कथं शक्ष्ये निरीक्षितुम्।"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-62",
    "chapterName": "अरण्यकाण्ड, सर्ग 62",
    "verseNumber": 12
  },
  {
