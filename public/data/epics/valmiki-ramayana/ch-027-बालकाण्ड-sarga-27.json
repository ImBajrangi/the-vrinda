    "slug": "valmiki-ramayana-1-sarga-27-shlok-31",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "उदयाभ्युदितं दृष्ट्वा शशाङ्कं च विशेषतः॥३१॥",
          "आविवेश न तं निद्रा निशासु शयनं गतम्।"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-27",
    "chapterName": "बालकाण्ड, सर्ग 27",
    "verseNumber": 31
