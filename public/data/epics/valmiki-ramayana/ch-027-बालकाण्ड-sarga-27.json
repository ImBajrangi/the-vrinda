        "stanzaNumber": 1,
        "linesDevanagari": [
          "कैलासं लवयित्वा तु ससैन्यबलवाहनः।",
          "आससाद महातेजा इन्द्रलोकं दशाननः॥१॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-27",
    "chapterName": "बालकाण्ड, सर्ग 27",
    "verseNumber": 1
  },
