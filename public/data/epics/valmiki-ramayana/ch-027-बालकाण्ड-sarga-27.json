    "slug": "valmiki-ramayana-1-sarga-27-shlok-5-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "कृत्वा च समयं रामः सुग्रीवेण सहानघः।",
          "कालयुक्तं महद्वाक्यमुवाच रघुनन्दनः॥५॥",
          "विनीतं भ्रातरं भ्राता लक्ष्मणं लक्ष्मिवर्धनम्।"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-27",
    "chapterName": "बालकाण्ड, सर्ग 27",
    "verseNumber": 5
  },
