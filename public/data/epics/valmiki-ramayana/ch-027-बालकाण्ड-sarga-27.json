    "slug": "valmiki-ramayana-1-sarga-27-shlok-29",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "इत्युक्त्वा न्यवसत् तत्र राघवः सहलक्ष्मणः।",
          "बहुदृश्यदरीकुञ्ज तस्मिन् प्रस्रवणे गिरौ॥२९॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-27",
    "chapterName": "बालकाण्ड, सर्ग 27",
    "verseNumber": 29
  },
  {
    "id": "valmiki-ramayana-1-sarga-27-shlok-30",
