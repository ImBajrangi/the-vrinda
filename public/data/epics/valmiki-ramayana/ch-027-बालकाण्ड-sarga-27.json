    "slug": "valmiki-ramayana-1-sarga-27-shlok-30",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "सुसुखे हि बहुद्रव्ये तस्मिन् हि धरणीधरे।",
          "वसतस्तस्य रामस्य रतिरल्पापि नाभवत्॥३०॥",
          "हृतां हि भार्यां स्मरतः प्राणेभ्योऽपि गरीयसीम्।"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-27",
    "chapterName": "बालकाण्ड, सर्ग 27",
    "verseNumber": 30
  },
  {
