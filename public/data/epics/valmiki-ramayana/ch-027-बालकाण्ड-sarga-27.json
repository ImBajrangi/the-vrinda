    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "आदित्यांश्च वसून् रुद्रान् साध्यांश्च समरुद्गणान्।",
          "सज्जा भवत युद्धार्थं रावणस्य दुरात्मनः॥४॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-27",
    "chapterName": "बालकाण्ड, सर्ग 27",
    "verseNumber": 4
  },
