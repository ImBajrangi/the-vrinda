        "stanzaNumber": 1,
        "linesDevanagari": [
          "यदि नोत्सहसे यातुं मया सार्धमनिन्दिते।",
          "अभिज्ञानं प्रयच्छ त्वं जानीयाद् राघवो हि यत्॥१०॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-38",
    "chapterName": "सुन्दरकाण्ड, सर्ग 38",
    "verseNumber": 10
  },
  {
