          "एवमुक्ता हनुमता सीता सुरसुतोपमा।",
          "उवाच वचनं मन्दं बाष्पप्रग्रथिताक्षरम्॥११॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-38",
    "chapterName": "सुन्दरकाण्ड, सर्ग 38",
    "verseNumber": 11
  },
  {
