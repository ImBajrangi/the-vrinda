    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-5-sarga-38-shlok-16",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "ततो मांससमायुक्तो वायसः पर्यतुण्डयत्।",
          "तमहं लोष्टमुद्यम्य वारयामि स्म वायसम्॥१५॥",
          "दारयन् स च मां काकस्तत्रैव परिलीयते।",
          "न चाप्युपारमन्मांसाद् भक्षार्थी बलिभोजनः॥१६॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-38",
    "chapterName": "सुन्दरकाण्ड, सर्ग 38",
    "verseNumber": 16
  },
