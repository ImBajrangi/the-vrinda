    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "श्रोष्यते चैव काकुत्स्थः सर्वं निरवशेषतः।",
          "चेष्टितं यत् त्वया देवि भाषितं च ममाग्रतः॥६॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-38",
    "chapterName": "सुन्दरकाण्ड, सर्ग 38",
    "verseNumber": 6
  },
  {
