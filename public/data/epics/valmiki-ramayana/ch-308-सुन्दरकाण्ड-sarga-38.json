    "index": 10188,
    "titleDevanagari": "वाल्मीकि रामायण, सुन्दरकाण्ड, सर्ग 38, श्लोक 4",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-5-sarga-38-shlok-4",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "द्वितीयं कारणं यच्च ब्रवीषि विनयान्विते।",
          "रामादन्यस्य नार्हामि संसर्गमिति जानकि॥४॥",
          "एतत् ते देवि सदृशं पत्न्यास्तस्य महात्मनः।"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-38",
    "chapterName": "सुन्दरकाण्ड, सर्ग 38",
    "verseNumber": 4
  },
  {
