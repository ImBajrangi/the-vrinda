        "linesDevanagari": [
          "इच्छामि त्वां समानेतुमद्यैव रघुनन्दिना।",
          "गुरुस्नेहेन भक्त्या च नान्यथा तदुदाहृतम्॥९॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-38",
    "chapterName": "सुन्दरकाण्ड, सर्ग 38",
    "verseNumber": 9
