    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "कारणैर्बहुभिर्देवि रामप्रियचिकीर्षया।",
          "स्नेहप्रस्कन्नमनसा मयैतत् समुदीरितम्॥७॥",
          "७॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-38",
    "chapterName": "सुन्दरकाण्ड, सर्ग 38",
    "verseNumber": 7
  },
  {
