    "slug": "valmiki-ramayana-2-sarga-103-shlok-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "तां श्रुत्वा करुणां वाचं पितुर्मरणसंहिताम्।",
          "राघवो भरतेनोक्तां बभूव गतचेतनः॥१॥"
        ]
      }
    ],
    "chapterId": "अयोध्याकाण्ड-sarga-103",
    "chapterName": "अयोध्याकाण्ड, सर्ग 103",
    "verseNumber": 1
  },
  {
