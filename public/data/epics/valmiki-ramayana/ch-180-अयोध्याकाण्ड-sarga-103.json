    "slug": "valmiki-ramayana-2-sarga-103-shlok-3",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "तं तु वज्रमिवोत्सृष्टमाहवे दानवारिणा।",
          "वाग्वजं भरतेनोक्तममनोज्ञं परंतपः॥२॥",
          "प्रगृह्य रामो बाहू वै पुष्पिताङ्ग इव द्रुमः।",
          "वने परशुना कृत्तस्तथा भुवि पपात ह॥३॥"
        ]
      }
    ],
    "chapterId": "अयोध्याकाण्ड-sarga-103",
    "chapterName": "अयोध्याकाण्ड, सर्ग 103",
    "verseNumber": 3
  },
  {
