          "आर्ताः प्रजा नरव्याघ्र क्व नु यास्यन्ति निर्वृतिम्॥ ७॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-65",
    "chapterName": "अरण्यकाण्ड, सर्ग 65",
    "verseNumber": 7
  },
