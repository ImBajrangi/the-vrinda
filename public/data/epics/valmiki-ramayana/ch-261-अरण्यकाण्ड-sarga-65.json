    "titleDevanagari": "वाल्मीकि रामायण, अरण्यकाण्ड, सर्ग 65, श्लोक 2",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-65-shlok-2",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "तं तथा शोकसंतप्तं विलपन्तमनाथवत्।",
          "मोहेन महता युक्तं परिधूनमचेतसम्॥१॥",
          "ततः सौमित्रिराश्वस्य मुहूर्तादिव लक्ष्मणः।",
          "रामं सम्बोधयामास चरणौ चाभिपीडयन्॥२॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-65",
    "chapterName": "अरण्यकाण्ड, सर्ग 65",
    "verseNumber": 2
  },
  {
    "id": "valmiki-ramayana-3-sarga-65-shlok-3",
    "collectionId": "valmiki-ramayana",
    "index": 8520,
    "titleDevanagari": "वाल्मीकि रामायण, अरण्यकाण्ड, सर्ग 65, श्लोक 3",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-65-shlok-3",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "महता तपसा चापि महता चापि कर्मणा।",
          "राजा दशरथेनासील्लब्धोऽमृतमिवामरैः॥३॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-65",
    "chapterName": "अरण्यकाण्ड, सर्ग 65",
    "verseNumber": 3
  },
