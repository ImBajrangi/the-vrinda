    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-65-shlok-4",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "तव चैव गुणैर्बद्धस्त्वद्वियोगान्महीपतिः।",
          "राजा देवत्वमापन्नो भरतस्य यथा श्रुतम्॥४॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-65",
    "chapterName": "अरण्यकाण्ड, सर्ग 65",
    "verseNumber": 4
  },
