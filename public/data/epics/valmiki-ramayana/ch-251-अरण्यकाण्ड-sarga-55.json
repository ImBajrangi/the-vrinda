    "slug": "valmiki-ramayana-3-sarga-55-shlok-12",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "दीर्घिकाः पुष्करिण्यश्च नानापुष्पसमावृताः।",
          "रावणो दर्शयामास सीतां शोकपरायणाम्॥ १२॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-55",
    "chapterName": "अरण्यकाण्ड, सर्ग 55",
    "verseNumber": 12
