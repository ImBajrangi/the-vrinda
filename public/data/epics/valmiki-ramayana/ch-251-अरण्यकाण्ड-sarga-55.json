    "slug": "valmiki-ramayana-3-sarga-55-shlok-13",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "दर्शयित्वा तु वैदेहीं कृत्स्नं तद्भवनोत्तमम्।",
          "उवाच वाक्यं पापात्मा सीतां लोभितुमिच्छया॥ १३॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-55",
    "chapterName": "अरण्यकाण्ड, सर्ग 55",
    "verseNumber": 13
  },
  {
