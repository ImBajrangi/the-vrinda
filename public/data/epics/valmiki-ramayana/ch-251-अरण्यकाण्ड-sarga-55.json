    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-55-shlok-10",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "दान्तका राजताश्चैव गवाक्षाः प्रियदर्शनाः।",
          "हेमजालावृताश्चासंस्तत्र प्रासादपङ्क्तयः॥१०॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-55",
    "chapterName": "अरण्यकाण्ड, सर्ग 55",
    "verseNumber": 10
  },
