[
  {
    "id": "valmiki-ramayana-3-sarga-55-shlok-1",
    "collectionId": "valmiki-ramayana",
    "index": 8258,
    "titleDevanagari": "वाल्मीकि रामायण, अरण्यकाण्ड, सर्ग 55, श्लोक 1",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-55-shlok-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "संदिश्य राक्षसान् घोरान् रावणोऽष्टौ महाबलान्।",
          "आत्मानं बुद्धिवैक्लव्यात् कृत्कृत्यममन्यत॥१॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-55",
    "chapterName": "अरण्यकाण्ड, सर्ग 55",
    "verseNumber": 1
  },
  {
    "id": "valmiki-ramayana-3-sarga-55-shlok-2",
    "collectionId": "valmiki-ramayana",
    "index": 8259,
    "titleDevanagari": "वाल्मीकि रामायण, अरण्यकाण्ड, सर्ग 55, श्लोक 2",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-55-shlok-2",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "स चिन्तयानो वैदेहीं कामबाणैः प्रपीडितः।",
          "प्रविवेश गृहं रम्यं सीतां द्रष्टमभित्वरन्॥२॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-55",
    "chapterName": "अरण्यकाण्ड, सर्ग 55",
    "verseNumber": 2
  },
  {
    "id": "valmiki-ramayana-3-sarga-55-shlok-4",
    "collectionId": "valmiki-ramayana",
    "index": 8260,
    "titleDevanagari": "वाल्मीकि रामायण, अरण्यकाण्ड, सर्ग 55, श्लोक 4",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-55-shlok-4",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "स प्रविश्य तु तद्देश्म रावणो राक्षसाधिपः।",
          "अपश्यद् राक्षसीमध्ये सीतां दुःखपरायणाम्॥",
          "अश्रुपूर्णमुखीं दीनां शोकभारावपीडिताम्।",
          "वायुवेगैरिवाक्रान्तां मज्जन्तीं नावमर्णवे॥४॥",
          "मृगयूथपरिभ्रष्टां मृगी श्वभिरिवावृताम्।"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-55",
    "chapterName": "अरण्यकाण्ड, सर्ग 55",
    "verseNumber": 4
  },
  {
    "id": "valmiki-ramayana-3-sarga-55-shlok-6",
    "collectionId": "valmiki-ramayana",
    "index": 8261,
    "titleDevanagari": "वाल्मीकि रामायण, अरण्यकाण्ड, सर्ग 55, श्लोक 6",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-55-shlok-6",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "अधोगतमुखीं सीतां तामभ्येत्य निशाचरः॥५॥",
          "तां तु शोकवशाद् दीनामवशां राक्षसाधिपः।",
          "सबलाद् दर्शयामास गृहं देवगृहोपमम्॥६॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-55",
    "chapterName": "अरण्यकाण्ड, सर्ग 55",
    "verseNumber": 6
  },
  {
