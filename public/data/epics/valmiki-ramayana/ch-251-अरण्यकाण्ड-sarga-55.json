    "titleDevanagari": "वाल्मीकि रामायण, अरण्यकाण्ड, सर्ग 55, श्लोक 7",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-55-shlok-7",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "हर्म्यप्रासादसम्बाधं स्त्रीसहस्रनिषेवितम्।",
          "नानापक्षिगणैर्जुष्टं नानारत्नसमन्वितम्॥७॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-55",
    "chapterName": "अरण्यकाण्ड, सर्ग 55",
    "verseNumber": 7
  },
