    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-55-shlok-8",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "दान्तकैस्तापनीयैश्च स्फाटिकै राजतैस्तथा।",
          "वज्रवैदूर्यचित्रैश्च स्तम्भैदृष्टिमनोरमैः॥८॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-55",
    "chapterName": "अरण्यकाण्ड, सर्ग 55",
    "verseNumber": 8
  },
  {
