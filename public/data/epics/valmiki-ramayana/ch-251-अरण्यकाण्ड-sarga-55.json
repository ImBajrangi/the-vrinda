    "slug": "valmiki-ramayana-3-sarga-55-shlok-11",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "सुधामणिविचित्राणि भूमिभागानि सर्वशः।",
          "दशग्रीवः स्वभवने प्रादर्शयत मैथिलीम्॥११॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-55",
    "chapterName": "अरण्यकाण्ड, सर्ग 55",
    "verseNumber": 11
  },
