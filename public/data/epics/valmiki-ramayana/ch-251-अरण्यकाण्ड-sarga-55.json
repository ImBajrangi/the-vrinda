    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-55-shlok-16",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "यदिदं राज्यतन्त्रं मे त्वयि सर्वं प्रतिष्ठितम्।",
          "जीवितं च विशालाक्षि त्वं मे प्राणैर्गरीयसी॥ १६॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-55",
    "chapterName": "अरण्यकाण्ड, सर्ग 55",
    "verseNumber": 16
  },
  {
