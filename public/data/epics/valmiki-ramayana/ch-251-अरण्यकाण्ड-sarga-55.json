    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-55-shlok-15",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "दश राक्षसकोट्यश्च द्वाविंशतिरथापराः।",
          "वर्जयित्वा जरावृद्धान् बालांश्च रजनीचरान्॥ १४॥",
          "तेषां प्रभुरहं सीते सर्वेषां भीमकर्मणाम्।",
          "सहस्रमेकमेकस्य मम कार्यपुरःसरम्॥१५॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-55",
    "chapterName": "अरण्यकाण्ड, सर्ग 55",
    "verseNumber": 15
  },
  {
