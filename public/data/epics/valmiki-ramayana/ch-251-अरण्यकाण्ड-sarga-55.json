    "slug": "valmiki-ramayana-3-sarga-55-shlok-9",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "दिव्यदुन्दुभिनिर्घोषं तप्तकाञ्चनभूषणम्।",
          "सोपानं काञ्चनं चित्रमारुरोह तया सह ॥९॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-55",
    "chapterName": "अरण्यकाण्ड, सर्ग 55",
    "verseNumber": 9
  },
  {
