    "slug": "valmiki-ramayana-5-sarga-21-shlok-3",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "तृणमन्तरतः कृत्वा प्रत्युवाच शुचिस्मिता।",
          "निवर्तय मनो मत्तः स्वजने प्रीयतां मनः॥३॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-21",
    "chapterName": "सुन्दरकाण्ड, सर्ग 21",
    "verseNumber": 3
  },
