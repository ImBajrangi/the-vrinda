    "slug": "valmiki-ramayana-5-sarga-21-shlok-4",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "न मां प्रार्थयितुं युक्तस्त्वं सिद्धिमिव पापकृत्।",
          "अकार्यं न मया कार्यमेकपत्न्या विगर्हितम्॥४॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-21",
    "chapterName": "सुन्दरकाण्ड, सर्ग 21",
    "verseNumber": 4
  },
  {
    "id": "valmiki-ramayana-5-sarga-21-shlok-6",
