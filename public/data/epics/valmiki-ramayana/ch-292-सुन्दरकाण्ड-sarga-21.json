    "slug": "valmiki-ramayana-5-sarga-21-shlok-7",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "साधु धर्ममवेक्षस्व साधु साधुव्रतं चर।",
          "यथा तव तथान्येषां रक्ष्या दारा निशाचर॥७॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-21",
    "chapterName": "सुन्दरकाण्ड, सर्ग 21",
    "verseNumber": 7
  },
