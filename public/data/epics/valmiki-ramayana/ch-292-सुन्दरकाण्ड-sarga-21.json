    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-5-sarga-21-shlok-6",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "कुलं सम्प्राप्तया पुण्यं कुले महति जातया।",
          "एवमुक्त्वा तु वैदेही रावणं तं यशस्विनी॥५॥",
          "रावणं पृष्ठतः कृत्वा भूयो वचनमब्रवीत्।",
          "नाहमौपयिकी भार्या परभार्या सती तव॥६॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-21",
    "chapterName": "सुन्दरकाण्ड, सर्ग 21",
    "verseNumber": 6
  },
  {
