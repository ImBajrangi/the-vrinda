    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "इह सन्तो न वा सन्ति सतो वा नानुवर्तसे।",
          "यथा हि विपरीता ते बुद्धिराचारवर्जिता॥९॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-21",
    "chapterName": "सुन्दरकाण्ड, सर्ग 21",
    "verseNumber": 9
