    "slug": "valmiki-ramayana-5-sarga-21-shlok-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "तस्य तद् वचनं श्रुत्वा सीता रौद्रस्य रक्षसः।",
          "आर्ता दीनस्वरा दीनं प्रत्युवाच ततः शनैः॥१॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-21",
    "chapterName": "सुन्दरकाण्ड, सर्ग 21",
    "verseNumber": 1
  },
  {
