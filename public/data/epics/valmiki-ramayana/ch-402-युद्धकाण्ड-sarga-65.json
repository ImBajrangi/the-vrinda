    "slug": "valmiki-ramayana-6-sarga-65-shlok-3",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "गर्जन्ति न वृथा शूरा निर्जला इव तोयदाः।",
          "पश्य सम्पद्यमानं तु गर्जितं युधि कर्मणा॥३॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-65",
    "chapterName": "युद्धकाण्ड, सर्ग 65",
    "verseNumber": 3
  },
  {
