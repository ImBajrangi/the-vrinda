    "slug": "valmiki-ramayana-6-sarga-65-shlok-2",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "सोऽहं तव भयं घोरं वधात् तस्य दुरात्मनः।",
          "रामस्याद्य प्रमार्जामि निर्वैरो हि सुखी भव॥२॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-65",
    "chapterName": "युद्धकाण्ड, सर्ग 65",
    "verseNumber": 2
  },
  {
