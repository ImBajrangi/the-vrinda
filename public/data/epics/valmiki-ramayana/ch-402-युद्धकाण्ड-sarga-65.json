    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "न मर्षयन्ति चात्मानं सम्भावयितुमात्मना।",
          "अदर्शयित्वा शूरास्तु कर्म कुर्वन्ति दुष्करम्॥४॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-65",
    "chapterName": "युद्धकाण्ड, सर्ग 65",
    "verseNumber": 4
  },
  {
