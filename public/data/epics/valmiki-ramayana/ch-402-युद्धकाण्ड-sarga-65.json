        "linesDevanagari": [
          "युद्धे कापुरुषैर्नित्यं भवद्भिः प्रियवादिभिः।",
          "राजानमनुगच्छद्भिः सर्वं कृत्यं विनाशितम्॥६॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-65",
    "chapterName": "युद्धकाण्ड, सर्ग 65",
    "verseNumber": 6
  },
