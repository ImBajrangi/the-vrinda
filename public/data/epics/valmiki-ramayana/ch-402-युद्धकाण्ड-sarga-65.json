    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "विक्लवानां ह्यबुद्धीनां राज्ञां पण्डितमानिनाम्।",
          "रोचते त्वदचो नित्यं कथ्यमानं महोदर॥५॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-65",
    "chapterName": "युद्धकाण्ड, सर्ग 65",
    "verseNumber": 5
  },
  {
