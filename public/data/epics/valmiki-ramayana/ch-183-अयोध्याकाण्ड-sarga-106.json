    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "परावरज्ञो यश्च स्याद् यथा त्वं मनुजाधिप।",
          "स एव व्यसनं प्राप्य न विषीदितुमर्हति॥५॥"
        ]
      }
    ],
    "chapterId": "अयोध्याकाण्ड-sarga-106",
    "chapterName": "अयोध्याकाण्ड, सर्ग 106",
    "verseNumber": 5
  },
  {
