    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "यथा मृतस्तथा जीवन् यथासति तथा सति।",
          "यस्यैष बुद्धिलाभः स्यात् परितप्येत केन सः॥ ४॥"
        ]
      }
    ],
    "chapterId": "अयोध्याकाण्ड-sarga-106",
    "chapterName": "अयोध्याकाण्ड, सर्ग 106",
    "verseNumber": 4
  },
