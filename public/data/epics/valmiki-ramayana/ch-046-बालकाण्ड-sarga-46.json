    "slug": "valmiki-ramayana-1-sarga-46-shlok-6",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "ततः क्षतजवेगेन आपुपूरे तदा बिलम्।",
          "तदहं विस्मितो दृष्ट्वा भ्रातुः शोकविषार्दितः॥६॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-46",
    "chapterName": "बालकाण्ड, सर्ग 46",
    "verseNumber": 6
  },
  {
