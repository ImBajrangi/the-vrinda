    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "उदयं तत्र पश्यामि पर्वतं धातमण्डितम्।",
          "क्षीरोदं सागरं चैव नित्यमप्सरसालयम्॥१५॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-46",
