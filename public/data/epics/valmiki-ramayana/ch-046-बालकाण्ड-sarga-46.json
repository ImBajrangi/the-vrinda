    "slug": "valmiki-ramayana-1-sarga-46-shlok-9",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "राज्यं च सुमहत् प्राप्य तारां च रुमया सह।",
          "मित्रैश्च सहितस्तत्र वसामि विगतज्वरः॥९॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-46",
    "chapterName": "बालकाण्ड, सर्ग 46",
    "verseNumber": 9
  },
  {
