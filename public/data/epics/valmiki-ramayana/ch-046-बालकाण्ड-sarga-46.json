    "slug": "valmiki-ramayana-1-sarga-46-shlok-18-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "द्रुमशैलान्तरे पश्यन् भूयो दक्षिणतोऽपराम्।",
          "अपरां च दिशं प्राप्तो वालिना समभिद्रतः॥१८॥"
        ]
      }
