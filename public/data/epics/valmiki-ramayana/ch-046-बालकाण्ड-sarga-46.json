    "slug": "valmiki-ramayana-1-sarga-46-shlok-12",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "पूर्णे वर्षसहस्रे सा दशोने रघुनन्दन।",
          "दितिः परमसंहृष्टा सहस्राक्षमथाब्रवीत्॥१२॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-46",
    "chapterName": "बालकाण्ड, सर्ग 46",
    "verseNumber": 12
  },
