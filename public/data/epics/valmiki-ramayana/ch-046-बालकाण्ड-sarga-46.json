[
  {
    "id": "valmiki-ramayana-1-sarga-46-shlok-1",
    "collectionId": "valmiki-ramayana",
    "index": 2168,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 46, श्लोक 1",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-46-shlok-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "हतेषु तेषु पुत्रेषु दितिः परमदुःखिता।",
          "मारीचं कश्यपं नाम भर्तारमिदमब्रवीत्॥१॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-46",
    "chapterName": "बालकाण्ड, सर्ग 46",
    "verseNumber": 1
  },
  {
    "id": "valmiki-ramayana-1-sarga-46-shlok-2-1",
    "collectionId": "valmiki-ramayana",
    "index": 2169,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 46, श्लोक 2",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-46-shlok-2-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "सुग्रीवश्च ततो राममुवाच प्रणतात्मवान्।",
          "श्रूयतां सर्वमाख्यास्ये विस्तरेण वचो मम॥२॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-46",
    "chapterName": "बालकाण्ड, सर्ग 46",
    "verseNumber": 2
  },
  {
    "id": "valmiki-ramayana-1-sarga-46-shlok-3",
    "collectionId": "valmiki-ramayana",
    "index": 2170,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 46, श्लोक 3",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-46-shlok-3",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "साहं तपश्चरिष्यामि गर्भं मे दातुमर्हसि।",
          "ईश्वरं शक्रहन्तारं त्वमनुज्ञातुमर्हसि॥३॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-46",
    "chapterName": "बालकाण्ड, सर्ग 46",
    "verseNumber": 3
  },
  {
    "id": "valmiki-ramayana-1-sarga-46-shlok-4",
    "collectionId": "valmiki-ramayana",
    "index": 2171,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 46, श्लोक 4",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-46-shlok-4",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "यदा तु दुन्दुभिं नाम दानवं महिषाकृतिम्।",
          "प्रतिकालयते वाली मलयं प्रति पर्वतम्॥३॥",
          "तदा विवेश महिषो मलयस्य गुहां प्रति।",
          "विवेश वाली तत्रापि मलयं तज्जिघांसया॥४॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-46",
    "chapterName": "बालकाण्ड, सर्ग 46",
    "verseNumber": 4
  },
  {
    "id": "valmiki-ramayana-1-sarga-46-shlok-5",
    "collectionId": "valmiki-ramayana",
    "index": 2172,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 46, श्लोक 5",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-46-shlok-5",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "ततोऽहं तत्र निक्षिप्तो गुहाद्वारि विनीतवत्।",
          "न च निष्क्रामते वाली तदा संवत्सरे गते॥५॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-46",
    "chapterName": "बालकाण्ड, सर्ग 46",
    "verseNumber": 5
  },
  {
    "id": "valmiki-ramayana-1-sarga-46-shlok-6",
