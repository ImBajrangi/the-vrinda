    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-46-shlok-8",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "अशक्नुवन्निष्क्रमितुं महिषो विनशिष्यति।",
          "ततोऽहमागां किष्किन्धां निराशस्तस्य जीविते॥८ ॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-46",
    "chapterName": "बालकाण्ड, सर्ग 46",
    "verseNumber": 8
  },
  {
