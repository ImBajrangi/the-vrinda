    "slug": "valmiki-ramayana-1-sarga-46-shlok-10",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "आजगाम ततो वाली हत्वा तं वानरर्षभः।",
          "ततोऽहमददां राज्यं गौरवाद भययन्त्रितः॥१०॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-46",
    "chapterName": "बालकाण्ड, सर्ग 46",
    "verseNumber": 10
  },
