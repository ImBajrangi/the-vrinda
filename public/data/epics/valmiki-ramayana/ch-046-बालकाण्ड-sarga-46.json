    "slug": "valmiki-ramayana-1-sarga-46-shlok-7",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "अथाहं गतबुद्धिस्तु सुव्यक्तं निहतो गुरुः।",
          "शिला पर्वतसंकाशा बिलद्वारि मया कृता॥७॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-46",
    "chapterName": "बालकाण्ड, सर्ग 46",
    "verseNumber": 7
  },
  {
