    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 46, श्लोक 13",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-46-shlok-13",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "ततोऽहं वालिना तेन सोऽनुबद्धः प्रधावितः।",
          "नदीश्च विविधाः पश्यन् वनानि नगराणि च॥१२॥",
          "आदर्शतलसंकाशा ततो वै पृथिवी मया।",
          "अलातचक्रप्रतिमा दृष्टा गोष्पदवत् कृता॥१३॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-46",
    "chapterName": "बालकाण्ड, सर्ग 46",
    "verseNumber": 13
  },
  {
    "id": "valmiki-ramayana-1-sarga-46-shlok-14-1",
    "collectionId": "valmiki-ramayana",
    "index": 2181,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 46, श्लोक 14",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-46-shlok-14-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "पूर्वां दिशं ततो गत्वा पश्यामि विविधान् द्रुमान्।",
          "पर्वतान् सदरीन् रम्यान् सरांसि विविधानि च॥१४॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-46",
    "chapterName": "बालकाण्ड, सर्ग 46",
    "verseNumber": 14
  },
