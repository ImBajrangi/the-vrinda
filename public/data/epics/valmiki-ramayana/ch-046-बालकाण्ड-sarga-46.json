    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-46-shlok-11-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "स मां जिघांसर्दष्टात्मा वाली प्रव्यथितेन्द्रियः।",
          "परिकालयते वाली धावन्तं सचिवैः सह ॥११॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-46",
