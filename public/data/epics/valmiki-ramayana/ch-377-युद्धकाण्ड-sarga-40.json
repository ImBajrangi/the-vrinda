    "slug": "valmiki-ramayana-6-sarga-40-shlok-11",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "इत्युक्त्वा सहसोत्पत्य पुप्लुवे तस्य चोपरि।",
          "आकृष्य मुकुटं चित्रं पातयामास तद् भुवि॥११॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-40",
    "chapterName": "युद्धकाण्ड, सर्ग 40",
    "verseNumber": 11
  },
  {
    "id": "valmiki-ramayana-6-sarga-40-shlok-12",
    "collectionId": "valmiki-ramayana",
