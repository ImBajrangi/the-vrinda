    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-6-sarga-40-shlok-6",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "शशलोहितरागेण संवीतं रक्तवाससा।",
          "संध्यातपेन संछन्नं मेघराशिमिवाम्बरे॥६॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-40",
    "chapterName": "युद्धकाण्ड, सर्ग 40",
    "verseNumber": 6
  },
  {
    "id": "valmiki-ramayana-6-sarga-40-shlok-7",
    "collectionId": "valmiki-ramayana",
    "index": 12439,
    "titleDevanagari": "वाल्मीकि रामायण, युद्धकाण्ड, सर्ग 40, श्लोक 7",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-6-sarga-40-shlok-7",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "पश्यतां वानरेन्द्राणां राघवस्यापि पश्यतः।",
          "दर्शनाद् राक्षसेन्द्रस्य सुग्रीवः सहसोत्थितः॥७॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-40",
    "chapterName": "युद्धकाण्ड, सर्ग 40",
    "verseNumber": 7
  },
  {
    "id": "valmiki-ramayana-6-sarga-40-shlok-8",
    "collectionId": "valmiki-ramayana",
    "index": 12440,
    "titleDevanagari": "वाल्मीकि रामायण, युद्धकाण्ड, सर्ग 40, श्लोक 8",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-6-sarga-40-shlok-8",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "क्रोधवेगेन संयुक्तः सत्त्वेन च बलेन च।",
          "अचलाग्रादथोत्थाय पुप्लुवे गोपुरस्थले॥८॥",
          "स्थित्वा मुहूर्तं सम्प्रेक्ष्य निर्भयेनान्तरात्मना।",
          "तृणीकृत्य च तद् रक्षः सोऽब्रवीत् परुषं वचः॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-40",
    "chapterName": "युद्धकाण्ड, सर्ग 40",
    "verseNumber": 8
  },
  {
    "id": "valmiki-ramayana-6-sarga-40-shlok-10",
    "collectionId": "valmiki-ramayana",
    "index": 12441,
    "titleDevanagari": "वाल्मीकि रामायण, युद्धकाण्ड, सर्ग 40, श्लोक 10",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-6-sarga-40-shlok-10",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "लोकनाथस्य रामस्य सखा दासोऽस्मि राक्षस।",
          "न मया मोक्ष्यसेऽद्य त्वं पार्थिवेन्द्रस्य तेजसा॥१०॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-40",
    "chapterName": "युद्धकाण्ड, सर्ग 40",
    "verseNumber": 10
  },
