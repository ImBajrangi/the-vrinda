    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-6-sarga-40-shlok-18",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "आलिङ्ग्य चालिङ्ग्य च बाहुयोक्त्रैः संयोजयामासतुराहवे तौ।",
          "संरम्भशिक्षाबलसम्प्रयुक्तौ सुचेरतुः सम्प्रति युद्धमार्गः ॥१८॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-40",
    "chapterName": "युद्धकाण्ड, सर्ग 40",
    "verseNumber": 18
  },
