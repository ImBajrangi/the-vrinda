    "slug": "valmiki-ramayana-6-sarga-40-shlok-15",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "मुष्टिप्रहारैश्च तलप्रहारैररनिघातैश्च कराग्रघातैः।",
          "तौ चक्रतुयुद्धमसह्यरूपं महाबलौ राक्षसवानरेन्द्रौ॥१५॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-40",
    "chapterName": "युद्धकाण्ड, सर्ग 40",
    "verseNumber": 15
  },
