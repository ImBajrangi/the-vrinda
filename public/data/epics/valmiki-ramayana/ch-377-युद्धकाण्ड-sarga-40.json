    "titleDevanagari": "वाल्मीकि रामायण, युद्धकाण्ड, सर्ग 40, श्लोक 5",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-6-sarga-40-shlok-5",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "नीलजीमूतसंकाशं हेमसंछादिताम्बरम्।",
          "ऐरावतविषाणाग्रैरुत्कृष्टकिणवक्षसम्॥५॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-40",
    "chapterName": "युद्धकाण्ड, सर्ग 40",
    "verseNumber": 5
  },
  {
