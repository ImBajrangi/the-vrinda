    "slug": "valmiki-ramayana-6-sarga-40-shlok-19",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "शार्दूलसिंहाविव जातदंष्ट्रौ गजेन्द्रपोताविव सम्प्रयुक्तौ।",
          "संहत्य संवेद्य च तौ कराभ्यां तौ पेततुर्वै युगपद् धरायाम्॥१९॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-40",
    "chapterName": "युद्धकाण्ड, सर्ग 40",
    "verseNumber": 19
  },
  {
    "id": "valmiki-ramayana-6-sarga-40-shlok-20",
