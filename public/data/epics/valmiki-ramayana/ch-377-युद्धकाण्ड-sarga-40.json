    "slug": "valmiki-ramayana-6-sarga-40-shlok-13",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "इत्युक्त्वोत्थाय तं क्षिप्रं बाहुभ्यामाक्षिपत् तले।",
          "कन्दुवत् स समुत्थाय बाहुभ्यामाक्षिपद्धरिः॥१३॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-40",
    "chapterName": "युद्धकाण्ड, सर्ग 40",
    "verseNumber": 13
