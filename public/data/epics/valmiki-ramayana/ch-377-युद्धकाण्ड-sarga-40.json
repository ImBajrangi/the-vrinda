[
  {
    "id": "valmiki-ramayana-6-sarga-40-shlok-1",
    "collectionId": "valmiki-ramayana",
    "index": 12434,
    "titleDevanagari": "वाल्मीकि रामायण, युद्धकाण्ड, सर्ग 40, श्लोक 1",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-6-sarga-40-shlok-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "ततो रामः सुवेलाग्रं योजनद्वयमण्डलम्।",
          "उपारोहत् ससुग्रीवो हरियथैः समन्वितः॥१॥",
          "बाहूत्तमैारणवारणाभैनिवारयन्तौ परवारणाभौ।",
          "चिरेण कालेन भृशं प्रयुद्धौ संचेरतुर्मण्डलमार्गमाशु॥२",
          "१॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-40",
    "chapterName": "युद्धकाण्ड, सर्ग 40",
    "verseNumber": 1
  },
  {
    "id": "valmiki-ramayana-6-sarga-40-shlok-2",
    "collectionId": "valmiki-ramayana",
    "index": 12435,
    "titleDevanagari": "वाल्मीकि रामायण, युद्धकाण्ड, सर्ग 40, श्लोक 2",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-6-sarga-40-shlok-2",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "स्थित्वा मुहूर्तं तत्रैव दिशो दश विलोकयन्।",
          "त्रिकूटशिखरे रम्ये निर्मितां विश्वकर्मणा॥२॥",
          "ददर्श लङ्कां सुन्यस्तां रम्यकाननशोभिताम्।"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-40",
    "chapterName": "युद्धकाण्ड, सर्ग 40",
    "verseNumber": 2
  },
  {
    "id": "valmiki-ramayana-6-sarga-40-shlok-4",
    "collectionId": "valmiki-ramayana",
    "index": 12436,
    "titleDevanagari": "वाल्मीकि रामायण, युद्धकाण्ड, सर्ग 40, श्लोक 4",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-6-sarga-40-shlok-4",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "तस्य गोपुरशृङ्गस्थं राक्षसेन्द्रं दुरासदम्॥३॥",
          "श्वेतचामरपर्यन्तं विजयच्छत्रशोभितम्।",
          "रक्तचन्दनसंलिप्तं रत्नाभरणभूषितम्॥४॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-40",
    "chapterName": "युद्धकाण्ड, सर्ग 40",
    "verseNumber": 4
  },
  {
    "id": "valmiki-ramayana-6-sarga-40-shlok-5",
