    "slug": "valmiki-ramayana-6-sarga-40-shlok-14",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "परस्परं स्वेदविदिग्धगात्रौ परस्परं शोणितरक्तदेहौ।",
          "परस्परं श्लिष्टनिरुद्धचेष्टौ परस्परं शाल्मलिकिंशुकाविव॥१४॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-40",
    "chapterName": "युद्धकाण्ड, सर्ग 40",
    "verseNumber": 14
  },
  {
