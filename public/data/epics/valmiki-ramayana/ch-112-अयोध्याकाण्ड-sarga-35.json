    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "यन्महेन्द्रमिवाजय्यं दुष्प्रकम्प्यमिवाचलम्।",
          "महोदधिमिवाक्षोभ्यं संतापयसि कर्मभिः॥७॥"
        ]
      }
    ],
    "chapterId": "अयोध्याकाण्ड-sarga-35",
    "chapterName": "अयोध्याकाण्ड, सर्ग 35",
    "verseNumber": 7
  },
