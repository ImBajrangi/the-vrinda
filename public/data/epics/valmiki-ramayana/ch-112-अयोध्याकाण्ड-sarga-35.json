    "slug": "valmiki-ramayana-2-sarga-35-shlok-4",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "वाक्यवज्ररनुपमैर्निर्भिन्दन्निव चाशुभैः।",
          "कैकेय्याः सर्वमर्माणि सुमन्त्रः प्रत्यभाषत॥४॥"
        ]
      }
    ],
    "chapterId": "अयोध्याकाण्ड-sarga-35",
    "chapterName": "अयोध्याकाण्ड, सर्ग 35",
    "verseNumber": 4
  },
  {
