[
  {
    "id": "valmiki-ramayana-3-sarga-27-shlok-1",
    "collectionId": "valmiki-ramayana",
    "index": 7487,
    "titleDevanagari": "वाल्मीकि रामायण, अरण्यकाण्ड, सर्ग 27, श्लोक 1",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-27-shlok-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "खरं तु रामाभिमुखं प्रयान्तं वाहिनीपतिः।",
          "राक्षसस्त्रिशिरा नाम संनिपत्येदमब्रवीत्॥१॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-27",
    "chapterName": "अरण्यकाण्ड, सर्ग 27",
    "verseNumber": 1
  },
  {
    "id": "valmiki-ramayana-3-sarga-27-shlok-2",
    "collectionId": "valmiki-ramayana",
    "index": 7488,
    "titleDevanagari": "वाल्मीकि रामायण, अरण्यकाण्ड, सर्ग 27, श्लोक 2",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-27-shlok-2",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "मां नियोजय विक्रान्तं त्वं निवर्तस्व साहसात्।",
          "पश्य रामं महाबाहं संयुगे विनिपातितम्॥२॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-27",
    "chapterName": "अरण्यकाण्ड, सर्ग 27",
    "verseNumber": 2
  },
  {
    "id": "valmiki-ramayana-3-sarga-27-shlok-3",
    "collectionId": "valmiki-ramayana",
    "index": 7489,
    "titleDevanagari": "वाल्मीकि रामायण, अरण्यकाण्ड, सर्ग 27, श्लोक 3",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-27-shlok-3",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "प्रतिजानामि ते सत्यमायुधं चाहमालभे।",
          "यथा रामं वधिष्यामि वधार्ह सर्वरक्षसाम्॥३॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-27",
    "chapterName": "अरण्यकाण्ड, सर्ग 27",
    "verseNumber": 3
  },
  {
    "id": "valmiki-ramayana-3-sarga-27-shlok-4",
    "collectionId": "valmiki-ramayana",
    "index": 7490,
    "titleDevanagari": "वाल्मीकि रामायण, अरण्यकाण्ड, सर्ग 27, श्लोक 4",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-27-shlok-4",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "अहं वास्य रणे मृत्युरेष वा समरे मम।",
          "विनिवर्त्य रणोत्साहं मुहूर्तं प्राश्निको भव॥४॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-27",
    "chapterName": "अरण्यकाण्ड, सर्ग 27",
    "verseNumber": 4
  },
  {
    "id": "valmiki-ramayana-3-sarga-27-shlok-5",
    "collectionId": "valmiki-ramayana",
    "index": 7491,
    "titleDevanagari": "वाल्मीकि रामायण, अरण्यकाण्ड, सर्ग 27, श्लोक 5",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-27-shlok-5",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "प्रहृष्टो वा हते रामे जनस्थानं प्रयास्यसि।",
          "मयि वा निहते रामं संयुगाय प्रयास्यसि॥५॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-27",
    "chapterName": "अरण्यकाण्ड, सर्ग 27",
    "verseNumber": 5
  },
  {
    "id": "valmiki-ramayana-3-sarga-27-shlok-6",
    "collectionId": "valmiki-ramayana",
    "index": 7492,
    "titleDevanagari": "वाल्मीकि रामायण, अरण्यकाण्ड, सर्ग 27, श्लोक 6",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-27-shlok-6",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "खरस्त्रिशिरसा तेन मृत्युलोभात् प्रसादितः।",
          "गच्छ युध्येत्यनुज्ञातो राघवाभिमुखो ययौ॥६॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-27",
    "chapterName": "अरण्यकाण्ड, सर्ग 27",
    "verseNumber": 6
  },
  {
    "id": "valmiki-ramayana-3-sarga-27-shlok-7",
    "collectionId": "valmiki-ramayana",
    "index": 7493,
    "titleDevanagari": "वाल्मीकि रामायण, अरण्यकाण्ड, सर्ग 27, श्लोक 7",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-27-shlok-7",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "त्रिशिरास्तु रथेनैव वाजियुक्तेन भास्वता।",
          "अभ्यद्रवद् रणे रामं त्रिशृङ्ग इव पर्वतः॥७॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-27",
    "chapterName": "अरण्यकाण्ड, सर्ग 27",
    "verseNumber": 7
  },
  {
    "id": "valmiki-ramayana-3-sarga-27-shlok-8",
    "collectionId": "valmiki-ramayana",
    "index": 7494,
    "titleDevanagari": "वाल्मीकि रामायण, अरण्यकाण्ड, सर्ग 27, श्लोक 8",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-27-shlok-8",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "शरधारासमूहान् स महामेघ इवोत्सृजन्।।",
          "व्यसृजत् सदृशं नादं जलार्द्रस्येव दुन्दुभेः॥८॥",
          "आगच्छन्तं त्रिशिरसं राक्षसं प्रेक्ष्य राघवः।",
          "धनुषा प्रतिजग्राह विधुन्वन् सायकान् शितान्॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-27",
    "chapterName": "अरण्यकाण्ड, सर्ग 27",
    "verseNumber": 8
  },
  {
    "id": "valmiki-ramayana-3-sarga-27-shlok-10",
    "collectionId": "valmiki-ramayana",
    "index": 7495,
    "titleDevanagari": "वाल्मीकि रामायण, अरण्यकाण्ड, सर्ग 27, श्लोक 10",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-27-shlok-10",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "स सम्प्रहारस्तुमुलो रामत्रिशिरसोस्तदा।",
          "सम्बभूवातिबलिनोः सिंहकुञ्जरयोरिव॥१०॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-27",
    "chapterName": "अरण्यकाण्ड, सर्ग 27",
    "verseNumber": 10
  },
  {
    "id": "valmiki-ramayana-3-sarga-27-shlok-11",
    "collectionId": "valmiki-ramayana",
    "index": 7496,
    "titleDevanagari": "वाल्मीकि रामायण, अरण्यकाण्ड, सर्ग 27, श्लोक 11",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-27-shlok-11",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "ततस्त्रिशिरसा बाणैर्ललाटे ताडितस्त्रिभिः।",
          "अमर्षी कुपितो रामः संरब्ध इदमब्रवीत्॥११॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-27",
    "chapterName": "अरण्यकाण्ड, सर्ग 27",
    "verseNumber": 11
  },
  {
    "id": "valmiki-ramayana-3-sarga-27-shlok-12",
    "collectionId": "valmiki-ramayana",
    "index": 7497,
    "titleDevanagari": "वाल्मीकि रामायण, अरण्यकाण्ड, सर्ग 27, श्लोक 12",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-27-shlok-12",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "अहो विक्रमशूरस्य राक्षसस्येदृशं बलम्।",
          "पुष्पैरिव शरैर्योऽहं ललाटेऽस्मि परिक्षतः॥१२॥",
          "ममापि प्रतिगृह्णीष्व शरांश्चापगुणाच्च्युतान्।",
          "एवमुक्त्वा सुसंरब्धः शरानाशीविषोपमान्॥ १३॥",
          "त्रिशिरोवक्षसि क्रुद्धो निजघान चतुर्दश।"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-27",
    "chapterName": "अरण्यकाण्ड, सर्ग 27",
    "verseNumber": 12
  },
  {
    "id": "valmiki-ramayana-3-sarga-27-shlok-15",
    "collectionId": "valmiki-ramayana",
    "index": 7498,
    "titleDevanagari": "वाल्मीकि रामायण, अरण्यकाण्ड, सर्ग 27, श्लोक 15",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-27-shlok-15",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "चतुर्भिस्तुरगानस्य शरैः संनतपर्वभिः॥१४॥",
          "न्यपातयत तेजस्वी चतुरस्तस्य वाजिनः।",
          "अष्टभिः सायकैः सूतं रथोपस्थे न्यपातयत्॥ १५॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-27",
    "chapterName": "अरण्यकाण्ड, सर्ग 27",
    "verseNumber": 15
  },
  {
    "id": "valmiki-ramayana-3-sarga-27-shlok-16",
    "collectionId": "valmiki-ramayana",
    "index": 7499,
    "titleDevanagari": "वाल्मीकि रामायण, अरण्यकाण्ड, सर्ग 27, श्लोक 16",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-27-shlok-16",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "रामश्चिच्छेद बाणेन ध्वजं चास्य समुच्छ्रितम्।",
          "ततो हतरथात् तस्मादुत्पतन्तं निशाचरम्॥१६॥",
          "चिच्छेद रामस्तं बाणैर्हृदये सोऽभवज्जडः।"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-27",
    "chapterName": "अरण्यकाण्ड, सर्ग 27",
    "verseNumber": 16
  },
  {
    "id": "valmiki-ramayana-3-sarga-27-shlok-17",
    "collectionId": "valmiki-ramayana",
    "index": 7500,
    "titleDevanagari": "वाल्मीकि रामायण, अरण्यकाण्ड, सर्ग 27, श्लोक 17",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-27-shlok-17",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "सायकैश्चाप्रमेयात्मा सामर्षस्तस्य रक्षसः॥१७॥",
          "शिरांस्यपातयत् त्रीणि वेगवद्भिस्त्रिभिः शरैः।",
          "स धूमशोणितोद्गारी रामबाणाभिपीडितः॥ १८॥",
          "न्यपतत् पतितैः पूर्वं समरस्थो निशाचरः।"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-27",
    "chapterName": "अरण्यकाण्ड, सर्ग 27",
    "verseNumber": 17
  },
  {
    "id": "valmiki-ramayana-3-sarga-27-shlok-19",
