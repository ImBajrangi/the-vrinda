    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "तदप्रियममित्रघ्नो वचनं मरणोपमम।",
          "श्रुत्वा न विव्यथे रामः कैकेयीं चेदमब्रवीत्॥१॥"
        ]
      }
