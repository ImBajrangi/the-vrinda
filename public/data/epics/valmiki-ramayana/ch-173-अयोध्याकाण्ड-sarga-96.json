    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "तां तदा दर्शयित्वा तु मैथिली गिरिनिम्नगाम्।",
          "निषसाद गिरिप्रस्थे सीतां मांसेन छन्दयन्॥१॥"
        ]
      }
    ],
    "chapterId": "अयोध्याकाण्ड-sarga-96",
    "chapterName": "अयोध्याकाण्ड, सर्ग 96",
