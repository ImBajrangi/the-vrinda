    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-69-shlok-18",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "राजा च राघवौ पुत्रौ निशाम्य परिहर्षितः॥१८॥",
          "उवास परमप्रीतो जनकेनाभिपूजितः।"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-69",
    "chapterName": "बालकाण्ड, सर्ग 69",
