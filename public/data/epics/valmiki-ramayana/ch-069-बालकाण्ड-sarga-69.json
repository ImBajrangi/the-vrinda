    "slug": "valmiki-ramayana-1-sarga-69-shlok-19",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "जनकोऽपि महातेजाः क्रिया धर्मेण तत्त्ववित्।",
          "यज्ञस्य च सुताभ्यां च कृत्वा रात्रिमुवास ह॥ १९॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-69",
