[
  {
    "id": "valmiki-ramayana-1-sarga-69-shlok-1",
    "collectionId": "valmiki-ramayana",
    "index": 2801,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 69, श्लोक 1",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-69-shlok-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "ततो रात्र्यां व्यतीतायां सोपाध्यायः सबान्धवः।",
          "राजा दशरथो हृष्टः सुमन्त्रमिदमब्रवीत्॥१॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-69",
    "chapterName": "बालकाण्ड, सर्ग 69",
    "verseNumber": 1
  },
  {
    "id": "valmiki-ramayana-1-sarga-69-shlok-2",
    "collectionId": "valmiki-ramayana",
    "index": 2802,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 69, श्लोक 2",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-69-shlok-2",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "अद्य सर्वे धनाध्यक्षा धनमादाय पुष्कलम्।",
          "व्रजन्त्वग्रे सुविहिता नानारत्नसमन्विताः॥२॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-69",
    "chapterName": "बालकाण्ड, सर्ग 69",
    "verseNumber": 2
  },
  {
    "id": "valmiki-ramayana-1-sarga-69-shlok-3",
    "collectionId": "valmiki-ramayana",
    "index": 2803,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 69, श्लोक 3",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-69-shlok-3",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "चतुरंगबलं चापि शीघ्रं निर्यातु सर्वशः।",
          "ममाज्ञासमकालं च यानं युग्यमनुत्तमम्॥३॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-69",
    "chapterName": "बालकाण्ड, सर्ग 69",
    "verseNumber": 3
  },
  {
    "id": "valmiki-ramayana-1-sarga-69-shlok-5",
    "collectionId": "valmiki-ramayana",
    "index": 2804,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 69, श्लोक 5",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-69-shlok-5",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "वसिष्ठो वामदेवश्च जाबालिरथ कश्यपः।",
          "मार्कण्डेयस्तु दीर्घायुर्ऋषिः कात्यायनस्तथा ॥४॥",
          "एते द्विजाः प्रयान्त्वग्रे स्यन्दनं योजयस्व मे।",
          "यथा कालात्ययो न स्याद् दूता हि त्वरयन्ति माम्॥५॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-69",
    "chapterName": "बालकाण्ड, सर्ग 69",
    "verseNumber": 5
  },
  {
    "id": "valmiki-ramayana-1-sarga-69-shlok-6",
    "collectionId": "valmiki-ramayana",
    "index": 2805,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 69, श्लोक 6",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-69-shlok-6",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "वचनाच्च नरेन्द्रस्य सेना च चतुरंगिणी।",
          "राजानमृषिभिः सार्धं व्रजन्तं पृष्ठतोऽन्वयात्॥६॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-69",
    "chapterName": "बालकाण्ड, सर्ग 69",
    "verseNumber": 6
  },
  {
    "id": "valmiki-ramayana-1-sarga-69-shlok-7",
    "collectionId": "valmiki-ramayana",
    "index": 2806,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 69, श्लोक 7",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-69-shlok-7",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "गत्वा चतुरहं मार्गं विदेहानभ्युपेयिवान्।",
          "राजा च जनकः श्रीमान् श्रुत्वा पूजामकल्पयत्॥ ७॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-69",
    "chapterName": "बालकाण्ड, सर्ग 69",
    "verseNumber": 7
  },
  {
    "id": "valmiki-ramayana-1-sarga-69-shlok-8",
    "collectionId": "valmiki-ramayana",
    "index": 2807,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 69, श्लोक 8",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-69-shlok-8",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "ततो राजानमासाद्य वृद्धं दशरथं नृपम्।",
          "मुदितो जनको राजा प्रहर्षं परमं ययौ॥८॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-69",
    "chapterName": "बालकाण्ड, सर्ग 69",
    "verseNumber": 8
  },
  {
    "id": "valmiki-ramayana-1-sarga-69-shlok-9",
    "collectionId": "valmiki-ramayana",
    "index": 2808,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 69, श्लोक 9",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-69-shlok-9",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "उवाच वचनं श्रेष्ठो नरश्रेष्ठं मुदान्वितम्।",
          "स्वागतं ते नरश्रेष्ठ दिष्ट्या प्राप्तोऽसि राघव॥९॥",
          "पुत्रयोरुभयोः प्रीतिं लप्स्यसे वीर्यनिर्जिताम्।",
          "दिष्ट्या प्राप्तो महातेजा वसिष्ठो भगवानृषिः॥ १०॥",
          "सह सर्वैर्द्धिजश्रेष्ठैर्देवैरिव शतक्रतुः।"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-69",
    "chapterName": "बालकाण्ड, सर्ग 69",
    "verseNumber": 9
  },
  {
    "id": "valmiki-ramayana-1-sarga-69-shlok-11",
    "collectionId": "valmiki-ramayana",
    "index": 2809,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 69, श्लोक 11",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-69-shlok-11",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "दिष्ट्या मे निर्जिता विघ्ना दिष्ट्या मे पूजितं कुलम्॥११॥",
          "राघवैः सह सम्बन्धाद् वीर्यश्रेष्ठैर्महाबलैः।"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-69",
    "chapterName": "बालकाण्ड, सर्ग 69",
    "verseNumber": 11
  },
  {
    "id": "valmiki-ramayana-1-sarga-69-shlok-12",
    "collectionId": "valmiki-ramayana",
    "index": 2810,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 69, श्लोक 12",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-69-shlok-12",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "श्वः प्रभाते नरेन्द्र त्वं संवर्तयितुमर्हसि॥१२॥",
          "यज्ञस्यान्ते नरश्रेष्ठ विवाहमृषिसत्तमैः।",
          "तस्य तद् वचनं श्रुत्वा ऋषिमध्ये नराधिपः॥ १३॥",
          "वाक्यं वाक्यविदां श्रेष्ठः प्रत्युवाच महीपतिम्।"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-69",
    "chapterName": "बालकाण्ड, सर्ग 69",
    "verseNumber": 12
  },
  {
    "id": "valmiki-ramayana-1-sarga-69-shlok-14",
    "collectionId": "valmiki-ramayana",
    "index": 2811,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 69, श्लोक 14",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-69-shlok-14",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "प्रतिग्रहो दातृवशः श्रुतमेतन्मया पुरा॥१४॥",
          "यथा वक्ष्यसि धर्मज्ञ तत् करिष्यामहे वयम्।"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-69",
    "chapterName": "बालकाण्ड, सर्ग 69",
    "verseNumber": 14
  },
  {
