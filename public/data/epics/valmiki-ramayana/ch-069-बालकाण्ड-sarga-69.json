    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-69-shlok-15",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "तद् धर्मिष्ठं यशस्यं च वचनं सत्यवादिनः॥१५॥",
          "श्रुत्वा विदेहाधिपतिः परं विस्मयमागतः।"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-69",
    "chapterName": "बालकाण्ड, सर्ग 69",
    "verseNumber": 15
  },
  {
    "id": "valmiki-ramayana-1-sarga-69-shlok-16",
    "collectionId": "valmiki-ramayana",
    "index": 2813,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 69, श्लोक 16",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-69-shlok-16",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "ततः सर्वे मुनिगणाः परस्परसमागमे॥१६॥",
          "हर्षेण महता युक्तास्तां रात्रिमवसन् सुखम्।",
          "अथ रामो महातेजा लक्ष्मणेन समं ययौ॥ १७॥",
          "विश्वामित्रं पुरस्कृत्य पितुः पादावुपस्पृशन्।"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-69",
    "chapterName": "बालकाण्ड, सर्ग 69",
    "verseNumber": 16
  },
  {
    "id": "valmiki-ramayana-1-sarga-69-shlok-18",
    "collectionId": "valmiki-ramayana",
