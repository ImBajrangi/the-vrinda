    "slug": "valmiki-ramayana-2-sarga-28-shlok-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "स एवं ब्रुवतीं सीतां धर्मज्ञां धर्मवत्सलः।",
          "न नेतुं कुरुते बुद्धिं वने दुःखानि चिन्तयन्॥१॥"
        ]
      }
    ],
    "chapterId": "अयोध्याकाण्ड-sarga-28",
    "chapterName": "अयोध्याकाण्ड, सर्ग 28",
    "verseNumber": 1
  },
  {
    "id": "valmiki-ramayana-2-sarga-28-shlok-2",
