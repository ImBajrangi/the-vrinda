    "slug": "valmiki-ramayana-6-sarga-13-shlok-2",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "यः खल्वपि वनं प्राप्य मृगव्यालनिषेवितम्।",
          "न पिबेन्मधु सम्प्राप्य स नरो बालिशो भवेत्॥२॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-13",
    "chapterName": "युद्धकाण्ड, सर्ग 13",
    "verseNumber": 2
  },
  {
