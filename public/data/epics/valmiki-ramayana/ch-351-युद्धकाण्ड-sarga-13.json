    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "रावणं क्रुद्धमाज्ञाय महापावो महाबलः।",
          "मुहूर्तमनुसंचिन्त्य प्राञ्जलिर्वाक्यमब्रवीत्॥१॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-13",
    "chapterName": "युद्धकाण्ड, सर्ग 13",
    "verseNumber": 1
  },
  {
