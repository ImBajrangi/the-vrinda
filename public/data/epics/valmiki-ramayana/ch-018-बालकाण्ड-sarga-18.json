    "slug": "valmiki-ramayana-1-sarga-18-shlok-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "प्रविष्टायां हुताशं तु वेदवत्यां स रावणः।",
          "पुष्पकं तु समारुह्य परिचक्राम मेदिनीम्॥१॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-18",
    "chapterName": "बालकाण्ड, सर्ग 18",
    "verseNumber": 1
  },
  {
    "id": "valmiki-ramayana-1-sarga-18-shlok-2",
