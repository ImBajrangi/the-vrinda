    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "अन्वेष्वपि गतेष्वेवं देवेष्वरिनिषूदन।",
          "रावणः प्राविशद् यज्ञं सारमेय इवाशुचिः॥६॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-18",
    "chapterName": "बालकाण्ड, सर्ग 18",
    "verseNumber": 6
  },
