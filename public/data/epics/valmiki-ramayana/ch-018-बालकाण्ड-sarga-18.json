    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "तं च राजानमासाद्य रावणो राक्षसाधिपः।",
          "प्राह युद्धं प्रयच्छेति निर्जितोऽस्मीति वा वद॥७॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-18",
    "chapterName": "बालकाण्ड, सर्ग 18",
    "verseNumber": 7
  },
