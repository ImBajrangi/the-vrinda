    "slug": "valmiki-ramayana-1-sarga-47-shlok-2",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "ते सरांसि सरित्कक्षानाकाशं नगराणि च।",
          "नदीदुर्गास्तथा देशान् विचिन्वन्ति समन्ततः॥२॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-47",
    "chapterName": "बालकाण्ड, सर्ग 47",
    "verseNumber": 2
  },
  {
