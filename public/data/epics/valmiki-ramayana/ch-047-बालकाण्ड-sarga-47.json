          "समायान्ति स्म मेदिन्यां निशाकालेषु वानराः॥४॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-47",
    "chapterName": "बालकाण्ड, सर्ग 47",
    "verseNumber": 4
  },
