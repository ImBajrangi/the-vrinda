    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "दर्शनार्थं तु वैदेह्याः सर्वतः कपिकुञ्जराः।",
          "व्यादिष्टाः कपिराजेन यथोक्तं जग्मुरञ्जसा॥१॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-47",
    "chapterName": "बालकाण्ड, सर्ग 47",
    "verseNumber": 1
  },
  {
