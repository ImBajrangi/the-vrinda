    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-5-sarga-31-shlok-14",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "अहं सम्पातिवचनाच्छतयोजनमायतम्॥१४॥",
          "तस्या हेतोर्विशालाक्ष्याः समुद्रं वेगवान् प्लुतः।"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-31",
    "chapterName": "सुन्दरकाण्ड, सर्ग 31",
    "verseNumber": 14
  },
  {
    "id": "valmiki-ramayana-5-sarga-31-shlok-16",
