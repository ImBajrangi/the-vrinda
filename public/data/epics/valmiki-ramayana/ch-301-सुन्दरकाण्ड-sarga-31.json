    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-5-sarga-31-shlok-13",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "सुग्रीवेणाभिसंदिष्टा हरयः कामरूपिणः॥१३॥",
          "दिक्षु सर्वासु तां देवीं विचिन्वन्तः सहस्रशः।"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-31",
    "chapterName": "सुन्दरकाण्ड, सर्ग 31",
    "verseNumber": 13
  },
  {
