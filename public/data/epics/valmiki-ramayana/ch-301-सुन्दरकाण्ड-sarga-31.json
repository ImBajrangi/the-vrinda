    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-5-sarga-31-shlok-17",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "जानकी चापि तच्छ्रुत्वा विस्मयं परमं गता।",
          "ततः सा वक्रकेशान्ता सुकेशी केशसंवृतम्।",
          "उन्नम्य वदनं भीरुः शिंशपामन्ववैक्षत॥१७॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-31",
    "chapterName": "सुन्दरकाण्ड, सर्ग 31",
    "verseNumber": 17
  },
