    "titleDevanagari": "वाल्मीकि रामायण, सुन्दरकाण्ड, सर्ग 31, श्लोक 1",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-5-sarga-31-shlok-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "एवं बहुविधां चिन्तां चिन्तयित्वा महामतिः।",
          "संश्रवे मधुरं वाक्यं वैदेह्या व्याजहार ह॥१॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-31",
    "chapterName": "सुन्दरकाण्ड, सर्ग 31",
    "verseNumber": 1
  },
  {
    "id": "valmiki-ramayana-5-sarga-31-shlok-2",
    "collectionId": "valmiki-ramayana",
    "index": 9913,
    "titleDevanagari": "वाल्मीकि रामायण, सुन्दरकाण्ड, सर्ग 31, श्लोक 2",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-5-sarga-31-shlok-2",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "राजा दशरथो नाम रथकुञ्जरवाजिमान्।",
          "पुण्यशीलो महाकीर्तिरिक्ष्वाकूणां महायशाः॥२॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-31",
    "chapterName": "सुन्दरकाण्ड, सर्ग 31",
    "verseNumber": 2
  },
  {
    "id": "valmiki-ramayana-5-sarga-31-shlok-3",
    "collectionId": "valmiki-ramayana",
    "index": 9914,
    "titleDevanagari": "वाल्मीकि रामायण, सुन्दरकाण्ड, सर्ग 31, श्लोक 3",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-5-sarga-31-shlok-3",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "राजर्षीणां गुणश्रेष्ठस्तपसा चर्षिभिः समः।",
          "चक्रवर्तिकुले जातः पुरंदरसमो बले॥३॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-31",
    "chapterName": "सुन्दरकाण्ड, सर्ग 31",
    "verseNumber": 3
  },
  {
    "id": "valmiki-ramayana-5-sarga-31-shlok-5",
    "collectionId": "valmiki-ramayana",
    "index": 9915,
    "titleDevanagari": "वाल्मीकि रामायण, सुन्दरकाण्ड, सर्ग 31, श्लोक 5",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-5-sarga-31-shlok-5",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "अहिंसारतिरक्षुद्रो घृणी सत्यपराक्रमः।",
          "मुख्यस्येक्ष्वाकुवंशस्य लक्ष्मीवॉल्लक्ष्मिवर्धनः॥४॥",
          "पार्थिवव्यञ्जनैर्युक्तः पृथुश्रीः पार्थिवर्षभः।",
          "पृथिव्यां चतुरन्तायां विश्रुतः सुखदः सुखी॥५॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-31",
    "chapterName": "सुन्दरकाण्ड, सर्ग 31",
    "verseNumber": 5
  },
  {
    "id": "valmiki-ramayana-5-sarga-31-shlok-6",
    "collectionId": "valmiki-ramayana",
    "index": 9916,
    "titleDevanagari": "वाल्मीकि रामायण, सुन्दरकाण्ड, सर्ग 31, श्लोक 6",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-5-sarga-31-shlok-6",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "तस्य पुत्रः प्रियो ज्येष्ठस्ताराधिपनिभाननः।",
          "रामो नाम विशेषज्ञः श्रेष्ठः सर्वधनुष्मताम्॥६॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-31",
    "chapterName": "सुन्दरकाण्ड, सर्ग 31",
    "verseNumber": 6
  },
  {
    "id": "valmiki-ramayana-5-sarga-31-shlok-7",
    "collectionId": "valmiki-ramayana",
    "index": 9917,
    "titleDevanagari": "वाल्मीकि रामायण, सुन्दरकाण्ड, सर्ग 31, श्लोक 7",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-5-sarga-31-shlok-7",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "रक्षिता स्वस्य वृत्तस्य स्वजनस्यापि रक्षिता।",
          "रक्षिता जीवलोकस्य धर्मस्य च परंतपः॥७॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-31",
    "chapterName": "सुन्दरकाण्ड, सर्ग 31",
    "verseNumber": 7
  },
  {
    "id": "valmiki-ramayana-5-sarga-31-shlok-8",
    "collectionId": "valmiki-ramayana",
    "index": 9918,
    "titleDevanagari": "वाल्मीकि रामायण, सुन्दरकाण्ड, सर्ग 31, श्लोक 8",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-5-sarga-31-shlok-8",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "तस्य सत्याभिसंधस्य वृद्धस्य वचनात् पितुः।",
          "सभार्यः सह च भ्रात्रा वीरः प्रव्रजितो वनम्॥८॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-31",
    "chapterName": "सुन्दरकाण्ड, सर्ग 31",
    "verseNumber": 8
  },
  {
    "id": "valmiki-ramayana-5-sarga-31-shlok-9",
    "collectionId": "valmiki-ramayana",
    "index": 9919,
    "titleDevanagari": "वाल्मीकि रामायण, सुन्दरकाण्ड, सर्ग 31, श्लोक 9",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-5-sarga-31-shlok-9",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "तेन तत्र महारण्ये मृगयां परिधावता।",
          "राक्षसा निहताः शूरा बहवः कामरूपिणः॥९॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-31",
    "chapterName": "सुन्दरकाण्ड, सर्ग 31",
    "verseNumber": 9
  },
  {
    "id": "valmiki-ramayana-5-sarga-31-shlok-10",
    "collectionId": "valmiki-ramayana",
    "index": 9920,
    "titleDevanagari": "वाल्मीकि रामायण, सुन्दरकाण्ड, सर्ग 31, श्लोक 10",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-5-sarga-31-shlok-10",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "जनस्थानवधं श्रुत्वा निहतौ खरदूषणौ।",
          "ततस्त्वमर्षापहृता जानकी रावणेन तु॥१०॥",
          "वञ्चयित्वा वने रामं मृगरूपेण मायया।",
          "स मार्गमाणस्तां देवीं रामः सीतामनिन्दिताम्॥",
          "आससाद वने मित्रं सुग्रीवं नाम वानरम्।"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-31",
    "chapterName": "सुन्दरकाण्ड, सर्ग 31",
    "verseNumber": 10
  },
  {
    "id": "valmiki-ramayana-5-sarga-31-shlok-12",
    "collectionId": "valmiki-ramayana",
    "index": 9921,
    "titleDevanagari": "वाल्मीकि रामायण, सुन्दरकाण्ड, सर्ग 31, श्लोक 12",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-5-sarga-31-shlok-12",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "ततः स वालिनं हत्वा रामः परपुरंजयः॥१२॥",
          "आयच्छत् कपिराज्यं तु सुग्रीवाय महात्मने।"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-31",
    "chapterName": "सुन्दरकाण्ड, सर्ग 31",
    "verseNumber": 12
  },
  {
