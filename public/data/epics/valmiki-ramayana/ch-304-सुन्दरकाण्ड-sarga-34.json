    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "अहं रामस्य संदेशाद् देवि दूतस्तवागतः।",
          "वैदेहि कुशली रामः स त्वां कौशलमब्रवीत्॥२॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-34",
    "chapterName": "सुन्दरकाण्ड, सर्ग 34",
    "verseNumber": 2
  },
  {
