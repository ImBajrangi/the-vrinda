    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "यो ब्राह्ममस्त्रं वेदांश्च वेद वेदविदां वरः।",
          "स त्वां दाशरथी रामो देवि कौशलमब्रवीत्॥३॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-34",
    "chapterName": "सुन्दरकाण्ड, सर्ग 34",
    "verseNumber": 3
  },
