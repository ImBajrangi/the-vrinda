    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "गृहे गृहे रुदत्यश्च भर्तारं गृहमागतम्।",
          "व्यगर्हयन्त दुःखार्ता वाग्भिस्तोत्नैरिव द्विपान्॥ ६॥"
        ]
      }
    ],
    "chapterId": "अयोध्याकाण्ड-sarga-48",
    "chapterName": "अयोध्याकाण्ड, सर्ग 48",
    "verseNumber": 6
  },
  {
