        "stanzaNumber": 1,
        "linesDevanagari": [
          "शोभयिष्यन्ति काकुत्स्थमटव्यो रम्यकाननाः।",
          "आपगाश्च महानूपाः सानुमन्तश्च पर्वताः॥१०॥"
        ]
      }
    ],
    "chapterId": "अयोध्याकाण्ड-sarga-48",
    "chapterName": "अयोध्याकाण्ड, सर्ग 48",
    "verseNumber": 10
  },
