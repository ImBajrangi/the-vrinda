    "slug": "valmiki-ramayana-2-sarga-48-shlok-7",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "किं नु तेषां",
          "गृहैः कार्यं किं दारैः किं धनेन वा।",
          "पुत्रैर्वापि सुखैर्वापि ये न पश्यन्ति राघवम्॥७॥"
        ]
      }
    ],
    "chapterId": "अयोध्याकाण्ड-sarga-48",
    "chapterName": "अयोध्याकाण्ड, सर्ग 48",
    "verseNumber": 7
  },
  {
