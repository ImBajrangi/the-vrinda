      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "नष्टं दृष्ट्वा नाभ्यनन्दन् विपुलं वा धनागमम्।",
          "पुत्रं प्रथमजं लब्ध्वा जननी नाप्यनन्दत॥५॥"
        ]
      }
    ],
    "chapterId": "अयोध्याकाण्ड-sarga-48",
    "chapterName": "अयोध्याकाण्ड, सर्ग 48",
    "verseNumber": 5
  },
  {
