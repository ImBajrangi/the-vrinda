    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-2-sarga-48-shlok-3",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "स्वं स्वं निलयमागम्य पुत्रदारैः समावृताः।",
          "अश्रूणि मुमुचुः सर्वे बाष्पेण पिहिताननाः॥३॥"
        ]
      }
    ],
    "chapterId": "अयोध्याकाण्ड-sarga-48",
    "chapterName": "अयोध्याकाण्ड, सर्ग 48",
    "verseNumber": 3
  },
