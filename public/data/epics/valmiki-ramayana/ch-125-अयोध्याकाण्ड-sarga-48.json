    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "न चाहृष्यन् न चामोदन् वणिजो न प्रसारयन्।",
          "न चाशोभन्त पण्यानि नापचन् गृहमेधिनः॥४॥"
        ]
      }
    ],
    "chapterId": "अयोध्याकाण्ड-sarga-48",
    "chapterName": "अयोध्याकाण्ड, सर्ग 48",
    "verseNumber": 4
  },
