    "slug": "valmiki-ramayana-6-sarga-56-shlok-2",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "क्रोधमूिर्च्छत तरूपस्तु धुन्वन् परमकार्मुकम्।",
          "दृष्ट्वा तु कर्म शत्रूणां सारथिं वाक्यमब्रवीत्॥२॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-56",
    "chapterName": "युद्धकाण्ड, सर्ग 56",
    "verseNumber": 2
  },
  {
