    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "तत्रैव तावत् त्वरितो रथं प्रापय सारथे।",
          "एते च बलिनो नन्ति सुबहून् राक्षसान् रणे॥३॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-56",
    "chapterName": "युद्धकाण्ड, सर्ग 56",
    "verseNumber": 3
  },
