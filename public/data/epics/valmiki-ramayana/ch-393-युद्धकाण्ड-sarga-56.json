    "slug": "valmiki-ramayana-6-sarga-56-shlok-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "तद् दृष्ट्वा सुमहत् कर्म कृतं वानरसत्तमैः।",
          "क्रोधमाहारयामास युधि तीव्रमकम्पनः॥१॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-56",
    "chapterName": "युद्धकाण्ड, सर्ग 56",
    "verseNumber": 1
  },
  {
