    "slug": "valmiki-ramayana-3-sarga-13-shlok-2",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "अध्वश्रमेण वां खेदो बाधते प्रचुरश्रमः।",
          "व्यक्तमुत्कण्ठते वापि मैथिली जनकात्मजा॥२॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-13",
    "chapterName": "अरण्यकाण्ड, सर्ग 13",
    "verseNumber": 2
  },
  {
