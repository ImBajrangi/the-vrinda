    "slug": "valmiki-ramayana-3-sarga-13-shlok-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "राम प्रीतोऽस्मि भद्रं ते परितुष्टोऽस्मि लक्ष्मण।",
          "अभिवादयितुं यन्मां प्राप्तौ स्थः सह सीतया॥ १॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-13",
    "chapterName": "अरण्यकाण्ड, सर्ग 13",
    "verseNumber": 1
  },
  {
