    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "आश्वासयन्तं भरतं जाबालिब्राह्मणोत्तमः।",
          "उवाच रामं धर्मज्ञं धर्मापेतमिदं वचः॥१॥"
        ]
      }
    ],
    "chapterId": "अयोध्याकाण्ड-sarga-108",
    "chapterName": "अयोध्याकाण्ड, सर्ग 108",
    "verseNumber": 1
  },
  {
