    "slug": "valmiki-ramayana-2-sarga-108-shlok-2",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "साधु राघव मा भूत् ते बुद्धिरेवं निरर्थिका।",
          "प्राकृतस्य नरस्येव ह्यार्यबुद्धेस्तपस्विनः॥२॥"
        ]
      }
    ],
    "chapterId": "अयोध्याकाण्ड-sarga-108",
    "chapterName": "अयोध्याकाण्ड, सर्ग 108",
    "verseNumber": 2
  },
