          "गङ्गायमुनयोः संधिमासाद्य मनुजर्षभौ।",
          "कालिन्दीमनुगच्छेतां नदी पश्चान्मुखाश्रिताम्॥ ४॥"
        ]
      }
    ],
    "chapterId": "अयोध्याकाण्ड-sarga-55",
    "chapterName": "अयोध्याकाण्ड, सर्ग 55",
    "verseNumber": 4
  },
  {
    "id": "valmiki-ramayana-2-sarga-55-shlok-5",
