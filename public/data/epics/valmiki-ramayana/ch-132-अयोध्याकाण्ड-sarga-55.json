    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "उषित्वा रजनीं तत्र राजपुत्रावरिंदमौ।",
          "महर्षिमभिवाद्याथ जग्मतुस्तं गिरिं प्रति॥१॥"
        ]
      }
    ],
    "chapterId": "अयोध्याकाण्ड-sarga-55",
    "chapterName": "अयोध्याकाण्ड, सर्ग 55",
    "verseNumber": 1
  },
  {
