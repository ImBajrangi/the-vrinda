    "slug": "valmiki-ramayana-3-sarga-52-shlok-23",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "सा हेमवर्णा नीलाऊं मैथिली राक्षसाधिपम्।",
          "शुशुभे काञ्चनी काञ्ची नीलं गजमिवाश्रिता॥ २३॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-52",
