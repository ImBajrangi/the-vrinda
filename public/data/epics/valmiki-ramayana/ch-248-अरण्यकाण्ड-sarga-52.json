    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "तप्ताभरणवर्णाङ्गी पीतकौशेयवासिनी।",
          "रराज राजपुत्री तु विद्युत्सौदामनी यथा॥१४॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-52",
    "chapterName": "अरण्यकाण्ड, सर्ग 52",
    "verseNumber": 14
  },
