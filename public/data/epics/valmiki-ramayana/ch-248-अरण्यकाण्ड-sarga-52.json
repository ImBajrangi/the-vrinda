    "titleDevanagari": "वाल्मीकि रामायण, अरण्यकाण्ड, सर्ग 52, श्लोक 1",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-52-shlok-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "सा तु ताराधिपमुखी रावणेन निरीक्ष्य तम्।",
          "गृध्रराजं विनिहतं विललाप सुदुःखिता॥१॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-52",
    "chapterName": "अरण्यकाण्ड, सर्ग 52",
    "verseNumber": 1
  },
  {
    "id": "valmiki-ramayana-3-sarga-52-shlok-2",
    "collectionId": "valmiki-ramayana",
    "index": 8176,
    "titleDevanagari": "वाल्मीकि रामायण, अरण्यकाण्ड, सर्ग 52, श्लोक 2",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-52-shlok-2",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "निमित्तं लक्षणं स्वप्नं शकुनिस्वरदर्शनम्।",
          "अवश्यं सुखदुःखेषु नराणां परिदृश्यते॥२॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-52",
    "chapterName": "अरण्यकाण्ड, सर्ग 52",
    "verseNumber": 2
  },
  {
    "id": "valmiki-ramayana-3-sarga-52-shlok-3",
    "collectionId": "valmiki-ramayana",
    "index": 8177,
    "titleDevanagari": "वाल्मीकि रामायण, अरण्यकाण्ड, सर्ग 52, श्लोक 3",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-52-shlok-3",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "न नूनं राम जानासि महद्व्यसनमात्मनः।।",
          "धावन्ति नूनं काकुत्स्थ मदर्थं मृगपक्षिणः॥३॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-52",
    "chapterName": "अरण्यकाण्ड, सर्ग 52",
    "verseNumber": 3
  },
  {
    "id": "valmiki-ramayana-3-sarga-52-shlok-4",
    "collectionId": "valmiki-ramayana",
    "index": 8178,
    "titleDevanagari": "वाल्मीकि रामायण, अरण्यकाण्ड, सर्ग 52, श्लोक 4",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-52-shlok-4",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "अयं हि कृपया राम मां त्रातुमिह संगतः।",
          "शेते विनिहतो भूमौ ममाभाग्याद् विहंगमः॥४॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-52",
    "chapterName": "अरण्यकाण्ड, सर्ग 52",
    "verseNumber": 4
  },
  {
    "id": "valmiki-ramayana-3-sarga-52-shlok-5",
    "collectionId": "valmiki-ramayana",
    "index": 8179,
    "titleDevanagari": "वाल्मीकि रामायण, अरण्यकाण्ड, सर्ग 52, श्लोक 5",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-52-shlok-5",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "त्राहि मामद्य काकुत्स्थ लक्ष्मणेति वराङ्गना।",
          "सुसंत्रस्ता समाक्रन्दच्छृण्वतां तु यथान्तिके॥५॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-52",
    "chapterName": "अरण्यकाण्ड, सर्ग 52",
    "verseNumber": 5
  },
  {
    "id": "valmiki-ramayana-3-sarga-52-shlok-6",
    "collectionId": "valmiki-ramayana",
    "index": 8180,
    "titleDevanagari": "वाल्मीकि रामायण, अरण्यकाण्ड, सर्ग 52, श्लोक 6",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-52-shlok-6",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "तां क्लिष्टमाल्याभरणां विलपन्तीमनाथवत्।",
          "अभ्यधावत वैदेहीं रावणो राक्षसाधिपः॥६॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-52",
    "chapterName": "अरण्यकाण्ड, सर्ग 52",
    "verseNumber": 6
  },
  {
    "id": "valmiki-ramayana-3-sarga-52-shlok-7",
    "collectionId": "valmiki-ramayana",
    "index": 8181,
    "titleDevanagari": "वाल्मीकि रामायण, अरण्यकाण्ड, सर्ग 52, श्लोक 7",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-52-shlok-7",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "तां लतामिव वेष्टन्तीमालिङ्गन्तीं महाद्रुमान्।",
          "मुञ्च मुञ्चेति बहुशः प्राप तां राक्षसाधिपः॥७॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-52",
    "chapterName": "अरण्यकाण्ड, सर्ग 52",
    "verseNumber": 7
  },
  {
    "id": "valmiki-ramayana-3-sarga-52-shlok-9",
    "collectionId": "valmiki-ramayana",
    "index": 8182,
    "titleDevanagari": "वाल्मीकि रामायण, अरण्यकाण्ड, सर्ग 52, श्लोक 9",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-52-shlok-9",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "क्रोशन्तीं राम रामेति रामेण रहितां वने।",
          "जीवितान्ताय केशेषु जग्राहान्तकसंनिभः॥८॥",
          "प्रधर्षितायां वैदेह्यां बभूव सचराचरम्।",
          "जगत् सर्वममर्यादं तमसान्धेन संवृतम्॥९॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-52",
    "chapterName": "अरण्यकाण्ड, सर्ग 52",
    "verseNumber": 9
  },
  {
