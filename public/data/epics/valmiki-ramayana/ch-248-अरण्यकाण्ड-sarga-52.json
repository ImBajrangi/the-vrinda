    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-52-shlok-13",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "स तु तां राम रामेति रुदती लक्ष्मणेति च।",
          "जगामादाय चाकाशं रावणो राक्षसेश्वरः॥१३॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-52",
    "chapterName": "अरण्यकाण्ड, सर्ग 52",
    "verseNumber": 13
