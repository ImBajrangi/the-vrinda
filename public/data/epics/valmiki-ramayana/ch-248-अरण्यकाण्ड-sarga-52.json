    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "उद्धृतेन च वस्त्रेण तस्याः पीतेन रावणः।",
          "अधिकं परिबभ्राज गिरिर्दीप्त इवाग्निना॥१५॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-52",
