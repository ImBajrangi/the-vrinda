    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-52-shlok-12",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "प्रहृष्टा व्यथिताश्चासन् सर्वे ते परमर्षयः॥११॥",
          "दृष्ट्वा सीतां परामृष्टां दण्डकारण्यवासिनः।",
          "रावणस्य विनाशं च प्राप्तं बुद्ध्वा यदृच्छया॥ १२॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-52",
    "chapterName": "अरण्यकाण्ड, सर्ग 52",
    "verseNumber": 12
  },
  {
