    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-52-shlok-22",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "रुदितं व्यपमृष्टास्रं चन्द्रवत् प्रियदर्शनम्।",
          "सुनासं चारुताम्रोष्ठमाकाशे हाटकप्रभम्॥ २१॥",
          "राक्षसेन्द्रसमाधूतं तस्यास्तद् वदनं शुभम्।",
          "शुशुभे न विना रामं दिवा चन्द्र इवोदितः॥२२॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-52",
    "chapterName": "अरण्यकाण्ड, सर्ग 52",
    "verseNumber": 22
  },
