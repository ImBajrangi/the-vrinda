    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-52-shlok-10",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "न वाति मारुतस्तत्र निष्प्रभोऽभून दिवाकरः।",
          "दृष्ट्वा सीतां परामृष्टां देवो दिव्येन चक्षुषा॥१०॥",
          "कृतं कार्यमिति श्रीमान् व्याजहार पितामहः।"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-52",
    "chapterName": "अरण्यकाण्ड, सर्ग 52",
    "verseNumber": 10
  },
  {
