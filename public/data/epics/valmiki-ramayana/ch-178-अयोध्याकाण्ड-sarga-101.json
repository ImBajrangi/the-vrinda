    "slug": "valmiki-ramayana-2-sarga-101-shlok-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "तं तु रामः समाज्ञाय भ्रातरं गुरुवत्सलम्।",
          "लक्ष्मणेन सह भ्रात्रा प्रष्टुं समुपचक्रमे॥१॥"
        ]
      }
    ],
    "chapterId": "अयोध्याकाण्ड-sarga-101",
    "chapterName": "अयोध्याकाण्ड, सर्ग 101",
    "verseNumber": 1
  },
