    "slug": "valmiki-ramayana-5-sarga-36-shlok-3",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "प्रत्ययार्थं तवानीतं तेन दत्तं महात्मना।",
          "समाश्वसिहि भद्रं ते क्षीणदुःखफला ह्यसि॥३॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-36",
    "chapterName": "सुन्दरकाण्ड, सर्ग 36",
    "verseNumber": 3
  },
  {
