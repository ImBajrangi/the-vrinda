    "slug": "valmiki-ramayana-5-sarga-36-shlok-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "भूय एव महातेजा हनूमान् पवनात्मजः।",
          "अब्रवीत् प्रश्रितं वाक्यं सीताप्रत्ययकारणात्॥१॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-36",
    "chapterName": "सुन्दरकाण्ड, सर्ग 36",
    "verseNumber": 1
  },
  {
    "id": "valmiki-ramayana-5-sarga-36-shlok-2",
    "collectionId": "valmiki-ramayana",
    "index": 10075,
    "titleDevanagari": "वाल्मीकि रामायण, सुन्दरकाण्ड, सर्ग 36, श्लोक 2",
