    "slug": "valmiki-ramayana-5-sarga-36-shlok-2",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "वानरोऽहं महाभागे दूतो रामस्य धीमतः।",
          "रामनामाङ्कितं चेदं पश्य देव्यङ्गलीयकम्॥२॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-36",
    "chapterName": "सुन्दरकाण्ड, सर्ग 36",
    "verseNumber": 2
  },
  {
