    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "ततः सा ह्रीमती बाला भर्तुः संदेशहर्षिता।",
          "परितुष्टा प्रियं कृत्वा प्रशशंस महाकपिम्॥६॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-36",
    "chapterName": "सुन्दरकाण्ड, सर्ग 36",
    "verseNumber": 6
  },
