    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "चारु तद् वदनं तस्यास्ताम्रशुक्लायतेक्षणम्।",
          "बभूव हर्षोदग्रं च राहुमुक्त इवोडुराट्॥५॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-36",
    "chapterName": "सुन्दरकाण्ड, सर्ग 36",
    "verseNumber": 5
  },
