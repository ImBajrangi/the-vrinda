    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "गृहीत्वा प्रेक्षमाणा सा भर्तुः करविभूषितम्।",
          "भर्तारमिव सम्प्राप्त जानकी मुदिताभवत्॥४॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-36",
    "chapterName": "सुन्दरकाण्ड, सर्ग 36",
    "verseNumber": 4
  },
