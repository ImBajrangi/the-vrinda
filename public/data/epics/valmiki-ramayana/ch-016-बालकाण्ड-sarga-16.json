    "slug": "valmiki-ramayana-1-sarga-16-shlok-3-2",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "स पर्वतं समारुह्य कंचिद् रम्यवनान्तरम्।",
          "प्रेक्षते पुष्पकं तत्र राम विष्टम्भितं तदा॥३॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-16",
    "chapterName": "बालकाण्ड, सर्ग 16",
    "verseNumber": 3
  },
