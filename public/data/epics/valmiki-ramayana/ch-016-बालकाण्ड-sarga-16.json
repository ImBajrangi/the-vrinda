    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 16, श्लोक 1",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-16-shlok-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "स जित्वा धनदं राम भ्रातरं राक्षसाधिपः।",
          "महासेनप्रसूतिं तद् ययौ शरवणं महत्॥१॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-16",
    "chapterName": "बालकाण्ड, सर्ग 16",
    "verseNumber": 1
  },
  {
    "id": "valmiki-ramayana-1-sarga-16-shlok-2-2",
    "collectionId": "valmiki-ramayana",
    "index": 790,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 16, श्लोक 2",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-16-shlok-2-2",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "अथापश्यद् दशग्रीवो रौक्मं शरवणं महत्।",
          "गभस्तिजालसंवीतं द्वितीयमिव भास्करम्॥२॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-16",
    "chapterName": "बालकाण्ड, सर्ग 16",
    "verseNumber": 2
  },
  {
