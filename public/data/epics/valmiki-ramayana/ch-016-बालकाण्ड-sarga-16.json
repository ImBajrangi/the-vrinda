    "slug": "valmiki-ramayana-1-sarga-16-shlok-16-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "॥ श्रीसीतारामचन्द्राभ्यां नमः॥",
          "श्रीमद्वाल्मीकीय रामायण",
          "किष्किन्धाकाण्डम्",
          "षोडशः सर्गः (सर्ग 16)",
          "तं स दृष्ट्वा महाबाहः सुग्रीवं पर्यवस्थितम।",
          "गाढं परिदधे वासो वाली परमकोपनः॥१६॥",
          "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये किष्किन्धाकाण्डे षोडशः सर्गः ॥१६॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-16",
    "chapterName": "बालकाण्ड, सर्ग 16",
    "verseNumber": 16
  },
  {
