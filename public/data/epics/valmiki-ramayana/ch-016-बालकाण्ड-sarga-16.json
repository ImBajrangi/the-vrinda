        "stanzaNumber": 1,
        "linesDevanagari": [
          "ततोऽब्रवीत् तदा राम मारीचो बुद्धिकोविदः।",
          "नेदं निष्कारणं राजन् पुष्पकं यन्न गच्छति॥६॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-16",
    "chapterName": "बालकाण्ड, सर्ग 16",
    "verseNumber": 6
  },
