    "slug": "valmiki-ramayana-1-sarga-16-shlok-4",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "सोढुं न च समर्थोऽहं युद्धकामस्य संयुगे।",
          "सुग्रीवस्य च संरम्भं हीनग्रीवस्य गर्जितम्॥४॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-16",
    "chapterName": "बालकाण्ड, सर्ग 16",
    "verseNumber": 4
  },
  {
    "id": "valmiki-ramayana-1-sarga-16-shlok-5",
    "collectionId": "valmiki-ramayana",
    "index": 793,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 16, श्लोक 5",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-16-shlok-5",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "विष्टब्धं किमिदं कस्मान्नागमत् कामगं कृतम्।",
          "अचिन्तयद राक्षसेन्द्रः सचिवैस्तैः समावृतः॥४॥",
          "किंनिमित्तमिच्छया मे नेदं गच्छति पुष्पकम्।",
          "पर्वतस्योपरिष्ठस्य कर्मेदं कस्यचिद् भवेत्॥५॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-16",
    "chapterName": "बालकाण्ड, सर्ग 16",
    "verseNumber": 5
  },
  {
