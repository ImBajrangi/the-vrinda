    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-16-shlok-17-2",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "यस्माद् वानररूपं मामवज्ञाय दशानन।",
          "अशनीपातसंकाशमपहासं प्रमुक्तवान्॥१६॥",
          "तस्मान्मबीर्यसंयुक्ता मद्रूपसमतेजसः।",
          "उत्पत्स्यन्ति वधार्थं हि कुलस्य तव वानराः॥१७॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-16",
    "chapterName": "बालकाण्ड, सर्ग 16",
    "verseNumber": 17
  },
