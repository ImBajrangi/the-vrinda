    "slug": "valmiki-ramayana-1-sarga-59-shlok-2-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "जाम्बवान् वानरश्रेष्ठः सह सर्वैः प्लवङ्गमैः।",
          "भूतलात् सहसोत्थाय गृध्रराजानमब्रवीत्॥२॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-59",
    "chapterName": "बालकाण्ड, सर्ग 59",
    "verseNumber": 2
  },
