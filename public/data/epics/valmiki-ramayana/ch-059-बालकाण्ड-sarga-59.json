        "stanzaNumber": 1,
        "linesDevanagari": [
          "तदाख्यातु भवान् सर्वं गतिर्भव वनौकसाम्॥३॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-59",
    "chapterName": "बालकाण्ड, सर्ग 59",
    "verseNumber": 3
