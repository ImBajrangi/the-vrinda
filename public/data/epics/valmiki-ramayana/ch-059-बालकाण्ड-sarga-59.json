    "slug": "valmiki-ramayana-1-sarga-59-shlok-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "ततस्तदमृतास्वादं गृध्रराजेन भाषितम्।",
          "निशम्य वदता हृष्टास्ते वचः प्लवगर्षभाः॥१॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-59",
    "chapterName": "बालकाण्ड, सर्ग 59",
    "verseNumber": 1
  },
  {
