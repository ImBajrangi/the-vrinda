    "titleDevanagari": "वाल्मीकि रामायण, सुन्दरकाण्ड, सर्ग 65, श्लोक 2",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-5-sarga-65-shlok-2",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "ततः प्रस्रवणं शैलं ते गत्वा चित्रकाननम्।",
          "प्रणम्य शिरसा रामं लक्ष्मणं च महाबलम्॥१॥",
          "युवराजं पुरस्कृत्य सुग्रीवमभिवाद्य च।",
          "प्रवृत्तिमथ सीतायाः प्रवक्तुमुपचक्रमुः॥२॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-65",
    "chapterName": "सुन्दरकाण्ड, सर्ग 65",
    "verseNumber": 2
  },
  {
    "id": "valmiki-ramayana-5-sarga-65-shlok-4",
    "collectionId": "valmiki-ramayana",
    "index": 11171,
    "titleDevanagari": "वाल्मीकि रामायण, सुन्दरकाण्ड, सर्ग 65, श्लोक 4",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-5-sarga-65-shlok-4",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "रावणान्तःपुरे रोधं राक्षसीभिश्च तर्जनम्।",
          "रामे समनुरागं च यथा च नियमः कृतः॥३॥",
          "एतदाख्याय ते सर्वं हरयो रामसंनिधौ।",
          "वैदेहीमक्षतां श्रुत्वा रामस्तूत्तरमब्रवीत्॥४॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-65",
    "chapterName": "सुन्दरकाण्ड, सर्ग 65",
    "verseNumber": 4
  },
  {
    "id": "valmiki-ramayana-5-sarga-65-shlok-5",
    "collectionId": "valmiki-ramayana",
    "index": 11172,
    "titleDevanagari": "वाल्मीकि रामायण, सुन्दरकाण्ड, सर्ग 65, श्लोक 5",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-5-sarga-65-shlok-5",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "क्व सीता वर्तते देवी कथं च मयि वर्तते।",
          "एतन्मे सर्वमाख्यात वैदेहीं प्रति वानराः॥५॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-65",
    "chapterName": "सुन्दरकाण्ड, सर्ग 65",
    "verseNumber": 5
  },
  {
