    "slug": "valmiki-ramayana-5-sarga-65-shlok-6",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "रामस्य गदितं श्रुत्वा हरयो रामसंनिधौ।",
          "चोदयन्ति हनूमन्तं सीतावृत्तान्तकोविदम्॥६॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-65",
    "chapterName": "सुन्दरकाण्ड, सर्ग 65",
    "verseNumber": 6
  },
  {
