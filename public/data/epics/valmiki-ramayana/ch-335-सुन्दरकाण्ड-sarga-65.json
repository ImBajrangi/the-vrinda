    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "अभिज्ञानं च मे दत्तं यथावृत्तं तवान्तिके।",
          "चित्रकूटे महाप्राज्ञ वायसं प्रति राघव॥२०॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-65",
    "chapterName": "सुन्दरकाण्ड, सर्ग 65",
    "verseNumber": 20
  },
  {
