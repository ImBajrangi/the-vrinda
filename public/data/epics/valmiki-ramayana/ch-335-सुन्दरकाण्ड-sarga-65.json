    "slug": "valmiki-ramayana-5-sarga-65-shlok-21",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "विज्ञाप्यः पुनरप्येष रामो वायुसुत त्वया।",
          "अखिलेन यथा दृष्टमिति मामाह जानकी॥२१॥",
          "अयं चास्मै प्रदातव्यो यत्नात् सुपरिरक्षितः।"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-65",
    "chapterName": "सुन्दरकाण्ड, सर्ग 65",
    "verseNumber": 21
  },
