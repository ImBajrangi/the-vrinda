    "slug": "valmiki-ramayana-5-sarga-65-shlok-10",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "तत्र लङ्केति नगरी रावणस्य दुरात्मनः॥१०॥",
          "दक्षिणस्य समुद्रस्य तीरे वसति दक्षिणे।"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-65",
    "chapterName": "सुन्दरकाण्ड, सर्ग 65",
    "verseNumber": 10
  },
  {
    "id": "valmiki-ramayana-5-sarga-65-shlok-11",
    "collectionId": "valmiki-ramayana",
    "index": 11178,
    "titleDevanagari": "वाल्मीकि रामायण, सुन्दरकाण्ड, सर्ग 65, श्लोक 11",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-5-sarga-65-shlok-11",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "तत्र सीता मया दृष्टा रावणान्तःपुरे सती॥११॥",
          "त्वयि संन्यस्य जीवन्ती रामा राम मनोरथम्।",
          "दृष्टा मे राक्षसीमध्ये तय॑माना मुहुर्मुहुः॥१२॥",
          "राक्षसीभिर्विरूपाभी रक्षिता प्रमदावने।"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-65",
    "chapterName": "सुन्दरकाण्ड, सर्ग 65",
    "verseNumber": 11
  },
  {
    "id": "valmiki-ramayana-5-sarga-65-shlok-14",
    "collectionId": "valmiki-ramayana",
    "index": 11179,
    "titleDevanagari": "वाल्मीकि रामायण, सुन्दरकाण्ड, सर्ग 65, श्लोक 14",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-5-sarga-65-shlok-14",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "दुःखमापद्यते देवी त्वया वीर सुखोचिता॥१३॥",
          "रावणान्तःपुरे रुद्वा राक्षसीभिः सुरक्षिता।",
          "एकवेणीधरा दीना त्वयि चिन्तापरायणा॥१४॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-65",
    "chapterName": "सुन्दरकाण्ड, सर्ग 65",
    "verseNumber": 14
  },
  {
