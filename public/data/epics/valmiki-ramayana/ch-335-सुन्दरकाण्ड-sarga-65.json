    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-5-sarga-65-shlok-15",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "अधःशय्या विवर्णाङ्गी पद्मिनीव हिमागमे।",
          "रावणाद् विनिवृत्तार्था मर्तव्यकृतनिश्चया॥१५॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-65",
    "chapterName": "सुन्दरकाण्ड, सर्ग 65",
    "verseNumber": 15
  },
  {
    "id": "valmiki-ramayana-5-sarga-65-shlok-17",
