    "slug": "valmiki-ramayana-5-sarga-65-shlok-7",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "श्रुत्वा तु वचनं तेषां हनूमान् मारुतात्मजः।",
          "प्रणम्य शिरसा देव्यै सीतायै तां दिशं प्रति॥७॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-65",
    "chapterName": "सुन्दरकाण्ड, सर्ग 65",
    "verseNumber": 7
  },
  {
    "id": "valmiki-ramayana-5-sarga-65-shlok-8",
    "collectionId": "valmiki-ramayana",
    "index": 11175,
    "titleDevanagari": "वाल्मीकि रामायण, सुन्दरकाण्ड, सर्ग 65, श्लोक 8",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-5-sarga-65-shlok-8",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "उवाच वाक्यं वाक्यज्ञः सीताया दर्शनं यथा।",
          "तं मणिं काञ्चनं दिव्यं दीप्यमानं स्वतेजसा॥८॥",
          "दत्त्वा रामाय हनुमांस्ततः प्राञ्जलिरब्रवीत्।"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-65",
    "chapterName": "सुन्दरकाण्ड, सर्ग 65",
    "verseNumber": 8
  },
  {
    "id": "valmiki-ramayana-5-sarga-65-shlok-9",
    "collectionId": "valmiki-ramayana",
    "index": 11176,
    "titleDevanagari": "वाल्मीकि रामायण, सुन्दरकाण्ड, सर्ग 65, श्लोक 9",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-5-sarga-65-shlok-9",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "समुद्रं लवयित्वाहं शतयोजनमायतम्॥९॥",
          "अगच्छं जानकी सीतां मार्गमाणो दिदृक्षया।"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-65",
    "chapterName": "सुन्दरकाण्ड, सर्ग 65",
    "verseNumber": 9
  },
  {
