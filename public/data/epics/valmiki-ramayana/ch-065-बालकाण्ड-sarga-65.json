[
  {
    "id": "valmiki-ramayana-1-sarga-65-shlok-1",
    "collectionId": "valmiki-ramayana",
    "index": 2665,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 65, श्लोक 1",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-65-shlok-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "अथाङ्गदवचः श्रुत्वा ते सर्वे वानरर्षभाः।",
          "स्वं स्वं गतौ समुत्साहमचुस्तत्र यथाक्रमम्॥१॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-65",
    "chapterName": "बालकाण्ड, सर्ग 65",
    "verseNumber": 1
  },
  {
    "id": "valmiki-ramayana-1-sarga-65-shlok-2-2",
    "collectionId": "valmiki-ramayana",
    "index": 2666,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 65, श्लोक 2",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-65-shlok-2-2",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "गजो गवाक्षो गवयः शरभो गन्धमादनः।",
          "मैन्दश्च द्विविदश्चैव सुषेणो जाम्बवांस्तथा ॥२॥",
          "आबभाषे गजस्तत्र प्लवेयं दशयोजनम्।",
          "गवाक्षो योजनान्याह गमिष्यामीति विंशतिम्॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-65",
    "chapterName": "बालकाण्ड, सर्ग 65",
    "verseNumber": 2
  },
  {
    "id": "valmiki-ramayana-1-sarga-65-shlok-3",
    "collectionId": "valmiki-ramayana",
    "index": 2667,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 65, श्लोक 3",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-65-shlok-3",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "पूर्णे वर्षसहस्रे तु काष्ठभूतं महामुनिम्।",
          "विनर्बहुभिराधूतं क्रोधो नान्तरमाविशत्॥३॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-65",
    "chapterName": "बालकाण्ड, सर्ग 65",
    "verseNumber": 3
  },
  {
    "id": "valmiki-ramayana-1-sarga-65-shlok-4",
    "collectionId": "valmiki-ramayana",
    "index": 2668,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 65, श्लोक 4",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-65-shlok-4",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "शरभो वानरस्तत्र वानरांस्तानुवाच ह।",
          "त्रिंशतं तु गमिष्यामि योजनानां प्लवङ्गमाः॥४॥",
          "ऋषभो वानरस्तत्र वानरांस्तानुवाच ह।",
          "चत्वारिंशद् गमिष्यामि योजनानां न संशयः॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-65",
    "chapterName": "बालकाण्ड, सर्ग 65",
    "verseNumber": 4
  },
  {
    "id": "valmiki-ramayana-1-sarga-65-shlok-5-1",
    "collectionId": "valmiki-ramayana",
    "index": 2669,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 65, श्लोक 5",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-65-shlok-5-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "स कृत्वा निश्चयं राम तप आतिष्ठताव्ययम्।",
          "तस्य वर्षसहस्रस्य व्रते पूर्णे महाव्रतः॥४॥",
          "भोक्तुमारब्धवानन्नं तस्मिन् काले रघूत्तम।",
          "इन्द्रो द्विजातिर्भूत्वा तं सिद्धमन्नमयाचत॥५॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-65",
    "chapterName": "बालकाण्ड, सर्ग 65",
    "verseNumber": 5
  },
  {
    "id": "valmiki-ramayana-1-sarga-65-shlok-6-2",
    "collectionId": "valmiki-ramayana",
    "index": 2670,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 65, श्लोक 6",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-65-shlok-6-2",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "वानरांस्तु महातेजा अब्रवीद् गन्धमादनः।",
          "योजनानां गमिष्यामि पञ्चाशत्तु न संशयः॥६॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-65",
    "chapterName": "बालकाण्ड, सर्ग 65",
    "verseNumber": 6
  },
  {
