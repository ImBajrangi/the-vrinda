    "slug": "valmiki-ramayana-1-sarga-65-shlok-7",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "मैन्दस्तु वानरस्तत्र वानरांस्तानुवाच ह।",
          "योजनानां परं षष्टिमहं प्लवितुमुत्सहे॥७॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-65",
    "chapterName": "बालकाण्ड, सर्ग 65",
    "verseNumber": 7
  },
  {
    "id": "valmiki-ramayana-1-sarga-65-shlok-8-1",
    "collectionId": "valmiki-ramayana",
