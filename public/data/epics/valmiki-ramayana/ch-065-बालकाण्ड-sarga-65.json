    "slug": "valmiki-ramayana-1-sarga-65-shlok-8-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "अथ वर्षसहस्रं च नोच्छ्वसन् मुनिपुंगवः।",
          "तस्यानुच्छ्वसमानस्य मूर्ध्नि धूमो व्यजायत॥८॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-65",
    "chapterName": "बालकाण्ड, सर्ग 65",
    "verseNumber": 8
  },
  {
    "id": "valmiki-ramayana-1-sarga-65-shlok-9-1",
    "collectionId": "valmiki-ramayana",
    "index": 2673,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 65, श्लोक 9",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-65-shlok-9-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "सुषेणस्तु महातेजाः सत्त्ववान् कपिसत्तमः।",
          "अशीतिं प्रतिजानेऽहं योजनानां पराक्रमे॥९॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-65",
    "chapterName": "बालकाण्ड, सर्ग 65",
    "verseNumber": 9
  },
  {
    "id": "valmiki-ramayana-1-sarga-65-shlok-10-1",
    "collectionId": "valmiki-ramayana",
    "index": 2674,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 65, श्लोक 10",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-65-shlok-10-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "त्रैलोक्यं येन सम्भ्रान्तमातापितमिवाभवत्।",
          "ततो देवर्षिगन्धर्वाः पन्नगोरगराक्षसाः॥९॥",
          "मोहितास्तपसा तस्य तेजसा मन्दरश्मयः।",
          "कश्मलोपहताः सर्वे पितामहमथाब्रुवन्॥१०॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-65",
    "chapterName": "बालकाण्ड, सर्ग 65",
    "verseNumber": 10
  },
  {
    "id": "valmiki-ramayana-1-sarga-65-shlok-11-1",
    "collectionId": "valmiki-ramayana",
    "index": 2675,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 65, श्लोक 11",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-65-shlok-11-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "बहुभिः कारणैर्देव विश्वामित्रो महामुनिः।",
          "लोभितः क्रोधितश्चैव तपसा चाभिवर्धते॥११॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-65",
    "chapterName": "बालकाण्ड, सर्ग 65",
    "verseNumber": 11
  },
  {
    "id": "valmiki-ramayana-1-sarga-65-shlok-13-2",
    "collectionId": "valmiki-ramayana",
    "index": 2676,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 65, श्लोक 13",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-65-shlok-13-2",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "पूर्वमस्माकमप्यासीत् कश्चिद् गतिपराक्रमः।",
          "ते वयं वयसः पारमनुप्राप्ताः स्म साम्प्रतम्॥११॥",
          "किं तु नैवं गते शक्यमिदं कार्यमुपेक्षितुम्।",
          "यदर्थं कपिराजश्च रामश्च कृतनिश्चयौ॥१२॥",
          "साम्प्रतं कालमस्माकं या गतिस्तां निबोधत।",
          "नवतिं योजनानां तु गमिष्यामि न संशयः॥१३॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-65",
    "chapterName": "बालकाण्ड, सर्ग 65",
    "verseNumber": 13
  },
  {
    "id": "valmiki-ramayana-1-sarga-65-shlok-14",
    "collectionId": "valmiki-ramayana",
    "index": 2677,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 65, श्लोक 14",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-65-shlok-14",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "सागराः क्षुभिताः सर्वे विशीर्यन्ते च पर्वताः। प्र",
          "कम्पते च वसुधा वायुर्वातीह संकुलः॥१४॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-65",
    "chapterName": "बालकाण्ड, सर्ग 65",
    "verseNumber": 14
  },
  {
    "id": "valmiki-ramayana-1-sarga-65-shlok-15",
    "collectionId": "valmiki-ramayana",
    "index": 2678,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 65, श्लोक 15",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-65-shlok-15",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "तांश्च सर्वान् हरिश्रेष्ठाजाम्बवानिदमब्रवीत्।",
          "न खल्वेतावदेवासीद् गमने मे पराक्रमः॥१४॥",
          "मया वैरोचने यज्ञे प्रभविष्णुः सनातनः।",
          "प्रदक्षिणीकृतः पूर्वं क्रममाणस्त्रिविक्रमम्॥१५॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-65",
    "chapterName": "बालकाण्ड, सर्ग 65",
    "verseNumber": 15
  },
  {
    "id": "valmiki-ramayana-1-sarga-65-shlok-16-1",
    "collectionId": "valmiki-ramayana",
    "index": 2679,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 65, श्लोक 16",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-65-shlok-16-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "भास्करो निष्प्रभश्चैव महर्षेस्तस्य तेजसा।",
          "बुद्धिं न कुरुते यावन्नाशे देव महामुनिः॥१६॥",
          "तावत् प्रसादो भगवन्नग्निरूपो महाद्युतिः।",
          "कालाग्निना यथा पूर्वं त्रैलोक्यं दह्यतेऽखिलम्॥ १७॥",
          "देवराज्यं चिकीर्षत दीयतामस्य यन्मनः।"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-65",
    "chapterName": "बालकाण्ड, सर्ग 65",
    "verseNumber": 16
  },
  {
    "id": "valmiki-ramayana-1-sarga-65-shlok-17",
    "collectionId": "valmiki-ramayana",
    "index": 2680,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 65, श्लोक 17",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-65-shlok-17",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "सम्प्रत्येतावदेवाद्य शक्यं मे गमने स्वतः।",
          "नैतावता च संसिद्धिः कार्यस्यास्य भविष्यति॥१७॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-65",
    "chapterName": "बालकाण्ड, सर्ग 65",
    "verseNumber": 17
  },
  {
    "id": "valmiki-ramayana-1-sarga-65-shlok-18-1",
    "collectionId": "valmiki-ramayana",
    "index": 2681,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 65, श्लोक 18",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-65-shlok-18-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "ततः सुरगणाः सर्वे पितामहपुरोगमाः॥१८॥",
          "विश्वामित्रं महात्मानं वाक्यं मधुरमब्रुवन्।",
          "ब्रह्मर्षे स्वागतं तेऽस्तु तपसा स्म सुतोषिताः॥ १९॥",
          "ब्राह्मण्यं तपसोग्रेण प्राप्तवानसि कौशिक।",
          "दीर्घमायुश्च ते ब्रह्मन् ददामि समरुद्गणः॥ २०॥",
          "स्वस्ति प्राप्नुहि भद्रं ते गच्छ सौम्य यथासुखम्।",
          "पितामहवचः श्रुत्वा सर्वेषां त्रिदिवौकसाम्॥ २१॥",
          "कृत्वा प्रणामं मुदितो व्याजहार महामुनिः।"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-65",
    "chapterName": "बालकाण्ड, सर्ग 65",
    "verseNumber": 18
  },
  {
