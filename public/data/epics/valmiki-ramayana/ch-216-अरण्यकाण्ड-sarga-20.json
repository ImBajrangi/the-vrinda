    "titleDevanagari": "वाल्मीकि रामायण, अरण्यकाण्ड, सर्ग 20, श्लोक 2",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-20-shlok-2",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "ते रामं पर्णशालायामुपविष्टं महाबलम्।",
          "ददृशुः सीतया सार्धं लक्ष्मणेनापि सेवितम्॥२॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-20",
    "chapterName": "अरण्यकाण्ड, सर्ग 20",
    "verseNumber": 2
  },
  {
