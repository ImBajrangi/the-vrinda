    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "मुहूर्तं भव सौमित्रे सीतायाः प्रत्यनन्तरः।",
          "इमानस्या वधिष्यामि पदवीमागतानिह ॥४॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-20",
    "chapterName": "अरण्यकाण्ड, सर्ग 20",
    "verseNumber": 4
  },
  {
