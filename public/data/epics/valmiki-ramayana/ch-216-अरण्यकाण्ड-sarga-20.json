    "slug": "valmiki-ramayana-3-sarga-20-shlok-3",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "तां दृष्ट्वा राघवः श्रीमानागतांस्तांश्च राक्षसान्।",
          "अब्रवीद् भ्रातरं रामो लक्ष्मणं दीप्ततेजसम्॥३॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-20",
    "chapterName": "अरण्यकाण्ड, सर्ग 20",
    "verseNumber": 3
  },
  {
