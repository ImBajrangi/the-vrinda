    "slug": "valmiki-ramayana-3-sarga-20-shlok-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "ततः शूर्पणखा घोरा राघवाश्रममागता।",
          "राक्षसानाचचक्षे तौ भ्रातरौ सह सीतया॥१॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-20",
    "chapterName": "अरण्यकाण्ड, सर्ग 20",
    "verseNumber": 1
  },
  {
