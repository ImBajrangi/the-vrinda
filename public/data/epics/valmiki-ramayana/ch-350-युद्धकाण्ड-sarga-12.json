    "slug": "valmiki-ramayana-6-sarga-12-shlok-11",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "अयं हि सुप्तः षण्मासान् कुम्भकर्णो महाबलः।",
          "सर्वशस्त्रभृतां मुख्यः स इदानीं समुत्थितः ॥११॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-12",
    "chapterName": "युद्धकाण्ड, सर्ग 12",
    "verseNumber": 11
  },
  {
