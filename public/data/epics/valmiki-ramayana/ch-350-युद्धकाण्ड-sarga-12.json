[
  {
    "id": "valmiki-ramayana-6-sarga-12-shlok-1",
    "collectionId": "valmiki-ramayana",
    "index": 11589,
    "titleDevanagari": "वाल्मीकि रामायण, युद्धकाण्ड, सर्ग 12, श्लोक 1",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-6-sarga-12-shlok-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "स तां परिषदं कृत्स्नां समीक्ष्य समितिंजयः।",
          "प्रचोदयामास तदा प्रहस्तं वाहिनीपतिम्॥१॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-12",
    "chapterName": "युद्धकाण्ड, सर्ग 12",
    "verseNumber": 1
  },
  {
    "id": "valmiki-ramayana-6-sarga-12-shlok-2",
    "collectionId": "valmiki-ramayana",
    "index": 11590,
    "titleDevanagari": "वाल्मीकि रामायण, युद्धकाण्ड, सर्ग 12, श्लोक 2",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-6-sarga-12-shlok-2",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "सेनापते यथा ते स्युः कृतविद्याश्चतुर्विधाः।",
          "योधा नगररक्षायां तथा व्यादेष्टमर्हसि ॥२॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-12",
    "chapterName": "युद्धकाण्ड, सर्ग 12",
    "verseNumber": 2
  },
  {
    "id": "valmiki-ramayana-6-sarga-12-shlok-3",
    "collectionId": "valmiki-ramayana",
    "index": 11591,
    "titleDevanagari": "वाल्मीकि रामायण, युद्धकाण्ड, सर्ग 12, श्लोक 3",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-6-sarga-12-shlok-3",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "स प्रहस्तः प्रणीतात्मा चिकीर्षन् राजशासनम्।",
          "विनिक्षिपद बलं सर्वं बहिरन्तश्च मन्दिरे॥३॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-12",
    "chapterName": "युद्धकाण्ड, सर्ग 12",
    "verseNumber": 3
  },
  {
    "id": "valmiki-ramayana-6-sarga-12-shlok-4",
    "collectionId": "valmiki-ramayana",
    "index": 11592,
    "titleDevanagari": "वाल्मीकि रामायण, युद्धकाण्ड, सर्ग 12, श्लोक 4",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-6-sarga-12-shlok-4",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "ततो विनिक्षिप्य बलं सर्वं नगरगुप्तये।",
          "प्रहस्तः प्रमुखे राज्ञो निषसाद जगाद च॥४॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-12",
    "chapterName": "युद्धकाण्ड, सर्ग 12",
    "verseNumber": 4
  },
  {
    "id": "valmiki-ramayana-6-sarga-12-shlok-5",
    "collectionId": "valmiki-ramayana",
    "index": 11593,
    "titleDevanagari": "वाल्मीकि रामायण, युद्धकाण्ड, सर्ग 12, श्लोक 5",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-6-sarga-12-shlok-5",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "विहितं बहिरन्तश्च बलं बलवतस्तव।",
          "कुरुष्वाविमनाः क्षिप्रं यदभिप्रेतमस्ति ते॥५॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-12",
    "chapterName": "युद्धकाण्ड, सर्ग 12",
    "verseNumber": 5
  },
  {
