    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-6-sarga-12-shlok-13",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "सा मे न शय्यामारोढुमिच्छत्यलसगामिनी।",
          "त्रिषु लोकेषु चान्या मे न सीतासदृशी तथा॥१३॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-12",
