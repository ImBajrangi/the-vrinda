    "collectionId": "valmiki-ramayana",
    "index": 11595,
    "titleDevanagari": "वाल्मीकि रामायण, युद्धकाण्ड, सर्ग 12, श्लोक 7",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-6-sarga-12-shlok-7",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "प्रियाप्रिये सुखे दुःखे लाभालाभे हिताहिते।",
          "धर्मकामार्थकृच्छेषु यूयमर्हथ वेदितुम्॥७॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-12",
    "chapterName": "युद्धकाण्ड, सर्ग 12",
    "verseNumber": 7
  },
  {
    "id": "valmiki-ramayana-6-sarga-12-shlok-8",
