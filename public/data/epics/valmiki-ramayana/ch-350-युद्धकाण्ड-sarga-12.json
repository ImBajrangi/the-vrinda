    "collectionId": "valmiki-ramayana",
    "index": 11594,
    "titleDevanagari": "वाल्मीकि रामायण, युद्धकाण्ड, सर्ग 12, श्लोक 6",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-6-sarga-12-shlok-6",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "प्रहस्तस्य वचः श्रुत्वा राजा राज्यहितैषिणः।",
          "सुखेप्सुः सुहृदां मध्ये व्याजहार स रावणः॥६॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-12",
    "chapterName": "युद्धकाण्ड, सर्ग 12",
    "verseNumber": 6
  },
  {
