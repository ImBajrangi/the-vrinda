    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-6-sarga-12-shlok-9",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "ससोमग्रहनक्षत्रैर्मरुद्भिरिव वासवः।",
          "भवद्भिरहमत्यर्थं वृतः श्रियमवाप्नुयाम्॥९॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-12",
    "chapterName": "युद्धकाण्ड, सर्ग 12",
    "verseNumber": 9
  },
  {
