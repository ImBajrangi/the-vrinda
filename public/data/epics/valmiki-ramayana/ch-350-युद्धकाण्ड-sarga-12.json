    "slug": "valmiki-ramayana-6-sarga-12-shlok-12",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "॥ श्रीसीतारामचन्द्राभ्यां नमः॥",
          "श्रीमद्वाल्मीकीय रामायण",
          "युद्धकाण्डम्",
          "द्वादशः सर्गः (12)",
          "इयं च दण्डकारण्याद् रामस्य महिषी प्रिया।",
          "रक्षोभिश्चरितोद्देशादानीता जनकात्मजा॥१२॥",
          "इत्याचे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये युद्धकाण्डे द्वादशः सर्गः॥१२॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-12",
    "chapterName": "युद्धकाण्ड, सर्ग 12",
    "verseNumber": 12
  },
