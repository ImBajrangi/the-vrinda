    "slug": "valmiki-ramayana-6-sarga-12-shlok-10",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "अहं तु खलु सर्वान् वः समर्थयितुमुद्यतः।",
          "कुम्भकर्णस्य तु स्वप्नान् नेममर्थमचोदयम्॥१०॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-12",
    "chapterName": "युद्धकाण्ड, सर्ग 12",
    "verseNumber": 10
  },
  {
