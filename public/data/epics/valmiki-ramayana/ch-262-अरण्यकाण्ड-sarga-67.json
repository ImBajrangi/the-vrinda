      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "तं तथा परितापार्तं लक्ष्मणो वाक्यमब्रवीत्।",
          "इदमेव जनस्थानं त्वमन्वेषितुमर्हसि ॥४॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-67",
    "chapterName": "अरण्यकाण्ड, सर्ग 67",
    "verseNumber": 4
  },
