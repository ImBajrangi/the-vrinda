    "collectionId": "valmiki-ramayana",
    "index": 8542,
    "titleDevanagari": "वाल्मीकि रामायण, अरण्यकाण्ड, सर्ग 67, श्लोक 3",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-67-shlok-3",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "किं करिष्यावहे वत्स क्व वा गच्छाव लक्ष्मण।",
          "केनोपायेन पश्यावः सीतामिह विचिन्तय॥३॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-67",
    "chapterName": "अरण्यकाण्ड, सर्ग 67",
    "verseNumber": 3
  },
