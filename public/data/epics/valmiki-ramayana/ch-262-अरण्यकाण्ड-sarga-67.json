    "titleDevanagari": "वाल्मीकि रामायण, अरण्यकाण्ड, सर्ग 67, श्लोक 1",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-67-shlok-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "पूर्वजोऽप्युक्तमात्रस्तु लक्ष्मणेन सुभाषितम्।",
          "सारग्राही महासारं प्रतिजग्राह राघवः॥१॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-67",
    "chapterName": "अरण्यकाण्ड, सर्ग 67",
    "verseNumber": 1
  },
  {
    "id": "valmiki-ramayana-3-sarga-67-shlok-2",
    "collectionId": "valmiki-ramayana",
    "index": 8541,
    "titleDevanagari": "वाल्मीकि रामायण, अरण्यकाण्ड, सर्ग 67, श्लोक 2",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-67-shlok-2",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "स निगृह्य महाबाहुः प्रवृद्धं रोषमात्मनः।",
          "अवष्टभ्य धनुश्चित्रं रामो लक्ष्मणमब्रवीत्॥२॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-67",
    "chapterName": "अरण्यकाण्ड, सर्ग 67",
    "verseNumber": 2
  },
  {
