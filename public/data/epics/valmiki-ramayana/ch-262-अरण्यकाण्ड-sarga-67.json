    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "गुहाश्च विविधा घोरा नानामृगगणाकुलाः।",
          "आवासाः किंनराणां च गन्धर्वभवनानि च॥६॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-67",
