    "slug": "valmiki-ramayana-3-sarga-67-shlok-7",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "तानि युक्तो मया सार्धं समन्वेषितुमर्हसि।",
          "त्वद्विधा बुद्धिसम्पन्ना महात्मानो नरर्षभाः॥७॥",
          "आपत्सु न प्रकम्पन्ते वायुवेगैरिवाचलाः।"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-67",
    "chapterName": "अरण्यकाण्ड, सर्ग 67",
    "verseNumber": 7
  },
