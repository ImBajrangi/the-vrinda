    "slug": "valmiki-ramayana-6-sarga-66-shlok-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "स लवयित्वा प्राकारं गिरिकूटोपमो महान्।",
          "निर्ययौ नगरात् तूर्णं कुम्भकर्णो महाबलः॥१॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-66",
    "chapterName": "युद्धकाण्ड, सर्ग 66",
    "verseNumber": 1
  },
  {
