    "slug": "valmiki-ramayana-6-sarga-66-shlok-2",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "ननाद च महानादं समुद्रमभिनादयन्।",
          "विजयन्निव निर्घातान् विधमन्निव पर्वतान्॥२॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-66",
    "chapterName": "युद्धकाण्ड, सर्ग 66",
    "verseNumber": 2
  },
  {
