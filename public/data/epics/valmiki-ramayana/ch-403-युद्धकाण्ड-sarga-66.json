    "slug": "valmiki-ramayana-6-sarga-66-shlok-3",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "तमवध्यं मघवता यमेन वरुणेन वा।",
          "प्रेक्ष्य भीमाक्षमायान्तं वानरा विप्रदुद्रुवुः॥३॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-66",
    "chapterName": "युद्धकाण्ड, सर्ग 66",
    "verseNumber": 3
  },
