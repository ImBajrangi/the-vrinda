    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "आत्मनस्तानि विस्मृत्य वीर्याण्यभिजनानि च।",
          "क्व गच्छत भयत्रस्ताः प्राकृता हरयो यथा॥५॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-66",
    "chapterName": "युद्धकाण्ड, सर्ग 66",
    "verseNumber": 5
  },
