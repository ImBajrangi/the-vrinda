    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "तांस्तु विप्रद्रुतान् दृष्ट्वा राजपुत्रोऽङ्गदोऽब्रवीत्।",
          "नलं नीलं गवाक्षं च कुमुदं च महाबलम्॥४॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-66",
    "chapterName": "युद्धकाण्ड, सर्ग 66",
    "verseNumber": 4
  },
