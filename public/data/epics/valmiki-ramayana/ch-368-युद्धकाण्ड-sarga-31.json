    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-6-sarga-31-shlok-24",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "अथ सुप्तस्य रामस्य प्रहस्तेन प्रमाथिना।",
          "असक्तं कृतहस्तेन शिरश्छिन्नं महासिना॥२४॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-31",
    "chapterName": "युद्धकाण्ड, सर्ग 31",
    "verseNumber": 24
  },
