    "slug": "valmiki-ramayana-6-sarga-31-shlok-25",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "विभीषणः समुत्पत्य निगृहीतो यदृच्छया।",
          "दिशः प्रव्राजितः सैन्यैर्लक्ष्मणः प्लवगैः सह ॥२५॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-31",
    "chapterName": "युद्धकाण्ड, सर्ग 31",
    "verseNumber": 25
  },
