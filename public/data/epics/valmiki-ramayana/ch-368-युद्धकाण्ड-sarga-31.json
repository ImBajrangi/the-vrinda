    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-6-sarga-31-shlok-19",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "संनिविष्टः समुद्रस्य पीड्य तीरमथोत्तरम्।",
          "बलेन महता रामो व्रजत्यस्तं दिवाकरे॥१९॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-31",
    "chapterName": "युद्धकाण्ड, सर्ग 31",
    "verseNumber": 19
  },
