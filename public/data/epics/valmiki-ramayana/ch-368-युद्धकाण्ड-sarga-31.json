    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-6-sarga-31-shlok-23",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "पट्टिशान् परिघांश्चक्रानृष्टीन् दण्डान् महायुधान्।",
          "बाणजालानि शूलानि भास्वरान् कूटमुद्गरान्॥२२॥",
          "यष्टीश्च तोमरान् प्रासांश्चक्राणि मुसलानि च।",
          "उद्यम्योद्यम्य रक्षोभिर्वानरेषु निपातिताः॥२३॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-31",
    "chapterName": "युद्धकाण्ड, सर्ग 31",
    "verseNumber": 23
  },
  {
    "id": "valmiki-ramayana-6-sarga-31-shlok-24",
