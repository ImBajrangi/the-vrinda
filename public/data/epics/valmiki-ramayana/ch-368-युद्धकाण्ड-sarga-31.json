[
  {
    "id": "valmiki-ramayana-6-sarga-31-shlok-2",
    "collectionId": "valmiki-ramayana",
    "index": 12169,
    "titleDevanagari": "वाल्मीकि रामायण, युद्धकाण्ड, सर्ग 31, श्लोक 2",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-6-sarga-31-shlok-2",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "ततस्तमक्षोभ्यबलं लङ्कायां नृपतेश्चराः।",
          "सुवेले राघवं शैले निविष्टं प्रत्यवेदयन्॥१॥",
          "चाराणां रावणः श्रुत्वा प्राप्तं रामं महाबलम्।",
          "जातोरेगोऽभवत् किंचित् सचिवानिदमब्रवीत्॥२॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-31",
    "chapterName": "युद्धकाण्ड, सर्ग 31",
    "verseNumber": 2
  },
  {
    "id": "valmiki-ramayana-6-sarga-31-shlok-4",
    "collectionId": "valmiki-ramayana",
    "index": 12170,
    "titleDevanagari": "वाल्मीकि रामायण, युद्धकाण्ड, सर्ग 31, श्लोक 4",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-6-sarga-31-shlok-4",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "तस्य तच्छासनं श्रुत्वा मन्त्रिणोऽभ्यागमन् द्रुतम्।",
          "ततः स मन्त्रयामास राक्षसैः सचिवैः सह ॥४॥",
          "मन्त्रयित्वा तु दुर्धर्षः क्षमं यत् तदनन्तरम्।",
          "विसर्जयित्वा सचिवान् प्रविवेश स्वमालयम्॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-31",
    "chapterName": "युद्धकाण्ड, सर्ग 31",
    "verseNumber": 4
  },
  {
    "id": "valmiki-ramayana-6-sarga-31-shlok-6",
    "collectionId": "valmiki-ramayana",
    "index": 12171,
    "titleDevanagari": "वाल्मीकि रामायण, युद्धकाण्ड, सर्ग 31, श्लोक 6",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-6-sarga-31-shlok-6",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "ततो राक्षसमादाय विद्युज्जिवं महाबलम्।",
          "मायाविनं महामायं प्राविशद् यत्र मैथिली॥६॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-31",
    "chapterName": "युद्धकाण्ड, सर्ग 31",
    "verseNumber": 6
  },
  {
    "id": "valmiki-ramayana-6-sarga-31-shlok-7",
    "collectionId": "valmiki-ramayana",
    "index": 12172,
    "titleDevanagari": "वाल्मीकि रामायण, युद्धकाण्ड, सर्ग 31, श्लोक 7",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-6-sarga-31-shlok-7",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "विद्युज्जिवं च मायाज्ञमब्रवीद् राक्षसाधिपः।",
          "मोहयिष्यावहे सीतां मायया जनकात्मजाम्॥७॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-31",
    "chapterName": "युद्धकाण्ड, सर्ग 31",
    "verseNumber": 7
  },
  {
    "id": "valmiki-ramayana-6-sarga-31-shlok-8",
    "collectionId": "valmiki-ramayana",
    "index": 12173,
    "titleDevanagari": "वाल्मीकि रामायण, युद्धकाण्ड, सर्ग 31, श्लोक 8",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-6-sarga-31-shlok-8",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "शिरो मायामयं गृह्य राघवस्य निशाचर।",
          "मां त्वं समुपतिष्ठस्व महच्च सशरं धनुः॥८॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-31",
    "chapterName": "युद्धकाण्ड, सर्ग 31",
    "verseNumber": 8
  },
  {
    "id": "valmiki-ramayana-6-sarga-31-shlok-9",
    "collectionId": "valmiki-ramayana",
    "index": 12174,
    "titleDevanagari": "वाल्मीकि रामायण, युद्धकाण्ड, सर्ग 31, श्लोक 9",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-6-sarga-31-shlok-9",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "एवमुक्तस्तथेत्याह विद्युज्जिह्वो निशाचरः।",
          "दर्शयामास तां मायां सुप्रयुक्तां स रावणे॥९॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-31",
    "chapterName": "युद्धकाण्ड, सर्ग 31",
    "verseNumber": 9
  },
  {
    "id": "valmiki-ramayana-6-sarga-31-shlok-10",
    "collectionId": "valmiki-ramayana",
    "index": 12175,
    "titleDevanagari": "वाल्मीकि रामायण, युद्धकाण्ड, सर्ग 31, श्लोक 10",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-6-sarga-31-shlok-10",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "तस्य तुष्टोऽभवद् राजा प्रददौ च विभूषणम्।",
          "अशोकवनिकायां च सीतादर्शनलालसः॥१०॥",
          "नैर्ऋतानामधिपतिः संविवेश महाबलः।"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-31",
    "chapterName": "युद्धकाण्ड, सर्ग 31",
    "verseNumber": 10
  },
  {
    "id": "valmiki-ramayana-6-sarga-31-shlok-12",
    "collectionId": "valmiki-ramayana",
    "index": 12176,
    "titleDevanagari": "वाल्मीकि रामायण, युद्धकाण्ड, सर्ग 31, श्लोक 12",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-6-sarga-31-shlok-12",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "ततो दीनामदैन्याहाँ ददर्श धनदानुजः॥११॥",
          "अधोमुखीं शोकपरामुपविष्टां महीतले।",
          "भर्तारं समनुध्यान्तीमशोकवनिकां गताम्॥१२॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-31",
    "chapterName": "युद्धकाण्ड, सर्ग 31",
    "verseNumber": 12
  },
  {
    "id": "valmiki-ramayana-6-sarga-31-shlok-13",
    "collectionId": "valmiki-ramayana",
    "index": 12177,
    "titleDevanagari": "वाल्मीकि रामायण, युद्धकाण्ड, सर्ग 31, श्लोक 13",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-6-sarga-31-shlok-13",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "उपास्यमानां घोराभी राक्षसीभिरदूरतः।",
          "उपसृत्य ततः सीतां प्रहर्षं नाम कीर्तयन्॥१३॥",
          "इदं च वचनं धृष्टमुवाच जनकात्मजाम्।"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-31",
    "chapterName": "युद्धकाण्ड, सर्ग 31",
    "verseNumber": 13
  },
  {
    "id": "valmiki-ramayana-6-sarga-31-shlok-14",
    "collectionId": "valmiki-ramayana",
    "index": 12178,
    "titleDevanagari": "वाल्मीकि रामायण, युद्धकाण्ड, सर्ग 31, श्लोक 14",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-6-sarga-31-shlok-14",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "सान्त्व्यमाना मया भद्रे यमाश्रित्य विमन्यसे॥१४॥",
          "खरहन्ता स ते भर्ता राघवः समरे हतः।"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-31",
    "chapterName": "युद्धकाण्ड, सर्ग 31",
    "verseNumber": 14
  },
  {
    "id": "valmiki-ramayana-6-sarga-31-shlok-16",
    "collectionId": "valmiki-ramayana",
    "index": 12179,
    "titleDevanagari": "वाल्मीकि रामायण, युद्धकाण्ड, सर्ग 31, श्लोक 16",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-6-sarga-31-shlok-16",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "छिन्नं ते सर्वथा मूलं दर्पश्च निहतो मया॥१५॥",
          "व्यसनेनात्मनः सीते मम भार्या भविष्यसि।",
          "विसृजैतां मतिं मूढे किं मृतेन करिष्यसि॥१६॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-31",
    "chapterName": "युद्धकाण्ड, सर्ग 31",
    "verseNumber": 16
  },
  {
    "id": "valmiki-ramayana-6-sarga-31-shlok-17",
    "collectionId": "valmiki-ramayana",
    "index": 12180,
    "titleDevanagari": "वाल्मीकि रामायण, युद्धकाण्ड, सर्ग 31, श्लोक 17",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-6-sarga-31-shlok-17",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "भवस्व भद्रे भार्याणां सर्वासामीश्वरी मम।",
          "अल्पपुण्ये निवृत्तार्थे मूढे पण्डितमानिनि।",
          "शृणु भर्तृवधं सीते घोरं वृत्रवधं यथा॥१७॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-31",
    "chapterName": "युद्धकाण्ड, सर्ग 31",
    "verseNumber": 17
  },
  {
    "id": "valmiki-ramayana-6-sarga-31-shlok-18",
    "collectionId": "valmiki-ramayana",
    "index": 12181,
    "titleDevanagari": "वाल्मीकि रामायण, युद्धकाण्ड, सर्ग 31, श्लोक 18",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-6-sarga-31-shlok-18",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "समायातः समुद्रान्तं हन्तुं मां किल राघवः।",
          "वानरेन्द्रप्रणीतेन बलेन महता वृतः॥१८॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-31",
    "chapterName": "युद्धकाण्ड, सर्ग 31",
    "verseNumber": 18
  },
  {
    "id": "valmiki-ramayana-6-sarga-31-shlok-19",
    "collectionId": "valmiki-ramayana",
