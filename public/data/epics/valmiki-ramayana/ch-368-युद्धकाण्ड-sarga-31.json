    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-6-sarga-31-shlok-20",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "अथाध्वनि परिश्रान्तमर्धरात्रे स्थितं बलम्।",
          "सुखसुप्तं समासाद्य चरितं प्रथमं चरैः॥२०॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-31",
    "chapterName": "युद्धकाण्ड, सर्ग 31",
    "verseNumber": 20
  },
  {
    "id": "valmiki-ramayana-6-sarga-31-shlok-21",
