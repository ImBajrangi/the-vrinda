    "slug": "valmiki-ramayana-2-sarga-13-shlok-2",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "अतदर्ह महाराजं शयानमतथोचितम्।",
          "ययातिमिव पुण्यान्ते देवलोकात् परिच्युतम्॥",
          "अनर्थरूपासिद्धार्था ह्यभीता भयदर्शिनी।",
          "पुनराकारयामास तमेव वरमङ्गना॥२॥"
        ]
      }
    ],
    "chapterId": "अयोध्याकाण्ड-sarga-13",
    "chapterName": "अयोध्याकाण्ड, सर्ग 13",
    "verseNumber": 2
  },
