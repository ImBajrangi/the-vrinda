      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "अथान्तर्गृहमाविश्य राजा दशरथस्तदा।",
          "सूतमामन्त्रयामास रामं पुनरिहानय॥३॥"
        ]
      }
    ],
    "chapterId": "अयोध्याकाण्ड-sarga-4",
    "chapterName": "अयोध्याकाण्ड, सर्ग 4",
    "verseNumber": 3
  },
  {
