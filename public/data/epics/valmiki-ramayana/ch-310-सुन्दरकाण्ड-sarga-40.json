    "slug": "valmiki-ramayana-5-sarga-40-shlok-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "श्रुत्वा तु वचनं तस्य वायुसूनोर्महात्मनः।",
          "उवाचात्महितं वाक्यं सीता सुरसुतोपमा॥१॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-40",
    "chapterName": "सुन्दरकाण्ड, सर्ग 40",
    "verseNumber": 1
  },
  {
