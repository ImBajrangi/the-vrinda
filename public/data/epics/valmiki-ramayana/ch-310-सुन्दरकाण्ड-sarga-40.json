    "slug": "valmiki-ramayana-5-sarga-40-shlok-2",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "त्वां दृष्ट्वा प्रियवक्तारं सम्प्रहृष्यामि वानर।",
          "अर्धसंजातसस्येव वृष्टिं प्राप्य वसुंधरा ॥२॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-40",
    "chapterName": "सुन्दरकाण्ड, सर्ग 40",
    "verseNumber": 2
  },
  {
