    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "दत्त्वा तु सह वैदेह्या ब्राह्मणेभ्यो धनं बहु।",
          "जग्मतुः पितरं द्रष्टं सीतया सह राघवौ॥१॥"
        ]
      }
    ],
    "chapterId": "अयोध्याकाण्ड-sarga-33",
    "chapterName": "अयोध्याकाण्ड, सर्ग 33",
    "verseNumber": 1
  },
