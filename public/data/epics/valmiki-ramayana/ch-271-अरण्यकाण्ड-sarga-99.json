    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-99-shlok-20",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "उवाच वाक्यं रुदती भगवन् राघवं प्रति।",
          "सह भ्रात्रा महाबाहुर्दिष्ट्या मे श्रुतिमागतः॥२०॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-99",
    "chapterName": "अरण्यकाण्ड, सर्ग 99",
    "verseNumber": 20
  },
  {
