    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-99-shlok-19",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "सीताया वचनं श्रुत्वा तथा चक्रे शचीपतिः।",
          "पृथिवीं नास्पृशत् पद्भ्यामनिमेषेक्षणानि च॥ १८॥",
          "अरजोऽम्बरधारी च न म्लानकुसुमस्तथा।",
          "तं ज्ञात्वा लक्षणैः सीता वासवं परिहर्षिता॥ १९॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-99",
    "chapterName": "अरण्यकाण्ड, सर्ग 99",
    "verseNumber": 19
  },
  {
    "id": "valmiki-ramayana-3-sarga-99-shlok-20",
    "collectionId": "valmiki-ramayana",
    "index": 8792,
