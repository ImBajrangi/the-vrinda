    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-99-shlok-22",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "तवाज्ञया च देवेन्द्र पयोभूतमिदं हविः।",
          "अशिष्यामि त्वया दत्तं रघूणां कुलवर्धनम्॥ २२॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-99",
