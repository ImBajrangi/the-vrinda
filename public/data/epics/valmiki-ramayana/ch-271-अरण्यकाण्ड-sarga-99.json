    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-99-shlok-21",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "यथा मे श्वशुरो राजा यथा च मिथिलाधिपः।",
          "तथा त्वामद्य पश्यामि सनाथो मे पतिस्त्वया॥ २१॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-99",
    "chapterName": "अरण्यकाण्ड, सर्ग 99",
    "verseNumber": 21
  },
  {
