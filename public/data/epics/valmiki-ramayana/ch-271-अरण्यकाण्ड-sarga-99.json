    "titleDevanagari": "वाल्मीकि रामायण, अरण्यकाण्ड, सर्ग 99, श्लोक 13",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-99-shlok-13",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "मत्प्रसादात् समुद्रं स तरिष्यति बलैः सह।",
          "मयैवेह च राक्षस्यो मायया मोहिताः शुभे॥१३॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-99",
    "chapterName": "अरण्यकाण्ड, सर्ग 99",
    "verseNumber": 13
  },
  {
    "id": "valmiki-ramayana-3-sarga-99-shlok-14",
    "collectionId": "valmiki-ramayana",
    "index": 8788,
    "titleDevanagari": "वाल्मीकि रामायण, अरण्यकाण्ड, सर्ग 99, श्लोक 14",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-99-shlok-14",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "तस्मादन्नमिदं सीते हविष्यान्नमहं स्वयम्।",
          "स त्वां संगृह्य वैदेहि आगतः सह निद्रया॥१४॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-99",
    "chapterName": "अरण्यकाण्ड, सर्ग 99",
    "verseNumber": 14
  },
  {
