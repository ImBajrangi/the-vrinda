    "titleDevanagari": "वाल्मीकि रामायण, अरण्यकाण्ड, सर्ग 99, श्लोक 1",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-99-shlok-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "प्रवेशितायां सीतायां लङ्कां प्रति पितामहः।",
          "तदा प्रोवाच देवेन्द्र परितुष्टं शतक्रतुम्॥१॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-99",
    "chapterName": "अरण्यकाण्ड, सर्ग 99",
    "verseNumber": 1
  },
  {
    "id": "valmiki-ramayana-3-sarga-99-shlok-2",
    "collectionId": "valmiki-ramayana",
    "index": 8778,
    "titleDevanagari": "वाल्मीकि रामायण, अरण्यकाण्ड, सर्ग 99, श्लोक 2",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-99-shlok-2",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "त्रैलोक्यस्य हितार्थाय रक्षसामहिताय च।",
          "लङ्कां प्रवेशिता सीता रावणेन दुरात्मना॥२॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-99",
    "chapterName": "अरण्यकाण्ड, सर्ग 99",
    "verseNumber": 2
  },
  {
    "id": "valmiki-ramayana-3-sarga-99-shlok-3",
    "collectionId": "valmiki-ramayana",
    "index": 8779,
    "titleDevanagari": "वाल्मीकि रामायण, अरण्यकाण्ड, सर्ग 99, श्लोक 3",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-99-shlok-3",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "पतिव्रता महाभागा नित्यं चैव सुखैधिता।",
          "अपश्यन्ती च भर्तारं पश्यन्ती राक्षसीजनम्॥३॥",
          "राक्षसीभिः परिवृता भर्तृदर्शनलालसा।"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-99",
    "chapterName": "अरण्यकाण्ड, सर्ग 99",
    "verseNumber": 3
  },
  {
    "id": "valmiki-ramayana-3-sarga-99-shlok-4",
    "collectionId": "valmiki-ramayana",
    "index": 8780,
    "titleDevanagari": "वाल्मीकि रामायण, अरण्यकाण्ड, सर्ग 99, श्लोक 4",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-99-shlok-4",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "निविष्टा हि पुरी लङ्का तीरे नदनदीपतेः॥४॥",
          "कथं ज्ञास्यति तां रामस्तत्रस्थां तामनिन्दिताम्।"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-99",
    "chapterName": "अरण्यकाण्ड, सर्ग 99",
    "verseNumber": 4
  },
  {
    "id": "valmiki-ramayana-3-sarga-99-shlok-6",
    "collectionId": "valmiki-ramayana",
    "index": 8781,
    "titleDevanagari": "वाल्मीकि रामायण, अरण्यकाण्ड, सर्ग 99, श्लोक 6",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-99-shlok-6",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "दुःखं संचिन्तयन्ती सा बहुशः परिदुर्लभा॥५॥",
          "प्राणयात्रामकुर्वाणा प्राणांस्त्यक्ष्यत्यसंशयम्।",
          "स भूयः संशयो जातः सीतायाः प्राणसंक्षये॥ ६॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-99",
    "chapterName": "अरण्यकाण्ड, सर्ग 99",
    "verseNumber": 6
  },
  {
    "id": "valmiki-ramayana-3-sarga-99-shlok-7",
    "collectionId": "valmiki-ramayana",
    "index": 8782,
    "titleDevanagari": "वाल्मीकि रामायण, अरण्यकाण्ड, सर्ग 99, श्लोक 7",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-99-shlok-7",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "स त्वं शीघ्रमितो गत्वा सीतां पश्य शुभाननाम्।",
          "प्रविश्य नगरी लङ्कां प्रयच्छ हविरुत्तमम्॥७॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-99",
    "chapterName": "अरण्यकाण्ड, सर्ग 99",
    "verseNumber": 7
  },
  {
    "id": "valmiki-ramayana-3-sarga-99-shlok-8",
    "collectionId": "valmiki-ramayana",
    "index": 8783,
    "titleDevanagari": "वाल्मीकि रामायण, अरण्यकाण्ड, सर्ग 99, श्लोक 8",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-99-shlok-8",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "एवमुक्तोऽथ देवेन्द्रः पुरीं रावणपालिताम्।",
          "आगच्छन्निद्रया सार्धं भगवान् पाकशासनः॥८॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-99",
    "chapterName": "अरण्यकाण्ड, सर्ग 99",
    "verseNumber": 8
  },
  {
    "id": "valmiki-ramayana-3-sarga-99-shlok-9",
    "collectionId": "valmiki-ramayana",
    "index": 8784,
    "titleDevanagari": "वाल्मीकि रामायण, अरण्यकाण्ड, सर्ग 99, श्लोक 9",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-99-shlok-9",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "निद्रां चोवाच गच्छ त्वं राक्षसान् सम्प्रमोहय।",
          "सा तथोक्ता मघवता देवी परमहर्षिता॥९॥",
          "देवकार्यार्थसिद्ध्यर्थं प्रामोहयत राक्षसान्।"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-99",
    "chapterName": "अरण्यकाण्ड, सर्ग 99",
    "verseNumber": 9
  },
  {
    "id": "valmiki-ramayana-3-sarga-99-shlok-10",
    "collectionId": "valmiki-ramayana",
    "index": 8785,
    "titleDevanagari": "वाल्मीकि रामायण, अरण्यकाण्ड, सर्ग 99, श्लोक 10",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-99-shlok-10",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "एतस्मिन्नन्तरे देवः सहस्राक्षः शचीपतिः॥१०॥",
          "आससाद वनस्थां तां वचनं चेदमब्रवीत्।"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-99",
    "chapterName": "अरण्यकाण्ड, सर्ग 99",
    "verseNumber": 10
  },
  {
    "id": "valmiki-ramayana-3-sarga-99-shlok-12",
    "collectionId": "valmiki-ramayana",
