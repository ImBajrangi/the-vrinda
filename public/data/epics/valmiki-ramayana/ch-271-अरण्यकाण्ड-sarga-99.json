    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-99-shlok-15",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "एतदत्स्यसि मद्धस्तान्न त्वां बाधिष्यते शुभे।",
          "क्षुधा तृषा च रम्भोरु वर्षाणामयुतैरपि॥१५॥",
          "एवमुक्ता तु देवेन्द्रमुवाच परिशङ्किता।",
          "कथं जानामि देवेन्द्रं त्वामिहस्थं शचीपतिम्॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-99",
    "chapterName": "अरण्यकाण्ड, सर्ग 99",
    "verseNumber": 15
  },
