    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-99-shlok-17",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "देवलिङ्गानि दृष्टानि रामलक्ष्मणसंनिधौ।",
          "तानि दर्शय देवेन्द्र यदि त्वं देवराट् स्वयम्॥ १७॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-99",
    "chapterName": "अरण्यकाण्ड, सर्ग 99",
    "verseNumber": 17
  },
