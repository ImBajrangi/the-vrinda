    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "रामस्य तु वचः श्रुत्वा मुनिवेषधरं च तम्।",
          "समीक्ष्य सह भार्याभी राजा विगतचेतनः॥१॥"
        ]
      }
    ],
    "chapterId": "अयोध्याकाण्ड-sarga-39",
    "chapterName": "अयोध्याकाण्ड, सर्ग 39",
