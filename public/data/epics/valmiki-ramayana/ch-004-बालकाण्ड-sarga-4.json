    "slug": "valmiki-ramayana-1-sarga-4-shlok-1-2",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "श्रुत्वागस्त्येरितं वाक्यं रामो विस्मयमागतः।",
          "कथमासीत् तु लङ्कायां सम्भवो रक्षसां पुरा॥१॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-4",
    "chapterName": "बालकाण्ड, सर्ग 4",
    "verseNumber": 1
  },
  {
    "id": "valmiki-ramayana-1-sarga-4-shlok-2-1",
    "collectionId": "valmiki-ramayana",
    "index": 208,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 4, श्लोक 2",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-4-shlok-2-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "भाव्यो राज्यागमस्तस्य सुग्रीवस्य महात्मनः।",
          "यदयं कृत्यवान् प्राप्तः कृत्यं चैतदुपागतम्॥२॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-4",
    "chapterName": "बालकाण्ड, सर्ग 4",
    "verseNumber": 2
  },
  {
    "id": "valmiki-ramayana-1-sarga-4-shlok-3-2",
    "collectionId": "valmiki-ramayana",
    "index": 209,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 4, श्लोक 3",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-4-shlok-3-2",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "भगवन् पूर्वमप्येषा लङ्काऽऽसीत् पिशिताशिनाम्।",
          "श्रुत्वेदं भगवद्वाक्यं जातो मे विस्मयः परः॥३॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-4",
    "chapterName": "बालकाण्ड, सर्ग 4",
    "verseNumber": 3
  },
  {
    "id": "valmiki-ramayana-1-sarga-4-shlok-4-1",
    "collectionId": "valmiki-ramayana",
    "index": 210,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 4, श्लोक 4",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-4-shlok-4-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "॥ श्रीसीतारामचन्द्राभ्यां नमः॥",
          "श्रीमद्वाल्मीकीय रामायण",
          "किष्किन्धाकाण्डम्",
          "चतुर्थः सर्गः (सर्ग 4)",
          "किमर्थं त्वं वनं घोरं पम्पाकाननमण्डितम्।",
          "आगतः सानुजो दुर्गं नानाव्यालमृगायुतम्॥४॥",
          "इत्याचे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये किष्किन्धाकाण्डे चतुर्थः सर्गः॥४॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-4",
    "chapterName": "बालकाण्ड, सर्ग 4",
    "verseNumber": 4
  },
  {
    "id": "valmiki-ramayana-1-sarga-4-shlok-5-2",
    "collectionId": "valmiki-ramayana",
    "index": 211,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 4, श्लोक 5",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-4-shlok-5-2",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "रावणात् कुम्भकर्णाश्च प्रहस्ताद् विकटादपि।",
          "रावणस्य च पुत्रेभ्यः किं नु ते बलवत्तराः॥५॥",
          "क एषां पूर्वको ब्रह्मन् किंनामा च बलोत्कटः।",
          "अपराधं च कं प्राप्य विष्णुना द्राविताः कथम्॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-4",
    "chapterName": "बालकाण्ड, सर्ग 4",
    "verseNumber": 5
  },
  {
    "id": "valmiki-ramayana-1-sarga-4-shlok-6",
