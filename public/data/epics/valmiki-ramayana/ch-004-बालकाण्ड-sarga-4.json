    "slug": "valmiki-ramayana-1-sarga-4-shlok-24",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "ततः सा राक्षसी गर्भं घनगर्भसमप्रभम्।",
          "प्रसूता मन्दरं गत्वा गङ्गा गर्भमिवाग्निजम्।",
          "समुत्सृज्य तु सा गर्भ विद्युत्केशरतार्थिनी॥२४॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-4",
    "chapterName": "बालकाण्ड, सर्ग 4",
    "verseNumber": 24
  },
