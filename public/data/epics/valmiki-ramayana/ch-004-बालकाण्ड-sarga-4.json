    "slug": "valmiki-ramayana-1-sarga-4-shlok-31-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "उमयापि वरो दत्तो राक्षसीनां नृपात्मज॥३०॥",
          "सद्योपलब्धिर्गर्भस्य प्रसूतिः सद्य एव च।",
          "सद्य एव वयःप्राप्तिं मातुरेव वयःसमम्॥३१॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-4",
    "chapterName": "बालकाण्ड, सर्ग 4",
    "verseNumber": 31
  },
