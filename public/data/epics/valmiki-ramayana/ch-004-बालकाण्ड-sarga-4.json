    "slug": "valmiki-ramayana-1-sarga-4-shlok-29",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "अमरं चैव तं कृत्वा महादेवोऽक्षरोऽव्ययः॥२९॥",
          "पुरमाकाशगं प्रादात् पार्वत्याः प्रियकाम्यया।"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-4",
    "chapterName": "बालकाण्ड, सर्ग 4",
    "verseNumber": 29
