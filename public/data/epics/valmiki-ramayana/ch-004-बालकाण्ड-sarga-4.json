    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "स हि राज्याश्च विभ्रष्टः कृतवैरश्च वालिना।",
          "हृतदारो वने त्रस्तो भ्रात्रा विनिकृतो भृशम्॥ २७॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-4",
    "chapterName": "बालकाण्ड, सर्ग 4",
    "verseNumber": 27
  },
  {
