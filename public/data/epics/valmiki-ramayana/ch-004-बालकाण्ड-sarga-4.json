    "slug": "valmiki-ramayana-1-sarga-4-shlok-25",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "रेमे तु सार्धं पतिना विस्मृत्य सुतमात्मजम्।",
          "उत्सृष्टस्तु तदा गर्भो घनशब्दसमस्वनः॥२५॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-4",
    "chapterName": "बालकाण्ड, सर्ग 4",
    "verseNumber": 25
  },
