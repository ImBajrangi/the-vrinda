    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "एतद् विस्तरतः सर्वं कथयस्व ममानघ।",
          "कुतूहलमिदं मह्यं नुद भानुर्यथा तमः॥७॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-4",
    "chapterName": "बालकाण्ड, सर्ग 4",
    "verseNumber": 7
  },
