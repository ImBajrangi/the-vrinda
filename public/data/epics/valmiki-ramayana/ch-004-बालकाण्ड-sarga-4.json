    "slug": "valmiki-ramayana-1-sarga-4-shlok-6",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "राजा दशरथो नाम द्युतिमान् धर्मवत्सलः।",
          "चातुर्वण्र्यं स्वधर्मेण नित्यमेवाभिपालयन्॥६॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-4",
    "chapterName": "बालकाण्ड, सर्ग 4",
    "verseNumber": 6
  },
