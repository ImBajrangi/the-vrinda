[
  {
    "id": "valmiki-ramayana-1-sarga-4-shlok-1-2",
    "collectionId": "valmiki-ramayana",
    "index": 207,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 4, श्लोक 1",
