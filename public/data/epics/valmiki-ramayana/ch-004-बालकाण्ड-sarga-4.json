    "slug": "valmiki-ramayana-1-sarga-4-shlok-21",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "अवश्यमेव दातव्या परस्मै सेति संध्यया।",
          "चिन्तयित्वा सुता दत्ता विद्युत्केशाय राघव॥२१॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-4",
    "chapterName": "बालकाण्ड, सर्ग 4",
    "verseNumber": 21
  },
  {
