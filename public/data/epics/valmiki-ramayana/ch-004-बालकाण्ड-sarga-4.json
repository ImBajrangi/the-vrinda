    "slug": "valmiki-ramayana-1-sarga-4-shlok-22-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "संध्यायास्तनयां लब्ध्वा विद्युत्केशो निशाचरः।",
          "रमते स तया सार्धं पौलोम्या मघवानिव॥२२॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-4",
    "chapterName": "बालकाण्ड, सर्ग 4",
    "verseNumber": 22
  },
  {
