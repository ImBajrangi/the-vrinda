    "slug": "valmiki-ramayana-3-sarga-71-shlok-13",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "स एवमुक्तः शक्रो मे बाहू योजनमायतौ॥१३॥",
          "तदा चास्यं च मे कुक्षौ तीक्ष्णदंष्ट्रमकल्पयत् ।"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-71",
    "chapterName": "अरण्यकाण्ड, सर्ग 71",
    "verseNumber": 13
  },
