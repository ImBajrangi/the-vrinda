    "titleDevanagari": "वाल्मीकि रामायण, अरण्यकाण्ड, सर्ग 71, श्लोक 1",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-71-shlok-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "पुरा राम महाबाहो महाबलपराक्रमम्।",
          "रूपमासीन्ममाचिन्त्यं त्रिषु लोकेषु विश्रुतम्॥१॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-71",
    "chapterName": "अरण्यकाण्ड, सर्ग 71",
    "verseNumber": 1
  },
  {
    "id": "valmiki-ramayana-3-sarga-71-shlok-2",
    "collectionId": "valmiki-ramayana",
    "index": 8659,
    "titleDevanagari": "वाल्मीकि रामायण, अरण्यकाण्ड, सर्ग 71, श्लोक 2",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-71-shlok-2",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "यथा सूर्यस्य सोमस्य शक्रस्य च यथा वपुः।",
          "सोऽहं रूपमिदं कृत्वा लोकवित्रासनं महत्॥२॥",
          "ऋषीन् वनगतान् राम त्रासयामि ततस्ततः।"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-71",
    "chapterName": "अरण्यकाण्ड, सर्ग 71",
    "verseNumber": 2
  },
  {
    "id": "valmiki-ramayana-3-sarga-71-shlok-4",
    "collectionId": "valmiki-ramayana",
    "index": 8660,
    "titleDevanagari": "वाल्मीकि रामायण, अरण्यकाण्ड, सर्ग 71, श्लोक 4",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-71-shlok-4",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "ततः स्थूलशिरा नाम महर्षिः कोपितो मया ॥३॥",
          "स चिन्वन् विविधं वन्यं रूपेणानेन धर्षितः।",
          "तेनाहमुक्तः प्रेक्ष्यैवं घोरशापाभिधायिना॥४॥",
          "एतदेवं नृशंसं ते रूपमस्तु विगर्हितम्।",
          "स मया याचितः क्रुद्धः शापस्यान्तो भवेदिति॥",
          "अभिशापकृतस्येति तेनेदं भाषितं वचः।"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-71",
    "chapterName": "अरण्यकाण्ड, सर्ग 71",
    "verseNumber": 4
  },
  {
    "id": "valmiki-ramayana-3-sarga-71-shlok-7",
    "collectionId": "valmiki-ramayana",
    "index": 8661,
    "titleDevanagari": "वाल्मीकि रामायण, अरण्यकाण्ड, सर्ग 71, श्लोक 7",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-71-shlok-7",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "यदा छित्त्वा भुजौ रामस्त्वां दहेद् विजने वने॥ ६॥",
          "तदा त्वं प्राप्स्यसे रूपं स्वमेव विपुलं शुभम्।",
          "श्रिया विराजितं पुत्रं दनोस्त्वं विद्धि लक्ष्मण॥ ७॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-71",
    "chapterName": "अरण्यकाण्ड, सर्ग 71",
    "verseNumber": 7
  },
  {
    "id": "valmiki-ramayana-3-sarga-71-shlok-9",
    "collectionId": "valmiki-ramayana",
    "index": 8662,
    "titleDevanagari": "वाल्मीकि रामायण, अरण्यकाण्ड, सर्ग 71, श्लोक 9",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-71-shlok-9",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "इन्द्रकोपादिदं रूपं प्राप्तमेवं रणाजिरे।",
          "अहं हि तपसोग्रेण पितामहमतोषयम्॥८॥",
          "दीर्घमायुः स मे प्रादात् ततो मां विभ्रमोऽस्पृशत् ।",
          "दीर्घमायुर्मया प्राप्तं किं मां शक्रः करिष्यति॥ ९॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-71",
    "chapterName": "अरण्यकाण्ड, सर्ग 71",
    "verseNumber": 9
  },
  {
    "id": "valmiki-ramayana-3-sarga-71-shlok-10",
    "collectionId": "valmiki-ramayana",
    "index": 8663,
    "titleDevanagari": "वाल्मीकि रामायण, अरण्यकाण्ड, सर्ग 71, श्लोक 10",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-71-shlok-10",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "इत्येवं बुद्धिमास्थाय रणे शक्रमधर्षयम्।",
          "तस्य बाहुप्रमुक्तेन वज्रेण शतपर्वणा॥१०॥",
          "सक्थिनी च शिरश्चैव शरीरे सम्प्रवेशितम्।",
          "स मया याच्यमानः सन् नानयद् यमसादनम्॥ ११॥",
          "पितामहवचः सत्यं तदस्त्विति ममाब्रवीत्।",
          "अनाहारः कथं शक्तो भग्नसक्थिशिरोमुखः॥ १२॥",
          "वज्रेणाभिहतः कालं सुदीर्घमपि जीवितुम्।"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-71",
    "chapterName": "अरण्यकाण्ड, सर्ग 71",
    "verseNumber": 10
  },
