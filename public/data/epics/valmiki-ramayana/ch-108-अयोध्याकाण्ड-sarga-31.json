    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "एवं श्रुत्वा स संवादं लक्ष्मणः पूर्वमागतः।",
          "बाष्पपर्याकुलमुखः शोकं सोढुमशक्नुवन्॥१॥"
        ]
      }
    ],
    "chapterId": "अयोध्याकाण्ड-sarga-31",
    "chapterName": "अयोध्याकाण्ड, सर्ग 31",
    "verseNumber": 1
  },
