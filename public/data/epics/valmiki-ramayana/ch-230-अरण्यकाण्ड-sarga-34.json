    "titleDevanagari": "वाल्मीकि रामायण, अरण्यकाण्ड, सर्ग 34, श्लोक 1",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-34-shlok-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "ततः शूर्पणखां दृष्ट्वा ब्रुवन्तीं परुषं वचः।",
          "अमात्यमध्ये संक्रुद्धः परिपप्रच्छ रावणः॥१॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-34",
    "chapterName": "अरण्यकाण्ड, सर्ग 34",
    "verseNumber": 1
  },
  {
    "id": "valmiki-ramayana-3-sarga-34-shlok-2",
    "collectionId": "valmiki-ramayana",
    "index": 7683,
    "titleDevanagari": "वाल्मीकि रामायण, अरण्यकाण्ड, सर्ग 34, श्लोक 2",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-34-shlok-2",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "कश्च रामः कथंवीर्यः किंरूपः किंपराक्रमः।",
          "किमर्थं दण्डकारण्यं प्रविष्टश्च सुदुस्तरम्॥२॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-34",
    "chapterName": "अरण्यकाण्ड, सर्ग 34",
    "verseNumber": 2
  },
  {
    "id": "valmiki-ramayana-3-sarga-34-shlok-3",
    "collectionId": "valmiki-ramayana",
    "index": 7684,
    "titleDevanagari": "वाल्मीकि रामायण, अरण्यकाण्ड, सर्ग 34, श्लोक 3",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-34-shlok-3",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "आयुधं किं च रामस्य येन ते राक्षसा हताः।",
          "खरश्च निहतः संख्ये दूषणस्त्रिशिरास्तथा ॥३॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-34",
    "chapterName": "अरण्यकाण्ड, सर्ग 34",
    "verseNumber": 3
  },
  {
    "id": "valmiki-ramayana-3-sarga-34-shlok-4",
    "collectionId": "valmiki-ramayana",
    "index": 7685,
    "titleDevanagari": "वाल्मीकि रामायण, अरण्यकाण्ड, सर्ग 34, श्लोक 4",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-34-shlok-4",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "तत्त्वं ब्रूहि मनोज्ञाङ्गि केन त्वं च विरूपिता।",
          "इत्युक्ता राक्षसेन्द्रेण राक्षसी क्रोधमूर्च्छिता॥४॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-34",
    "chapterName": "अरण्यकाण्ड, सर्ग 34",
    "verseNumber": 4
  },
  {
    "id": "valmiki-ramayana-3-sarga-34-shlok-5",
    "collectionId": "valmiki-ramayana",
    "index": 7686,
    "titleDevanagari": "वाल्मीकि रामायण, अरण्यकाण्ड, सर्ग 34, श्लोक 5",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-34-shlok-5",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "ततो रामं यथान्यायमाख्यातुमुपचक्रमे।",
          "दीर्घबाहुर्विशालाक्षश्चीरकृष्णाजिनाम्बरः॥५॥",
          "कन्दर्पसमरूपश्च रामो दशरथात्मजः।।"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-34",
    "chapterName": "अरण्यकाण्ड, सर्ग 34",
    "verseNumber": 5
  },
  {
    "id": "valmiki-ramayana-3-sarga-34-shlok-6",
    "collectionId": "valmiki-ramayana",
    "index": 7687,
    "titleDevanagari": "वाल्मीकि रामायण, अरण्यकाण्ड, सर्ग 34, श्लोक 6",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-34-shlok-6",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "शक्रचापनिभं चापं विकृष्य कनकाङ्गदम्॥६॥",
          "दीप्तान् क्षिपति नाराचान् सर्पानिव महाविषान्।",
          "नाददानं शरान् घोरान् विमुञ्चन्तं महाबलम्॥ ७॥",
          "न कार्मुकं विकर्षन्तं रामं पश्यामि संयुगे।"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-34",
    "chapterName": "अरण्यकाण्ड, सर्ग 34",
    "verseNumber": 6
  },
  {
    "id": "valmiki-ramayana-3-sarga-34-shlok-8",
    "collectionId": "valmiki-ramayana",
    "index": 7688,
    "titleDevanagari": "वाल्मीकि रामायण, अरण्यकाण्ड, सर्ग 34, श्लोक 8",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-34-shlok-8",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "हन्यमानं तु तत्सैन्यं पश्यामि शरवृष्टिभिः॥८॥",
          "इन्द्रेणेवोत्तमं सस्यमाहतं त्वश्मवृष्टिभिः।।"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-34",
    "chapterName": "अरण्यकाण्ड, सर्ग 34",
    "verseNumber": 8
  },
  {
