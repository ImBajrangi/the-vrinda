    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "तां तु विस्तीर्णजघनां पीनोत्तुङ्गपयोधराम्।",
          "भार्यार्थे तु तवानेतुमुद्यताहं वराननाम्॥२१॥",
          "विरूपितास्मि क्रूरेण लक्ष्मणेन महाभुज।"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-34",
