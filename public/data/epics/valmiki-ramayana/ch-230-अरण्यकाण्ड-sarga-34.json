    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-34-shlok-12",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "एका कथंचिन्मुक्ताहं परिभूय महात्मना।",
          "स्त्रीवधं शङ्कमानेन रामेण विदितात्मना॥१२॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-34",
    "chapterName": "अरण्यकाण्ड, सर्ग 34",
    "verseNumber": 12
  },
  {
