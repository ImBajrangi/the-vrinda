    "slug": "valmiki-ramayana-3-sarga-34-shlok-19",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "यस्य सीता भवेद् भार्या यं च हृष्टा परिष्वजेत्।",
          "अभिजीवेत् स सर्वेषु लोकेष्वपि पुरंदरात्॥१९॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-34",
