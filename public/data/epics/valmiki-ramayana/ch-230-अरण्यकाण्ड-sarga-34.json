    "slug": "valmiki-ramayana-3-sarga-34-shlok-15",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "रामस्य तु विशालाक्षी पूर्णेन्दुसदृशानना।",
          "धर्मपत्नी प्रिया नित्यं भर्तुः प्रियहिते रता॥१५॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-34",
    "chapterName": "अरण्यकाण्ड, सर्ग 34",
    "verseNumber": 15
  },
