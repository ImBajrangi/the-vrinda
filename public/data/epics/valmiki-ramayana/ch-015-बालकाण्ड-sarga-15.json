    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "रावणं जहि यक्षेन्द्र दुर्वृत्तं पापचेतसम्।",
          "शरणं भव वीराणां यक्षाणां युद्धशालिनाम्॥२॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-15",
    "chapterName": "बालकाण्ड, सर्ग 15",
    "verseNumber": 2
  },
  {
