        "stanzaNumber": 1,
        "linesDevanagari": [
          "धूम्राक्षेण समागम्य माणिभद्रो महारणे।",
          "मुसलेनोरसि क्रोधात् ताडितो न च कम्पितः॥१०॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-15",
    "chapterName": "बालकाण्ड, सर्ग 15",
    "verseNumber": 10
