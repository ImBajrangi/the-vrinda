    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "अथ तस्य निनादं तं सुग्रीवस्य महात्मनः।",
          "शुश्रावान्तःपुरगतो वाली भ्रातुरमर्षणः॥१॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-15",
    "chapterName": "बालकाण्ड, सर्ग 15",
    "verseNumber": 1
  },
  {
