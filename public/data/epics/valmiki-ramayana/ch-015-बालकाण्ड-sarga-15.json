    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "एवमुक्तो महाबाहुर्माणिभद्रः सुदुर्जयः।",
          "वृतो यक्षसहस्रैस्तु चतुर्भिः समयोधयत्॥३॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-15",
    "chapterName": "बालकाण्ड, सर्ग 15",
    "verseNumber": 3
  },
