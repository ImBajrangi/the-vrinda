    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "कृतदारोऽस्मि भवति भार्येयं दयिता मम।",
          "त्वद्विधानां तु नारीणां सुदुःखा ससपत्नता॥२॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-18",
    "chapterName": "अरण्यकाण्ड, सर्ग 18",
