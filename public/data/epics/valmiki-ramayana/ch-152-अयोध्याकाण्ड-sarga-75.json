    "slug": "valmiki-ramayana-2-sarga-75-shlok-5",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "तथैव क्रोशतस्तस्य भरतस्य महात्मनः।",
          "कौसल्या शब्दमाज्ञाय सुमित्रां चेदमब्रवीत्॥५॥"
        ]
      }
    ],
    "chapterId": "अयोध्याकाण्ड-sarga-75",
    "chapterName": "अयोध्याकाण्ड, सर्ग 75",
    "verseNumber": 5
  },
  {
