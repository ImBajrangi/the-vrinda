    "slug": "valmiki-ramayana-2-sarga-75-shlok-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "दीर्घकालात् समुत्थाय संज्ञां लब्ध्वा स वीर्यवान्।",
          "नेत्राभ्यामश्रुपूर्णाभ्यां दीनामुद्रीक्ष्य मातरम्॥१॥",
          "सोऽमात्यमध्ये भरतो जननीमभ्यकुत्सयत्।"
        ]
      }
    ],
    "chapterId": "अयोध्याकाण्ड-sarga-75",
    "chapterName": "अयोध्याकाण्ड, सर्ग 75",
    "verseNumber": 1
  },
  {
    "id": "valmiki-ramayana-2-sarga-75-shlok-3",
    "collectionId": "valmiki-ramayana",
    "index": 5520,
    "titleDevanagari": "वाल्मीकि रामायण, अयोध्याकाण्ड, सर्ग 75, श्लोक 3",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-2-sarga-75-shlok-3",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "राज्यं न कामये जातु मन्त्रये नापि मातरम्॥२॥",
          "अभिषेकं न जानामि योऽभूद् राज्ञा समीक्षितः।",
          "विप्रकृष्ट ह्यहं देशे शत्रुघ्नसहितोऽभवम्॥३॥"
        ]
      }
    ],
    "chapterId": "अयोध्याकाण्ड-sarga-75",
    "chapterName": "अयोध्याकाण्ड, सर्ग 75",
    "verseNumber": 3
  },
  {
