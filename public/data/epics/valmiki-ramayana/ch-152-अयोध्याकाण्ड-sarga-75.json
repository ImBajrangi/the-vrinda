    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-2-sarga-75-shlok-4",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "वनवासं न जानामि रामस्याहं महात्मनः।",
          "विवासनं च सौमित्रेः सीतायाश्च यथाभवत्॥ ४ ॥"
        ]
      }
    ],
    "chapterId": "अयोध्याकाण्ड-sarga-75",
    "chapterName": "अयोध्याकाण्ड, सर्ग 75",
    "verseNumber": 4
  },
  {
