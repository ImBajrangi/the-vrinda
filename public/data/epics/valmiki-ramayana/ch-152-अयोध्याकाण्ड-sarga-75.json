        "stanzaNumber": 1,
        "linesDevanagari": [
          "आगतः क्रूरकार्यायाः कैकेय्या भरतः सुतः।",
          "तमहं द्रष्टमिच्छामि भरतं दीर्घदर्शिनम्॥६॥"
        ]
      }
    ],
    "chapterId": "अयोध्याकाण्ड-sarga-75",
    "chapterName": "अयोध्याकाण्ड, सर्ग 75",
    "verseNumber": 6
  },
  {
