    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "ततः शत्रुघ्नभरतौ कौसल्या प्रेक्ष्य दुःखितौ।",
          "पर्यष्वजेतां दुःखार्ता पतितां नष्टचेतनाम्॥९॥",
          "रुदन्तौ रुदती दुःखात् समेत्यार्या मनस्विनी।",
          "भरतं प्रत्युवाचेदं कौसल्या भृशदुःखिता॥१०॥"
        ]
      }
    ],
