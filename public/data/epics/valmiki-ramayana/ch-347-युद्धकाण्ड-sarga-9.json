      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "॥ श्रीसीतारामचन्द्राभ्यां नमः॥",
          "श्रीमद्वाल्मीकीय रामायण",
          "युद्धकाण्डम्",
          "नवमः सर्गः (9)",
          "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये युद्धकाण्डे नवमः सर्गः॥९॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-9",
    "chapterName": "युद्धकाण्ड, सर्ग 9",
    "verseNumber": 9
  },
