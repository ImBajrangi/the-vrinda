    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "किं च राक्षसराजस्य रामेणापकृतं पुरा।",
          "आजहार जनस्थानाद् यस्य भार्यां यशस्विनः॥१३॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-9",
    "chapterName": "युद्धकाण्ड, सर्ग 9",
    "verseNumber": 13
  },
  {
    "id": "valmiki-ramayana-6-sarga-9-shlok-14",
