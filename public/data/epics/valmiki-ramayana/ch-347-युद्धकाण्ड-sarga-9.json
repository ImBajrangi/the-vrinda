    "slug": "valmiki-ramayana-6-sarga-9-shlok-6",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "अद्य रामं वधिष्यामः सुग्रीवं च सलक्ष्मणम्।",
          "कृपणं च हनूमन्तं लङ्का येन प्रधर्षिता॥६॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-9",
    "chapterName": "युद्धकाण्ड, सर्ग 9",
    "verseNumber": 6
  },
