    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "अप्रमत्तं कथं तं तु विजिगीषु बले स्थितम्।",
          "जितरोषं दुराधर्षं तं धर्षयितुमिच्छथ॥१०॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-9",
    "chapterName": "युद्धकाण्ड, सर्ग 9",
    "verseNumber": 10
  },
  {
