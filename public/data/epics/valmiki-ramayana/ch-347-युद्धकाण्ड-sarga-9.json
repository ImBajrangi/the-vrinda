    "slug": "valmiki-ramayana-6-sarga-9-shlok-12",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "समुद्रं लवयित्वा तु घोरं नदनदीपतिम्।",
          "बलान्यपरिमेयानि वीर्याणि च निशाचराः।",
          "परेषां सहसावज्ञा न कर्तव्या कथंचन॥१२॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-9",
    "chapterName": "युद्धकाण्ड, सर्ग 9",
    "verseNumber": 12
  },
  {
