    "slug": "valmiki-ramayana-6-sarga-9-shlok-7",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "तान् गृहीतायुधान् सर्वान् वारयित्वा विभीषणः।",
          "अब्रवीत् प्राञ्जलिर्वाक्यं पुनः प्रत्युपवेश्य तान्॥७॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-9",
    "chapterName": "युद्धकाण्ड, सर्ग 9",
    "verseNumber": 7
  },
  {
