    "titleDevanagari": "वाल्मीकि रामायण, सुन्दरकाण्ड, सर्ग 43, श्लोक 13",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-5-sarga-43-shlok-13",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "तेन नादेन महता चैत्यपालाः शतं ययुः।",
          "गृहीत्वा विविधानस्त्रान् प्रासान् खड्गान् परश्वधान्॥१३॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-43",
    "chapterName": "सुन्दरकाण्ड, सर्ग 43",
    "verseNumber": 13
  },
  {
    "id": "valmiki-ramayana-5-sarga-43-shlok-14",
    "collectionId": "valmiki-ramayana",
    "index": 10389,
    "titleDevanagari": "वाल्मीकि रामायण, सुन्दरकाण्ड, सर्ग 43, श्लोक 14",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-5-sarga-43-shlok-14",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "विसृजन्तो महाकाया मारुतिं पर्यवारयन्।",
          "ते गदाभिर्विचित्राभिः परिघैः काञ्चनाङ्गदैः॥१४॥",
          "आजग्मुर्वानरश्रेष्ठं बाणैश्चादित्यसंनिभैः।",
          "आवर्त इव गङ्गायास्तोयस्य विपुलो महान्॥ १५॥",
          "परिक्षिप्य हरिश्रेष्ठं स बभौ रक्षसां गणः।"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-43",
    "chapterName": "सुन्दरकाण्ड, सर्ग 43",
    "verseNumber": 14
  },
  {
    "id": "valmiki-ramayana-5-sarga-43-shlok-18",
    "collectionId": "valmiki-ramayana",
    "index": 10390,
    "titleDevanagari": "वाल्मीकि रामायण, सुन्दरकाण्ड, सर्ग 43, श्लोक 18",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-5-sarga-43-shlok-18",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "ततो वातात्मजः क्रुद्धो भीमरूपं समास्थितः॥१६॥",
          "प्रासादस्य महांस्तस्य स्तम्भं हेमपरिष्कृतम्।",
          "उत्पाटयित्वा वेगेन हनूमान् मारुतात्मजः॥१७॥",
          "ततस्तं भ्रामयामास शतधारं महाबलः।",
          "तत्र चाग्निः समभवत् प्रासादश्चाप्यदह्यत॥१८॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-43",
    "chapterName": "सुन्दरकाण्ड, सर्ग 43",
    "verseNumber": 18
  },
  {
    "id": "valmiki-ramayana-5-sarga-43-shlok-19",
    "collectionId": "valmiki-ramayana",
    "index": 10391,
    "titleDevanagari": "वाल्मीकि रामायण, सुन्दरकाण्ड, सर्ग 43, श्लोक 19",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-5-sarga-43-shlok-19",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "दह्यमानं ततो दृष्ट्वा प्रासादं हरियूथपः।",
          "स राक्षसशतं हत्वा वज्रणेन्द्र इवासुरान्॥१९॥",
          "अन्तरिक्षस्थितः श्रीमानिदं वचनमब्रवीत्।"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-43",
    "chapterName": "सुन्दरकाण्ड, सर्ग 43",
    "verseNumber": 19
  },
