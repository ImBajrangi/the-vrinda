    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-5-sarga-43-shlok-20",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "मादृशानां सहस्राणि विसृष्टानि महात्मनाम्॥२०॥",
          "बलिनां वानरेन्द्राणां सुग्रीववशवर्तिनाम्।।"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-43",
