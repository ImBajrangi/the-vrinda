    "titleDevanagari": "वाल्मीकि रामायण, सुन्दरकाण्ड, सर्ग 43, श्लोक 1",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-5-sarga-43-shlok-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "ततः स किंकरान् हत्वा हनूमान् ध्यानमास्थितः।",
          "वनं भग्नं मया चैत्यप्रासादो न विनाशितः॥१॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-43",
    "chapterName": "सुन्दरकाण्ड, सर्ग 43",
    "verseNumber": 1
  },
  {
    "id": "valmiki-ramayana-5-sarga-43-shlok-4",
    "collectionId": "valmiki-ramayana",
    "index": 10382,
    "titleDevanagari": "वाल्मीकि रामायण, सुन्दरकाण्ड, सर्ग 43, श्लोक 4",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-5-sarga-43-shlok-4",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "आरुह्य गिरिसंकाशं प्रासादं हरियूथपः।",
          "बभौ स सुमहातेजाः प्रतिसूर्य इवोदितः॥४॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-43",
    "chapterName": "सुन्दरकाण्ड, सर्ग 43",
    "verseNumber": 4
  },
  {
    "id": "valmiki-ramayana-5-sarga-43-shlok-5",
    "collectionId": "valmiki-ramayana",
    "index": 10383,
    "titleDevanagari": "वाल्मीकि रामायण, सुन्दरकाण्ड, सर्ग 43, श्लोक 5",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-5-sarga-43-shlok-5",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "सम्प्रधृष्य तु दुर्धर्षश्चैत्यप्रासादमुन्नतम्।",
          "हनूमान् प्रज्वलँल्लक्ष्म्या पारियात्रोपमोऽभवत्॥५॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-43",
    "chapterName": "सुन्दरकाण्ड, सर्ग 43",
    "verseNumber": 5
  },
  {
    "id": "valmiki-ramayana-5-sarga-43-shlok-6",
    "collectionId": "valmiki-ramayana",
    "index": 10384,
    "titleDevanagari": "वाल्मीकि रामायण, सुन्दरकाण्ड, सर्ग 43, श्लोक 6",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-5-sarga-43-shlok-6",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "स भूत्वा सुमहाकायः प्रभावान् मारुतात्मजः।",
          "धृष्टमास्फोटयामास लङ्कां शब्देन पूरयन्॥६॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-43",
    "chapterName": "सुन्दरकाण्ड, सर्ग 43",
    "verseNumber": 6
  },
  {
    "id": "valmiki-ramayana-5-sarga-43-shlok-7",
    "collectionId": "valmiki-ramayana",
    "index": 10385,
    "titleDevanagari": "वाल्मीकि रामायण, सुन्दरकाण्ड, सर्ग 43, श्लोक 7",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-5-sarga-43-shlok-7",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "तस्यास्फोटितशब्देन महता श्रोत्रघातिना।",
          "पेतुर्विहंगमास्तत्र चैत्यपालाश्च मोहिताः॥७॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-43",
    "chapterName": "सुन्दरकाण्ड, सर्ग 43",
    "verseNumber": 7
  },
  {
    "id": "valmiki-ramayana-5-sarga-43-shlok-11",
    "collectionId": "valmiki-ramayana",
    "index": 10386,
    "titleDevanagari": "वाल्मीकि रामायण, सुन्दरकाण्ड, सर्ग 43, श्लोक 11",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-5-sarga-43-shlok-11",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "अस्त्रविज्जयतां रामो लक्ष्मणश्च महाबलः।",
          "राजा जयति सुग्रीवो राघवेणाभिपालितः॥८॥",
          "दासोऽहं कोसलेन्द्रस्य रामस्याक्लिष्टकर्मणः।",
          "हनूमान् शत्रुसैन्यानां निहन्ता मारुतात्मजः॥९॥",
          "न रावणसहस्रं मे युद्धे प्रतिबलं भवेत्।",
          "शिलाभिश्च प्रहरतः पादपैश्च सहस्रशः॥१०॥",
          "धर्षयित्वा पुरीं लङ्कामभिवाद्य च मैथिलीम्।",
          "समृद्धार्थो गमिष्यामि मिषतां सर्वरक्षसाम्॥११॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-43",
    "chapterName": "सुन्दरकाण्ड, सर्ग 43",
    "verseNumber": 11
  },
  {
    "id": "valmiki-ramayana-5-sarga-43-shlok-12",
    "collectionId": "valmiki-ramayana",
    "index": 10387,
    "titleDevanagari": "वाल्मीकि रामायण, सुन्दरकाण्ड, सर्ग 43, श्लोक 12",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-5-sarga-43-shlok-12",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "एवमुक्त्वा महाकायश्चैत्यस्थो हरियूथपः।",
          "ननाद भीमनिर्बादो रक्षसां जनयन् भयम्॥१२॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-43",
    "chapterName": "सुन्दरकाण्ड, सर्ग 43",
    "verseNumber": 12
  },
  {
