    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 60, श्लोक 9",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-60-shlok-9",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "अष्टौ वर्षसहस्राणि तेनास्मिन्नृषिणा गिरौ।",
          "वसतो मम धर्मज्ञे स्वर्गते तु निशाकरे॥९॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-60",
    "chapterName": "बालकाण्ड, सर्ग 60",
    "verseNumber": 9
  },
  {
