    "slug": "valmiki-ramayana-1-sarga-60-shlok-13",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "उपेत्य चाश्रमं पुण्यं वृक्षमूलमुपाश्रितः।",
          "द्रष्टकामः प्रतीक्षे च भगवन्तं निशाकरम्॥१३॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-60",
    "chapterName": "बालकाण्ड, सर्ग 60",
    "verseNumber": 13
  },
