    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "तस्याश्रमपदाभ्याशे ववुर्वाताः सुगन्धिनः।",
          "वृक्षो नापुष्पितः कश्चिदफलो वा न दृश्यते॥१२॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-60",
    "chapterName": "बालकाण्ड, सर्ग 60",
    "verseNumber": 12
  },
