    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 60, श्लोक 1",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-60-shlok-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "ततः कृतोदकं स्नातं तं गृधं हरियूथपाः।",
          "उपविष्टा गिरौ रम्ये परिवार्य समन्ततः॥१॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-60",
    "chapterName": "बालकाण्ड, सर्ग 60",
    "verseNumber": 1
  },
  {
    "id": "valmiki-ramayana-1-sarga-60-shlok-2",
    "collectionId": "valmiki-ramayana",
    "index": 2543,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 60, श्लोक 2",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-60-shlok-2",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "तमङ्गदमुपासीनं तैः सर्वैर्हरिभिर्वृतम्।",
          "जनितप्रत्ययो हर्षात् सम्पातिः पुनरब्रवीत्॥२॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-60",
    "chapterName": "बालकाण्ड, सर्ग 60",
    "verseNumber": 2
  },
  {
    "id": "valmiki-ramayana-1-sarga-60-shlok-3",
    "collectionId": "valmiki-ramayana",
    "index": 2544,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 60, श्लोक 3",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-60-shlok-3",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "कृत्वा निःशब्दमेकानाः शृण्वन्तु हरयो मम।",
          "तथ्यं संकीर्तयिष्यामि यथा जानामि मैथिलीम्॥३॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-60",
    "chapterName": "बालकाण्ड, सर्ग 60",
    "verseNumber": 3
  },
  {
    "id": "valmiki-ramayana-1-sarga-60-shlok-4-1",
    "collectionId": "valmiki-ramayana",
    "index": 2545,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 60, श्लोक 4",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-60-shlok-4-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "अस्य विन्ध्यस्य शिखरे पतितोऽस्मि पुरानघ।",
          "सूर्यतापपरीताङ्गो निर्दग्धः सूर्यरश्मिभिः॥४॥",
          "लब्धसंज्ञस्तु षडात्राद् विवशो विह्वलन्निव।",
          "वीक्षमाणो दिशः सर्वा नाभिजानामि किंचन॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-60",
    "chapterName": "बालकाण्ड, सर्ग 60",
    "verseNumber": 4
  },
  {
    "id": "valmiki-ramayana-1-sarga-60-shlok-6",
    "collectionId": "valmiki-ramayana",
    "index": 2546,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 60, श्लोक 6",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-60-shlok-6",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "ततस्तु सागरान् शैलान् नदीः सर्वाः सरांसि च।",
          "वनानि च प्रदेशांश्च निरीक्ष्य मतिरागता॥६॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-60",
    "chapterName": "बालकाण्ड, सर्ग 60",
    "verseNumber": 6
  },
  {
    "id": "valmiki-ramayana-1-sarga-60-shlok-7",
