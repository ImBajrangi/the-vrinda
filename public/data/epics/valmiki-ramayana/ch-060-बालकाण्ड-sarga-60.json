    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 60, श्लोक 10",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-60-shlok-10",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "अवतीर्य च विन्ध्याग्रात् कृच्छ्रेण विषमाच्छनैः।",
          "तीक्ष्णदर्भा वसुमती दुःखेन पुनरागतः॥१०॥",
          "तमृषिं द्रष्टकामोऽस्मि दुःखेनाभ्यागतो भृशम्।",
          "जटायुषा मया चैव बहुशोऽधिगतो हि सः॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-60",
    "chapterName": "बालकाण्ड, सर्ग 60",
    "verseNumber": 10
  },
  {
    "id": "valmiki-ramayana-1-sarga-60-shlok-11",
    "collectionId": "valmiki-ramayana",
    "index": 2551,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 60, श्लोक 11",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-60-shlok-11",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "ततः कालेन महता विश्वामित्रो महातपाः॥१०॥",
          "चकारावाहनं तत्र भागार्थं सर्वदेवताः।",
          "नाभ्यागमंस्तदा तत्र भागार्थं सर्वदेवताः॥११॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-60",
    "chapterName": "बालकाण्ड, सर्ग 60",
    "verseNumber": 11
  },
