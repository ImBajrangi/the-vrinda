    "slug": "valmiki-ramayana-1-sarga-60-shlok-7",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "हृष्टपक्षिगणाकीर्णः कन्दरोदरकूटवान्।",
          "दक्षिणस्योदधेस्तीरे विन्ध्योऽयमिति निश्चितः॥७॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-60",
    "chapterName": "बालकाण्ड, सर्ग 60",
    "verseNumber": 7
  },
  {
