    "slug": "valmiki-ramayana-1-sarga-60-shlok-8-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "आसीच्चात्राश्रमं पुण्यं सुरैरपि सुपूजितम्।",
          "ऋषिर्निशाकरो नाम यस्मिन्नुग्रतपाऽभवत्॥८॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-60",
    "chapterName": "बालकाण्ड, सर्ग 60",
    "verseNumber": 8
  },
  {
    "id": "valmiki-ramayana-1-sarga-60-shlok-9",
    "collectionId": "valmiki-ramayana",
