    "slug": "valmiki-ramayana-2-sarga-21-shlok-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "तथा त विलपन्तीं तां कौसल्यां राममातरम्।",
          "उवाच लक्ष्मणो दीनस्तत्कालसदृशं वचः॥१॥"
        ]
      }
    ],
    "chapterId": "अयोध्याकाण्ड-sarga-21",
    "chapterName": "अयोध्याकाण्ड, सर्ग 21",
    "verseNumber": 1
  },
  {
    "id": "valmiki-ramayana-2-sarga-21-shlok-3",
