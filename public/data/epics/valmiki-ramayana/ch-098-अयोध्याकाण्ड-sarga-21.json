    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-2-sarga-21-shlok-3",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "न रोचते ममाप्येतदार्ये यद् राघवो वनम्।",
          "त्यक्त्वा राज्यश्रियं गच्छेत् स्त्रिया वाक्यवशंगतः॥२॥",
          "विपरीतश्च वृद्धश्च विषयैश्च प्रधर्षितः।",
          "नृपः किमिव न ब्रूयाच्चोद्यमानः समन्मथः॥३॥"
        ]
      }
    ],
    "chapterId": "अयोध्याकाण्ड-sarga-21",
    "chapterName": "अयोध्याकाण्ड, सर्ग 21",
    "verseNumber": 3
  },
  {
    "id": "valmiki-ramayana-2-sarga-21-shlok-4",
