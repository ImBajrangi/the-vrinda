    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-5-sarga-48-shlok-11",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "न वीर सेना गणशो च्यवन्ति न वज्रमादाय विशालसारम्।",
          "न मारुतस्यास्ति गतिप्रमाणं न चाग्निकल्पः करणेन हन्तुम्॥११॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-48",
    "chapterName": "सुन्दरकाण्ड, सर्ग 48",
    "verseNumber": 11
  },
  {
