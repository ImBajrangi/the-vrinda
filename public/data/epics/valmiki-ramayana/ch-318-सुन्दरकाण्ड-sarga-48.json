    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-5-sarga-48-shlok-13",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "न खल्वियं मतिश्रेष्ठ यत्त्वां सम्प्रेषयाम्यहम्।",
          "इयं च राजधर्माणां क्षत्रस्य च मतिर्मता॥१३॥"
        ]
      }
    ],
