        "linesDevanagari": [
          "नानाशस्त्रेषु संग्रामे वैशारद्यमरिंदम।",
          "अवश्यमेव बोद्धव्यं काम्यश्च विजयो रणे॥१४॥"
        ]
      }
    ],
