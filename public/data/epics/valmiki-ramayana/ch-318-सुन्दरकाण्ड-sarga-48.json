      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "ततः पितुस्तद्वचनं निशम्य प्रदक्षिणं दक्षसुतप्रभावः।",
          "चकार भर्तारमतित्वरेण रणाय वीरः प्रतिपन्नबुद्धिः ॥१५॥"
        ]
      }
