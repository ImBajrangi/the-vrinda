    "index": 10512,
    "titleDevanagari": "वाल्मीकि रामायण, सुन्दरकाण्ड, सर्ग 48, श्लोक 7",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-5-sarga-48-shlok-7",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "निहताः किंकराः सर्वे जम्बुमाली च राक्षसः।",
          "अमात्यपुत्रा वीराश्च पञ्च सेनाग्रगामिनः॥७॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-48",
    "chapterName": "सुन्दरकाण्ड, सर्ग 48",
    "verseNumber": 7
  },
  {
    "id": "valmiki-ramayana-5-sarga-48-shlok-8",
