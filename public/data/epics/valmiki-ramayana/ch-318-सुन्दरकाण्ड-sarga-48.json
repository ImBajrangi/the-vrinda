    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-5-sarga-48-shlok-10",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "बलावमर्दस्त्वयि संनिकृष्टे यथा गते शाम्यति शान्तशत्रौ।",
          "तथा समीक्ष्यात्मबलं परं च समारभस्वास्त्रभृतां वरिष्ठ॥१०॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-48",
    "chapterName": "सुन्दरकाण्ड, सर्ग 48",
    "verseNumber": 10
  },
  {
