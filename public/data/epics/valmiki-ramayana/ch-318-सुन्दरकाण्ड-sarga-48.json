    "titleDevanagari": "वाल्मीकि रामायण, सुन्दरकाण्ड, सर्ग 48, श्लोक 1",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-5-sarga-48-shlok-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "ततस्तु रक्षोऽधिपतिर्महात्मा हनूमताक्षे निहते कुमारे।",
          "मनः समाधाय स देवकल्पं समादिदेशेन्द्रजितं सरोषः॥१॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-48",
    "chapterName": "सुन्दरकाण्ड, सर्ग 48",
    "verseNumber": 1
  },
  {
    "id": "valmiki-ramayana-5-sarga-48-shlok-2",
    "collectionId": "valmiki-ramayana",
    "index": 10507,
    "titleDevanagari": "वाल्मीकि रामायण, सुन्दरकाण्ड, सर्ग 48, श्लोक 2",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-5-sarga-48-shlok-2",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "त्वमस्त्रविच्छस्त्रभृतां वरिष्ठः सुरासुराणामपि शोकदाता।",
          "सुरेषु सेन्द्रेषु च दृष्टकर्मा पितामहाराधनसंचितास्त्रः॥२॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-48",
    "chapterName": "सुन्दरकाण्ड, सर्ग 48",
    "verseNumber": 2
  },
  {
    "id": "valmiki-ramayana-5-sarga-48-shlok-3",
    "collectionId": "valmiki-ramayana",
    "index": 10508,
    "titleDevanagari": "वाल्मीकि रामायण, सुन्दरकाण्ड, सर्ग 48, श्लोक 3",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-5-sarga-48-shlok-3",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "त्वदस्त्रबलमासाद्य ससुराः समरुद्गणाः।",
          "न शेकुः समरे स्थातुं सुरेश्वरसमाश्रिताः॥३॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-48",
    "chapterName": "सुन्दरकाण्ड, सर्ग 48",
    "verseNumber": 3
  },
  {
    "id": "valmiki-ramayana-5-sarga-48-shlok-4",
    "collectionId": "valmiki-ramayana",
    "index": 10509,
    "titleDevanagari": "वाल्मीकि रामायण, सुन्दरकाण्ड, सर्ग 48, श्लोक 4",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-5-sarga-48-shlok-4",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "न कश्चित् त्रिषु लोकेषु संयुगे न गतश्रमः।",
          "भुजवीर्याभिगुप्तश्च तपसा चाभिरक्षितः।",
          "देशकालप्रधानश्च त्वमेव मतिसत्तमः॥४॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-48",
    "chapterName": "सुन्दरकाण्ड, सर्ग 48",
    "verseNumber": 4
  },
  {
    "id": "valmiki-ramayana-5-sarga-48-shlok-5",
    "collectionId": "valmiki-ramayana",
    "index": 10510,
    "titleDevanagari": "वाल्मीकि रामायण, सुन्दरकाण्ड, सर्ग 48, श्लोक 5",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-5-sarga-48-shlok-5",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "न तेऽस्त्यशक्यं समरेषु कर्मणां न तेऽस्त्यकार्यं मतिपूर्वमन्त्रणे।",
          "न सोऽस्ति कश्चित् त्रिषु संग्रहेषु न वेद यस्तेऽस्त्रबलं बलं च॥५॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-48",
    "chapterName": "सुन्दरकाण्ड, सर्ग 48",
    "verseNumber": 5
  },
  {
    "id": "valmiki-ramayana-5-sarga-48-shlok-6",
    "collectionId": "valmiki-ramayana",
    "index": 10511,
    "titleDevanagari": "वाल्मीकि रामायण, सुन्दरकाण्ड, सर्ग 48, श्लोक 6",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-5-sarga-48-shlok-6",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "ममानुरूपं तपसो बलं च ते पराक्रमश्चास्त्रबलं च संयुगे।",
          "न त्वां समासाद्य रणावमर्दै मनः श्रमं गच्छति निश्चितार्थम्॥६॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-48",
    "chapterName": "सुन्दरकाण्ड, सर्ग 48",
    "verseNumber": 6
  },
  {
    "id": "valmiki-ramayana-5-sarga-48-shlok-7",
