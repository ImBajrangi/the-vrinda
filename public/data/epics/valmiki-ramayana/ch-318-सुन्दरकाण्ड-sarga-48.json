    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-5-sarga-48-shlok-8",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "बलानि सुसमृद्धानि साश्वनागरथानि च।",
          "सहोदरस्ते दयितः कुमारोऽक्षश्च सूदितः।",
          "न तु तेष्वेव मे सारो यस्त्वय्यरिनिषूदन॥८॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-48",
    "chapterName": "सुन्दरकाण्ड, सर्ग 48",
    "verseNumber": 8
  },
  {
    "id": "valmiki-ramayana-5-sarga-48-shlok-9",
    "collectionId": "valmiki-ramayana",
    "index": 10514,
    "titleDevanagari": "वाल्मीकि रामायण, सुन्दरकाण्ड, सर्ग 48, श्लोक 9",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-5-sarga-48-shlok-9",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "इदं च दृष्ट्वा निहतं महद् बलं कपेः प्रभावं च पराक्रमं च।",
          "त्वमात्मनश्चापि निरीक्ष्य सारं कुरुष्व वेगं स्वबलानुरूपम्॥९॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-48",
    "chapterName": "सुन्दरकाण्ड, सर्ग 48",
    "verseNumber": 9
  },
  {
