    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-5-sarga-48-shlok-12",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "तमेवमर्थं प्रसमीक्ष्य सम्यक् स्वकर्मसाम्याद्धि समाहितात्मा।",
          "स्मरंश्च दिव्यं धनुषोऽस्य वीर्य व्रजाक्षतं कर्म समारभस्व॥१२॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-48",
    "chapterName": "सुन्दरकाण्ड, सर्ग 48",
    "verseNumber": 12
  },
