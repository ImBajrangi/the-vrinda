    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 7, श्लोक 1",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-7-shlok-1-2",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "नारायणगिरिं ते तु गर्जन्तो राक्षसाम्बुदाः।",
          "अर्दयन्तोऽस्त्रवर्षेण वर्षेणेवाद्रिमम्बुदाः॥१॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-7",
    "chapterName": "बालकाण्ड, सर्ग 7",
    "verseNumber": 1
  },
  {
    "id": "valmiki-ramayana-1-sarga-7-shlok-2-1",
    "collectionId": "valmiki-ramayana",
    "index": 347,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 7, श्लोक 2",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-7-shlok-2-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "न जाने निलयं तस्य सर्वथा पापरक्षसः।",
          "सामर्थ्य विक्रमं वापि दौष्कुलेयस्य वा कुलम्॥ २॥",
          "सत्यं तु प्रतिजानामि त्यज शोकमरिंदम।",
          "करिष्यामि तथा यत्नं यथा प्राप्स्यसि मैथिलीम्॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-7",
    "chapterName": "बालकाण्ड, सर्ग 7",
    "verseNumber": 2
  },
  {
    "id": "valmiki-ramayana-1-sarga-7-shlok-3",
    "collectionId": "valmiki-ramayana",
    "index": 348,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 7, श्लोक 3",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-7-shlok-3",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "धृष्टिर्जयन्तो विजयः सुराष्ट्रो राष्ट्रवर्धनः ।",
          "अकोपो धर्मपालश्च सुमन्त्रश्चाष्टमोऽर्थवित्॥३॥ ।"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-7",
    "chapterName": "बालकाण्ड, सर्ग 7",
    "verseNumber": 3
  },
  {
    "id": "valmiki-ramayana-1-sarga-7-shlok-4-2",
    "collectionId": "valmiki-ramayana",
    "index": 349,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 7, श्लोक 4",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-7-shlok-4-2",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "शलभा इव केदारं मशका इव पावकम्।",
          "यथामृतघटं दंशा मकरा इव चार्णवम्॥३॥",
          "तथा रक्षोधनुर्मुक्ता वज्रानिलमनोजवाः।",
          "हरिं विशन्ति स्म शरा लोका इव विपर्यये॥४॥",
          "स्यन्दनैः स्यन्दनगता गजैश्च गजमूर्धगाः।",
          "अश्वारोहास्तथाश्वैश्च पादाताश्चाम्बरे स्थिताः॥",
          "राक्षसेन्द्रा गिरिनिभाः शरैः शक्त्यष्टितोमरैः।",
          "निरुच्छ्वासं हरिं चक्रुः प्राणायामा इव द्विजम्॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-7",
    "chapterName": "बालकाण्ड, सर्ग 7",
    "verseNumber": 4
  },
  {
    "id": "valmiki-ramayana-1-sarga-7-shlok-5",
