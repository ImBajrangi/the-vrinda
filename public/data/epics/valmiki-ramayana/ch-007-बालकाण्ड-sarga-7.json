    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "शरैः पूर्णायतोत्सृष्टैर्वज्रकल्पैर्मनोजवैः।",
          "चिच्छेद विष्णुर्निशितैः शतशोऽथ सहस्रशः॥८॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-7",
    "chapterName": "बालकाण्ड, सर्ग 7",
    "verseNumber": 8
  },
