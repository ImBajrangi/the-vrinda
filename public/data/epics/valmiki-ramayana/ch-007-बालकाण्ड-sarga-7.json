    "slug": "valmiki-ramayana-1-sarga-7-shlok-5",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "अलं वैक्लव्यमालम्ब्य धैर्यमात्मगतं स्मर।",
          "त्वद्विधानां न सदृशमीदृशं बुद्धिलाघवम्॥५॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-7",
    "chapterName": "बालकाण्ड, सर्ग 7",
    "verseNumber": 5
  },
  {
