    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-7-shlok-6-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "मयापि व्यसनं प्राप्तं भार्याविरहजं महत्।",
          "नाहमेवं हि शोचामि धैर्यं न च परित्यजे॥६॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-7",
    "chapterName": "बालकाण्ड, सर्ग 7",
    "verseNumber": 6
  },
  {
