    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "नागैरश्वैः खरैरुष्टैः संयुक्तः सुसमाहितः।",
          "पताकाध्वजचित्रैश्च बहुभिः समलंकृतः॥५॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-53",
    "chapterName": "युद्धकाण्ड, सर्ग 53",
    "verseNumber": 5
  },
