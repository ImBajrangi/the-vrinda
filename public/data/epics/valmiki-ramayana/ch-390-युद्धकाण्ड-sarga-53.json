    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "तथेत्युक्त्वा द्रुततरं मायावी राक्षसेश्वरः।",
          "निर्जगाम बलैः सार्धं बहुभिः परिवारितः॥४॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-53",
    "chapterName": "युद्धकाण्ड, सर्ग 53",
    "verseNumber": 4
  },
  {
