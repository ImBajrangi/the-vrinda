    "slug": "valmiki-ramayana-6-sarga-53-shlok-6",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "ततो विचित्रकेयूरमुकुटेन विभूषितः।",
          "तनुत्रं स समावृत्य सधनुर्निर्ययौ द्रुतम्॥६॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-53",
    "chapterName": "युद्धकाण्ड, सर्ग 53",
    "verseNumber": 6
