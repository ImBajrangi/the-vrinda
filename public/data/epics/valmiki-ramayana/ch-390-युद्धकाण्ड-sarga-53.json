    "titleDevanagari": "वाल्मीकि रामायण, युद्धकाण्ड, सर्ग 53, श्लोक 1",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-6-sarga-53-shlok-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "धूम्राक्षं निहतं श्रुत्वा रावणो राक्षसेश्वरः।",
          "क्रोधेन महताऽऽविष्टो निःश्वसन्नुरगो यथा॥१॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-53",
    "chapterName": "युद्धकाण्ड, सर्ग 53",
    "verseNumber": 1
  },
  {
    "id": "valmiki-ramayana-6-sarga-53-shlok-2",
    "collectionId": "valmiki-ramayana",
    "index": 12954,
    "titleDevanagari": "वाल्मीकि रामायण, युद्धकाण्ड, सर्ग 53, श्लोक 2",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-6-sarga-53-shlok-2",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "दीर्घमुष्णं विनिःश्वस्य क्रोधेन कलुषीकृतः।",
          "अब्रवीद् राक्षसं क्रूरं वज्रदंष्ट्र महाबलम्॥२॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-53",
    "chapterName": "युद्धकाण्ड, सर्ग 53",
    "verseNumber": 2
  },
  {
    "id": "valmiki-ramayana-6-sarga-53-shlok-3",
    "collectionId": "valmiki-ramayana",
    "index": 12955,
    "titleDevanagari": "वाल्मीकि रामायण, युद्धकाण्ड, सर्ग 53, श्लोक 3",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-6-sarga-53-shlok-3",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "गच्छ त्वं वीर निर्याहि राक्षसैः परिवारितः।",
          "जहि दाशरथिं रामं सुग्रीवं वानरैः सह ॥३॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-53",
    "chapterName": "युद्धकाण्ड, सर्ग 53",
    "verseNumber": 3
  },
  {
