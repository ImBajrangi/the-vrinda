      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "पताकालंकृतं दीप्तं तप्तकाञ्चनभूषितम्।",
          "रथं प्रदक्षिणं कृत्वा समारोहच्चमपतिः॥७॥"
        ]
      }
