    "slug": "valmiki-ramayana-2-sarga-15-shlok-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "ते तु तां रजनीमुष्य ब्राह्मणा वेदपारगाः।",
          "उपतस्थुरुपस्थानं सह राजपुरोहिताः॥१॥"
        ]
      }
    ],
    "chapterId": "अयोध्याकाण्ड-sarga-15",
    "chapterName": "अयोध्याकाण्ड, सर्ग 15",
    "verseNumber": 1
  },
  {
    "id": "valmiki-ramayana-2-sarga-15-shlok-2",
