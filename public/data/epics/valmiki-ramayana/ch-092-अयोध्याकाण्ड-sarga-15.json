    "titleDevanagari": "वाल्मीकि रामायण, अयोध्याकाण्ड, सर्ग 15, श्लोक 2",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-2-sarga-15-shlok-2",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "अमात्या बलमुख्याश्च मुख्या ये निगमस्य च।",
          "राघवस्याभिषेकार्थे प्रीयमाणाः सुसंगताः॥२॥"
        ]
      }
    ],
    "chapterId": "अयोध्याकाण्ड-sarga-15",
    "chapterName": "अयोध्याकाण्ड, सर्ग 15",
    "verseNumber": 2
  },
  {
    "id": "valmiki-ramayana-2-sarga-15-shlok-5",
    "collectionId": "valmiki-ramayana",
    "index": 3528,
    "titleDevanagari": "वाल्मीकि रामायण, अयोध्याकाण्ड, सर्ग 15, श्लोक 5",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-2-sarga-15-shlok-5",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "उदिते विमले सूर्ये पुष्ये चाभ्यागतेऽहनि।",
          "लग्ने कर्कटके प्राप्ते जन्म रामस्य च स्थिते॥३॥",
          "अभिषेकाय रामस्य द्विजेन्द्रैरुपकल्पितम्।",
          "काञ्चना जलकुम्भाश्च भद्रपीठं स्वलंकृतम्॥ ४॥",
          "रथश्च सम्यगास्तीर्णो भास्वता व्याघ्रचर्मणा।",
          "गङ्गायमुनयोः पुण्यात् संगमादाहृतं जलम्॥५॥"
        ]
      }
    ],
    "chapterId": "अयोध्याकाण्ड-sarga-15",
    "chapterName": "अयोध्याकाण्ड, सर्ग 15",
    "verseNumber": 5
  },
  {
    "id": "valmiki-ramayana-2-sarga-15-shlok-7",
    "collectionId": "valmiki-ramayana",
    "index": 3529,
    "titleDevanagari": "वाल्मीकि रामायण, अयोध्याकाण्ड, सर्ग 15, श्लोक 7",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-2-sarga-15-shlok-7",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "याश्चान्याः सरितः पुण्या ह्रदाः कूपाः सरांसि च।",
          "प्राग्वहाश्चोर्ध्ववाहाश्च तिर्यग्वाहाश्च क्षीरिणः॥ ६॥",
          "ताभ्यश्चैवाहृतं तोयं समुद्रेभ्यश्च सर्वशः।",
          "क्षौद्रं दधि घृतं लाजा दर्भाः सुमनसः पयः॥७॥",
          "अष्टौ च कन्या रुचिरा मत्तश्च वरवारणः।",
          "सजलाः क्षीरिभिश्छन्ना घटाः काञ्चनराजताः॥ ८॥",
          "पद्मोत्पलयुता भान्ति पूर्णाः परमवारिणा।"
        ]
      }
    ],
    "chapterId": "अयोध्याकाण्ड-sarga-15",
    "chapterName": "अयोध्याकाण्ड, सर्ग 15",
    "verseNumber": 7
  },
