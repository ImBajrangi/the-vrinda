    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "स्निग्धगम्भीरघोषेण स्यन्दनेनोपयान् प्रभुः।",
          "अयोध्या",
          "ं भरतः क्षिप्रं प्रविवेश महायशाः॥१॥",
          "अयोध्या"
        ]
      }
    ],
