    "slug": "valmiki-ramayana-2-sarga-114-shlok-4",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "अल्पोष्णक्षुब्धसलिलां घर्मतप्तविहंगमाम्।",
          "लीनमीनझषग्राहां कृशां गिरिनदीमिव॥४॥",
          "विधूमामिव हेमाभां शिखामग्नेः समुत्थिताम्।",
          "हविरभ्युक्षितां पश्चाच्छिखां विप्रलयं गताम्॥"
        ]
      }
    ],
    "chapterId": "अयोध्याकाण्ड-sarga-114",
    "chapterName": "अयोध्याकाण्ड, सर्ग 114",
    "verseNumber": 4
  },
  {
    "id": "valmiki-ramayana-2-sarga-114-shlok-5",
    "collectionId": "valmiki-ramayana",
    "index": 6634,
    "titleDevanagari": "वाल्मीकि रामायण, अयोध्याकाण्ड, सर्ग 114, श्लोक 5",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-2-sarga-114-shlok-5",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "खेलौ बलदाऊ जी सों होरी ।।",
          "वे तो कहिये ब्रज के राजा फगुवा लैन चलो री ।",
          "फागुन में हिय उमगि भरयो है मन भावै सोई करौ री ।",
          "लाज सब दूर धरो री ।।",
          "चोवा लाओ चन्दन लाओ अबीर बनाओ भर झोरी ।",
          "बैंया पकरि के याहि नचाओ (याकि) मुख ते लगाय देओ रोरी ।",
          "हाल ऐसो ही करो री ।।",
          "कहत मुकुंद बार नाय कीजै पकरि लेउ बरजोरी ।",
          "कोई काजर कोई बेंदी लगाओ (याके) सेंदुर मांग भरो री ।",
          "नील पर धूरि धरो री ।।"
        ]
      }
    ],
    "chapterId": "अयोध्याकाण्ड-sarga-114",
    "chapterName": "अयोध्याकाण्ड, सर्ग 114",
    "verseNumber": 5
  },
