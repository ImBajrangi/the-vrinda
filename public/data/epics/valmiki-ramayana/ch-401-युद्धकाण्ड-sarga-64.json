    "index": 13524,
    "titleDevanagari": "वाल्मीकि रामायण, युद्धकाण्ड, सर्ग 64, श्लोक 5",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-6-sarga-64-shlok-5",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "यत् त्वशक्यं बलवता वक्तुं प्राकृतबुद्धिना।",
          "अनुपासितवृद्धेन कः कुर्यात् तादृशं बुधः॥५॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-64",
    "chapterName": "युद्धकाण्ड, सर्ग 64",
    "verseNumber": 5
  },
  {
