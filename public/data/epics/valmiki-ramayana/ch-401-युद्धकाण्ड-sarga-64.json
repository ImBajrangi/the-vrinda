        "stanzaNumber": 1,
        "linesDevanagari": [
          "तत्र क्लृप्तमिदं राज्ञा हृदि कार्यं मतं च नः।",
          "शत्रौ हि साहसं यत् तत् किमिवात्रापनीयते॥१०॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-64",
    "chapterName": "युद्धकाण्ड, सर्ग 64",
    "verseNumber": 10
  },
