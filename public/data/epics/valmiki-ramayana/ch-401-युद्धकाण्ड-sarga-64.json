    "titleDevanagari": "वाल्मीकि रामायण, युद्धकाण्ड, सर्ग 64, श्लोक 1",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-6-sarga-64-shlok-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "तदुक्तमतिकायस्य बलिनो बाहुशालिनः।",
          "कुम्भकर्णस्य वचनं श्रुत्वोवाच महोदरः॥१॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-64",
    "chapterName": "युद्धकाण्ड, सर्ग 64",
    "verseNumber": 1
  },
  {
    "id": "valmiki-ramayana-6-sarga-64-shlok-2",
    "collectionId": "valmiki-ramayana",
    "index": 13521,
    "titleDevanagari": "वाल्मीकि रामायण, युद्धकाण्ड, सर्ग 64, श्लोक 2",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-6-sarga-64-shlok-2",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "कुम्भकर्ण कुले जातो धृष्टः प्राकृतदर्शनः।",
          "अवलिप्तो न शक्नोषि कृत्यं सर्वत्र वेदितुम्॥२॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-64",
    "chapterName": "युद्धकाण्ड, सर्ग 64",
    "verseNumber": 2
  },
  {
    "id": "valmiki-ramayana-6-sarga-64-shlok-3",
    "collectionId": "valmiki-ramayana",
    "index": 13522,
    "titleDevanagari": "वाल्मीकि रामायण, युद्धकाण्ड, सर्ग 64, श्लोक 3",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-6-sarga-64-shlok-3",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "नहि राजा न जानीते कुम्भकर्ण नयानयौ।",
          "त्वं तु कैशोरकाद् धृष्टः केवलं वक्तुमिच्छसि॥३॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-64",
    "chapterName": "युद्धकाण्ड, सर्ग 64",
    "verseNumber": 3
  },
  {
