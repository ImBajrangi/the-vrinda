    "titleDevanagari": "वाल्मीकि रामायण, युद्धकाण्ड, सर्ग 64, श्लोक 7",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-6-sarga-64-shlok-7",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "कर्म चैव हि सर्वेषां कारणानां प्रयोजनम्।",
          "श्रेयः पापीयसां चात्र फलं भवति कर्मणाम्॥७॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-64",
    "chapterName": "युद्धकाण्ड, सर्ग 64",
    "verseNumber": 7
  },
  {
    "id": "valmiki-ramayana-6-sarga-64-shlok-8",
    "collectionId": "valmiki-ramayana",
    "index": 13527,
    "titleDevanagari": "वाल्मीकि रामायण, युद्धकाण्ड, सर्ग 64, श्लोक 8",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-6-sarga-64-shlok-8",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "निःश्रेयसफलावेव धर्मार्थावितरावपि।",
          "अधर्मानर्थयोः प्राप्तं फलं च प्रत्यवायिकम्॥८॥",
          "ऐहलौकिकपारक्यं कर्म पुंभिर्निषेव्यते।",
          "कर्माण्यपि तु कल्याणि लभते काममास्थितः॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-64",
    "chapterName": "युद्धकाण्ड, सर्ग 64",
    "verseNumber": 8
  },
  {
