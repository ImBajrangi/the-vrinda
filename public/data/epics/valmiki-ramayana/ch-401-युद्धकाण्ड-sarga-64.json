          "राक्षसा राघवं तं त्वं कथमेको जयिष्यसि॥१२॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-64",
    "chapterName": "युद्धकाण्ड, सर्ग 64",
    "verseNumber": 12
