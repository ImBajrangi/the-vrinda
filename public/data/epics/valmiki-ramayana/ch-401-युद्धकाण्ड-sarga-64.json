    "slug": "valmiki-ramayana-6-sarga-64-shlok-4",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "स्थानं वृद्धिं च हानिं च देशकालविधानवित्।",
          "आत्मनश्च परेषां च बुध्यते राक्षसर्षभः॥४॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-64",
    "chapterName": "युद्धकाण्ड, सर्ग 64",
    "verseNumber": 4
  },
  {
