    "slug": "valmiki-ramayana-3-sarga-40-shlok-8",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "दोषं गुणं वा सम्पृष्टस्त्वमेवं वक्तुमर्हसि।",
          "अपायं वा उपायं वा कार्यस्यास्य विनिश्चये॥ ८॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-40",
    "chapterName": "अरण्यकाण्ड, सर्ग 40",
    "verseNumber": 8
  },
  {
