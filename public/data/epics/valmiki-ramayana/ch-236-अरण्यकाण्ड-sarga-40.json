    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "त्वां हि मायामयं दृष्ट्वा काञ्चनं जातविस्मया।",
          "आनयनमिति क्षिप्रं रामं वक्ष्यति मैथिली॥१९॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-40",
