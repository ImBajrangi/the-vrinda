    "titleDevanagari": "वाल्मीकि रामायण, अरण्यकाण्ड, सर्ग 40, श्लोक 1",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-40-shlok-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "मारीचस्य तु तद् वाक्यं क्षमं युक्तं च रावणः।",
          "उक्तो न प्रतिजग्राह मर्तुकाम इवौषधम्॥१॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-40",
    "chapterName": "अरण्यकाण्ड, सर्ग 40",
    "verseNumber": 1
  },
  {
    "id": "valmiki-ramayana-3-sarga-40-shlok-2",
    "collectionId": "valmiki-ramayana",
    "index": 7825,
    "titleDevanagari": "वाल्मीकि रामायण, अरण्यकाण्ड, सर्ग 40, श्लोक 2",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-40-shlok-2",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "तं पथ्यहितवक्तारं मारीचं राक्षसाधिपः।",
          "अब्रवीत् परुषं वाक्यमयुक्तं कालचोदितः॥२॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-40",
    "chapterName": "अरण्यकाण्ड, सर्ग 40",
    "verseNumber": 2
  },
  {
