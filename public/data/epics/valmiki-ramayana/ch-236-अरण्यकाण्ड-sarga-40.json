    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-40-shlok-4",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "त्वद्वाक्यैर्न तु मां शक्यं भेत्तुं रामस्य संयुगे।",
          "मूर्खस्य पापशीलस्य मानुषस्य विशेषतः॥४॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-40",
    "chapterName": "अरण्यकाण्ड, सर्ग 40",
    "verseNumber": 4
  },
  {
