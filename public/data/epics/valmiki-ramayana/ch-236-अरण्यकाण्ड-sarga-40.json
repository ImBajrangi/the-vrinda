    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-40-shlok-3",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "दुष्कुलैतदयुक्तार्थं मारीच मयि कथ्यते।",
          "वाक्यं निष्फलमत्यर्थं बीजमुप्तमिवोषरे॥३॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-40",
    "chapterName": "अरण्यकाण्ड, सर्ग 40",
    "verseNumber": 3
  },
  {
