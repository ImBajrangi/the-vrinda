    "collectionId": "valmiki-ramayana",
    "index": 7828,
    "titleDevanagari": "वाल्मीकि रामायण, अरण्यकाण्ड, सर्ग 40, श्लोक 6",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-40-shlok-6",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "यस्त्यक्त्वा सुहृदो राज्यं मातरं पितरं तथा।",
          "स्त्रीवाक्यं प्राकृतं श्रुत्वा वनमेकपदे गतः॥५॥",
          "अवश्यं तु मया तस्य संयुगे खरघातिनः।।",
          "प्राणैः प्रियतरा सीता हर्तव्या तव संनिधौ॥६॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-40",
    "chapterName": "अरण्यकाण्ड, सर्ग 40",
    "verseNumber": 6
  },
  {
    "id": "valmiki-ramayana-3-sarga-40-shlok-7",
    "collectionId": "valmiki-ramayana",
    "index": 7829,
    "titleDevanagari": "वाल्मीकि रामायण, अरण्यकाण्ड, सर्ग 40, श्लोक 7",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-40-shlok-7",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "एवं मे निश्चिता बुद्धिर्हदि मारीच विद्यते।",
          "न व्यावर्तयितुं शक्या सेन्ट्रैरपि सुरासुरैः॥७॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-40",
    "chapterName": "अरण्यकाण्ड, सर्ग 40",
    "verseNumber": 7
  },
  {
