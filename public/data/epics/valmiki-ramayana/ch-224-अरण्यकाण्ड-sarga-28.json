    "titleDevanagari": "वाल्मीकि रामायण, अरण्यकाण्ड, सर्ग 28, श्लोक 1",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-28-shlok-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "निहतं दूषणं दृष्ट्वा रणे त्रिशिरसा सह।",
          "खरस्याप्यभवत् त्रासो दृष्ट्वा रामस्य विक्रमम्॥ १॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-28",
    "chapterName": "अरण्यकाण्ड, सर्ग 28",
    "verseNumber": 1
  },
  {
    "id": "valmiki-ramayana-3-sarga-28-shlok-3",
    "collectionId": "valmiki-ramayana",
    "index": 7505,
    "titleDevanagari": "वाल्मीकि रामायण, अरण्यकाण्ड, सर्ग 28, श्लोक 3",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-28-shlok-3",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "स दृष्ट्वा राक्षसं सैन्यमविषह्यं महाबलम्।",
          "हतमेकेन रामेण दूषणस्त्रिशिरा अपि॥२॥",
          "तबलं हतभूयिष्ठं विमनाः प्रेक्ष्य राक्षसः।",
          "आससाद खरो रामं नमुचिर्वासवं यथा॥३॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-28",
    "chapterName": "अरण्यकाण्ड, सर्ग 28",
    "verseNumber": 3
  },
  {
