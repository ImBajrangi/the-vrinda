    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "विकृष्य बलवच्चापं नाराचान् रक्तभोजनान्।",
          "खरश्चिक्षेप रामाय क्रुद्धानाशीविषानिव॥४॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-28",
    "chapterName": "अरण्यकाण्ड, सर्ग 28",
    "verseNumber": 4
  },
