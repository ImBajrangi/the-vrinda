    "slug": "valmiki-ramayana-1-sarga-61-shlok-20",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "उक्तवाक्ये मुनौ तस्मिन् मुनिपल्यां तथैव च।",
          "शुनःशेपः स्वयं राम मध्यमो वाक्यमब्रवीत्॥ २०॥"
        ]
