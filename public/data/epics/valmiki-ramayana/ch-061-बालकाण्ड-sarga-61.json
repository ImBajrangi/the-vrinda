[
  {
    "id": "valmiki-ramayana-1-sarga-61-shlok-1-1",
    "collectionId": "valmiki-ramayana",
    "index": 2571,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 61, श्लोक 1",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-61-shlok-1-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "ततस्तद् दारुणं कर्म दुष्करं सहसा कृतम्।",
          "आचचक्षे मुनेः सर्वं सूर्यानुगमनं तथा॥१॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-61",
    "chapterName": "बालकाण्ड, सर्ग 61",
    "verseNumber": 1
  },
  {
    "id": "valmiki-ramayana-1-sarga-61-shlok-2",
    "collectionId": "valmiki-ramayana",
    "index": 2572,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 61, श्लोक 2",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-61-shlok-2",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "भगवन् व्रणयुक्तत्वाल्लज्जया चाकुलेन्द्रियः।",
          "परिश्रान्तो न शक्नोमि वचनं परिभाषितुम्॥२॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-61",
    "chapterName": "बालकाण्ड, सर्ग 61",
    "verseNumber": 2
  },
  {
    "id": "valmiki-ramayana-1-sarga-61-shlok-3",
    "collectionId": "valmiki-ramayana",
    "index": 2573,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 61, श्लोक 3",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-61-shlok-3",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "अहं चैव जटायुश्च संघर्षाद् गर्वमोहितौ।",
          "आकाशं पतितौ दूराज्जिज्ञासन्तौ पराक्रमम्॥३॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-61",
    "chapterName": "बालकाण्ड, सर्ग 61",
    "verseNumber": 3
  },
  {
    "id": "valmiki-ramayana-1-sarga-61-shlok-4",
    "collectionId": "valmiki-ramayana",
    "index": 2574,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 61, श्लोक 4",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-61-shlok-4",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "कैलासशिखरे बद्ध्वा मुनीनामग्रतः पणम्।",
          "रविः स्यादनुयातव्यो यावदस्तं महागिरिम्॥४॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-61",
    "chapterName": "बालकाण्ड, सर्ग 61",
    "verseNumber": 4
  },
  {
    "id": "valmiki-ramayana-1-sarga-61-shlok-5",
    "collectionId": "valmiki-ramayana",
    "index": 2575,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 61, श्लोक 5",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-61-shlok-5",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "अप्यावां युगपत् प्राप्तावपश्याव महीतले।",
          "रथचक्रप्रमाणानि नगराणि पृथक् पृथक्॥५॥",
          "क्वचिद् वादित्रघोषश्च क्वचिद् भूषणनिःस्वनः।",
          "गायन्तीः स्माङ्गना बह्वीः पश्यावो रक्तवाससः॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-61",
    "chapterName": "बालकाण्ड, सर्ग 61",
    "verseNumber": 5
  },
  {
    "id": "valmiki-ramayana-1-sarga-61-shlok-6",
    "collectionId": "valmiki-ramayana",
    "index": 2576,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 61, श्लोक 6",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-61-shlok-6",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "तस्य वै यजमानस्य पशुमिन्द्रो जहार ह।",
          "प्रणष्टे तु पशौ विप्रो राजानमिदमब्रवीत्॥६॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-61",
    "chapterName": "बालकाण्ड, सर्ग 61",
    "verseNumber": 6
  },
  {
    "id": "valmiki-ramayana-1-sarga-61-shlok-7-1",
    "collectionId": "valmiki-ramayana",
