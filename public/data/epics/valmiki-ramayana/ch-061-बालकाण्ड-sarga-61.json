    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 61, श्लोक 7",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-61-shlok-7-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "तूर्णमुत्पत्य चाकाशमादित्यपदमास्थितौ।",
          "आवामालोकयावस्तद् वनं शादलसंस्थितम्॥७॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-61",
    "chapterName": "बालकाण्ड, सर्ग 61",
    "verseNumber": 7
  },
  {
    "id": "valmiki-ramayana-1-sarga-61-shlok-8-1",
    "collectionId": "valmiki-ramayana",
    "index": 2578,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 61, श्लोक 8",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-61-shlok-8-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "उपलैरिव संछन्ना दृश्यते भूः शिलोच्चयैः।",
          "आपगाभिश्च संवीता सूत्रैरिव वसुंधरा॥८॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-61",
    "chapterName": "बालकाण्ड, सर्ग 61",
    "verseNumber": 8
  },
  {
    "id": "valmiki-ramayana-1-sarga-61-shlok-9",
    "collectionId": "valmiki-ramayana",
    "index": 2579,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 61, श्लोक 9",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-61-shlok-9",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "उपाध्यायवचः श्रुत्वा स राजा पुरुषर्षभः।",
          "अन्वियेष महाबुद्धिः पशं गोभिः सहस्रशः॥९॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-61",
    "chapterName": "बालकाण्ड, सर्ग 61",
    "verseNumber": 9
  },
  {
    "id": "valmiki-ramayana-1-sarga-61-shlok-10",
    "collectionId": "valmiki-ramayana",
    "index": 2580,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 61, श्लोक 10",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-61-shlok-10",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "हिमवांश्चैव विन्ध्यश्च मेरुश्च सुमहागिरिः।।",
          "भूतले सम्प्रकाशन्ते नागा इव जलाशये॥९॥",
          "तीव्रः स्वेदश्च खेदश्च भयं चासीत् तदावयोः।",
          "समाविशत मोहश्च ततो मूर्छा च दारुणा॥१०॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-61",
    "chapterName": "बालकाण्ड, सर्ग 61",
    "verseNumber": 10
  },
  {
    "id": "valmiki-ramayana-1-sarga-61-shlok-11-1",
    "collectionId": "valmiki-ramayana",
    "index": 2581,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 61, श्लोक 11",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-61-shlok-11-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "न च दिग् ज्ञायते याम्या न चाग्नेयी न वारुणी।",
          "युगान्ते नियतो लोको हतो दग्ध इवाग्निना॥११॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-61",
    "chapterName": "बालकाण्ड, सर्ग 61",
    "verseNumber": 11
  },
  {
    "id": "valmiki-ramayana-1-sarga-61-shlok-12-1",
    "collectionId": "valmiki-ramayana",
    "index": 2582,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 61, श्लोक 12",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-61-shlok-12-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "मनश्च मे हतं भूयश्चक्षुः प्राप्य तु संश्रयम्।",
          "यत्नेन महता ह्यस्मिन् मनः संधाय चक्षुषी॥१२॥",
          "यत्नेन महता भूयो भास्करः प्रतिलोकितः।",
          "तुल्यपृथ्वीप्रमाणेन भास्करः प्रतिभाति नौ॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-61",
    "chapterName": "बालकाण्ड, सर्ग 61",
    "verseNumber": 12
  },
  {
    "id": "valmiki-ramayana-1-sarga-61-shlok-13",
    "collectionId": "valmiki-ramayana",
    "index": 2583,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 61, श्लोक 13",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-61-shlok-13",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "पृष्ट्वा सर्वत्र कुशलम्चीकं तमिदं वचः।",
          "गवां शतसहस्रेण विक्रीणीषे सुतं यदि॥१३॥",
          "पशोरर्थे महाभाग कृतकृत्योऽस्मि भार्गव।"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-61",
    "chapterName": "बालकाण्ड, सर्ग 61",
    "verseNumber": 13
  },
  {
    "id": "valmiki-ramayana-1-sarga-61-shlok-14-1",
    "collectionId": "valmiki-ramayana",
    "index": 2584,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 61, श्लोक 14",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-61-shlok-14-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "जटायुर्मामनापृच्छय निपपात महीं ततः।",
          "तं दृष्ट्वा तूर्णमाकाशादात्मानं मुक्तवानहम्॥ १४॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-61",
    "chapterName": "बालकाण्ड, सर्ग 61",
    "verseNumber": 14
  },
  {
    "id": "valmiki-ramayana-1-sarga-61-shlok-15",
    "collectionId": "valmiki-ramayana",
    "index": 2585,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 61, श्लोक 15",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-61-shlok-15",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "एवमुक्तो महातेजा ऋचीकस्त्वब्रवीद् वचः॥१५॥",
          "नाहं ज्येष्ठं नरश्रेष्ठ विक्रीणीयां कथंचन।",
          "ऋचीकस्य वचः श्रुत्वा तेषां माता महात्मनाम्॥ १६॥",
          "उवाच नरशार्दूलमम्बरीषमिदं वचः।"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-61",
    "chapterName": "बालकाण्ड, सर्ग 61",
    "verseNumber": 15
  },
  {
    "id": "valmiki-ramayana-1-sarga-61-shlok-16",
    "collectionId": "valmiki-ramayana",
    "index": 2586,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 61, श्लोक 16",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-61-shlok-16",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "पक्षाभ्यां च मया गुप्तो जटायुर्न प्रदह्यत।",
          "प्रमादात् तत्र निर्दग्धः पतन् वायुपथादहम्॥१५॥",
          "आशङ्के तं निपतितं जनस्थाने जटायुषम्।",
          "अहं तु पतितो विन्ध्ये दग्धपक्षो जडीकृतः॥१६॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-61",
    "chapterName": "बालकाण्ड, सर्ग 61",
    "verseNumber": 16
  },
  {
    "id": "valmiki-ramayana-1-sarga-61-shlok-17",
    "collectionId": "valmiki-ramayana",
    "index": 2587,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 61, श्लोक 17",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-61-shlok-17",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "राज्याच्च हीनो भ्रात्रा च पक्षाभ्यां विक्रमेण च।",
          "सर्वथा मर्तुमेवेच्छन् पतिष्ये शिखराद् गिरेः॥१७॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-61",
    "chapterName": "बालकाण्ड, सर्ग 61",
    "verseNumber": 17
  },
  {
    "id": "valmiki-ramayana-1-sarga-61-shlok-18",
    "collectionId": "valmiki-ramayana",
    "index": 2588,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 61, श्लोक 18",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-61-shlok-18",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "अविक्रेयं सुतं ज्येष्ठं भगवानाह भार्गवः॥१७॥",
          "ममापि दयितं विद्धि कनिष्ठं शुनकं प्रभो।",
          "तस्मात् कनीयसं पुत्रं न दास्ये तव पार्थिव॥ १८॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-61",
    "chapterName": "बालकाण्ड, सर्ग 61",
    "verseNumber": 18
  },
  {
    "id": "valmiki-ramayana-1-sarga-61-shlok-19",
    "collectionId": "valmiki-ramayana",
    "index": 2589,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 61, श्लोक 19",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-61-shlok-19",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "प्रायेण हि नरश्रेष्ठ ज्येष्ठाः पितृषु वल्लभाः।",
          "मातॄणां च कनीयांसस्तस्माद् रक्ष्ये कनीयसम्॥ १९॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-61",
    "chapterName": "बालकाण्ड, सर्ग 61",
    "verseNumber": 19
  },
  {
    "id": "valmiki-ramayana-1-sarga-61-shlok-20",
