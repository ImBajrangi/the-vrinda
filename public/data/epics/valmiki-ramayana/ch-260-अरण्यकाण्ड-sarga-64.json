    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-64-shlok-15",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "एते महामृगा वीर मामीक्षन्ते पुनः पुनः॥१५॥",
          "वक्तुकामा इह हि मे इङ्गितान्युपलक्षये।"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-64",
    "chapterName": "अरण्यकाण्ड, सर्ग 64",
    "verseNumber": 15
  },
  {
