      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "एवं सम्भाषमाणौ तावन्योन्यं भ्रातरावुभौ ॥२४॥",
          "वसुंधरायां पतितपुष्पमार्गमपश्यताम्।"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-64",
    "chapterName": "अरण्यकाण्ड, सर्ग 64",
    "verseNumber": 24
  },
  {
    "id": "valmiki-ramayana-3-sarga-64-shlok-25",
    "collectionId": "valmiki-ramayana",
    "index": 8485,
    "titleDevanagari": "वाल्मीकि रामायण, अरण्यकाण्ड, सर्ग 64, श्लोक 25",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-64-shlok-25",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "पुष्पवृष्टिं निपतितां दृष्ट्वा रामो महीतले॥२५॥",
          "उवाच लक्ष्मणं वीरो दुःखितो दुःखितं वचः।",
          "अभिजानामि पुष्पाणि तानीमानीह लक्ष्मण॥ २६॥",
          "अपिनद्धानि वैदेह्या मया दत्तानि कानने।",
          "मन्ये सूर्यश्च वायुश्च मेदिनी च यशस्विनी॥ २७॥",
          "अभिरक्षन्ति पुष्पाणि प्रकुर्वन्तो मम प्रियम्।"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-64",
    "chapterName": "अरण्यकाण्ड, सर्ग 64",
    "verseNumber": 25
  },
  {
    "id": "valmiki-ramayana-3-sarga-64-shlok-28",
