    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-64-shlok-14",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "मन्दाकिनी जनस्थानमिमं प्रस्रवणं गिरिम्॥१४॥",
          "सर्वाण्यनुचरिष्यामि यदि सीता हि लभ्यते।"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-64",
    "chapterName": "अरण्यकाण्ड, सर्ग 64",
    "verseNumber": 14
  },
