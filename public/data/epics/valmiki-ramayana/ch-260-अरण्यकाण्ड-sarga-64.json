    "titleDevanagari": "वाल्मीकि रामायण, अरण्यकाण्ड, सर्ग 64, श्लोक 2",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-64-shlok-2",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "एवमुक्तस्तु रामेण लक्ष्मणः पुनरेव हि ॥२॥",
          "नदी गोदावरी रम्यां जगाम लघुविक्रमः।"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-64",
    "chapterName": "अरण्यकाण्ड, सर्ग 64",
    "verseNumber": 2
  },
  {
    "id": "valmiki-ramayana-3-sarga-64-shlok-3",
    "collectionId": "valmiki-ramayana",
    "index": 8472,
    "titleDevanagari": "वाल्मीकि रामायण, अरण्यकाण्ड, सर्ग 64, श्लोक 3",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-64-shlok-3",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "तां लक्ष्मणस्तीर्थवती विचित्वा राममब्रवीत्॥३॥",
          "नैनां पश्यामि तीर्थेषु क्रोशतो न शृणोति मे।"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-64",
    "chapterName": "अरण्यकाण्ड, सर्ग 64",
    "verseNumber": 3
  },
  {
    "id": "valmiki-ramayana-3-sarga-64-shlok-4",
    "collectionId": "valmiki-ramayana",
    "index": 8473,
    "titleDevanagari": "वाल्मीकि रामायण, अरण्यकाण्ड, सर्ग 64, श्लोक 4",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-64-shlok-4",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "कं नु सा देशमापन्ना वैदेही क्लेशनाशिनी ॥४॥",
          "नहि तं वेद्मि वै राम यत्र सा तनुमध्यमा।",
          "लक्ष्मणस्य वचः श्रुत्वा दीनः संतापमोहितः॥",
          "रामः समभिचक्राम स्वयं गोदावरी नदीम्।"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-64",
    "chapterName": "अरण्यकाण्ड, सर्ग 64",
    "verseNumber": 4
  },
  {
    "id": "valmiki-ramayana-3-sarga-64-shlok-7",
    "collectionId": "valmiki-ramayana",
    "index": 8474,
    "titleDevanagari": "वाल्मीकि रामायण, अरण्यकाण्ड, सर्ग 64, श्लोक 7",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-64-shlok-7",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "स तामुपस्थितो रामः क्व सीतेत्येवमब्रवीत्॥६॥",
          "भूतानि राक्षसेन्द्रेण वधार्हेण हृतामपि।",
          "न तां शशंसू रामाय तथा गोदावरी नदी॥७॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-64",
    "chapterName": "अरण्यकाण्ड, सर्ग 64",
    "verseNumber": 7
  },
  {
    "id": "valmiki-ramayana-3-sarga-64-shlok-8",
    "collectionId": "valmiki-ramayana",
    "index": 8475,
    "titleDevanagari": "वाल्मीकि रामायण, अरण्यकाण्ड, सर्ग 64, श्लोक 8",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-64-shlok-8",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "ततः प्रचोदिता भूतैः शंस चास्मै प्रियामिति।",
          "न च सा ह्यवदत् सीतां पृष्टा रामेण शोचता॥८॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-64",
    "chapterName": "अरण्यकाण्ड, सर्ग 64",
    "verseNumber": 8
  },
  {
    "id": "valmiki-ramayana-3-sarga-64-shlok-9",
    "collectionId": "valmiki-ramayana",
    "index": 8476,
    "titleDevanagari": "वाल्मीकि रामायण, अरण्यकाण्ड, सर्ग 64, श्लोक 9",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-64-shlok-9",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "रावणस्य च तद्रूपं कर्मापि च दुरात्मनः।",
          "ध्यात्वा भयात् तु वैदेहीं सा नदी न शशंस ह॥ ९॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-64",
    "chapterName": "अरण्यकाण्ड, सर्ग 64",
    "verseNumber": 9
  },
  {
    "id": "valmiki-ramayana-3-sarga-64-shlok-10",
    "collectionId": "valmiki-ramayana",
    "index": 8477,
    "titleDevanagari": "वाल्मीकि रामायण, अरण्यकाण्ड, सर्ग 64, श्लोक 10",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-64-shlok-10",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "निराशस्तु तया नद्या सीताया दर्शने कृतः।",
          "उवाच रामः सौमित्रिं सीतादर्शनकर्शितः॥१०॥",
          "एषा गोदावरी सौम्य किंचिन्न प्रतिभाषते।",
          "किं नु लक्ष्मण वक्ष्यामि समेत्य जनकं वचः॥ ११॥",
          "मातरं चैव वैदेह्या विना तामहमप्रियम्।",
          "या मे राज्यविहीनस्य वने वन्येन जीवतः ॥ १२॥",
          "सर्वं व्यपानयच्छोकं वैदेही क्व नु सा गता।"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-64",
    "chapterName": "अरण्यकाण्ड, सर्ग 64",
    "verseNumber": 10
  },
  {
    "id": "valmiki-ramayana-3-sarga-64-shlok-13",
    "collectionId": "valmiki-ramayana",
    "index": 8478,
    "titleDevanagari": "वाल्मीकि रामायण, अरण्यकाण्ड, सर्ग 64, श्लोक 13",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-64-shlok-13",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "ज्ञातिवर्गविहीनस्य वैदेहीमप्यपश्यतः॥१३॥",
          "मन्ये दीर्घा भविष्यन्ति रात्रयो मम जाग्रतः।"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-64",
    "chapterName": "अरण्यकाण्ड, सर्ग 64",
    "verseNumber": 13
  },
