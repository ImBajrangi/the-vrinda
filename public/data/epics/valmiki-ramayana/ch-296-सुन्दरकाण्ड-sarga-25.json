    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "वेपते स्माधिकं सीता विशन्तीवांगमात्मनः।",
          "वने यूथपरिभ्रष्टा मृगी कोकैरिवादिता॥५॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-25",
    "chapterName": "सुन्दरकाण्ड, सर्ग 25",
    "verseNumber": 5
  },
