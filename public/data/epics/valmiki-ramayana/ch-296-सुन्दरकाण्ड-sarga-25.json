    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "सा त्वशोकस्य विपुलां शाखामालम्ब्य पुष्पिताम्।",
          "चिन्तयामास शोकेन भर्तारं भग्नमानसा॥६॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-25",
    "chapterName": "सुन्दरकाण्ड, सर्ग 25",
    "verseNumber": 6
  },
