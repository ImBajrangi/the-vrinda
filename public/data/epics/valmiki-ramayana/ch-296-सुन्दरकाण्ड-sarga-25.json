    "titleDevanagari": "वाल्मीकि रामायण, सुन्दरकाण्ड, सर्ग 25, श्लोक 1",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-5-sarga-25-shlok-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "अथ तासां वदन्तीनां परुषं दारुणं बहु।",
          "राक्षसीनामसौम्यानां रुरोद जनकात्मजा॥१॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-25",
    "chapterName": "सुन्दरकाण्ड, सर्ग 25",
    "verseNumber": 1
  },
  {
    "id": "valmiki-ramayana-5-sarga-25-shlok-2",
    "collectionId": "valmiki-ramayana",
    "index": 9772,
    "titleDevanagari": "वाल्मीकि रामायण, सुन्दरकाण्ड, सर्ग 25, श्लोक 2",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-5-sarga-25-shlok-2",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "एवमुक्ता तु वैदेही राक्षसीभिर्मनस्विनी।",
          "उवाच परमत्रस्ता बाष्पगद्गदया गिरा॥२॥",
          "न मानुषी राक्षसस्य भार्या भवितुमर्हति।",
          "कामं खादत मां सर्वा न करिष्यामि वो वचः॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-25",
    "chapterName": "सुन्दरकाण्ड, सर्ग 25",
    "verseNumber": 2
  },
  {
    "id": "valmiki-ramayana-5-sarga-25-shlok-4",
    "collectionId": "valmiki-ramayana",
    "index": 9773,
    "titleDevanagari": "वाल्मीकि रामायण, सुन्दरकाण्ड, सर्ग 25, श्लोक 4",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-5-sarga-25-shlok-4",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "सा राक्षसीमध्यगता सीता सुरसुतोपमा।",
          "न शर्म लेभे शोकार्ता रावणेनेव भर्त्सिता॥४॥"
        ]
      }
    ],
    "chapterId": "सुन्दरकाण्ड-sarga-25",
    "chapterName": "सुन्दरकाण्ड, सर्ग 25",
    "verseNumber": 4
  },
  {
