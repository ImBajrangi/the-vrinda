    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-33-shlok-6",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "ये न रक्षन्ति विषयमस्वाधीनं नराधिपाः।",
          "ते न वृद्ध्या प्रकाशन्ते गिरयः सागरे यथा॥६॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-33",
    "chapterName": "अरण्यकाण्ड, सर्ग 33",
    "verseNumber": 6
