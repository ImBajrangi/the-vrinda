    "slug": "valmiki-ramayana-3-sarga-33-shlok-3",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "सक्तं ग्राम्येषु भोगेषु कामवृत्तं महीपतिम्।",
          "लुब्धं न बहु मन्यन्ते श्मशानाग्निमिव प्रजाः॥ ३॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-33",
    "chapterName": "अरण्यकाण्ड, सर्ग 33",
    "verseNumber": 3
  },
  {
