    "slug": "valmiki-ramayana-3-sarga-33-shlok-4",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "स्वयं कार्याणि यः काले नानुतिष्ठति पार्थिवः।",
          "स तु वै सह राज्येन तैश्च कार्यैर्विनश्यति॥४॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-33",
    "chapterName": "अरण्यकाण्ड, सर्ग 33",
    "verseNumber": 4
  },
  {
