    "slug": "valmiki-ramayana-3-sarga-33-shlok-5",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "अयुक्तचारं दुर्दर्शमस्वाधीनं नराधिपम्।",
          "वर्जयन्ति नरा दूरान्नदीपङ्कमिव द्विपाः॥५॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-33",
    "chapterName": "अरण्यकाण्ड, सर्ग 33",
    "verseNumber": 5
  },
  {
