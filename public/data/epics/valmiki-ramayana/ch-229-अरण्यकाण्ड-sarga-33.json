    "slug": "valmiki-ramayana-3-sarga-33-shlok-2",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "प्रमत्तः कामभोगेषु स्वैरवृत्तो निरङ्कशः।",
          "समुत्पन्नं भयं घोरं बोद्धव्यं नावबुध्यसे॥२॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-33",
    "chapterName": "अरण्यकाण्ड, सर्ग 33",
    "verseNumber": 2
  },
  {
