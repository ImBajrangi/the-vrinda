    "slug": "valmiki-ramayana-2-sarga-61-shlok-7",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "महेन्द्रध्वजसंकाशः क्व नु शेते महाभुजः।",
          "भुजं परिघसंकाशमुपाधाय महाबलः॥७॥"
        ]
      }
    ],
    "chapterId": "अयोध्याकाण्ड-sarga-61",
    "chapterName": "अयोध्याकाण्ड, सर्ग 61",
    "verseNumber": 7
  },
