    "slug": "valmiki-ramayana-2-sarga-61-shlok-2",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "यद्यपि त्रिषु लोकेषु प्रथितं ते महद् यशः।",
          "सानुक्रोशो वदान्यश्च प्रियवादी च राघवः॥२॥"
        ]
      }
    ],
    "chapterId": "अयोध्याकाण्ड-sarga-61",
    "chapterName": "अयोध्याकाण्ड, सर्ग 61",
    "verseNumber": 2
  },
