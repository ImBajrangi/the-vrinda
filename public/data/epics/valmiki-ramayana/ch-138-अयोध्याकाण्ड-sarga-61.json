    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "यदि पञ्चदशे वर्षे राघवः पुनरेष्यति।",
          "जह्याद् राज्यं च कोशं च भरतो नोपलक्ष्यते॥ ११॥"
        ]
      }
    ],
    "chapterId": "अयोध्याकाण्ड-sarga-61",
