    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "सा नूनं तरुणी श्यामा सुकुमारी सुखोचिता।",
          "कथमुष्णं च शीतं च मैथिली विसहिष्यते॥४॥"
        ]
      }
    ],
    "chapterId": "अयोध्याकाण्ड-sarga-61",
    "chapterName": "अयोध्याकाण्ड, सर्ग 61",
    "verseNumber": 4
  },
  {
