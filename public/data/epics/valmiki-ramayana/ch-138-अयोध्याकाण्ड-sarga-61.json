        "linesDevanagari": [
          "पद्मवर्णं सुकेशान्तं पद्मनिःश्वासमुत्तमम्।",
          "कदा द्रक्ष्यामि रामस्य वदनं पुष्करेक्षणम्॥८॥"
        ]
      }
    ],
    "chapterId": "अयोध्याकाण्ड-sarga-61",
    "chapterName": "अयोध्याकाण्ड, सर्ग 61",
    "verseNumber": 8
  },
