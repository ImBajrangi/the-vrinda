    "slug": "valmiki-ramayana-2-sarga-61-shlok-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "वनं गते धर्मरते रामे रमयतां वरे।",
          "कौसल्या रुदती चार्ता भर्तारमिदमब्रवीत्॥१॥"
        ]
      }
    ],
    "chapterId": "अयोध्याकाण्ड-sarga-61",
    "chapterName": "अयोध्याकाण्ड, सर्ग 61",
    "verseNumber": 1
  },
