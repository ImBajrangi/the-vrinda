    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-46-shlok-8",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "रामस्य त्वन्तरं प्रेप्सुर्दशग्रीवस्तदन्तरे ॥८॥",
          "उपतस्थे च वैदेहीं भिक्षुरूपेण रावणः।"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-46",
    "chapterName": "अरण्यकाण्ड, सर्ग 46",
    "verseNumber": 8
  },
