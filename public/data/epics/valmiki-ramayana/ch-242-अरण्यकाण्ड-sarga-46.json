    "slug": "valmiki-ramayana-3-sarga-46-shlok-10",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "सहसा भव्यरूपेण तृणैः कूप इवावृतः॥१०॥",
          "ङ्केअतिष्ठत् प्रेक्ष्य वैदेही रामपत्नी यशस्विनीम ।"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-46",
    "chapterName": "अरण्यकाण्ड, सर्ग 46",
    "verseNumber": 10
  },
  {
