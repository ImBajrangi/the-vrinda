    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-46-shlok-12",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "तिष्ठन् सम्प्रेक्ष्य च तदा पत्नी रामस्य रावणः॥ ११॥",
          "शुभां रुचिरदन्तोष्ठी पूर्णचन्द्रनिभाननाम्।",
          "आसीनां पर्णशालायां बाष्पशोकाभिपीडिताम्॥ १२॥"
        ]
      }
    ],
