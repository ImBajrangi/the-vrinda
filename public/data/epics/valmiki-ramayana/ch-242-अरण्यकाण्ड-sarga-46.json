    "titleDevanagari": "वाल्मीकि रामायण, अरण्यकाण्ड, सर्ग 46, श्लोक 3",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-46-shlok-3",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "श्लक्ष्णकाषायसंवीतः शिखी छत्री उपानही।",
          "वामे चांसेऽवसज्याथ शुभे यष्टिकमण्डलू॥३॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-46",
    "chapterName": "अरण्यकाण्ड, सर्ग 46",
    "verseNumber": 3
  },
  {
    "id": "valmiki-ramayana-3-sarga-46-shlok-4",
    "collectionId": "valmiki-ramayana",
    "index": 7987,
    "titleDevanagari": "वाल्मीकि रामायण, अरण्यकाण्ड, सर्ग 46, श्लोक 4",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-46-shlok-4",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "परिव्राजकरूपेण वैदेहीमन्ववर्तत।",
          "तामाससादातिबलो भ्रातृभ्यां रहितां वने॥४॥",
          "रहितां सूर्यचन्द्राभ्यां संध्यामिव महत्तमः।",
          "तामपश्यत् ततो बालां राजपुत्रीं यशस्विनीम्॥",
          "रोहिणीं शशिना हीनां ग्रहवद् भृशदारुणः।"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-46",
    "chapterName": "अरण्यकाण्ड, सर्ग 46",
    "verseNumber": 4
  },
  {
    "id": "valmiki-ramayana-3-sarga-46-shlok-6",
    "collectionId": "valmiki-ramayana",
    "index": 7988,
    "titleDevanagari": "वाल्मीकि रामायण, अरण्यकाण्ड, सर्ग 46, श्लोक 6",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-46-shlok-6",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "तमुग्रं पापकर्माणं जनस्थानगता द्रुमाः॥६॥",
          "संदृश्य न प्रकम्पन्ते न प्रवाति च मारुतः।",
          "शीघ्रस्रोताश्च तं दृष्ट्वा वीक्षन्तं रक्तलोचनम्॥ ७॥",
          "स्तिमितं गन्तुमारेभे भयाद् गोदावरी नदी।"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-46",
    "chapterName": "अरण्यकाण्ड, सर्ग 46",
    "verseNumber": 6
  },
  {
