    "slug": "valmiki-ramayana-3-sarga-46-shlok-9",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "अभव्यो भव्यरूपेण भर्तारमनुशोचतीम्॥९॥",
          "अभ्यवर्तत वैदेहीं चित्रामिव शनैश्चरः।"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-46",
    "chapterName": "अरण्यकाण्ड, सर्ग 46",
    "verseNumber": 9
  },
