    "slug": "valmiki-ramayana-3-sarga-46-shlok-13",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "स तां पद्मपलाशाक्षीं पीतकौशेयवासिनीम्।",
          "अभ्यगच्छत वैदेहीं हृष्टचेता निशाचरः॥१३॥"
        ]
      }
    ],
