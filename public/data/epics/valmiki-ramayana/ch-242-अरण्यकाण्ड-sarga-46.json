    "index": 7985,
    "titleDevanagari": "वाल्मीकि रामायण, अरण्यकाण्ड, सर्ग 46, श्लोक 2",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-46-shlok-2",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "तदासाद्य दशग्रीवः क्षिप्रमन्तरमास्थितः।",
          "अभिचक्राम वैदेही परिव्राजकरूपधृक्॥२॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-46",
    "chapterName": "अरण्यकाण्ड, सर्ग 46",
    "verseNumber": 2
  },
  {
    "id": "valmiki-ramayana-3-sarga-46-shlok-3",
