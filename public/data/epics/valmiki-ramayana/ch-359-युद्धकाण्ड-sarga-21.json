    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-6-sarga-21-shlok-12",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "स त्रिरात्रोषितस्तत्र नयज्ञो धर्मवत्सलः।",
          "उपासत तदा रामः सागरं सरितां पतिम्॥११॥",
          "न च दर्शयते रूपं मन्दो रामस्य सागरः।",
          "प्रयतेनापि रामेण यथार्हमभिपूजितः॥१२॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-21",
    "chapterName": "युद्धकाण्ड, सर्ग 21",
    "verseNumber": 12
  },
  {
