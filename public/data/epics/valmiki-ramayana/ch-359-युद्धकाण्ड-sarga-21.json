    "slug": "valmiki-ramayana-6-sarga-21-shlok-2",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "बाहुं भुजङ्गभोगाभमुपधायारिसूदनः।",
          "जातरूपमयैश्चैव भूषणैर्भूषितं पुरा॥२॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-21",
