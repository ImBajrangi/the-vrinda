    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "तस्य रामस्य सुप्तस्य कुशास्तीर्णे महीतले।",
          "नियमादप्रमत्तस्य निशास्तिस्रोऽभिजग्मतुः॥१०॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-21",
    "chapterName": "युद्धकाण्ड, सर्ग 21",
    "verseNumber": 10
  },
  {
