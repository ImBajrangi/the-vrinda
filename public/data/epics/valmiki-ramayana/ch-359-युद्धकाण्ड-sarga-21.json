    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-6-sarga-21-shlok-13",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "समुद्रस्य ततः क्रुद्धो रामो रक्तान्तलोचनः।",
          "समीपस्थमुवाचेदं लक्ष्मणं शुभलक्षणम्॥१३॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-21",
    "chapterName": "युद्धकाण्ड, सर्ग 21",
    "verseNumber": 13
