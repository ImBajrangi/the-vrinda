    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "संयुगे युगसंकाशं शत्रूणां शोकवर्धनम्।",
          "सुहृदां नन्दनं दीर्घ सागरान्तव्यपाश्रयम्॥६॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-21",
    "chapterName": "युद्धकाण्ड, सर्ग 21",
