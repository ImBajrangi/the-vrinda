    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "ततः सागरवेलायां दर्भानास्तीर्य राघवः।",
          "अञ्जलिं प्राङ्मखः कृत्वा प्रतिशिश्ये महोदधेः॥१॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-21",
    "chapterName": "युद्धकाण्ड, सर्ग 21",
    "verseNumber": 1
  },
