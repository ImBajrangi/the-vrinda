    "slug": "valmiki-ramayana-3-sarga-1-shlok-6",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "बलिहोमार्चितं पुण्यं ब्रह्मघोषनिनादितम्।",
          "पुष्पैश्चान्यैः परिक्षिप्तं पद्मिन्या च सपद्मया॥ ६॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-1",
    "chapterName": "अरण्यकाण्ड, सर्ग 1",
    "verseNumber": 6
  },
  {
