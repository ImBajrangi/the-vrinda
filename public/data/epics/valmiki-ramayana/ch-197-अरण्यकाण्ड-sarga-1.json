    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-1-shlok-3",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "शरण्यं सर्वभूतानां सुसम्मृष्टाजिरं सदा।",
          "मृगैर्बहुभिराकीर्णं पक्षिसंघैः समावृतम्॥३॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-1",
    "chapterName": "अरण्यकाण्ड, सर्ग 1",
    "verseNumber": 3
  },
  {
