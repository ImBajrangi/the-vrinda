    "slug": "valmiki-ramayana-3-sarga-1-shlok-7",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "फलमूलाशनैर्दान्तैश्चीरकृष्णाजिनाम्बरैः।",
          "सूर्यवैश्वानराभैश्च पुराणैर्मुनिभिर्युतम्॥७॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-1",
    "chapterName": "अरण्यकाण्ड, सर्ग 1",
    "verseNumber": 7
  },
  {
