    "titleDevanagari": "वाल्मीकि रामायण, अरण्यकाण्ड, सर्ग 1, श्लोक 1",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-1-shlok-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "॥ श्रीसीतारामचन्द्राभ्यां नमः॥",
          "श्रीमद्वाल्मीकीय रामायण",
          "अरण्यकाण्डम्",
          "प्रथमः सर्गः (सर्ग 1)",
          "प्रविश्य तु महारण्यं दण्डकारण्यमात्मवान्।",
          "रामो ददर्श दुर्धर्षस्तापसाश्रममण्डलम्॥१॥",
          "इत्याचे श्रीमद्रामायणे वाल्मीकीये आदिकाव्येऽरण्यकाण्डे प्रथमः सर्गः॥१॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-1",
    "chapterName": "अरण्यकाण्ड, सर्ग 1",
    "verseNumber": 1
  },
  {
    "id": "valmiki-ramayana-3-sarga-1-shlok-2",
    "collectionId": "valmiki-ramayana",
    "index": 6803,
    "titleDevanagari": "वाल्मीकि रामायण, अरण्यकाण्ड, सर्ग 1, श्लोक 2",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-1-shlok-2",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "कुशचीरपरिक्षिप्तं ब्राह्मया लक्ष्या समावृतम्।",
          "यथा प्रदीप्तं दुर्दर्श गगने सूर्यमण्डलम्॥२॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-1",
    "chapterName": "अरण्यकाण्ड, सर्ग 1",
    "verseNumber": 2
  },
  {
