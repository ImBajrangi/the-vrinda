    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-6-sarga-27-shlok-32",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "एतेऽसितमुखा घोरा गोलाङ्गला महाबलाः॥३२॥",
          "शतं शतसहस्राणि दृष्ट्वा वै सेतुबन्धनम्।",
          "गोलाङ्गुलं महाराज गवाक्षं नाम यूथपम्॥३३॥",
          "परिवार्याभिनर्दन्ते लङ्कां मर्दितुमोजसा।"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-27",
    "chapterName": "युद्धकाण्ड, सर्ग 27",
    "verseNumber": 32
