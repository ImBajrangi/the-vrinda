  {
    "id": "valmiki-ramayana-6-sarga-27-shlok-34",
    "collectionId": "valmiki-ramayana",
    "index": 12103,
    "titleDevanagari": "वाल्मीकि रामायण, युद्धकाण्ड, सर्ग 27, श्लोक 34",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-6-sarga-27-shlok-34",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "भ्रमराचरिता यत्र सर्वकालफलद्रुमाः॥३४॥",
          "यं सूर्यस्तुल्यवर्णाभमनुपर्येति पर्वतम्।",
          "यस्य भासा सदा भान्ति तद्वर्णा मृगपक्षिणः॥३५॥",
          "यस्य प्रस्थं महात्मानो न त्यजन्ति महर्षयः।",
          "सर्वकामफला वृक्षाः सदा फलसमन्विताः॥",
          "मधूनि च महार्हाणि यस्मिन् पर्वतसत्तमे।",
          "तत्रैष रमते राजन् रम्ये काञ्चनपर्वते॥३७॥",
          "मुख्यो वानरमुख्यानां केसरी नाम यूथपः।"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-27",
    "chapterName": "युद्धकाण्ड, सर्ग 27",
    "verseNumber": 34
  },
