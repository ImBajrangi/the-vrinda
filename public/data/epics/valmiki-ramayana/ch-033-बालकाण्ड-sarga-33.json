    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "स तां रत्नमयीं दिव्यां श्रीमान् पुष्पितकाननाम्।",
          "रम्यां रत्नसमाकीर्णां ददर्श महतीं गुहाम्॥४॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-33",
    "chapterName": "बालकाण्ड, सर्ग 33",
    "verseNumber": 4
  },
