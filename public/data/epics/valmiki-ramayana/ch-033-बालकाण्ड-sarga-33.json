    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "एतस्मिन्नेव काले तु चूली नाम महाद्युतिः।",
          "ऊर्ध्वरेताः शुभाचारो ब्राह्म तप उपागमत्॥११॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-33",
    "chapterName": "बालकाण्ड, सर्ग 33",
    "verseNumber": 11
