    "slug": "valmiki-ramayana-1-sarga-33-shlok-8",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "विन्ध्यमेरुगिरिप्रख्यैः प्रासादै कभूमिभिः।",
          "ददर्श गिरिनद्यश्च विमलास्तत्र राघवः॥८॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-33",
    "chapterName": "बालकाण्ड, सर्ग 33",
    "verseNumber": 8
