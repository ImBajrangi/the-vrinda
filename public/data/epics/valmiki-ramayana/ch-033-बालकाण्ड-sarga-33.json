    "slug": "valmiki-ramayana-1-sarga-33-shlok-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "तस्य तद् वचनं श्रुत्वा कुशनाभस्य धीमतः।",
          "शिरोभिश्चरणौ स्पृष्ट्वा कन्याशतमभाषत॥१॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-33",
    "chapterName": "बालकाण्ड, सर्ग 33",
    "verseNumber": 1
  },
  {
    "id": "valmiki-ramayana-1-sarga-33-shlok-2-1",
    "collectionId": "valmiki-ramayana",
    "index": 1633,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 33, श्लोक 2",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-33-shlok-2-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "द्वारस्था हरयस्तत्र महाकाया महाबलाः।",
          "बभूवुर्लक्ष्मणं दृष्ट्वा सर्वे प्राञ्जलयः स्थिताः॥२॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-33",
    "chapterName": "बालकाण्ड, सर्ग 33",
    "verseNumber": 2
  },
  {
    "id": "valmiki-ramayana-1-sarga-33-shlok-3",
    "collectionId": "valmiki-ramayana",
    "index": 1634,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 33, श्लोक 3",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-33-shlok-3",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "निःश्वसन्तं तु तं दृष्ट्वा क्रुद्धं दशरथात्मजम्।",
          "बभूवुर्हरयस्त्रस्ता न चैनं पर्यवारयन्॥३॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-33",
    "chapterName": "बालकाण्ड, सर्ग 33",
    "verseNumber": 3
  },
  {
