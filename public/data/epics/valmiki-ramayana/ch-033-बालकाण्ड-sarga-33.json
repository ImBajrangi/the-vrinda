    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "देवगन्धर्वपुत्रैश्च वानरैः कामरूपिभिः।",
          "दिव्यमाल्याम्बरधरैः शोभितां प्रियदर्शनैः॥६॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-33",
    "chapterName": "बालकाण्ड, सर्ग 33",
    "verseNumber": 6
