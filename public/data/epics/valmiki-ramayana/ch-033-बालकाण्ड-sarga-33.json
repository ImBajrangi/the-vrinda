        "stanzaNumber": 1,
        "linesDevanagari": [
          "हर्म्यप्रासादसम्बाधां नानारत्नोपशोभिताम्।",
          "सर्वकामफलैर्वृक्षैः पुष्पितैरुपशोभिताम्॥५॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-33",
    "chapterName": "बालकाण्ड, सर्ग 33",
    "verseNumber": 5
  },
