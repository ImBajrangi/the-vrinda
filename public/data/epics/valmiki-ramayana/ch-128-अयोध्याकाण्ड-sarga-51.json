    "titleDevanagari": "वाल्मीकि रामायण, अयोध्याकाण्ड, सर्ग 51, श्लोक 1",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-2-sarga-51-shlok-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "तं जाग्रतमदम्भेन भ्रातुराय लक्ष्मणम्।",
          "गुहः संतापसंतप्तो राघवं वाक्यमब्रवीत्॥१॥"
        ]
      }
    ],
    "chapterId": "अयोध्याकाण्ड-sarga-51",
    "chapterName": "अयोध्याकाण्ड, सर्ग 51",
    "verseNumber": 1
  },
  {
    "id": "valmiki-ramayana-2-sarga-51-shlok-2",
    "collectionId": "valmiki-ramayana",
