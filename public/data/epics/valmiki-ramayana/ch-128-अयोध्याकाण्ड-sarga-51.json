    "slug": "valmiki-ramayana-2-sarga-51-shlok-4",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "नहि रामात् प्रियतमो ममास्ते भुवि कश्चन।",
          "ब्रवीम्येव च ते सत्यं सत्येनैव च ते शपे॥४॥"
        ]
      }
    ],
    "chapterId": "अयोध्याकाण्ड-sarga-51",
    "chapterName": "अयोध्याकाण्ड, सर्ग 51",
    "verseNumber": 4
  },
  {
