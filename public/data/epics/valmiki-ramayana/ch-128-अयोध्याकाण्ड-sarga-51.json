    "slug": "valmiki-ramayana-2-sarga-51-shlok-9",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "लक्ष्मणस्तु तदोवाच रक्ष्यमाणास्त्वयानघ।",
          "नात्र भीता वयं सर्वे धर्ममेवानुपश्यता॥८॥",
          "कथं दाशरथौ भूमौ शयाने सह सीतया।",
          "शक्या निद्रा मया लब्धं जीवितं वा सुखानि वा॥ ९॥"
        ]
      }
    ],
    "chapterId": "अयोध्याकाण्ड-sarga-51",
    "chapterName": "अयोध्याकाण्ड, सर्ग 51",
    "verseNumber": 9
  },
  {
