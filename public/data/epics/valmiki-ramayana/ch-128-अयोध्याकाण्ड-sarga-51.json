    "slug": "valmiki-ramayana-2-sarga-51-shlok-7",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "न मेऽस्त्यविदितं किंचिद वनेऽस्मिंश्चरतः सदा।",
          "चतुरङ्ग ह्यतिबलं सुमहत् संतरेमहि ॥७॥"
        ]
      }
    ],
    "chapterId": "अयोध्याकाण्ड-sarga-51",
    "chapterName": "अयोध्याकाण्ड, सर्ग 51",
    "verseNumber": 7
  },
  {
