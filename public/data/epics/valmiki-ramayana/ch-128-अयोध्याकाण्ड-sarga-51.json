    "titleDevanagari": "वाल्मीकि रामायण, अयोध्याकाण्ड, सर्ग 51, श्लोक 2",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-2-sarga-51-shlok-2",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "इयं तात सुखा शय्या त्वदर्थमुपकल्पिता।",
          "प्रत्याश्वसिहि साध्वस्यां राजपुत्र यथासुखम्॥ २॥"
        ]
      }
    ],
    "chapterId": "अयोध्याकाण्ड-sarga-51",
    "chapterName": "अयोध्याकाण्ड, सर्ग 51",
    "verseNumber": 2
  },
  {
    "id": "valmiki-ramayana-2-sarga-51-shlok-3",
