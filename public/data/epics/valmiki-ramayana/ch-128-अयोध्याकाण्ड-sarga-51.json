    "slug": "valmiki-ramayana-2-sarga-51-shlok-6",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "सोऽहं प्रियसखं रामं शयानं सह सीतया।",
          "रक्षिष्यामि धनुष्पाणिः सर्वथा ज्ञातिभिः सह ॥ ६॥"
        ]
      }
    ],
    "chapterId": "अयोध्याकाण्ड-sarga-51",
    "chapterName": "अयोध्याकाण्ड, सर्ग 51",
    "verseNumber": 6
  },
  {
