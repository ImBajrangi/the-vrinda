    "index": 4711,
    "titleDevanagari": "वाल्मीकि रामायण, अयोध्याकाण्ड, सर्ग 51, श्लोक 3",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-2-sarga-51-shlok-3",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "उचितोऽयं जनः सर्वः क्लेशानां त्वं सुखोचितः।",
          "गुप्त्यर्थं जागरिष्यामः काकुत्स्थस्य वयं निशाम्॥ ३॥"
        ]
      }
    ],
    "chapterId": "अयोध्याकाण्ड-sarga-51",
    "chapterName": "अयोध्याकाण्ड, सर्ग 51",
    "verseNumber": 3
  },
  {
