    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-2-sarga-51-shlok-10",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "यो न देवासुरैः सर्वैः शक्यः प्रसहितुं युधि।",
          "तं पश्य सुखसंसुप्तं तृणेषु सह सीतया॥१०॥"
        ]
      }
    ],
    "chapterId": "अयोध्याकाण्ड-sarga-51",
    "chapterName": "अयोध्याकाण्ड, सर्ग 51",
    "verseNumber": 10
  },
