    "slug": "valmiki-ramayana-2-sarga-51-shlok-5",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "अस्य प्रसादादाशंसे लोकेऽस्मिन् सुमहद् यशः।",
          "धर्मावाप्तिं च विपुलामर्थकामौ च पुष्कलौ॥५॥"
        ]
      }
    ],
    "chapterId": "अयोध्याकाण्ड-sarga-51",
    "chapterName": "अयोध्याकाण्ड, सर्ग 51",
    "verseNumber": 5
  },
  {
