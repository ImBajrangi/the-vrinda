    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 32, श्लोक 4",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-32-shlok-4-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "असुहृद्भिर्ममामित्रैर्नित्यमन्तरदर्शिभिः।",
          "मम दोषानसम्भूतान् श्रावितो राघवानुजः॥४॥",
          "अत्र तावद् यथाबुद्धिः सर्वैरेव यथाविधि।",
          "भावस्य निश्चयस्तावद् विज्ञेयो निपुणं शनैः॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-32",
    "chapterName": "बालकाण्ड, सर्ग 32",
    "verseNumber": 4
  },
  {
    "id": "valmiki-ramayana-1-sarga-32-shlok-5",
    "collectionId": "valmiki-ramayana",
    "index": 1610,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 32, श्लोक 5",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-32-shlok-5",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "कुशस्य वचनं श्रुत्वा चत्वारो लोकसत्तमाः।",
          "निवेशं चक्रिरे सर्वे पुराणां नृवरास्तदा॥५॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-32",
    "chapterName": "बालकाण्ड, सर्ग 32",
    "verseNumber": 5
  },
  {
