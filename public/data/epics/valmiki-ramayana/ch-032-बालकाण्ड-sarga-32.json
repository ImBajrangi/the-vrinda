    "slug": "valmiki-ramayana-1-sarga-32-shlok-6",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "न खल्वस्ति मम त्रासो लक्ष्मणान्नापि राघवात्।",
          "मित्रं स्वस्थानकुपितं जनयत्येव सम्भ्रमम्॥६॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-32",
    "chapterName": "बालकाण्ड, सर्ग 32",
    "verseNumber": 6
  },
  {
