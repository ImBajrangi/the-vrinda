    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 32, श्लोक 1",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-32-shlok-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "अङ्गदस्य वचः श्रुत्वा सुग्रीवः सचिवैः सह।",
          "लक्ष्मणं कुपितं श्रुत्वा मुमोचासनमात्मवान्॥१॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-32",
    "chapterName": "बालकाण्ड, सर्ग 32",
    "verseNumber": 1
  },
  {
    "id": "valmiki-ramayana-1-sarga-32-shlok-2-1",
    "collectionId": "valmiki-ramayana",
    "index": 1607,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 32, श्लोक 2",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-32-shlok-2-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "स च तानब्रवीद् वाक्यं निश्चित्य गुरुलाघवम्।",
          "मन्त्रज्ञान् मन्त्रकुशलो मन्त्रेषु परिनिष्ठितः॥२॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-32",
    "chapterName": "बालकाण्ड, सर्ग 32",
    "verseNumber": 2
  },
  {
    "id": "valmiki-ramayana-1-sarga-32-shlok-3",
    "collectionId": "valmiki-ramayana",
    "index": 1608,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 32, श्लोक 3",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-32-shlok-3",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "न मे दुर्व्याहृतं किंचिन्नापि मे दुरनुष्ठितम्।",
          "लक्ष्मणो राघवभ्राता क्रुद्धः किमिति चिन्तये॥ ३॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-32",
    "chapterName": "बालकाण्ड, सर्ग 32",
    "verseNumber": 3
  },
  {
