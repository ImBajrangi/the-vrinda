    "slug": "valmiki-ramayana-1-sarga-20-shlok-4-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "रणे दारुणविक्रान्त प्रवीर प्लवतां वर।",
          "किमिदानीं पुरोभागामद्य त्वं नाभिभाषसे॥४॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-20",
    "chapterName": "बालकाण्ड, सर्ग 20",
    "verseNumber": 4
  },
