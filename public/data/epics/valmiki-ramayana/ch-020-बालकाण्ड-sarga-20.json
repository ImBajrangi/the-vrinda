    "slug": "valmiki-ramayana-1-sarga-20-shlok-6-2",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "किंचिद् वक्ष्यामि तावत् तु श्रोतव्यं श्रोष्यसे यदि।",
          "तन्मे निगदतस्तात समाधिं श्रवणे कुरु॥६॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-20",
    "chapterName": "बालकाण्ड, सर्ग 20",
    "verseNumber": 6
  },
  {
