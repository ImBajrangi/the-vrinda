    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-20-shlok-7",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "किमयं वध्यते तात त्वयावध्येन दैवतैः।",
          "हत एव ह्ययं लोको यदा मृत्युवशं गतः॥७॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-20",
    "chapterName": "बालकाण्ड, सर्ग 20",
    "verseNumber": 7
  },
