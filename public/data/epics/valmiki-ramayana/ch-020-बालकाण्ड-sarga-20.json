    "slug": "valmiki-ramayana-1-sarga-20-shlok-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "ततो वित्रासयन् मान् पृथिव्यां राक्षसाधिपः।",
          "आससाद घने तस्मिन् नारदं मुनिपुङ्गवम्॥१॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-20",
    "chapterName": "बालकाण्ड, सर्ग 20",
    "verseNumber": 1
  },
  {
    "id": "valmiki-ramayana-1-sarga-20-shlok-2",
    "collectionId": "valmiki-ramayana",
    "index": 987,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 20, श्लोक 2",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-20-shlok-2",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "तस्याभिवादनं कृत्वा दशग्रीवो निशाचरः।",
          "अब्रवीत् कुशलं पृष्ट्वा हेतुमागमनस्य च ॥२॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-20",
    "chapterName": "बालकाण्ड, सर्ग 20",
    "verseNumber": 2
  },
  {
    "id": "valmiki-ramayana-1-sarga-20-shlok-3-1",
    "collectionId": "valmiki-ramayana",
    "index": 988,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 20, श्लोक 3",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-20-shlok-3-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "रामचापविसृष्टेन शरेणान्तकरेण तम्।",
          "दृष्ट्वा विनिहतं भूमौ तारा ताराधिपानना॥१॥",
          "सा समासाद्य भर्तारं पर्यष्वजत भामिनी।",
          "इषुणाभिहतं दृष्ट्वा वालिनं कुञ्जरोपमम्॥२॥",
          "वानरं पर्वतेन्द्राभं शोकसंतप्तमानसा।",
          "तारा तरुमिवोन्मूलं पर्यदेवयतातुरा॥३॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-20",
    "chapterName": "बालकाण्ड, सर्ग 20",
    "verseNumber": 3
  },
  {
    "id": "valmiki-ramayana-1-sarga-20-shlok-4-1",
    "collectionId": "valmiki-ramayana",
