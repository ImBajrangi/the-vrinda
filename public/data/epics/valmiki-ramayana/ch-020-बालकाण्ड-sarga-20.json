    "slug": "valmiki-ramayana-1-sarga-20-shlok-9",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "निरानन्दा निराशाहं निमग्ना शोकसागरे।",
          "त्वयि पञ्चत्वमापन्ने महायूथपयूथपे॥९॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-20",
    "chapterName": "बालकाण्ड, सर्ग 20",
    "verseNumber": 9
  },
