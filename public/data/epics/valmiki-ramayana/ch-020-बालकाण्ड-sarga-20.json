    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "उत्तिष्ठ हरिशार्दूल भजस्व शयनोत्तमम्।",
          "नैवंविधाः शेरते हि भूमौ नृपतिसत्तमाः॥५॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-20",
    "chapterName": "बालकाण्ड, सर्ग 20",
    "verseNumber": 5
  },
