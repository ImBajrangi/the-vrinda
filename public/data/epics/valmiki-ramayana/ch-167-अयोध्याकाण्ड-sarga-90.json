          "ततः संदर्शने तस्य भरद्वाजस्य राघवः।",
          "मन्त्रिणस्तानवस्थाप्य जगामानुपुरोहितम्॥३॥"
        ]
      }
    ],
    "chapterId": "अयोध्याकाण्ड-sarga-90",
    "chapterName": "अयोध्याकाण्ड, सर्ग 90",
    "verseNumber": 3
  },
