    "slug": "valmiki-ramayana-2-sarga-73-shlok-3",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "दुःखे मे दुःखमकरोणे क्षारमिवाददाः।",
          "राजानं प्रेतभावस्थं कृत्वा रामं च तापसम्॥३॥"
        ]
      }
    ],
    "chapterId": "अयोध्याकाण्ड-sarga-73",
    "chapterName": "अयोध्याकाण्ड, सर्ग 73",
