          "कस्मात् प्रव्राजितो रामः कस्मादेव वनं गतः॥ ७॥"
        ]
      }
    ],
    "chapterId": "अयोध्याकाण्ड-sarga-73",
    "chapterName": "अयोध्याकाण्ड, सर्ग 73",
    "verseNumber": 7
  },
