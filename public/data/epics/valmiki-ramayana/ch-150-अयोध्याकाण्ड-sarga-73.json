    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "त्वां प्राप्य हि पिता मेऽद्य सत्यसंधो महायशाः।",
          "तीव्रदुःखाभिसंतप्तो वृत्तो दशरथो नृपः॥६॥"
        ]
      }
    ],
    "chapterId": "अयोध्याकाण्ड-sarga-73",
    "chapterName": "अयोध्याकाण्ड, सर्ग 73",
    "verseNumber": 6
  },
