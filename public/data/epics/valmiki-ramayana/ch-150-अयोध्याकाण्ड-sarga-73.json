    "slug": "valmiki-ramayana-2-sarga-73-shlok-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "श्रुत्वा च स पितुर्वृत्तं भ्रातरौ च विवासितौ।",
          "भरतो दुःखसंतप्त इदं वचनमब्रवीत्॥१॥"
        ]
      }
    ],
    "chapterId": "अयोध्याकाण्ड-sarga-73",
    "chapterName": "अयोध्याकाण्ड, सर्ग 73",
    "verseNumber": 1
  },
  {
