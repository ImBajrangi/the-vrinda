    "slug": "valmiki-ramayana-2-sarga-73-shlok-2",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "किं नु कार्यं हतस्येह मम राज्येन शोचतः।",
          "विहीनस्याथ पित्रा च भ्रात्रा पितृसमेन च॥२॥"
        ]
      }
    ],
    "chapterId": "अयोध्याकाण्ड-sarga-73",
    "chapterName": "अयोध्याकाण्ड, सर्ग 73",
    "verseNumber": 2
  },
