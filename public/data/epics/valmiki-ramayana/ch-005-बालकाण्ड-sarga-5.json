    "slug": "valmiki-ramayana-1-sarga-5-shlok-2-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "अयं रामो महाप्राज्ञ सम्प्राप्तो दृढविक्रमः।",
          "लक्ष्मणेन सह भ्रात्रा रामोऽयं सत्यविक्रमः॥२॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-5",
    "chapterName": "बालकाण्ड, सर्ग 5",
    "verseNumber": 2
  },
