    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "शतक्रतोर्वचः श्रुत्वा देवाः साग्निपुरोगमाः।",
          "पितृदेवानुपेत्याहुः सर्वे सह मरुद्गणैः॥५॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-49",
    "chapterName": "बालकाण्ड, सर्ग 49",
    "verseNumber": 5
  },
