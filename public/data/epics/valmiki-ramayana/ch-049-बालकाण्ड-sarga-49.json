        "stanzaNumber": 1,
        "linesDevanagari": [
          "अनिर्वेदं च दाक्ष्यं च मनसश्चापराजयम्।",
          "कार्यसिद्धिकराण्याहुस्तस्मादेतद् ब्रवीम्यहम्॥६॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-49",
    "chapterName": "बालकाण्ड, सर्ग 49",
    "verseNumber": 6
  },
