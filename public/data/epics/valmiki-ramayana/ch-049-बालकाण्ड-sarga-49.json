    "slug": "valmiki-ramayana-1-sarga-49-shlok-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "अथाङ्गदस्तदा सर्वान् वानरानिदमब्रवीत्।",
          "परिश्रान्तो महाप्राज्ञः समाश्वास्य शनैर्वचः॥१॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-49",
    "chapterName": "बालकाण्ड, सर्ग 49",
    "verseNumber": 1
  },
  {
    "id": "valmiki-ramayana-1-sarga-49-shlok-2",
