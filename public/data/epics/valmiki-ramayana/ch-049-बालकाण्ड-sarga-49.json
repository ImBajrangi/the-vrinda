    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 49, श्लोक 3",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-49-shlok-3-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "वनानि गिरयो नद्यो दुर्गाणि गहनानि च।",
          "दरी गिरिगुहाश्चैव विचिताः सर्वमन्ततः॥२॥",
          "तत्र तत्र सहास्माभिर्जानकी न च दृश्यते।।",
          "तथा रक्षोऽपहर्ता च सीतायाश्चैव दुष्कृती॥३॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-49",
    "chapterName": "बालकाण्ड, सर्ग 49",
    "verseNumber": 3
  },
  {
    "id": "valmiki-ramayana-1-sarga-49-shlok-4",
    "collectionId": "valmiki-ramayana",
    "index": 2247,
    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 49, श्लोक 4",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-49-shlok-4",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "कालश्च नो महान् यातः सुग्रीवश्चोग्रशासनः।",
          "तस्माद् भवन्तः सहिता विचिन्वन्तु समन्ततः॥४॥",
          "विहाय तन्द्रीं शोकं च निद्रां चैव समुत्थिताम्।",
          "विचिनुध्वं तथा सीतां पश्यामो जनकात्मजाम्॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-49",
    "chapterName": "बालकाण्ड, सर्ग 49",
    "verseNumber": 4
  },
  {
