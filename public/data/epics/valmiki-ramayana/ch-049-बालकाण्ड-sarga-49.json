    "titleDevanagari": "वाल्मीकि रामायण, बालकाण्ड, सर्ग 49, श्लोक 2",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-1-sarga-49-shlok-2",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "कुर्वता तपसो विनं गौतमस्य महात्मनः।",
          "क्रोधमुत्पाद्य हि मया सुरकार्यमिदं कृतम्॥ २॥"
        ]
      }
    ],
    "chapterId": "बालकाण्ड-sarga-49",
    "chapterName": "बालकाण्ड, सर्ग 49",
    "verseNumber": 2
  },
  {
    "id": "valmiki-ramayana-1-sarga-49-shlok-3-1",
    "collectionId": "valmiki-ramayana",
