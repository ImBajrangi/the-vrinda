    "titleDevanagari": "वाल्मीकि रामायण, युद्धकाण्ड, सर्ग 25, श्लोक 1",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-6-sarga-25-shlok-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "सबले सागरं तीर्णे रामे दशरथात्मजे।",
          "अमात्यौ रावणः श्रीमानब्रवीच्छुकसारणौ ॥१॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-25",
    "chapterName": "युद्धकाण्ड, सर्ग 25",
    "verseNumber": 1
  },
  {
    "id": "valmiki-ramayana-6-sarga-25-shlok-2",
    "collectionId": "valmiki-ramayana",
    "index": 12032,
    "titleDevanagari": "वाल्मीकि रामायण, युद्धकाण्ड, सर्ग 25, श्लोक 2",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-6-sarga-25-shlok-2",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "समग्रं सागरं तीर्णं दुस्तरं वानरं बलम्।",
          "अभूतपूर्वं रामेण सागरे सेतुबन्धनम्॥२॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-25",
    "chapterName": "युद्धकाण्ड, सर्ग 25",
    "verseNumber": 2
  },
  {
    "id": "valmiki-ramayana-6-sarga-25-shlok-3",
    "collectionId": "valmiki-ramayana",
    "index": 12033,
    "titleDevanagari": "वाल्मीकि रामायण, युद्धकाण्ड, सर्ग 25, श्लोक 3",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-6-sarga-25-shlok-3",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "सागरे सेतुबन्धं तं न श्रद्दध्यां कथंचन।",
          "अवश्यं चापि संख्येयं तन्मया वानरं बलम्॥३॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-25",
    "chapterName": "युद्धकाण्ड, सर्ग 25",
    "verseNumber": 3
  },
  {
    "id": "valmiki-ramayana-6-sarga-25-shlok-4",
    "collectionId": "valmiki-ramayana",
    "index": 12034,
    "titleDevanagari": "वाल्मीकि रामायण, युद्धकाण्ड, सर्ग 25, श्लोक 4",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-6-sarga-25-shlok-4",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "शुकेन तु समादिष्टान् दृष्ट्वा स हरियूथपान्।",
          "लक्ष्मणं च महावीर्यं भुजं रामस्य दक्षिणम्॥१॥",
          "समीपस्थं च रामस्य भ्रातरं च विभीषणम्।",
          "सर्ववानरराजं च सुग्रीवं भीमविक्रमम्॥२॥",
          "अङ्गदं चापि बलिनं वज्रहस्तात्मजात्मजम्।",
          "हनूमन्तं च विक्रान्तं जाम्बवन्तं च दुर्जयम्॥३॥",
          "सुषेणं कुमुदं नीलं नलं च प्लवगर्षभम्।",
          "गजं गवाक्षं शरभं मैन्दं च द्विविदं तथा॥४॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-25",
    "chapterName": "युद्धकाण्ड, सर्ग 25",
    "verseNumber": 4
  },
  {
