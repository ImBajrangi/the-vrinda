    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-6-sarga-25-shlok-6",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "अधोमुखौ तौ प्रणतावब्रवीच्छुकसारणौ।",
          "रोषगद्गदया वाचा संरब्धं परुषं तथा॥६॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-25",
    "chapterName": "युद्धकाण्ड, सर्ग 25",
    "verseNumber": 6
  },
  {
