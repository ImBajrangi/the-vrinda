    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-6-sarga-25-shlok-5",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "किंचिदाविग्नहृदयो जातक्रोधश्च रावणः।",
          "भर्त्सयामास तौ वीरौ कथान्ते शुकसारणौ ॥५॥"
        ]
      }
    ],
    "chapterId": "युद्धकाण्ड-sarga-25",
    "chapterName": "युद्धकाण्ड, सर्ग 25",
    "verseNumber": 5
  },
