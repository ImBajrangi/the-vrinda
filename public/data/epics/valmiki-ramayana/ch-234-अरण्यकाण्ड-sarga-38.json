    "titleDevanagari": "वाल्मीकि रामायण, अरण्यकाण्ड, सर्ग 38, श्लोक 1",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-38-shlok-1",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "कदाचिदप्यहं वीर्यात् पर्यटन् पृथिवीमिमाम्।",
          "बलं नागसहस्रस्य धारयन् पर्वतोपमः॥१॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-38",
    "chapterName": "अरण्यकाण्ड, सर्ग 38",
    "verseNumber": 1
  },
  {
    "id": "valmiki-ramayana-3-sarga-38-shlok-2",
    "collectionId": "valmiki-ramayana",
    "index": 7774,
    "titleDevanagari": "वाल्मीकि रामायण, अरण्यकाण्ड, सर्ग 38, श्लोक 2",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-38-shlok-2",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "नीलजीमूतसंकाशस्तप्तकाञ्चनकुण्डलः।",
          "भयं लोकस्य जनयन् किरीटी परिघायुधः॥२॥",
          "व्यचरन् दण्डकारण्यमृषिमांसानि भक्षयन्।",
          "विश्वामित्रोऽथ धर्मात्मा मद्वित्रस्तो महामुनिः॥ ३॥",
          "स्वयं गत्वा दशरथं नरेन्द्रमिदमब्रवीत्।"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-38",
    "chapterName": "अरण्यकाण्ड, सर्ग 38",
    "verseNumber": 2
  },
  {
    "id": "valmiki-ramayana-3-sarga-38-shlok-4",
    "collectionId": "valmiki-ramayana",
    "index": 7775,
    "titleDevanagari": "वाल्मीकि रामायण, अरण्यकाण्ड, सर्ग 38, श्लोक 4",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-38-shlok-4",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "अयं रक्षतु मां रामः पर्वकाले समाहितः॥४॥",
          "मारीचान्मे भयं घोरं समुत्पन्नं नरेश्वर।"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-38",
    "chapterName": "अरण्यकाण्ड, सर्ग 38",
    "verseNumber": 4
  },
  {
