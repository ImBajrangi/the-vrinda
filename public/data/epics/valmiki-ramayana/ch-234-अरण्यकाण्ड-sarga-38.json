    "slug": "valmiki-ramayana-3-sarga-38-shlok-14",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "अजातव्यञ्जनः श्रीमान् बालः श्यामः शुभेक्षणः।",
          "एकवस्त्रधरो धन्वी शिखी कनकमालया॥१४॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-38",
    "chapterName": "अरण्यकाण्ड, सर्ग 38",
    "verseNumber": 14
  },
