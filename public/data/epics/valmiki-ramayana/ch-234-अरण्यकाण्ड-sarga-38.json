    "slug": "valmiki-ramayana-3-sarga-38-shlok-8",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "एवमुक्तः स तु मुनी राजानमिदमब्रवीत्॥८॥",
          "रामान्नान्यद बलं लोके पर्याप्तं तस्य रक्षसः।"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-38",
    "chapterName": "अरण्यकाण्ड, सर्ग 38",
    "verseNumber": 8
  },
  {
    "id": "valmiki-ramayana-3-sarga-38-shlok-9",
