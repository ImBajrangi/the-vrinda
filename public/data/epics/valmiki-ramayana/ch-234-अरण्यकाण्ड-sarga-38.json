    "titleDevanagari": "वाल्मीकि रामायण, अरण्यकाण्ड, सर्ग 38, श्लोक 5",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-38-shlok-5",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "इत्येवमुक्तो धर्मात्मा राजा दशरथस्तदा ॥५॥",
          "प्रत्युवाच महाभागं विश्वामित्रं महामुनिम्।"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-38",
    "chapterName": "अरण्यकाण्ड, सर्ग 38",
    "verseNumber": 5
  },
  {
    "id": "valmiki-ramayana-3-sarga-38-shlok-6",
    "collectionId": "valmiki-ramayana",
    "index": 7777,
    "titleDevanagari": "वाल्मीकि रामायण, अरण्यकाण्ड, सर्ग 38, श्लोक 6",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-38-shlok-6",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "ऊनद्वादशवर्षोऽयमकृतास्त्रश्च राघवः॥६॥",
          "कामं तु मम तत् सैन्यं मया सह गमिष्यति।",
          "बलेन चतुरङ्गेण स्वयमेत्य निशाचरम्॥७॥",
          "वधिष्यामि मुनिश्रेष्ठ शत्रु तव यथेप्सितम्।"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-38",
    "chapterName": "अरण्यकाण्ड, सर्ग 38",
    "verseNumber": 6
  },
  {
    "id": "valmiki-ramayana-3-sarga-38-shlok-8",
    "collectionId": "valmiki-ramayana",
    "index": 7778,
