    "slug": "valmiki-ramayana-3-sarga-38-shlok-15",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "शोभयन् दण्डकारण्यं दीप्तेन स्वेन तेजसा।",
          "अदृश्यत तदा रामो बालचन्द्र इवोदितः॥१५॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-38",
    "chapterName": "अरण्यकाण्ड, सर्ग 38",
    "verseNumber": 15
