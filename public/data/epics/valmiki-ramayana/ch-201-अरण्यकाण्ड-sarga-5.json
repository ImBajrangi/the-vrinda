    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "पाण्डुराभ्रघनप्रख्यं चन्द्रमण्डलसंनिभम्॥८॥",
          "अपश्यद् विमलं छत्रं चित्रमाल्योपशोभितम्।"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-5",
    "chapterName": "अरण्यकाण्ड, सर्ग 5",
    "verseNumber": 8
  },
  {
