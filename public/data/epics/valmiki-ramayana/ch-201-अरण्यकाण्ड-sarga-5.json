    "slug": "valmiki-ramayana-3-sarga-5-shlok-13",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "अर्चिष्मन्तं श्रिया जुष्टमद्भुतं पश्य लक्ष्मण।",
          "प्रतपन्तमिवादित्यमन्तरिक्षगतं रथम्॥१३॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-5",
    "chapterName": "अरण्यकाण्ड, सर्ग 5",
    "verseNumber": 13
