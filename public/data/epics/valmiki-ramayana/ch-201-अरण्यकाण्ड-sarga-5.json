[
  {
    "id": "valmiki-ramayana-3-sarga-5-shlok-3",
    "collectionId": "valmiki-ramayana",
    "index": 6894,
    "titleDevanagari": "वाल्मीकि रामायण, अरण्यकाण्ड, सर्ग 5, श्लोक 3",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-5-shlok-3",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "हत्वा तु तं भीमबलं विराधं राक्षसं वने।",
          "ततः सीतां परिष्वज्य समाश्वास्य च वीर्यवान्॥",
          "अब्रवीद् भ्रातरं रामो लक्ष्मणं दीप्ततेजसम्।",
          "कष्टं वनमिदं दुर्गं न च स्मो वनगोचराः॥२॥",
          "अभिगच्छामहे शीघ्रं शरभङ्गं तपोधनम्।",
          "आश्रमं शरभङ्गस्य राघवोऽभिजगाम ह॥३॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-5",
    "chapterName": "अरण्यकाण्ड, सर्ग 5",
    "verseNumber": 3
  },
  {
    "id": "valmiki-ramayana-3-sarga-5-shlok-4",
    "collectionId": "valmiki-ramayana",
    "index": 6895,
    "titleDevanagari": "वाल्मीकि रामायण, अरण्यकाण्ड, सर्ग 5, श्लोक 4",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-5-shlok-4",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "तस्य देवप्रभावस्य तपसा भावितात्मनः।",
          "समीपे शरभङ्गस्य ददर्श महदद्भुतम्॥४॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-5",
    "chapterName": "अरण्यकाण्ड, सर्ग 5",
    "verseNumber": 4
  },
  {
