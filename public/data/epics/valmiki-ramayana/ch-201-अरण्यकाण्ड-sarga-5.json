    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "ये हयाः पुरुहूतस्य पुरा शक्रस्य नः श्रुताः।",
          "अन्तरिक्षगता दिव्यास्त इमे हरयो ध्रुवम्॥१४॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-5",
    "chapterName": "अरण्यकाण्ड, सर्ग 5",
    "verseNumber": 14
