    "slug": "valmiki-ramayana-3-sarga-5-shlok-5",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "॥ श्रीसीतारामचन्द्राभ्यां नमः॥",
          "श्रीमद्वाल्मीकीय रामायण",
          "अरण्यकाण्डम्",
          "पञ्चमः सर्गः (सर्ग 5)",
          "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्येऽरण्यकाण्डे पञ्चमः सर्गः॥५॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-5",
    "chapterName": "अरण्यकाण्ड, सर्ग 5",
    "verseNumber": 5
  },
  {
    "id": "valmiki-ramayana-3-sarga-5-shlok-6",
    "collectionId": "valmiki-ramayana",
    "index": 6897,
    "titleDevanagari": "वाल्मीकि रामायण, अरण्यकाण्ड, सर्ग 5, श्लोक 6",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-5-shlok-6",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "विभ्राजमानं वपुषा सूर्यवैश्वानरप्रभम्।",
          "रथप्रवरमारूढमाकाशे विबुधानुगम्॥५॥",
          "असंस्पृशन्तं वसुधां ददर्श विबुधेश्वरम्।",
          "सम्प्रभाभरणं देवं विरजोऽम्बरधारिणम्॥६॥"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-5",
    "chapterName": "अरण्यकाण्ड, सर्ग 5",
    "verseNumber": 6
  },
  {
    "id": "valmiki-ramayana-3-sarga-5-shlok-7",
    "collectionId": "valmiki-ramayana",
    "index": 6898,
    "titleDevanagari": "वाल्मीकि रामायण, अरण्यकाण्ड, सर्ग 5, श्लोक 7",
    "author": "महर्षि वाल्मीकि",
    "slug": "valmiki-ramayana-3-sarga-5-shlok-7",
    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "तद्विधैरेव बहुभिः पूज्यमानं महात्मभिः।",
          "हरितैर्वाजिभिर्युक्तमन्तरिक्षगतं रथम्॥७॥",
          "ददर्शादूरतस्तस्य तरुणादित्यसंनिभम्।"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-5",
    "chapterName": "अरण्यकाण्ड, सर्ग 5",
    "verseNumber": 7
  },
  {
