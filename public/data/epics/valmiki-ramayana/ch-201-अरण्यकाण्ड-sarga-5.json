    "verses": [
      {
        "stanzaNumber": 1,
        "linesDevanagari": [
          "चामरव्यजने चाग्रये रुक्मदण्डे महाधने॥९॥",
          "गृहीते वरनारीभ्यां धूयमाने च मूर्धनि।"
        ]
      }
    ],
    "chapterId": "अरण्यकाण्ड-sarga-5",
    "chapterName": "अरण्यकाण्ड, सर्ग 5",
    "verseNumber": 9
  },
  {
