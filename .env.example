# Groq Cloud API Key (https://console.groq.com/keys)
VITE_GROQ_API_KEY=your_groq_api_key_here

# Hugging Face User Access Token (https://huggingface.co/settings/tokens)
VITE_HF_TOKEN=your_huggingface_token_here
